// scrollIntoOwnContainer — bring a deep-linked element into view WITHOUT
// scrolling the app shell, then flash a ring on it.
//
// Moved here from leaderboard/GlobalTab.jsx (2026-10-18) when the Badges page
// grew the same deep link (`/Badges?badge=<id>`); both now share one copy.
//
// WHY NOT el.scrollIntoView(). It bubbles the scroll to EVERY scrollable
// ancestor; #root (overflow-y:auto, index.css) then scrolls the whole page up
// on iOS, sliding the status-bar-safe header (pt-[60px]) under the notch. That
// was the trophy-tap top-cutoff regression (v1.0.279/280 soak). Scoping the
// scroll to the nearest scrollable ancestor — stopping BEFORE #root — keeps the
// top inset intact.

/**
 * The nearest scrollable ancestor of `node`, stopping before the app-wide
 * #root momentum scroller. Null when there is none (the node is in view).
 *
 * @param {Element} node
 * @returns {HTMLElement | null}
 */
export function closestScrollable(node) {
  for (let el = node.parentElement; el; el = el.parentElement) {
    if (el.id === 'root') break; // never scroll the app shell (would hide the top inset)
    const oy = getComputedStyle(el).overflowY;
    if (oy === 'auto' || oy === 'scroll') return el;
  }
  return null;
}

/**
 * Centre `node` in its own scroller. No scroller found → leave the page put.
 *
 * @param {HTMLElement} node
 */
export function scrollIntoOwnContainer(node) {
  const scroller = closestScrollable(node);
  if (!scroller) return;
  const rowRect = node.getBoundingClientRect();
  const scRect = scroller.getBoundingClientRect();
  const delta = (rowRect.top - scRect.top) - (scroller.clientHeight - node.clientHeight) / 2;
  if (scroller.scrollBy) scroller.scrollBy({ top: delta, behavior: 'smooth' });
  else scroller.scrollTop += delta;
}

/**
 * Flash a fading ring on `node`. The Web Animations API is guarded so older
 * webviews just no-op (the scroll alone still helps), and a player who asked
 * for reduced motion gets no flash.
 *
 * @param {HTMLElement} node
 * @param {{ color?: string, duration?: number, pulses?: number }} [opts]
 */
export function flashRing(node, { color = 'var(--u37-gold)', duration = 1800, pulses = 1 } = {}) {
  try {
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
    node.animate(
      [
        { boxShadow: `0 0 0 3px ${color}` },
        { boxShadow: `0 0 0 3px ${color}`, offset: 0.6 },
        { boxShadow: '0 0 0 0 rgba(255,207,58,0)' },
      ],
      { duration, easing: 'ease-out', iterations: pulses },
    );
  } catch { /* Web Animations API unavailable — the scroll is enough. */ }
}
