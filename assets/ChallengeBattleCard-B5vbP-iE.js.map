import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { X, Loader2 } from 'lucide-react';
import { apiClient } from '@/transport';
import { playSound } from '@/ui/feedback';
import { BATTLE_DURATIONS_ENABLED, BATTLE_DURATION_OPTIONS, DEFAULT_BATTLE_SECONDS } from './battleConfig';
import { buildBattleDiceSequence } from './battleDeck';
import BattleDurationPicker from './BattleDurationPicker';
import { BLITZ_TIER_ACCENT, normalizeBlitzMode } from './blitzMode';
import { blitzTierPresentation } from './blitzTierPresentation';
import BlitzModeBadge from './BlitzModeBadge';

/**
 * `initialDurationSeconds` pre-fills the length picker (Sector 73's Rematch: same mode + timer as the
 * battle just played). An unknown length falls back to the default rather than offering a value the
 * picker has no button for.
 * @param {{ opponentId: string, onClose: () => void, onCreated: () => void, battleMode?: string, initialDurationSeconds?: number }} props
 */
export default function CreateChallenge({ opponentId, onClose, onCreated, battleMode = 'easy', initialDurationSeconds = undefined }) {
  const [creating, setCreating] = useState(false);

  // The tier this invite is for, resolved once; every colour derives from it.
  const tierAccent = BLITZ_TIER_ACCENT(normalizeBlitzMode(battleMode));
  const [error, setError] = useState('');
  // M3 duration picker (gated). When disabled the value stays at the legacy
  // 10-minute default, so all copy below reads "10-minute" exactly as before.
  const [durationSeconds, setDurationSeconds] = useState(() => (
    BATTLE_DURATION_OPTIONS.some((o) => o.seconds === initialDurationSeconds) ? initialDurationSeconds : DEFAULT_BATTLE_SECONDS
  ));
  const durationMinutes = Math.round(durationSeconds / 60);

  const handleCreate = async () => {
    playSound('swordClash');
    setCreating(true);
    setError('');

    try {
      const user = await apiClient.auth.me();

      if (user.id === opponentId) {
        setError('You cannot challenge yourself!');
        setCreating(false);
        return;
      }

      // Pre-generate the shared dice sequence. Both players read this same
      // stored array by index, so it must be long enough to never be exhausted
      // in a time-boxed battle — see BATTLE_DICE_SEQUENCE_LENGTH.
      //
      // Expert DRAWS from the vetted pool instead of rolling, and THROWS if the
      // pool cannot supply a full deck — an unvetted roll in a perfect-only mode
      // is a puzzle neither player can clear. See battleDeck.js.
      const diceSequence = await buildBattleDiceSequence({ mode: battleMode });

      await apiClient.entities.HeadToHeadChallenge.create({
        challenger_id: user.id,
        opponent_id: opponentId,
        blitz_mode: battleMode,
        status: 'pending',
        dice_sequence: diceSequence,
        challenger_result: { completed: false, total_solved: 0, solutions: [] },
        opponent_result: { completed: false, total_solved: 0, solutions: [] },
        // Only persist the chosen length once B's column exists (flag). Sending
        // an unknown column would fail the insert — see battleConfig.js.
        ...(BATTLE_DURATIONS_ENABLED ? { time_limit_seconds: durationSeconds } : {}),
      });

      onCreated();
    } catch (error) {
      // ⚠️ SURFACE THE REAL MESSAGE WHEN WE HAVE ONE (2026-09-11).
      // `buildBattleDiceSequence` throws ExpertDeckUnavailableError with a
      // sentence written FOR the player — "Expert battles are not available yet
      // — the vetted puzzle pool is still filling. Please try again later, or
      // start an Easy or Challenge battle." Flattening that into "Failed to
      // create challenge. Please try again." told someone to repeat the exact
      // action that cannot work, with no hint that the other two tiers would.
      // Harmless while Expert was unreachable; not harmless now that it ships.
      const friendly = error?.name === 'ExpertDeckUnavailableError' ? error.message : null;
      console.error('Failed to create challenge:', error);
      setError(friendly || 'Failed to create challenge. Please try again.');
      setCreating(false);
    }
  };

  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 u37-ad-safe-pb"
    >
      <motion.div
        initial={{ scale: 0.9, y: 20 }}
        animate={{ scale: 1, y: 0 }}
        className="bg-gradient-to-br from-slate-800 via-indigo-950 to-slate-800 rounded-xl sm:rounded-2xl p-4 sm:p-6 max-w-md w-full border-2 shadow-xl"
        style={{
          borderColor: `color-mix(in srgb, ${tierAccent} 50%, transparent)`,
          boxShadow: `0 0 32px -12px ${tierAccent}`,
        }}
      >
        <div className="flex items-center justify-between mb-4 sm:mb-6">
          {/* Both of these were easy/not-easy class pairs, so an Expert battle
              wore Challenge's orange — which is not even Challenge's colour
              (that is cyan). One accent, from the tier. */}
          <h2 className="text-base sm:text-xl font-bold" style={{ color: tierAccent }}>
            Create Head-to-Head Challenge
          </h2>
          <button onClick={onClose} className="text-slate-400 hover:text-white">
            <X className="w-5 h-5" />
          </button>
        </div>

        <div className="mb-4 sm:mb-6">
          <p className="text-slate-300 mb-3 sm:mb-4 text-sm sm:text-base">
            Challenge this player to a {durationMinutes}-minute speed race! You'll both face the same sequence of puzzles.
          </p>

          {/* Duration Picker (M3 — gated). When disabled, the length is fixed at
              the legacy 10-minute default and no picker is shown. Shared with the
              Colosseum "Battle Friends" flow via BattleDurationPicker. */}
          {BATTLE_DURATIONS_ENABLED && (
            <BattleDurationPicker
              value={durationSeconds}
              onChange={setDurationSeconds}
              battleMode={battleMode}
            />
          )}

          {/* Selected Mode Display.
              🔴 WAS `battleMode === 'easy' ? 'Easy Mode' : 'Challenge Mode'`,
              with the power dice drawn by hand in raw divs. So the screen you
              see immediately before starting an EXPERT battle announced it as
              "Challenge Mode · Power Dice Rules", in orange. Same two-branch
              mistake as the notifications centre, in the inverted direction —
              which is why my first sweep (`=== 'challenge' ?`) missed it. */}
          <div className="mb-3 sm:mb-4">
            <h3
              className="text-xs sm:text-sm font-bold mb-2 sm:mb-3"
              style={{ color: tierAccent }}
            >
              Battle Mode
            </h3>
            <div
              className="p-3 sm:p-4 rounded-lg sm:rounded-xl border-2 text-center"
              style={{
                background: `linear-gradient(to bottom right, color-mix(in srgb, ${tierAccent} 28%, transparent), transparent)`,
                borderColor: `color-mix(in srgb, ${tierAccent} 60%, transparent)`,
              }}
            >
              <BlitzModeBadge mode={battleMode} variant="inline" suffix=" Mode" className="justify-center" />
              <div className="text-xs sm:text-sm text-slate-300 mt-1">
                {blitzTierPresentation(normalizeBlitzMode(battleMode)).diceBlurb}
              </div>
            </div>
          </div>

          <div className="bg-slate-700/50 rounded-lg p-3 sm:p-4 space-y-1.5 sm:space-y-2 text-xs sm:text-sm text-slate-300">
            <div className="flex items-start gap-2">
              <span className="text-amber-400">•</span>
              <span>{durationMinutes}-minute countdown timer</span>
            </div>
            <div className="flex items-start gap-2">
              <span className="text-amber-400">•</span>
              <span>Solve as many equations as possible</span>
            </div>
            <div className="flex items-start gap-2">
              <span className="text-amber-400">•</span>
              <span>Both players face identical puzzles</span>
            </div>
            <div className="flex items-start gap-2">
              <span className="text-amber-400">•</span>
              <span>Winner: Most solved (or fastest if tied)</span>
            </div>
            <div className="flex items-start gap-2">
              <span className="text-amber-400">•</span>
              <span>Must complete within 7 days or forfeit</span>
            </div>
          </div>
        </div>

        {error && (
          <div className="mb-3 sm:mb-4 p-2 sm:p-3 bg-red-900/30 border border-red-500/50 rounded-lg text-red-300 text-xs sm:text-sm">
            {error}
          </div>
        )}

        <div className="flex gap-2 sm:gap-3">
          <Button
            onClick={onClose}
            className="flex-1 bg-gradient-to-r from-purple-900 to-purple-950 hover:from-purple-950 hover:to-purple-900 border border-purple-800/50 text-white min-h-[44px] text-sm sm:text-base"
            disabled={creating}
          >
            Cancel
          </Button>
          <Button
            onClick={handleCreate}
            className="flex-1 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 min-h-[44px] text-sm sm:text-base"
            disabled={creating}
          >
            {creating ? (
              <>
                <Loader2 className="w-3 h-3 sm:w-4 sm:h-4 mr-2 animate-spin" />
                <span className="text-xs sm:text-base">Creating...</span>
              </>
            ) : (
              'Send Challenge'
            )}
          </Button>
        </div>
      </motion.div>
    </motion.div>
  );
}