import React from 'react';
import { motion } from 'framer-motion';
import { Swords } from 'lucide-react';
import { Button } from '@/ui/primitives/button';
import { MiniDice } from '@/puzzle-input';
import { BLITZ_TIER_ACCENT, BLITZ_TIER_LABEL, offeredBlitzTiers } from '@/head-to-head';

// ChallengeBattleCard — "challenge this player to a battle", on their profile.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT LEFT OtherProfile
// ─────────────────────────────────────────────────────────────────────────────
// Reported on the S21 (David, 2026-09-11): "the battle friend tab from within
// the other persons profile page is not formatted correctly". It was the last
// block on that page still wearing hand-picked Tailwind colours — emerald for
// Easy, orange for Challenge, a red gradient on the heading — while everything
// around it had moved onto the design tokens. It did not look broken so much as
// borrowed from another app.
//
// The tiers already have official colours, and they are NOT the ones this used:
//
//     easy       var(--u37-green)
//     challenge  var(--u37-cyan)      ← was orange
//     expert     var(--u37-gold)
//
// `BLITZ_TIER_ACCENT` is the single source (head-to-head/blitzMode.js), the same
// one the Colosseum surfaces were moved onto. Magenta is deliberately absent —
// it identifies the Colosseum as a PLACE, so a tier wearing it would vanish into
// the chrome around it.
//
// ⚠️ EXPERT MAY NOT APPEAR, AND THAT IS NOT AN OVERSIGHT. `BATTLE_EXPERT_ENABLED`
// is false: the Expert deck pool has a precondition that has never been
// verified (a two-player Expert battle on staging, which needs two humans), and
// creating one before then deals unvetted puzzles. The gate is applied inside
// `offeredBlitzTiers()` — the ONE place pickers get it — so enabling Expert is a
// one-line change there and this renders three cards without being touched.
//
// 2026-09-12: this file used to carry its OWN `TIERS` array, duplicating the
// dice and blurbs that blitzTierPresentation.js already owned — that module's
// header even described this array in the past tense, as though the migration
// had happened. It had not. Changing the sample dice to read 3-6-5 (David) meant
// changing them in two places, so the duplicate went instead.
//
// It is a component rather than JSX inside the page because `OtherProfile.jsx`
// sits at 774 lines against an 800-line ratchet cap. Re-skinning it in place
// would have spent the remaining headroom on styling — and the rule is to
// extract rather than trim comments for room.

/**
 * @param {Object} props
 * @param {string} props.username the player being challenged
 * @param {(mode: string) => void} props.onChallenge called with the chosen tier
 */
export default function ChallengeBattleCard({ username, onChallenge }) {
  // The tiers, their sample dice and their one-line blurbs all come from
  // `offeredBlitzTiers()` — which ALSO applies the BATTLE_EXPERT_ENABLED gate, so
  // the local filter this used to do is gone with the local array.
  const tiers = offeredBlitzTiers();

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      data-testid="challenge-battle-card"
      className="rounded-2xl p-6 border-2 mb-8 backdrop-blur"
      style={{
        background: 'var(--u37-panel-bg)',
        // The panel takes the COLOSSEUM's identity, not a tier's — this is the
        // doorway to the arena, and the tier colours belong to the cards inside.
        borderColor: 'color-mix(in srgb, var(--u37-magenta) 45%, transparent)',
        boxShadow: '0 18px 60px rgba(0,0,0,0.45), 0 0 34px -18px var(--u37-magenta)',
      }}
    >
      <div className="w-full flex items-center mb-4">
        <div className="flex items-center gap-2 min-w-0">
          <span className="text-2xl flex-shrink-0">⚔️</span>
          <span
            className="text-lg sm:text-xl font-bold truncate"
            style={{ color: 'var(--u37-magenta)' }}
          >
            Challenge {username}
          </span>
        </div>
      </div>

      {/* One column per available tier. `sm:grid-cols-N` from the count rather
          than a literal 2, so enabling Expert does not silently leave a third
          card stacked alone under a two-wide row. */}
      <div className={`grid grid-cols-1 gap-4 ${tiers.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
        {tiers.map(({ mode, diceBlurb, dice }) => {
          const accent = BLITZ_TIER_ACCENT(mode);
          return (
            <div
              key={mode}
              data-testid="challenge-tier-card"
              data-mode={mode}
              className="flex flex-col justify-between rounded-2xl p-5 border-2"
              style={{
                background: 'var(--u37-surface)',
                borderColor: `color-mix(in srgb, ${accent} 45%, transparent)`,
                boxShadow: `0 0 26px -16px ${accent}`,
              }}
            >
              <div className="text-center mb-4">
                <div className="flex justify-center gap-2 mb-2">
                  {dice.map((d, i) => <MiniDice key={i} value={d.value} color={d.color} />)}
                </div>
                <h3 className="text-xl font-black mb-1" style={{ color: accent }}>
                  {BLITZ_TIER_LABEL(mode)} Battle
                </h3>
                {/* Length is chosen in the NEXT step (3/5/7/10 min) since 1.0.285 —
                    a fixed "10 minutes" here was wrong (Bryce). */}
                <p className="text-xs mb-3" style={{ color: accent, opacity: 0.85 }}>{diceBlurb}</p>
              </div>
              <Button
                onClick={() => onChallenge(mode)}
                className="w-full min-h-[48px] touch-manipulation font-bold border-2"
                style={{
                  background: `color-mix(in srgb, ${accent} 22%, transparent)`,
                  borderColor: accent,
                  color: accent,
                }}
              >
                <Swords className="w-4 h-4 mr-2" />
                Start {BLITZ_TIER_LABEL(mode)} Battle
              </Button>
            </div>
          );
        })}
      </div>
    </motion.div>
  );
}
