// daily-challenge — thin function-level abstraction over the
// dailyChallengeController edge function. Centralises the four action
// verbs (status / start / submit / forfeit) so callers don't have to
// know the action-string contract or the session-token plumbing.
//
// This pass keeps the React state machine in Game.jsx — see
// docs/architecture/subsystems.md "Pass 4.1" entry for the deferred
// useDailyChallengeAttempt() hook work. The function-level surface
// alone collapses six different inline edgeCall sites into one place
// per action, which is already a real reduction in places-to-edit.
//
// Each function returns the underlying EdgeCallResult unchanged
// ({ success, data, error }) so callers continue to handle the
// envelope shape exactly the way edgeCallPort returns it. No new
// error semantics added.

import { edgeCall, apiClient } from '@/transport';

// ─────────────────────────────────────────────────────────────────────────────
// `mode` — WHICH Daily a call is about
// ─────────────────────────────────────────────────────────────────────────────
// Every verb below takes `mode`, defaulting to 'daily' — Challenge's Daily, the
// legacy key and the only Daily that exists in shipped data. See
// src/game-modes/modeKeys.js for why 'daily' does NOT mean "the daily in
// general".
//
// WIRE ENCODING — the key is OMITTED when it holds the default. Two reasons,
// and the second is the load-bearing one:
//
//   1. It buys nothing today. Adding a request field is additive and exempt from
//      the edge-deploy envelope freeze, but the Deno side resolves `mode` by
//      TRUST, not validation: an untrusted caller's mode is coerced to 'daily'
//      regardless (lane-contract §3.2 r4). Only the cron is trusted. So an
//      explicit `mode: 'daily'` and an absent one are the same request.
//   2. It keeps every pre-modes payload BYTE-IDENTICAL. That is the proof this
//      signature is dormant — no existing caller changed, and no existing test
//      had to change to accommodate it.
//
// Same shape as `device_time_ms` further down: a key that only appears when it
// carries information, never `mode: undefined`.
const DEFAULT_DAILY_MODE = 'daily';
const modeField = (mode) => (mode === DEFAULT_DAILY_MODE ? {} : { mode });

// Status pre-check — returns one of 'not_started' | 'in_progress' |
// 'completed' | 'forfeited' on the .data.status field of a successful
// result. Used to gate whether `start` is safe to call.
export const getDailyChallengeStatus = ({ mode = DEFAULT_DAILY_MODE } = {}) =>
  edgeCall('dailyChallengeController', { action: 'status', ...modeField(mode) });

// Begin a new attempt for the current day. On success, .data
// contains { session_token, ... } — caller should stash the token
// somewhere accessible (currently window.dailyChallengeSessionToken;
// will move into hook-managed state when useDailyChallengeAttempt
// lands).
export const startDailyChallengeAttempt = ({ mode = DEFAULT_DAILY_MODE } = {}) =>
  edgeCall('dailyChallengeController', { action: 'start', ...modeField(mode) });

// Submit a finished daily challenge solution. session_token is the
// one returned from startDailyChallengeAttempt's .data.session_token.
// All other fields describe the solution.
export const submitDailyChallengeSolution = ({
  sessionToken,
  mode = DEFAULT_DAILY_MODE,
  solveTimeSeconds,
  equation,
  usedDiceIndices,
  diceColors,
  shuffledDice,
}) =>
  edgeCall('dailyChallengeController', {
    action: 'submit',
    session_token: sessionToken,
    ...modeField(mode),
    solve_time_seconds: solveTimeSeconds,
    equation,
    usedDiceIndices,
    diceColors,
    shuffledDice,
  });

// Submit a finished daily solve to the anti-spoof leaderboard writer (W4-HIGH,
// the `submit-daily-time` edge fn). This is the AUTHORITATIVE leaderboard-row
// write — the edge fn re-verifies the equation and computes a SERVER-side solve
// time from the attempt's start, so the client can no longer fake a solve. It
// sends NO user_email (email is being removed, W4-MED).
//
// Feature T (device-time-authoritative, contract LOCKED w/ Lane B 2026-07-26):
// we now ALSO send `device_time_ms` — the device-measured elapsed solve time in
// whole milliseconds. The server picks the device time when it's within a ~3s
// tolerance of its own measurement (so the displayed time matches the device,
// no network-lag skew), else falls back to the server time. The field is
// OPTIONAL — omit it and the server just uses its own time as before. The
// response envelope is unchanged (additive request field → NOT deploy-frozen).
// Distinct from submitDailyChallengeSolution above, which stays for the
// perfect-streak sync + (during Phase 1) a fallback insert. Keys are snake_case.
export const submitDailyLeaderboardTime = ({
  mode = DEFAULT_DAILY_MODE,
  equation,
  usedDiceIndices,
  diceColors,
  shuffledDice,
  deviceTimeMs,
}) =>
  edgeCall('submitDailyTime', {
    ...modeField(mode),
    equation,
    used_dice_indices: usedDiceIndices,
    dice_colors: diceColors,
    shuffled_dice: shuffledDice,
    // Only include the key when we actually have a measurement — keeps the
    // field truly optional (no `device_time_ms: undefined` in the JSON body).
    ...(Number.isFinite(deviceTimeMs) ? { device_time_ms: Math.round(deviceTimeMs) } : {}),
  });

/**
 * Does this player already have a leaderboard row for (date, mode)?
 *
 * 🔴 Exists to stop the app LYING to a player about a lost solve. The referee
 * answers domain rejections in-band (HTTP 200 + `fail(code)`), and a rejection
 * does not mean nothing was written — `daily-challenge-controller` still
 * performs a Phase-1 fallback insert right after it. Before telling someone
 * their time was not saved, ask the table. See game-flow/leaderboardSubmit.
 *
 * Selects `id` ONLY. This runs on a win screen and needs a yes/no, not a row —
 * and the narrower the select, the fewer ways a column change can 42703 it.
 *
 * ⚠️ Throws rather than returning false on a read error. "I could not check" and
 * "it is not there" are different answers, and the caller alarms on the first
 * while staying silent on the second — collapsing them here would hand back a
 * confident `false` built on a failed read.
 *
 * @param {{userId: string, date: string, mode?: string}} p
 * @returns {Promise<boolean>}
 */
export async function hasDailyTimeRow({ userId, date, mode = DEFAULT_DAILY_MODE }) {
  if (!userId || !date) return false;
  const { data, error } = await apiClient.supabase
    .from('daily_challenge_times')
    .select(/** @type {'*'} */ ('id'))
    .eq('user_id', userId)
    .eq('date', date)
    .eq('mode', mode)
    .limit(1);
  if (error) throw error;
  return Array.isArray(data) && data.length > 0;
}

// Forfeit the current attempt. session_token may be the literal
// string 'unknown' when the caller has lost track (e.g. stale
// in_progress on a different tab) — the backend tolerates this.
export const forfeitDailyChallengeAttempt = ({ sessionToken, mode = DEFAULT_DAILY_MODE }) =>
  edgeCall('dailyChallengeController', {
    action: 'forfeit',
    session_token: sessionToken || 'unknown',
    ...modeField(mode),
  });
