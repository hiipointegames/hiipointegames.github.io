// useDailyChallengeAttempt — the daily-challenge state machine, as a hook.
//
// Owns:
//   - status: 'loading' | 'not_started' | 'in_progress' | 'completed' | 'forfeited'
//   - elapsed-seconds timer (ticks at 10ms while in_progress)
//   - session token (kept in a ref — survives re-renders, never leaks
//     to window globals)
//   - today's-dice cache (kept in a ref — shared between start() and
//     fetchTodaysDice())
//   - the three UI flags that Game.jsx used to manage:
//       showStartWarning  — pre-game confirmation modal
//       showExitWarning   — mid-game exit confirmation modal
//       showGame          — the playing-UI surface is mounted
//
// Methods:
//   restore(user)         — mount-time state restoration from
//                           DailyChallengeAttempt entity + user's
//                           game_stats.dailyChallengeTimes
//   start()               — pre-check status, kick off attempt + dice
//                           fetch, return { dice, ok } so the caller
//                           can wire dice into its game state
//   submit({ ... })       — fire submit edge call, flip status to
//                           'completed', reset timer
//   forfeit()             — fire forfeit edge call, flip status to
//                           'forfeited', reset timer; returns whenSaved()
//   whenSaved()           — FORFEIT SAVES ONLY (a solve's submit is not in
//                           it). Promise<boolean> that settles once every
//                           forfeit this hook has fired so far has finished:
//                           true only if every one reported success, false if
//                           any failed (offline, refused). Never rejects.
//   reset()               — clear timer/startedAt/showGame (used by
//                           SuccessModal close handlers)
//   fetchTodaysDice()     — read-or-fetch today's dice, used by the
//                           handleNewGame path
//
// See:
//   docs/architecture/subsystems.md  (#4 — daily-challenge)
//   ../pages/Game.jsx                (consumer)

import { useCallback, useEffect, useRef, useState } from 'react';
import { apiClient } from '@/transport';
import { reportSolveFailure, SOLVE_STAGE, track } from '@/observability';
import { generateDailyDice } from '@/dice';
import { isDaily, isKnownModeKey } from '@/game-modes';
import {
  getDailyChallengeStatus,
  startDailyChallengeAttempt,
  submitDailyChallengeSolution,
  forfeitDailyChallengeAttempt,
} from './dailyChallenge';
import { todayET } from './dailyTimezone';
import { DAILY_LIMIT_SECONDS, DAILY_LIMIT_MS } from './dailyLimit';

const todayString = todayET;

// The daily attempt's hard wall — an attempt whose server start is older than
// this is no longer recoverable (it resolves to the timeout outcome instead).
// 1 hour → 15:37 on 2026-09-12; the number and the words a player reads both
// come from ./dailyLimit now, so the clock and the rules screen cannot drift.
// The last COUNTDOWN_SECONDS run a visible on-screen countdown (15:27 → 15:37).
const COUNTDOWN_SECONDS = 10;

// Challenge's Daily — the legacy wire key, and the only Daily in shipped data.
// See src/game-modes/modeKeys.js for why 'daily' does NOT mean "the daily in
// general".
const DEFAULT_DAILY_MODE = 'daily';

/**
 * @param {string} [modeKey] WHICH Daily this instance drives. One hook INSTANCE
 *   PER MODE — the state is already per-instance, and the dice cache is keyed
 *   `${date}:${mode}` so two instances cannot serve each other's dice.
 *
 *   Defaults to 'daily', so every pre-modes caller is untouched.
 *
 *   An unrecognised key is NOT coerced. Coercing it to 'daily' would hand a typo
 *   a timed, ranked, once-a-day round — the exact hazard lane-contract 3.2 r3
 *   forbids ("never to 'daily'") — and coercing to 'easy' would be nonsense in a
 *   Daily-only hook. Instead the dice read finds no row for the bogus mode and
 *   says so loudly, which is a bug you can see.
 */
export function useDailyChallengeAttempt(modeKey = DEFAULT_DAILY_MODE) {
  const [status, setStatus] = useState('not_started');
  const [startedAt, setStartedAt] = useState(null);
  const [elapsedSeconds, setElapsedSeconds] = useState(0);

  const [showStartWarning, setShowStartWarning] = useState(false);
  const [showExitWarning, setShowExitWarning] = useState(false);
  const [showGame, setShowGame] = useState(false);
  // F4: the timer can be PAUSED (e.g. while the in-game How-To-Play is open) and
  // resumed without losing or inflating elapsed time. The clock is derived from
  // `startedAt` (a wall-clock anchor), so resume() pushes `startedAt` forward by
  // however long we were paused — the elapsed calc then continues seamlessly.
  const [isPaused, setIsPaused] = useState(false);

  const sessionTokenRef = useRef(null);
  const diceCacheRef = useRef({});
  const pausedAtRef = useRef(null);

  // whenSaved — so a host can wait for a forfeit to reach the server before it
  // moves on (Sector 73 closes its 37 mode only after the forfeit is saved, or
  // the other page could restore the Daily as "Continue"). Every forfeit write
  // the hook fires — voluntary, the 1-hour timeout, the expired attempt found by
  // restore() — is folded into this one promise. Each write is `.catch`-ed AS IT
  // IS STORED: a failed forfeit is already logged where it is fired, and keeping
  // a rejecting promise here would turn it into a second, unhandled rejection
  // (a new Sentry event) for every host that never calls whenSaved().
  // Nothing in 37 waits on it: the forfeit stays fire-and-forget there.
  // Each write resolves true (saved) or false (failed); `keepSave` ANDs them, so
  // whenSaved() is true only when every forfeit so far reached the server. What
  // to do on false (retry, tell the player) is the host's call, not this hook's.
  const pendingSaveRef = useRef(/** @type {Promise<boolean>} */ (Promise.resolve(true)));
  const keepSave = useCallback((/** @type {Promise<any>} */ write) => {
    const settled = Promise.resolve(write).then((ok) => ok === true, () => false);
    const all = Promise.all([pendingSaveRef.current, settled]).then(([a, b]) => a && b);
    pendingSaveRef.current = all;
    return all;
  }, []);
  /** Forfeit saves only. @returns {Promise<boolean>} true iff every forfeit so far saved; never rejects. */
  const whenSaved = useCallback(() => pendingSaveRef.current, []);

  // Recovery (daily-timer): a still-live attempt (forfeited===false, <1hr old)
  // interrupted by a reload / crash / phone-lock. restore() flags it as
  // `recoverable` so the entry screen offers "Continue Daily"; resumeRecovered()
  // re-anchors the wall-clock to the persisted server start and drops the player
  // back in — WITHOUT creating a new attempt row and WITHOUT forfeiting. This
  // replaces the old reload=trap (restore collapsed to not_started, and pressing
  // Start then force-forfeited the live attempt).
  const [recoverable, setRecoverable] = useState(false);
  const recoverableStartedAtRef = useRef(null);

  // Is there a puzzle for (today, this mode) at all?
  //
  // Production carries exactly ONE puzzle per date until the Step-5 cron lands,
  // so Easy's and Expert's Dailies have NO ROW on most dates. P3 removed the
  // client create-if-missing fallback (it authored mode-less rows and is the
  // mechanism behind 44 days of phone-authored puzzles) and left a local roll
  // purely so the screen still renders — but locally-rolled dice match NO other
  // player's board, so a solve on them would be a leaderboard row against a
  // puzzle nobody else played. That must never be startable.
  //
  // `null` means "not looked yet", so the entry screen can tell "unknown" from
  // "known missing" and never flashes an error before it has asked.
  // Mirrored into a ref as well as state: state is for RENDER (the entry screen
  // needs to re-render when the answer changes), the ref is for start(), which
  // reads it in the same tick that fetchTodaysDice() set it — a state read there
  // would see the previous render's closure value and let the start through.
  const [puzzleMissing, setPuzzleMissingState] = useState(null);
  const puzzleMissingRef = useRef(null);
  // A dice READ that failed, which is NOT the same thing as a puzzle that does
  // not exist (puzzleMissing). Kept apart because they need opposite copy — "no
  // puzzle today, try another mode" vs "we could not reach the server, try
  // again" — and because only the second one is worth retrying. See the catch
  // in fetchTodaysDice for why this has to refuse rather than fall back.
  const diceReadFailedRef = useRef(false);
  const setPuzzleMissing = useCallback((v) => {
    puzzleMissingRef.current = v;
    setPuzzleMissingState(v);
  }, []);

  // daily-timer Slice D: the 1-hour hard limit. `timedOut` flips true once the
  // wall-clock reaches DAILY_LIMIT_SECONDS during play — it drives the forfeit/
  // DNF and signals the consumer (Game.jsx) to open the solve-reveal modal.
  const [timedOut, setTimedOut] = useState(false);

  // Timer ticks every 10ms while in_progress, we have a start time, and we're
  // not paused. Stops automatically when status flips, startedAt clears, or
  // the clock is paused.
  useEffect(() => {
    if (status !== 'in_progress' || !startedAt || isPaused) return undefined;
    const interval = setInterval(() => {
      setElapsedSeconds((Date.now() - startedAt) / 1000);
    }, 10);
    return () => clearInterval(interval);
  }, [status, startedAt, isPaused]);

  // Pause the running clock (no-op if not running / already paused). Records the
  // pause instant so resume() can credit the paused span back.
  const pause = useCallback(() => {
    if (pausedAtRef.current != null) return;
    pausedAtRef.current = Date.now();
    setIsPaused(true);
  }, []);

  // Resume the clock (no-op if not paused). Shifts startedAt forward by the
  // paused duration so elapsedSeconds picks up exactly where it left off.
  const resume = useCallback(() => {
    if (pausedAtRef.current == null) return;
    const pausedMs = Date.now() - pausedAtRef.current;
    pausedAtRef.current = null;
    setStartedAt((s) => (s != null ? s + pausedMs : s));
    setIsPaused(false);
  }, []);

  // Enter the running attempt: re-anchor the wall-clock timer to `anchorMs`
  // (the persisted server start, in ms) and mount the playing UI. Shared by a
  // fresh start(), resumeRecovered(), and start()'s in_progress recovery branch
  // — the last two drop the player into a PRE-EXISTING attempt (correct elapsed
  // time from the anchor) rather than creating a new one.
  const enterInProgress = useCallback((anchorMs) => {
    pausedAtRef.current = null;
    setIsPaused(false);
    setTimedOut(false);
    setStartedAt(anchorMs);
    setElapsedSeconds((Date.now() - anchorMs) / 1000);
    setRecoverable(false);
    setStatus('in_progress');
    setShowGame(true);
  }, []);

  // Mount-time state restoration. Mirrors the PRIORITY 1-4 ladder from
  // the old Game.jsx mount-effect verbatim, except `setMode('daily')`
  // is dropped — the caller already knows the user is on the daily
  // route, no mode flip required.
  //
  // PRIORITY 1: user.game_stats.dailyChallengeTimes has today's date
  //             ⇒ completed (regardless of attempt status).
  // PRIORITY 1b (V13 BACKUP): metadata missed it, but a DailyChallengeTime
  //             row exists for today ⇒ completed. A DailyChallengeTime row is
  //             a COMPLETION by construction — forfeits never write one (see
  //             stats-aggregation/dailyForfeits.js). This repairs the "solved
  //             day shows FAILED on the home card" bug: when the stats-write
  //             into game_stats is missed (cross-build / write gap), the
  //             account honestly reports no completion and the attempt-timeout
  //             branch below would otherwise flip it to forfeited. The
  //             leaderboard row is the durable source of truth, so we trust it
  //             BEFORE the recoverable/forfeit ladder.
  // PRIORITY 2: attempt.daily_status === 'in_progress'
  //             ⇒ auto-forfeit (page-refresh-during-game = forfeit).
  // PRIORITY 3: attempt.daily_status === 'forfeited' ⇒ forfeited.
  // PRIORITY 4: attempt.daily_status === 'completed' but no time yet
  //             ⇒ keep status as not_started (race case; should self-
  //             correct when stats sync).
  // FALLBACK : DailyChallengeAttempt query failed but completion
  //            exists in stats ⇒ trust completion.
  // Returns the resolved status string so callers that need to react
  // synchronously (e.g. setMode('daily') for forfeit display) don't
  // have to read the stale-by-closure `status` value.
  // MODE-BLIND-RESTORE — CLOSED by W2-MODES, 2026-08-27.
  //
  // Both entity reads below, and the game_stats fast path above them, used to ask
  // "did this player finish today?" with NO mode. That is fine while 'daily' is
  // the only Daily and stays fine forever for a single instance — but this hook is
  // now mounted ONCE PER MODE, so a mode-blind read means finishing Easy reports
  // Challenge as completed (and locks Challenge's entry button for the day).
  // Same shape as the metadata fast path P1 deleted from viewerGate.js.
  //
  // Three reads, three different rules:
  //
  //   1. game_stats.dailyChallengeTimes  — CHALLENGE'S DAILY ONLY. Lane contract
  //      §3.5 freezes every legacy top-level game_stats key to its current
  //      meaning, and that key has always meant 'daily'. So the fast path is
  //      consulted ONLY when modeKey === 'daily'; for the other two it would be
  //      answering a question about a different board. Skipping it costs one DB
  //      round-trip on Easy/Expert and is the only correct reading.
  //   2. daily_challenge_times   — filtered on `mode`. The column is live on prod
  //      (it is in DAILY_TIME_PUBLIC_COLUMNS, confirmed present before that
  //      shipped).
  //   3. daily_challenge_attempts — filtered on `mode`. P1's migration is applied
  //      to prod: text NOT NULL DEFAULT 'daily', 1144/1144 rows backfilled, so
  //      every pre-existing attempt reads back as Challenge's Daily, which is
  //      exactly what it was.
  const restore = useCallback(async (user) => {
    if (!user) return 'not_started';
    setStatus('loading');
    const today = todayString();
    // See rule 1 above: this blob is Challenge's Daily and nothing else.
    const completedToday = modeKey === DEFAULT_DAILY_MODE
      ? (user.game_stats?.dailyChallengeTimes?.some((t) => t.date === today) || false)
      : false;

    try {
      if (completedToday) {
        // PRIORITY 1 — metadata fast path, no DB round-trip needed.
        setStatus('completed');
        return 'completed';
      }

      // PRIORITY 1b (V13) — metadata didn't record it; confirm against the
      // durable leaderboard table before falling into the forfeit ladder.
      const todayTimes = await apiClient.entities.DailyChallengeTime
        .filter({ date: today, user_id: user.id, mode: modeKey });
      if (todayTimes && todayTimes.length > 0) {
        setStatus('completed');
        return 'completed';
      }

      const todayAttempts = await apiClient.entities.DailyChallengeAttempt
        .filter({ date: today, user_id: user.id, mode: modeKey });

      if (todayAttempts.length > 0) {
        const attempt = todayAttempts[0];
        // The attempts table tracks a single `forfeited` boolean — there is no
        // `daily_status`/`session_token` column. The old field names never
        // matched the real schema, so a forfeit was silently undetected on
        // mount and the Daily Challenge button stayed clickable after a forfeit
        // (you'd play an ad + read the rules only to hit "failed"). A forfeited
        // row means today's challenge is spent.
        if (attempt.forfeited === true) {
          // PRIORITY 3
          setStatus('forfeited');
          return 'forfeited';
        }
        // forfeited === false ⇒ a still-live attempt (or an unsynced
        // completion). If it's a genuine in-progress attempt still under the
        // 1-hour cap, mark it RECOVERABLE so the entry screen offers
        // "Continue Daily" instead of trapping the player (the status stays
        // not_started so the launcher renders its entry button, just relabelled).
        // `created_at` is the persisted server start. A missing timestamp or an
        // attempt already ≥1hr old falls through to a plain not_started; the
        // ≥1hr timeout outcome is handled by the timer slice.
        const createdMs = attempt.created_at ? new Date(attempt.created_at).getTime() : NaN;
        if (Number.isFinite(createdMs)) {
          if (Date.now() - createdMs < DAILY_LIMIT_MS) {
            recoverableStartedAtRef.current = createdMs;
            setRecoverable(true);
          } else {
            // Slice D: the attempt's 1-hour clock already ran out while the app
            // was closed — it is NOT resumable, it resolves straight to the
            // timeout/DNF outcome. Persist the forfeit (token 'unknown' is
            // tolerated — the backend resolves the attempt by the authed user +
            // today's date) and present today as spent, with solutions available.
            keepSave(Promise.resolve(forfeitDailyChallengeAttempt({ sessionToken: null, mode: modeKey }))
              .then((r) => {
                if (!r?.success) { console.error('Timeout forfeit failed:', r?.error); return false; }
                return true;
              })
              .catch((e) => { console.error('Timeout forfeit failed:', e); return false; }));
            setStatus('forfeited');
            return 'forfeited';
          }
        }
      }
      setStatus('not_started');
      return 'not_started';
    } catch (error) {
      console.error('Failed to check daily challenge attempts:', error);
      // FALLBACK: trust completion if API failed mid-restore.
      const fallback = completedToday ? 'completed' : 'not_started';
      setStatus(fallback);
      return fallback;
    }
  }, [modeKey, keepSave]);

  // Today's dice — cached. Used both by start() (which needs dice to
  // hand back to the caller) and by handleNewGame in Game.jsx (which
  // fetches dice without starting a new attempt).
  const fetchTodaysDice = useCallback(async () => {
    const today = todayString();
    // Keyed `${date}:${mode}`, not `${date}`. With three Dailies a date-only key
    // would serve whichever mode asked first to every other mode — the player
    // would play Easy's dice on Expert's board.
    const cacheKey = `${today}:${modeKey}`;
    diceReadFailedRef.current = false;
    if (diceCacheRef.current[cacheKey]) {
      setPuzzleMissing(false);
      return diceCacheRef.current[cacheKey];
    }
    if (!isKnownModeKey(modeKey) || !isDaily(modeKey)) {
      // Not coerced (see the hook's doc comment) — named, so the typo is visible.
      console.error(`useDailyChallengeAttempt: '${modeKey}' is not a daily mode key`);
    }
    try {
      const existing = await apiClient.entities.DailyChallenge.filter({
        date: today,
        // Never omitted. `daily_challenges` is keyed (date, mode) since the Slice
        // 4 migration; without this a three-row date hands back an arbitrary
        // mode's dice, because the read is unordered.
        mode: modeKey,
      });
      if (existing.length > 0) {
        const storedDice = existing[0].dice;
        // Materialise stable IDs so the dice list has stable React keys. The id
        // carries the mode too: two modes' dice can be mounted in one React tree,
        // and ids that collided across them would collide in the shuffle.
        const diceWithIds = storedDice.map((value, index) => ({
          id: existing[0].diceIds?.[index] || `die_${today}_${modeKey}_${index}`,
          value,
          originalIndex: index,
        }));
        diceCacheRef.current[cacheKey] = diceWithIds;
        setPuzzleMissing(false);
        return diceWithIds;
      }
      // No row for (today, mode).
      //
      // There used to be a create-if-missing fallback here: the client rolled its
      // own dice and INSERTED them. It is deleted, and the deletion is the point.
      // It wrote a MODE-LESS row, so a missing Easy puzzle would silently author a
      // second Challenge one. It is also the mechanism behind 44 days of
      // phone-authored puzzles, and Slice 5 made the generator the only author.
      // A missing puzzle is now loud instead of papered over — which is what
      // supabase/functions/_shared/dailyCoverage.ts exists to alarm on.
      //
      // The local roll is kept ONLY so the screen still renders: the consumer
      // (pages/Game.jsx, W2-MODES' file) maps over the returned dice and would
      // crash on null. Making the failure reach the player as a message rather
      // than a console line needs a branch in that file. See the P3 lane report.
      console.error(
        `No daily challenge row for ${today} (${modeKey}) — the generator did not `
        + 'stock this day. Falling back to locally-rolled dice, which will NOT '
        + 'match any other player\'s board.',
      );
      // NOT cached, and flagged. Caching a local roll would make the miss look
      // like a real puzzle for the rest of the session, and start() reads this
      // flag to refuse rather than burn the player's one attempt of the day on
      // a board no one else is playing.
      setPuzzleMissing(true);
      return generateDailyDice();
    } catch (error) {
      // A failed READ is not the same as a confirmed absence, so puzzleMissing is
      // left alone: we must not tell the player a puzzle does not exist when we
      // simply could not ask.
      //
      // What this branch must NEVER do is let the player PLAY the locally-rolled
      // dice below. They are seven Math.random() values — the right shape for a
      // board and matched to nobody else's, so the player solves a private puzzle
      // that is not that day's Daily, against a real attempt row. That is the
      // 2026-09-16 'math whiz' report: a slow network, a double-tapped Start, and
      // a Challenge Daily that was not the day's puzzle.
      //
      // So the read failure is RECORDED and start()/resumeRecovered() refuse on
      // it. The local roll is still returned, because the recap path
      // (loadTodaysStatsRecap) maps over the result and would crash on null; it
      // just never reaches a playable board any more.
      diceReadFailedRef.current = true;
      reportSolveFailure(SOLVE_STAGE.diceRead, error, { mode: modeKey });
      return generateDailyDice();
    }
  }, [modeKey]);

  // Shown when the dice read failed. Deliberately different from the
  // "Today's puzzle isn't ready" copy, which claims knowledge we do not have.
  const DICE_UNAVAILABLE_MESSAGE =
    "Couldn't load today's puzzle — check your connection and try again. "
    + 'Your attempt has not been used.';

  // Start an attempt. Pre-checks status, deals with stale in_progress
  // by forfeiting+bailing, then runs the start+dice fetch in parallel.
  //
  // Returns { ok, dice } — when ok is true, dice is the rich
  // { id, value, originalIndex }[] for today and status has flipped to
  // 'in_progress'. When ok is false, status has flipped to whatever
  // terminal value the pre-check or start-failure surfaced
  // (completed/forfeited).
  const runStart = useCallback(async () => {
    // PRE-CHECK to avoid 400-style errors.
    const statusResult = await getDailyChallengeStatus({ mode: modeKey });
    if (statusResult.success) {
      const backendStatus = statusResult.data?.status;
      if (backendStatus === 'completed') {
        setStatus('completed');
        setShowStartWarning(false);
        return { ok: false, dice: null, reason: 'completed' };
      }
      if (backendStatus === 'forfeited') {
        setStatus('forfeited');
        setShowStartWarning(false);
        return { ok: false, dice: null, reason: 'forfeited' };
      }
      if (backendStatus === 'in_progress') {
        // RECOVER rather than force-forfeit (daily-timer design): a live attempt
        // means the player is mid-challenge — re-anchor to the server start and
        // drop them back in instead of destroying their day. Normally the entry
        // screen already routes them through "Continue Daily" (resumeRecovered);
        // this is the defensive path if Start is somehow reached with a live
        // attempt (e.g. a second tab).
        const dice = await fetchTodaysDice();
        if (diceReadFailedRef.current) {
          // Refuse rather than drop them onto a private board mid-attempt.
          alert(DICE_UNAVAILABLE_MESSAGE);
          setShowStartWarning(false);
          return { ok: false, dice: null, reason: 'dice_unavailable' };
        }
        // `attempt_started_at` FIRST, because that is the key the controller
        // actually sends on the 'status' action (daily-challenge-controller
        // :830, :841). It was absent here, so every key missed, `anchorMs` was
        // NaN, and the branch fell through to `Date.now()` — re-anchoring a
        // resumed Daily to the moment of resume while the comment above
        // promised the server start. The other two keys are the `start`
        // action's shape (:355, :368) and are kept so one reader serves both.
        const startedIso = statusResult.data?.attempt_started_at
          || statusResult.data?.started_at
          || statusResult.data?.created_at;
        const anchorMs = startedIso ? new Date(startedIso).getTime() : NaN;
        enterInProgress(Number.isFinite(anchorMs) ? anchorMs : Date.now());
        setShowStartWarning(false);
        return { ok: true, dice };
      }
      // 'not_started' — fall through.
    } else {
      console.warn('Status pre-check failed, proceeding with start:', statusResult.error);
    }

    // Dice FIRST, then the attempt — deliberately serial, and the ordering is
    // the whole point.
    //
    // These used to run in parallel, which was right while every date was
    // guaranteed a puzzle. It is wrong now: production carries one puzzle per
    // date until the Step-5 cron lands, so Easy's and Expert's Dailies have no
    // row on most dates. In parallel, the controller would CREATE the attempt
    // row — spending the player's single attempt for the day — and only then
    // would we discover there is nothing to play. The day would be gone, on a
    // mode that never existed. Asking first costs one round-trip of latency and
    // cannot spend anything.
    const dice = await fetchTodaysDice();
    if (puzzleMissingRef.current) {
      setShowStartWarning(false);
      return { ok: false, dice: null, reason: 'no_puzzle' };
    }
    // Same ordering argument as puzzleMissing: this runs BEFORE
    // startDailyChallengeAttempt, so refusing costs the player nothing. Their one
    // attempt of the day is still intact and they can simply tap again.
    if (diceReadFailedRef.current) {
      alert(DICE_UNAVAILABLE_MESSAGE);
      setShowStartWarning(false);
      return { ok: false, dice: null, reason: 'dice_unavailable' };
    }

    const startResult = await startDailyChallengeAttempt({ mode: modeKey });

    if (!startResult.success) {
      // Domain failures carry status context.
      const ctxStatus = startResult.context?.status;
      if (ctxStatus === 'completed' || startResult.error.code === 'already_completed') {
        setStatus('completed');
      } else if (ctxStatus === 'forfeited' || startResult.error.code === 'already_forfeited') {
        setStatus('forfeited');
      } else {
        alert(`Could not start Daily Challenge: ${startResult.error.message}. Please try again.`);
      }
      setShowStartWarning(false);
      return { ok: false, dice: null };
    }

    // Success — record token, anchor the clock to the SERVER's start.
    //
    // ⚠️ NOT `Date.now()`, and this is not the same bug as the one fixed at the
    // in_progress pre-check above — it is its twin, on the path that runs when
    // the pre-check never answered. `start` does not always mean "a new attempt
    // began": when a row already exists the controller returns THAT ROW's
    // `created_at` as `started_at` (daily-challenge-controller:368-372) and
    // reports success. So this path can be handed a start from hours ago and,
    // by anchoring to now, show a clock that begins at zero for an attempt the
    // referee already considers expired. That is what showed delaney-37 a
    // 146-second timer for an attempt `submit-daily-time` measured at 7h40m,
    // and then refused.
    //
    // On a genuinely fresh insert the controller sends the timestamp it took
    // right after the insert (:384), which is the row's `created_at` to within
    // microseconds — so this is also STRICTLY more accurate than the local
    // clock, which starts only once the round trip returns.
    sessionTokenRef.current = startResult.data?.session_token || null;
    const serverStartMs = new Date(startResult.data?.started_at ?? '').getTime();
    enterInProgress(Number.isFinite(serverStartMs) ? serverStartMs : Date.now());
    setShowStartWarning(false);
    return { ok: true, dice };
  }, [fetchTodaysDice, enterInProgress, modeKey]);

  // SINGLE-FLIGHT. A second call while one is running joins the first instead of
  // racing it.
  //
  // Without this, two overlapping starts each ran their own status pre-check and
  // their own dice read, then each resolved with their own dice array — and the
  // caller entered the board with whichever landed LAST. Two reads also means two
  // chances to hit the failure path above, so a double tap did not merely
  // duplicate work, it roughly doubled the odds of the bad outcome and then
  // handed it the final say.
  //
  // The UI guard in ChallengeWarningModal is the other half of this fix; this is
  // the half that holds for every caller, including any future one that never
  // goes through that modal.
  const startInFlightRef = useRef(/** @type {Promise<any>|null} */ (null));
  const start = useCallback(() => {
    if (startInFlightRef.current) return startInFlightRef.current;
    const inFlight = runStart()
      .then((res) => {
        track('daily.start', { mode: modeKey, outcome: res?.ok ? 'ok' : 'blocked', reason: res?.reason ?? null });
        return res;
      })
      .finally(() => { startInFlightRef.current = null; });
    startInFlightRef.current = inFlight;
    return inFlight;
  }, [runStart, modeKey]);

  // Resume a RECOVERABLE attempt (see restore()): re-anchor the clock to the
  // attempt's persisted server start and drop the player back into the running
  // game. No new attempt row, no forfeit — the honest player who reloaded keeps
  // their correct elapsed time. Returns { ok, dice } like start() so the caller
  // wires the dice into its game state the same way.
  const resumeRecovered = useCallback(async () => {
    const anchorMs = recoverableStartedAtRef.current;
    if (anchorMs == null) return { ok: false, dice: null };
    const dice = await fetchTodaysDice();
    if (diceReadFailedRef.current) {
      alert(DICE_UNAVAILABLE_MESSAGE);
      return { ok: false, dice: null, reason: 'dice_unavailable' };
    }
    enterInProgress(anchorMs);
    track('daily.resume', { mode: modeKey });
    return { ok: true, dice };
  }, [fetchTodaysDice, enterInProgress, modeKey]);

  // Submit a completed solution. Fire-and-forget against the backend
  // (the leaderboard entity is written separately by the caller; this
  // edge call is secondary validation). Status flips to 'completed'
  // and the timer stops.
  const submit = useCallback(({
    solveTimeSeconds,
    equation,
    usedDiceIndices,
    diceColors,
    shuffledDice,
  }) => {
    track('daily.submit', { mode: modeKey });
    const sessionToken = sessionTokenRef.current;
    if (sessionToken) {
      submitDailyChallengeSolution({
        sessionToken,
        mode: modeKey,
        solveTimeSeconds,
        equation,
        usedDiceIndices,
        diceColors,
        shuffledDice,
      }).then((result) => {
        if (!result.success) {
          console.error('Failed to submit to controller:', result.error);
        }
      });
    }
    pausedAtRef.current = null;
    setIsPaused(false);
    setStatus('completed');
    setShowGame(false);
  }, [modeKey]);

  // Forfeit the current attempt. Fire-and-forget against the backend. Always
  // attempts the backend forfeit so the DNF is persisted even when we've lost
  // the session token — e.g. a recovered attempt (resumeRecovered sets no token)
  // that then hits the Slice-D 1-hour timeout. The wrapper coerces a falsy token
  // to the literal 'unknown', which the backend tolerates (it resolves the
  // attempt by the authed user + today's date).
  // Returns whenSaved() — existing callers ignore it; a host that must not move
  // on before the DNF is persisted awaits it.
  const forfeit = useCallback(() => {
    track('daily.forfeit', { mode: modeKey });
    const saved = keepSave(forfeitDailyChallengeAttempt({ sessionToken: sessionTokenRef.current, mode: modeKey })
      .then((result) => {
        if (!result?.success) {
          console.error('Forfeit failed:', result?.error);
          return false;
        }
        return true;
      })
      .catch((e) => { console.error('Forfeit failed:', e); return false; }));
    pausedAtRef.current = null;
    setIsPaused(false);
    setStatus('forfeited');
    setStartedAt(null);
    setElapsedSeconds(0);
    setShowGame(false);
    setShowExitWarning(false);
    return saved;
  }, [modeKey, keepSave]);

  // Slice D — 1-hour hard limit. Once the live wall-clock reaches
  // DAILY_LIMIT_SECONDS, the attempt times out: flag `timedOut` (so Game.jsx can
  // open the solve-reveal) and run the SAME forfeit path as a voluntary forfeit
  // (edge call + status→forfeited + timer reset) so the DNF bookkeeping — streak
  // reset, lost perfect-streak, counts-as-attempt-not-completion — is identical.
  // Guarded by `timedOut` so it fires exactly once. Enforced client-side this
  // session; the server-side 1-hour/solve-time check is Track B (W4-HIGH).
  useEffect(() => {
    if (status === 'in_progress' && startedAt && !isPaused
        && elapsedSeconds >= DAILY_LIMIT_SECONDS && !timedOut) {
      track('daily.timeout', { mode: modeKey });
      setTimedOut(true);
      forfeit();
    }
  }, [status, startedAt, isPaused, elapsedSeconds, timedOut, forfeit, modeKey]);

  // Clear the running-game flags. Used by SuccessModal close
  // handlers — doesn't change status (caller already flipped it to
  // 'completed' via submit()).
  const reset = useCallback(() => {
    pausedAtRef.current = null;
    setIsPaused(false);
    setTimedOut(false);
    setStartedAt(null);
    setElapsedSeconds(0);
    setShowGame(false);
  }, []);

  // Slice D — seconds left before the 1-hour wall (derived from the same
  // wall-clock elapsed, so it's correct after any reload). `showCountdown`
  // turns true for the final COUNTDOWN_SECONDS so the game screen can surface a
  // prominent 10→0 countdown (59:50 → 60:00).
  const isLive = status === 'in_progress' && startedAt != null;
  const remainingSeconds = isLive
    ? Math.max(0, DAILY_LIMIT_SECONDS - elapsedSeconds)
    : DAILY_LIMIT_SECONDS;
  const showCountdown = isLive && remainingSeconds <= COUNTDOWN_SECONDS;

  const openStartWarning = useCallback(() => setShowStartWarning(true), []);
  const closeStartWarning = useCallback(() => setShowStartWarning(false), []);
  const openExitWarning = useCallback(() => setShowExitWarning(true), []);
  const closeExitWarning = useCallback(() => setShowExitWarning(false), []);

  return {
    // state-machine state
    status,
    startedAt,
    elapsedSeconds,
    isPaused,
    // recovery (involuntary-interruption) — entry screen offers "Continue Daily"
    recoverable,
    // Is there a puzzle for (today, this mode)? null until we have looked.
    puzzleMissing,
    // 1-hour hard limit (Slice D)
    remainingSeconds,
    showCountdown,
    timedOut,
    // modal flags
    showStartWarning,
    showExitWarning,
    showGame,
    // lifecycle methods
    restore,
    start,
    resumeRecovered,
    submit,
    forfeit,
    whenSaved,
    reset,
    pause,
    resume,
    fetchTodaysDice,
    // modal toggles
    openStartWarning,
    closeStartWarning,
    openExitWarning,
    closeExitWarning,
  };
}
