import React, { useEffect, useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { MIRROR_TARGET } from './mirror';
import { prefersReducedMotion } from './fx';

// The Mirror's near-miss glint (sweep SW13, David 2026-10-05). When a locked player's Daily
// board reads 73 with FEWER than all 7 dice, the equation area gives one quick mirror shimmer.
// Nothing is explained — an Outer-Wilds-style "something's here" for the curious. It never
// blocks taps and never repeats until the board leaves 73 and comes back.

/** Does the board read 73 without using every die? (A full 73 is the real Mirror.) */
export const isMirrorNearMiss = ({ valid, result, usedDiceIndices }) =>
  Boolean(valid && result === MIRROR_TARGET && Array.isArray(usedDiceIndices)
    && usedDiceIndices.length > 0 && usedDiceIndices.length < 7);

export function MirrorGlint({ active }) {
  const [shine, setShine] = useState(0);
  const was = useRef(false);
  useEffect(() => {
    if (active && !was.current && !prefersReducedMotion()) setShine((n) => n + 1); // rising edge only
    was.current = active;
  }, [active]);
  if (!shine) return null;
  return (
    <div className="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl" aria-hidden="true" data-testid="mirror-glint">
      <motion.div
        key={shine}
        className="absolute -inset-y-4 w-1/3"
        style={{ background: 'linear-gradient(105deg, transparent, rgba(233,213,255,0.55), rgba(255,255,255,0.8), rgba(196,181,253,0.4), transparent)' }}
        initial={{ x: '-120%', opacity: 0 }}
        animate={{ x: '360%', opacity: [0, 1, 1, 0] }}
        transition={{ duration: 0.7, ease: 'easeInOut' }}
      />
    </div>
  );
}
