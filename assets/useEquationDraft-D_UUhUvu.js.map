// segmentNumberDice — pure "touching dice" tokenizer (R5-rem).
//
// A contiguous run of digits in the equation can stand for MORE than one die:
// placing die `3` next to die `7` reads as the single number "37". The builder
// needs to know, for a given digit run, exactly which placed dice it consumes
// so it can colour + outline each die separately. This is the pure core of that
// decision, lifted out of EquationBuilder's render walk so it can be unit-tested
// on its own. No React, no DOM — safe alongside the rest of equation-engine.
//
// It walks `numStr` left-to-right, greedily matching each remaining prefix
// against the value of the next unused die (dice are consumed in placement
// order via `usedDiceIndices`). It stops at the first die whose value is NOT a
// prefix of what's left, or when the string is fully consumed / dice run out.

/**
 * @typedef {object} DiceSegment
 * @property {number} diceIndex - index into the dice value array
 * @property {string} value - the die's value as a string (what it contributes)
 * @property {number} usedIndex - the die's slot in placement order (usedDiceIndices)
 */

/**
 * Segment a digit run into the consecutive placed dice it represents.
 *
 * `diceValues` is indexed by dice index (i.e. `diceValues[usedDiceIndices[n]]`),
 * matching the builder's `tutorialDiceValues || dice` array. `startDiceIndex`
 * is the running cursor into `usedDiceIndices` — the caller threads it across
 * the whole equation so each number starts where the previous one left off.
 *
 * @param {string} numStr - the contiguous digit run from the equation
 * @param {number[]} usedDiceIndices - placement order → dice-array index
 * @param {Array<number|string>} diceValues - dice values, indexed by dice index
 * @param {number} startDiceIndex - cursor into usedDiceIndices to start matching at
 * @returns {{ segments: DiceSegment[], touchingCount: number, remaining: string, nextDiceIndex: number }}
 */
export const segmentNumberDice = (numStr, usedDiceIndices, diceValues, startDiceIndex) => {
  const segments = [];
  let remaining = numStr;
  let diceCursor = startDiceIndex;
  let touchingCount = 0;

  while (remaining.length > 0 && diceCursor < usedDiceIndices.length) {
    const diceIndex = usedDiceIndices[diceCursor];
    const value = diceValues[diceIndex].toString();

    if (remaining.startsWith(value)) {
      segments.push({ diceIndex, value, usedIndex: diceCursor });
      remaining = remaining.slice(value.length);
      diceCursor++;
      touchingCount++;
    } else {
      break;
    }
  }

  return { segments, touchingCount, remaining, nextDiceIndex: diceCursor };
};
