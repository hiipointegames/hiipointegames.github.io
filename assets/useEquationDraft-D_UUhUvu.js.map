import React from 'react';
import { playSound, formatSolveTime, useSoundMute } from '@/ui/feedback';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { CheckCircle, LogOut, Volume2, VolumeX } from 'lucide-react';
import { DiceDisplay } from '@/puzzle-input';
import { EquationBuilder } from '@/puzzle-input';
import { OperatorPad } from '@/puzzle-input';
import { evaluateEquation, validateChallengeModeRules, collectDraftErrors, getPowerDiceCorrectness, isSubmittableSolution, requiredPowerDiceCount } from '@/equation-engine';
import { SHOW_SHUFFLE_BUTTON } from '@/game-mechanics';
import { POWER_DIE_FACE } from '@/dice-visuals';
import { HowToOverlay } from '@/how-to-play';
import { isDaily, isPractice, hasPowerDice, modeTierLabel } from '@/game-modes';
import { lockScroll } from '@/shell';
import { HelpCircle } from 'lucide-react';
import { modeAccentToken } from '@/game-flow/modeTheme';
import { isWarpSubmittable, ALREADY_UNLOCKED_MESSAGE, MirrorGlint, isMirrorNearMiss } from '@/sector73';

export default function DailyChallengeGame({
  dice,
  diceColors,
  equation,
  usedDiceIndices,
  solved,
  dailyChallengeTimer,
  onDiceClick,
  onOperatorClick,
  onDelete,
  onClear,
  onSubmit,
  showColorRuleError,
  shakeButton,
  showTryAgain,
  mode = 'daily',
  cursorPosition,
  onCursorPositionChange,
  onExit,
  onRollNewDice,
  onShuffle,
  equationsSolved = 0,
  shuffledDice,
  timerMaxDuration = undefined,
  // Slice D — the daily 1-hour hard limit. `showCountdown` turns true for the
  // final 10 seconds; `remainingSeconds` is the live seconds-left so this screen
  // can surface a prominent 10→0 countdown (59:50 → 60:00) before the timeout.
  showCountdown = false,
  remainingSeconds = undefined,
  // F4 / item 9 + 15a: the in-game How-To-Play overlay no longer pauses the clock.
  // Pausing on open was a timer-pause exploit AND — on the daily game screen — the
  // reason the overlay failed to open at all (the pause state-change interrupted
  // the open), so it was removed (July-2 prompt list). Game.jsx still passes
  // onPauseTimer/onResumeTimer; they're intentionally not consumed here anymore
  // (the pause/resume primitive is kept in useDailyChallengeAttempt for future use).
  // F5: which per-mode neon accent to wear (drives --u37-mode-accent via the
  // [data-mode] rules in tokens.css). Defaults to `mode` (easy/challenge/daily);
  // the Blitz Colosseum passes 'solo-blitz' / 'blitz-battle' so its variants ride
  // the Blitz color rather than the easy/challenge color.
  themeMode,
  // What a 73 does on this Daily (useMirrorWarp's `board`): 'open' — a first 73
  // submits; 'used' — already crossed, refused with the "Coordinates already
  // logged" line; 'off' — a guest (David, 2026-10-19: Sector 73 needs a username
  // + password), so a 73 is just another wrong total: no warp, no glint, no copy.
  // Defaults to 'off' — Sector 73 switched off — so a host that doesn't wire it is the 37 Daily.
  sector73Mirror = 'off',
  // The Sector 73 host's cosmic look ('sector73'): data-skin + data-part on the
  // scrim and the card, recoloured by that mode's own CSS. Absent in 37.
  skin = undefined,
}) {
  const accentMode = themeMode || mode;

  // Only the blitz surfaces — see the label's own comment in the status bar.
  const playModeLabel = themeMode === 'blitz-battle'
    ? `${modeTierLabel(mode)} Battle`
    : themeMode === 'solo-blitz'
      ? `${modeTierLabel(mode)} Solo Blitz`
      : null;
  // Shared mute preference — the in-game speaker toggle (daily lockdown) drives
  // the SAME state as the drawer's Mute Sound (which is hidden mid-daily).
  const { muted, toggleMute } = useSoundMute();
  const [shuffleLockedRef] = React.useState({ locked: false });
  const [exitLockedRef] = React.useState({ locked: false });
  const [rollLockedRef] = React.useState({ locked: false });
  const [submitLockedRef] = React.useState({ locked: false });
  const [showHowTo, setShowHowTo] = React.useState(false);

  const openHowTo = () => {
    // No pause here (item 9 + 15a): opening help must not touch the clock. The
    // clock keeps running while help is open — reading the rules is not a way to
    // stop the timer.
    setShowHowTo(true);
  };
  const closeHowTo = () => {
    setShowHowTo(false);
  };

  // The "?" and mute buttons live inside the scrollable board container. With
  // plain onClick, a tap there can be swallowed as the start of a scroll gesture
  // on mobile WebViews, so the button appears dead (Bryce, Daily on 1.0.251 —
  // and it's the same on every mode, since this component is shared). Fire on
  // pointerDown like every other control in here (exit/shuffle/roll/submit), and
  // preventDefault so the follow-up synthetic click can't double-fire (which
  // would toggle mute twice back to where it started).
  const handleHowToClick = (e) => {
    e.preventDefault();
    e.stopPropagation();
    openHowTo();
  };
  const handleMuteClick = (e) => {
    e.preventDefault();
    e.stopPropagation();
    toggleMute();
  };

  const handleShuffleClick = (e) => {
    if (shuffleLockedRef.locked || solved || !onShuffle) return;
    e.preventDefault();
    e.stopPropagation();

    shuffleLockedRef.locked = true;
    onShuffle();

    setTimeout(() => {
      shuffleLockedRef.locked = false;
    }, 50);
  };

  const handleExitClick = (e) => {
    if (exitLockedRef.locked || !onExit) return;
    e.preventDefault();
    e.stopPropagation();

    // The daily "Forfeit & See Solves" button keeps its punch SFX — that button
    // IS the forfeit, and the sound is the point.
    //
    // The generic exit (practices, solo Blitz, battles) used to be deliberately
    // SILENT. David, 2026-09-12: give it the app's standard tap sound, like every
    // other control. It gets `buttonTap` rather than `punch` so leaving a
    // practice round never sounds like forfeiting a Daily.
    //
    // After the lock guard, so a rapid double-tap cannot double-play either.
    playSound(isDaily(mode) ? 'punch' : 'buttonTap');

    exitLockedRef.locked = true;
    onExit();

    setTimeout(() => {
      exitLockedRef.locked = false;
    }, 50);
  };

  const handleRollClick = (e) => {
    if (rollLockedRef.locked || !onRollNewDice) return;
    e.preventDefault();
    e.stopPropagation();

    rollLockedRef.locked = true;
    if (isPractice(mode)) {
      playSound('shorterDiceRoll');
    }
    onRollNewDice();

    setTimeout(() => {
      rollLockedRef.locked = false;
    }, 50);
  };

  const handleSubmitClick = (e) => {
    if (submitLockedRef.locked || !canSubmit) return;
    e.preventDefault();
    e.stopPropagation();

    submitLockedRef.locked = true;
    onSubmit();

    setTimeout(() => {
      submitLockedRef.locked = false;
    }, 50);
  };
  // Freeze the background (the #root launcher) while the in-play overlay is up.
  // Uses lockScroll() — which locks the #root scroll container, NOT
  // document.body { position: fixed } — so the how-to overlay portaled to <body>
  // stays tappable on iOS (the body-fixed pattern offsets fixed-child hit regions
  // on WKWebView; RC1, 2026-07-08 audit). This overlay is `fixed inset-0` with its
  // own inner scroll, so #root overflow:hidden doesn't touch it.
  React.useEffect(() => lockScroll(), []);
  const formatTime = (seconds) => {
    // If timer is 0 but has max duration, display max duration (e.g., for completed blitz games)
    if (seconds === 0 && timerMaxDuration !== undefined) {
      return formatSolveTime(Math.floor(timerMaxDuration));
    }
    return formatSolveTime(seconds);
  };

  const builtShuffledDice = shuffledDice || dice.map((value, idx) => ({
    value,
    color: diceColors[idx] || 'white',
    originalIndex: idx,
    id: idx
  }));

  const { valid, result } = evaluateEquation(equation, usedDiceIndices, builtShuffledDice);
  const isComplete = usedDiceIndices.length === 7;
  // Structural errors block Submit (but never editing). Once editing is free,
  // touching dice / adjacent operators / unbalanced parens can REST in the
  // draft, so Submit must check them explicitly — `valid` alone misses fused dice.
  const draftErrors = collectDraftErrors(equation, usedDiceIndices);
  const challengeRulesMet = hasPowerDice(mode) && dice.length === 7 && equation
    ? validateChallengeModeRules(equation, usedDiceIndices, dice, diceColors, mode)
    : true;
  // Shared win gate + this surface's liveness guard (not already solved).
  // Sector 73's Mirror: in a Daily, a 73 using all seven dice (no power-dice
  // rule) is submittable — once. After the unlock it is refused in place.
  const mirrorOn = isDaily(mode) && sector73Mirror !== 'off';
  const warpReady = mirrorOn && isWarpSubmittable({ valid, result, usedDiceIndices, draftErrors });
  const warpOpen = warpReady && sector73Mirror === 'open';
  const warpRefused = warpReady && sector73Mirror === 'used';
  const canSubmit = (isSubmittableSolution({ valid, result, usedDiceIndices, challengeRulesMet, draftErrors }) || warpOpen) && !solved;

  // Power-dice mode shows a slim reminder legend with a live "N/3 used correctly"
  // count (challenge/daily). Helper returns an empty Map for empty/invalid input.
  const showPowerReminder = hasPowerDice(mode);
  const powerCorrectCount = showPowerReminder
    ? [...getPowerDiceCorrectness(equation, usedDiceIndices, diceColors).values()].filter(Boolean).length
    : 0;
  // How many this MODE actually demands: Challenge 2, Expert 3. The counter and
  // the error copy below both used to assume 2, so an Expert player was told to
  // "use at least 2" while the gate silently wanted 3, and a Challenge player
  // sitting on a sufficient 2/3 read it as a shortfall.
  const requiredPower = requiredPowerDiceCount(mode);
  const powerSatisfied = powerCorrectCount >= requiredPower;
  // Timer lives in the top status bar now (timed modes only: daily + blitz/battle,
  // which have no Roll-New-Dice). Easy/Challenge are untimed → no timer.
  const showTimer = dailyChallengeTimer !== undefined && !onRollNewDice;
  // Mode accent for the Roll-New-Dice CTA. Was `=== 'challenge' ? cyan : green`,
  // which painted the EXPERT practice board's roll button green — Easy's colour.
  // `dailyModeAccent` knows all three tiers and coerces an unknown key to Easy.
  const rollAccent = modeAccentToken(mode);

  return (
    <div data-skin={skin} data-part={skin ? 'scrim' : undefined} className="fixed inset-0 z-[100] bg-black/80 backdrop-blur-sm overflow-hidden" style={{ WebkitOverflowScrolling: 'touch' }}>
      {/* Bottom region keeps its 130px ad clearance via the scroll region's height
          calc below (NOT a visual bar); top padding extends by the status-bar/notch
          inset so the exit button + timer never sit under the phone's status icons.
          Decorative shadow/buffer bars removed (2026-06-29, FU-1) so the bottom of
          the board is no longer dimmed by a fade overlay — clearance unchanged. */}
      <div className="overflow-y-auto px-3 scroll-edge-fade-bottom" style={{ height: 'calc(100dvh - var(--ad-reserved-bottom) - var(--safe-bottom))' }}>
        {/* No-scroll gameplay (F3): the board is vertically CENTERED when it fits
            (real phone portrait) and scrolls without clipping the top when it
            doesn't (very short desktop windows) — the canonical min-h-full +
            justify-center pattern. Replaces the old fixed 140px top pad that pushed
            the operators/builder/Submit below the fold. */}
        <div className="min-h-full flex flex-col items-center justify-center" style={{ paddingTop: 'calc(12px + var(--safe-top))', paddingBottom: '12px' }}>
        {/* F5: per-mode neon theming. data-mode sets --u37-mode-accent (tokens.css)
            for this subtree; the card wears that accent as a neon outline + soft
            glow. Easy=green · Challenge=cyan (Daily included) · Solo Blitz=blue ·
            Blitz Battle=magenta. Gold + dice colors stay constant. */}
        <div
          data-mode={accentMode}
          data-skin={skin}
          data-part={skin ? 'card' : undefined}
          className="w-full max-w-lg bg-gradient-to-b from-slate-900 via-slate-900 to-indigo-950 rounded-3xl border-2 shadow-2xl p-3 relative"
          style={{ borderColor: 'var(--u37-mode-accent)', boxShadow: '0 0 28px -10px var(--u37-mode-accent)' }}
        >
          {/* Top status bar — exit (left) + mode (centre) + timer (right). */}
          <div data-testid="region-status" className="flex items-center justify-between gap-2 mb-2 min-h-[28px]">
            <div className="flex items-center gap-1">
              {onExit ? (
                isDaily(mode) ? (
                  // Daily lockdown: the ONLY way out is this explicit forfeit,
                  // which reveals today's solutions. Game.jsx wires onExit to the
                  // forfeit-confirm → SuccessModal solve-reveal path.
                  <button
                    onPointerDown={handleExitClick}
                    aria-label="Forfeit and see solutions"
                    className="flex items-center gap-1.5 text-rose-200 hover:text-white transition-colors z-10 active:scale-95 touch-manipulation rounded-lg px-2.5 py-1.5 min-h-[34px] border border-rose-400/60"
                    style={{
                      WebkitTapHighlightColor: 'transparent',
                      background: 'color-mix(in srgb, #f43f5e 14%, transparent)',
                      boxShadow: '0 0 14px -5px #f43f5e',
                    }}
                  >
                    <LogOut className="w-[18px] h-[18px]" />
                    <span className="text-[13px] font-bold">Forfeit &amp; See Solves</span>
                  </button>
                ) : (
                  <button
                    onPointerDown={handleExitClick}
                    aria-label="Exit"
                    className="grid place-items-center w-9 h-9 rounded-lg text-slate-100 hover:text-white transition-colors z-10 active:scale-95 touch-manipulation border border-white/25"
                    style={{
                      WebkitTapHighlightColor: 'transparent',
                      background: 'rgba(255,255,255,0.07)',
                    }}
                  >
                    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                )
              ) : null}
              {/* F4: in-game How-To-Play — available in every session. Opening it
                  does NOT pause the clock (item 9 + 15a); see openHowTo. */}
              <button
                type="button"
                onPointerDown={handleHowToClick}
                aria-label="How to play"
                // Color the "?" help affordance to the active mode (easy=green ·
                // challenge=cyan (daily too) · blitz=blue/magenta) via the
                // inherited --u37-mode-accent, instead of a flat grey — so it
                // reads as part of the mode's theme like the card outline.
                className="flex items-center gap-1 hover:brightness-125 transition-all z-10 active:scale-95 touch-manipulation rounded-lg px-1.5 py-1"
                style={{ color: 'var(--u37-mode-accent)', WebkitTapHighlightColor: 'transparent' }}
              >
                <HelpCircle className="w-5 h-5" />
                <span className="text-xs font-semibold hidden sm:inline">How to Play</span>
              </button>
              {/* In-game mute toggle — every gameplay screen (Easy/Challenge/
                  Daily/Blitz), beside the "?". Reuses the drawer's mute
                  preference so it stays reachable while the drawer is hidden. */}
              <button
                type="button"
                onPointerDown={handleMuteClick}
                aria-label={muted ? 'Unmute sound' : 'Mute sound'}
                className="text-slate-400 hover:text-white transition-colors z-10 active:scale-95 touch-manipulation rounded-lg px-1.5 py-1"
                style={{ WebkitTapHighlightColor: 'transparent' }}
              >
                {muted ? <VolumeX className="w-5 h-5" /> : <Volume2 className="w-5 h-5" />}
              </button>
            </div>
            {/* ⚠️ WHICH BLITZ AM I IN? (David, 2026-09-17, mid-battle on beta
                1.0.311): "im in an expert battle and i couldnt remember."

                A Daily names its tier on the button that opens it and on its
                pre-game gate; a blitz is entered from a card and then runs for
                minutes with nothing on screen saying which tier it is. The gap
                in this row was literally empty.

                ⚠️ IT WEARS THE TIER'S COLOUR, NOT THE BLITZ THEME'S. The card
                around it is magenta for a battle and blue for a solo run — but
                the fact being stated is "Expert", so the colour has to be
                Expert's gold or it is decoration rather than information.
                `modeAccentToken` takes the TIER via modeOf (easy green,
                challenge cyan, expert gold); `accentMode` deliberately does not.

                Dailies and practice get nothing here: they already say what they
                are on the way in, and this row has no room to spare. */}
            {playModeLabel && (
              <div
                data-testid="play-mode-label"
                className="min-w-0 truncate text-[11px] font-black uppercase tracking-wider px-1"
                style={{ color: modeAccentToken(mode) }}
              >
                {playModeLabel}
              </div>
            )}
            <div className="flex items-center gap-2">
              {/* Slice D: final-10s countdown — a prominent, pulsing "Ns left"
                  pill that appears as the time wall approaches (15:27 → 15:37).
                  At 0 the attempt times out (forfeit/DNF, solutions revealed). */}
              {showCountdown && remainingSeconds !== undefined && (
                <motion.div
                  data-testid="daily-countdown"
                  animate={{ scale: [1, 1.12, 1] }}
                  transition={{ duration: 1, repeat: Infinity }}
                  className="bg-rose-600/90 px-3 py-1 rounded-lg border border-rose-300 shadow-lg shadow-rose-500/30"
                >
                  <span className="text-white font-black text-base tabular-nums">
                    {Math.max(0, Math.ceil(remainingSeconds))}s left
                  </span>
                </motion.div>
              )}
              {showTimer && (
                <div data-testid="game-timer" className="bg-white/10 backdrop-blur px-3 py-1 rounded-lg border" style={{ borderColor: 'var(--u37-mode-accent)' }}>
                  <span className="text-white font-black text-base tabular-nums">{formatTime(dailyChallengeTimer)}</span>
                </div>
              )}
            </div>
          </div>

          {/* Power-dice reminder — slim legend with live N/3 (challenge/daily) */}
          {showPowerReminder && (
            <motion.div
              data-testid="region-reminder"
              initial={{ opacity: 0, y: -6 }}
              animate={{ opacity: 1, y: 0 }}
              className="mb-2"
            >
              <div className={`backdrop-blur rounded-lg px-3 py-1.5 border transition-all duration-300 ${showColorRuleError ? 'bg-red-900/40 border-red-500/50' : 'bg-slate-800/60 border-slate-700/50'}`}>
                <div className="flex items-center justify-center gap-3 text-xs flex-wrap">
                  <span className="flex items-center gap-1.5">
                    <span className={`w-4 h-4 rounded bg-gradient-to-br ${POWER_DIE_FACE.green.bg} shadow-sm`} />
                    <span className="text-emerald-300 font-semibold">+/−</span>
                  </span>
                  <span className="flex items-center gap-1.5">
                    <span className={`w-4 h-4 rounded bg-gradient-to-br ${POWER_DIE_FACE.blue.bg} shadow-sm`} />
                    <span className="text-sky-300 font-semibold">×/÷</span>
                  </span>
                  <span className="flex items-center gap-1.5">
                    <span className={`w-4 h-4 rounded bg-gradient-to-br ${POWER_DIE_FACE.red.bg} shadow-sm`} />
                    <span className="text-rose-300 font-semibold">^</span>
                  </span>
                  {/* Gold outline = a power die used with its correct operator. */}
                  <span className="flex items-center gap-1.5">
                    <span className="w-4 h-4 rounded border-2 border-amber-400" style={{ boxShadow: '0 0 6px rgba(233,196,90,0.7)' }} />
                    <span className="text-amber-300 font-semibold">used right</span>
                  </span>
                  {/* Denominator stays 3 — that is honestly how many power dice
                      are on the board. What changes is whether the count reads as
                      SATISFIED, which is mode-dependent: 2 finishes Challenge, only
                      3 finishes Expert. */}
                  <span
                    data-testid="power-dice-count"
                    data-satisfied={powerSatisfied ? 'true' : 'false'}
                    data-required={requiredPower}
                    className={`font-black tabular-nums ${
                      showColorRuleError ? 'text-red-200' : powerSatisfied ? 'text-amber-300' : 'text-slate-300'
                    }`}
                  >{powerCorrectCount}/3</span>
                </div>
                {showColorRuleError && (
                  <p data-testid="power-dice-error" className="text-[11px] text-center text-red-200 mt-1">
                    {requiredPower === 3
                      ? 'Use ALL 3 Power Dice with their correct operator.'
                      : `Use at least ${requiredPower} Power Dice with their correct operator.`}
                  </p>
                )}
              </div>
            </motion.div>
          )}

          {/* Dice */}
          <div data-testid="region-dice" className="mb-2">
            <DiceDisplay
              dice={dice}
              usedIndices={usedDiceIndices}
              onDiceClick={onDiceClick}
              disabled={solved}
              mode={mode}
              colors={diceColors}
            />
          </div>

          {/* Shuffle Button and Equations Solved Counter */}
          {SHOW_SHUFFLE_BUTTON && onShuffle && (
            <div className="mb-2 flex justify-center items-center gap-3 px-2">
              {/* Counter only shows in blitz solo/battle modes (not daily challenge) */}
              {isPractice(mode) && onExit && !onRollNewDice && (
                <div className="bg-slate-800/90 backdrop-blur rounded-lg px-3 py-1.5 border border-slate-700">
                  <div className="text-slate-400 text-[10px] font-medium mb-0.5">Solved</div>
                  <div className="text-white font-bold text-xl leading-none">{equationsSolved}</div>
                </div>
              )}
              <button
                onPointerDown={handleShuffleClick}
                disabled={solved}
                className={`
                text-white font-bold px-4 py-2 rounded-lg shadow-lg disabled:opacity-50 disabled:cursor-not-allowed
                transition-all duration-200 touch-manipulation text-sm active:scale-95
              `}
                // Was an easy/not-easy gradient pair, so the EXPERT practice
                // board's Shuffle button was orange — which is not Challenge's
                // colour either (that is cyan). Tier accent, like everything else.
                style={{
                  WebkitTapHighlightColor: 'transparent',
                  background: `linear-gradient(to right, ${modeAccentToken(mode)}, color-mix(in srgb, ${modeAccentToken(mode)} 70%, black))`,
                }}
              >
                🔀 Shuffle
              </button>
            </div>
          )}

          {/* Fallback counter if Shuffle is hidden but counter is needed */}
          {!SHOW_SHUFFLE_BUTTON && isPractice(mode) && onExit && !onRollNewDice && (
            <div className="mb-2 flex justify-center items-center px-2">
              <div className="bg-slate-800/90 backdrop-blur rounded-lg px-3 py-1.5 border border-slate-700">
                <div className="text-slate-400 text-[10px] font-medium mb-0.5 text-center">Solved</div>
                <div className="text-white font-bold text-xl leading-none text-center">{equationsSolved}</div>
              </div>
            </div>
          )}

          {/* Operators — above the builder (dice → operators → builder) */}
          <div data-testid="region-operators" className="mb-2 relative z-20">
            <OperatorPad
              onOperatorClick={onOperatorClick}
              disabled={solved}
              mode={mode}
            />
          </div>

          {/* Equation Builder */}
          {/* `relative` only anchors the Mirror glint; with the Mirror off this is main's markup. */}
          <div data-testid="region-builder" className={mirrorOn ? 'relative mb-2' : 'mb-2'}>
            <EquationBuilder
              equation={equation}
              result={result}
              isValid={valid}
              isComplete={isComplete}
              challengeRulesMet={challengeRulesMet}
              mode={mode}
              usedDiceIndices={usedDiceIndices}
              diceColors={diceColors}
              dice={dice}
              shuffledDice={builtShuffledDice}
              sector73Mirror={sector73Mirror !== 'off'}
              onDelete={onDelete}
              onClear={onClear}
              disabled={solved}
              showTutorialHint={hasPowerDice(mode)}
              cursorPosition={cursorPosition}
              onCursorPositionChange={onCursorPositionChange}
              onOperatorInsert={onOperatorClick}
              tutorialDiceColors={undefined}
              tutorialDiceValues={undefined}
              hidePerfectMessage={false}
            />
            {/* Sector 73: a near-miss 73 (fewer than 7 dice) glints once, unexplained. */}
            <MirrorGlint active={mirrorOn && sector73Mirror === 'open' && isMirrorNearMiss({ valid, result, usedDiceIndices })} />
          </div>

          {/* Sector 73: a repeat 73 is refused in place — the board stays, the
              clock keeps running, and the player heads back toward 37. */}
          {warpRefused && !solved && (
            <div
              data-testid="sector73-already-unlocked"
              role="status"
              className="mb-2 rounded-lg border border-violet-400/50 bg-violet-950/60 px-3 py-2 text-center text-[12px] font-semibold text-violet-100"
              style={{ boxShadow: '0 0 16px -6px #a855f7' }}
            >
              📡 {ALREADY_UNLOCKED_MESSAGE}
            </div>
          )}

          {/* Submit Button */}
          <div data-testid="region-submit" className="mb-2">
            <motion.div
              animate={shakeButton ? { x: [-10, 10, -10, 10, 0] } : {}}
              transition={{ duration: 0.4 }}
            >
              <Button
                onPointerDown={handleSubmitClick}
                disabled={!canSubmit}
                disableDefaultSound={true}
                type="button"
                className={`
                w-full py-4 rounded-xl font-bold text-lg touch-manipulation shadow-xl
                transition-all duration-300 cursor-pointer flex items-center justify-center gap-2 active:scale-95
                ${canSubmit && warpOpen
                    ? 'bg-gradient-to-r from-violet-600 via-fuchsia-500 to-violet-600 shadow-lg shadow-violet-500/40 animate-pulse'
                    : canSubmit
                    ? 'bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 shadow-lg shadow-emerald-500/30'
                    : showColorRuleError
                      ? 'bg-gradient-to-r from-red-600 to-red-700 text-white cursor-not-allowed'
                      : 'bg-slate-700 text-slate-400 cursor-not-allowed'
                  }
              `}
                style={{
                  minHeight: '56px',
                  WebkitTapHighlightColor: 'transparent',
                  touchAction: 'manipulation'
                }}
              >
                <CheckCircle className="w-5 h-5" />
                <span className="text-base">{solved ? 'Solved!' : showTryAgain ? 'Remember Power Dice Rules!' : 'SUBMIT'}</span>
              </Button>
            </motion.div>
          </div>

          {/* Roll New Dice Button - Easy and Challenge Mode. Neon-cosmic, mode
              colored (green = easy, cyan = challenge) so it matches the theme
              and reads as the current mode. */}
          {isPractice(mode) && onRollNewDice && (
            <div className="mb-0">
              <Button
                onPointerDown={handleRollClick}
                className="w-full py-3 rounded-xl font-bold text-sm transition-all touch-manipulation active:scale-95 border-2"
                style={{
                  background: `color-mix(in srgb, ${rollAccent} 20%, transparent)`,
                  borderColor: rollAccent,
                  color: `color-mix(in srgb, ${rollAccent} 25%, white)`,
                  boxShadow: `0 0 18px -6px ${rollAccent}, inset 0 0 20px -12px ${rollAccent}`,
                  textShadow: `0 0 8px color-mix(in srgb, ${rollAccent} 55%, transparent)`,
                  WebkitTapHighlightColor: 'transparent',
                }}
              >
                🎲 Roll New Dice
              </Button>
            </div>
          )}
        </div>
        </div>
      </div>

      {/* F4: in-game How-To-Play overlay. Rendered IN PLACE (not via the route)
          so the live attempt is never unmounted/forfeited; the daily clock is
          held by openHowTo/closeHowTo. Both Back and the "Got it — Play" CTA
          just close + resume. */}
      {showHowTo && (
        <HowToOverlay mode={mode} context="resume-game" onClose={closeHowTo} onComplete={closeHowTo} />
      )}
    </div>
  );
}