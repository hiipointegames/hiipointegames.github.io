// useEquationDraft — owns the [[equation draft]] composition state shared by
// the daily-challenge (Game.jsx) and head-to-head (HeadToHeadGame.jsx) play
// surfaces. See ADR-0003.
//
// `dice` is the rolled dice array. Each entry may be a plain number (blitz)
// or a rich object { value, id, ... } (daily). The hook reads value + stable
// id from whichever shape it's given; it does not own dice or diceColors.

import { useState, useRef, useCallback } from 'react';
import {
  applyDraftAction,
  initialDraftState,
  deriveEquation,
  deriveUsedDiceIndices,
  deriveUsedDiceIds,
  tokensFromEquation,
} from './draftReducer';

export function useEquationDraft(dice = []) {
  const [state, setState] = useState(initialDraftState);

  // Ref mirrors current state so action callbacks stay referentially stable
  // (empty deps) while always reducing against the latest state.
  const stateRef = useRef(state);
  stateRef.current = state;

  const run = useCallback((action) => {
    const result = applyDraftAction(stateRef.current, action);
    setState(result.state);
    return result;
  }, []);

  const clickDie = useCallback(
    (index) => {
      const die = dice[index];
      const value = die && typeof die === 'object' ? die.value : die;
      const id = die && typeof die === 'object' && die.id != null ? die.id : index;
      return run({ type: 'CLICK_DIE', die: { value, index, id } });
    },
    [dice, run]
  );

  // Returns { rejected } so the orchestrator can fire the shake animation.
  const insertOperator = useCallback(
    (operator) => {
      const { shake } = run({ type: 'INSERT_OPERATOR', operator });
      return { rejected: shake };
    },
    [run]
  );

  const deleteAtCursor = useCallback(() => run({ type: 'DELETE' }), [run]);
  const clear = useCallback(() => run({ type: 'CLEAR' }), [run]);
  const setCursor = useCallback((cursor) => run({ type: 'SET_CURSOR', cursor }), [run]);
  const remapDiceReferences = useCallback((indexMap) => run({ type: 'REMAP', indexMap }), [run]);

  const hydrate = useCallback(
    ({ equation, usedDiceIndices }) => {
      const eq = equation || '';
      const tokens = tokensFromEquation(eq, usedDiceIndices || [], dice);
      run({ type: 'HYDRATE', tokens, cursor: eq.length });
    },
    [dice, run]
  );

  return {
    equation: deriveEquation(state.tokens),
    usedDiceIndices: deriveUsedDiceIndices(state.tokens),
    usedDiceIds: deriveUsedDiceIds(state.tokens),
    cursorPosition: state.cursor,
    clickDie,
    insertOperator,
    deleteAtCursor,
    clear,
    setCursor,
    remapDiceReferences,
    hydrate,
  };
}
