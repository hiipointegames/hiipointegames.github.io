// HowToOverlay — the ONE in-place how-to surface used everywhere in the app.
//
// Wraps the presentational `HowToPlayPage` in the full-viewport `z-[150]` layer
// that renders ABOVE the game shell (z-[100]), the corner chrome, and the
// app-wide bottom nav bar (z-140). Because it
// mounts in place and closes locally — never navigating — the screen underneath
// (the live game, the Daily start modal, the Blitz picker) stays mounted, so
// dismissing it returns the player to exactly where they opened it. This is the
// shared replacement for the old three-divergent-mount-paths situation (route
// wrapper + inline overlay) documented in the 2026-07-08 occlusion audit.
//
// `context` drives the bottom-button label so the CTA names the return ("go
// back" / "choose opponent" / "begin battle!" / first-run "continue"); with no
// context the page keeps its default "Got it — Play <mode>" label.

import React, { useEffect } from 'react';
import { createPortal } from 'react-dom';
import HowToPlayPage from './HowToPlayPage';
import { isDaily } from '@/game-modes';

// Context → bottom-CTA label. Returns `undefined` for the default/unknown case
// so HowToPlayPage falls back to its own mode-aware "Got it — Play <mode>".
// `mode` is only consulted for 'resume-game' (the in-gameplay "?"), where the CTA
// names the surface you return to.
export function howToContextLabel(context, mode) {
  switch (context) {
    case 'go-back': return 'Got it — go back';
    case 'choose-opponent': return 'Got it — choose opponent';
    case 'begin-battle': return 'Got it — begin battle!';
    // FIRST RUN RETURNS NOTHING ON PURPOSE (2026-09-11). This context always
    // sets `requireScroll`, and HowToPlayPage names that case `Begin <mode>` —
    // the button IS the start of play, and "Got it — continue" described the
    // dismissal rather than what happens next. Returning a label here would
    // win over it.
    case 'first-run': return undefined;
    // Opened from the live gameplay screen — closing just resumes play, so the
    // CTA names the surface returned to. (2026-07-08 beta finding.)
    case 'resume-game':
      return isDaily(mode) ? 'Got it — return to daily challenge' : 'Got it — return to puzzle';
    default: return undefined;
  }
}

export default function HowToOverlay({
  mode = 'daily',
  context = null,
  requireScroll = false,
  onClose,
  onComplete,
  testId = 'ingame-howto',
  // False when the host owns the chrome (an embedded battle inside Sector 73
  // hides the nav itself); the unmount broadcast would otherwise restore it.
  hidesNav = true,
}) {
  // ── Suppress the app-wide bottom nav while the how-to is open (Bryce, 1.0.285
  // iOS) ───────────────────────────────────────────────────────────────────────
  // From HOME the persistent bottom nav bar (BottomNavBar, portaled to <body> at
  // zIndex:140) is NOT hidden while this overlay is open, and the overlay itself
  // portaled to <body> at the SAME stacking level. So the full-width footer "Got
  // it — go back" button sat directly over a nav tab underneath and the tap fell
  // through to it → the player landed on Stats instead of returning Home. (In live
  // gameplay the nav is already hidden by Game's homeChromeVisible gate, which is
  // why the in-game CTA worked — matching Bryce's report that only the Home how-to
  // misbehaved.) Fix, two independent belts:
  //   1. While open, drive the nav's existing `suppressed` lever — dispatch the
  //      'bottomNavChanged' { hidden: true } event Layout already listens for
  //      (see routing/Layout.jsx handleBottomNav → isBottomNavVisible), and
  //      restore it on unmount. Cleanup runs even if we're unmounted mid-gesture,
  //      so the bar can never stay stuck hidden.
  //   2. The wrapper below sits at z-[150], above the nav's 140, so even a timing
  //      race where suppression hasn't applied yet can't let the nav capture a tap.
  useEffect(() => {
    if (!hidesNav) return undefined;
    const setNavHidden = (hidden) => {
      window.dispatchEvent(new CustomEvent('bottomNavChanged', { detail: { hidden } }));
    };
    setNavHidden(true);
    return () => setNavHidden(false);
  }, [hidesNav]);

  const overlay = (
    <div className="fixed inset-0 z-[150]" data-testid={testId}>
      <HowToPlayPage
        mode={mode}
        requireScroll={requireScroll}
        ctaLabel={howToContextLabel(context, mode)}
        onBack={onClose}
        onStart={onComplete || onClose}
      />
    </div>
  );

  // Portal to <body> so the overlay escapes the page-content stacking context.
  // Layout wraps every page in `<div className="relative z-[1]">`, which is its
  // OWN stacking context — so the overlay, however high its z-[150], stays
  // trapped BELOW the sibling corner chrome (the z-50 Save-Stats button + the
  // hamburger drawer) that lives in the parent context. On the S21 (beta 1.0.242)
  // that chrome drew OVER the how-to's back arrow + title. Rendering into <body>
  // lifts the overlay into the root stacking context where z-[150] beats z-50.
  // (2026-07-08 audit. The old "?"+mute corner cluster was later removed in the
  // H3 restructure, but the Save-Stats/hamburger chrome keeps this portal needed.)
  return typeof document !== 'undefined'
    ? createPortal(overlay, document.body)
    : overlay;
}
