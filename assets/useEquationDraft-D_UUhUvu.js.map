// Sector 73 — public surface for the rest of the app.
//
// Deliberately LIGHT: the home screen and the Daily import from here eagerly, so
// only the Mirror (unlock rule + transition + wormhole) lives in this barrel. The
// cockpit world and its four modes are a separate lazy route chunk
// (routing/pages.config.js → ./Sector73Page), downloaded only when a pilot flies in.

export {
  MIRROR_TARGET,
  isWarpEquation,
  isWarpSubmittable,
  hasWarpRow,
  fetchSector73Unlocked,
  readCachedUnlock,
  writeCachedUnlock,
} from './mirror';
export { useSector73Unlocked } from './useSector73Unlocked';
// The master switch (app_settings.sector73; missing/failed/slow = OFF). Everything
// Sector 73 shows on a 37 screen, and the /Sector73 route, is gated on it.
export {
  useSector73Enabled,
  useSector73Switch,
  isSector73Enabled,
  sector73EnabledNow,
  SECTOR73_BADGE_IDS,
  sector73BadgeCatalog,
} from './sector73Switch';
export { useSector73PortalVisible } from './useSector73PortalVisible';
export { useMirrorWarp } from './useMirrorWarp';
export { default as MirrorWarpOverlay } from './MirrorWarpOverlay';
export { default as WormholeButton } from './WormholeButton';
export { MirrorGlint, isMirrorNearMiss } from './MirrorGlint';
export { playSynth } from './synth';

/** Copy for a repeat 73 (David's pick, 2026-10-04 interview). */
export const ALREADY_UNLOCKED_MESSAGE =
  'Coordinates already logged. 37 is your only heading today. Sector 73 is one jump away from home.';

/** Faint clue on the Daily pre-game screen (David's pick). */
