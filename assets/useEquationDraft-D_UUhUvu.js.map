// scrollLock — freeze the app's background scroll WITHOUT pinning
// `document.body` to `position: fixed`.
//
// WHY NOT position:fixed (the iOS dead-tap, RC1, 2026-07-08 occlusion audit):
// the in-play game (DailyChallengeGame) used to lock scroll by setting
// `document.body { position: fixed; top: -scrollY }`. On iOS/WKWebView that is a
// known trap — with the body shifted, hit-testing for `position: fixed` OVERLAYS
// (the how-to overlay's back arrow, bottom CTA, mute, "?") is offset by the
// scroll delta, so the controls render correctly but taps silently MISS. Android
// is unaffected. (The how-to overlay is now portaled to <body>, so a
// position:fixed body would still sit as its ancestor — this lock removes that.)
//
// Instead we lock the ACTUAL scroll container — `#root` (index.css makes it the
// `overflow-y: auto` scroller) — with `overflow: hidden` + `touch-action: none`.
// Nothing is moved, so: (a) the scroll position is preserved for free, and
// (b) there is no shifted origin to confuse WKWebView hit-testing. Background
// scroll/rubber-band is still frozen on both platforms.
//
// Returns an idempotent unlock() that restores the prior inline styles exactly.

export function lockScroll() {
  const root = typeof document !== 'undefined' ? document.getElementById('root') : null;
  if (!root) return () => {};

  const prev = {
    overflow: root.style.overflow,
    touchAction: root.style.touchAction,
  };
  root.style.overflow = 'hidden';
  root.style.touchAction = 'none';

  let unlocked = false;
  return function unlock() {
    if (unlocked) return;
    unlocked = true;
    root.style.overflow = prev.overflow;
    root.style.touchAction = prev.touchAction;
  };
}
