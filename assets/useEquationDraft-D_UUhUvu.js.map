import React, { useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { getPowerDiceCorrectness, isPerfectSolve, collectDraftErrors, computeSubmitHint, segmentNumberDice } from '@/equation-engine';
import { operatorInputController } from '@/components/utils/OperatorInputController';
import { GoldPulseRing, Target37, NUM_COLOR, EXPONENT_CLASS } from '@/dice-visuals';
import { hasPowerDice } from '@/game-modes';
import { playSound } from '@/ui/feedback';

/**
 * Several props are optional and guarded at use (onOperatorInsert,
 * onCursorPositionChange, disabled, shuffledDice) — the tutorial mounts this
 * component without them. Typed as an open prop bag so partial callers are
 * valid without enumerating every optional field.
 * @param {Record<string, any>} props
 */
export default function EquationBuilder({ equation, result, isValid, isComplete, challengeRulesMet, mode, usedDiceIndices, tutorialDiceColors, tutorialDiceValues, diceColors, dice, hidePerfectMessage, onDelete, onClear, disabled, showTutorialHint = false, cursorPosition = 0, onCursorPositionChange, onOperatorInsert, shuffledDice, sector73Mirror = false }) {
  const [deleteLockedRef] = React.useState({ locked: false });
  const [clearLockedRef] = React.useState({ locked: false });

  const handleDeleteClick = (e) => {
    // Free edit: delete is never blocked by a structural state (touching dice,
    // etc.). Only the rapid-tap debounce, the disabled/solved flag, and an
    // empty equation stop it.
    if (deleteLockedRef.locked || disabled || equation.length === 0) return;
    e.preventDefault();
    e.stopPropagation();

    // Standard tap sound, matching Reset (David, 2026-09-12 — he named the two
    // controls INSIDE the equation builder specifically, not the ✕ at the top of
    // the screen). Behind the lock guard so a rapid double-tap cannot double-play.
    playSound('buttonTap');

    deleteLockedRef.locked = true;
    onDelete();

    setTimeout(() => {
      deleteLockedRef.locked = false;
    }, 50);
  };

  const handleClearClick = (e) => {
    if (clearLockedRef.locked || disabled || equation.length === 0) return;
    e.preventDefault();
    e.stopPropagation();

    // The app's standard tap sound (David, 2026-09-12): Reset was one of the
    // few controls on the board that did nothing audible. After the lock guard,
    // so a rapid double-tap cannot double-play it.
    playSound('buttonTap');

    clearLockedRef.locked = true;
    onClear();

    setTimeout(() => {
      clearLockedRef.locked = false;
    }, 50);
  };

  // Register with shared operator controller
  useEffect(() => {
    if (onOperatorInsert) {
      operatorInputController.registerInsertHandler(onOperatorInsert);
    }

    return () => {
      operatorInputController.reset();
    };
  }, [onOperatorInsert]);
  const displayEquation = equation
    .replace(/\*/g, '×')
    .replace(/\//g, '÷')
    .replace(/-/g, '−');

  // The one structural-validity signal for the builder: an ordered list of the
  // active problems (touching dice, invalid operators, unbalanced parens, or a
  // generic invalid). Editing is never blocked by these — they drive the red
  // token highlighting, the non-blocking checklist, and the `?` readout, and
  // (on the surfaces) gate Submit. This replaces the old scattered detectors
  // (hasTouchingIssue / hasUnclosedParentheses / invalidEquationState).
  // The one structural-validity signal for the builder: an ordered list of the
  // active issues, each with a severity. 'error' (red) = a mistake to delete;
  // 'incomplete' (blue) = a valid prefix you'll finish by adding. Both keep
  // Submit gated; only 'error' is shown as a mistake. One char per token
  // (ADR-0003) means a string offset is the token's render position.
  const draftIssues = collectDraftErrors(equation, usedDiceIndices);
  const hasIssues = draftIssues.length > 0;
  const errorIssues = draftIssues.filter((x) => x.severity === 'error');
  // Every flagged token offset — both 'error' and 'incomplete'. They share ONE
  // golden "deal with this" mark (not red/blue), so the equation's attention
  // color never collides with the green/blue/red POWER-DICE colors shown on the
  // numbers in challenge/daily mode. The severity still drives the Submit hint,
  // the haptic, and aria-invalid — it's just no longer a color.
  const markedIndices = new Set(draftIssues.flatMap((x) => x.tokenIndices));

  // Best-effort haptic when a NEW real mistake (red error) appears — NOT for the
  // normal blue "incomplete" states while building. JS-only and OTA-safe:
  // navigator.vibrate is feature-detected and silently no-ops where
  // unsupported/unpermitted (today iOS WKWebView lacks it; Android lacks the
  // VIBRATE permission). Wired now so a future NATIVE release activates it with
  // no JS change. A native haptic can't ship in this OTA-only fix. See followups.
  const prevErrorCountRef = React.useRef(0);
  useEffect(() => {
    const count = errorIssues.length;
    if (count > prevErrorCountRef.current
      && typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function') {
      navigator.vibrate(15);
    }
    prevErrorCountRef.current = count;
  }, [errorIssues.length]);

  // The single "what's left before Submit" hint. The grayed Submit button is the
  // gate; this names the next blocker. Priority: fix real mistakes → place all
  // dice → finish incomplete spots → reach 37 → satisfy the power-dice rule.
  // Logic lives in the pure equation-engine (computeSubmitHint, R5); we pass the
  // already-computed draftIssues so it doesn't re-scan the equation.
  const submitHint = computeSubmitHint({
    equation,
    mode,
    isComplete,
    isValid,
    result,
    challengeRulesMet,
    draftIssues,
    // false (the default) for a guest or with Sector 73 switched off: a 73 gets the usual distance hint.
    sector73Mirror,
  });

  // Readout number colors come from the shared NUM_COLOR token so a placed power
  // die's numeral matches its color on the How-To-Play page exactly.
  const getColorForDiceIndex = (index) => {
    if (!hasPowerDice(mode)) return NUM_COLOR.white;

    // Check if we're in tutorial mode with custom dice setup
    if (tutorialDiceColors && tutorialDiceValues) {
      return NUM_COLOR[tutorialDiceColors[index]] || NUM_COLOR.white;
    }

    // Use the actual diceColors array passed from parent
    if (diceColors && diceColors[index]) {
      return NUM_COLOR[diceColors[index]] || NUM_COLOR.white;
    }

    return NUM_COLOR.white;
  };

  const handleEquationClick = (e) => {
    if (disabled || !onCursorPositionChange) return;

    // Get click position relative to the element
    const rect = e.currentTarget.getBoundingClientRect();
    const clickX = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
    const totalWidth = rect.width;
    const charWidth = totalWidth / Math.max(equation.length, 1);
    const clickedPosition = Math.round(clickX / charWidth);
    onCursorPositionChange(Math.max(0, Math.min(clickedPosition, equation.length)));
  };

  // A single golden "deal with this" mark for any flagged token — both real
  // mistakes and not-yet-finished spots. One color (the gold of the "/ 37"
  // target) instead of red/blue, so it never competes with the green/blue/red
  // power-dice colors in the equation. Underlined, with a wide offset to keep
  // the line clear of the glyphs and parentheses.
  const MARK_TOKEN_CLASS = 'text-amber-400 underline decoration-solid decoration-2 decoration-amber-400 underline-offset-4';
  // The mark for any offset in a [start, end) span (single tokens pass i, i+1).
  const markForRange = (start, end) => {
    for (let k = start; k < end; k++) if (markedIndices.has(k)) return MARK_TOKEN_CLASS;
    return '';
  };

  const renderColoredEquation = () => {
    // Get correctness map using AST-based validation (works even for incomplete equations)
    const correctnessMap = hasPowerDice(mode) && diceColors && diceColors.length >= 7 && usedDiceIndices && equation.length > 0
      ? getPowerDiceCorrectness(equation, usedDiceIndices, diceColors)
      : new Map();

    // Dice values indexed by dice index (tutorial overrides the real roll when
    // present) — passed to the touching-dice tokenizer for each number below.
    const diceValues = tutorialDiceValues || dice;

    const parts = [];
    let currentIndex = 0;
    let diceUsedIndex = 0;
    let inSuperscript = false;
    let parenDepth = 0;

    // Render cursor at position 0 if needed
    if (cursorPosition === 0 && onCursorPositionChange) {
      parts.push(
        <span key={`cursor-0`} className="inline-block w-0.5 h-6 bg-amber-400 animate-pulse mx-0.5" />
      );
    }

    for (let i = 0; i < equation.length; i++) {
      const char = equation[i];
      const prevChar = i > 0 ? equation[i - 1] : '';

      // Check if we're starting a superscript (only set true immediately after ^)
      if (prevChar === '^' && !inSuperscript) {
        inSuperscript = true;
        parenDepth = 0;
      }

      if (/\d/.test(char)) {
        // Start of a number
        let numStr = char;
        let j = i + 1;
        while (j < equation.length && /\d/.test(equation[j])) {
          numStr += equation[j];
          j++;
        }

        // Map this digit run to the consecutive placed dice it represents
        // (R5-rem — the pure tokenizer in equation-engine). A run like "37" can
        // be one number made of two touching dice; segmentNumberDice reports
        // which dice it consumes, from the running placement cursor. We advance
        // the cursor by the matched count to mirror the old inline loop; the
        // single-die/no-match branch below resets it back to startDiceIndex.
        const startDiceIndex = diceUsedIndex;
        const { segments: expectedDiceValues, touchingCount, remaining } =
          segmentNumberDice(numStr, usedDiceIndices, diceValues, diceUsedIndex);
        diceUsedIndex += touchingCount;

        // If we successfully matched multiple dice, render them separately with cursor between
        if (touchingCount > 1 && remaining.length === 0) {
          let currentPos = i;
          expectedDiceValues.forEach((diceInfo, idx) => {
            // Each touching die is one character, so its render offset is i+idx.
            const mark = markForRange(i + idx, i + idx + 1);
            const color = mark
              || (hasPowerDice(mode) ? getColorForDiceIndex(diceInfo.diceIndex) : 'text-white');
            const shouldOutline = !mark && correctnessMap.has(diceInfo.usedIndex) && correctnessMap.get(diceInfo.usedIndex);
            const shouldSuperscript = inSuperscript;

            const numSpan = (
              <span
                key={`${currentIndex}-${idx}`}
                className={`${color} ${shouldSuperscript ? `inline-block ml-0.5 ${EXPONENT_CLASS}` : ''}`}
              >
                {diceInfo.value}
              </span>
            );
            // A correctly-used power die gets the shared gold pulse outline (same
            // as the How-To-Play readout) — replaces the old white box.
            parts.push(
              shouldOutline
                ? <GoldPulseRing key={`gpr-${currentIndex}-${idx}`} radius="rounded-md">{numSpan}</GoldPulseRing>
                : numSpan
            );

            currentPos += diceInfo.value.length;

            // Insert cursor between touching dice values if cursor position is in this range
            if (onCursorPositionChange && cursorPosition > i && cursorPosition <= currentPos && idx < expectedDiceValues.length - 1) {
              parts.push(
                <span key={`cursor-${i}-${idx}`} className="inline-block w-0.5 h-6 bg-amber-400 animate-pulse mx-0.5" />
              );
            }
          });

          // Insert cursor after all touching values if cursor is at the end
          const finalPos = i + numStr.length;
          if (onCursorPositionChange && cursorPosition > i && cursorPosition >= finalPos && cursorPosition <= finalPos) {
            parts.push(
              <span key={`cursor-${i}-end`} className="inline-block w-0.5 h-6 bg-amber-400 animate-pulse mx-0.5" />
            );
          }
        } else {
          // Single die or no match - render normally
          diceUsedIndex = startDiceIndex;
          const diceIndex = usedDiceIndices[diceUsedIndex];
          // The number spans chars [i, j); mark it if any of those positions is flagged.
          const mark = markForRange(i, j);
          const color = mark
            || (hasPowerDice(mode) ? getColorForDiceIndex(diceIndex) : 'text-white');
          const shouldOutline = !mark && correctnessMap.has(diceUsedIndex) && correctnessMap.get(diceUsedIndex);
          const shouldSuperscript = inSuperscript;

          const singleNumSpan = (
            <span
              key={currentIndex}
              className={`${color} ${shouldSuperscript ? `inline-block ml-0.5 ${EXPONENT_CLASS}` : ''}`}
            >
              {numStr}
            </span>
          );
          parts.push(
            shouldOutline
              ? <GoldPulseRing key={`gpr-${currentIndex}`} radius="rounded-md">{singleNumSpan}</GoldPulseRing>
              : singleNumSpan
          );

          diceUsedIndex++;
        }

        // Insert cursor after this number if cursor is in this range (only if not touching dice)
        if (touchingCount <= 1 && onCursorPositionChange && cursorPosition > i && cursorPosition <= j) {
          parts.push(
            <span key={`cursor-${i}`} className="inline-block w-0.5 h-6 bg-amber-400 animate-pulse mx-0.5" />
          );
        }

        i = j - 1;

        // End superscript after the number if not in parentheses
        if (inSuperscript && parenDepth === 0) {
          inSuperscript = false;
        }
      } else {
        // Operator or parenthesis
        let displayChar = char;
        if (char === '*') displayChar = '×';
        else if (char === '/') displayChar = '÷';
        else if (char === '-') displayChar = '−';

        const shouldSuperscript = inSuperscript;

        // Track parentheses depth for superscripts
        if (char === '(' && inSuperscript) {
          parenDepth++;
        } else if (char === ')' && inSuperscript && parenDepth > 0) {
          parenDepth--;
          if (parenDepth === 0) {
            parts.push(
              <span
                key={currentIndex}
                className={`inline-block ml-0.5 ${EXPONENT_CLASS} ${markForRange(i, i + 1)}`}
              >
                {displayChar}
              </span>
            );
            inSuperscript = false;
            currentIndex++;

            // Insert cursor after this character if position matches
            if (onCursorPositionChange && cursorPosition === i + 1) {
              parts.push(
                <span key={`cursor-${i}`} className="inline-block w-0.5 h-6 bg-amber-400 animate-pulse mx-0.5" />
              );
            }
            continue;
          }
        }

        parts.push(
          <span
            key={currentIndex}
            className={`${shouldSuperscript ? `inline-block ml-0.5 ${EXPONENT_CLASS}` : ''} ${markForRange(i, i + 1)}`}
          >
            {displayChar}
          </span>
        );

        // Insert cursor after this character if position matches
        if (onCursorPositionChange && cursorPosition === i + 1) {
          parts.push(
            <span key={`cursor-${i}`} className="inline-block w-0.5 h-6 bg-amber-400 animate-pulse mx-0.5" />
          );
        }
      }
      currentIndex++;
    }

    return <>{parts}</>;
  };

  const getResultColor = () => {
    if (!isComplete) return 'text-slate-400';
    if (isValid && result === 37) return 'text-emerald-400';
    return 'text-red-400';
  };

  return (
    <div className="w-full px-2">
      <div className="bg-slate-800/90 backdrop-blur rounded-xl p-2.5 border-2 border-slate-700/50 shadow-xl">
        {/* Equation display */}
        <div className="min-h-10 flex items-center justify-center mb-2">
          <AnimatePresence mode="popLayout">
            {equation.length > 0 ? (
              <motion.div
                key="equation"
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                aria-invalid={errorIssues.length > 0 ? 'true' : 'false'}
                className="text-2xl sm:text-3xl font-mono font-bold text-white tracking-wider break-all text-center cursor-pointer"
                onClick={handleEquationClick}
                onTouchStart={handleEquationClick}
              >
                {renderColoredEquation()}
              </motion.div>
            ) : (
              <motion.div
                key="placeholder"
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="text-slate-500 text-base sm:text-lg font-medium"
              >
                Tap dice and operators
              </motion.div>
            )}
          </AnimatePresence>
        </div>

        {/* Divider */}
        <div className="h-px bg-gradient-to-r from-transparent via-slate-600 to-transparent mb-2" />

        {/* Running-total display */}
        <div className="flex items-center justify-between">
          <div className="flex flex-col items-start gap-1.5 flex-shrink-0 min-w-[60px]">
            {/* "Result" -> "Running Total" (David, 2026-09-12): the number below
                updates as you build, so "Result" read like a final answer.

                It WRAPS TO TWO LINES on purpose. This column is `flex-shrink-0`
                inside the row that also holds the live total, so a wider label
                does not compress itself — it squeezes the number beside it.
                "RUNNING TOTAL" at the old `text-xs tracking-widest` is roughly
                twice the width of "RESULT", so the tracking is tightened and the
                label is allowed to break across two tight lines, keeping the
                column at its original 60px and the row unchanged. */}
            <span className="text-slate-400 text-[10px] leading-[1.15] uppercase tracking-wide font-bold max-w-[62px]">Running Total</span>
            {/* Bigger and brighter (David, 2026-09-12): this sits under the
                running total on every board — dailies, practices, solo Blitz and
                battles — and was a small dim chip. Now a 32px-tall target with a
                red glow, which also brings it closer to the 44px touch guidance
                without stealing height from the row. */}
            <button
              onPointerDown={handleClearClick}
              disabled={disabled || equation.length === 0}
              className="px-3.5 py-1.5 min-h-[32px] rounded-lg bg-gradient-to-r from-red-500 to-red-600 hover:from-red-400 hover:to-red-500 text-white font-black text-sm tracking-wide transition-all disabled:opacity-30 disabled:cursor-not-allowed touch-manipulation active:scale-95"
              style={{
                WebkitTapHighlightColor: 'transparent',
                boxShadow: '0 0 16px -4px #ef4444, inset 0 1px 0 rgba(255,255,255,0.28)',
              }}
            >
              Reset
            </button>
          </div>

          <div className="flex-1 px-1 flex flex-col justify-center items-center text-center min-w-0">
            {showTutorialHint && isComplete && result === 37 && (
              <div className="text-[10px] sm:text-xs text-slate-400 flex items-center justify-center gap-1 mb-1">
                <span className="border-2 border-amber-400 rounded inline-block w-3 h-3" style={{ boxShadow: '0 0 6px rgba(233,196,90,0.7)' }}></span> = correct
              </div>
            )}

            {/* Status message */}
            <AnimatePresence>
              {equation.length > 0 && (
                <motion.div
                  initial={{ opacity: 0, height: 0 }}
                  animate={{ opacity: 1, height: 'auto' }}
                  exit={{ opacity: 0, height: 0 }}
                  className="text-center w-full"
                >
                  {(() => {
                    // The single "what's left before Submit" hint (computed as
                    // submitHint above). The grayed Submit button is the gate;
                    // this line names the next blocker, tone-colored to match the
                    // inline marks (red mistake / blue incomplete / amber value).
                    if (submitHint) {
                      // Structural blockers (mistake + incomplete) use the same
                      // golden as the inline marks; value/completeness stay amber/slate.
                      const toneClass = {
                        error: 'text-amber-400 font-bold',
                        incomplete: 'text-amber-400 font-medium',
                        amber: 'text-orange-400 font-medium',
                        muted: 'text-slate-400 font-medium',
                      }[submitHint.tone] || 'text-slate-400 font-medium';
                      return <span className={`${toneClass} text-xs sm:text-sm`}>{submitHint.text}</span>;
                    }
                    // Nothing left → a valid solve. Some surfaces suppress the cheer.
                    if (hidePerfectMessage) return null;
                    const perfect = hasPowerDice(mode)
                      && isPerfectSolve(equation, usedDiceIndices, diceColors);
                    return (
                      <span className="text-emerald-400 text-xs sm:text-sm font-bold">
                        {perfect ? '🎉 Perfect Solve!' : '🎉 Nice Solve!'}
                      </span>
                    );
                  })()}
                </motion.div>
              )}
            </AnimatePresence>
          </div>

          <div className="flex flex-col items-end gap-1.5 flex-shrink-0 min-w-[60px]">
            <div className="flex items-center gap-1.5">
              <motion.span
                key={result}
                initial={{ scale: 1.2, opacity: 0 }}
                animate={{ scale: 1, opacity: 1 }}
                className={`text-2xl sm:text-3xl font-black font-mono ${getResultColor()}`}
              >
                {hasIssues ? '?' : (isValid ? result : '?')}
              </motion.span>
              <span className="text-slate-500 text-xl sm:text-2xl font-bold">/</span>
              <Target37 className="text-2xl sm:text-3xl font-black font-mono" />
            </div>
            {/* Sized and lit to MATCH Reset (David, 2026-09-12). These two are a
                pair — the only controls inside the builder — and they were both
                small, dim and silent. Same metrics as Reset so they read as one
                set rather than two afterthoughts. */}
            <button
              onPointerDown={handleDeleteClick}
              disabled={disabled || equation.length === 0}
              className="px-3.5 py-1.5 min-h-[32px] rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-black text-sm tracking-wide transition-all disabled:opacity-30 disabled:cursor-not-allowed touch-manipulation active:scale-95"
              style={{
                WebkitTapHighlightColor: 'transparent',
                boxShadow: '0 0 16px -4px #818cf8, inset 0 1px 0 rgba(255,255,255,0.28)',
              }}
            >
              ← Back
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}