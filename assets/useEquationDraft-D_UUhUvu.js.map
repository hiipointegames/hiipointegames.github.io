// Pure reducer for the [[equation draft]] — the in-progress composition a
// player assembles before submitting. See ADR-0003.
//
// The token list is the single source of truth. Each token is either
//   { type: 'die', value, index, id }   (value 1-6; index = current dice-array
//                                         position; id = stable die identity)
//   { type: 'operator', value }          (value is one of + - * / ^ ( ) )
//
// INVARIANT (ADR-0003): every token renders as exactly one character — dice
// are 1-6, operators are single symbols. Therefore the cursor (a character
// offset, to match the rendered equation string) is identical to the index
// into the token list. All insertion/deletion is plain array indexing at the
// cursor. If dice ever become multi-digit this assumption breaks.

const isDie = (t) => t.type === 'die';

// True iff two die tokens are adjacent — they fuse into one number (e.g.
// '5','5' reads as '55'), which is never a valid submission. DERIVED from the
// tokens, not stored.
//
// History: this used to be the draft's *edit lock* — DELETE was a no-op and the
// Back button was disabled while it was true, forcing the player to insert an
// operator BETWEEN the pair (or Clear) before doing anything else. That trapped
// real users. As of the 2026-06-12 free-edit change, editing is NEVER gated;
// touching dice is now just one of several structural problems surfaced
// non-blockingly by collectDraftErrors (equation-engine) and gated only at
// Submit. This helper remains as a pure detector (still consumed by the hook /
// error surfacing), no longer as an edit gate.
export const hasTouchingDice = (tokens) =>
  tokens.some((t, i) => i > 0 && t.type === 'die' && tokens[i - 1].type === 'die');

export const initialDraftState = { tokens: [], cursor: 0 };

// ── Derived views (the draft's public projections) ──────────────────────────
export const deriveEquation = (tokens) => tokens.map((t) => String(t.value)).join('');
export const deriveUsedDiceIndices = (tokens) => tokens.filter(isDie).map((t) => t.index);
export const deriveUsedDiceIds = (tokens) => tokens.filter(isDie).map((t) => t.id);

// Rebuild the token list from a saved equation string + usedDiceIndices.
// Used by the non-daily active_game restore path. `dice` (optional) supplies
// stable ids; falls back to the dice-array index when absent.
export function tokensFromEquation(equation, usedDiceIndices, dice = []) {
  const tokens = [];
  let diePos = 0;
  for (const ch of equation) {
    if (/\d/.test(ch)) {
      const index = usedDiceIndices[diePos];
      const die = dice[index];
      const id = die && typeof die === 'object' && die.id != null ? die.id : index;
      tokens.push({ type: 'die', value: Number(ch), index, id });
      diePos++;
    } else {
      tokens.push({ type: 'operator', value: ch });
    }
  }
  return tokens;
}

// Apply one action. Returns { state, shake }. As of the 2026-06-12 free-edit
// change no action rejects an edit for an adjacency/structural reason, so
// `shake` is always false (the field is retained for the call signature; the
// only remaining no-ops — die reuse, delete at cursor 0 — are silent). Gentle
// error feedback now lives at the surfacing layer, not here.
export function applyDraftAction(state, action) {
  const { tokens, cursor } = state;

  switch (action.type) {
    case 'CLICK_DIE': {
      const { value, index, id } = action.die;
      // Can't reuse a die already in the draft — a die is a physical object,
      // not a typeable digit; placing it twice is nonsensical, not a
      // fix-later error. This is the ONLY remaining edit guard.
      if (tokens.some((t) => t.type === 'die' && t.index === index)) {
        return { state, shake: false };
      }
      // Free edit: a die may be placed anywhere, including adjacent to another
      // die. Resulting touching dice are surfaced by collectDraftErrors and
      // block Submit, not the edit.
      const next = tokens.slice();
      next.splice(cursor, 0, { type: 'die', value, index, id });
      return { state: { tokens: next, cursor: cursor + 1 }, shake: false };
    }

    case 'INSERT_OPERATOR': {
      const op = action.operator;
      // Free edit: an operator may be inserted anywhere, including next to
      // another operator. A disallowed adjacent pair (e.g. the ÷+ unary trap)
      // is surfaced by collectDraftErrors and blocks Submit, not the edit.
      const next = tokens.slice();
      next.splice(cursor, 0, { type: 'operator', value: op });
      return { state: { tokens: next, cursor: cursor + 1 }, shake: false };
    }

    case 'DELETE': {
      // Free edit: delete the token before the cursor, always. The old
      // touching-dice lock (a no-op while two dice were fused) is gone — it
      // trapped players who wanted to delete their way out of a mistake. The
      // resulting state, fused or not, is surfaced by collectDraftErrors and
      // blocks Submit, not the edit. Only cursor 0 is a no-op (nothing before).
      if (cursor === 0) return { state, shake: false };
      const next = tokens.slice();
      next.splice(cursor - 1, 1);
      return { state: { tokens: next, cursor: cursor - 1 }, shake: false };
    }

    case 'CLEAR':
      return { state: initialDraftState, shake: false };

    case 'SET_CURSOR': {
      const pos = Math.max(0, Math.min(action.cursor, tokens.length));
      return { state: { tokens, cursor: pos }, shake: false };
    }

    case 'REMAP': {
      const map = action.indexMap;
      const next = tokens.map((t) =>
        t.type === 'die' ? { ...t, index: map[t.index] ?? t.index } : t
      );
      return { state: { tokens: next, cursor }, shake: false };
    }

    case 'HYDRATE':
      return { state: { tokens: action.tokens, cursor: action.cursor }, shake: false };

    default:
      return { state, shake: false };
  }
}
