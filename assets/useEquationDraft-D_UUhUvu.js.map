// computeSubmitHint — the pure "what's left before Submit" decision.
//
// Extracted from EquationBuilder.jsx (R5, 2026-07-03) so the builder's
// highest-branching piece of logic lives in the pure equation-engine, testable
// without React/DOM. The grayed Submit button is the gate; this names the single
// next blocker. Behavior is preserved exactly from the component; the component
// now renders whatever this returns.
//
// Priority (first match wins):
//   1. real mistakes (severity 'error')  → fix them
//   2. not all dice placed                → "Use all 7 dice"
//   3. not-yet-finished spots ('incomplete') → finish them
//   4. valid but not 37                   → how far off (except a Daily 73 while the
//                                            Mirror is open to this player — no hint)
//   5. valid 37 but power-dice rule unmet → "Use the power dice correctly"
//   6. otherwise                          → null (ready — a valid solve)
//
// @returns {{ text: string, tone: 'error'|'incomplete'|'amber'|'muted' } | null}
import { collectDraftErrors, DRAFT_ERROR, TARGET_SUM } from './equationUtils';
import { hasPowerDice, isDaily } from '@/game-modes';

/**
 * @param {{ equation?: any, usedDiceIndices?: any, mode?: string,
 *   isComplete?: boolean, isValid?: boolean, result?: any,
 *   challengeRulesMet?: boolean, draftIssues?: any[], sector73Mirror?: boolean }} [args]
 * @returns {{ text: string, tone: 'error'|'incomplete'|'amber'|'muted' } | null}
 */
export function computeSubmitHint({
  equation,
  usedDiceIndices,
  mode,
  isComplete,
  isValid,
  result,
  challengeRulesMet,
  // Callers that already computed the draft issues for this equation can pass
  // them in to avoid a second collectDraftErrors pass; otherwise we derive them.
  draftIssues,
  // Is Sector 73's Mirror open to this player? false for a guest (David, 2026-10-19:
  // Sector 73 needs a username + password), whose 73 is just another wrong total.
  // Defaults to false (Sector 73 switched off): an un-wired caller gets the 37 hint.
  sector73Mirror = false,
} = {}) {
  if (!equation || equation.length === 0) return null;

  const issues = draftIssues ?? collectDraftErrors(equation, usedDiceIndices);
  const errorIssues = issues.filter((x) => x.severity === 'error');
  const hasPowerRules = hasPowerDice(mode);

  if (errorIssues.length > 0) {
    return errorIssues.some((e) => e.type === DRAFT_ERROR.TOUCHING_DICE)
      ? { text: 'Separate the touching dice', tone: 'error' }
      : { text: 'Fix the highlighted operators', tone: 'error' };
  }

  if (!isComplete) return { text: 'Use all 7 dice', tone: 'muted' };

  const incomplete = issues.filter((x) => x.severity === 'incomplete');
  if (incomplete.length > 0) {
    return incomplete.some((x) => x.type === DRAFT_ERROR.UNMATCHED_PARENS)
      ? { text: 'Match the parentheses', tone: 'incomplete' }
      : { text: 'Each operator needs a number', tone: 'incomplete' };
  }

  // Sector 73's Mirror: a Daily board that reads 73 gets NO distance hint — "36 too many" would
  // spell out that 73 is "wrong" and undercut the secret. (73 = MIRROR_TARGET in @/sector73; a
  // literal here because @/sector73 imports this engine.)
  if (sector73Mirror && isValid && result === 73 && isDaily(mode)) return null;

  if (isValid && result !== TARGET_SUM) {
    return {
      text: result < TARGET_SUM ? `Need ${TARGET_SUM - result} more` : `${result - TARGET_SUM} too many`,
      tone: 'amber',
    };
  }

  if (hasPowerRules && isValid && result === TARGET_SUM && !challengeRulesMet) {
    return { text: 'Use the power dice correctly', tone: 'amber' };
  }

  return null; // ready — a valid solve
}
