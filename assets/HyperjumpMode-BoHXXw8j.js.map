import React, { useEffect, useMemo, useRef, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { ModeHeader, SpaceDie, Keypad, EquationReadout, PrimaryButton, useTokenDraft, ActionDock, POWER_KEY_TINTS } from '../ui';
import { TipSlot, useStuckTimer, DailyChip, PracticeChip } from '../coach';
import { coachLine, goodLine, refusalLine, stuckTip, DIE_TAG } from './coach';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { playSynth } from '../../synth';
import { powerDiceCorrect, correctPowerDice } from '../sectorMath';
import { useJumpMoment } from './JumpMoment';
import JumpBriefing from './JumpBriefing';
import { briefingFor } from './briefing';
import { SCAN_TEXT } from './scanner';
import { useScanRoute } from './useScanRoute';
import ScanShape from './ScanShape';
import { jumpScore, timeReward, tierFor } from './scoring';
import { clearRewards, migrateArtifacts, OXYGEN_TANK_SECONDS, FUEL_CAN_FUEL, canTarget, toolOptions, migrateUsed, ACTIVE_TOOLS, useBlocker, settleDeck, artifactById as artifactInfo } from './artifacts';
import { ArtifactIcon } from './ArtifactIcon';
import PowerUps from './PowerUps';
import DraftScreen from './DraftScreen';
import { bountyForRoll, bountyById, bountyMet, BONUS_FUEL } from './bounties';
import BossEntrance from './BossEntrance';
import { recordBest } from '../bests';
import { todayEastern, randomSeed, makeRng } from '../rng';
import {
  START_OXYGEN, OXYGEN_CAP, drainOxygen, addOxygen,
  START_FUEL, FUEL_CAP, addFuel, BASE_SLOTS, MAX_SLOTS,
  targetFor, bandFor, powerNeeded, flareOpFor, runCardText, curseDesc, hasPowerDice, isBossJump, curseFor, curseById, rollFor, draftFor, judgeJump,
  artifactById, rerollOneDie,
} from './logic';
import { FINAL_JUMP, sectorFor, afterClear, isWinningJump, saveRun, loadRun, clearRun, readDailyAttempt, markDailyAttempt, clearedOf } from './run';
import { earnStars } from '../stars';
import { startDaily, finishDaily } from '../dailyRuns';
import { beforeDailyAttempt } from '../dailyAd';
import RulesSheet from './RulesSheet';
import JumpHud from './JumpHud';
import JumpFlash from './JumpFlash';
import RunResults from './RunResults';
import LaunchCard from './LaunchCard';
import SectorBanner from './SectorBanner';
import PracticeStart from './PracticeStart';

// Hyperjump — the roguelike run. Phases: intro → jump → draft → (sector banner) → jump …
// → over (oxygen out) or won (jump 20 cleared: the Core). Run arc + saving: ./run.js.

const LIVE = new Set(['jump', 'draft', 'sector']);
/** Skipping the draft pays fuel (David, 2026-10-22: salvage was cut; "keep my loadout" should still be worth something). */
export const SKIP_FUEL = 1;

export { ArtifactIcon } from './ArtifactIcon';

/**
 * The launch contract (world framework §D, 2026-10-22): openMode('hyperjump', { entry: 'daily' | 'practice' }).
 * The world shows the Practice object for this game only because the mode exports ACCEPTS_ENTRY.
 *   'daily'    — today's Daily card (ad + claim at DAILY RUN), its resume, or the done card
 *   'practice' — the Practice screen: never the Daily, never a claim, never an ad
 *   no params  — as before: the Gate's launch card with both ways to play.
 */
export const ACCEPTS_ENTRY = true;

/** @param {{ onExit: () => void, onReturnTo37: () => void, user?: any, params?: { entry?: string } | null }} props */
export default function HyperjumpMode({ onExit, onReturnTo37, user = undefined, params = null }) {
  const today = todayEastern();
  // "Practice instead" (on the Daily's done card) switches the entry for this visit.
  const [entry, setEntry] = useState(/** @type {'daily'|'practice'|null} */ (params?.entry === 'daily' || params?.entry === 'practice' ? params.entry : null));
  const [phase, setPhase] = useState('intro'); // intro | jump | draft | over
  const [seed, setSeed] = useState(null);
  const [jump, setJump] = useState(1);
  const [rollK, setRollK] = useState(0);
  const [oxygen, setOxygen] = useState(START_OXYGEN);
  const [fuel, setFuel] = useState(START_FUEL);
  const [artifacts, setArtifacts] = useState([]);
  const [slots, setSlots] = useState(BASE_SLOTS);
  const [lightYears, setLightYears] = useState(0);
  const [message, setMessage] = useState(null);
  const [toolNote, setToolNote] = useState(null); // what a tool just did, in words (Factorial's working)
  useEffect(() => { setToolNote(null); }, [jump, rollK]);
  // The Scan (David, 2026-10-22): level 1 shows the blanked shape of a real route, level 2 lights its
  // biggest part. 1 fuel per level, two per roll. A miss says so (scanMsg) and costs nothing.
  const [scanLevel, setScanLevel] = useState(0);
  const [scanMsg, setScanMsg] = useState(/** @type {string|null} */ (null));
  const [scanning, setScanning] = useState(false); // asked, waiting for the search
  const [lastClear, setLastClear] = useState(null);
  const [swapFor, setSwapFor] = useState(null);
  // Per-jump board edits from artifacts: values (Wild Moon, Thruster, Tractor Beam, Supergiant)
  // and colours (Supergiant turns a white die gold).
  const [overrides, setOverrides] = useState({});
  const [colorOverrides, setColorOverrides] = useState({});
  // This jump's artifact use: `active` = switched ON (one-use: they leave the deck when the
  // jump clears — ./artifacts settleDeck).
  /** @type {[{ active: string[] }, Function]} */
  const [used, setUsed] = useState({ active: [] });
  const [tool, setTool] = useState(null); // the armed tool (./artifacts ACTIVE_TOOLS)
  const [pickDie, setPickDie] = useState(null); // the die a Thruster is choosing a value for
  // The jump clock: seconds this jump has been live (paused like oxygen). The 45-s Bonus runs on it.
  const [jumpSeconds, setJumpSeconds] = useState(0);
  const [entranceSeen, setEntranceSeen] = useState(null); // the boss jump whose entrance has played
  // (The reserve tank, salvage, charges and the Orbit set's kept card were cut 2026-10-22: David's "simpler"
  // brief, with the hidden/moving curses: Dark Matter, Comet, Pulsar, Entropy.)
  const [saved, setSaved] = useState(() => loadRun());
  const [leaving, setLeaving] = useState(null); // the exit to take once "Leave run?" is confirmed
  const [runLog, setRunLog] = useState([]); // one entry per cleared jump → the share card's glyphs
  // Light-year scoring (./scoring.js, David 2026-10-22): the run's Perfect streak, the seconds played on
  // cleared jumps (ties on the Daily board), and whether this jump took a Scan or a Reroll.
  const [perfectStreak, setPerfectStreak] = useState(0);
  const [runSeconds, setRunSeconds] = useState(0);
  const [helped, setHelped] = useState(false);
  // The help this run used, on its results and share card (framework C1), and the jump it began on
  // (Practice can start at a later sector; such a run pays no Core ★).
  const [scansUsed, setScansUsed] = useState(0);
  const [rerollsUsed, setRerollsUsed] = useState(0);
  const [startJump, setStartJump] = useState(1);
  const [endBoard, setEndBoard] = useState(null); // the board that ended the run: one route for it is shown
  // The jump whose briefing (or 1-s flash) is done. Which jumps get a card: `needsBrief` below.
  // Not saved: a resumed run re-briefs the jump it lands on.
  const [briefedJump, setBriefedJump] = useState(null);
  const [resumedJump, setResumedJump] = useState(null); // the jump a resume lands on: it is briefed again
  const readoutRef = useRef(null);
  const moment = useJumpMoment(readoutRef); // "The Jump" signature moment (./JumpMoment.jsx)

  // An artifact works only while it is ON this jump (David, 2026-10-11: one-use, chosen by the player).
  const on = (id) => used.active.includes(id);
  // MIDNIGHT-SAFE (audit 2026-10-18): a Daily is pinned to its date + seed when it starts (or is resumed
  // the same day), so a run that crosses midnight still finishes — and posts — as that day's Daily.
  const [dailyPin, setDailyPin] = useState(/** @type {{ date: string, seed: string } | null} */ (null));
  const isDaily = Boolean(dailyPin) && seed === dailyPin.seed;
  const dailyDate = dailyPin?.date ?? today;
  const savedDaily = Boolean(saved) && saved.seed === `hyperjump-${today}`; // an earlier day's save resumes as Free
  const [dailyAttempt, setDailyAttempt] = useState(() => readDailyAttempt(today));
  const [recorded, setRecorded] = useState(0); // bumps when the server has today's result (board refresh)
  const [sent, setSent] = useState(/** @type {'posted'|'queued'|'dropped'|null} */ (null)); // how the Daily result went
  const [newBest, setNewBest] = useState(false);
  const [endTarget, setEndTarget] = useState(null);
  const recordDaily = (score, then = undefined) => { finishDaily('hyperjump', score).then((r) => { setSent(r); setRecorded((n) => n + 1); then?.(r); }); };
  // DAILY RUN starts at once and claims the attempt on the server alongside: one attempt per
  // ACCOUNT (another phone or cleared data cannot give a second go). If the server says this account
  // already flew it, the run is called off. Offline, the phone's own rule still applies.
  const startDailyRun = () => beforeDailyAttempt(() => { // the Daily ad first (never on a Free Run)
    startRun(true);
    startDaily('hyperjump').then((claim) => {
      if (!claim?.used) return;
      clearRun(); setSaved(null);
      setDailyAttempt(markDailyAttempt(dailyDate, 'elsewhere'));
      setSeed(null); setDailyPin(null); setPhase('intro');
    });
  });
  // The jump whose curse a Deflector cancelled (saved with the run, so a resume keeps it).
  const [deflectedJump, setDeflectedJump] = useState(null);
  const rolledCurse = seed ? curseFor(seed, jump) : null;
  // Deflector: cancels the curse, a Black Hole's too (David, 2026-10-22; it used to only weaken a boss).
  const curse = deflectedJump === jump ? null : rolledCurse;
  const burnedOp = curse === 'solarFlare' ? flareOpFor(seed, jump) : null; // Solar Flare's dead key
  const board = useMemo(() => (seed ? rollFor(seed, jump, rollK, curse) : null), [seed, jump, rollK, curse]);
  const values = useMemo(() => (board ? board.values.map((v, i) => overrides[i] ?? v) : []), [board, overrides]);
  const targetNow = targetFor(jump);
  const colors = useMemo(() => (board ? board.colors.map((c, i) => colorOverrides[i] ?? c) : []), [board, colorOverrides]);
  const draft = useTokenDraft(values, { reuse: on('twinStar') ? 1 : 0 });
  const band = bandFor(jump);
  const need = powerNeeded(jump, curse);
  // FEWER BRIEFINGS (audit D6): a card only when something changes — jump 1, a boss, a curse, or the
  // jump you resume on (~7 a run instead of 20). Other jumps get a 1-s flash of the number and target.
  const needsBrief = jump === 1 || isBossJump(jump) || Boolean(rolledCurse) || resumedJump === jump;
  const briefing = phase === 'jump' && briefedJump !== jump && needsBrief;
  const flashing = phase === 'jump' && briefedJump !== jump && !needsBrief;
  const [rulesOpen, setRulesOpen] = useState(false); // the Rules sheet (./RulesSheet.jsx)
  // ONE pause rule (audit 2026-10-18): the clock is held exactly while the dice are face-down — the
  // briefing, the 1-s jump flash, the Rules sheet and "Leave run?". (Artifact details do NOT pause; tapping a die closes them.)
  const paused = Boolean(leaving || briefing || flashing || rulesOpen);
  // This jump's Bounty (round 2, ./bounties.js) — posted from the jump's FIRST roll; a reroll keeps it
  // only while the new dice still allow it, otherwise it is re-picked (review 2026-10-14).
  const bounty = useMemo(() => (seed && board
    ? bountyForRoll(seed, jump, rollK === 0 ? board : rollFor(seed, jump, 0, curse), board, { burnedOp }) : null),
  [seed, jump, rollK, board, curse, burnedOp]);
  // The Scan's route for the board on screen, searched off the main thread as soon as it lands.
  const scanRoute = useScanRoute(board && phase === 'jump'
    ? { values, colors, jump, curse, artifacts: used.active, burnedOp, target: targetNow } : null);
  // The stuck tip (framework §B1.3): 30 s with no new die placed, or 2 refused JUMPs. "Progress" = the most
  // dice this roll has ever had in the equation, so taking dice out and putting them back is not progress.
  const [refused, setRefused] = useState(0);
  const [maxPlaced, setMaxPlaced] = useState(0);
  const placedCount = Object.keys(draft.counts).length;
  useEffect(() => { setMaxPlaced(0); }, [jump, rollK]);
  useEffect(() => { if (placedCount > maxPlaced) setMaxPlaced(placedCount); }, [placedCount, maxPlaced]);
  const progressKey = `${jump}:${rollK}:${maxPlaced}`;
  useEffect(() => { setRefused(0); }, [progressKey]);
  const stuckTimer = useStuckTimer({ progressKey, refusals: refused, active: phase === 'jump' && !paused && !tool });
  const bountyCtx = (correct) => ({ tokens: draft.tokens, values, colors, jump, curse, burnedOp, seconds: jumpSeconds, correct });

  // Oxygen drains while a jump is on screen, never in the background.
  useEffect(() => {
    if (phase !== 'jump' || paused) return undefined;
    const id = setInterval(() => {
      const hidden = typeof document !== 'undefined' && document.hidden;
      setOxygen((o) => drainOxygen(o, 1, { hidden }));
      if (!hidden) setJumpSeconds((s) => s + 1);
    }, 1000); // whole seconds: the clock shows m:ss, and ticking 10×/s re-rendered the screen 10×/s
    return () => clearInterval(id);
  }, [phase, paused]);

  // Save the run after every step (oxygen to the whole second, so ~1 write a second).
  const oxygenSecond = Math.ceil(oxygen);
  useEffect(() => {
    if (!seed || !LIVE.has(phase)) return;
    saveRun({ seed, phase, jump, rollK, oxygen: oxygenSecond, jumpSeconds, fuel, artifacts, slots, lightYears, overrides, colorOverrides, used, lastClear, runLog, deflectedJump, perfectStreak, runSeconds, helped, scansUsed, rerollsUsed, startJump });
  }, [seed, phase, jump, rollK, oxygenSecond, jumpSeconds, fuel, artifacts, slots, lightYears, overrides, colorOverrides, used, lastClear, runLog, deflectedJump, perfectStreak, runSeconds, helped, scansUsed, rerollsUsed, startJump]);
  const help = { scans: scansUsed, rerolls: rerollsUsed };
  /** The share text, kept with a finished Daily so its "done" card can share it again. */
  const cardFor = (cleared, ly, won) => runCardText({ jump: cleared, lightYears: ly, artifacts, daily: true, date: dailyDate, won, runLog, help });

  useEffect(() => {
    if (phase === 'jump' && oxygen <= 0) {
      playSynth('fail');
      setNewBest(recordBest('hyperjump', jump - 1));
      setEndTarget(targetNow);
      setEndBoard({ values, colors, jump, curse, burnedOp, target: targetNow });
      if (isDaily) { setDailyAttempt(markDailyAttempt(dailyDate, 'over', jump - 1, undefined, { lightYears, card: cardFor(jump - 1, lightYears, false) })); recordDaily({ jump: jump - 1, lightYears, ms: (runSeconds + jumpSeconds) * 1000 }); }
      clearRun();
      setSaved(null);
      setPhase('over');
    }
  }, [oxygen, phase, jump]);

  /** @param {boolean} daily  @param {number} [from] Practice may start at a later sector's first jump */
  const startRun = (daily, from = 1) => {
    const now = todayEastern(); // the date at the tap, not the last render
    const runSeed = daily ? `hyperjump-${now}` : `hyperjump-${randomSeed()}`;
    const first = daily ? 1 : from;
    if (daily) setDailyAttempt(markDailyAttempt(now, 'started'));
    setSent(null);
    setDailyPin(daily ? { date: now, seed: runSeed } : null);
    clearRun();
    setSaved(null);
    setSeed(runSeed);
    setJump(first); setRollK(0); setOxygen(START_OXYGEN); setFuel(START_FUEL);
    // A later start brings 2 power-ups (the draft before that sector would have offered) and its slots.
    setArtifacts(first > 1 ? draftFor(runSeed, first - 1, []).ids.slice(0, 2) : []);
    setSlots(first > 5 ? MAX_SLOTS : BASE_SLOTS); setLightYears(0); setMessage(null);
    setOverrides({}); setColorOverrides({}); setUsed({ active: [] }); setTool(null); setPickDie(null); setRunLog([]); setBriefedJump(null); setResumedJump(null); setDeflectedJump(null);
    setPerfectStreak(0); setRunSeconds(0); setHelped(false);
    setScansUsed(0); setRerollsUsed(0); setStartJump(first); setEndBoard(null);
    draft.clear();
    playSynth('warp');
    setPhase(first > 1 ? 'sector' : 'jump'); // a later start opens on its sector's banner (the lesson lives there)
  };

  const resumeRun = (run) => {
    setDailyPin(run.seed === `hyperjump-${todayEastern()}` ? { date: todayEastern(), seed: run.seed } : null);
    setSeed(run.seed); setJump(run.jump); setRollK(run.rollK || 0); setOxygen(run.oxygen);
    setFuel(run.fuel); setArtifacts(migrateArtifacts(run.artifacts)); setSlots(run.slots || BASE_SLOTS);
    setLightYears(run.lightYears || 0); setOverrides(run.overrides || {}); setColorOverrides(run.colorOverrides || {});
    setUsed(migrateUsed(run.used)); setLastClear(run.lastClear || null); setPickDie(null); setDeflectedJump(run.deflectedJump ?? null);
    // An older save's reserve, salvage, charges and Pulsar lock are ignored (cut 2026-10-22).
    setRunLog(Array.isArray(run.runLog) ? run.runLog : []);
    setPerfectStreak(run.perfectStreak || 0); setRunSeconds(run.runSeconds || 0); setHelped(Boolean(run.helped));
    setScansUsed(run.scansUsed || 0); setRerollsUsed(run.rerollsUsed || 0); setStartJump(run.startJump || 1); setEndBoard(null);
    setJumpSeconds(Number.isFinite(run.jumpSeconds) ? run.jumpSeconds : 0); // the 45-s bonus clock carries on
    setTool(null); setMessage(null); draft.clear(); setBriefedJump(null); setResumedJump(run.phase === 'jump' ? run.jump : null);
    playSynth('warp');
    setPhase(run.phase);
  };

  // "Abandon & start new" (audit D1): a saved Daily ends here and posts the jumps cleared, as running out
  // of oxygen would. A Free save is simply dropped.
  const abandonSaved = () => {
    if (savedDaily) {
      setDailyAttempt(markDailyAttempt(today, 'over', clearedOf(saved)));
      finishDaily('hyperjump', { jump: clearedOf(saved), lightYears: saved.lightYears || 0, ms: (saved.runSeconds || 0) * 1000 });
    }
    clearRun(); setSaved(null);
  };

  // Leaving mid-run asks first (the run is saved either way).
  const guard = (exit) => () => (LIVE.has(phase) ? setLeaving(() => exit) : exit());
  const exitMode = guard(onExit);
  const exitTo37 = guard(onReturnTo37);

  const newJumpState = () => {
    setRollK(0); setOverrides({}); setColorOverrides({}); setUsed({ active: [] }); setTool(null); setPickDie(null);
    setMessage(null); draft.clear(); setScanLevel(0); setScanMsg(null);
    setJumpSeconds(0); setHelped(false);
  };

  // The one-use deck (David, 2026-10-11): tap a power-up in the tray to read it, USE to switch it on.
  const activate = (id) => setUsed((u) => (u.active.includes(id) ? u : { ...u, active: [...u.active, id] }));
  const blocker = (id) => useBlocker(id, { active: used.active, curse, core: need >= 3 });
  const useArtifact = (id) => {
    if (blocker(id)) return;
    setPickDie(null);
    if (ACTIVE_TOOLS.includes(id)) { setTool(id); return; } // a tool is ON once it touches a die
    setTool(null);
    activate(id);
    if (id === 'oxygenTank') {
      // The same 9:37 cap as a cleared jump (review 2026-10-14: the tank went above it).
      const { oxygen: o2, overflow } = addOxygen(oxygen, OXYGEN_TANK_SECONDS, OXYGEN_CAP);
      setOxygen(o2);
      if (overflow) setToolNote(`🫧 Oxygen full (9:37 max): +${OXYGEN_TANK_SECONDS - overflow}s`);
    }
    if (id === 'fuelCan') {
      const add = addFuel(fuel, FUEL_CAN_FUEL);
      setFuel(add.fuel);
      setToolNote(add.lost ? `⛽ Tank full (${FUEL_CAP} max): +${add.gained} fuel` : `⛽ +${add.gained} fuel`);
    }
    if (id === 'deflector') {
      setDeflectedJump(jump);
      setOverrides({}); setColorOverrides({}); draft.clear(); // the dice may change (Gravity Well)
      // …which wipes what the tools did, so they are not spent (as a reroll; contrarian review 2026-10-14).
      setUsed((u) => ({ ...u, active: u.active.filter((a) => !ACTIVE_TOOLS.includes(a)) }));
    }
    playSynth('dock');
  };
  const spendTool = (id) => {
    activate(id);
    setTool(null); setPickDie(null); setScanMsg(null); // the dice changed (a paid Scan level stays: its shape follows the new route)
    playSynth('dock');
  };
  const setDie = (i, value, color) => {
    setOverrides((o) => ({ ...o, [i]: value }));
    if (color) setColorOverrides((c) => ({ ...c, [i]: color }));
  };
  const pickValue = (value) => {
    setDie(pickDie, value);
    spendTool(tool);
  };

  const tapDie = (i) => {
    if (tool) {
      if (!canTarget(tool, colors[i])) return;
      if (tool === 'tractorBeam') {
        setDie(i, rerollOneDie(makeRng(`${seed}-tractor-${jump}-${rollK}-${i}`), colors[i]));
        spendTool(tool);
      } else if (tool === 'supergiant') {
        setDie(i, values[i] * 10, 'gold');
        spendTool(tool);
      } else {
        setPickDie(i); // Thruster: choose the value on the line above the tray
      }
      return;
    }
    if (!draft.canUse(i)) return;
    setMessage(null);
    draft.addDie(i);
  };

  const reroll = () => {
    if (fuel <= 0) return;
    playSynth('warp');
    setFuel((f) => f - 1);
    setHelped(true); // a Reroll is help: no "No help" bonus this jump
    setRerollsUsed((n) => n + 1);
    setRollK((k) => k + 1);
    setOverrides({}); setColorOverrides({});
    setTool(null); setPickDie(null);
    // The reroll wipes what the tools did, so they are not spent (bug 2026-10-11: the card was).
    setUsed((u) => ({ ...u, active: u.active.filter((id) => !ACTIVE_TOOLS.includes(id)) }));
    draft.clear();
    setScanLevel(0); setScanMsg(null); // new dice, new route: the Scan starts again
  };

  // Scan (David, 2026-10-22): the route is searched in the background (./useScanRoute.js); pressing
  // Scan reveals one more level of it. A route found = 1 fuel (Gravity Lens: one free); none = free.
  const canScan = fuel > 0 && !scanning && scanLevel < 2 && !scanMsg;
  const settleScan = (r) => {
    setScanning(false);
    if (r.status !== 'found') { setScanMsg(SCAN_TEXT[r.status] ?? SCAN_TEXT.unknown); return; }
    setFuel((f) => f - 1);
    setHelped(true); // a Scan is help too
    setScansUsed((n) => n + 1);
    setScanLevel((l) => Math.min(2, l + 1));
  };
  const runScan = () => {
    if (!canScan) return;
    playSynth('blip');
    if (scanRoute.result) { settleScan(scanRoute.result); return; }
    setScanning(true);
    scanRoute.request();
  };
  // Asked before the search was done: settle the moment it is.
  useEffect(() => { if (scanning && scanRoute.result) settleScan(scanRoute.result); }, [scanning, scanRoute.result]); // eslint-disable-line react-hooks/exhaustive-deps -- settle once per answer

  const attemptJump = () => {
    const verdict = judgeJump({ tokens: draft.tokens, values, colors, jump, artifacts: used.active, curse, burnedOp, target: targetNow });
    if (!verdict.ok) {
      moment.fail();
      setMessage(refusalLine(verdict, { target: targetNow, need, burnedOp }));
      setRefused((n) => n + 1); // two in a row = stuck (./coach.js)
      return;
    }
    // What the artifacts add — each says so on the clear screen (./artifacts.js).
    const rewards = clearRewards({ assisted: verdict.assisted });
    // One-use: what was used leaves the deck now, and says so.
    const settled = settleDeck(artifacts, used.active);
    setArtifacts(settled.deck);
    const metBounty = bounty && bountyMet(bounty, bountyCtx(verdict.correct));
    const deckProcs = [
      ...(settled.spent.length ? [{ id: 'spent', icon: '🃏', text: `Used up: ${settled.spent.map((id) => artifactInfo(id)?.name).join(', ')}` }] : []),
      ...(metBounty ? [{ id: 'bounty', icon: '🎯', text: `Bonus met: +${BONUS_FUEL}⛽ · ${bountyById(bounty).text}` }] : []),
    ];
    // Help = a Scan, a Reroll, or any power-up USED on this jump (David, 2026-10-22). Reading a card is free.
    const wasHelped = helped || used.active.some((id) => artifacts.includes(id));
    const tier = tierFor(need);
    // Oxygen back follows how good the jump was (./scoring.js timeReward), up to the 9:37 ceiling.
    const time = timeReward({ tier, perfect: verdict.perfect, seconds: jumpSeconds, helped: wasHelped });
    const oxygenGain = time.seconds;
    const { oxygen: nextOxygen, overflow } = addOxygen(oxygen, oxygenGain, OXYGEN_CAP);
    const score = jumpScore({
      target: targetNow, tier, perfect: verdict.perfect, seconds: jumpSeconds, helped: wasHelped,
      cursed: Boolean(rolledCurse), deflected: deflectedJump === jump, streakBefore: perfectStreak,
    });
    const { ly } = score;
    setPerfectStreak(score.streak);
    setRunSeconds((s) => s + jumpSeconds);
    setLightYears((l) => l + ly);
    setOxygen(nextOxygen);
    setRunLog((r) => [...r, { jump, perfect: verdict.perfect, rerolled: rollK > 0 }]);
    // Fuel tops out at FUEL_CAP (review 2026-10-14: 20 fuel at the Core made rerolls free).
    const fuelAdd = addFuel(fuel, metBounty ? BONUS_FUEL : 0);
    const fuelGain = fuelAdd.gained;
    if (fuelGain) setFuel(fuelAdd.fuel);
    if (fuelAdd.lost) deckProcs.push({ id: 'fuel-full', icon: '⛽', text: `Fuel tank full (${FUEL_CAP} max)` });
    // A Black Hole adds a slot, up to MAX_SLOTS. Say so only when it really did (it said "+1" after every boss).
    const slotGained = isBossJump(jump) && slots < MAX_SLOTS;
    if (slotGained) setSlots((s) => Math.min(MAX_SLOTS, s + 1));
    setLastClear({ jump, ly, lyParts: score.parts, time, timeCapped: overflow > 0, perfect: verdict.perfect, fuelGain, oxygenGain, slotGained, procs: [...rewards.procs, ...deckProcs] });
    // 'warping' keeps the jump screen up (oxygen paused) while the moment plays, then lands.
    setPhase('warping');
    if (isWinningJump(jump)) {
      setNewBest(recordBest('hyperjump', jump));
      clearRun();
      setSaved(null);
      // The Core's ★ (audit D10, David's pick): a Daily pays 5★ — asked for only AFTER the server has the
      // result, because it checks that this account finished today's Daily at jump 20; a Free run pays 2★
      // under its own daily cap (it never blocks the Daily's).
      if (isDaily) {
        setDailyAttempt(markDailyAttempt(dailyDate, 'won', FINAL_JUMP, undefined, { lightYears: lightYears + ly, card: cardFor(FINAL_JUMP, lightYears + ly, true) }));
        recordDaily({ jump: FINAL_JUMP, lightYears: lightYears + ly, ms: (runSeconds + jumpSeconds) * 1000 }, (r) => { if (r !== 'dropped') earnStars('hj_core', seed); });
      } else if (startJump === 1) earnStars('hj_core_free', seed); // a Practice run from a later sector pays no Core ★
      moment.start('core', jump, () => setPhase('won'));
      return;
    }
    moment.start(isBossJump(jump) ? 'boss' : 'jump', jump, () => setPhase('draft'));
  };

  const pickArtifact = (id) => {
    if (artifacts.length >= slots) { setSwapFor(id); return; }
    setArtifacts((a) => [...a, id]);
    nextJump();
  };
  const swapOut = (oldId) => {
    setArtifacts((a) => a.map((x) => (x === oldId ? swapFor : x)));
    setSwapFor(null);
    nextJump();
  };
  const nextJump = () => {
    newJumpState();
    setJump((j) => j + 1);
    playSynth('warp');
    setPhase(afterClear(jump) === 'sector' ? 'sector' : 'jump');
  };

  const ops = ['+', '-', '*', '/', '^', '(', ')'];

  const leaveModal = leaving && (
    <div className="absolute inset-0 z-50 grid place-items-center bg-black/70 px-6">
      <div className="w-full max-w-xs rounded-2xl border border-violet-400/50 bg-[#0d0820] p-5 text-center">
        <div className="text-lg font-black text-white">Leave run?</div>
        <p className="mt-1 text-sm text-slate-300">It&apos;s saved — resume from the Hyperjump Gate. Oxygen does not drain while you&apos;re away.</p>
        <div className="mt-4 grid grid-cols-2 gap-2">
          <button type="button" onClick={() => setLeaving(null)} className="rounded-xl border border-white/20 py-2.5 text-sm font-bold text-slate-200">Keep flying</button>
          <button type="button" data-testid="hj-leave" onClick={() => { const go = leaving; setLeaving(null); go(); }} className="rounded-xl bg-violet-500 py-2.5 text-sm font-black text-white">Leave</button>
        </div>
      </div>
    </div>
  );

  if (phase === 'intro' && entry === 'practice') {
    return (
      <PracticeStart saved={saved && !savedDaily ? saved : null} onResume={() => resumeRun(saved)} onStart={(from) => startRun(false, from)}
        onExit={onExit} onReturnTo37={onReturnTo37} />
    );
  }

  if (phase === 'intro') {
    return (
      <LaunchCard today={today} saved={saved} savedDaily={savedDaily} dailyAttempt={dailyAttempt} entry={entry === 'daily' ? 'daily' : null}
        onPractice={() => setEntry('practice')}
        onDaily={startDailyRun} onFree={() => startRun(false)} onResume={() => resumeRun(saved)} onAbandon={abandonSaved}
        onExit={onExit} onReturnTo37={onReturnTo37} />
    );
  }

  if (phase === 'over' || phase === 'won') {
    return (
      <RunResults won={phase === 'won'} jump={jump} lightYears={lightYears} artifacts={artifacts} runLog={runLog}
        isDaily={isDaily} date={dailyDate} recorded={recorded} newBest={newBest}
        placeStatus={user === null ? 'signedOut' : user?.is_anonymous ? 'guest' : sent ?? 'pending'} stoppedTarget={endTarget} onExit={onExit} onReturnTo37={onReturnTo37} onNewRun={() => setPhase('intro')}
        help={help} endBoard={endBoard} coreStarEligible={startJump === 1} />
    );
  }

  if (phase === 'sector') {
    return (
      <SectorBanner jump={jump} onEnter={() => setPhase('jump')}
        onExit={exitMode} onReturnTo37={exitTo37} leaveModal={leaveModal} />
    );
  }

  if (phase === 'draft') {
    return (
      <DraftScreen
        jump={jump} band={band} lastClear={lastClear} artifacts={artifacts} swapFor={swapFor}
        draft={draftFor(seed, jump, artifacts)}
        onPick={pickArtifact} onSwapOut={swapOut} onCancelSwap={() => setSwapFor(null)}
        skipFuel={SKIP_FUEL}
        onSkip={() => { setFuel((f) => addFuel(f, SKIP_FUEL).fuel); nextJump(); }}
        exitMode={exitMode} exitTo37={exitTo37} leaveModal={leaveModal}
      />
    );
  }

  // phase === 'jump'
  const curseInfo = curse ? curseById(curse) : null;
  const target = targetNow;
  // Live judgement of the draft (pure + cheap): green only when JUMP would really pass.
  const liveVerdict = draft.result.ok ? judgeJump({ tokens: draft.tokens, values, colors, jump, artifacts: used.active, curse, burnedOp, target: targetNow }) : null;
  const livePower = draft.result.ok ? powerDiceCorrect(draft.result.leaves, colors) : 0;
  // JUMP lights when every die is in (audit D3) — it used to light after any tap. A wrong total still
  // goes through judgeJump and shakes with its reason, so pressing JUMP keeps teaching the rules.
  const diceLeft = Math.max(0, values.length - Object.keys(draft.counts).length);
  // The stuck tip's words (./coach.js): a power die that doesn't count yet, or which way the Scan's route goes.
  const stuckText = stuckTip({
    values, colors, need, target,
    countedDice: draft.tokens.length ? correctPowerDice(draft.tokens, values, colors) : [],
    placed: Object.keys(draft.counts).map(Number),
    route: scanRoute.result?.status === 'found' ? scanRoute.result : null,
  });
  return (
    <div className="relative isolate flex h-full flex-col overflow-y-auto pb-6" style={{ background: curseInfo ? 'radial-gradient(ellipse at top, #450a0a 0%, #04030d 70%)' : 'radial-gradient(ellipse at top, #1e1b4b 0%, #04030d 70%)' }}>
      <ModeBackdrop theme="hyperjump" />
      <ModeHeader title={`Jump ${jump} of ${FINAL_JUMP}`} subtitle={isDaily ? <DailyChip date={dailyDate} /> : <PracticeChip />} onExit={exitMode} onReturnTo37={exitTo37} />
      <JumpHud target={target}
        jump={jump} oxygen={oxygen} fuel={fuel} lightYears={lightYears}
        curseInfo={curseInfo}
        powerDice={hasPowerDice(jump)} livePower={livePower} need={need} bounty={bounty}
        bountyMet={Boolean(bounty && liveVerdict?.ok && bountyMet(bounty, bountyCtx(liveVerdict.correct)))}
        onRules={() => setRulesOpen(true)} />

      {/* Paused = face-down: nothing that shows a die's value (faces, equation, scan hint, tool tags). */}
      <div data-testid="hj-play" className={`mt-3 space-y-2 px-3 ${paused ? 'invisible' : ''}`}>
        <div data-testid="hj-dice-row" className={`flex justify-center ${values.length > 7 ? 'gap-1' : 'gap-1.5'}`}>
          {values.map((v, i) => (
            <SpaceDie
              key={i}
              value={v}
              color={colors[i]}
              size={values.length > 7 ? 38 : 44} // eight dice fit one row at 360 px: 8 × 38 + 7 × 4 = 332 ≤ 336 (was 362: clipped)
              hidden={paused}
              used={tool ? !canTarget(tool, colors[i]) : !draft.canUse(i)}
              dim={tool ? !canTarget(tool, colors[i]) : Boolean(draft.counts[i])}
              badge={!tool && draft.counts[i] && draft.canUse(i) ? '🌟' : null}
              tag={DIE_TAG[colors[i]] ?? null /* a power die wears its keys (David, 2026-10-22: the rule on screen) */}
              glow={pickDie === i} // the Scan never points at a die (David, 2026-10-22)
              onClick={() => tapDie(i)}
            />
          ))}
        </div>
        <motion.div ref={readoutRef} key={moment.failKey} {...moment.readoutAnim}>
          <EquationReadout tokens={draft.tokens} values={values} colors={colors} result={draft.result} target={target}
            accepted={liveVerdict?.ok ?? false} cursor={draft.cursor} onCursor={tool ? undefined : draft.setCursor} lines={2} showGap powerRings={hasPowerDice(jump)} />
        </motion.div>
        {scanLevel > 0 && scanRoute.result?.status === 'found' && <ScanShape tree={scanRoute.result.tree} level={scanLevel} />}
        {/* ONE message slot (framework §B3): refusal > stuck tip > good > coach line. */}
        <TipSlot testId="hj-tip-slot" onDismissTip={stuckTimer.dismiss} messages={{
          refusal: message,
          tip: stuckTimer.stuck && stuckText,
          good: liveVerdict?.ok && goodLine({ target, perfect: liveVerdict.perfect && need < 3 }),
          coach: scanning ? '📡 Scanning…' : (scanMsg && `📡 ${scanMsg}`) || toolNote
            || coachLine({ target, diceLeft, value: draft.result.ok ? draft.result.value : null, need, power: livePower }),
        }} />
        {/* Power-ups: the shared tray above the keypad (framework §C2). */}
        <PowerUps artifacts={artifacts} slots={slots} active={used.active} tool={tool} blocker={blocker} onUse={useArtifact}
          picker={pickDie != null && tool ? { options: toolOptions(tool, values[pickDie], colors[pickDie]) } : null}
          onPick={pickValue} onCancel={() => { setPickDie(null); setTool(null); }} />
        <Keypad ops={ops} onOp={draft.addOp} onDelete={draft.del} onClear={draft.clear} disabled={Boolean(tool)} tints={hasPowerDice(jump) ? POWER_KEY_TINTS : null} burned={burnedOp} />
        <ActionDock>
          <div className="grid grid-cols-4 gap-2">
            <button type="button" disabled={fuel <= 0} onClick={reroll} className="rounded-xl border border-amber-400/50 bg-amber-500/10 py-1.5 text-sm font-bold leading-tight text-amber-100 disabled:opacity-40">
              <span>⛽ Reroll</span>
              <span data-testid="hj-reroll-cost" className="block text-[10px] font-semibold opacity-80">1 fuel</span>
            </button>
            <button type="button" data-testid="hj-scan" disabled={!canScan} onClick={runScan} className="rounded-xl border border-cyan-400/50 bg-cyan-500/10 py-1.5 text-sm font-bold leading-tight text-cyan-100 disabled:opacity-40">
              <span>📡 {scanLevel === 1 ? 'Scan 2' : 'Scan'}</span>
              <span data-testid="hj-scan-cost" className="block text-[10px] font-semibold opacity-80">{scanLevel >= 2 ? 'done' : '1 fuel'}</span>
            </button>
            <div className="col-span-2">
              <PrimaryButton testId="hj-jump" disabled={Boolean(tool) || diceLeft > 0} onClick={attemptJump}>{diceLeft > 0 ? `${diceLeft} ${diceLeft === 1 ? 'die' : 'dice'} left` : 'JUMP ▶'}</PrimaryButton>
            </div>
          </div>
        </ActionDock>
      </div>
      {flashing && <JumpFlash jump={jump} target={targetNow} onDone={() => setBriefedJump(jump)} />}
      {briefing && isBossJump(jump) && entranceSeen !== jump && <BossEntrance jump={jump} onDone={() => setEntranceSeen(jump)} />}
      {briefing && (
        <JumpBriefing
          brief={briefingFor({ jump, curse, artifacts, active: used.active, fuel, burnedOp, bounty, deflected: deflectedJump === jump ? rolledCurse : null })}
          onDeflect={() => useArtifact('deflector')}
          sectorNote={jump === 1 ? sectorFor(1).blurb : null}
          onLaunch={() => setBriefedJump(jump)}
          onLeave={onExit} // it's saved: no second "Leave run?"
          renderIcon={(id) => <ArtifactIcon id={id} />}
        />
      )}
      {rulesOpen && (
        <RulesSheet
          brief={briefingFor({ jump, curse, artifacts, active: used.active, fuel, burnedOp, bounty, deflected: deflectedJump === jump ? rolledCurse : null })}
          renderIcon={(id) => <ArtifactIcon id={id} />}
          onClose={() => setRulesOpen(false)}
        />
      )}
      {moment.overlay}
      {leaveModal}
    </div>
  );
}
