import React from 'react';
import { createPortal } from 'react-dom';

// Hyperjump's Rules sheet (David, 2026-10-14: "we want people to be able to access a rules or
// explanations sheet that gives them all the info, but it is just a way to crowded screen"). The
// play screen and the briefing now show only short chips; every full sentence lives here.
// Opened from the ⓘ chip on the jump screen and "Full rules" on the briefing. Portaled to <body>
// so it sits above everything on iPhone too (memory: ios-overlays-must-portal).

const Section = ({ title, children, testId = undefined }) => (
  <section className="mt-3" data-testid={testId}>
    <h3 className="text-[10px] uppercase tracking-[0.3em] text-violet-300">{title}</h3>
    <div className="mt-1 space-y-1.5 text-sm text-slate-200">{children}</div>
  </section>
);

/**
 * @param {{ brief: any, onClose: () => void, renderIcon?: (id: string) => React.ReactNode }} props
 *   brief = briefingFor(...) for the current jump (./briefing.js)
 */
export default function RulesSheet({ brief, onClose, renderIcon = () => null }) {
  return createPortal(
    <div className="fixed inset-0 z-[10001] flex items-end justify-center bg-black/70" data-testid="hj-rules"
      onPointerDown={(e) => { e.stopPropagation(); if (e.target === e.currentTarget) onClose(); }}
      style={{ paddingTop: 'calc(var(--safe-top, 0px) + 12px)' }}>
      <div className="max-h-full w-full max-w-md overflow-y-auto rounded-t-3xl border border-violet-400/40 bg-[#0b0720] px-4 pt-4 text-left text-white"
        style={{ paddingBottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 20px)' }}>
        <div className="flex items-center justify-between">
          <div className="text-lg font-black">ⓘ Hyperjump rules</div>
          <button type="button" onClick={onClose} data-testid="hj-rules-close" className="rounded-full border border-white/20 px-3 py-1 text-sm">Close</button>
        </div>

        <Section title={`This jump · ${brief.jump} · ${brief.sector}`} testId="hj-rules-jump">
          <p>🎯 Make <b>{brief.target}</b>.</p>
          {brief.curse
            ? <p data-testid="hj-rules-curse">🕳️ <b>{brief.boss ? 'Black Hole curse' : 'Curse'}: {brief.curse.name}</b> — {brief.curse.desc}</p>
            : <p>☀️ Clear skies — no curse this jump.</p>}
          <p>🎲 {brief.dice.text}</p>
          {brief.dice.power && <p data-testid="hj-rules-power">Power dice: <span className="text-emerald-300">green</span> is added or taken away (+ −), <span className="text-sky-300">blue</span> multiplies or divides (× ÷), <span className="text-rose-300">red</span> is part of a power (^). Inside brackets, it counts for the key it sits next to there. The keys are tinted to match.</p>}
          {brief.tensDie && <p>🟡 The gold Tens Die (10, 20 … 60) must be used too.</p>}
          {brief.bounty && <p>{brief.bounty.icon} <b>Bonus</b> (optional) — {brief.bounty.text} · +{brief.bounty.fuel}⛽ fuel.</p>}
        </Section>

        <Section title="Your power-ups" testId="hj-rules-artifacts">
          {brief.loadout.length ? brief.loadout.map((a) => (
            <p key={a.id} className="flex gap-2"><span className="w-6 shrink-0 text-center">{renderIcon(a.id)}</span><span><b>{a.name}</b> — {a.what} <span className="text-slate-400">Best when: {a.when}</span></span></p>
          )) : <p className="text-slate-400">None yet — clear a jump to choose your first.</p>}
          <p className="text-slate-400">Tap a power-up in the tray to read it, then USE it. Each one works once: it is used up when you clear the jump.</p>
        </Section>

        <Section title="How Hyperjump works">
          <p>🎯 Each jump has a target: 37 × the jump number. Use every die once to make it. 20 jumps in 4 sectors.</p>
          <p>🫁 Oxygen runs down while you think (paused on the briefing and while these rules are open). A cleared jump gives 30 s (40 in the Core), +20 s if fast (under 20 s) or +10 s if quick (under 40 s), +10 s for a Perfect and +10 s if you used no help; never above 9:37.</p>
          <p>⚡ From jump 6, coloured dice must do their job: 1 of them in Sector 2, 2 in Sector 3, all 3 in the Core. All 3 is a <b>Perfect</b>.</p>
          <p>🕳️ Every 5th jump is a Black Hole with a hard curse; a few other jumps get a mild one. A Deflector cancels any curse.</p>
          <p>⛽ Fuel (the tank holds 6) pays for a <b>Reroll</b> (new dice) or a <b>Scan</b> (the shape of a real route, numbers hidden).</p>
          <p>✨ <b>Light-years</b> are your score: the target, ×1.5 for a Perfect (not in the Core, where it is the rule), plus bonuses for speed, no help (no Scan, Reroll or power-up), beating a curse and Perfect streaks (Sectors 2 and 3). The Daily is the same run for everyone, one attempt: furthest jump, then most light-years, then the faster time.</p>
        </Section>
      </div>
    </div>,
    document.body,
  );
}
