import React from 'react';
import { routeShape, SCAN_TEXT } from './scanner';

// What a Scan shows (David, 2026-10-22): the shape of a real route with every number blanked, so you
// see which keys and which grouping work, never which die. Level 2 lights the part of the route that
// makes most of the target.

/**
 * @param {{ tree: object, level: number, free?: boolean }} props level 1 or 2
 */
export default function ScanShape({ tree, level, free = false }) {
  const { segments } = routeShape(tree, { level });
  return (
    <div data-testid="hj-scan-shape" data-level={level} className="text-center">
      <div className="text-xs text-cyan-200">📡 {SCAN_TEXT[level === 2 ? 2 : 1]}{free ? ' · 🔭 free' : ''}</div>
      <div data-testid="hj-scan-route" className="mt-0.5 text-lg font-black tracking-wide text-cyan-100">
        {segments.map((s, k) => (
          <span key={k} data-big={s.big ? 'true' : undefined}
            className={s.big ? 'rounded-md bg-amber-400/25 px-0.5 text-amber-200 ring-1 ring-amber-300/70' : undefined}>
            {s.text}
          </span>
        ))}
      </div>
    </div>
  );
}
