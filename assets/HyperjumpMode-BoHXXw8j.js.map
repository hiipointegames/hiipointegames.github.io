import React from 'react';
import { PowerUpTray } from '../coach';
import { artifactById, TOOL_TEXT } from './artifacts';

// Hyperjump's power-ups on the jump screen (framework §C, 2026-10-22): the shared tray above the keypad
// (tap → card → USE), and, while a tool is armed, one line that says what to do next (Thruster's value
// picker sits there too). Replaces the artifact row that sat under the stat tiles.

/**
 * @param {object} p
 * @param {string[]} p.artifacts   the deck
 * @param {number} p.slots
 * @param {string[]} p.active      used this jump
 * @param {string|null} p.tool     the armed tool
 * @param {(id: string) => string|null} p.blocker   why it cannot be used now
 * @param {(id: string) => void} p.onUse
 * @param {{ options: number[] } | null} p.picker   values to choose for the tapped die (Thruster)
 * @param {(value: number) => void} p.onPick
 * @param {() => void} p.onCancel
 */
export default function PowerUps({ artifacts, slots, active, tool, blocker, onUse, picker, onPick, onCancel }) {
  const powerUps = artifacts.map(artifactById).filter(Boolean).map((a) => ({
    id: a.id,
    icon: a.icon,
    name: a.short,
    what: a.what,
    cost: '1 use',
    active: active.includes(a.id) || tool === a.id,
    disabledReason: active.includes(a.id) ? undefined : blocker(a.id) ?? undefined,
    thisJump: a.kind === 'rule',
  }));
  return (
    <div data-testid="hj-power-ups">
      {tool && (
        <div data-testid="hj-tool-prompt" aria-live="polite" className="flex min-h-[34px] flex-wrap items-center justify-center gap-1.5 text-sm text-amber-100">
          {picker ? (
            <span className="flex flex-wrap items-center justify-center gap-1.5" data-testid="hj-picker">
              {picker.options.map((v) => (
                <button key={v} type="button" data-testid={`hj-pick-${v}`} onClick={() => onPick(v)}
                  className="min-w-[40px] rounded-lg border border-amber-300/70 bg-amber-500/20 px-2 py-1.5 text-base font-black text-amber-50 active:scale-90">
                  {v}
                </button>
              ))}
            </span>
          ) : <span>{TOOL_TEXT[tool]}</span>}
          <button type="button" data-testid="hj-tool-cancel" onClick={onCancel} className="rounded-lg border border-white/20 px-2 py-1 text-xs text-slate-300">Cancel</button>
        </div>
      )}
      {/* Five buttons fill a 360-px row (5 × 60 + 4 × 8 = 332), so the count sits on its own line. */}
      {artifacts.length > 0 && (
        <div data-testid="hj-bag" className="text-center text-[10px] uppercase tracking-[0.2em] text-slate-400" aria-label={`${artifacts.length} of ${slots} power-up slots`}>
          Power-ups {artifacts.length}/{slots}
        </div>
      )}
      <PowerUpTray testId="hj-tray" powerUps={powerUps} onUse={onUse} />
    </div>
  );
}
