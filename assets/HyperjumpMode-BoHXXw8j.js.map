import React, { useEffect, useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { useFx, runTimeline, prefersReducedMotion } from '../../fx';

// The Black Hole's entrance (David, 2026-10-11: "a boss entrance moment, so bosses feel like
// events"). Plays before a boss jump's briefing card; a tap anywhere skips it.
//
// Beats (ms): 0 dark + rumble (cue bossArrive: warp sound, heavy vibration, shake) · 0–900 the
// black hole swells in, its accretion ring spinning · 550 "BLACK HOLE" slams in · 950 the jump
// line · 2000 done. Reduced motion: nothing moves — the cue's sound + vibration still mark it,
// and it hands straight over to the briefing.

export const ENTRANCE_MS = Object.freeze({ title: 550, sub: 950, done: 2000 });

export default function BossEntrance({ jump, onDone }) {
  const fx = useFx();
  const [stage, setStage] = useState('swell'); // swell → title → sub
  const tl = useRef(null);
  const doneRef = useRef(onDone);
  doneRef.current = onDone;

  useEffect(() => {
    fx.cue('bossArrive');
    if (prefersReducedMotion()) { doneRef.current(); return undefined; }
    tl.current = runTimeline([
      { at: ENTRANCE_MS.title, run: () => setStage('title') },
      { at: ENTRANCE_MS.sub, run: () => setStage('sub') },
      { at: ENTRANCE_MS.done, run: () => doneRef.current() },
    ]);
    return () => tl.current?.cancel();
  }, [fx]);

  const skip = () => { tl.current?.cancel(); doneRef.current(); };

  return (
    <div data-testid="hj-boss-entrance" data-stage={stage} role="presentation" onClick={skip}
      className="absolute inset-0 z-50 grid place-items-center overflow-hidden bg-black">
      <motion.div
        className="absolute h-[70vmin] w-[70vmin] rounded-full"
        initial={{ scale: 0, opacity: 0 }}
        animate={{ scale: 1, opacity: 1, rotate: 360 }}
        transition={{ scale: { duration: 0.9, ease: [0.16, 1, 0.3, 1] }, opacity: { duration: 0.4 }, rotate: { duration: 6, ease: 'linear', repeat: Infinity } }}
        style={{ background: 'conic-gradient(from 0deg, #f59e0b, #fb7185, #a78bfa, #22d3ee, #f59e0b)' }} // no blur filter: costly on Android WebView
      />
      <motion.div
        className="absolute h-[46vmin] w-[46vmin] rounded-full bg-black"
        initial={{ scale: 0 }}
        animate={{ scale: 1 }}
        transition={{ duration: 0.9, ease: [0.16, 1, 0.3, 1] }}
        style={{ boxShadow: '0 0 60px 20px #000, inset 0 0 40px #000' }}
      />
      <div className="relative text-center">
        {stage !== 'swell' && (
          <motion.div
            initial={{ scale: 1.6, opacity: 0 }}
            animate={{ scale: 1, opacity: 1 }}
            transition={{ type: 'spring', stiffness: 420, damping: 18 }}
            className="text-4xl font-black tracking-[0.25em] text-amber-300"
            style={{ textShadow: '0 0 24px #f59e0b' }}
          >
            BLACK HOLE
          </motion.div>
        )}
        {stage === 'sub' && (
          <motion.div initial={{ opacity: 0, y: 6 }} animate={{ opacity: 1, y: 0 }} className="mt-2 text-sm uppercase tracking-[0.35em] text-rose-200">
            Jump {jump} · boss
          </motion.div>
        )}
      </div>
      <div className="absolute bottom-6 text-[10px] uppercase tracking-[0.3em] text-slate-500">Tap to skip</div>
    </div>
  );
}
