import React, { useState } from 'react';
import { createPortal } from 'react-dom';
import { ModeHeader, PrimaryButton, ClickShield, ShareButton } from '../ui';
import { DailyChip } from '../coach';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import HowItWorks from '../HowItWorks';
import { sectorFor, FINAL_JUMP, isDailySeed } from './run';
import { FUEL_CAP } from './logic';
import { clearedText } from './RunResults';
import HyperjumpDemo from './HyperjumpDemo';

// Hyperjump's launch card (audit 2026-10-18, D1). Replaces a 201-word intro: one caption, the two
// ways to play with a line each, and "ⓘ How it works" for the rest. With a run saved, RESUME is the
// only way on (plus "Abandon & start new"), so a tap can never restart or wipe a saved Daily.

export const LAUNCH_CAPTION = 'Make 37 × the jump number. Use every die.';

/** The full rules, behind ⓘ (moved from the old intro; power dice AND the Tens Die arrive at jump 6). */
export const HOW_IT_WORKS = [
  `🎯 Each jump has a target: 37 × the jump number. Use every die once to make it. ${FINAL_JUMP} jumps in 4 sectors; clear jump ${FINAL_JUMP} to reach the Core.`,
  '🫁 Oxygen starts at 9:37 and runs down while you think. A cleared jump gives 30 s (40 in the Core), +20 if fast or +10 if quick, +10 for a Perfect, +10 with no help; never above 9:37. At zero the run ends.',
  '⚡ From jump 6, coloured power dice join: green is added or taken away, blue multiplies or divides, red is part of a power (^). Use 1 that way in Sector 2, 2 in Sector 3, all 3 in the Core. A gold Tens die (10–60) joins too.',
  '🕳️ Every 5th jump is a Black Hole with a hard curse; a few other jumps get a mild one. A Deflector cancels any curse.',
  `🎒 After each jump, pick 1 of 3 power-ups (or Skip for +1 fuel). Each works once: tap it in the tray, then USE. ⛽ Fuel (up to ${FUEL_CAP}) buys a Reroll or a 📡 Scan (the shape of a real route).`,
  '✨ Light-years are your score: the target, ×1.5 for a Perfect, plus bonuses for speed, no help, beating a curse and Perfect streaks.',
];

function ConfirmAbandon({ daily, onYes, onNo }) {
  return createPortal(
    <div data-testid="hj-abandon-confirm" className="fixed inset-0 z-[10001] grid place-items-center bg-black/80 px-6" role="dialog" aria-modal="true">
      <ClickShield className="w-full max-w-xs">
      <div className="rounded-2xl border border-violet-400/50 bg-[#0d0820] p-5 text-center text-white">
        <div className="text-lg font-black">Abandon this run?</div>
        <p className="mt-1 text-sm text-slate-300">{daily ? "Today's Daily ends here — your jumps so far go on the board." : 'It ends here.'}</p>
        <div className="mt-4 grid grid-cols-2 gap-2">
          <button type="button" autoFocus onClick={onNo} className="rounded-xl border border-white/20 py-2.5 text-sm font-bold">Keep it</button>
          <button type="button" data-testid="hj-abandon-yes" onClick={onYes} className="rounded-xl bg-rose-500 py-2.5 text-sm font-black">Abandon</button>
        </div>
      </div>
      </ClickShield>
    </div>,
    document.body,
  );
}

/**
 * The world's Daily object (entry 'daily', David 2026-10-22): today's Daily only, with the gold chip.
 * Flown already → the done card (result, Share, Practice instead). A saved PRACTICE run is not offered
 * here; starting the Daily ends it, and the card says so.
 */
function DailyEntry({ today, saved, savedDaily, dailyAttempt, usedText, onDaily, onResume, onAbandonAsk, onPractice }) {
  if (savedDaily) {
    return (
      <>
        <PrimaryButton tone="cyan" testId="hj-resume" onClick={onResume}>RESUME TODAY&apos;S DAILY · Jump {saved.jump}</PrimaryButton>
        <button type="button" data-testid="hj-abandon" onClick={onAbandonAsk} className="mx-auto block min-h-[32px] text-xs text-slate-400 underline">Abandon</button>
      </>
    );
  }
  if (usedText) {
    return (
      <div data-testid="hj-daily-done" className="space-y-2 rounded-xl border border-amber-500/40 bg-amber-950/30 px-3 py-3 text-sm text-amber-50">
        <div>{usedText}</div>
        {dailyAttempt?.lightYears != null && <div data-testid="hj-daily-done-ly" className="text-lg font-black">{dailyAttempt.lightYears.toLocaleString()} light-years</div>}
        <div className="text-xs text-amber-200/80">New Daily tomorrow.</div>
        <div className="flex justify-center gap-2 pt-1">
          {dailyAttempt?.card && <ShareButton text={() => dailyAttempt.card} label="Share" />}
          <button type="button" data-testid="hj-practice-instead" onClick={onPractice} className="rounded-xl border border-white/25 px-3 py-2 text-sm font-bold text-white">Practice instead</button>
        </div>
      </div>
    );
  }
  return (
    <div>
      <PrimaryButton testId="hj-daily" onClick={onDaily}>DAILY RUN · {today.slice(5)}</PrimaryButton>
      <div className="mt-1 text-xs text-slate-300">One try today · after a short ad</div>
      {saved && <div data-testid="hj-daily-ends-practice" className="mt-1 text-xs text-amber-200">Starting it ends your practice run (jump {saved.jump}).</div>}
    </div>
  );
}

/**
 * @param {{ today: string, saved: any, savedDaily: boolean, dailyAttempt: any,
 *   onDaily: () => void, onFree: () => void, onResume: () => void, onAbandon: () => void,
 *   onExit: () => void, onReturnTo37: () => void, entry?: 'daily' | null, onPractice?: () => void }} props
 *   savedDaily = the saved run is TODAY's Daily (a saved run from an earlier day resumes as Free).
 *   entry 'daily' = opened from the world's Daily object; null = the old Gate (both ways to play).
 */
export default function LaunchCard({ today, saved, savedDaily, dailyAttempt, onDaily, onFree, onResume, onAbandon, onExit, onReturnTo37, entry = null, onPractice = () => {} }) {
  const [how, setHow] = useState(false);
  const [abandon, setAbandon] = useState(false);
  const usedText = dailyAttempt && (dailyAttempt.status === 'won' ? "☀️ Today's Daily: you reached the Core!"
    : dailyAttempt.status === 'over' ? `Today's Daily: ${clearedText(dailyAttempt.jump).toLowerCase()}.`
      : dailyAttempt.status === 'elsewhere' ? "Today's Daily was already flown on your account."
        : "Today's Daily was started and left.");
  return (
    <div className="relative isolate flex h-full flex-col overflow-y-auto" style={{ background: 'radial-gradient(ellipse at center, #2e1065 0%, #04030d 70%)' }}>
      <ModeBackdrop theme="hyperjump" />
      <ModeHeader title="Hyperjump" subtitle={entry === 'daily' ? <DailyChip date={today} /> : undefined} onExit={onExit} onReturnTo37={onReturnTo37} />
      <div data-testid="hj-launch-card" className="mx-auto mt-4 w-full max-w-sm space-y-3 px-5 text-center">
        {/* New players see the loop in motion; a saved run goes straight to RESUME. */}
        {saved && (entry !== 'daily' || savedDaily) ? <div className="text-6xl" aria-hidden="true">🌀</div> : <HyperjumpDemo paused={how} />}
        <p data-testid="hj-caption" className="text-lg font-black leading-snug text-white">{LAUNCH_CAPTION}</p>
        {entry === 'daily' ? (
          <DailyEntry today={today} saved={saved} savedDaily={savedDaily} dailyAttempt={dailyAttempt} usedText={usedText}
            onDaily={onDaily} onResume={onResume} onAbandonAsk={() => setAbandon(true)} onPractice={onPractice} />
        ) : saved ? (
          <>
            <PrimaryButton tone="cyan" testId="hj-resume" onClick={onResume}>
              RESUME · Jump {saved.jump} · {sectorFor(saved.jump).name}
            </PrimaryButton>
            {!savedDaily && isDailySeed(saved.seed) && (
              <div data-testid="hj-old-daily" className="text-xs text-slate-400">From an earlier day — it continues as a Free run.</div>
            )}
            {/* Its own line (sweep 2026-10-20): inline, it sat flush against "ⓘ How it works" with no gap. */}
            <button type="button" data-testid="hj-abandon" onClick={() => setAbandon(true)} className="mx-auto block min-h-[32px] text-xs text-slate-400 underline">
              Abandon &amp; start new
            </button>
          </>
        ) : (
          <>
            {usedText ? (
              <div data-testid="hj-daily-used" className="rounded-xl border border-violet-300/30 bg-violet-950/40 px-3 py-2 text-sm text-violet-100">
                {usedText} New Daily tomorrow.
              </div>
            ) : (
              <div>
                <PrimaryButton testId="hj-daily" onClick={onDaily}>DAILY RUN · {today.slice(5)}</PrimaryButton>
                <div className="mt-1 text-xs text-slate-300">One try today · after a short ad</div>
              </div>
            )}
            <div>
              <PrimaryButton tone="cyan" testId="hj-free" onClick={onFree}>FREE RUN</PrimaryButton>
              <div className="mt-1 text-xs text-slate-300">Practice anytime</div>
            </div>
          </>
        )}
        <button type="button" data-testid="hj-how" onClick={() => setHow(true)} className="rounded-full border border-sky-300/50 px-3 py-1.5 text-xs font-bold text-sky-100">ⓘ How it works</button>
      </div>
      {how && <HowItWorks title="Hyperjump" items={HOW_IT_WORKS} onClose={() => setHow(false)} testId="hj-how-sheet" />}
      {abandon && <ConfirmAbandon daily={savedDaily} onNo={() => setAbandon(false)} onYes={() => { setAbandon(false); onAbandon(); }} />}
    </div>
  );
}
