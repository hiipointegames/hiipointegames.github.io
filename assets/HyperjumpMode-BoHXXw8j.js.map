// Hyperjump — the roguelike run (David's picks: 5–10 minute runs; pick 1 of 3
// power-ups after EVERY jump; same builder, space skin). Simplified 2026-10-22.
//
// Jump n needs an equation equal to 37 × n using every die on the board.
// Oxygen is the clock AND your health: start 5:00, +37s per cleared jump, the
// run ends at zero. Fuel buys rerolls. Difficulty rises in bands because big
// targets alone are NOT hard (measured 2026-10-04: 7 dice reach 37…370 in 100%
// of rolls) — the rules get stricter instead:
//   jumps 1–5   Inner Orbit   seven white dice, free maths
//   jumps 6–10  Asteroid Belt 1 of 3 power dice used correctly (all 3 = Perfect)
//   jumps 11–15 Deep Space    2 of 3
//   jumps 16–20 The Core      PERFECT ONLY: all 3, every jump; clearing 20 WINS (./run.js)
// Eased by David 2026-10-10 ("too challenging… keep the final round perfect solve only
// for experts"); was 0 · 2 · 3 · 2 with cursed jumps eased to 2.
// Every 5th jump is a Black Hole with a hard curse; 4 other jumps per run get a mild one (curseFor).
//
// Everything random comes from a seed per (run, jump, reroll), so a Daily Run is
// identical for every player whatever order they do things in.

import { evaluateTokens, hits, powerDiceCorrect, DISPLAY, hasImplicitMultiply } from '../sectorMath';
import { makeRng, rollDie, shuffle } from '../rng';
import { sectorFor } from './run';
import { ARTIFACTS, artifactById, NOT_IN_CORE } from './artifacts';

export { ARTIFACTS, artifactById };

/**
 * The clock (David, 2026-10-22): 9:37 to start, and never above 9:37. With 5:00 "people are going to find it
 * damn near impossible to reach the core". What a cleared jump gives back follows how good it was
 * (./scoring.js timeReward: 30–70 s); the flat +37 s per jump is gone.
 */
export const START_OXYGEN = 577;

/**
 * Oxygen is capped (David, sweep 2026-10-05: banking minutes early made the late game tension-free); the
 * cap is the 9:37 start since 2026-10-22. What goes above it is simply not added.
 */
export const OXYGEN_CAP = 577;

/** @returns {{ oxygen: number, overflow: number }} */
export function addOxygen(oxygen, gain, cap = OXYGEN_CAP) {
  const total = oxygen + gain;
  return total > cap ? { oxygen: cap, overflow: Math.round(total - cap) } : { oxygen: total, overflow: 0 };
}

/**
 * Oxygen after `seconds` on the jump screen. Nothing drains while the app is in the
 * background (a call, an app switch) — found on the S21 2026-10-05, when a run lost three
 * minutes of oxygen sitting behind another app. (Solar Wind's 3× drain left with the curse.)
 */
export function drainOxygen(oxygen, seconds, { hidden = false } = {}) {
  if (hidden) return oxygen;
  return oxygen - seconds;
}
export const START_FUEL = 3;

/**
 * The fuel tank holds 6 (contrarian review 2026-10-14: a playtest reached the Core with 20 fuel,
 * so rerolls and Scans were free and fuel stopped being a choice). Twice the starting 3: enough
 * to save up for the Core, not enough to reroll every bad board. Gains above it are lost.
 */
export const FUEL_CAP = 6;

/**
 * Add fuel up to the cap. Fuel already above the cap (an older save) is kept, never cut.
 * @returns {{ fuel: number, gained: number, lost: number }}
 */
export function addFuel(fuel, gain, cap = FUEL_CAP) {
  const gained = Math.max(0, Math.min(gain, cap - fuel));
  return { fuel: fuel + gained, gained, lost: gain - gained };
}
export const BASE_SLOTS = 4;
export const MAX_SLOTS = 5;
export const POWER_COLORS = ['white', 'white', 'white', 'white', 'blue', 'red', 'green'];

export const targetFor = (jump) => 37 * jump;
export const isBossJump = (jump) => jump % 5 === 0;

/** The rules band for a jump = its sector (id, name, base power dice needed). */
export const bandFor = (jump) => sectorFor(jump);

/**
 * Power dice needed to clear a jump: the sector's rule. Curses no longer ease it — that
 * would quietly make the Core's Perfect-only rule 2 of 3 on its cursed jumps.
 * @param {number} jump
 * @param {string|null} [_curse] kept so callers need not change
 */
export function powerNeeded(jump, _curse = null) {
  return bandFor(jump).power;
}

/** Gravity Well (one die fewer) only before jump 9 — later it makes too many rolls unwinnable. */
export const GRAVITY_WELL_LAST_JUMP = 8;

/**
 * Event Horizon (no +) only up to jump 14: from 15 even 2 of 3 power dice measured just
 * 84–89% reachable (plans/slice-H1.md). David retired it there, 2026-10-05.
 */
export const EVENT_HORIZON_LAST_JUMP = 14;

/** Are there coloured power dice on this jump? Only once a power rule applies (jump 6+). */
export const hasPowerDice = (jump) => bandFor(jump).power > 0;

/**
 * The gold Tens Die (David, 2026-10-10): an 8th die showing 10, 20 … 60 joins once targets
 * pass 200 (jump 6, target 222). Measured: it makes 740 about as findable as 74 is with
 * seven dice (solution counts, scripts/s73-hyperjump-reach.mjs 'tens'). It must be used
 * like every other die, and it is not a power die.
 */
export const TENS_DIE_FROM = 6;

/** Gravity Assist: how far from the target a jump may land and still clear. */
export const GRAVITY_ASSIST_RANGE = 2;
export const hasTensDie = (jump) => jump >= TENS_DIE_FROM;
export const isTensDie = (color) => color === 'gold';

/** A fresh value for one die (Tractor Beam): the Tens Die stays a multiple of 10. */
export const rerollOneDie = (rng, color) => rollDie(rng) * (isTensDie(color) ? 10 : 1);

// ── Curses (David, 2026-10-22) ───────────────────────────────────────────────────────────────────
// Four, and every one is visible on the board: no hidden, moving or flipping rules (Dark Matter,
// Comet, Pulsar and Entropy retired). Every Black Hole has a HARD one; a few ordinary jumps — a
// different few every run — have a MILD one, so a Deflector is a real choice: spend it now, or keep
// it for the boss. A Deflector cancels any curse in full (the "weakened" versions are gone).

export const CURSES = [
  { id: 'eventHorizon', name: 'Event Horizon', desc: 'No + on this jump.' },
  { id: 'redGiant', name: 'Red Giant', desc: 'The red die must be an exponent: □ ^ red.' },
  { id: 'solarFlare', name: 'Solar Flare', desc: 'One key is burned out on this jump.' },
  { id: 'gravityWell', name: 'Gravity Well', desc: 'A white die was swallowed: one die fewer.' },
];
export const curseById = (id) => CURSES.find((c) => c.id === id) || null;

/** How many ordinary (non-boss) jumps carry a mild curse in one run. */
export const CURSED_PER_RUN = 4;

/** Mild on ordinary jumps, hard on Black Holes. */
export const curseTier = (jump) => (isBossJump(jump) ? 'hard' : 'mild');

/**
 * The curses that may land on a jump. Mild = Solar Flare burning − or ÷, or Gravity Well (to jump 8).
 * Hard (bosses) = any of the four within their jump limits, Solar Flare burning + or ×.
 */
export function cursePoolFor(jump, tier = curseTier(jump)) {
  const ok = (id) => !(
    (id === 'gravityWell' && jump > GRAVITY_WELL_LAST_JUMP)
    || (id === 'eventHorizon' && jump > EVENT_HORIZON_LAST_JUMP)
    || (id === 'redGiant' && !hasPowerDice(jump)) // no red die in Inner Orbit
  );
  const ids = tier === 'hard' ? CURSES.map((c) => c.id) : ['solarFlare', 'gravityWell'];
  return ids.filter(ok);
}

/**
 * The ordinary jumps that carry a mild curse this run: CURSED_PER_RUN of jumps 2–19 (never jump 1,
 * never a boss), picked by the seed, so every run (and every Daily player) gets its own spread.
 * @returns {number[]} ascending
 */
export function cursedJumps(seed) {
  const candidates = Array.from({ length: 18 }, (_, k) => k + 2).filter((j) => !isBossJump(j));
  return shuffle(makeRng(`${seed}-cursed-jumps`), candidates).slice(0, CURSED_PER_RUN).sort((a, b) => a - b);
}

/** The curse for a jump (or null): always one on a boss; on CURSED_PER_RUN ordinary jumps a mild one. */
export function curseFor(seed, jump) {
  if (!isBossJump(jump) && !cursedJumps(seed).includes(jump)) return null;
  const pool = cursePoolFor(jump);
  return pool[Math.floor(makeRng(`${seed}-curse-${jump}`)() * pool.length)];
}

/** Solar Flare's burned-out key, the same for every player: − or ÷ when mild, + or × on a Black Hole. */
export const FLARE_OPS = Object.freeze({ mild: Object.freeze(['-', '/']), hard: Object.freeze(['+', '*']) });
export const flareOpFor = (seed, jump) => {
  const ops = FLARE_OPS[curseTier(jump)];
  return ops[Math.floor(makeRng(`${seed}-flare-${jump}`)() * ops.length)];
};

/** A curse's description for this jump — Solar Flare names its key. */
export function curseDesc(id, { burnedOp = null } = {}) {
  if (id === 'solarFlare' && burnedOp) return `The ${DISPLAY[burnedOp]} key is burned out on this jump.`;
  return curseById(id)?.desc ?? '';
}

/**
 * A curse in a few words, for chips and the briefing (David, 2026-10-14: the screens were "way too
 * crowded"). The full sentence lives in the Rules sheet (./RulesSheet.jsx).
 */
const SHORT = Object.freeze({ eventHorizon: 'No +', redGiant: 'Red die = exponent', solarFlare: 'A key is burned', gravityWell: 'One die fewer' });
export function curseShort(id, { burnedOp = null } = {}) {
  if (!SHORT[id]) return '';
  return id === 'solarFlare' && burnedOp ? `${DISPLAY[burnedOp]} key burned` : SHORT[id];
}

const RARITY_WEIGHT = { common: 5, rare: 3, legendary: 1 };

/**
 * The dice for a jump's k-th roll (k = 0 first roll, 1 after one reroll…).
 * @returns {{ values: number[], colors: string[] }}
 */
export function rollFor(seed, jump, k, curse = null) {
  const rng = makeRng(`${seed}-jump-${jump}-roll-${k}`);
  let values = Array.from({ length: 7 }, () => rollDie(rng));
  // Inner Orbit (no power rule) plays like Easy: seven WHITE dice. The coloured power dice
  // arrive with the power rules from jump 6 (David, S21 2026-10-10).
  let colors = hasPowerDice(jump) ? [...POWER_COLORS] : Array(7).fill('white');
  if (hasTensDie(jump)) { values.push(10 * rollDie(rng)); colors.push('gold'); }
  if (curse === 'gravityWell') {
    // A WHITE die is swallowed, so all three power dice (and the Tens Die) survive.
    const gone = Math.floor(rng() * 4);
    values = values.filter((_, i) => i !== gone);
    colors = colors.filter((_, i) => i !== gone);
  }
  return { values, colors };
}

/**
 * Artifacts that help against each curse (2026-10-11: "a counter offered before it"). Never the
 * Deflector: it would delete the boss puzzle (contrarian review, 2026-10-11).
 */
export const COUNTERS = Object.freeze({
  eventHorizon: ['gravityAssist', 'supergiant', 'twinStar'],
  redGiant: ['thruster', 'tractorBeam', 'twinStar'],
  solarFlare: ['twinStar', 'gravityAssist', 'tractorBeam'],
  gravityWell: ['supergiant', 'twinStar', 'thruster'],
});

/**
 * The draft after clearing `jump`:
 * - after a boss, Black Hole LOOT — rare and legendary only (2026-10-11: "a bigger reward");
 * - before a boss, at least one COUNTER to its curse (never named — the boss is announced
 *   only on its own briefing).
 * A card you hold is never offered again (one copy each; upgrades were cut 2026-10-22).
 * @param {string} seed
 * @param {number} jump
 * @param {string[]} [owned]
 * @returns {{ ids: string[], counter: string|null, loot: boolean }}
 */
export function draftFor(seed, jump, owned = []) {
  const loot = isBossJump(jump);
  const next = jump + 1;
  // Gravity Assist cannot clear a Core jump, so it is not offered for one (it was a dead pick).
  const useful = (id) => !(NOT_IN_CORE.includes(id) && sectorFor(next).id === 'core');
  const allowed = (a) => !owned.includes(a.id) && (!loot || a.rarity !== 'common') && useful(a.id);
  const rng = makeRng(`${seed}-offer-${jump}`);
  const ids = weightedPicks(rng, ARTIFACTS.filter(allowed), 3);
  let counter = null;
  if (isBossJump(next)) {
    const options = (COUNTERS[curseFor(seed, next)] || []).filter((id) => !owned.includes(id) && useful(id));
    counter = ids.find((id) => options.includes(id)) ?? null;
    if (!counter && options.length) {
      counter = options[Math.floor(makeRng(`${seed}-counter-${jump}`)() * options.length)];
      ids[Math.max(0, ids.length - 1)] = counter;
    }
  }
  return { ids, counter, loot };
}

/** Three distinct artifacts not already owned, weighted by rarity. */
export const offerFor = (seed, jump, owned = []) => draftFor(seed, jump, owned).ids;

function weightedPicks(rng, pool, n = 3, weightOf = (a) => RARITY_WEIGHT[a.rarity]) {
  const picks = [];
  const bag = shuffle(rng, pool);
  while (picks.length < n && bag.length) {
    const total = bag.reduce((s, a) => s + weightOf(a), 0);
    let roll = rng() * total;
    const idx = bag.findIndex((a) => (roll -= weightOf(a)) <= 0);
    picks.push(bag.splice(idx === -1 ? 0 : idx, 1)[0]);
  }
  return picks.map((a) => a.id);
}

/**
 * Judge a jump.
 * @param {object} p
 * @param {Array} p.tokens
 * @param {number[]} p.values
 * @param {string[]} p.colors
 * @param {number} p.jump
 * @param {string[]} p.artifacts owned artifact ids
 * @param {string|null} p.curse
 * @param {string|null} [p.burnedOp] Solar Flare's burned-out key
 * @param {number|null} [p.target] the target; default 37 × jump
 * @returns {{ ok: boolean, reason?: string, value?: number, perfect?: boolean, correct?: number, assisted?: boolean }}
 */
export function judgeJump({ tokens, values, colors, jump, artifacts = [], curse = null, burnedOp = null, target: targetNow = null }) {
  const has = (id) => artifacts.includes(id);
  const r = evaluateTokens(tokens, values);
  const ops = tokens.filter((t) => t.t === 'op').map((t) => t.v);

  // Only + − × ÷ ^ ( ) have keys; anything else (√, x², !) is refused.
  if (ops.includes('√')) return { ok: false, reason: 'no-sqrt' };
  if (ops.includes('²')) return { ok: false, reason: 'no-square' };
  // Factorial is a die tool now (2026-10-12), so there is no ! key; a typed ! is refused.
  if (ops.includes('!')) return { ok: false, reason: 'no-factorial' };
  if (curse === 'eventHorizon' && ops.includes('+')) return { ok: false, reason: 'event-horizon' };
  if (burnedOp) {
    const uses = ops.filter((o) => o === burnedOp).length + (burnedOp === '*' && hasImplicitMultiply(tokens) ? 1 : 0);
    if (uses > 0) return { ok: false, reason: 'solar-flare' };
  }

  const counts = {};
  r.usedIndices.forEach((i) => { counts[i] = (counts[i] || 0) + 1; });
  const missing = values.some((_, i) => !counts[i]);
  if (missing) return { ok: false, reason: 'all-dice' };
  const extraUses = Object.values(counts).reduce((s, n) => s + n - 1, 0);
  if (extraUses > (has('twinStar') ? 1 : 0)) return { ok: false, reason: 'reuse' };

  if (!r.ok) return { ok: false, reason: 'invalid' };
  if (r.fusedPairs > 0) return { ok: false, reason: 'fused' };

  const target = targetNow ?? targetFor(jump);
  const onTarget = hits(r.value, target);
  // Gravity Assist (2026-10-11): within 2 still clears — but never as a Perfect.
  const assisted = !onTarget && has('gravityAssist') && Math.abs(r.value - target) <= GRAVITY_ASSIST_RANGE + 1e-9;
  if (!onTarget && !assisted) return { ok: false, reason: 'target', value: r.value };

  const correct = powerDiceCorrect(r.leaves, colors);
  if (correct < powerNeeded(jump, curse)) return { ok: false, reason: 'power', value: r.value, correct };
  // Perfect-only sectors need a true Perfect — an "assisted" landing is never one (bug 2026-10-11).
  if (powerNeeded(jump, curse) >= 3 && assisted) return { ok: false, reason: 'perfect-only', value: r.value, correct };
  if (curse === 'redGiant') {
    const redIdx = colors.indexOf('red');
    // The red die must BE the exponent (the right operand of ^), not the base.
    const redIsExponent = r.leaves.some((l) => l.op === '^' && l.right && l.dice.includes(redIdx));
    if (!redIsExponent) return { ok: false, reason: 'red-giant', value: r.value };
  }

  return { ok: true, value: r.value, perfect: correct >= 3 && !assisted, correct, assisted };
}

// Light-years for a cleared jump: ./scoring.js (jumpScore), since 2026-10-22.

// Refusal words live in ./coach.js (refusalLine) since 2026-10-22.


/** Run card share text. */
export function runCardText({ jump, lightYears, artifacts, daily, date, won = false, runLog = [], help = null }) {
  const icons = artifacts.map((id) => artifactById(id)?.icon).join('');
  const reached = won ? `☀️ Reached the Core (${jump} jumps)` : `Cleared ${jump} ${jump === 1 ? 'jump' : 'jumps'}`;
  const glyphs = runGlyphs(runLog);
  // The help a run used is on its card, so the Daily board stays fair (framework C1, 2026-10-22).
  return `🚀 Hyperjump${daily ? ` · Daily ${date}` : ''}\n${reached} · ${lightYears.toLocaleString()} light-years\n${glyphs ? `${glyphs}\n` : ''}${help ? `${helpText(help)}\n` : ''}${icons ? `Power-ups ${icons}\n` : ''}Sector 73 · https://37themathpuzzle.app`;
}

/** "📡 3 scans · 🔄 1 reroll" */
export const helpText = ({ scans = 0, rerolls = 0 }) => `📡 ${scans} ${scans === 1 ? 'scan' : 'scans'} · 🔄 ${rerolls} ${rerolls === 1 ? 'reroll' : 'rerolls'}`;

/**
 * The final screen's run summary (contrarian review 2026-10-14: the run just ended with a number).
 * Built from the run log, so a resumed run counts every jump it saved.
 * @param {Array<{ jump: number, perfect?: boolean, rerolled?: boolean }>} runLog
 * @returns {{ cleared: number, perfects: number, bosses: number, rerolled: number }}
 */
export function runSummary(runLog = []) {
  return {
    cleared: runLog.length,
    perfects: runLog.filter((c) => c.perfect).length,
    bosses: runLog.filter((c) => isBossJump(c.jump)).length,
    rerolled: runLog.filter((c) => c.rerolled).length,
  };
}

/**
 * The run's shape without spoilers (Wordle-style; David, sweep 2026-10-05): one glyph per
 * cleared jump, sectors separated. 🕳️ boss · ⭐ Perfect · ⛽ needed a reroll · 🟣 clean.
 * @param {Array<{ jump: number, perfect?: boolean, rerolled?: boolean }>} runLog
 */
export function runGlyphs(runLog) {
  const glyph = (c) => (isBossJump(c.jump) ? '🕳️' : c.perfect ? '⭐' : c.rerolled ? '⛽' : '🟣');
  /** @type {string[][]} */
  const sectors = [];
  for (const c of runLog) {
    const s = Math.ceil(c.jump / 5) - 1;
    (sectors[s] ||= []).push(glyph(c));
  }
  return sectors.filter(Boolean).map((g) => g.join('')).join(' │ ');
}
