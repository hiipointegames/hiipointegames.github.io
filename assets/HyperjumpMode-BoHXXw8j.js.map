import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { PrimaryButton, ClickShield } from '../ui';
import RulesSheet from './RulesSheet';

// The pre-jump briefing card (David, S21 2026-10-10): TARGET, what's different this jump, your
// artifacts, then LAUNCH. It covers the jump screen; the oxygen clock is paused while it is up.
// Content comes from ./briefing.js.
//
// SHORT ON PURPOSE (David, 2026-10-14: the pre-game screen was "way too crowded"): one line for
// the curse, rule CHIPS, artifact ICONS. Every full sentence is one tap away in the Rules sheet
// ("ⓘ Full rules", ./RulesSheet.jsx).
//
// `renderIcon` draws an artifact's icon — passed in so this file does not import
// HyperjumpMode (which imports this one).

const Chip = ({ children, className = '', testId = undefined }) => (
  <span data-testid={testId} className={`rounded-full border px-2.5 py-1 text-xs font-bold ${className}`}>{children}</span>
);

export default function JumpBriefing({ brief, onLaunch, onDeflect = undefined, onLeave = undefined, sectorNote = null, renderIcon = (/** @type {string} */ _id) => null }) {
  const [rules, setRules] = useState(false);
  const cursed = Boolean(brief.curse);
  const accent = brief.boss ? '#fbbf24' : cursed ? '#fb7185' : '#a78bfa';
  return (
    <div data-testid="hj-briefing" className="absolute inset-0 z-40 grid place-items-center overflow-y-auto bg-black/75 px-4 py-6">
      <ClickShield className="w-full max-w-sm">
        <motion.div
          initial={{ scale: 0.85, opacity: 0, y: 16 }}
          animate={{ scale: 1, opacity: 1, y: 0 }}
          transition={{ type: 'spring', stiffness: 320, damping: 24 }}
          className="rounded-3xl border-2 bg-[#0b0720]/95 p-4 text-center"
          style={{ borderColor: accent, boxShadow: `0 0 40px -10px ${accent}` }}
        >
          <div className="text-[11px] uppercase tracking-[0.35em] text-violet-300">
            Jump {brief.jump} · {brief.sector}
          </div>
          {/* Jump 1 opens the run: its sector's one-line news rides on this card (no extra screen). */}
          {sectorNote && <div data-testid="hj-brief-sector" className="mt-1 text-xs text-sky-200">{sectorNote}</div>}
          {brief.boss && (
            // The ONLY place the boss is announced (David, S21 2026-10-10): the card right before it.
            <div data-testid="hj-brief-boss" className="mt-2 whitespace-nowrap text-xl font-black tracking-[0.2em] text-amber-300" style={{ textShadow: '0 0 18px #f59e0b' }}>
              🕳️ BLACK HOLE BOSS
            </div>
          )}

          <div className="mt-2 text-[10px] uppercase tracking-[0.3em] text-slate-400">🎯 Target</div>
          <div data-testid="hj-brief-target" className="text-6xl font-black leading-none text-white" style={{ textShadow: `0 0 24px ${accent}` }}>
            {brief.target}
          </div>

          {/* What's different this jump: ONE line. */}
          <div data-testid="hj-brief-curse" className={`mt-3 text-base font-bold ${cursed ? 'text-rose-200' : brief.deflected ? 'text-cyan-100' : 'text-slate-300'}`}>
            {cursed ? <>🕳️ {brief.curse.name}: {brief.curse.short}</>
              : brief.deflected ? <>🛡️ {brief.deflected} deflected</> : <>☀️ Clear skies</>}
          </div>
          {brief.canDeflect && onDeflect && (
            <button type="button" data-testid="hj-deflect" onClick={onDeflect}
              className="mt-1.5 w-full rounded-lg border border-cyan-300/70 bg-cyan-500/15 py-1.5 text-sm font-black text-cyan-50 active:scale-95">
              🛡️ Use Deflector: cancel {brief.curse.name}
            </button>
          )}

          <div className="mt-2 flex flex-wrap justify-center gap-1.5">
            <Chip testId="hj-brief-dice" className="border-white/20 text-slate-100">{brief.dice.chip}</Chip>
            {brief.tensDie && <Chip testId="hj-brief-tens" className="border-yellow-300/60 text-yellow-100">🟡 Tens Die</Chip>}
            {brief.bounty && <Chip testId="hj-brief-bounty" className="border-amber-300/70 bg-amber-500/10 text-amber-100">Bonus (optional) · {brief.bounty.icon} {brief.bounty.text}</Chip>}
            <Chip testId="hj-brief-fuel" className="border-amber-300/50 text-amber-100">⛽ {brief.fuel}</Chip>
          </div>

          {brief.loadout.length > 0 && (
            <div data-testid="hj-brief-artifacts" className="mt-3 flex flex-wrap items-center justify-center gap-1.5">
              {brief.loadout.map((p) => (
                <span key={p.id} title={p.name} aria-label={p.name} className="grid h-9 w-9 place-items-center rounded-lg border border-white/15 bg-black/30 text-lg">{renderIcon(p.id)}</span>
              ))}
            </div>
          )}

          <div className="mt-4">
            <PrimaryButton testId="hj-launch" tone={brief.boss ? 'rose' : 'violet'} onClick={onLaunch}>LAUNCH ▶</PrimaryButton>
            <div className="mt-2 flex justify-center gap-4 text-xs">
              <button type="button" data-testid="hj-brief-rules" onClick={() => setRules(true)} className="text-violet-200 underline">ⓘ Full rules</button>
              {onLeave && (
                <button type="button" data-testid="hj-brief-leave" onClick={onLeave} className="text-slate-400 underline">
                  Not now — run saved
                </button>
              )}
            </div>
          </div>
        </motion.div>
      </ClickShield>
      {rules && <RulesSheet brief={brief} renderIcon={renderIcon} onClose={() => setRules(false)} />}
    </div>
  );
}
