// Hyperjump's words while you play (framework §B, 2026-10-22): the coach line (what you have now and
// what's left), the refusal (why JUMP said no) and the ONE stuck tip. Pure, so every string is
// tested against the wording rules (≤ 12 words, keypad symbols) and against the board.
//
// The stuck tip never gives away a route step (David, 2026-10-22: the Scan shows a blanked shape, so a
// free tip must not show more). It is either about YOUR equation (a power die not counting yet) or
// about the direction the simplest route takes from the target (aim over and subtract, aim under
// and add, or multiply two numbers), which is true because it comes from a route the judge accepts.

/** What a power die must do to count (sectorMath powerDiceCorrect), as the stuck tip says it. */
const DOES = Object.freeze({
  green: (d) => `Add or take away ${d} so it counts.`,
  blue: (d) => `Multiply or divide by ${d} so it counts.`,
  red: (d) => `Use ${d} in a power (^) so it counts.`,
});
/** The tag under each power die: the keys it counts with. */
export const DIE_TAG = Object.freeze({ blue: '×÷', green: '+−', red: '^' });
const SHOW = { '+': '+', '-': '−', '*': '×', '/': '÷', '^': '^' };

const fmt = (v) => (Number.isInteger(v) ? String(v) : v.toFixed(2));
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

/**
 * The coach line: neutral, about the equation on screen.
 * @param {{ target: number, diceLeft: number, value: number|null, need?: number, power?: number }} p
 *   value = the equation's value when it computes (null while it doesn't)
 * @returns {string}
 */
export function coachLine({ target, diceLeft, value, need = 0, power = 0 }) {
  const pw = need > 0 ? ` · power ${power} of ${need >= 3 ? 3 : need}` : '';
  if (value == null) return diceLeft > 0 ? `Make ${target} · ${plural(diceLeft, 'die', 'dice')} left${pw}` : `Finish the equation${pw}`;
  if (diceLeft > 0) return `${fmt(value)} so far · ${plural(diceLeft, 'die', 'dice')} left${pw}`;
  const gap = value - target;
  if (Math.abs(gap) < 1e-9) return `${target} · all dice in${pw}`;
  return `${fmt(value)}: ${fmt(Math.abs(gap))} ${gap > 0 ? 'over' : 'short'}${pw}`;
}

/** The green line when JUMP will pass. */
export const goodLine = ({ target, perfect = false }) => `${target}${perfect ? ' · Perfect' : ''} · press JUMP`;

/**
 * Why JUMP was refused, in plain words (≤ 12). Replaces REASON_TEXT on the jump screen.
 * @param {{ reason?: string, value?: number, correct?: number }} verdict
 * @param {{ target: number, need: number, burnedOp?: string|null }} ctx
 */
export function refusalLine(verdict, { target, need, burnedOp = null }) {
  switch (verdict.reason) {
    case 'target': {
      const gap = verdict.value - target;
      return `${fmt(verdict.value)} is ${fmt(Math.abs(gap))} ${gap > 0 ? 'over' : 'short of'} ${target}.`;
    }
    case 'power': return `Power ${verdict.correct} of ${need}: a coloured die needs its key.`;
    case 'perfect-only': return 'The Core needs exactly the target and all 3 power dice.';
    case 'all-dice': return 'Use every die on the board.';
    case 'reuse': return 'Each die once (Twin Star lets one repeat).';
    case 'invalid': return 'That equation does not compute yet.';
    case 'fused': return 'Dice cannot touch: put a key between them.';
    case 'event-horizon': return 'No + on this jump.';
    case 'solar-flare': return `The ${SHOW[burnedOp] ?? ''} key is burned on this jump.`.replace('  ', ' ');
    case 'red-giant': return 'The red die must be the power: □ ^ red.';
    default: return 'Jump refused.';
  }
}

/**
 * The stuck tip, or null when there is nothing true and useful to say.
 * @param {{ values: number[], colors: string[], need: number, countedDice: Set<number>|number[],
 *   placed?: Set<number>|number[], target: number, route?: { tree: any } | null }} p
 *   countedDice = power dice counted so far; route = the Scan's route (placed: kept for callers, unused)
 */
export function stuckTip({ values, colors, need, countedDice, target, route = null }) {
  const counted = new Set(countedDice);
  // 1. Short on power: name a power die that doesn't count yet and its keys.
  if (need > counted.size) {
    const i = colors.findIndex((c, k) => DOES[c] && !counted.has(k));
    if (i >= 0) {
      return DOES[colors[i]](`the ${colors[i]} ${values[i]}`);
    }
  }
  // 2. Which way the simplest route goes from the target (from the route's last step).
  const root = route?.tree;
  if (root && root.die == null) {
    const near = (n) => Math.abs(n.v - target) <= Math.max(10, target * 0.15);
    if (root.op === '-' && near(root.l)) return `Aim a little over ${target}, then subtract a small part.`;
    if (root.op === '+' && (near(root.l) || near(root.r))) return `Aim a little under ${target}, then add a small part.`;
    if (root.op === '*') return `Try ${target} as two numbers multiplied together.`;
    if (root.op === '/') return `Try making a number bigger than ${target}, then divide.`;
    if (root.op === '+' || root.op === '-') return `Build two big parts, then ${root.op === '+' ? 'add' : 'subtract'} them.`;
    if (root.op === '^') return 'Try a power (^) as the last step.';
  }
  return null;
}
