// Hyperjump's jump Bonus (David, 2026-10-11 round 2 — "lots of rewards", for clever play rather
// than grind; called a "Bonus" on screen, the shared Sector 73 word). Every jump from 2 posts one
// seeded side goal on its briefing; meet it when you clear the jump and it pays +1 fuel (David,
// 2026-10-22: salvage was cut, and fuel buys Rerolls and Scans). Only offered when the board allows it.
// Pure.

import { evaluateTokens, hasImplicitMultiply } from '../sectorMath';
import { makeRng } from '../rng';
import { sectorFor } from './run';

/** What a met Bonus pays: fuel (up to the tank's cap). */
export const BONUS_FUEL = 1;
export const FAST_SECONDS = 45;

const leavesOf = (tokens, values) => {
  const r = evaluateTokens(tokens, values);
  return r.ok ? r.leaves : [];
};
const opsOf = (tokens) => tokens.filter((t) => t.t === 'op').map((t) => t.v);

/**
 * id, text, when it can be offered, and the check on a CLEARED jump.
 * ctx: { tokens, values, colors, jump, curse, burnedOp, seconds, correct }
 */
export const BOUNTIES = Object.freeze([
  {
    id: 'sixExponent', icon: '⁶', text: 'Use a 6 as an exponent',
    offer: ({ values }) => values.includes(6),
    met: ({ tokens, values }) => leavesOf(tokens, values)
      .some((l) => l.op === '^' && l.right && l.dice.length === 1 && values[l.dice[0]] === 6),
  },
  {
    id: 'noTimes', icon: '🚫', text: 'No × at all',
    offer: ({ burnedOp }) => burnedOp !== '*', // Solar Flare on × would make it free
    met: ({ tokens }) => !opsOf(tokens).includes('*') && !hasImplicitMultiply(tokens),
  },
  {
    id: 'useDivide', icon: '÷', text: 'Use ÷ at least once',
    offer: ({ burnedOp }) => burnedOp !== '/',
    met: ({ tokens }) => opsOf(tokens).includes('/'),
  },
  {
    id: 'allPower', icon: '⚡', text: 'All 3 power dice used correctly',
    offer: ({ jump }) => jump >= 6 && jump <= 15, // the Core needs all 3 anyway
    met: ({ correct }) => correct >= 3,
  },
  {
    id: 'fast', icon: '⏱️', text: `Clear it in ${FAST_SECONDS} s`,
    offer: (_ctx) => true,
    met: ({ seconds }) => seconds <= FAST_SECONDS,
  },
]);
export const bountyById = (id) => BOUNTIES.find((b) => b.id === id) || null;

/**
 * This jump's bounty (or null on jump 1), the same for every player on a seed and roll.
 * @param {string} seed
 * @param {number} jump
 * @param {{ values: number[], colors: string[] }} board
 * @param {{ burnedOp?: string|null }} [ctx]
 */
export function bountyFor(seed, jump, board, { burnedOp = null } = {}) {
  if (jump < 2 || !board) return null;
  const pool = BOUNTIES.filter((b) => b.offer({ ...board, jump, burnedOp }));
  if (!pool.length) return null;
  return pool[Math.floor(makeRng(`${seed}-bounty-${jump}`)() * pool.length)].id;
}

/**
 * The bounty for the roll on screen. It is posted from the jump's FIRST roll (so the briefing can
 * show it) and kept through rerolls while the new dice still allow it — but a reroll that takes
 * away what it needs (the only 6, say) re-picks from the new dice, so it is never impossible
 * (contrarian review 2026-10-14). Same seed + rolls = same bounty for every player.
 * @param {{ values: number[], colors: string[] }} first the jump's first roll
 * @param {{ values: number[], colors: string[] }} current the roll on screen
 */
export function bountyForRoll(seed, jump, first, current, { burnedOp = null } = {}) {
  const posted = bountyFor(seed, jump, first, { burnedOp });
  if (!posted || !current || current === first) return posted;
  return bountyById(posted).offer({ ...current, jump, burnedOp }) ? posted : bountyFor(seed, jump, current, { burnedOp });
}

/** Was it met? (Call only for a cleared jump.) */
export const bountyMet = (id, ctx) => Boolean(bountyById(id)?.met(ctx));
