import React from 'react';
import { ArtifactIcon } from './ArtifactIcon';
import { artifactById } from './artifacts';

/**
 * One artifact on the draft screen: icon, name and what it does. (Rarity, family and set lines were
 * cut 2026-10-22: David's "simpler" brief. Rarity still weights the offer, it just isn't shown.)
 */
export default function ArtifactCard({ id, onPick, counter = false, compact = false, highlight = false }) {
  const a = artifactById(id);
  if (!a) return null;
  return (
    <button
      type="button"
      data-testid={`hj-card-${id}`}
      onClick={onPick}
      className={`rounded-2xl border border-violet-400/60 text-left active:scale-95 transition-transform ${compact ? 'p-1.5' : 'p-3'} ${highlight ? 'ring-2 ring-rose-400' : ''}`}
      style={{ background: 'rgba(15,10,35,0.85)', boxShadow: '0 0 18px -8px #a78bfa' }}
    >
      <div className={compact ? 'text-xl text-center' : 'text-3xl'}><ArtifactIcon id={id} /></div>
      {!compact && (
        <>
          <div className="mt-1 font-black text-white">{a.name}</div>
          <div className="mt-1 text-sm text-slate-100">{a.what}</div>
          <div data-testid={`hj-card-when-${id}`} className="mt-0.5 text-xs text-violet-200">Best when: {a.when}</div>
          {counter && (
            <div data-testid={`hj-card-counter-${id}`} className="mt-1.5 rounded-lg bg-fuchsia-500/15 px-2 py-1 text-[11px] font-bold text-fuchsia-100">
              🔮 Helps against the next Black Hole
            </div>
          )}
        </>
      )}
    </button>
  );
}
