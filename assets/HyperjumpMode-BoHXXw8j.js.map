import React, { useEffect, useRef } from 'react';
import { motion } from 'framer-motion';
import { usePrefersReducedMotion } from '../../fx';

// The 1-second jump flash (audit 2026-10-18, D6). An ordinary jump — no curse, no boss, nothing new —
// no longer opens a briefing card (that was 20 cards a run). It flashes its number and target instead.
// It counts as a pause (the dice are hidden and the clock waits), and it blocks taps while it shows.

export const FLASH_MS = 1000;

/** @param {{ jump: number, target: number, onDone: () => void }} props */
export default function JumpFlash({ jump, target, onDone }) {
  const reduced = usePrefersReducedMotion();
  // The parent passes a fresh onDone on every render (the page above re-renders when pilots come and
  // go): keep the latest in a ref so a re-render never restarts the 1-s timer.
  const done = useRef(onDone);
  done.current = onDone;
  useEffect(() => {
    const id = setTimeout(() => done.current(), FLASH_MS);
    return () => clearTimeout(id);
  }, []);
  return (
    <div data-testid="hj-flash" className="absolute inset-0 z-40 grid place-items-center bg-black/85" role="alert" aria-label={`Jump ${jump}, target ${target}`}>
      <motion.div initial={reduced ? false : { scale: 0.7, opacity: 0 }} animate={{ scale: 1, opacity: 1 }}
        transition={reduced ? { duration: 0 } : { type: 'spring', stiffness: 360, damping: 22 }} className="text-center">
        <div className="text-sm font-black uppercase tracking-[0.4em] text-violet-300">Jump {jump}</div>
        <div className="text-7xl font-black leading-none text-white" style={{ textShadow: '0 0 28px #a78bfa' }}>{target}</div>
      </motion.div>
    </div>
  );
}
