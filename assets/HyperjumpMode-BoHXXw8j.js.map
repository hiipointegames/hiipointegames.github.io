import React from 'react';
import { ModeHeader, PrimaryButton } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { PracticeChip } from '../coach';
import { readBestValue } from '../bests';
import { practiceStarts, sectorFor } from './run';

// Hyperjump practice (the world's Practice object, entry 'practice'; David, 2026-10-22): straight here,
// never the Daily, never an ad or a server claim. New dice every run, and you can start at the first
// jump of any sector you have reached, so the hard sectors can be practised without replaying the easy
// ones. A later start brings 2 power-ups and pays no Core ★ (only a run from jump 1 does).

/**
 * @param {{ saved: any, onResume: () => void, onStart: (jump: number) => void, onExit: () => void, onReturnTo37: () => void }} props
 *   saved = a saved PRACTICE run (never the Daily's), or null
 */
export default function PracticeStart({ saved, onResume, onStart, onExit, onReturnTo37 }) {
  const starts = practiceStarts(readBestValue('hyperjump') ?? 0);
  return (
    <div className="relative isolate flex h-full flex-col overflow-y-auto" style={{ background: 'radial-gradient(ellipse at center, #1e293b 0%, #04030d 70%)' }}>
      <ModeBackdrop theme="hyperjump" />
      <ModeHeader title="Hyperjump" subtitle={<PracticeChip />} onExit={onExit} onReturnTo37={onReturnTo37} />
      <div data-testid="hj-practice" className="mx-auto mt-4 w-full max-w-sm space-y-3 px-5 text-center">
        <div className="text-lg font-black text-white">Practice</div>
        <p className="text-sm text-slate-300">New dice every time. No ad. Your Daily is untouched.</p>
        {saved && (
          <PrimaryButton tone="cyan" testId="hj-resume" onClick={onResume}>
            RESUME · Jump {saved.jump} · {sectorFor(saved.jump).name}
          </PrimaryButton>
        )}
        <div className="pt-1 text-[11px] uppercase tracking-[0.3em] text-violet-300">{saved ? 'Or start a new run at' : 'Start at'}</div>
        <div className="grid grid-cols-2 gap-2">
          {starts.map((s) => (
            <button key={s.id} type="button" data-testid={`hj-start-${s.number}`} disabled={!s.open} onClick={() => onStart(s.jump)}
              className="rounded-xl border border-violet-400/40 bg-black/40 px-2 py-2.5 text-left text-white active:scale-95 disabled:opacity-35">
              <b className="block text-sm">{s.number} · {s.name}</b>
              <span className="text-xs text-slate-300">{s.open ? `Jump ${s.jump} · ${s.power ? `${s.power === 3 ? 'all 3' : s.power} power ${s.power === 1 ? 'die' : 'dice'}` : 'white dice'}` : '🔒 Reach it once'}</span>
            </button>
          ))}
        </div>
        <p className="text-xs text-slate-400">
          {saved ? 'A new run ends the saved one. ' : ''}Starting later gives you 2 power-ups. Only a run from jump 1 pays the Core ★.
        </p>
      </div>
    </div>
  );
}
