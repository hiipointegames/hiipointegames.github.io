import React, { useEffect } from 'react';
import { tokensToString } from '../sectorMath';
import { useScanRoute } from './useScanRoute';

// After the run (David, 2026-10-22, Daily and Practice): one route for the jump that ended it, so the
// miss teaches something. Shown only once the run is over, and never on the share card.

/**
 * @param {{ board: { values: number[], colors: string[], jump: number, curse: string|null, burnedOp: string|null, target: number } }} props
 */
export default function EndRoute({ board }) {
  const route = useScanRoute(board);
  useEffect(() => { route.request(); }, [route.request]); // eslint-disable-line react-hooks/exhaustive-deps -- once per board
  const r = route.result;
  return (
    <div data-testid="hj-end-route" className="rounded-xl border border-cyan-300/30 bg-black/30 px-3 py-2 text-sm text-cyan-100">
      <div className="text-[10px] uppercase tracking-[0.25em] text-cyan-300">One way through jump {board.jump}</div>
      <div data-testid="hj-end-route-text" className="mt-0.5 font-bold">
        {!r ? 'Searching…' : r.status === 'found' ? `${tokensToString(r.tokens, board.values)} = ${board.target}` : r.status === 'none' ? 'The Scanner finds no route on those dice.' : 'The Scanner ran out of time on those dice.'}
      </div>
    </div>
  );
}
