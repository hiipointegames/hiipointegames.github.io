// Hyperjump's pre-jump briefing (David, S21 2026-10-10): before every jump a card tells the
// player the TARGET, the ARTIFACTS they carry, and the CHALLENGE against them that jump.
// Pure: everything here is derived from the run state, so it is unit-tested without a screen.

import { bountyById, BONUS_FUEL } from './bounties';
import { targetFor, bandFor, powerNeeded, hasPowerDice, hasTensDie, isBossJump, curseById, curseDesc, curseShort, artifactById } from './logic';

/**
 * What the briefing says for a jump.
 * @param {{ jump: number, curse?: string | null, artifacts?: string[], active?: string[], fuel?: number, deflected?: string | null, burnedOp?: string | null, bounty?: string | null }} state
 */
export function briefingFor({ jump, curse = null, artifacts = [], active = [], fuel = 0, deflected = null, burnedOp = null, bounty = null }) {
  const band = bandFor(jump);
  const target = targetFor(jump);
  const c = curse ? curseById(curse) : null;
  const need = powerNeeded(jump, curse);
  const power = hasPowerDice(jump);
  return {
    jump,
    sector: band.name,
    target,
    boss: isBossJump(jump),
    curse: c ? { id: c.id, name: c.name, desc: curseDesc(c.id, { burnedOp }), short: curseShort(c.id, { burnedOp }) } : null,
    // Deflector: cancels any curse, a Black Hole's too (David, 2026-10-22).
    canDeflect: Boolean(c) && artifacts.includes('deflector'),
    deflected: deflected ? curseById(deflected)?.name ?? null : null,
    dice: power
      ? { power: true, need, chip: need >= 3 ? '⚡ Perfect only' : `⚡ ${need} of 3 power dice`, text: need >= 3 ? 'Perfect only: use all 3 power dice correctly.' : `Use ${need} of the 3 power dice correctly — all 3 is a Perfect.` }
      : { power: false, need: 0, chip: '🎲 White dice · any maths', text: 'White dice: any maths.' }, // not "Seven": Gravity Well leaves six
    tensDie: hasTensDie(jump),
    loadout: artifacts.map(artifactById).filter(Boolean).map((a) => ({ id: a.id, name: a.name, what: a.what, when: a.when })),
    fuel,
    bounty: bounty && bountyById(bounty) ? { icon: bountyById(bounty).icon, text: bountyById(bounty).text, fuel: BONUS_FUEL } : null,
  };
}
