import React from 'react';
import { artifactById } from './artifacts';

/**
 * An artifact's icon. Most are emoji (they carry their own colour), but some are plain
 * glyphs like "x²" that inherit the text colour — on a dark card that made Square Root
 * invisible (S21, 2026-10-05). Always draw icons in bright neon with a soft glow.
 */
export function ArtifactIcon({ id, className = '' }) {
  const a = artifactById(id);
  if (!a) return null;
  return (
    <span data-testid={`artifact-icon-${id}`} title={a.name} className={`font-black text-cyan-50 ${className}`} style={{ textShadow: '0 0 8px #67e8f9' }}>
      {a.icon}
    </span>
  );
}
