import React from 'react';
import { bountyById, BONUS_FUEL } from './bounties';

// The jump screen's heads-up display (moved out of HyperjumpMode, audit 2026-10-18, D2 + D4).
// ONE LABEL PER NUMBER: Target · Oxygen · Fuel · Score each get their own tile (fuel and the score
// used to share "FUEL · LY"). ⚡ means power dice and nothing else. A Bounty is OPTIONAL, so it
// sits on its own gold row as a "Bonus" — never among the rule chips (both simulated first-time
// players read "Use ÷ at least once" as a rule).

const fmtTime = (s) => `${Math.floor(Math.max(0, s) / 60)}:${String(Math.floor(Math.max(0, s) % 60)).padStart(2, '0')}`;

function Tile({ label, color, children }) {
  return (
    <div className={`min-w-0 rounded-xl border bg-black/40 p-1.5 ${color.border}`}>
      <div className={`text-[9px] uppercase tracking-widest ${color.text}`}>{label}</div>
      {children}
    </div>
  );
}

/**
 * @param {object} p
 * @param {number} p.target
 * @param {number} p.jump  @param {number} p.oxygen  @param {number} p.fuel  @param {number} p.lightYears
 * @param {{ name: string } | null} p.curseInfo
 * @param {boolean} p.powerDice  @param {number} p.livePower  @param {number} p.need
 * @param {string|null} p.bounty  @param {boolean} p.bountyMet
 * @param {() => void} p.onRules
 */
export default function JumpHud(p) {
  const enough = p.livePower >= Math.max(p.need, 1);
  return (
    <>
      <div className="mt-2 grid grid-cols-4 gap-1.5 px-3 text-center">
        <Tile label="Target" color={{ border: 'border-violet-400/30', text: 'text-violet-300' }}>
          <div data-testid="hj-target" className="text-2xl font-black text-white">{p.target}</div>
        </Tile>
        <Tile label="Oxygen" color={{ border: 'border-cyan-400/30', text: 'text-cyan-300' }}>
          <div data-testid="hj-oxygen" className={`text-2xl font-black tabular-nums ${p.oxygen < 30 ? 'text-rose-300 animate-pulse' : 'text-white'}`}>{fmtTime(p.oxygen)}</div>
        </Tile>
        <Tile label="Fuel" color={{ border: 'border-amber-400/30', text: 'text-amber-300' }}>
          <div data-testid="hj-fuel" className="text-2xl font-black text-white">⛽{p.fuel}</div>
        </Tile>
        <Tile label="Score" color={{ border: 'border-fuchsia-400/30', text: 'text-fuchsia-300' }}>
          <div data-testid="hj-score" className="truncate pt-1 text-base font-black leading-6 text-white tabular-nums">{p.lightYears.toLocaleString()}</div>
          <div className="text-[9px] text-fuchsia-200/80">light-years</div>
        </Tile>
      </div>

      {/* Rule chips: the curse, the dice rule, Rules. */}
      <div data-testid="hj-chips" className="mt-2 flex flex-wrap items-center justify-center gap-1.5 px-3 text-xs font-bold">
        {p.curseInfo && (
          <button type="button" data-testid="hj-curse-chip" onClick={p.onRules}
            className="rounded-full border border-rose-400/70 bg-rose-950/60 px-2.5 py-1 text-rose-100">
            🕳️ {p.curseInfo.name}
          </button>
        )}
        {p.powerDice ? (
          <span data-testid="hj-power" data-enough={enough || undefined} className={`rounded-full border px-2.5 py-1 ${enough ? 'border-emerald-300/70 text-emerald-200' : 'border-white/20 text-slate-200'}`}>
            ⚡ Power {p.livePower}/3 {enough ? '✓' : `· need ${p.need >= 3 ? 'all 3' : p.need}`}
          </span>
        ) : (
          <span data-testid="hj-white-dice" className="rounded-full border border-white/20 px-2.5 py-1 text-slate-300">🎲 any maths</span>
        )}
        <button type="button" data-testid="hj-rules-open" onClick={p.onRules}
          className="rounded-full border border-violet-300/60 px-2.5 py-1 text-violet-100">ⓘ Rules</button>
      </div>

      {/* The Bonus: optional, so it looks like a reward, on its own row. */}
      {p.bounty && (
        <div className="mt-1.5 flex justify-center px-3">
          <span data-testid="hj-bounty" className={`rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${p.bountyMet ? 'border-emerald-300/70 text-emerald-100' : 'border-amber-300/70 bg-amber-500/10 text-amber-100'}`}>
            <b>Bonus +{BONUS_FUEL}⛽</b> · {bountyById(p.bounty).text.includes(bountyById(p.bounty).icon) ? '' : `${bountyById(p.bounty).icon} `}{bountyById(p.bounty).text}
            {p.bountyMet && <span data-testid="hj-bounty-met" className="ml-1 font-black text-emerald-300">✓</span>}
          </span>
        </div>
      )}
    </>
  );
}
