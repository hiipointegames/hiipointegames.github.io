import { useCallback, useEffect, useRef, useState } from 'react';
import { findRoute } from './scanner';

// The route behind the Scan, for the board on screen (David, 2026-10-22).
//
// Where Web Workers exist (phones, browsers) the search starts in ./scanWorker.js the moment the
// board changes, so the answer is usually ready before the player asks. Without a worker (tests,
// a very old WebView) nothing runs until `request()`; then it runs on the page after one frame, as
// the old Scanner did, so "Scanning…" paints first.

/** @type {Worker | null | undefined} undefined = not tried yet, null = unavailable */
let worker;
let nextId = 0;
const waiting = new Map();

const defaultFactory = () => (typeof Worker !== 'undefined' && import.meta.env?.MODE !== 'test'
  ? new Worker(new URL('./scanWorker.js', import.meta.url), { type: 'module' }) : null);
let makeWorker = defaultFactory;

function getWorker() {
  if (worker !== undefined) return worker;
  worker = null;
  try {
    const w = makeWorker();
    if (w) {
      w.onmessage = (e) => { const done = waiting.get(e.data?.id); waiting.delete(e.data?.id); done?.(e.data.result); };
      w.onerror = () => { // a worker that cannot run: answer every caller with "unknown", fall back from now on
        waiting.forEach((done) => done({ status: 'unknown' })); waiting.clear(); w.terminate(); worker = null;
      };
      worker = w;
    }
  } catch {
    worker = null;
  }
  return worker;
}

/** Test hook: use `factory` to make the worker (null = the real one) and forget the current one. */
export function setScanWorkerFactory(factory) { makeWorker = factory ?? defaultFactory; worker = undefined; waiting.clear(); }

/**
 * @param {object | null} params findRoute's input for the board on screen (null = no board)
 * @returns {{ result: null | { status: 'found', tokens: Array, tree: object } | { status: 'none' } | { status: 'unknown' }, request: () => void }}
 *   result null = not known yet (searching, or not asked for).
 */
export function useScanRoute(params) {
  const key = params ? JSON.stringify(params) : null;
  const [state, setState] = useState(/** @type {{ key: string|null, result: any }} */ ({ key: null, result: null }));
  const asked = useRef(/** @type {string|null} */ (null));
  const live = useRef(key);
  live.current = key;

  // With a worker: search every new board straight away.
  useEffect(() => {
    if (!key) return undefined;
    const w = getWorker();
    if (!w) return undefined;
    const id = ++nextId;
    waiting.set(id, (result) => { if (live.current === key) setState({ key, result }); });
    w.postMessage({ id, params: JSON.parse(key) });
    return () => { waiting.delete(id); };
  }, [key]);

  // Without one: search only when asked, one frame later.
  const request = useCallback(() => {
    if (!key || getWorker() || asked.current === key) return;
    asked.current = key;
    setTimeout(() => {
      if (live.current !== key) return;
      let result;
      try { result = findRoute(JSON.parse(key)); } catch { result = { status: 'unknown' }; }
      setState({ key, result });
    }, 40);
  }, [key]);

  return { result: state.key === key ? state.result : null, request };
}
