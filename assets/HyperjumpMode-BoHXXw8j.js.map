// Hyperjump's power-ups (called "artifacts" in the code): the roster and the one-use deck.
//
// THE DECK (David, 2026-10-11): every power-up is a one-use card. Tap it in the tray, then USE: it is
// ON for the rest of this jump (a failed try or a reroll does not waste it). When the jump clears,
// every card used leaves the deck; the draft (1 of 3 each round) refills the gaps. Nothing works
// unless the player chose it.
//
// THE ROSTER (David, 2026-10-22: "power-ups should be good, worth using, clearly explained"): eight,
// each with a one-line `what` (≤ 10 words, the tray card) and a `when` (when it is worth it, the draft
// card). Retired: Wild Moon (merged into Thruster), Factorial, Square, Mirror Shard, Fusion Core (rules
// that needed a paragraph each, and the Scan could not use them), Fuel Cell, Overclock, Gravity Lens
// (bookkeeping; the Fuel Can replaces them). Families, sets and charges were cut the same day.
//
// Pure: no React, no imports from ./logic (logic re-exports from here).

/**
 * kind — what USE does:
 * 'tool'    arms it; the next die tapped receives it (Thruster, Tractor Beam, Supergiant)
 * 'rule'    switches a rule on for this jump (Twin Star, Gravity Assist, Deflector)
 * 'instant' pays out at once (Oxygen Tank, Fuel Can)
 * short = the name under its tray button (≤ 10 letters).
 */
export const ARTIFACTS = [
  { id: 'thruster', name: 'Thruster', short: 'Thruster', icon: '🚀', rarity: 'common', kind: 'tool',
    what: 'Move one die 1 or 2 up or down.', when: 'You are a die away from a nice number: 5 → 6.' },
  { id: 'tractorBeam', name: 'Tractor Beam', short: 'Tractor', icon: '🧲', rarity: 'common', kind: 'tool',
    what: 'Reroll one die.', when: 'One die spoils a board you like.' },
  { id: 'twinStar', name: 'Twin Star', short: 'Twin Star', icon: '🌟', rarity: 'rare', kind: 'rule',
    what: 'Use one die twice.', when: 'You need one more 6, or one more power die.' },
  { id: 'supergiant', name: 'Supergiant', short: 'Supergiant', icon: '🔆', rarity: 'rare', kind: 'tool',
    what: 'Turn a white die into ×10 (4 → 40).', when: 'The target is far above what your dice reach.' },
  { id: 'gravityAssist', name: 'Gravity Assist', short: 'Assist', icon: '🌀', rarity: 'rare', kind: 'rule',
    what: 'Within 2 of the target counts. Not in the Core.', when: 'You keep landing 1 or 2 away.' },
  { id: 'deflector', name: 'Deflector', short: 'Deflector', icon: '🛡️', rarity: 'rare', kind: 'rule',
    what: 'Cancel this jump\'s curse.', when: 'A curse blocks you. Or save it for the Black Hole.' },
  { id: 'oxygenTank', name: 'Oxygen Tank', short: 'Oxygen', icon: '🫧', rarity: 'common', kind: 'instant',
    what: '+60 s oxygen now (max 9:37).', when: 'Oxygen is under 1:00.' },
  { id: 'fuelCan', name: 'Fuel Can', short: 'Fuel Can', icon: '⛽', rarity: 'common', kind: 'instant',
    what: '+2 fuel now (max 6).', when: 'You want two Scans or a Reroll on a hard jump.' },
];
export const artifactById = (id) => ARTIFACTS.find((a) => a.id === id) || null;

/** Retired ids in saved runs → the nearest power-up today (null = dropped). */
export const MIGRATE = Object.freeze({
  wildMoon: 'thruster', factorial: 'supergiant', square: 'twinStar', squareRoot: 'twinStar', fusionCore: 'twinStar',
  mirrorShard: 'gravityAssist', fuelCell: 'fuelCan', gravityLens: 'fuelCan', overclock: 'oxygenTank', solarSail: 'oxygenTank',
  echo: null,
});

/** Map a saved run's artifact ids onto today's roster (unknown ids dropped, no duplicates). */
export function migrateArtifacts(ids = []) {
  const out = [];
  for (const id of ids) {
    const now = id in MIGRATE ? MIGRATE[id] : id;
    if (now && artifactById(now) && !out.includes(now)) out.push(now);
  }
  return out;
}

export const OXYGEN_TANK_SECONDS = 60;
export const FUEL_CAN_FUEL = 2;

// ── The one-use deck ──────────────────────────────────────────────────────────

/** The power-ups you aim at a die after USE. */
export const ACTIVE_TOOLS = Object.freeze(ARTIFACTS.filter((a) => a.kind === 'tool').map((a) => a.id));

/** Gravity Assist cannot clear a Core jump (Perfect only = exact hits), so it is never usable there. */
export const NOT_IN_CORE = Object.freeze(['gravityAssist']);

/**
 * Why a power-up cannot be used right now, or null if it can.
 * @param {string} id
 * @param {{ active: string[], curse?: string|null, core?: boolean }} ctx
 */
export function useBlocker(id, { active, curse = null, core = false }) {
  if (active.includes(id)) return 'In use this jump.';
  if (id === 'deflector' && !curse) return 'No curse on this jump.';
  if (NOT_IN_CORE.includes(id) && core) return 'Not in the Core: it needs exact hits.';
  return null;
}

/**
 * Settle the deck when a jump clears: every power-up used this jump leaves it.
 * @returns {{ deck: string[], spent: string[] }}
 */
export function settleDeck(deck, active) {
  const spent = active.filter((id) => deck.includes(id));
  return { deck: deck.filter((id) => !spent.includes(id)), spent };
}

/**
 * What a cleared jump says about the power-ups used on it (a chip each).
 * @param {{ assisted?: boolean }} p
 * @returns {{ procs: Array<{ id: string, icon: string, text: string }> }}
 */
export function clearRewards({ assisted = false } = {}) {
  return { procs: assisted ? [{ id: 'gravityAssist', icon: '🌀', text: 'Gravity Assist pulled you in' }] : [] };
}

/** What the line above the tray says while a tool is armed. */
export const TOOL_TEXT = Object.freeze({
  thruster: '🚀 Tap a die, then pick its new value.',
  supergiant: '🔆 Tap a white die to make it ×10.',
  tractorBeam: '🧲 Tap a die to reroll it.',
});

/** Can this tool be aimed at this die? Supergiant only grows WHITE dice. */
export const canTarget = (tool, color) => (tool === 'supergiant' ? color === 'white' : true);

/**
 * The values a tool offers for a die: Thruster up to 2 either way (Wild Moon's reach since 2026-10-22),
 * in tens on the gold die, kept on the die. Empty for tools that act at once.
 */
export function toolOptions(tool, value, color) {
  const step = color === 'gold' ? 10 : 1;
  if (tool === 'thruster') return [-2, -1, 1, 2].map((d) => value + d * step).filter((v) => v >= step && v <= 6 * step);
  return [];
}

/**
 * This jump's power-up use, from a saved run: { active }. Older saves stored use counts
 * ({ counts }) or { wild, tractor } booleans — anything used counts as active (and is migrated).
 * @returns {{ active: string[] }}
 */
export function migrateUsed(u) {
  if (!u) return { active: [] };
  const active = [];
  const add = (id) => { const now = id in MIGRATE ? MIGRATE[id] : id; if (now && !active.includes(now)) active.push(now); };
  for (const id of u.active || []) add(id);
  for (const [id, n] of Object.entries(u.counts || {})) if (n > 0) add(id);
  if (u.wild) add('wildMoon');
  if (u.tractor) add('tractorBeam');
  return { active };
}
