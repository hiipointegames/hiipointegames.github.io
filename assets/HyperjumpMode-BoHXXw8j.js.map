import React from 'react';
import { motion } from 'framer-motion';
import { ModeHeader } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { LightYearsGain } from './JumpMoment';
import ArtifactCard from './ArtifactCard';
import { timeLine } from './scoring';

// Hyperjump's draft screen: what the jump paid, then pick 1 of 3 artifacts, or Skip for fuel. `draft`
// comes from logic.draftFor: after a boss the choices are Black Hole loot (rare+); before a boss one
// card is a counter to its curse. (Salvage, its shop, charges and style bonuses were cut 2026-10-22:
// David's "simpler" brief. The screen showed 48 labels before.)

export default function DraftScreen({ jump, band, lastClear, artifacts, swapFor, draft, onPick, onSwapOut, onCancelSwap, onSkip, exitMode, exitTo37, leaveModal, skipFuel = 1 }) {
  return (
    <div className="relative isolate flex h-full flex-col overflow-y-auto pb-6" style={{ background: 'radial-gradient(ellipse at top, #312e81 0%, #04030d 70%)' }}>
      <ModeBackdrop theme="hyperjump" />
      <ModeHeader title={`Jump ${jump} cleared`} subtitle={band.name} onExit={exitMode} onReturnTo37={exitTo37} />
      <motion.div initial={{ scale: 0.9, opacity: 0 }} animate={{ scale: 1, opacity: 1 }} className="mt-4 px-4 text-center">
        <div className="text-3xl font-black text-white">+<LightYearsGain value={lastClear?.ly ?? 0} /> light-years</div>
        {lastClear?.lyParts?.length ? (
          // How the light-years were earned (David, 2026-10-22): "+412 LY · Perfect ×1.5 · Fast +25%".
          <div data-testid="hj-ly-parts" className="mt-1 flex flex-wrap justify-center gap-1.5">
            {lastClear.lyParts.map((p) => (
              <span key={p.id} className="rounded-full border border-amber-300/60 bg-amber-500/15 px-2 py-0.5 text-[11px] font-bold text-amber-100">{p.text}</span>
            ))}
          </div>
        ) : null}
        <div className="text-sm text-violet-200">
          {lastClear?.perfect ? '⭐ Perfect jump' : 'Clean jump'}
          {lastClear?.fuelGain ? ` · +${lastClear.fuelGain} fuel` : ''}
        </div>
        {/* What the jump gave back, and why (David, 2026-10-22): "+70 s oxygen · 30 + Fast 20 + Perfect 10 + No help 10". */}
        {lastClear?.time && (
          // Each part stays whole when the line wraps at 360 px ("No help 10" never splits). Same text as timeLine().
          <div data-testid="hj-time-line" aria-label={timeLine(lastClear.time, lastClear.timeCapped)} className="mt-1 text-sm font-bold text-cyan-100">
            <span className="whitespace-nowrap">+{lastClear.time.seconds} s oxygen</span>{' · '}
            {lastClear.time.parts.map((p, k) => <React.Fragment key={p.id}>{k > 0 && ' + '}<span className="whitespace-nowrap">{p.text}</span></React.Fragment>)}
            {lastClear.timeCapped && <span className="whitespace-nowrap"> (full at 9:37)</span>}
          </div>
        )}
        {lastClear?.procs?.length ? (
          // Artifacts say what they just did (2026-10-11: "every artifact flashes").
          <div className="mt-2 flex flex-wrap justify-center gap-1.5" data-testid="hj-procs">
            {lastClear.procs.map((p, i) => (
              <motion.span key={p.id} initial={{ scale: 0.6, opacity: 0 }} animate={{ scale: 1, opacity: 1 }} transition={{ delay: 0.3 + i * 0.12, type: 'spring', stiffness: 380, damping: 16 }}
                className="rounded-full border border-cyan-300/60 bg-cyan-500/15 px-2 py-0.5 text-[11px] font-bold text-cyan-100">
                {p.icon} {p.text}
              </motion.span>
            ))}
          </div>
        ) : null}
        {lastClear?.slotGained && <div data-testid="hj-slot-gained" className="mt-1 text-sm text-amber-300">Black Hole escaped: one more artifact slot</div>}
      </motion.div>
      <div className="mt-5 px-4 text-center text-[11px] uppercase tracking-[0.3em] text-violet-300">
        {swapFor ? 'Slots full: tap an artifact to swap out' : draft.loot ? '🕳️ Black Hole loot: rare artifacts only' : 'Pick one · keep it, USE it on any later jump'}
      </div>
      {swapFor ? (
        <div className="mt-3 grid grid-cols-4 gap-2 px-4">
          {artifacts.map((id) => <ArtifactCard key={id} id={id} compact highlight onPick={() => onSwapOut(id)} />)}
        </div>
      ) : (
        <div className="mt-3 grid gap-2 px-4">
          {draft.ids.map((id) => (
            <ArtifactCard key={id} id={id} counter={id === draft.counter} onPick={() => onPick(id)} />
          ))}
        </div>
      )}
      <div className="mt-4 px-4">
        <button type="button" data-testid="hj-skip" onClick={swapFor ? onCancelSwap : onSkip} className="w-full rounded-xl border border-white/20 py-2.5 text-sm text-slate-300">
          {swapFor ? 'Cancel swap' : `Skip · keep my artifacts · +${skipFuel}⛽`}
        </button>
      </div>
      {leaveModal}
    </div>
  );
}
