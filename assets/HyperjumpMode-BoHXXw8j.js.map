import React from 'react';
import { motion } from 'framer-motion';
import { NeonDieFace } from '../dice/NeonDie';
import { usePrefersReducedMotion } from '../../fx';

// The power-dice lesson on the Asteroid Belt banner (audit 2026-10-18, D5) — where the coloured dice
// first arrive (jump 6), in pictures: each colour of die → the keys it must touch (the keypad keys
// glow the same colours). Then the gold Tens die, which is NOT a power die.

export const LESSON = Object.freeze([
  { color: 'blue', value: 4, keys: ['×', '÷'], key: 'border-sky-400 bg-sky-900/50 text-sky-100' },
  { color: 'red', value: 2, keys: ['^'], key: 'border-rose-400 bg-rose-900/50 text-rose-100' },
  { color: 'green', value: 5, keys: ['+', '−'], key: 'border-emerald-400 bg-emerald-900/50 text-emerald-100' },
]);

export default function PowerDiceLesson() {
  const reduced = usePrefersReducedMotion();
  const appear = (k) => (reduced ? {} : { initial: { opacity: 0, x: -12 }, animate: { opacity: 1, x: 0 }, transition: { delay: 0.3 + k * 0.45 } });
  return (
    <div data-testid="hj-power-lesson" className="mx-auto w-full max-w-xs space-y-1.5 rounded-2xl border border-white/10 bg-black/40 p-3">
      {LESSON.map((row, k) => (
        <motion.div key={row.color} data-testid={`hj-lesson-${row.color}`} className="flex items-center justify-center gap-2" {...appear(k)}>
          <NeonDieFace value={row.value} color={row.color} size={28} />
          <span className="text-slate-400">→ touch</span>
          {row.keys.map((key) => <span key={key} className={`grid h-7 w-7 place-items-center rounded-lg border text-sm font-black ${row.key}`}>{key}</span>)}
        </motion.div>
      ))}
      <motion.div data-testid="hj-lesson-gold" className="flex items-center justify-center gap-2 border-t border-white/10 pt-1.5 text-xs text-amber-100" {...appear(3)}>
        <NeonDieFace value={50} color="gold" size={28} />
        <span>Tens die (10–60) — not a power die</span>
      </motion.div>
    </div>
  );
}
