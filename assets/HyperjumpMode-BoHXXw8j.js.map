// Hyperjump's rewards for a cleared jump (David, 2026-10-22): players who reach the same jump are told
// apart by HOW they got there, and the oxygen a jump gives back follows how good it was.
//
// THE TIERS (the sector's power rule, ./run.js SECTORS):
//   easy         jumps 1–5    white dice, no power rule (a Perfect is impossible: no power dice)
//   challenge    jumps 6–15   1, then 2 of the 3 power dice
//   perfectOnly  jumps 16–20  the Core: all 3, every jump
//
// LIGHT-YEARS = target × Perfect × (1 + the bonuses that apply)
//   Perfect ×1.5       Challenge only (no bonus for what the Core requires)
//   Fast +25%          under 20 s on the jump clock (it pauses on briefings and the Rules)
//   Quick +10%         under 40 s
//   No help +10%       no Scan, no Reroll and no power-up used on this jump
//   Curse beaten +20%  a cursed jump cleared without a Deflector
//   Perfect streak     Challenge only: +5% for every Perfect in a row after the first, up to +25%.
//                      Easy and Core jumps neither earn nor grow it (a Core jump does not break it)
//
// OXYGEN BACK (seconds) = 30 (40 in the Core) + Fast 20 / Quick 10 + Perfect 10 + No help 10,
// added up to the 9:37 ceiling. The same signals as the light-years, so "Fast" means the same in both.
//
// Pure. Ties on the Daily board go to the faster total time (the server's clock; see dailyRuns).

export const PERFECT_MULTIPLIER = 1.5;
export const FAST_SECONDS = 20;
export const QUICK_SECONDS = 40;
export const BONUS = Object.freeze({ fast: 0.25, quick: 0.1, noHelp: 0.1, curseBeaten: 0.2, streakStep: 0.05, streakMax: 0.25 });
/** Oxygen back for a cleared jump, in seconds (David, 2026-10-22: "correlated to how impressive and quick"). */
export const TIME = Object.freeze({ base: 30, coreBase: 40, fast: 20, quick: 10, perfect: 10, noHelp: 10 });

/** @typedef {'easy' | 'challenge' | 'perfectOnly'} Tier */

/**
 * A jump's tier from its power rule (powerNeeded): 0 = easy, 1–2 = challenge, 3 = Perfect only.
 * @param {number} need power dice the jump requires
 * @returns {Tier}
 */
export const tierFor = (need) => (need >= 3 ? 'perfectOnly' : need > 0 ? 'challenge' : 'easy');

const pct = (x) => `+${Math.round(x * 100)}%`;

/**
 * @param {{ target: number, tier: Tier, perfect: boolean, seconds: number, helped: boolean,
 *   cursed: boolean, deflected: boolean, streakBefore: number }} p
 *   streakBefore = Perfect Challenge jumps in a row before this one
 * @returns {{ ly: number, parts: Array<{ id: string, text: string }>, streak: number }}
 *   parts = what paid, in words, for the breakdown chips; streak = the run's streak after this jump
 */
export function jumpScore({ target, tier, perfect, seconds, helped, cursed, deflected, streakBefore }) {
  const parts = [];
  const challenge = tier === 'challenge';
  const countsAsPerfect = perfect && challenge;
  const mult = countsAsPerfect ? PERFECT_MULTIPLIER : 1;
  if (countsAsPerfect) parts.push({ id: 'perfect', text: `Perfect ×${PERFECT_MULTIPLIER}` });
  let bonus = 0;
  const add = (id, label, x) => { bonus += x; parts.push({ id, text: `${label} ${pct(x)}` }); };
  if (seconds < FAST_SECONDS) add('fast', 'Fast', BONUS.fast);
  else if (seconds < QUICK_SECONDS) add('quick', 'Quick', BONUS.quick);
  if (!helped) add('noHelp', 'No help', BONUS.noHelp);
  if (cursed && !deflected) add('curseBeaten', 'Curse beaten', BONUS.curseBeaten);
  // The streak lives on Challenge jumps only: a miss there breaks it; Easy and Core jumps leave it be.
  const streak = challenge ? (countsAsPerfect ? streakBefore + 1 : 0) : streakBefore;
  if (countsAsPerfect && streak > 1) add('streak', 'Perfect streak', Math.min(BONUS.streakMax, BONUS.streakStep * (streak - 1)));
  return { ly: Math.round(target * mult * (1 + bonus)), parts, streak };
}

/**
 * The oxygen a cleared jump gives back, with its parts for the clear screen ("30 + Fast 20 + …").
 * @param {{ tier: Tier, perfect: boolean, seconds: number, helped: boolean }} p
 * @returns {{ seconds: number, parts: Array<{ id: string, text: string, seconds: number }> }}
 */
export function timeReward({ tier, perfect, seconds, helped }) {
  const base = tier === 'perfectOnly' ? TIME.coreBase : TIME.base;
  /** @type {Array<{ id: string, text: string, seconds: number }>} */
  const parts = [{ id: 'base', text: String(base), seconds: base }];
  if (seconds < FAST_SECONDS) parts.push({ id: 'fast', text: `Fast ${TIME.fast}`, seconds: TIME.fast });
  else if (seconds < QUICK_SECONDS) parts.push({ id: 'quick', text: `Quick ${TIME.quick}`, seconds: TIME.quick });
  if (perfect && tier === 'challenge') parts.push({ id: 'perfect', text: `Perfect ${TIME.perfect}`, seconds: TIME.perfect });
  if (!helped) parts.push({ id: 'noHelp', text: `No help ${TIME.noHelp}`, seconds: TIME.noHelp });
  return { seconds: parts.reduce((s, p) => s + p.seconds, 0), parts };
}

/** "+70 s oxygen · 30 + Fast 20 + Perfect 10 + No help 10", and "(full at 9:37)" when the ceiling clipped it. */
export const timeLine = ({ seconds, parts }, capped = false) =>
  `+${seconds} s oxygen · ${parts.map((p) => p.text).join(' + ')}${capped ? ' (full at 9:37)' : ''}`;
