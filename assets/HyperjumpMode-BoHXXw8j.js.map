// Count-ups — numbers that roll to their value (odometer feel; animation playbook §2.4).
//
// The value is driven by requestAnimationFrame into a ref'd element's text, NOT React state,
// so a 600 ms count-up costs no re-renders. An optional onTick fires each time the shown
// integer changes (rising ticks in sound).

import { useEffect, useRef } from 'react';
import { prefersReducedMotion } from './motionPrefs';

/** Ease-out cubic: fast start, gentle landing. */
export const easeOutCubic = (x) => 1 - (1 - Math.min(1, Math.max(0, x))) ** 3;

/** The value shown at `elapsedMs` of a count from `from` to `to` over `durationMs`. */
export function countUpValue(from, to, elapsedMs, durationMs) {
  if (durationMs <= 0 || elapsedMs >= durationMs) return to;
  return Math.round(from + (to - from) * easeOutCubic(elapsedMs / durationMs));
}

/** Longer counts for bigger numbers, within 300–1200 ms. */
export const countUpDuration = (from, to) => Math.max(300, Math.min(1200, 250 + Math.abs(to - from) * 2));

/**
 * Roll `ref.current.textContent` from its previous value to `value`.
 * @param {{ current: HTMLElement | null }} ref
 * @param {number} value
 * @param {{ ms?: number, format?: (n: number) => string, onTick?: (n: number) => void }} [opts]
 */
export function useCountUp(ref, value, opts = {}) {
  const prev = useRef(value);
  const { ms, format = (n) => n.toLocaleString(), onTick } = opts;
  useEffect(() => {
    const el = ref.current;
    const from = prev.current;
    prev.current = value;
    if (!el) return undefined;
    if (from === value || prefersReducedMotion()) { el.textContent = format(value); return undefined; }
    const duration = ms ?? countUpDuration(from, value);
    const start = performance.now();
    let last = null;
    let raf = 0;
    const frame = (now) => {
      const shown = countUpValue(from, value, now - start, duration);
      if (shown !== last) { el.textContent = format(shown); onTick?.(shown); last = shown; }
      if (shown !== value) raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);
    return () => cancelAnimationFrame(raf);
  }, [value]); // only a new value restarts the roll; ms/format/onTick are read fresh each time
}
