import React from 'react';
import { motion } from 'framer-motion';
import { ModeHeader, PrimaryButton } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { sectorFor } from './run';
import { targetFor } from './logic';
import PowerDiceLesson from './PowerDiceLesson';

// The banner between sectors (moved out of HyperjumpMode, audit 2026-10-18). The best teaching in the
// game (both simulated players): the sector's news in one sentence before its first jump.

/**
 * @param {{ jump: number, onEnter: () => void, onExit: () => void,
 *   onReturnTo37: () => void, leaveModal?: React.ReactNode }} props  jump = the sector's first jump
 */
export default function SectorBanner({ jump, onEnter, onExit, onReturnTo37, leaveModal = null }) {
  const sec = sectorFor(jump);
  return (
    <div className="relative isolate flex h-full flex-col overflow-y-auto" style={{ background: 'radial-gradient(ellipse at center, #1e3a8a 0%, #04030d 70%)' }}>
      <ModeBackdrop theme="hyperjump" />
      <ModeHeader title="Hyperjump" subtitle={`Jump ${jump - 1} cleared`} onExit={onExit} onReturnTo37={onReturnTo37} />
      <motion.div initial={{ y: 20, opacity: 0 }} animate={{ y: 0, opacity: 1 }} className="mx-auto mt-10 max-w-sm space-y-3 px-5 text-center" data-testid="hj-sector">
        <div className="text-[11px] uppercase tracking-[0.35em] text-sky-300">Sector {sec.number} of 4</div>
        <div className="text-4xl font-black text-white">{sec.name}</div>
        <p className="text-slate-300">{sec.blurb}</p>
        {sec.id === 'belt' && <PowerDiceLesson />}
        {sec.id === 'deep' && <div data-testid="hj-now-two" className="inline-block rounded-full border border-emerald-300/60 px-3 py-1 text-sm font-black text-emerald-200">⚡ now 2 of 3</div>}
        <p className="text-xs text-slate-500">Jumps {jump}–{jump + 4} · targets {targetFor(jump)} to {targetFor(jump + 4)}</p>
        <PrimaryButton testId="hj-enter-sector" onClick={onEnter}>ENTER {sec.name.toUpperCase()} ▶</PrimaryButton>
      </motion.div>
      {leaveModal}
    </div>
  );
}
