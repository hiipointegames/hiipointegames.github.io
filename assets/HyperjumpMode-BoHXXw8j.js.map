import React, { useCallback, useEffect, useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { useFx, runTimeline, prefersReducedMotion, useCountUp } from '../../fx';

// Hyperjump's signature moment, "The Jump" (sweep SW6; storyboard: research/juice.md §3.1).
//
// Beats (ms from the accepted JUMP), all skippable with a tap:
//   0      hit-stop + burst from the equation + small shake + thud   (fx cue)
//   0–360  the equation pulses and collapses into its value
//   360    hyperspace: star streaks rush out from the centre
//   760    land on the next screen (artifact draft / the Core)
// A Black Hole escape is gold, heavier and longer; reaching the Core rains 37-confetti.
// It escalates over a run: `heat` (0..1) grows with the jump number. Reduced motion: no
// streaks, no shake — the sound + vibration still mark the moment, and it lands at once.

// Bigger + brighter after David saw it on the S21 (2026-10-10): more and thicker streaks, a
// white-hot flash core, a second ring, more shake; the everyday jump still lands under 1.4 s.
export const MOMENTS = Object.freeze({
  jump: { cue: 'jumpValid', color: '#a78bfa', warpAt: 360, landAt: 900 },
  boss: { cue: 'bossEscape', color: '#fbbf24', warpAt: 700, landAt: 1250 },
  core: { cue: 'modeWin', color: '#fde68a', warpAt: 900, landAt: 1800 },
});

export const heatForJump = (jump) => Math.max(0, Math.min(1, (jump - 1) / 19));

const STREAK_COUNT = 44;
const STREAKS = Array.from({ length: STREAK_COUNT }, (_, i) => ({
  angle: (i / STREAK_COUNT) * 360 + ((i * 37) % 11),
  delay: (i % 7) * 0.025,
  length: 48 + ((i * 53) % 34),
  thick: i % 3 === 0 ? 4 : 2.5,
}));

/** Full-screen streak overlay; also catches the tap that skips the moment. */
function JumpWarp({ kind, stage, onSkip }) {
  const { color } = MOMENTS[kind];
  return (
    <div className="absolute inset-0 z-30 overflow-hidden" data-testid="hj-moment" data-stage={stage} onClick={onSkip} role="presentation">
      {stage === 'warp' && (
        <>
          <motion.div className="absolute inset-0" initial={{ opacity: 0 }} animate={{ opacity: [0, 0.9, 0] }} transition={{ duration: 0.5 }}
            style={{ background: `radial-gradient(circle at 50% 45%, #ffffff 0%, ${color} 18%, transparent 65%)` }} />
          {STREAKS.map((s, i) => (
            <div key={i} className="absolute left-1/2 top-[45%] w-0" style={{ height: s.thick, transform: `rotate(${s.angle}deg)` }}>
              <motion.div
                className="origin-left rounded-full"
                style={{ height: s.thick, width: `${s.length}vmax`, background: `linear-gradient(90deg, transparent, ${color} 60%, #ffffff)` }}
                initial={{ scaleX: 0, opacity: 0, x: '3vmax' }}
                animate={{ scaleX: [0, 1, 1], opacity: [0, 1, 0], x: ['3vmax', '6vmax', '24vmax'] }}
                transition={{ duration: 0.5, delay: s.delay, ease: 'easeIn' }}
              />
            </div>
          ))}
        </>
      )}
    </div>
  );
}

/**
 * Drives the moment. `start(kind, jump, land)` plays it and calls `land()` at the end (or at
 * once on skip / reduced motion). `fail()` shakes just the equation. `readoutAnim` animates the
 * readout wrapper; `overlay` is the streak layer to render on the jump screen.
 */
export function useJumpMoment(readoutRef) {
  const fx = useFx();
  const [moment, setMoment] = useState(null); // { kind, stage }
  const [failKey, setFailKey] = useState(0);
  const tl = useRef(null);

  useEffect(() => () => tl.current?.cancel(), []);

  const start = useCallback((kind, jump, land) => {
    const m = MOMENTS[kind];
    const heat = heatForJump(jump);
    fx.cue(m.cue, { at: readoutRef, heat, color: m.color });
    fx.burst(readoutRef, { preset: 'ring', color: m.color });
    fx.shake(0.15 + heat * 0.15); // on top of the cue's own trauma: bigger as the run goes on
    if (kind === 'core') fx.burst(readoutRef, { preset: 'confetti37', color: m.color, heat: 1 });
    if (prefersReducedMotion()) { land(); return; }
    setMoment({ kind, stage: 'collapse' });
    tl.current = runTimeline([
      { at: m.warpAt, run: () => setMoment({ kind, stage: 'warp' }) },
      { at: m.landAt, run: () => { setMoment(null); land(); } },
    ]);
  }, [fx, readoutRef]);

  const fail = useCallback(() => {
    fx.cue('fail');
    setFailKey((k) => k + 1);
  }, [fx]);

  const readoutAnim = moment
    ? { animate: { scale: [1, 1.1, 0.88], opacity: [1, 1, 0.5] }, transition: { duration: 0.36 } }
    : failKey
      ? { animate: { x: [0, -9, 8, -5, 4, 0] }, transition: { duration: 0.32 } }
      : { animate: {} };

  const overlay = moment ? <JumpWarp kind={moment.kind} stage={moment.stage} onSkip={() => tl.current?.skip()} /> : null;
  return { start, fail, readoutAnim, failKey, overlay, active: Boolean(moment) };
}

/** "+N light-years" that rolls up from 0 when the draft screen arrives. */
export function LightYearsGain({ value }) {
  const ref = useRef(null);
  const [shown, setShown] = useState(0);
  useEffect(() => { setShown(value); }, [value]);
  useCountUp(ref, shown);
  return <span ref={ref} data-testid="hj-ly-gain">0</span>;
}
