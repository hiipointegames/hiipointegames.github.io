import React, { useEffect, useState } from 'react';
import { motion } from 'framer-motion';
import { NeonDieFace } from '../dice/NeonDie';
import { usePrefersReducedMotion } from '../../fx';

// Hyperjump's launch demo (audit 2026-10-18, D1): ~5 s, code-drawn, the core loop in one glance —
// seven dice make 37 → JUMP → warp → seven dice make 74 → JUMP → "…all the way to jump 20".
// Every equation is real (tested with the game's own maths). Holds while the app is hidden or
// the How-it-works sheet covers it. Reduce-motion: three still frames.

// 7 dice each (the real rule): 6×5+2+3+1+2−1 = 37 · 6×6×2+3−1×1×1 = 74.
const B1 = [6, '×', 5, '+', 2, '+', 3, '+', 1, '+', 2, '−', 1];
const B2 = [6, '×', 6, '×', 2, '+', 3, '−', 1, '×', 1, '×', 1];

/** The beats. `ms` = how long each holds (the ✓ beats longest). */
export const HJ_DEMO_STEPS = Object.freeze([
  { jump: 1, target: 37, tokens: [], ms: 500 },
  { jump: 1, target: 37, tokens: B1, chip: '37 ✓', ms: 1400 },
  { jump: 2, target: 74, tokens: [], warp: true, ms: 800 },
  { jump: 2, target: 74, tokens: B2, chip: '74 ✓', ms: 1400 },
  { jump: 20, target: 740, tokens: [], warp: true, ladder: true, ms: 1200 },
]);
export const HJ_DEMO_LOOP_MS = HJ_DEMO_STEPS.reduce((n, s) => n + s.ms, 0);
const STILLS = [1, 3, 4]; // reduce-motion: make 37 → make 74 → up to jump 20

function Frame({ step, still = false }) {
  const s = HJ_DEMO_STEPS[step];
  return (
    <div data-testid={still ? 'hj-demo-still' : 'hj-demo-frame'} data-step={step}
      className="relative min-h-[112px] overflow-hidden rounded-2xl border border-violet-300/30 bg-black/40 px-2 py-2">
      {s.warp && !still && (
        // the jump itself: star streaks rush past
        <motion.div key={`w${step}`} className="pointer-events-none absolute inset-0" initial={{ opacity: 1 }} animate={{ opacity: 0 }} transition={{ duration: 0.7 }} aria-hidden="true">
          {[12, 30, 48, 66, 84].map((top) => (
            <motion.div key={top} className="absolute h-0.5 rounded-full bg-gradient-to-r from-transparent via-violet-200 to-transparent"
              style={{ top: `${top}%`, left: 0, right: 0 }} initial={{ scaleX: 0.1 }} animate={{ scaleX: 1.6 }} transition={{ duration: 0.6 }} />
          ))}
        </motion.div>
      )}
      <div className="text-[10px] uppercase tracking-[0.3em] text-violet-300">Jump {s.jump}{s.ladder ? ' · the Core' : ''}</div>
      <div className="text-3xl font-black leading-none text-white">{s.target}</div>
      {s.ladder ? (
        <>
          <div className="mt-1.5 text-xs font-bold text-violet-200">37 → 74 → 111 → … → 740</div>
          <div className="text-[11px] text-amber-200">+ power dice from jump 6</div>
        </>
      ) : (
        <div className="mt-1.5 flex min-h-[18px] flex-wrap items-center justify-center gap-0.5">
          {s.tokens.map((v, k) => (
            <motion.span key={`${step}-${k}`} className="inline-flex items-center" initial={still ? false : { y: 14, opacity: 0 }} animate={{ y: 0, opacity: 1 }}
              transition={still ? { duration: 0 } : { delay: k * 0.03, type: 'spring', stiffness: 300, damping: 20 }}>
              {typeof v === 'number' ? <NeonDieFace value={v} size={15} /> : <span className="text-[10px] font-black text-violet-300">{v}</span>}
            </motion.span>
          ))}
        </div>
      )}
      <div className="mt-1 flex h-5 items-center justify-center gap-1.5">
        {s.chip && (
          <>
            <motion.span key={`c${step}`} initial={still ? false : { opacity: 0, scale: 0.6 }} animate={{ opacity: 1, scale: 1 }}
              transition={still ? { duration: 0 } : { delay: 0.45, type: 'spring', stiffness: 380, damping: 16 }}
              className="rounded-full border border-emerald-300/70 px-1.5 text-xs font-black text-emerald-200">{s.chip}</motion.span>
            <motion.span key={`j${step}`} data-testid="hj-demo-jump" initial={still ? false : { opacity: 0 }}
              animate={still ? { opacity: 1 } : { opacity: 1, scale: [1, 1, 0.82, 1] }}
              transition={still ? { duration: 0 } : { delay: 0.75, duration: 0.5, times: [0, 0.5, 0.75, 1] }}
              className="rounded-full bg-violet-500 px-2 text-[11px] font-black text-white">JUMP ▶</motion.span>
          </>
        )}
      </div>
    </div>
  );
}

/** The looping demo (or three stills under reduce-motion). `paused`: hold the current beat. */
export default function HyperjumpDemo({ paused = false }) {
  const reduced = usePrefersReducedMotion();
  const [step, setStep] = useState(0);
  const [tick, setTick] = useState(0); // re-arms the timer while a beat is being held
  useEffect(() => {
    if (reduced || paused) return undefined;
    const id = setTimeout(() => {
      if (typeof document !== 'undefined' && document.hidden) setTick((n) => n + 1);
      else setStep((n) => (n + 1) % HJ_DEMO_STEPS.length);
    }, HJ_DEMO_STEPS[step].ms);
    return () => clearTimeout(id);
  }, [reduced, paused, step, tick]);
  if (reduced) {
    return (
      <div data-testid="hj-demo" data-reduced="true" className="space-y-1.5" aria-hidden="true">
        {STILLS.map((k) => <Frame key={k} step={k} still />)}
      </div>
    );
  }
  return <div data-testid="hj-demo" aria-hidden="true"><Frame step={step} /></div>;
}
