import React from 'react';
import { motion } from 'framer-motion';
import { ModeHeader, ShareButton } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { ArtifactIcon } from './ArtifactIcon';
import { runSummary, runGlyphs, runCardText, targetFor, helpText } from './logic';
import { DailyChip, PracticeChip } from '../coach';
import EndRoute from './EndRoute';
import { readBestValue } from '../bests';
import { FINAL_JUMP } from './run';
import { DailyPlace } from '../DailyBoard';
import { REWARDS, REWARD_CAPS, capText } from '../rewards';

// Hyperjump's end screens (moved out of HyperjumpMode, audit 2026-10-18): "over" (oxygen out) and
// "won" (the Core). The headline counts jumps CLEARED — never "Jump 0" for a first-jump crash.

/** "Cleared 1 jump" / "Cleared 7 jumps" */
export const clearedText = (n) => `Cleared ${n} ${n === 1 ? 'jump' : 'jumps'}`;

/** The final screen's run summary (review 2026-10-14): what the run log knows, plus its glyph line. */
export function RunSummary({ runLog, help = null }) {
  const s = runSummary(runLog);
  const glyphs = runGlyphs(runLog);
  return (
    <div data-testid="hj-summary" className="rounded-xl border border-violet-300/30 bg-black/30 px-3 py-2 text-sm text-slate-200">
      <div>
        ⭐ <b>{s.perfects}</b> Perfect · 🕳️ <b>{s.bosses}</b> Black {s.bosses === 1 ? 'Hole' : 'Holes'}
      </div>
      {help && <div data-testid="hj-help-used">{helpText(help)}</div>}
      {glyphs && <div className="mt-1 text-base">{glyphs}</div>}
    </div>
  );
}

/**
 * @param {{ won: boolean, jump: number, lightYears: number, artifacts: string[], runLog: any[], isDaily: boolean,
 *   date: string, recorded: number, onExit: () => void, onReturnTo37: () => void, onNewRun: () => void,
 *   newBest?: boolean, placeStatus?: string, stoppedTarget?: number|null,
 *   help?: { scans: number, rerolls: number } | null, endBoard?: object | null, coreStarEligible?: boolean }} props
 *   help = the Scans and Rerolls the run used (on the results and the share card: framework C1).
 *   endBoard = the board that ended an "over" run: one route for it is shown (never shared).
 *   coreStarEligible = a Free Core win pays ★ only for a run from jump 1 (Practice can start later).
 *   jump = the jump the run stopped on (over) — the cleared count is jump − 1.
 *   The story (audit D9): how far, the score, then your place (Daily) or your best (Free), and where it ended.
 */
export default function RunResults({ won, jump, lightYears, artifacts, runLog, isDaily, date, recorded, onExit, onReturnTo37, onNewRun, newBest = false, placeStatus = 'pending', stoppedTarget = null,
  help = null, endBoard = null, coreStarEligible = true }) {
  const best = readBestValue('hyperjump');
  const cleared = won ? FINAL_JUMP : jump - 1;
  const shareText = () => runCardText({ jump: cleared, lightYears, artifacts, daily: isDaily, date, won, runLog, help });
  const bg = won ? 'radial-gradient(ellipse at center, #b45309 0%, #3b0764 35%, #04030d 75%)' : 'radial-gradient(ellipse at center, #3b0764 0%, #04030d 70%)';
  return (
    <div className="relative isolate flex h-full flex-col overflow-y-auto" style={{ background: bg }}>
      <ModeBackdrop theme="hyperjump" />
      <ModeHeader title="Hyperjump" subtitle={isDaily ? <DailyChip date={date} /> : <PracticeChip />} onExit={onExit} onReturnTo37={onReturnTo37} />
      <motion.div initial={won ? { scale: 0.8, opacity: 0 } : false} animate={{ scale: 1, opacity: 1 }}
        className="mx-auto mt-8 max-w-sm space-y-3 px-5 text-center" data-testid={won ? 'hj-won' : 'hj-over'}>
        {won && <div className="text-6xl">☀️</div>}
        <div className={`text-sm uppercase tracking-[0.3em] ${won ? 'text-amber-200' : 'text-rose-300'}`}>{won ? 'You reached the Core' : 'Oxygen depleted'}</div>
        <div data-testid="hj-cleared" className="text-4xl font-black text-white">{won ? 'Run complete' : clearedText(cleared)}</div>
        <div data-testid="hj-result-score" className="text-lg text-violet-200">{lightYears.toLocaleString()} light-years{won ? ` · ${FINAL_JUMP} jumps` : ''}</div>
        {won && (isDaily || coreStarEligible) && !(isDaily && placeStatus === 'dropped') && <div data-testid="hj-core-stars" className="text-sm font-bold text-amber-200">{isDaily ? `Daily Core: ${REWARDS.hj_core}★ (${capText(REWARD_CAPS.hj_core)})` : `Free Core: ${REWARDS.hj_core_free}★ (${capText(REWARD_CAPS.hj_core_free)})`}</div>}
        {!won && <div data-testid="hj-stopped" className="text-sm text-slate-300">Out of oxygen on jump {jump} · target {stoppedTarget ?? targetFor(jump)}</div>}
        <div className="flex justify-center gap-1.5 text-2xl">{artifacts.map((id) => <ArtifactIcon key={id} id={id} />)}</div>
        <RunSummary runLog={runLog} help={help} />
        {!won && endBoard && <EndRoute board={endBoard} />}
        {isDaily ? <DailyPlace game="hyperjump" recorded={recorded} day={date} status={placeStatus} />
          : best != null && (
            <div data-testid="hj-best" className="text-sm font-bold text-amber-200">{newBest && cleared > 0 ? '🏅 New best!' : `Your best: ${clearedText(best).toLowerCase()}`}</div>
          )}
        <div className="flex justify-center gap-2 pt-2">
          <ShareButton text={shareText} label="Share run card" />
          <button type="button" onClick={onNewRun} className="rounded-xl bg-violet-500 px-4 py-2.5 text-sm font-black text-white">New run</button>
        </div>
      </motion.div>
    </div>
  );
}
