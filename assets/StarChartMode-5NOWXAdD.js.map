// Star Chart — par, rating, bounty and the special-star pad hints (overnight 2026-10-11;
// Hyperjump's Bounties and clear card, adapted). Pure.
//
// PAR is a first guess per layout (seconds, penalties included — the same number the ⏱ shows),
// to be tuned from real play: generous enough that a clean, unhurried solve earns gold.

import { makeRng } from '../rng';
import { REWARDS } from '../rewards';
import { MIRROR_TARGET } from './generator';

export const PAR_SECONDS = Object.freeze({ twin: 90, trio: 150, hash: 240, galaxy: 420 });
export const BOUNTY_STARS = REWARDS.sc_bounty; // what the server pays (../rewards)

export const parFor = (layoutId) => PAR_SECONDS[layoutId] ?? PAR_SECONDS.trio;
/** Seconds as m:ss. Fractions floor (59.6 → "0:59"); negative or not-a-number → "0:00". */
export const clock = (s) => {
  const t = Number.isFinite(s) ? Math.max(0, Math.floor(s)) : 0;
  return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
};

/**
 * Gold at or under par, silver within double par, bronze for any solve (3 / 2 / 1).
 * Shown as MEDALS, not ★ (review 2026-10-14: "star" meant four things on one screen — the chart's
 * stars, the rating, the ★ currency and the mode's name). ★ now only ever means the currency.
 */
export const MEDAL = Object.freeze({ 3: '🥇', 2: '🥈', 1: '🥉' });
export const MEDAL_NAME = Object.freeze({ 3: 'Gold', 2: 'Silver', 1: 'Bronze' });
export function parRating(layoutId, score) {
  const par = parFor(layoutId);
  return score <= par ? 3 : score <= par * 2 ? 2 : 1;
}

/**
 * Chart bounties: one per chart, seeded by the chart. ctx at the solve: { board, score, par }.
 * Every one is always possible — they only ask you to lean on your own deduction.
 */
export const BOUNTIES = Object.freeze([
  // Shown as "Bonus: no hints · +1★" ("Bounty" retired as a player word, world framework §A).
  { id: 'noHints', icon: '🧠', text: 'no hints', met: ({ board }) => board.hints === 0 },
  { id: 'noChecks', icon: '🎯', text: 'no Check', met: ({ board }) => board.checks === 0 },
  { id: 'underPar', icon: '⏱️', text: 'at or under par', met: ({ score, par }) => score <= par },
]);
export const bountyById = (id) => BOUNTIES.find((b) => b.id === id) || null;
export const bountyFor = (seed) => BOUNTIES[Math.floor(makeRng(`${seed}-bounty`)() * BOUNTIES.length)].id;
export const bountyMet = (id, ctx) => Boolean(bountyById(id)?.met(ctx));

/**
 * Pad numbers a special star rules out for the selected star: an odd star can't take an even
 * number; a star in an equal pair must match its partner once the partner has a number.
 * Only the special rules — the pad never does the line arithmetic for you.
 * @returns {Set<number>}
 */
export function ruledOut(selected, specials, values) {
  const out = new Set();
  if (!selected || !specials) return out;
  if ((specials.pulsars || []).includes(selected)) [2, 4, 6].forEach((v) => out.add(v));
  for (const [a, b] of specials.binaries || []) {
    const partner = a === selected ? b : b === selected ? a : null;
    if (partner && values[partner] != null) [1, 2, 3, 4, 5, 6].filter((v) => v !== values[partner]).forEach((v) => out.add(v));
  }
  return out;
}

/** "4 over" / "3 short" for a full line that misses its target. */
export const lineGap = (value, target) => (value > target ? `${value - target} over` : `${target - value} short`);

/** The colour a line lights up in once it makes its target: the 73 line stays violet, the rest go green. */
export const doneColor = (target) => (target === MIRROR_TARGET ? '#c084fc' : '#34d399');


/**
 * The share text (audit 2026-10-18 D7) — SPOILER-FREE: the layout, time, medal and how many hints and
 * checks, never a star's number, a line total or which stars were given. The Daily carries its own
 * (pinned) day as MM-DD, so a chart begun before midnight shares as that day.
 * @param {{ daily: boolean, date?: string|null, layoutName: string, score: number, rating: 1|2|3, hints: number, checks: number }} p
 */
export function chartShareText({ daily, date = null, layoutName, score, rating, hints, checks }) {
  const head = daily ? `✨ Star Chart Daily ${String(date ?? '').slice(5)} · ${layoutName}` : `✨ Star Chart · ${layoutName} practice`;
  return `${head} · ${clock(score)} · ${MEDAL[rating]}\n${helpText(hints, checks)}\nSector 73 · https://37themathpuzzle.app`;
}

/**
 * Hints and checks used, in ONE wording everywhere (results, the Daily-done card, the share — review sc-5 #2):
 * "No hints · no checks" for a clean solve, else "1 hint · 0 checks".
 */
export function helpText(hints = 0, checks = 0) {
  const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;
  return hints + checks ? `${plural(hints, 'hint')} · ${plural(checks, 'check')}` : 'No hints · no checks';
}
