// Star Chart — what each line adds up to right now, and whether it can still make its target
// (redesign slice 2, PROPOSAL §3B). Pure: the board, the readout, the coach line and the tips all
// read the same answer.
//
// "Ways" = the 1–6 fillings of a line's empty stars that hit its target AND keep the special rules
// (odd stars odd, "=" pairs equal). It is arithmetic on what is placed, never the chart's solution,
// so it is as fair in the Daily as the line totals already were.

import { lineSolutions, evalLine } from './generator';

/** @typedef {'open' | 'done' | 'miss' | 'broken'} LineStatus */
/**
 * @typedef {{
 *   li: number, keys: string[], ops: string[], target: number,
 *   values: Array<number | null>, full: boolean, value: number | null,
 *   ways: number, status: LineStatus, why: 'sum' | 'rule' | null,
 * }} LineState
 */

// lineSolutions is up to 6^5 evaluations per line; a chart asks for the same few lines on every tap.
const memo = new Map();
/** Every 1–6 tuple that makes a line with `ops` equal `target` (memoised). */
export function solutionsFor(ops, target) {
  const key = `${ops.join('')}|${target}`;
  let list = memo.get(key);
  if (!list) { list = lineSolutions(ops, target); memo.set(key, list); }
  return list;
}

/**
 * Can value `v` sit on star `k` under the special rules alone? (Odd star → odd; a pair star whose
 * partner already has a number → that number.)
 */
function specialAllows(k, v, specials, all) {
  if ((specials?.pulsars || []).includes(k) && v % 2 === 0) return false;
  for (const [a, b] of specials?.binaries || []) {
    const partner = a === k ? b : b === k ? a : null;
    if (partner && all[partner] != null && all[partner] !== v) return false;
  }
  return true;
}

/** Positions on this line holding the two stars of an "=" pair (both on the line), as [i, j] pairs. */
function pairsOnLine(keys, specials) {
  return (specials?.binaries || []).map(([a, b]) => [keys.indexOf(a), keys.indexOf(b)]).filter(([i, j]) => i >= 0 && j >= 0);
}

/**
 * The state of every line of `chart` with the numbers in `all` (entries + givens + hints).
 * @param {{ layout: { lines: string[][] }, ops: string[][], targets: number[], specials?: any }} chart
 * @param {Record<string, number>} all
 * @returns {LineState[]}
 */
export function lineStates(chart, all) {
  return chart.layout.lines.map((keys, li) => {
    const ops = chart.ops[li];
    const target = chart.targets[li];
    const values = keys.map((k) => all[k] ?? null);
    const full = values.every((v) => v != null);
    const value = full ? evalLine(values, ops) : null;
    const fits = (t) => keys.every((k, pos) => (values[pos] != null ? t[pos] === values[pos] : true));
    const sumWays = solutionsFor(ops, target).filter(fits);
    const pairs = pairsOnLine(keys, chart.specials);
    const ways = sumWays.filter((t) => keys.every((k, pos) => values[pos] != null || specialAllows(k, t[pos], chart.specials, all))
      && pairs.every(([i, j]) => t[i] === t[j])).length;
    /** @type {LineStatus} */
    const status = full ? (value === target ? 'done' : 'miss') : ways === 0 ? 'broken' : 'open';
    const why = status === 'broken' ? (sumWays.length ? 'rule' : 'sum') : null;
    return { li, keys, ops, target, values, full, value, ways, status, why };
  });
}

/**
 * A line's name in reading order, the way a player would say it: rows top to bottom ("Row 1"…),
 * columns left to right ("Column 1"…). A line is a row when its stars share a row index.
 * @param {{ layout: { lines: string[][] } }} chart
 * @param {number} li
 */
export function lineName(chart, li) {
  const info = chart.layout.lines.map((keys, i) => {
    const [r0, c0] = keys[0].split(',').map(Number);
    const [r1] = keys[keys.length - 1].split(',').map(Number);
    return { i, row: r0 === r1, at: r0 === r1 ? r0 : c0 };
  });
  const me = info[li];
  const same = info.filter((x) => x.row === me.row).sort((a, b) => a.at - b.at);
  return `${me.row ? 'Row' : 'Column'} ${same.findIndex((x) => x.i === li) + 1}`;
}

/**
 * The live coach line (framework §B1.2, ≤ 12 words): before any move, how to start; then how far
 * along the chart is. "2 of 4 lines done · 3 stars left".
 * @param {LineState[]} states
 * @param {number} emptyStars  stars still without a number
 * @param {number} moves  numbers the player has placed or revealed
 */
export function progressLine(states, emptyStars, moves) {
  if (!moves) return 'Tap a star, then pick its number.';
  const done = states.filter((s) => s.status === 'done').length;
  return `${done} of ${states.length} lines done · ${emptyStars} star${emptyStars === 1 ? '' : 's'} left`;
}
