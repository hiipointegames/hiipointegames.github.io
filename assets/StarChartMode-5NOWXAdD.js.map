import React, { forwardRef } from 'react';
import { motion } from 'framer-motion';
import { DISPLAY } from '../sectorMath';
import { MIRROR_TARGET } from './generator';
import { doneColor } from './chartInfo';

// The Star Chart board: constellation lines, the equal-pair links and "=" tags, the operator
// badges, the line-end targets and the stars. Pure rendering — props in, a tap callback out, no state
// (extracted from StarChartMode.jsx, audit 2026-10-18 slice 2a). Each layer is its own piece so a
// change to one (the line targets, the pair marks) stays inside it.

// Every line ENDS in its glowing gold target, "= 37" (David, 2026-10-22): right of a row's last star,
// under a column's. So the board keeps a little room on the left/top and more on the right/bottom.
const PAD_START = 8;
const PAD_END = 46;
const PAD = PAD_START + PAD_END;
/** The target label's box (px), measured from its widest text, "= 73 ✕" / "=" over "73 ✕". */
export const LABEL_SIZE = Object.freeze({ row: [52, 18], column: [36, 32] }); // Chrome: "= 73 ✕" 49 × 15, "="/"37 ✕" 34 × 30

/**
 * Board geometry: size, cell, star/badge sizes, a star's centre, and the "=" pair tag (its size and
 * centre). Exported so the tests measure overlaps with the same maths the board draws with.
 */
export function geometry(grid, viewport = globalThis.innerWidth) {
  // Nearly the full width (redesign slice 5: a 5×5 board's stars were 31 px at 360).
  const W = Math.min(viewport ? viewport * 0.94 : 320, 360) - PAD;
  const cell = W / grid;
  const roomy = grid >= 5; // 5-column boards: smaller stars + badges so nothing collides on a phone
  const starSize = Math.min(46, cell * (roomy ? 0.6 : 0.62));
  // A star TAPS across nearly its whole cell (≥ 44 px at 360), however small it is drawn.
  const hit = Math.max(starSize, Math.min(cell - 2, 60));
  const badge = roomy ? 16 : 20;
  const off = PAD_START;
  const pos = (k) => { const [r, c] = k.split(',').map(Number); return { x: off + (c + 0.5) * cell, y: off + (r + 0.5) * cell }; };
  // The "=" tag sits on the star's TOP-LEFT corner ("odd" takes the top-right). On the diagonal it
  // clears the operator badges on all four sides (|dx| and |dy| > badge/2 + tag/2), and the line
  // targets only ever sit to the right of or below a star — so it was bottom-left until the gold
  // "= 37" targets (2026-10-22) moved under the columns' last stars, where it collided.
  const tag = Math.round(badge * 0.75);
  const tagReach = Math.max(starSize / 2, badge / 2 + tag / 2 + 1);
  const tagAt = (k) => { const p = pos(k); return { x: p.x - tagReach, y: p.y - tagReach }; };
  const numberSize = Math.min(20, cell * 0.28); // a star's number (font size)
  return { W, cell, starSize, hit, badge, pos, tag, tagAt, numberSize, size: W + PAD };
}

function LineStrokes({ chart, states, pos, glowLine }) {
  return chart.layout.lines.map((line, li) => {
    const a = pos(line[0]); const b = pos(line[line.length - 1]);
    const { status } = states[li];
    const done = status === 'done';
    const bad = status === 'miss' || status === 'broken';
    const mirror = chart.targets[li] === MIRROR_TARGET;
    // The 73 line is violet in every state, a miss included: rose would hide that it is the 73 line
    // (2b review). Its gold "= 73" target turns rose ✕ instead.
    const color = done ? doneColor(chart.targets[li]) : mirror ? '#c084fc' : bad ? '#fb7185' : '#7dd3fc';
    // Glow = a wide faint line under the real one (an SVG drop-shadow filter is
    // expensive to repaint on Android WebView).
    return (
      <g key={li} data-status={status} data-glow={glowLine === li || undefined}>
        {/* The stuck tip names this line: a wide amber halo under it. */}
        {glowLine === li && <line data-testid="tip-glow" x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke="#fbbf24" strokeOpacity={0.35} strokeWidth={16} strokeLinecap="round" />}
        {(done || mirror) && <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke={color} strokeOpacity={done ? 0.25 : 0.18} strokeWidth={12} strokeLinecap="round" />}
        <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke={color} strokeOpacity={status === 'open' ? (mirror ? 0.6 : 0.35) : 0.85} strokeWidth={done ? 4 : 2.5} />
      </g>
    );
  });
}

/**
 * An "=" tag on the corner of BOTH stars of an equal pair, like the "odd" tag (D3; it replaces the
 * "=" on the link's midpoint). Drawn over the stars, but taps go through to the star.
 */
function PairTags({ chart, tagAt, tag }) {
  return (chart.specials?.binaries || []).flat().map((k) => {
    const p = tagAt(k);
    return (
      <span key={`eq-${k}`} data-testid="pair-tag" data-star={k} aria-hidden="true"
        className="pointer-events-none absolute grid -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-fuchsia-300 bg-[#04030d] font-black leading-none text-fuchsia-200"
        style={{ left: p.x, top: p.y, width: tag, height: tag, fontSize: tag * 0.8 }}>=</span>
    );
  });
}

/** The operator between each two neighbouring stars of a line. */
function OpBadges({ chart, pos, badge }) {
  return chart.layout.lines.map((line, li) => line.slice(0, -1).map((k, j) => {
    const a = pos(k); const b = pos(line[j + 1]);
    return (
      <span key={`${li}-${j}`} data-testid="op-badge" className="absolute grid -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-[#04030d] font-black text-sky-200 border border-sky-300/40"
        style={{ left: (a.x + b.x) / 2, top: (a.y + b.y) / 2, width: badge, height: badge, fontSize: badge * 0.6 }}>
        {DISPLAY[chart.ops[li][j]]}
      </span>
    );
  }));
}

/**
 * The CENTRE of a line's target label: just past its last star — to the right of a row, under a
 * column — so the "=" comes after the sum, the way it is read (David, 2026-10-22).
 */
export function labelAt(line, pos, starSize) {
  const end = pos(line[line.length - 1]); const start = pos(line[0]);
  const row = start.y === end.y;
  const [w, h] = LABEL_SIZE[row ? 'row' : 'column'];
  return row ? { x: end.x + starSize / 2 + 3 + w / 2, y: end.y, row } : { x: end.x, y: end.y + starSize / 2 + 2 + h / 2, row };
}

/** Text colour + glow per line state: gold while open, green when made, rose when it can't be or misses. */
export const TARGET_TONE = Object.freeze({
  open: { color: '#fde047', glow: '0 0 6px #facc15, 0 0 2px #facc15', mark: '' },
  done: { color: '#6ee7b7', glow: '0 0 6px #10b981', mark: ' ✓' },
  miss: { color: '#fda4af', glow: '0 0 6px #f43f5e', mark: ' ✕' },
  broken: { color: '#fda4af', glow: '0 0 6px #f43f5e', mark: ' ✕' },
});

/**
 * Each line ends in its TARGET — a bright, glowing gold "= 37" ("= 73" on Galaxy's 73 line). The
 * text never changes; its colour says the state (green ✓ made, rose ✕ can't be made / misses). What
 * the line adds up to now is in the readout under the board (LineReadout). A column's "=" sits over
 * its number, so it reads downwards like the column.
 */
function LineLabels({ chart, states, pos, starSize }) {
  return chart.layout.lines.map((line, li) => {
    const at = labelAt(line, pos, starSize);
    const target = chart.targets[li];
    const { status } = states[li];
    const tone = TARGET_TONE[status];
    return (
      <span key={`t${li}`} data-testid="line-total" data-state={status} data-mirror={target === MIRROR_TARGET || undefined} data-row={at.row || undefined}
        className={`pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap text-center text-[15px] font-black ${at.row ? 'leading-none' : 'flex flex-col items-center leading-[15px]'}`}
        style={{ left: at.x, top: at.y, color: tone.color, textShadow: tone.glow }}>
        {at.row ? `= ${target}${tone.mark}` : <><span>=</span><span>{`${target}${tone.mark}`}</span></>}
      </span>
    );
  });
}

function Stars({ chart, nodes, all, hinted, pencil, selected, pulse, wrong, glowStar, onTapStar, pos, numberSize, starSize, hit }) {
  const pairStars = new Set((chart.specials?.binaries || []).flat());
  const selectedValue = selected ? all[selected] : null;
  return nodes.map((k) => {
    const p = pos(k);
    const given = chart.givens[k] != null;
    const isHint = hinted[k] != null;
    const value = all[k];
    const marks = pencil[k] || [];
    const sel = selected === k;
    const same = !sel && selectedValue != null && value === selectedValue;
    const bad = wrong.has(k); // 🔎 Check marked it, and it still holds that wrong number
    const tipStar = glowStar === k; // the stuck tip names this star
    const pair = pairStars.has(k); // an "=" pair: both stars wear the same pink ring (no dashed link through other stars)
    return (
      <button key={k} type="button" aria-label={`star ${k}${value ? ` value ${value}` : ''}`} data-wrong={bad || undefined} data-tip={tipStar || undefined} data-pair={pair || undefined} onClick={() => onTapStar(k)}
        className={`absolute grid -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full font-black transition-transform ${sel ? 'scale-110' : ''}`}
        style={{
          left: p.x, top: p.y, width: starSize, height: starSize,
          background: given ? 'radial-gradient(circle at 35% 30%, #fde68a, #b45309)' : isHint ? 'radial-gradient(circle at 35% 30%, #a5f3fc, #0e7490)' : 'radial-gradient(circle at 35% 30%, #1e293b, #020617)',
          // Selected = white (it was pink, the same as the "=" pair marks).
          border: `${bad || tipStar ? 3 : 2}px solid ${sel ? '#ffffff' : bad ? '#fb7185' : tipStar ? '#fbbf24' : same ? '#c4b5fd' : pair ? '#f0abfc' : given ? '#fcd34d' : '#7dd3fc'}`,
          boxShadow: sel ? '0 0 16px #e0f2fe' : bad ? '0 0 12px #f43f5e' : tipStar ? '0 0 14px #f59e0b' : same ? '0 0 12px #a78bfa' : value ? '0 0 10px -2px #7dd3fc' : 'none',
          color: given ? '#1c1917' : '#f8fafc',
          fontSize: numberSize,
        }}>
        {value ?? (marks.length ? <span className="text-[9px] leading-[10px] text-sky-200 font-semibold">{marks.join(' ')}</span> : '')}
        {pulse > 0 && (
          <motion.span key={pulse} aria-hidden="true" className="pointer-events-none absolute inset-0 rounded-full border-2 border-emerald-300"
            initial={{ scale: 1, opacity: 0.9 }} animate={{ scale: 1.9, opacity: 0 }} transition={{ duration: 0.6, delay: nodes.indexOf(k) * 0.03 }} />
        )}
        {/* The whole cell answers a tap: an invisible circle, bigger than the drawn star. */}
        <span data-testid="star-hit" aria-hidden="true" className="absolute rounded-full" style={{ inset: -(hit - starSize) / 2 }} />
        {/* "odd" only where a number is still to be chosen: a gold star's number is given. */}
        {chart.specials?.pulsars?.includes(k) && !given && (
          <span data-testid="pulsar-badge" className="absolute -right-1.5 -top-1.5 rounded-full bg-amber-300 px-1 text-[8px] font-black leading-[12px] text-[#04030d]">odd</span>
        )}
      </button>
    );
  });
}

/**
 * @typedef {object} StarBoardProps
 * @property {ReturnType<typeof import('./generator').generateChart>} chart
 * @property {string[]} nodes  the chart's stars in board order
 * @property {import('./lineState').LineState[]} states  each line's state (lineState.js)
 * @property {Record<string, number>} all  every star's shown number (entries + givens + hints)
 * @property {Record<string, number>} hinted  stars revealed by a hint
 * @property {Record<string, number[]>} pencil  pencil marks
 * @property {string|null} selected  the selected star
 * @property {number} pulse  bumps on the solve: every star rings out
 * @property {Set<string>} [wrong]  stars 🔎 Check marked wrong (a rose ring)
 * @property {number|null} [glowLine]  the line the stuck tip names (an amber halo)
 * @property {string|null} [glowStar]  the star the stuck tip names (an amber ring)
 * @property {(k: string) => void} onTapStar
 */

const NO_WRONG = new Set();

/** @param {StarBoardProps} props @param {React.ForwardedRef<HTMLDivElement>} ref */
function StarBoardView({ chart, nodes, states, all, hinted, pencil, selected, pulse, wrong = NO_WRONG, glowLine = null, glowStar = null, onTapStar }, ref) {
  const { W, starSize, hit, badge, pos, tag, tagAt, numberSize } = geometry(chart.layout.grid);
  return (
    <div className="mt-2 flex justify-center">
      <div className="relative" data-testid="star-board" ref={ref} style={{ width: W + PAD, height: W + PAD }}>
        <svg className="absolute inset-0" width={W + PAD} height={W + PAD} aria-hidden="true">
          <LineStrokes chart={chart} states={states} pos={pos} glowLine={glowLine} />
        </svg>
        <OpBadges chart={chart} pos={pos} badge={badge} />
        <LineLabels chart={chart} states={states} pos={pos} starSize={starSize} />
        <Stars chart={chart} nodes={nodes} all={all} hinted={hinted} pencil={pencil} selected={selected} pulse={pulse} wrong={wrong} glowStar={glowStar} hit={hit}
          onTapStar={onTapStar} pos={pos} numberSize={numberSize} starSize={starSize} />
        <PairTags chart={chart} tagAt={tagAt} tag={tag} />
      </div>
    </div>
  );
}

/** The board element is forwarded: the mode aims its line / win effects at it. */
const StarBoard = forwardRef(StarBoardView);
export default StarBoard;
