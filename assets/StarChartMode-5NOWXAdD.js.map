import React from 'react';
import { DailyChip, PracticeChip } from '../coach';
import { LAYOUTS, LAYOUT_ORDER } from './generator';
import { TUTORIAL_LAYOUT } from './tutorial';
import { DAILY_TAB } from './daily';

// The row under Star Chart's header (redesign 2026-10-22, PROPOSAL §3A): the DAILY or PRACTICE chip
// (coach kit, the same spot in every Sector 73 game), then the practice sizes with a plain difficulty
// tag. How the game was opened decides what else shows:
//   entry 'daily'    → on the Daily: the chip alone (no tabs). Left for practice: the sizes.
//   entry 'practice' → the sizes, never a Daily button.
//   no entry (older callers) → today's row: 📅 Daily plus the sizes.

/** The practice sizes, easiest first, with the tag each chip wears. */
export const SIZE_TAGS = Object.freeze({ trio: 'EASY', hash: 'MEDIUM', galaxy: 'HARD' });
export const PRACTICE_SIZES = Object.freeze(LAYOUT_ORDER.filter((id) => id !== TUTORIAL_LAYOUT));

/**
 * @param {{
 *   entry: 'daily' | 'practice' | null,
 *   tab: string,                 // DAILY_TAB or a layout id
 *   dailyDate: string,           // the open Daily's Eastern date key
 *   inTutorial: boolean,
 *   onSwitch: (tab: string) => void,
 * }} props
 */
export default function ModeBar({ entry, tab, dailyDate, inTutorial, onSwitch }) {
  const isDaily = tab === DAILY_TAB;
  const showSizes = !(entry === 'daily' && isDaily);
  const showDailyTab = entry === null;
  const pill = (active) => `whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-bold leading-tight ${active ? 'bg-sky-400 text-[#04030d]' : 'border border-sky-300/40 text-sky-200'}`;
  return (
    <div data-testid="sc-mode-bar" className="mt-2 flex flex-wrap items-center justify-center gap-1.5 px-3">
      {isDaily ? <DailyChip date={dailyDate} /> : <PracticeChip />}
      {inTutorial && <span data-testid="sc-tutorial-pill" className="whitespace-nowrap rounded-full bg-sky-400 px-2 py-1 text-xs font-bold text-[#04030d]">Tutorial</span>}
      {showDailyTab && (
        <button type="button" data-testid={`sc-tab-${DAILY_TAB}`} onClick={() => onSwitch(DAILY_TAB)} className={pill(isDaily)}>📅 Daily</button>
      )}
      {showSizes && PRACTICE_SIZES.map((id) => (
        <button key={id} type="button" data-testid={`sc-tab-${id}`} onClick={() => onSwitch(id)} className={`${pill(id === tab)} flex flex-col items-center`}>
          <span>{LAYOUTS[id].name}</span>
          <span data-testid={`sc-size-tag-${id}`} className={`text-[9px] font-black tracking-wider ${id === tab ? 'text-sky-900' : 'text-slate-400'}`}>{SIZE_TAGS[id]}</span>
        </button>
      ))}
    </div>
  );
}
