import React, { useEffect, useMemo, useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { ModeHeader, PrimaryButton, ShareButton } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { useFx, runTimeline } from '../../fx';

// "Constellation Ignites" (sweep SW14c; storyboard juice.md §3.3). Mid-play, each line that
// reaches its target ignites (ring + shimmer, pitch climbing with every completed line). On the
// solve: a short hold, the lines ignite one after another, the stars pulse, then the win cue.
export const IGNITE_STAGGER_MS = 180;
export const IGNITE_HOLD_MS = 120;

/** Lines that just reached their target (indices), comparing before → now. */
export function newlyDoneLines(prevTotals, totals, targets) {
  return totals.map((v, li) => (v === targets[li] && prevTotals[li] !== targets[li] ? li : -1)).filter((li) => li >= 0);
}
import { playSynth } from '../../synth';
import { incrementBest } from '../bests';
import { randomSeed, todayEastern } from '../rng';
import { generateChart, lineValues, layoutNodes, meetsSpecials, LAYOUTS } from './generator';
import {
  TUTORIAL_LAYOUT, FIRST_REAL_LAYOUT, TUTORIAL_STEPS, TUTORIAL_CHART, TUTORIAL_SEED, tutorialStepIndex, isTutorialDone, setTutorialDone,
} from './tutorial';
import {
  emptyBoard, enterValue, togglePencil, erase as eraseStar, undo, check, revealHint, boardScore,
  saveBoard, loadBoard, clearBoard, MAX_HINTS, PENALTY_SECONDS, hintTarget, wrongStars,
} from './boardState';
import ChartBriefing from './ChartBriefing';
import ModeBar from './ModeBar';
import StarBoard from './StarBoard';
import LineReadout from './LineReadout';
import ChartControls, { checkVerdict } from './ChartControls';
import { lineStates, lineName, progressLine } from './lineState';
import { stuckTip } from './tips';
import { useStuckTimer } from '../coach';
import { parFor, parRating, clock, bountyFor, bountyById, bountyMet, BOUNTY_STARS, ruledOut, MEDAL, MEDAL_NAME, doneColor, chartShareText, helpText } from './chartInfo';
import { earnStars, useStarBalance } from '../stars';
import { startDaily, finishDaily } from '../dailyRuns';
import { beforeDailyAttempt } from '../dailyAd';
import DailyBoard, { DailyPlace, PLACE_LINES } from '../DailyBoard';
import {
  DAILY_TAB, dailyLayout, openDaily, dailyScore, readDailyRun, writeDailyRun, dailyDone, dailySeed, dailyDateOf, openingDailyDate,
} from './daily';

/** Nothing done on this chart yet (no move, no time, no penalty) — the briefing shows. */
const isFresh = (b) => b.elapsed === 0 && !Object.keys(b.entries).length && !Object.keys(b.pencil).length && b.hints + b.checks === 0;

// Star Chart — every constellation line must equal 37. Rules: ./generator.js.
// Board behaviour (undo, Check, saves): ./boardState.js. Design: Star Chart APPROVED 2026-10-04.

/** Open a tab's chart: the Daily (./daily.js), or a practice layout's saved / fresh chart. */
function openChart(tab, today) {
  if (tab === DAILY_TAB) return openDaily(today);
  if (tab === TUTORIAL_LAYOUT) { // one hand-made chart (./tutorial.js); an older random tutorial save is ignored
    const saved = loadBoard(tab);
    return saved?.seed === TUTORIAL_SEED ? saved : { seed: TUTORIAL_SEED, board: emptyBoard() };
  }
  const saved = loadBoard(tab);
  if (saved) return { seed: saved.seed, board: saved.board };
  return { seed: `star-chart-${randomSeed()}`, board: emptyBoard() };
}

/**
 * This mode reads `params.entry` (redesign 2026-10-22, framework §D): the world shows Star Chart's
 * Daily object and Practice object once a game says so.
 */
export const ACCEPTS_ENTRY = true;

/** 'daily' | 'practice' from the launch params; anything else (older callers) → null. */
export const entryOf = (params) => (params?.entry === 'daily' || params?.entry === 'practice' ? params.entry : null);

/**
 * The tab a visit opens on. Daily object → the Daily (its briefing or its done card). Practice object →
 * the coached tutorial until it is done, then Trident, never the Daily. No entry (older callers) → as
 * before: tutorial, else today's Daily until it is done, else Trident.
 */
export function startTabFor(entry, { tutorialDone, dailyIsDone }) {
  if (entry === 'daily') return DAILY_TAB;
  if (!tutorialDone) return TUTORIAL_LAYOUT;
  if (entry === 'practice') return FIRST_REAL_LAYOUT;
  return dailyIsDone ? FIRST_REAL_LAYOUT : DAILY_TAB;
}

export default function StarChartMode({ onExit, onReturnTo37, user = undefined, params = null }) {
  const entry = entryOf(params);
  // MIDNIGHT-SAFE (audit 2026-10-18): the Daily is pinned to its date + seed where it goes live —
  // START, resuming a started Daily at mount, and switching to the Daily tab with a started run —
  // so a chart solved after midnight still saves and posts as its own day, and tomorrow's Daily stays
  // open. Before START the briefing's seed says which day it was dealt for; practice never pins.
  const [opening] = useState(() => { const date = openingDailyDate(todayEastern()); return { date, run: readDailyRun(date) }; });
  const [dailyRun, setDailyRun] = useState(opening.run); // the open Daily's attempt on this phone
  // Which tab opens: how the game was launched (startTabFor), the tutorial, and today's Daily.
  const [startTab] = useState(() => startTabFor(entry, { tutorialDone: isTutorialDone(), dailyIsDone: dailyDone(opening.run, opening.date) }));
  const [tab, setTab] = useState(startTab); // DAILY_TAB or a layout id (each tab has its own save)
  const isDaily = tab === DAILY_TAB;
  const [{ seed, board: initialBoard }, setOpened] = useState(() => openChart(startTab, opening.date));
  const [pin, setPin] = useState(() => (startTab === DAILY_TAB && opening.run?.status === 'started' ? { date: opening.date, seed } : null));
  // The Daily's day: the pin, else the day its briefing was dealt for (never re-read from the clock
  // mid-chart: at midnight that swapped the layout under the player).
  const dailyDate = pin?.date ?? dailyDateOf(seed) ?? todayEastern();
  const layoutId = isDaily ? dailyLayout(dailyDate) : tab;
  const inTutorial = layoutId === TUTORIAL_LAYOUT;
  const [recorded, setRecorded] = useState(0); // bumps when the server has today's result (board refresh)
  // How this visit's Daily result went (the other games' opt-in place states). null = nothing back yet,
  // which the place line reads as 'pending' ("Sending…").
  const [sent, setSent] = useState(/** @type {'pending'|'posted'|'queued'|'dropped'|null} */ (null));
  const [boardOpen, setBoardOpen] = useState(false);
  // The open Daily can no longer be played here (./daily.js dailyDone). Checked on opening the tab,
  // so the solve screen stays up until you leave it.
  const [dailyClosed, setDailyClosed] = useState(() => dailyDone(opening.run, opening.date));
  const dailyOver = isDaily && dailyClosed;
  const chart = useMemo(() => (layoutId === TUTORIAL_LAYOUT ? TUTORIAL_CHART : generateChart(layoutId, seed)), [layoutId, seed]);
  const { nodes } = useMemo(() => layoutNodes(chart.layout), [chart]);

  const [board, setBoard] = useState(initialBoard);
  const [pencilMode, setPencilMode] = useState(false);
  const [selected, setSelected] = useState(null);
  // A Daily resumed after START keeps its clock running (START was pressed; no second briefing).
  const [started, setStarted] = useState(() => initialBoard.elapsed > 0 || Boolean(pin));
  const [solved, setSolved] = useState(false);
  const [briefedSeed, setBriefedSeed] = useState(null); // the chart whose briefing was dismissed
  const [result, setResult] = useState(null); // { score, rating, bountyOk, stars } at the solve
  const par = parFor(layoutId);
  const bountyId = useMemo(() => bountyFor(seed), [seed]);
  const bountyInfo = inTutorial ? null : bountyById(bountyId);

  const all = { ...board.entries, ...chart.givens, ...board.hinted };
  const totals = lineValues(chart.layout, chart.ops, all);
  const states = lineStates(chart, all); // per line: open / done / miss / broken (./lineState.js)

  const fx = useFx();
  const starBalance = useStarBalance();
  const boardRef = useRef(null);
  const [pulse, setPulse] = useState(0); // bumps once on the solve: every star rings out
  const lineEl = (li) => boardRef.current?.querySelectorAll('[data-testid="line-total"]')[li] || boardRef;

  // The coach line's good news ("✓ Row 2 makes 37."): set when a line is made, gone on the next move.
  const [goodNews, setGoodNews] = useState(/** @type {string | null} */ (null));
  useEffect(() => { setGoodNews(null); }, [board.entries, board.hinted]);

  // Mid-play reward: a line that reaches its target ignites; pitch climbs with each one.
  const prevTotals = useRef({ chartKey: '', totals: [] });
  useEffect(() => {
    const chartKey = `${layoutId}|${seed}`;
    const prev = prevTotals.current;
    prevTotals.current = { chartKey, totals };
    if (prev.chartKey !== chartKey) return; // a different chart: nothing "just" happened
    const fresh = newlyDoneLines(prev.totals, totals, chart.targets);
    const doneCount = totals.filter((v, li) => v === chart.targets[li]).length;
    if (!fresh.length || doneCount === totals.length) return; // the finale handles the last line
    const last = fresh[fresh.length - 1];
    setGoodNews(`${lineName(chart, last)} makes ${chart.targets[last]}.`);
    fresh.forEach((li) => fx.cue('lineDone', { at: lineEl(li), color: doneColor(chart.targets[li]), pitch: doneCount * 2 }));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [totals.join(','), layoutId, seed]);

  // Save the chart in progress when a move changes it (each tab has its own save — the Daily's
  // never overwrites a practice tab's). The clock ticking is saved every 10 s, on going to the
  // background and on leaving — it used to write to storage every second (overnight audit 2026-10-11).
  // A Daily that is over is never saved (a fresh save would make it look resumable).
  const live = useRef({ board, tab, seed, solved, over: dailyOver, run: dailyRun });
  live.current = { board, tab, seed, solved, over: dailyOver, run: dailyRun };
  const saveLive = () => { const l = live.current; if (!l.solved && !l.over) saveBoard(l.tab, l.seed, l.board); };
  useEffect(() => {
    if (!solved && !dailyOver) saveBoard(tab, seed, board);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [board.entries, board.pencil, board.hinted, board.hints, board.checks, tab, seed, solved, dailyOver]);
  useEffect(() => {
    if (board.elapsed > 0 && board.elapsed % 10 === 0) saveLive();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [board.elapsed]);
  useEffect(() => {
    const onHide = () => { if (typeof document !== 'undefined' && document.hidden) saveLive(); };
    document.addEventListener?.('visibilitychange', onHide);
    return () => { document.removeEventListener?.('visibilitychange', onHide); saveLive(); };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Clock: starts on the first tap; pauses while the app is in the background.
  useEffect(() => {
    if (solved || !started) return undefined;
    const id = setInterval(() => {
      if (typeof document !== 'undefined' && document.hidden) return;
      setBoard((b) => ({ ...b, elapsed: b.elapsed + 1 }));
    }, 1000);
    return () => clearInterval(id);
  }, [solved, started]);

  useEffect(() => {
    if (!solved && nodes.every((k) => all[k] != null) && totals.every((v, li) => v === chart.targets[li]) && meetsSpecials(chart.specials, all)) {
      setSolved(true);
      // The finale: hold, ignite every line in turn (rising), pulse the stars, then the win cue.
      const lines = chart.layout.lines.map((_, li) => li);
      runTimeline([
        ...lines.map((li, i) => ({
          at: IGNITE_HOLD_MS + i * IGNITE_STAGGER_MS,
          run: () => { fx.burst(lineEl(li), { preset: 'ring', color: doneColor(chart.targets[li]) }); playSynth('ignite', { pitch: i * 2 }); },
        })),
        { at: IGNITE_HOLD_MS + lines.length * IGNITE_STAGGER_MS, run: () => setPulse((n) => n + 1) },
        { at: IGNITE_HOLD_MS + lines.length * IGNITE_STAGGER_MS + 250, run: () => fx.cue('modeWin', { at: boardRef, color: '#7dd3fc' }) },
      ]);
      if (inTutorial) setTutorialDone(true); // the coached chart does not count as a solve
      else {
        incrementBest('starChart');
        const score = boardScore(board);
        const bountyOk = bountyMet(bountyId, { board, score, par });
        // A met bounty pays once per chart — practice charts and the Daily alike.
        if (bountyOk) earnStars('sc_bounty', seed); // paid by the server (★ on the account, max 3 a day)
        setResult({ score, rating: parRating(layoutId, score), bountyOk, stars: bountyOk ? BOUNTY_STARS : null });
        if (isDaily) { // the Daily: recorded once, on the phone and on the board — as its pinned day
          const daily = dailyScore(board);
          const run = { date: dailyDate, status: 'solved', score: daily };
          writeDailyRun(run); setDailyRun(run);
          finishDaily('starChart', daily).then((how) => { setSent(how); setRecorded((n) => n + 1); });
        }
      }
      clearBoard(tab);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [board.entries, board.hinted]);

  /** Open `date`'s Daily on the Daily tab (fresh, resumed — and then pinned — or its done card). */
  const openDailyDay = (date) => {
    const run = readDailyRun(date);
    const next = openDaily(date);
    const resumes = run?.status === 'started';
    setDailyRun(run);
    setDailyClosed(dailyDone(run, date));
    setPin(resumes ? { date, seed: next.seed } : null);
    setOpened(next);
    setBoard(next.board);
    setStarted(next.board.elapsed > 0 || resumes);
    setSelected(null);
    setSolved(false);
    setResult(null);
    setSent(null);
  };
  // `skipBrief`: open the chart ready to play, no briefing (the Daily's "Not now" — one card is enough).
  const switchLayout = (id, { skipBrief = false } = {}) => {
    if (id === tab) return;
    saveLive(); // keep the clock of the chart you're leaving (it is otherwise saved every 10 s)
    setTab(id);
    // Back to the Daily tab: a Daily started before midnight and still unfinished reopens as its own
    // day; a finished one from yesterday never hides today's (./daily.js openingDailyDate).
    if (id === DAILY_TAB) { openDailyDay(openingDailyDate(todayEastern())); return; }
    const next = openChart(id, todayEastern());
    if (skipBrief) setBriefedSeed(next.seed);
    setOpened(next);
    setBoard(next.board);
    setStarted(next.board.elapsed > 0);
    setSelected(null);
    setSolved(false);
    setResult(null);
    setSent(null);
  };

  // START on the briefing. Practice: the clock starts, nothing else. The Daily: its ad first, then
  // the clock, and the attempt is claimed on the server — one per ACCOUNT, so another phone or
  // cleared app data cannot chart it again. Offline, the phone's own record still applies.
  const adSpent = useRef(false);
  const begin = () => {
    if (!isDaily) { setBriefedSeed(seed); setStarted(true); return; } // practice: no ad
    // START re-reads the date: a briefing left open across midnight opens the NEW day's Daily
    // instead of starting (and claiming) yesterday's.
    if (seed !== dailySeed(todayEastern())) { openDailyDay(todayEastern()); return; }
    // An ad already watched for a START that midnight called off counts for the next START (one ad
    // per attempt — contrarian SC-1 #3).
    const withAd = adSpent.current ? (go) => { adSpent.current = false; go(); } : beforeDailyAttempt;
    withAd(() => {
      const date = todayEastern(); // midnight can pass while the ad is up
      if (seed !== dailySeed(date)) { adSpent.current = true; openDailyDay(date); return; }
      setPin({ date, seed });
      setBriefedSeed(seed); setStarted(true);
      const run = { date, status: 'started' }; writeDailyRun(run); setDailyRun(run);
      startDaily('starChart').then((claim) => {
        if (!claim?.used) return;
        // Already solved here before the answer came back: this phone's result stands (contrarian
        // FC-1 #1 — a late "used" must not wipe a finished Daily).
        if (live.current.run?.date === date && live.current.run.status === 'solved') return;
        const used = { date, status: 'elsewhere' }; writeDailyRun(used); setDailyRun(used);
        clearBoard(DAILY_TAB);
        setDailyClosed(true); // called off: the Daily tab now says why
        if (live.current.tab === DAILY_TAB) setStarted(false); // (a practice tab's clock keeps going)
      });
    });
  };
  const newChart = () => {
    const next = { seed: `star-chart-${randomSeed()}`, board: emptyBoard() };
    setOpened(next);
    setBoard(next.board);
    setStarted(false);
    setSelected(null);
    setSolved(false);
    setResult(null);
    setSent(null);
  };

  const fixed = (k) => chart.givens[k] != null || board.hinted[k] != null;
  // Only a move that changes the board starts the clock (audit 2026-10-11: an Undo or Erase
  // with nothing to undo, or a Check on an empty board, started it).
  const act = (fn) => {
    const next = fn(board);
    if (next === board) return;
    setStarted(true);
    setBoard(next);
  };

  const tapStar = (k) => {
    playSynth('blip');
    setSelected((s) => (s === k ? null : k)); // tap again to deselect
  };
  const enter = (v) => {
    if (!selected || fixed(selected) || solved) return;
    playSynth('blip');
    act((b) => (pencilMode ? togglePencil(b, selected, v) : enterValue(b, selected, v)));
  };
  const erase = () => { if (selected && !fixed(selected)) act((b) => eraseStar(b, selected)); };
  const onUndo = () => act(undo);
  // The two power-ups (slice 3), used from their card: 💡 Hint reveals the PICKED star; 🔎 Check
  // marks every wrong star, once per chart. Both add +37 s (boardState.js).
  const onPowerUp = (id) => {
    if (solved) return;
    if (id === 'check') { playSynth('dock'); act((b) => check(b, chart.solution)); return; }
    const k = hintTarget(fixed, selected);
    if (!k || board.hints >= MAX_HINTS) return;
    playSynth('dock');
    act((b) => revealHint(b, k, chart.solution[k]));
  };
  const verdict = checkVerdict(board.lastCheck);

  const score = boardScore(board);
  const blocked = selected && !fixed(selected) ? ruledOut(selected, chart.specials, all) : new Set(); // a fixed star takes no number
  const penalty = PENALTY_SECONDS * (board.hints + board.checks);
  // A Daily already started (resumed here) never shows its briefing again — START was its one go.
  // "Not now" (D6): on the Daily it goes to practice — Trident, or back to the tutorial if that isn't
  // finished — and the attempt stays unused; Trident opens ready, without a second briefing; on a practice chart it just closes the card (the clock
  // still waits for the first move).
  const leave = isDaily
    ? { text: isTutorialDone() ? `Not now — practice ${LAYOUTS[FIRST_REAL_LAYOUT].name}` : 'Not now — back to the tutorial',
      go: () => switchLayout(isTutorialDone() ? FIRST_REAL_LAYOUT : TUTORIAL_LAYOUT, { skipBrief: true }) }
    : { text: 'Not now — look at the chart', go: () => setBriefedSeed(seed) };
  const showBriefing = !inTutorial && !solved && !dailyOver && !(isDaily && dailyRun?.status === 'started')
    && briefedSeed !== seed && isFresh(board);

  // The stuck tip (slice 4, ./tips.js): after 30 s without progress, or 2 moves in a row that each
  // break another line. Practice gets a second, sharper tip if still stuck 30 s later; the Daily
  // never names a number. The tutorial coaches by itself.
  const progressKey = `${seed}|${JSON.stringify([board.entries, board.pencil, board.hinted])}`;
  const badLines = states.filter((s) => s.status === 'miss' || s.status === 'broken').length;
  const [refusals, setRefusals] = useState(0);
  const prevBad = useRef({ seed, bad: badLines });
  useEffect(() => {
    const prev = prevBad.current;
    setRefusals((r) => (prev.seed === seed && badLines > prev.bad ? r + 1 : 0));
    prevBad.current = { seed, bad: badLines };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [progressKey]);
  const stuckOn = started && !solved && !dailyOver && !showBriefing && !inTutorial;
  const stuck = useStuckTimer({ progressKey, refusals, active: stuckOn });
  const stuckAgain = useStuckTimer({ progressKey: `${progressKey}|again`, active: stuck.stuck && !isDaily });
  const tip = stuck.stuck ? stuckTip(chart, all, { daily: isDaily, level: stuckAgain.stuck ? 2 : 1 }) : null;
  const screenRef = useRef(/** @type {HTMLDivElement | null} */ (null));
  useEffect(() => { if (showBriefing && screenRef.current) screenRef.current.scrollTop = 0; }, [showBriefing, seed]);
  const tutStep = inTutorial ? TUTORIAL_STEPS[tutorialStepIndex(states[0].status === 'done')] : null;
  const glowLine = tutStep ? tutStep.line : tip?.line ?? null;
  // Why your place might not show (as Hyperjump / Re-Entry). `user` undefined = not passed (tests).
  const placeStatus = user === null ? 'signedOut' : user?.is_anonymous ? 'guest' : sent ?? 'pending';
  // A Daily solved on an earlier visit: its saved score, medal and share (no star values in it).
  const doneScore = dailyRun?.status === 'solved' ? dailyRun.score : null;
  const doneRating = doneScore ? parRating(layoutId, doneScore.seconds) : null;
  const shareFor = (s, rating, hints, checks) => () => chartShareText({
    daily: isDaily, date: dailyDate, layoutName: chart.layout.name, score: s, rating, hints, checks,
  });

  return (
    // While a briefing is up the screen does not scroll, and sits at the top: the card covers only the
    // visible part, and on a short phone the board's bottom row could be scrolled out from under it and
    // played — a Daily move without START, so without its ad or its claim (contrarian #28, 2026-10-22).
    <div ref={screenRef} data-testid="sc-screen" className={`relative isolate flex h-full flex-col pb-6 ${showBriefing ? 'overflow-hidden' : 'overflow-y-auto'}`} style={{ background: 'radial-gradient(ellipse at top, #0c2a4a 0%, #04030d 70%)' }}>
      <ModeBackdrop theme="starChart" />
      <ModeHeader title="Star Chart" subtitle={isDaily ? `Daily · ${dailyDate.slice(5)} · ${chart.layout.name}` : inTutorial ? 'Tutorial' : chart.layout.name} onExit={onExit} onReturnTo37={onReturnTo37} />

      {/* DAILY / PRACTICE chip + the practice sizes; what shows depends on how the game was opened. */}
      <ModeBar entry={entry} tab={tab} dailyDate={dailyDate} inTutorial={inTutorial} onSwitch={switchLayout} />
      {dailyOver ? (
        // Today's Daily is done: its result and the board instead of a playable chart.
        <div data-testid="sc-daily-done" className="mx-4 mt-6 space-y-3 rounded-2xl border border-sky-300/40 bg-[#06111f]/95 p-4 text-center text-white">
          <div className="text-lg font-black">✨ Today&apos;s Daily is done</div>
          <p data-testid="sc-daily-result" className="text-sm text-slate-300">
            {doneScore ? `Your chart: ${MEDAL[doneRating]} ${clock(doneScore.seconds)} · ${helpText(doneScore.hints, doneScore.checks)}.`
              : dailyRun?.status === 'elsewhere' ? 'Today’s Daily was already played on your account.'
                : 'Today’s attempt was used (you left mid-chart).'} A new chart arrives tomorrow.
          </p>
          {/* Signed out / guest: why you are not on the board (the same lines as the results screen). */}
          {doneScore && (placeStatus === 'signedOut' || placeStatus === 'guest') && (
            <p data-testid="sc-daily-done-place" className="text-xs text-slate-400">{PLACE_LINES[placeStatus]}</p>
          )}
          <div className="flex flex-wrap justify-center gap-2">
            {doneScore && <ShareButton text={shareFor(doneScore.seconds, doneRating, doneScore.hints ?? 0, doneScore.checks ?? 0)} label="Share chart" />}
            <button type="button" data-testid="sc-daily-board" onClick={() => setBoardOpen(true)} className="rounded-xl border border-amber-300/50 px-4 py-2.5 text-sm font-bold text-amber-100">🏆 Today&apos;s board</button>
            <button type="button" data-testid="sc-daily-practice" onClick={() => switchLayout(layoutId)} className="rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-black text-white">Practice instead</button>
          </div>
        </div>
      ) : (<>
      {/* Two lines reserved and the legend always present, so the board never shifts when the */}
      {/* penalty note appears or a chart has no special stars (audit 2026-10-11). */}
      {/* Two lines (D4): the rules, then the time. Each "·" chunk never breaks inside; on a narrow */}
      {/* screen or a large font the line wraps BETWEEN chunks instead of overflowing sideways. */}
      {/* Time is m:ss — the clock alone; help used shows beside it as "+37s help" (a cost, not a time). */}
      {/* The results add them up. (It showed the total AND "(+37s)": the penalty twice — slice 6.) */}
      <div data-testid="sc-rules" className="mt-1 flex min-h-[32px] flex-col items-center justify-center px-3 text-center text-[11px] leading-4 text-slate-400">
        <span data-testid="sc-rules-line" className="max-w-full">
          {/* Each line's own target glows at its end ("= 37" / "= 73"), so the strip no longer repeats it. */}
          <span className="sc-chunk whitespace-nowrap">stars 1–6</span>
          {' · '}<span className="sc-chunk whitespace-nowrap text-sky-200">× first, then + −</span>
          {' · '}<span className="sc-chunk whitespace-nowrap">read towards the =</span>
        </span>
        <span data-testid="sc-time" className="max-w-full">
          <span className="sc-chunk whitespace-nowrap">⏱ {clock(board.elapsed)}{penalty ? <span data-testid="sc-time-help" className="text-rose-200">{` +${penalty}s help`}</span> : null}</span>
          {!inTutorial ? <span className="text-slate-500">{' · '}<span className="sc-chunk whitespace-nowrap">par {clock(par)}</span></span> : null}
        </span>
      </div>

      {(chart.specials?.pulsars?.length || chart.specials?.binaries?.length) ? (
        <div className="mt-1 min-h-[15px] text-center text-[10px] text-slate-400" data-testid="sc-specials-legend">
          {chart.specials?.pulsars?.length ? <span className="mr-2"><b className="text-amber-200">odd</b> star: an odd number</span> : null}
          {/* The same "=" tag the pair stars wear (D3). */}
          {chart.specials?.binaries?.length ? <span><b data-testid="sc-legend-pair-tag" className="inline-grid h-3 w-3 place-items-center rounded-full border border-fuchsia-300 align-[-1px] text-[9px] leading-none text-fuchsia-200">=</b> pink pair: equal numbers</span> : null}
        </div>
      ) : <div className="mt-1 min-h-[15px]" aria-hidden="true" />}
      {/* The tutorial's coach card (./tutorial.js): the row, then — once the row makes 37 — the column. */}
      {/* Its line glows on the board. No "Next" buttons: doing the step moves it on. */}
      {inTutorial && !solved && tutStep && (
        <motion.div key={tutStep.id} initial={{ opacity: 0, y: -6 }} animate={{ opacity: 1, y: 0 }} data-testid="sc-coach" data-step={tutStep.id}
          className="mx-3 mt-2 flex min-h-[56px] items-center gap-2 rounded-xl border border-amber-300/60 bg-sky-950/60 px-3 py-2 text-sm font-semibold text-sky-50">
          <span className="flex-1">{tutStep.text}</span>
        </motion.div>
      )}
      {/* The tutorial is a practice thing: never offered on the Daily screen. */}
      {!inTutorial && !isDaily && (
        <div className="mt-1 text-center">
          <button type="button" data-testid="sc-replay-tutorial" onClick={() => switchLayout(TUTORIAL_LAYOUT)} className="text-[11px] text-sky-300/80 underline">How to play</button>
        </div>
      )}
      <StarBoard ref={boardRef} chart={chart} nodes={nodes} states={states} all={all} hinted={board.hinted} pencil={board.pencil}
        selected={selected} pulse={pulse} wrong={wrongStars(board)} glowLine={solved ? null : glowLine} glowStar={tip?.star ?? null} onTapStar={tapStar} />
      {/* The picked star's lines as live sums (slice 2); gone once the chart is solved. */}
      {!solved && <LineReadout chart={chart} states={states} selected={selected} givens={chart.givens} />}
      </>)}

      {dailyOver ? null : solved ? (
        <motion.div initial={{ scale: 0.9, opacity: 0 }} animate={{ scale: 1, opacity: 1 }} className="mt-4 space-y-3 px-4 text-center">
          <div className="text-2xl font-black text-emerald-300">{inTutorial ? 'Tutorial complete! ✨' : 'Constellation charted! ✨'}</div>
          {/* The medal and the time lead (D7); the penalty is said as "+37s", as on the play screen. */}
          {result ? (<>
            <div data-testid="sc-rating" className="text-3xl font-black text-white">
              {MEDAL[result.rating]} {MEDAL_NAME[result.rating]} · <span data-testid="sc-result-time">{clock(result.score)}</span>
            </div>
            <div data-testid="sc-result-detail" className="text-sm text-slate-300">
              {helpText(board.hints, board.checks)}{penalty ? ` (+${penalty}s)` : ''} · par {clock(par)}
            </div>
          </>) : (
            <div className="text-slate-300">{clock(score)} · {helpText(board.hints, board.checks)}</div>
          )}
          {result && (
            <div data-testid="sc-chips" className="flex flex-wrap justify-center gap-1.5 text-xs font-bold">
              {/* Signed out, no ★ reaches an account: the chip doesn't promise one (as Re-Entry / First Contact). */}
              {bountyInfo && (
                <span data-testid="sc-chip-bounty" className={`rounded-full border px-2 py-0.5 ${result.bountyOk ? 'border-amber-300/70 text-amber-200' : 'border-slate-600 text-slate-500 line-through'}`}>
                  {bountyInfo.icon} Bonus{result.bountyOk && user !== null ? ` +${BOUNTY_STARS}★` : ''}
                </span>
              )}
              <span data-testid="sc-chip-stars" className="rounded-full border border-amber-300/40 px-2 py-0.5 text-amber-100">★ {starBalance} total</span>
            </div>
          )}
          {/* Every finisher passes here, even one who never tapped "Next" — so the Check / Hint card */}
          {/* (the play screen's footer no longer explains them) is said once more (review sc-4 M1). */}
          {inTutorial && <p data-testid="sc-tut-help" className="text-xs text-sky-100">{TUTORIAL_STEPS.find((st) => st.id === 'help').text}</p>}
          {isDaily && <DailyPlace game="starChart" recorded={recorded} day={dailyDate} status={placeStatus} />}
          {inTutorial
            ? <PrimaryButton tone="cyan" testId="sc-to-real" onClick={() => switchLayout(FIRST_REAL_LAYOUT)}>REAL SKIES: {LAYOUTS[FIRST_REAL_LAYOUT].name.toUpperCase()} ▶</PrimaryButton>
            : (
              // As the other games: Share, then the next chart. The Daily is one chart a day, so after
              // it you practise the same layout; a practice chart deals a new one.
              <div className="flex flex-wrap justify-center gap-2 pt-1">
                {result && <ShareButton text={shareFor(result.score, result.rating, board.hints, board.checks)} label="Share chart" />}
                {isDaily
                  ? <button type="button" data-testid="sc-daily-to-practice" onClick={() => switchLayout(layoutId)} className="rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-black text-white active:scale-95">Practice {LAYOUTS[layoutId].name}</button>
                  : <button type="button" data-testid="sc-new-chart" onClick={newChart} className="rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-black text-white active:scale-95">New chart</button>}
              </div>
            )}
        </motion.div>
      ) : (
        <div>
          {/* The message slot, the tray (tools | 💡 Hint, 🔎 Check) and the dice (./ChartControls.jsx). */}
          <ChartControls board={board} selected={selected} isFixed={fixed} pencilMode={pencilMode}
            onPencil={() => setPencilMode((p) => !p)} onErase={erase} onUndo={onUndo} onPowerUp={onPowerUp} onDie={enter} ruledOut={blocked}
            onDismissTip={stuck.dismiss}
            messages={{
              refusal: verdict.refusal,
              tip: tip?.text ?? null,
              good: verdict.good ?? goodNews,
              coach: progressLine(states, nodes.filter((k) => all[k] == null).length, Object.keys(board.entries).length + Object.keys(board.hinted).length),
            }} />
          {/* The bounty sits under the dice: the S21's ad banner covers the very bottom. */}
          {bountyInfo && (
            <p data-testid="sc-bounty-line" className="mt-2 px-3 text-center text-[11px] text-amber-200/90">{bountyInfo.icon} Bonus: {bountyInfo.text} · +{BOUNTY_STARS}★</p>
          )}
        </div>
      )}
      {showBriefing && (
        <ChartBriefing name={chart.layout.name} lines={chart.layout.lines.length} targets={chart.targets} specials={chart.specials}
          par={par} bounty={bountyInfo} daily={isDaily} onStart={begin} onLeave={leave.go} leaveText={leave.text} />
      )}
      {boardOpen && <DailyBoard game="starChart" day={isDaily ? dailyDate : null} onClose={() => setBoardOpen(false)} />}
    </div>
  );
}
