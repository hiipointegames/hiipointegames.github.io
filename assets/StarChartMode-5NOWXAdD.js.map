// Star Chart — the endless puzzle generator (David: "endless generator", "not
// too easy"). Kakuro-style: constellation LINES run through STARS; each line's
// operators are printed; every line must equal 37; a star where lines cross
// counts for each. Stars take any value 1–6.
//
// Guarantee: every generated chart has EXACTLY ONE solution. Method:
//   1. pick operators per line, at random
//   2. list every value tuple that makes each line 37 (≤ 6^5 per line)
//   3. forward-checking backtracking to find a random full solution
//   4. reveal "given" stars until the solution is unique (count stops at 2)
//   5. greedily remove any given the uniqueness does not need → the hardest
//      chart that is still unique.

import { makeRng, shuffle } from '../rng';

export const TARGET = 37;
export const MIRROR_TARGET = 73;

/**
 * Special stars and lines (David, sweep 2026-10-05). They are extra deduction footholds, and
 * the uniqueness search knows about them:
 *   pulsar — the star must be ODD · binary — two stars must be EQUAL ·
 *   mirror line — that line must make 73 instead of 37 (Sector 73's own number).
 * Trident stays plain (it follows the tutorial); Hash gets a pulsar; Galaxy gets all three.
 */
export const SPECIALS_BY_LAYOUT = Object.freeze({
  twin: { pulsars: 0, binaries: 0, mirrorLines: 0 },
  trio: { pulsars: 0, binaries: 0, mirrorLines: 0 },
  hash: { pulsars: 1, binaries: 0, mirrorLines: 0 },
  galaxy: { pulsars: 1, binaries: 1, mirrorLines: 1 },
});
const LINE_OPS = ['+', '-', '*'];

const key = (r, c) => `${r},${c}`;
const H = (r, c0, c1) => Array.from({ length: c1 - c0 + 1 }, (_, k) => key(r, c0 + k));
const V = (c, r0, r1) => Array.from({ length: r1 - r0 + 1 }, (_, k) => key(r0 + k, c));

export const LAYOUTS = {
  twin: { id: 'twin', name: 'Twin Stars', grid: 4, lines: [H(1, 0, 3), V(1, 0, 3)] },
  trio: { id: 'trio', name: 'Trident', grid: 5, lines: [H(1, 0, 3), V(1, 0, 3), V(3, 1, 4)] },
  hash: { id: 'hash', name: 'Hash', grid: 4, lines: [H(1, 0, 3), H(2, 0, 3), V(1, 0, 3), V(2, 0, 3)] },
  galaxy: { id: 'galaxy', name: 'Galaxy', grid: 5, lines: [H(0, 0, 4), H(2, 0, 4), H(4, 0, 4), V(0, 0, 4), V(2, 0, 4), V(4, 0, 4)] },
};
export const LAYOUT_ORDER = ['twin', 'trio', 'hash', 'galaxy'];

/** Evaluate a line: values v0..vk with ops between, normal precedence (× first). */
export function evalLine(values, ops) {
  let total = 0;
  let term = values[0];
  let sign = 1;
  for (let k = 0; k < ops.length; k++) {
    const op = ops[k];
    const v = values[k + 1];
    if (op === '*') term *= v;
    else {
      total += sign * term;
      sign = op === '+' ? 1 : -1;
      term = v;
    }
  }
  return total + sign * term;
}

/** Every 1–6 tuple of length n that makes the line equal `target` (37 unless a Mirror line). */
export function lineSolutions(ops, target = TARGET) {
  const n = ops.length + 1;
  const out = [];
  const vals = new Array(n).fill(1);
  const rec = (i) => {
    if (i === n) {
      if (evalLine(vals, ops) === target) out.push([...vals]);
      return;
    }
    for (let v = 1; v <= 6; v++) { vals[i] = v; rec(i + 1); }
  };
  rec(0);
  return out;
}

/** Nodes of a layout, and for each node the (line, position) pairs it sits on. */
export function layoutNodes(layout) {
  const nodes = [];
  /** @type {Record<string, Array<[number, number]>>} */
  const where = {};
  layout.lines.forEach((line, li) => line.forEach((k, pos) => {
    if (!where[k]) { where[k] = []; nodes.push(k); }
    where[k].push([li, pos]);
  }));
  return { nodes, where };
}

/**
 * Backtracking search with forward checking.
 * @param {object} p
 * @param {string[]} p.nodes
 * @param {Record<string, Array<[number, number]>>} p.where
 * @param {number[][][]} p.sols   per-line solution tuples
 * @param {Record<string, number>} [p.fixed]  givens
 * @param {number} [p.limit]  stop after this many solutions
 * @param {() => number} [p.rng]  randomise value order (for picking a random solution)
 * @param {{ pulsars?: string[], binaries?: Array<[string, string]> }} [p.specials]
 * @returns {Array<Record<string, number>>}
 */
export function search({ nodes, where, sols, fixed = {}, limit = 2, rng = null, specials = {} }) {
  const found = [];
  const odd = new Set(specials.pulsars || []);
  /** @type {Record<string, string>} */
  const partner = {};
  for (const [a, b] of specials.binaries || []) { partner[a] = b; partner[b] = a; }
  // Candidate tuple lists per line, pre-filtered by the givens and the pulsars.
  let lists = sols.map((list) => list);
  for (const [k, v] of Object.entries(fixed)) {
    for (const [li, pos] of where[k]) lists[li] = lists[li].filter((t) => t[pos] === v);
  }
  for (const k of odd) {
    for (const [li, pos] of where[k] || []) lists[li] = lists[li].filter((t) => t[pos] % 2 === 1);
  }
  if (lists.some((l) => l.length === 0)) return found;

  // Most-constrained ordering: nodes on more lines first.
  const order = nodes.filter((k) => fixed[k] == null).sort((a, b) => where[b].length - where[a].length);
  const assign = { ...fixed };

  const rec = (idx, current) => {
    if (found.length >= limit) return;
    if (idx === order.length) { found.push({ ...assign }); return; }
    const k = order[idx];
    // Values still possible for this node across every line it is on.
    let possible = null;
    for (const [li, pos] of where[k]) {
      const s = new Set(current[li].map((t) => t[pos]));
      possible = possible ? new Set([...possible].filter((v) => s.has(v))) : s;
    }
    let vals = [...possible];
    // A binary star must equal its partner once the partner has a value.
    if (partner[k] && assign[partner[k]] != null) vals = vals.filter((v) => v === assign[partner[k]]);
    if (rng) vals = shuffle(rng, vals);
    for (const v of vals) {
      const next = current.slice();
      let dead = false;
      for (const [li, pos] of where[k]) {
        next[li] = current[li].filter((t) => t[pos] === v);
        if (next[li].length === 0) { dead = true; break; }
      }
      if (dead) continue;
      assign[k] = v;
      rec(idx + 1, next);
      delete assign[k];
      if (found.length >= limit) return;
    }
  };
  rec(0, lists);
  return found;
}

/**
 * Generate a unique-solution chart.
 * @returns {{ layout, ops: string[][], solution: Record<string, number>, givens: Record<string, number>,
 *   targets: number[], specials: { pulsars: string[], binaries: Array<[string, string]> } }}
 */
export function generateChart(layoutId, seed, retry = 0) {
  const layout = LAYOUTS[layoutId] || LAYOUTS.twin;
  const rng = makeRng(seed);
  const { nodes, where } = layoutNodes(layout);
  const want = SPECIALS_BY_LAYOUT[layout.id] || SPECIALS_BY_LAYOUT.twin;

  for (let attempt = 0; attempt < 200; attempt++) {
    const ops = layout.lines.map((line) => Array.from({ length: line.length - 1 }, () => {
      const r = rng();
      return r < 0.45 ? '*' : r < 0.8 ? '+' : '-';
    }));
    // Special stars / lines for this layout (none on Twin and Trident: their rng use is unchanged).
    const shuffled = want.pulsars + want.binaries ? shuffle(rng, nodes) : [];
    /** @type {string[]} */
    const pulsars = shuffled.slice(0, want.pulsars);
    /** @type {Array<[string, string]>} */
    const binaries = want.binaries ? [[shuffled[want.pulsars], shuffled[want.pulsars + 1]]] : [];
    const mirrorLine = want.mirrorLines ? Math.floor(rng() * layout.lines.length) : -1;
    const targets = layout.lines.map((_, li) => (li === mirrorLine ? MIRROR_TARGET : TARGET));
    const specials = { pulsars, binaries };
    const sols = ops.map((o, li) => lineSolutions(o, targets[li]));
    if (sols.some((s) => s.length === 0)) continue;
    const [solution] = search({ nodes, where, sols, limit: 1, rng, specials });
    if (!solution) continue;

    // Reveal givens until unique.
    /** @type {Record<string, number>} */
    const givens = {};
    for (let guard = 0; guard < nodes.length; guard++) {
      const two = search({ nodes, where, sols, fixed: givens, limit: 2, specials });
      if (two.length <= 1) break;
      const other = two.find((s) => nodes.some((k) => s[k] !== solution[k])) || two[1];
      const diff = shuffle(rng, nodes.filter((k) => other[k] !== solution[k] && givens[k] == null));
      const pickNode = diff[0] || shuffle(rng, nodes.filter((k) => givens[k] == null))[0];
      givens[pickNode] = solution[pickNode];
    }
    if (search({ nodes, where, sols, fixed: givens, limit: 2, specials }).length !== 1) continue;

    // Remove every given the uniqueness doesn't need (hardest unique chart).
    for (const k of shuffle(rng, Object.keys(givens))) {
      const v = givens[k];
      delete givens[k];
      if (search({ nodes, where, sols, fixed: givens, limit: 2, specials }).length !== 1) givens[k] = v;
    }
    return { layout, ops, solution, givens, targets, specials };
  }
  // About 1% of Galaxy seeds find no unique chart in 200 tries; that threw and took the whole app
  // to its error screen (S21, 2026-10-14), every time the saved chart reopened. Try the next seed.
  if (retry < 5) return generateChart(layoutId, `${seed}~${retry + 1}`, retry + 1);
  throw new Error(`Star Chart: could not generate a ${layoutId} chart`);
}

/** Current value of each line given player entries (null if any star empty). */
export function lineValues(layout, ops, entries) {
  return layout.lines.map((line, li) => {
    const vals = line.map((k) => entries[k]);
    if (vals.some((v) => v == null)) return null;
    return evalLine(vals, ops[li]);
  });
}

/** Do the special stars hold? (Pulsars odd, binary pairs equal; empty stars don't count yet.) */
export function meetsSpecials(specials, entries) {
  if (!specials) return true;
  const oddOk = (specials.pulsars || []).every((k) => entries[k] == null || entries[k] % 2 === 1);
  const pairsOk = (specials.binaries || []).every(([a, b]) => entries[a] == null || entries[b] == null || entries[a] === entries[b]);
  return oddOk && pairsOk;
}

/** Solved: every line on its target and every special star satisfied. */
export const isComplete = (layout, ops, entries, targets = layout.lines.map(() => TARGET), specials = null) =>
  lineValues(layout, ops, entries).every((v, li) => v === targets[li]) && meetsSpecials(specials, entries);

export { LINE_OPS };
