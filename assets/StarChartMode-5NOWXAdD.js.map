import React from 'react';
import { NeonDieFace } from '../dice/NeonDie';
import { PAD_COLORS } from '../dice/pips';
import { TipSlot, PowerUpTray } from '../coach';
import { MAX_HINTS, MAX_CHECKS, PENALTY_SECONDS, hintBlocked, checkBlocked } from './boardState';

// Everything under Star Chart's board readout (redesign slice 3, world framework §B3 / §C2):
//   the ONE message slot (coach line, Check's verdict, a stuck tip) →
//   the tray: free tools (Pencil, Erase, Undo) | power-ups (💡 Hint, 🔎 Check: tap → card → USE) →
//   the six dice.
// The tray sits directly above the dice, as in every Sector 73 game.

/** The power-ups, in the coach kit's shape: what each does, what it costs, why it can't be used now. */
export function chartPowerUps(board, selected, isFixed) {
  const hintsLeft = MAX_HINTS - board.hints;
  const checksLeft = MAX_CHECKS - board.checks;
  return [
    {
      id: 'hint', icon: '💡', name: 'Hint', what: 'Reveal the right number for the star you picked.',
      cost: `+${PENALTY_SECONDS} s`, badge: hintsLeft, left: hintsLeft, disabledReason: hintBlocked(board, selected, isFixed) ?? undefined,
    },
    {
      id: 'check', icon: '🔎', name: 'Check', what: 'Mark every wrong star red.',
      cost: `+${PENALTY_SECONDS} s`, badge: checksLeft, left: checksLeft, disabledReason: checkBlocked(board) ?? undefined,
    },
  ];
}

/** What Check found, for the message slot: a rose refusal when stars are wrong, else good news. */
export function checkVerdict(lastCheck) {
  if (!lastCheck) return { refusal: null, good: null };
  const { wrong, placed } = lastCheck;
  if (wrong) return { refusal: `${wrong} star${wrong === 1 ? ' is' : 's are'} wrong: the red ${wrong === 1 ? 'one' : 'ones'}.`, good: null };
  return { refusal: null, good: `All ${placed} placed star${placed === 1 ? ' is' : 's are'} right.` };
}

const TOOL = 'flex h-[56px] min-w-[52px] flex-col items-center justify-center rounded-xl border px-1 text-lg active:scale-95 disabled:opacity-40';

/**
 * @param {{
 *   board: import('./boardState').Board,
 *   selected: string | null,
 *   isFixed: (k: string) => boolean,
 *   pencilMode: boolean,
 *   onPencil: () => void,
 *   onErase: () => void,
 *   onUndo: () => void,
 *   onPowerUp: (id: 'hint' | 'check') => void,
 *   onDie: (v: number) => void,
 *   ruledOut: Set<number>,
 *   messages: { coach?: string | null, good?: string | null, tip?: string | null, refusal?: string | null },
 *   onDismissTip?: () => void,
 * }} props
 */
export default function ChartControls({ board, selected, isFixed, pencilMode, onPencil, onErase, onUndo, onPowerUp, onDie, ruledOut, messages, onDismissTip }) {
  return (
    <div className="mt-1 space-y-1.5 px-3">
      <TipSlot testId="sc-coach-line" messages={messages} onDismissTip={onDismissTip} />
      <div data-testid="sc-tray-row" className="flex items-center justify-center gap-1.5">
        <button type="button" data-testid="star-pencil" aria-pressed={pencilMode} onClick={onPencil}
          className={`${TOOL} ${pencilMode ? 'border-sky-300 bg-sky-500/30 text-white' : 'border-white/15 text-slate-200'}`}>
          <span aria-hidden="true">✏️</span><span className="text-[10px] font-bold leading-none">{pencilMode ? 'Pencil on' : 'Pencil'}</span>
        </button>
        <button type="button" data-testid="star-erase" onClick={onErase} className={`${TOOL} border-white/15 text-slate-200`}>
          <span aria-hidden="true">⌫</span><span className="text-[10px] font-bold leading-none">Erase</span>
        </button>
        <button type="button" data-testid="star-undo" disabled={!board.history.length} onClick={onUndo} className={`${TOOL} border-white/15 text-slate-200`}>
          <span aria-hidden="true">↶</span><span className="text-[10px] font-bold leading-none">Undo</span>
        </button>
        <span className="mx-0.5 h-10 w-px bg-white/15" aria-hidden="true" />
        <PowerUpTray powerUps={chartPowerUps(board, selected, isFixed)} onUse={onPowerUp} testId="sc-power-ups" />
      </div>
      <div className="grid grid-cols-6 gap-1.5">
        {/* The pad is six dice, each its own colour; the chart itself keeps numbers. */}
        {[1, 2, 3, 4, 5, 6].map((v) => (
          // A number an odd star or an "=" pair rules out for the selected star is dimmed (still tappable).
          <button key={v} type="button" aria-label={String(v)} data-testid={`pad-die-${v}`} data-ruled-out={ruledOut.has(v) || undefined} onClick={() => onDie(v)}
            className={`grid place-items-center rounded-xl py-1 transition-transform active:scale-90 ${ruledOut.has(v) ? 'opacity-25' : pencilMode ? 'opacity-60 ring-1 ring-sky-300/50' : ''}`}>
            <NeonDieFace value={v} color={PAD_COLORS[v]} size={48} />
          </button>
        ))}
      </div>
    </div>
  );
}
