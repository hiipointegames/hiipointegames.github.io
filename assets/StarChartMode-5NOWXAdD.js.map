// Star Chart's stuck tip (redesign slice 4, PROPOSAL §3C; world framework §B1.3 / §B2).
//
// Shown after 30 s without progress or 2 refused moves in a row (coach kit useStuckTimer). Every tip
// is worked out from the board AS IT IS — never from the chart's solution — and names a line or a
// star, so it is always true and always a step:
//   1. a line that can't make its target any more, or is full and wrong → name it, say "change one";
//   2. else the open line with the FEWEST ways to make its target → "only one way" / "only N ways";
//   3. practice only, level 2 (stuck again): the empty star only ONE number fits → name the number.
// The Daily never gets level 2 (David, Q4: "says where to look, never a number").

import { lineStates, lineName } from './lineState';

/**
 * @typedef {{ text: string, kind: 'broken' | 'miss' | 'rule' | 'fewest' | 'value', line: number | null, star?: string, value?: number }} Tip
 */

/**
 * The numbers 1–6 star `k` can still take: those that leave every line through it able to make its
 * target under ALL the special rules — the same test the board's ✕ uses (lineStates), so a tip and
 * the board can never disagree. (A per-line-sum shortcut missed an odd star elsewhere on the line.)
 */
export function candidates(chart, all, k) {
  const mine = chart.layout.lines.map((keys, li) => (keys.includes(k) ? li : -1)).filter((li) => li >= 0);
  const out = [];
  for (let v = 1; v <= 6; v++) {
    const states = lineStates(chart, { ...all, [k]: v });
    if (mine.every((li) => states[li].status === 'open' || states[li].status === 'done')) out.push(v);
  }
  return out;
}

/**
 * The tip for this board, or null (nothing useful to say).
 * @param {any} chart  generateChart(...)
 * @param {Record<string, number>} all  entries + givens + hints
 * @param {{ daily?: boolean, level?: 1 | 2 }} [opts]
 * @returns {Tip | null}
 */
export function stuckTip(chart, all, { daily = false, level = 1 } = {}) {
  const states = lineStates(chart, all);
  const name = (li) => lineName(chart, li);

  // 1. Something is already wrong: say where.
  const broken = states.find((s) => s.status === 'broken' && s.why === 'sum');
  if (broken) return { kind: 'broken', line: broken.li, text: `${name(broken.li)} can't make ${broken.target}. Change one of its numbers.` };
  const miss = states.find((s) => s.status === 'miss');
  // (A − line can go below zero: print the minus sign the keypad uses, never a hyphen.)
  if (miss) return { kind: 'miss', line: miss.li, text: `${name(miss.li)} makes ${String(miss.value).replace('-', '−')}, not ${miss.target}. Change one number.` };
  const rule = states.find((s) => s.status === 'broken');
  if (rule) return { kind: 'rule', line: rule.li, text: `${name(rule.li)} breaks the odd or = rule. Change a number.` };

  // 3. Practice, stuck again: the one number that fits a star (with the player's own numbers).
  if (level === 2 && !daily) {
    const empty = [...new Set(chart.layout.lines.flat())].filter((k) => all[k] == null);
    for (const k of empty) {
      const c = candidates(chart, all, k);
      if (c.length === 1) return { kind: 'value', line: null, star: k, value: c[0], text: `With your numbers, only ${c[0]} fits the glowing star.` };
    }
  }

  // 2. Where to look: the open line with the fewest ways (then the fewest empty stars).
  const open = states.filter((s) => s.status === 'open')
    .sort((a, b) => a.ways - b.ways || a.values.filter((v) => v == null).length - b.values.filter((v) => v == null).length || a.li - b.li);
  const best = open[0];
  if (!best) return null;
  return best.ways === 1
    ? { kind: 'fewest', line: best.li, text: `${name(best.li)} has only one way to make ${best.target}.` }
    : { kind: 'fewest', line: best.li, text: `Start with ${name(best.li)}: only ${best.ways} ways to make ${best.target}.` };
}
