// Star Chart's Daily (David, 2026-10-14) — the same chart for every player on a date, one attempt
// per account, ranked by the fastest score (time + 37 s per hint and per check). The server side
// is supabase/migrations/20261015000000_sector73_daily_boards.sql (game 'starChart').
//
// Two things live on the phone, separately from the practice tabs:
//   • the Daily's chart in progress — board slot 'daily' (./boardState.js saveBoard/loadBoard),
//     so a practice tab's saved chart is never overwritten;
//   • today's attempt record (DAILY_RUN_KEY) — 'started' at START, then 'solved' or 'elsewhere'
//     (this account already took it on another phone). It stops a second attempt offline too.

import { boardScore, loadBoard, emptyBoard, PENALTY_SECONDS } from './boardState';
import { dayBefore } from '../rng';

export const DAILY_TAB = 'daily';
const DAILY_RUN_KEY = 'sector73.starChart.dailyRun';

/**
 * The Daily is ALWAYS a Hash chart (David, 2026-10-22, redesign Q1): the same size every day, so the
 * race is fair and the par (4:00) means the same thing. It used to rotate Trident → Hash → Galaxy,
 * which swung the par from 2:30 to 7:00 and made the world blurb false on Galaxy days.
 */
export const DAILY_LAYOUT = 'hash';
/** Kept for callers that list the possible Daily layouts: now just the one. */
export const DAILY_LAYOUTS = Object.freeze([DAILY_LAYOUT]); // never the coached tutorial chart (daily.test.jsx)

/** Today's chart seed — the same for every player. */
export const dailySeed = (date) => `star-chart-daily-${date}`;

/** The date a Daily seed was dealt for ('YYYY-MM-DD'), or null for a practice seed. */
export const dailyDateOf = (seed) => (/^star-chart-daily-\d{4}-\d{2}-\d{2}$/.test(seed ?? '') ? seed.slice('star-chart-daily-'.length) : null);

/**
 * Which layout a date's Daily uses: always Hash (see DAILY_LAYOUT). The date stays a parameter so
 * every caller keeps asking "which layout for THIS day" — a later rule can change it in one place.
 * @param {string} _date 'YYYY-MM-DD'
 */
export function dailyLayout(_date) {
  return DAILY_LAYOUT;
}

/** Today's Daily chart: the saved one if it is today's, else a fresh board. */
export function openDaily(date) {
  const saved = loadBoard(DAILY_TAB);
  if (saved && saved.seed === dailySeed(date)) return { seed: saved.seed, board: saved.board };
  return { seed: dailySeed(date), board: emptyBoard() };
}

/** The score the server ranks: `seconds` INCLUDES the penalty; `penalty` is that part alone. */
export function dailyScore(board) {
  return {
    seconds: Math.max(1, boardScore(board)), // the server refuses 0 s (an instant solve)
    penalty: PENALTY_SECONDS * (board.hints + board.checks),
    hints: board.hints,
    checks: board.checks,
  };
}

/** @returns {{ date: string, status: string, score?: any } | null} today's record — status 'started' | 'solved' | 'elsewhere' */
export function readDailyRun(date) {
  try {
    const s = JSON.parse(globalThis.localStorage?.getItem(DAILY_RUN_KEY) ?? 'null');
    return s && s.date === date ? s : null;
  } catch { return null; }
}

export function writeDailyRun(state) {
  try { globalThis.localStorage?.setItem(DAILY_RUN_KEY, JSON.stringify(state)); } catch { /* storage blocked */ }
}

/**
 * Today's Daily is over on this phone: solved, taken on another phone, or started and left with
 * no chart saved to resume. A started Daily WITH a saved chart can still be finished.
 */
export function dailyDone(run, date) {
  if (!run) return false;
  if (run.status !== 'started') return true;
  const saved = loadBoard(DAILY_TAB);
  return !(saved && saved.seed === dailySeed(date));
}

/**
 * Which day's Daily to open (MIDNIGHT-SAFE, audit 2026-10-18): today's, unless YESTERDAY's was
 * started and can still be finished — a chart begun at 23:55 and reopened at 00:05 resumes as
 * yesterday's (the server still takes yesterday's finish, sector73_daily_finish `day >= today - 1`).
 * Anything older is let go: today's Daily opens fresh.
 * @param {string} today 'YYYY-MM-DD' (US Eastern)
 */
export function openingDailyDate(today) {
  const y = dayBefore(today);
  const run = readDailyRun(y);
  return run?.status === 'started' && !dailyDone(run, y) ? y : today;
}
