import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { PrimaryButton, ClickShield } from '../ui';
import { MIRROR_TARGET } from './generator';
import { BOUNTY_STARS, clock } from './chartInfo';
import HowItWorks from '../HowItWorks';

// Star Chart's briefing (overnight 2026-10-11). Shows on a FRESH chart only (never the coached
// tutorial, never a chart you're part-way through). The clock hasn't started yet.
//
// SHORT ON PURPOSE (David, 2026-10-14: pre-game screens were "way too crowded"): the chart, THREE
// short rules (redesign slice 6, world framework §B1.1: at most 3, each ≤ 14 words), chips for special
// stars / par / the Bonus, START and "ⓘ How it works" for the full rules and the medal thresholds.
// No demo: the tutorial teaches in motion. The special-star chips wear the board's own marks.
// "Every line makes its gold number" is true on every chart: each line's target glows at its end
// ("= 37", or "= 73" on Galaxy's 73 line), so the card needs no 73 footnote.

export const BRIEF_RULES = Object.freeze([
  'Gold stars are given.',
  'Every line makes its gold number.',
  '× first, then + −, reading towards the =.',
]);
/** The Daily's one line: one try, the race, and that help costs time (it is in the ranked score). */
export const DAILY_LINE = 'One try today · fastest time wins · help adds time';

// `daily`: today's Daily chart — one extra line. `leaveText`: what "Not now" does (StarChartMode).
export default function ChartBriefing({
  name, lines, targets, specials, par, bounty, onStart, onLeave = undefined, leaveText = 'Not now', daily = false,
}) {
  const [how, setHow] = useState(false);
  const has73 = targets.includes(MIRROR_TARGET); // Galaxy's 73 line
  const chips = [
    specials?.pulsars?.length ? {
      id: 'odd',
      text: <><b className="rounded-full bg-amber-300 px-1 text-[10px] font-black text-[#04030d]">odd</b> star: an odd number</>,
    } : null,
    specials?.binaries?.length ? {
      id: 'pair',
      text: <><b data-testid="sc-brief-pair-tag" className="inline-grid h-3.5 w-3.5 place-items-center rounded-full border border-fuchsia-300 align-[-2px] text-[10px] leading-none text-fuchsia-200">=</b> pair: equal numbers</>,
    } : null,
  ].filter(Boolean);
  return (
    <div data-testid="sc-briefing" className="absolute inset-0 z-40 grid place-items-center overflow-y-auto bg-black/75 px-4 py-6">
      <ClickShield className="w-full max-w-sm">
        <motion.div initial={{ scale: 0.88, opacity: 0, y: 14 }} animate={{ scale: 1, opacity: 1, y: 0 }} transition={{ type: 'spring', stiffness: 320, damping: 24 }}
          className="rounded-3xl border-2 border-sky-300/70 bg-[#06111f]/95 p-4 text-center" style={{ boxShadow: '0 0 40px -10px #7dd3fc' }}>
          <div className="text-[11px] uppercase tracking-[0.35em] text-sky-200">{daily ? '📅 Today’s Daily' : '✨ New chart'}</div>
          <div className="mt-1 text-3xl font-black text-white">{name}</div>
          {daily && <div data-testid="sc-brief-daily" className="mt-1 text-sm font-bold text-amber-200">{DAILY_LINE}</div>}
          <ol data-testid="sc-brief-rules" className="mx-auto mt-3 max-w-[300px] list-decimal space-y-1 pl-6 text-left text-base font-black leading-snug text-white">
            {BRIEF_RULES.map((r) => <li key={r} data-testid="sc-brief-rule">{r}</li>)}
          </ol>
          <div className="mt-2 flex flex-wrap justify-center gap-1.5 text-xs font-bold">
            {chips.map((c) => <span key={c.id} data-testid={`sc-brief-${c.id}`} className="whitespace-nowrap rounded-full border border-white/25 px-2.5 py-1 text-slate-100">{c.text}</span>)}
            <span data-testid="sc-brief-par" className="rounded-full border border-sky-300/60 bg-sky-950/40 px-2.5 py-1 text-sky-100">⏱ Par {clock(par)} · 🥇</span>
            {bounty && (
              <span data-testid="sc-brief-bounty" className="rounded-full border border-amber-300/60 bg-amber-500/10 px-2.5 py-1 text-amber-100">{bounty.icon} Bonus: {bounty.text} · +{BOUNTY_STARS}★</span>
            )}
          </div>
          <div className="mt-4">
            <PrimaryButton testId="sc-brief-start" tone="cyan" onClick={onStart}>START CHARTING ✨</PrimaryButton>
          </div>
          {/* The same buttons, in the same places, as First Contact's and Re-Entry's briefings. */}
          <div className="mt-3 flex flex-wrap justify-center gap-2 text-xs font-bold">
            <button type="button" data-testid="sc-brief-how" onClick={() => setHow(true)} className="rounded-full border border-sky-300/50 px-3 py-1.5 text-sky-100">ⓘ How it works</button>
          </div>
          {onLeave && (
            <button type="button" data-testid="sc-brief-leave" onClick={onLeave} className="mt-3 w-full text-center text-xs text-slate-400 underline">{leaveText}</button>
          )}
        </motion.div>
      </ClickShield>
      {how && (
        <HowItWorks title="Star Chart" testId="sc-how" onClose={() => setHow(false)} items={[
          `✨ Fill every star so each of the ${lines} lines makes the gold number at its end: 37${has73 ? ', or 73 on the 73 line' : ''}.`,
          '🎲 Stars take 1–6, and numbers can repeat. × first, then + and −, reading towards the = (left to right, top to bottom). A star where lines cross counts in both.',
          specials?.pulsars?.length ? '🔸 An “odd” star must be an odd number.' : null,
          specials?.binaries?.length ? '🔗 Two stars wearing the “=” tag and a pink ring must be equal.' : null,
          '💡 Hint reveals the star you pick (2 per chart). 🔎 Check marks every wrong star red (once per chart). Each adds +37 s.',
          `⏱ Par ${clock(par)}: 🥇 at or under par, 🥈 within ${clock(par * 2)}, 🥉 any solve. The clock starts when you press START or make your first move.`,
          bounty ? `${bounty.icon} Bonus: ${bounty.text} — +${BOUNTY_STARS}★ (up to 3★ a day).` : null,
        ]} />
      )}
    </div>
  );
}
