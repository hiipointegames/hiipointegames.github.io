import React from 'react';
import { DISPLAY } from '../sectorMath';
import { lineGap } from './chartInfo';
import { lineName } from './lineState';

// The line readout (redesign slice 2, PROPOSAL §3B): tap a star and the line(s) it sits on appear
// under the board as sums you can read — its numbers in reading order, every × run on a shaded block
// (so "× first" is something you SEE), and what the line makes so far. Two rows are always reserved,
// so the dice never move when a star is picked.

/** What a line says at its end, in words. Exported for the tests. */
export function readoutResult(s) {
  if (s.status === 'done') return { tone: 'done', text: `= ${s.target} ✓` };
  if (s.status === 'miss') return { tone: 'miss', text: `= ${s.value} · ${lineGap(s.value, s.target)}` };
  if (s.status === 'broken') return { tone: 'miss', text: s.why === 'rule' ? 'odd / = rule broken' : `can't make ${s.target}` };
  return { tone: 'open', text: `need ${s.target}` };
}

/** "Row 1" / "Column 2" → "ROW 1" / "COL 2": a 5-star Galaxy line has to fit a 360 px phone. */
export const shortName = (name) => name.replace('Column', 'Col').toUpperCase();

/**
 * The line as runs: each run is the stars joined by × (one shaded block when it has 2+ stars),
 * and the + / − between runs. Exported for the tests.
 * @returns {Array<{ type: 'run', keys: string[] } | { type: 'op', op: string }>}
 */
export function lineRuns(keys, ops) {
  /** @type {Array<{ type: 'run', keys: string[] } | { type: 'op', op: string }>} */
  const parts = [{ type: 'run', keys: [keys[0]] }];
  /** @type {{ type: 'run', keys: string[] }} */
  let run = /** @type {any} */ (parts[0]);
  ops.forEach((op, j) => {
    if (op === '*') { run.keys.push(keys[j + 1]); return; }
    run = { type: 'run', keys: [keys[j + 1]] };
    parts.push({ type: 'op', op }, run);
  });
  return parts;
}

function Star({ k, value, given, selected }) {
  return (
    <span data-testid="readout-star" data-star={k}
      className={`inline-grid h-[22px] min-w-[22px] place-items-center rounded-full border-[1.5px] px-0.5 text-[12px] font-black leading-none ${
        given ? 'border-amber-300 bg-amber-700 text-stone-900' : value == null ? 'border-sky-300/60 text-slate-500' : 'border-sky-300 text-white'} ${
        selected ? 'shadow-[0_0_8px_#e0f2fe] outline outline-2 outline-white' : ''}`}>
      {value ?? '☐'}
    </span>
  );
}

/**
 * @param {{
 *   chart: any,                         // generateChart(...)
 *   states: import('./lineState').LineState[],
 *   selected: string | null,
 *   givens: Record<string, number>,
 * }} props
 */
export default function LineReadout({ chart, states, selected, givens }) {
  const mine = selected ? states.filter((s) => s.keys.includes(selected)) : [];
  return (
    <div data-testid="line-readout" className="mx-3 mt-1 min-h-[68px] rounded-xl border border-indigo-900/80 bg-[#0b0920]/90 px-2 py-1.5">
      {mine.length === 0 ? (
        <p className="pt-4 text-center text-xs text-slate-500">Tap a star to see its lines.</p>
      ) : mine.map((s) => {
        const res = readoutResult(s);
        return (
          <div key={s.li} data-testid="readout-line" data-line={s.li} data-status={s.status}
            className="flex items-center gap-0.5 whitespace-nowrap py-[3px] text-[12px] font-black text-sky-100">
            <span className="w-[40px] shrink-0 text-[10px] tracking-wide text-slate-400">{shortName(lineName(chart, s.li))}</span>
            {lineRuns(s.keys, s.ops).map((p, i) => (p.type === 'op'
              ? <span key={i} className="px-0.5">{DISPLAY[p.op]}</span>
              : (
                <span key={i} data-testid={p.keys.length > 1 ? 'readout-times-run' : undefined}
                  className={p.keys.length > 1 ? 'inline-flex items-center gap-0.5 rounded-lg bg-sky-900/70 px-1 py-0.5' : 'inline-flex'}>
                  {p.keys.map((k, j) => (
                    <React.Fragment key={k}>
                      {j > 0 && <span className="px-px">×</span>}
                      <Star k={k} value={s.values[s.keys.indexOf(k)]} given={givens[k] != null} selected={k === selected} />
                    </React.Fragment>
                  ))}
                </span>
              )))}
            <span data-testid="readout-result"
              className={`ml-auto pl-1 text-[11px] ${res.tone === 'done' ? 'text-emerald-300' : res.tone === 'miss' ? 'text-rose-300' : 'text-slate-400'}`}>
              {res.text}
            </span>
          </div>
        );
      })}
    </div>
  );
}
