// Star Chart board state — pure, so undo / Check / saving are testable without React.
//
// Design (Star Chart, APPROVED 2026-10-04): unlimited UNDO; hints and checks are penalties
// and cannot be undone; every board size keeps its own in-progress chart, so switching
// never loses work.
//
// CHECK MARKS THE WRONG STARS, ONCE PER CHART (David, redesign Q3, 2026-10-22). It used to be
// count-only, unlimited (sweep 2026-10-05) because marking the wrong stars let "fill everything,
// Check, repeat" solve any chart in ≤5 presses. One use per chart takes away the "repeat": it is a
// rescue for a full board that won't come out, not a way to guess.
//
// HINT reveals the star the player PICKED, never one chosen for them (redesign slice 3): a hint
// that chose "the first open star" could spend 37 s on a star that was already right.

export const MAX_HINTS = 2;
export const MAX_CHECKS = 1;
export const PENALTY_SECONDS = 37;

/** @typedef {{ entries: Record<string, number>, pencil: Record<string, number[]>, hinted: Record<string, number>, hints: number, checks: number, lastCheck: { wrong: number, placed: number } | null, checkedSig?: string | null, checkedWrong?: Record<string, number>, history: Array<{entries: Record<string, number>, pencil: Record<string, number[]>}>, elapsed: number }} Board */

/** @returns {Board} */
export function emptyBoard() {
  return { entries: {}, pencil: {}, hinted: {}, hints: 0, checks: 0, lastCheck: null, checkedSig: null, checkedWrong: {}, history: [], elapsed: 0 };
}

const snapshot = (b) => ({ entries: b.entries, pencil: b.pencil });
const withHistory = (b) => ({ ...b, history: [...b.history, snapshot(b)].slice(-200) });

/** Place (or, if the same value is already there, clear) a number. Any edit clears the last Check result. */
export function enterValue(b, key, value) {
  const next = withHistory(b);
  const entries = { ...b.entries };
  if (entries[key] === value) delete entries[key]; else entries[key] = value;
  return { ...next, entries, lastCheck: null };
}

/** Toggle a pencil candidate. */
export function togglePencil(b, key, value) {
  const next = withHistory(b);
  const cur = new Set(b.pencil[key] || []);
  if (cur.has(value)) cur.delete(value); else cur.add(value);
  return { ...next, pencil: { ...b.pencil, [key]: [...cur].sort((x, y) => x - y) } };
}

/** Erase a star's number and pencil marks. */
export function erase(b, key) {
  if (b.entries[key] == null && !(b.pencil[key] || []).length) return b;
  const next = withHistory(b);
  const entries = { ...b.entries };
  delete entries[key];
  const pencil = { ...b.pencil };
  delete pencil[key];
  return { ...next, entries, pencil, lastCheck: null };
}

/** Undo the last number / pencil / erase change. Hints and checks are not undoable. */
export function undo(b) {
  if (!b.history.length) return b;
  const prev = b.history[b.history.length - 1];
  // A hinted star stays hinted: an older snapshot must not bring back the guess the hint
  // replaced (overnight audit 2026-10-11 — it reappeared, hidden under the hint).
  const entries = { ...prev.entries };
  const pencil = { ...prev.pencil };
  for (const k of Object.keys(b.hinted)) { delete entries[k]; delete pencil[k]; }
  return { ...b, entries, pencil, lastCheck: null, history: b.history.slice(0, -1) };
}

/** The placed numbers as a stable string (pencil marks are not part of it): what a Check judged. */
export const entriesSig = (entries) => Object.keys(entries).sort().map((k) => `${k}=${entries[k]}`).join(',');

/**
 * Can a Check tell you anything new? Only with stars placed, and only when the placed numbers
 * differ from those at the last Check — compared by value, so a pencil mark, an Undo back to
 * the same board, or clearing a number and putting it back don't count (contrarian review,
 * SC slice 3). The button is disabled otherwise. A save from before checkedSig existed falls
 * back to the old rule (a Check result still on screen = nothing new).
 */
export function canCheck(b) {
  if (b.checks >= MAX_CHECKS) return false;
  if (!Object.keys(b.entries).length) return false;
  if (b.checkedSig == null) return !b.lastCheck;
  return entriesSig(b.entries) !== b.checkedSig;
}

/**
 * Check: marks which placed stars are wrong (checkedWrong: star → the wrong number it held), and
 * counts them. Costs a penalty; once per chart. A no-op (free) when canCheck says no.
 */
export function check(b, solution) {
  if (!canCheck(b)) return b;
  const placed = Object.entries(b.entries);
  const wrongPairs = placed.filter(([k, v]) => solution[k] !== v);
  return {
    ...b, checks: b.checks + 1, lastCheck: { wrong: wrongPairs.length, placed: placed.length },
    checkedSig: entriesSig(b.entries), checkedWrong: Object.fromEntries(wrongPairs),
  };
}

/**
 * The stars Check marked wrong that STILL hold that wrong number: change one and its mark goes;
 * an Undo back to the wrong number brings it back (the mark follows the number, not the history).
 * @returns {Set<string>}
 */
export function wrongStars(b) {
  const marked = b.checkedWrong || {};
  return new Set(Object.keys(marked).filter((k) => b.entries[k] === marked[k]));
}

/** Reveal one star (a hint). Returns the board unchanged if no hints remain. */
export function revealHint(b, key, value) {
  if (b.hints >= MAX_HINTS) return b;
  const entries = { ...b.entries };
  delete entries[key];
  return { ...b, entries, hinted: { ...b.hinted, [key]: value }, hints: b.hints + 1, lastCheck: null };
}

/**
 * Which star a hint reveals: the PICKED one, if it isn't fixed — else none (redesign slice 3).
 * It used to fall back to "the first empty star, else the first open star", which on a full board
 * spent 37 s revealing a star that was already right (play-through 2026-10-22). The picked star is
 * revealed even when it is right: skipping it would tell you it was (overnight audit 2026-10-11).
 * @param {(k: string) => boolean} isFixed  given or already hinted
 * @param {string|null} selected
 */
export function hintTarget(isFixed, selected) {
  return selected && !isFixed(selected) ? selected : null;
}

/**
 * Why Hint can't be used right now, in plain words (null = it can). The power-up card shows it.
 * @param {Board} b
 * @param {string | null} selected
 * @param {(k: string) => boolean} isFixed
 */
export function hintBlocked(b, selected, isFixed) {
  if (b.hints >= MAX_HINTS) return 'No hints left on this chart.';
  if (!selected) return 'Pick a star first.';
  if (isFixed(selected)) return 'That star is already fixed.';
  return null;
}

/** Why Check can't be used right now (null = it can). */
export function checkBlocked(b) {
  if (b.checks >= MAX_CHECKS) return 'This chart’s Check is used.';
  if (!Object.keys(b.entries).length) return 'Place a number first.';
  if (!canCheck(b)) return 'Nothing new to check yet.';
  return null;
}

/** Score in seconds: time + 37 s per hint and per check. */
export const boardScore = (b) => Math.round(b.elapsed + PENALTY_SECONDS * (b.hints + b.checks));

// ── Saving: one in-progress chart per layout (device-local for practice) ────────

const KEY = (layoutId) => `sector73.starChart.${layoutId}`;

/**
 * Bumped whenever the generator would build a DIFFERENT chart from the same seed (SW12 added
 * special stars to Hash and Galaxy). An older save would show entries on the wrong chart, so it
 * is ignored instead.
 */
export const CHART_VERSION = 2;

/** Save the chart in progress for a layout (history is not saved — undo is per sitting). */
export function saveBoard(layoutId, seed, b, storage = globalThis.localStorage) {
  try {
    const { history, ...rest } = b;
    storage?.setItem(KEY(layoutId), JSON.stringify({ v: CHART_VERSION, seed, board: rest }));
  } catch {
    // Storage full / blocked: the chart simply won't resume next time.
  }
}

/** @returns {{ seed: string, board: Board } | null} */
export function loadBoard(layoutId, storage = globalThis.localStorage) {
  try {
    const raw = storage?.getItem(KEY(layoutId));
    if (!raw) return null;
    const { v, seed, board } = JSON.parse(raw);
    if (v !== CHART_VERSION || typeof seed !== 'string' || !board) return null;
    return { seed, board: { ...emptyBoard(), ...board, history: [] } };
  } catch {
    return null;
  }
}

export function clearBoard(layoutId, storage = globalThis.localStorage) {
  try { storage?.removeItem(KEY(layoutId)); } catch { /* nothing to clear */ }
}
