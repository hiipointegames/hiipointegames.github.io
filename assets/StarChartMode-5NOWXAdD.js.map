// Star Chart's guided first chart (sweep SW11, David 2026-10-05: "Twin → tutorial"; redesign slice 6,
// 2026-10-22: "a tutorial that teaches the thinking").
//
// ONE fixed, hand-made Twin chart, so every coach line is exactly true. It teaches the one idea that
// unlocks most charts — a × run decides a line — then the crossing star:
//
//   Row:    ☐ × ☐ + ☐ − 1 = 37  → the × part must be 32–36, and only 6 × 6 = 36 → 6 × 6 + 2 − 1.
//   Column: ☐ + 6 × ☐ + 4 = 37  → (with the row's 6 crossing it) 6 × 5 = 30 → 3 + 6 × 5 + 4.
//
// Both lines have exactly one way (tutorial.test.jsx checks it with the generator's own search).
// Real play starts at Trident.

import { LAYOUTS, TARGET } from './generator';

export const TUTORIAL_LAYOUT = 'twin';
export const FIRST_REAL_LAYOUT = 'trio';
/** The tutorial's save slot holds only THIS seed: an older random tutorial save is ignored. */
export const TUTORIAL_SEED = 'star-chart-tutorial-v2';
const KEY = 'sector73.starChart.tutorialDone';

/** The hand-made tutorial chart, in generateChart's shape. Row = line 0, column = line 1 (cross at 1,1). */
export const TUTORIAL_CHART = Object.freeze({
  layout: LAYOUTS.twin,
  ops: [['*', '+', '-'], ['+', '*', '+']],
  targets: [TARGET, TARGET],
  givens: Object.freeze({ '1,3': 1, '3,1': 4 }),
  solution: Object.freeze({ '1,0': 6, '1,1': 6, '1,2': 2, '1,3': 1, '0,1': 3, '2,1': 5, '3,1': 4 }),
  specials: Object.freeze({ pulsars: [], binaries: [] }),
});

/**
 * The coach card, step by step. `line` = the line that glows while the step shows. The steps move on
 * by themselves (the row made → the column); "help" is said on the tutorial's complete panel.
 */
export const TUTORIAL_STEPS = Object.freeze([
  { id: 'row', line: 0, text: 'Tap a glowing star, then a number. Only 6 × 6 gets close.' },
  { id: 'cross', line: 1, text: 'This star is in the column too. Now make the column 37.' },
  { id: 'help', line: null, text: 'Stuck? 💡 Hint reveals a star. 🔎 Check marks wrong ones. Each +37 s.' },
]);

/** Which step the coach card shows: the row first; once the row makes 37, the column. */
export const tutorialStepIndex = (rowDone) => (rowDone ? 1 : 0);

export function isTutorialDone(storage = globalThis.localStorage) {
  try { return storage?.getItem(KEY) === '1'; } catch { return false; }
}

export function setTutorialDone(done, storage = globalThis.localStorage) {
  try {
    if (done) storage?.setItem(KEY, '1'); else storage?.removeItem(KEY);
  } catch { /* storage blocked: the tutorial simply shows again */ }
}
