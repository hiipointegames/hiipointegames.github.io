// Presentational building blocks for the How-To-Play page.
// Realistic dice (depth, pip shadows, highlight) on the game's dark theme.

import React from 'react';
import { POWER_DIE_FACE } from '@/dice-visuals';

const PIPS = {
  1: [[50, 50]],
  2: [[28, 28], [72, 72]],
  3: [[28, 28], [50, 50], [72, 72]],
  4: [[28, 28], [72, 28], [28, 72], [72, 72]],
  5: [[28, 28], [72, 28], [50, 50], [28, 72], [72, 72]],
  6: [[28, 28], [72, 28], [28, 50], [72, 50], [28, 72], [72, 72]],
};

// Power-dice faces (darker hues + light pips so the gold "used-correctly" ring
// reads against them) come from the shared dice-visuals token so the live
// gameplay dice and these demo dice can never drift apart.
export function Die({ value, color = 'white', size = 56, className = '', rounded = 'rounded-2xl' }) {
  const f = POWER_DIE_FACE[color] || POWER_DIE_FACE.white;
  const pips = PIPS[value] || [];
  return (
    <span
      className={`relative inline-block ${rounded} bg-gradient-to-br ${f.bg} ${f.ring} ${className}`}
      style={{
        width: size,
        height: size,
        boxShadow:
          '0 10px 22px rgba(0,0,0,0.45), 0 3px 8px rgba(0,0,0,0.35), inset 0 2px 4px rgba(255,255,255,0.35), inset 0 -3px 6px rgba(0,0,0,0.3)',
      }}
    >
      {/* top sheen */}
      <span className={`absolute inset-0 ${rounded} bg-gradient-to-b from-white/25 to-transparent pointer-events-none`} />
      <svg viewBox="0 0 100 100" className="relative w-full h-full p-2">
        {pips.map(([cx, cy], i) => (
          <g key={i}>
            <circle cx={cx} cy={cy + 2.5} r={10.5} className="fill-black/30" />
            <circle cx={cx} cy={cy} r={10.5} className={f.pip} />
            <circle cx={cx - 3} cy={cy - 3} r={3} className="fill-white/30" />
          </g>
        ))}
      </svg>
    </span>
  );
}

// A compact operator glyph chip used inside the animated core loop.
export function OpChip({ glyph, size = 40, tone = 'slate' }) {
  const tones = {
    slate: 'from-slate-600 to-slate-800 text-white',
    green: 'from-emerald-500 to-green-700 text-white',
    blue: 'from-sky-500 to-blue-700 text-white',
    red: 'from-rose-500 to-red-700 text-white',
  };
  return (
    <span
      className={`inline-flex items-center justify-center rounded-xl font-black bg-gradient-to-br ${tones[tone] || tones.slate} shadow-lg`}
      style={{ width: size, height: size, fontSize: size * 0.5 }}
    >
      {glyph}
    </span>
  );
}

// GoldPulseRing (the "used-correctly" gold outline) now lives in the shared
// dice-visuals module so the live gameplay builder uses the exact same outline.
// Import it from '@/dice-visuals'.
