import React from 'react';
import { motion } from 'framer-motion';
import { playSound } from '@/ui/feedback';
import { POWER_DICE_COLORS, EASY_DICE_COLORS } from '@/dice';
import { hasPowerDice } from '@/game-modes';
import { POWER_DIE_FACE } from '@/dice-visuals';

const DiceFace = ({ value, isUsed, onClick, disabled, color, compact = false }) => {
  const [isLocked, setIsLocked] = React.useState(false);
  const unlockTimer = React.useRef(null);

  // The 50ms tap lock is a double-fire guard, and it used to be an uncancelled
  // setTimeout calling a state setter. A die can leave the tree inside that
  // window — the board unmounts when the player navigates off the game screen, or
  // when a mode switch renders a shorter dice array — and the pending timer then
  // fires a setState against a component that is gone. Own the handle so it can
  // be cleared.
  //
  // (Worth being precise about the blast radius: the dice are keyed by POSITION,
  // so a reroll re-renders the same seven DiceFace instances rather than
  // unmounting them. This is an unmount leak, not a per-shuffle one.)
  React.useEffect(() => () => {
    if (unlockTimer.current !== null) clearTimeout(unlockTimer.current);
  }, []);

  const handleClick = (e) => {
    if (isLocked || disabled || isUsed) return;
    e.preventDefault();
    e.stopPropagation();

    setIsLocked(true);
    playSound('diceClick');
    onClick();

    if (unlockTimer.current !== null) clearTimeout(unlockTimer.current);
    unlockTimer.current = setTimeout(() => {
      unlockTimer.current = null;
      setIsLocked(false);
    }, 50);
  };

  const dotPositions = {
    1: [[50, 50]],
    2: [[25, 25], [75, 75]],
    3: [[25, 25], [50, 50], [75, 75]],
    4: [[25, 25], [75, 25], [25, 75], [75, 75]],
    5: [[25, 25], [75, 25], [50, 50], [25, 75], [75, 75]],
    6: [[25, 25], [75, 25], [25, 50], [75, 50], [25, 75], [75, 75]]
  };

  // Faces + pips come from the shared dice-visuals token so the live board's
  // power dice are the SAME darker hues (with light pips) as the How-To-Play
  // demo dice — the prerequisite for the gold "used-correctly" outline to read.
  const colorStyles = {
    white: { bg: POWER_DIE_FACE.white.bg, shadow: 'hover:shadow-slate-300/40', dots: POWER_DIE_FACE.white.pip, ring: POWER_DIE_FACE.white.ring },
    blue: { bg: POWER_DIE_FACE.blue.bg, shadow: 'hover:shadow-blue-500/40', dots: POWER_DIE_FACE.blue.pip, ring: POWER_DIE_FACE.blue.ring },
    red: { bg: POWER_DIE_FACE.red.bg, shadow: 'hover:shadow-red-500/40', dots: POWER_DIE_FACE.red.pip, ring: POWER_DIE_FACE.red.ring },
    green: { bg: POWER_DIE_FACE.green.bg, shadow: 'hover:shadow-green-500/40', dots: POWER_DIE_FACE.green.pip, ring: POWER_DIE_FACE.green.ring }
  };

  const style = colorStyles[color] || colorStyles.white;
  const dots = dotPositions[value] || [];

  return (
    <button
      onPointerDown={handleClick}
      disabled={disabled || isUsed}
      className={`
        relative ${compact ? 'w-10 h-10 sm:w-12 sm:h-12 rounded-xl' : 'w-16 h-16 sm:w-20 sm:h-20 rounded-2xl'}
        transition-all duration-300 ease-out touch-manipulation
        active:scale-95
        ${isUsed
          ? 'bg-slate-700/50 opacity-30 cursor-not-allowed shadow-[0_4px_8px_rgba(0,0,0,0.2)]'
          : `bg-gradient-to-br ${style.bg} ${style.ring} cursor-pointer shadow-[0_8px_20px_rgba(0,0,0,0.35),0_3px_8px_rgba(0,0,0,0.25),inset_0_2px_4px_rgba(255,255,255,0.3)] active:shadow-[inset_0_2px_10px_rgba(0,0,0,0.3)]`
        }
        before:absolute before:inset-0 before:rounded-2xl before:bg-gradient-to-b before:from-white/25 before:to-transparent before:opacity-50 before:pointer-events-none
      `}
      // Dice keep `will-change: transform` even though v233 stripped it from the
      // other 17 gameplay buttons. The operator bar and the dice want OPPOSITE
      // treatment on Android WebView: the tiny operator buttons blank-painted
      // WHEN promoted (docs/bugs.md 2026-07-02), but the larger dice FLASH on tap
      // WITHOUT promotion — each tap fires `active:scale-95` on an un-promoted
      // layer, forcing a full repaint of the die + its ::before highlight. Pre-
      // promoting only the dice keeps the tap transform cheap (no flash) while
      // leaving the operator-bar fix intact. Verify on the S21 Ultra that the
      // promoted dice still PAINT (they render fine today; the bar did not).
      style={{ WebkitTapHighlightColor: 'transparent', willChange: 'transform' }}
    >
      <svg viewBox="0 0 100 100" className={`w-full h-full ${compact ? 'p-1' : 'p-2'} relative z-10`}>
        {dots.map(([cx, cy], i) => (
          <g key={i}>
            <circle cx={cx} cy={cy + 2} r={10} className="fill-black/25" />
            <circle cx={cx} cy={cy} r={10} className={isUsed ? 'fill-slate-500' : style.dots} />
            <circle cx={cx - 2.5} cy={cy - 2.5} r={3.5} className="fill-white/50" />
          </g>
        ))}
      </svg>
    </button>
  );
};

export default function DiceDisplay({ dice, usedIndices, onDiceClick, disabled, mode, colors, compact = false }) {
  // Use provided colors or fall back to mode-based colors
  const diceColors = colors || (
    hasPowerDice(mode)
      ? POWER_DICE_COLORS
      : EASY_DICE_COLORS
  );

  // COMPACT: all seven on ONE row, smaller faces.
  //
  // David, 2026-09-12, on the Today's Solve / post-win screen: "we want to have
  // the dice display shrunk so all 7 dice fit onto 1 line, and the screen slims
  // up a bunch and the bottom buttons become visible again."
  //
  // The 4+3 split below is the GAMEPLAY board and is deliberately untouched —
  // there the dice are tap targets and want to be big. Here they are a picture
  // of the roll, read at a glance, above a solve the player has already made.
  // Two different jobs, so an opt-in prop rather than a change to the default.
  //
  // 7 x w-10 (40px) + 6 x gap-1 (4px) = 304px, inside a 360px viewport with the
  // modal's padding. No wrapping, and no horizontal scroll.
  if (compact) {
    return (
      <div className="flex justify-center items-center gap-1 sm:gap-1.5 px-1 py-0.5">
        {dice.slice(0, 7).map((value, index) => (
          <DiceFace
            key={index}
            value={value}
            isUsed={usedIndices.includes(index)}
            onClick={() => onDiceClick(index)}
            disabled={disabled}
            color={diceColors[index]}
            compact
          />
        ))}
      </div>
    );
  }

  return (
    <div className="flex flex-col items-center gap-1.5 px-2 py-1">
      {/* Top row - 4 dice */}
      <div className="flex justify-center gap-2 sm:gap-3">
        {dice.slice(0, 4).map((value, index) => (
          <motion.div
            key={index}
            initial={{ scale: 0, rotate: -180 }}
            animate={{ scale: 1, rotate: 0 }}
            transition={{
              delay: index * 0.08,
              type: "spring",
              stiffness: 260,
              damping: 20
            }}
          >
            <DiceFace
              value={value}
              isUsed={usedIndices.includes(index)}
              onClick={() => onDiceClick(index)}
              disabled={disabled}
              color={diceColors[index]}
            />
          </motion.div>
        ))}
      </div>
      {/* Bottom row - 3 dice */}
      <div className="flex justify-center gap-2 sm:gap-3">
        {dice.slice(4, 7).map((value, index) => {
          const actualIndex = index + 4;
          return (
            <motion.div
              key={actualIndex}
              initial={{ scale: 0, rotate: -180 }}
              animate={{ scale: 1, rotate: 0 }}
              transition={{
                delay: actualIndex * 0.08,
                type: "spring",
                stiffness: 260,
                damping: 20
              }}
            >
              <DiceFace
                value={value}
                isUsed={usedIndices.includes(actualIndex)}
                onClick={() => onDiceClick(actualIndex)}
                disabled={disabled}
                color={diceColors[actualIndex]}
              />
            </motion.div>
          );
        })}
      </div>
    </div>
  );
}