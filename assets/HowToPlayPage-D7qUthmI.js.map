// How-To-Play & Winning Examples — mode-aware page (SPIKE: tuned for Daily).
//
// Presentational + props-driven (mode / onBack / onStart) so it's trivially
// testable and reusable; the route wrapper (src/pages/HowToPlay.jsx) supplies
// the router glue. Premium dark theme + per-mode accent. Teaches by SHOWING:
// a self-running real solve, color-as-rule power dice, and engine-verified
// winning boards rendered with the game's own SolvedEquation.

import React, { useState, useEffect, useRef, useMemo } from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { ArrowLeft, Infinity as InfinityIcon, Repeat, Target, Dice5, Clock, Calendar, Trophy, Gem } from 'lucide-react';
import { getPowerDiceCorrectness, evaluateEquation } from '@/equation-engine';
import { Die, OpChip } from './bits';
// The REAL gameplay dice board — reused so the how-to winning-examples board is
// pixel-identical to the live game (sharper dice, same per-mode power-dice hues)
// instead of the older rounded demo dice. Imported from puzzle-input's public
// surface; owned by F1 — imported here, never edited. (L1-#3, 1.0.278 feedback.)
import { DiceDisplay } from '@/puzzle-input';
import { GoldPulseRing, Target37, NUM_COLOR, GLYPH, EXPONENT_CLASS, OPERATOR_COLORS } from '@/dice-visuals';
import {
  MODE_CONFIG, POWER_DICE_RULES, powerDiceRuleFor,
  examplesForMode, CORE_NOTES,
} from './data';

// The gold used everywhere "Perfect" is signalled — the correctly-used power-die
// outline, the Perfect-Solve example border/badge, and the Perfect-Solve rule
// line under the power-dice card. One source so they never drift apart.
const GOLD = '#E9C45A';

// Renders an equation as NUMERALS (colored numbers + operator glyphs) — the
// equation READOUT shows numeric values, not dice (the dice tray below is the
// hand you pick from). Power-die numbers carry their hue and, when used
// correctly, the pulsing gold OUTLINE; non-power / wrongly-used numbers are
// plain. The digit right after `^` is superscripted. `upTo` limits how many
// build-steps render (the animation reveals progressively; static cards render
// the whole equation). Step indexing matches buildSteps so `upTo` stays in sync
// with the cursor's tap count.
function FancyEquation({ equation, usedIndices, colors, upTo = null, className = '' }) {
  const correct = getPowerDiceCorrectness(equation, usedIndices, colors);
  const out = [];
  let k = 0;        // number index (advances on digits only)
  let stepIdx = 0;  // build-step index (digit OR operator) — mirrors buildSteps
  let sup = false;
  for (let i = 0; i < equation.length; i++) {
    const ch = equation[i];
    const isDigit = /\d/.test(ch);
    const isOp = '+-*/^()'.includes(ch);
    if (!isDigit && !isOp) continue;
    if (upTo != null && stepIdx >= upTo) break;
    if (isDigit) {
      const color = colors[usedIndices[k]] || 'white';
      const isPowerCorrect = color !== 'white' && correct.get(k) === true;
      const numClass = `${NUM_COLOR[color]} ${sup ? EXPONENT_CLASS : ''} font-black`;
      out.push(
        isPowerCorrect
          ? <GoldPulseRing key={i} radius="rounded-md"><span className={`inline-block px-1 ${numClass}`}>{ch}</span></GoldPulseRing>
          : <span key={i} className={numClass}>{ch}</span>
      );
      k += 1; sup = false;
    } else {
      out.push(<span key={i} className="text-slate-400">{GLYPH[ch]}</span>);
      sup = ch === '^';
    }
    stepIdx += 1;
  }
  return <span className={`inline-flex flex-wrap items-baseline justify-center gap-x-1 gap-y-2 ${className}`}>{out}</span>;
}

// Per-mode NEON accent — the electric --u37-* tokens the new home/leaderboard
// screens use (easy=green · challenge=cyan · daily=cyan), so this page reads as
// the same theme instead of the old pastel tailwind gradients. `token` is the CSS
// var; `dot` is the cursor-puck fill (hex mirror of the token for a tailwind bg).
const ACCENT = {
  green: { token: 'var(--u37-green)', dot: 'bg-[#27ff9e]' },
  // Retained but unused since Challenge moved to cyan (David, 2026-08-31); a
  // section may still ask for it, and an accent key with no entry renders blank.
  violet: { token: 'var(--u37-violet)', dot: 'bg-[#b13bff]' },
  cyan: { token: 'var(--u37-cyan)', dot: 'bg-[#1ff0ff]' },
  // Expert (practice and Daily). Gold because in Expert a perfect solve is not a
  // decoration on top of winning, it IS winning — the same gold the perfect
  // highlight uses everywhere else. Added with the mode; the data-driven mount
  // test below caught its absence the moment MODE_CONFIG named it.
  gold: { token: 'var(--u37-gold)', dot: 'bg-[#ffcf3a]' },
};
// Neon surfaces — the SAME color-mix + boxShadow recipe as the Leaderboard tabs
// and home nav buttons, so accents glow instead of sitting flat.
const neonText = (t) => ({ color: t, textShadow: `0 0 8px color-mix(in srgb, ${t} 55%, transparent)` });
const neonChip = (t) => ({
  color: t,
  background: `color-mix(in srgb, ${t} 14%, transparent)`,
  borderColor: t,
  boxShadow: `0 0 16px -6px ${t}, inset 0 0 18px -12px ${t}`,
  textShadow: `0 0 8px color-mix(in srgb, ${t} 55%, transparent)`,
});
const ICONS = { infinity: InfinityIcon, repeat: Repeat, target: Target, dice: Dice5, clock: Clock, calendar: Calendar, trophy: Trophy, gem: Gem };
const POWER_TONE = { green: 'green', blue: 'blue', red: 'red' };
const POWER_TEXT = { green: 'text-emerald-300', blue: 'text-sky-300', red: 'text-rose-300' };

const OP_PAD = [
  { op: '+', g: '+' }, { op: '-', g: '−' }, { op: '*', g: '×' }, { op: '/', g: '÷' },
  { op: '^', g: '^' }, { op: '(', g: '(' }, { op: ')', g: ')' },
];

// Parse a verified example's equation into an ordered tap script for the cursor:
// each number (in equation order) maps to its board die via usedIndices; each
// operator char becomes an operator-pad tap. (No multi-digit numbers — dice 1-6.)
function buildSteps(equation, usedIndices) {
  const steps = [];
  let k = 0;
  for (const ch of equation) {
    if (/\d/.test(ch)) { steps.push({ kind: 'die', tray: usedIndices[k], numIdx: k }); k += 1; }
    else if ('+-*/^()'.includes(ch)) { steps.push({ kind: 'op', op: ch }); }
  }
  return steps;
}

// The equation string covering just the first `upTo` build-steps (tokens), so the
// live running total can be computed as the demo types itself out. One char per
// digit/operator, mirroring buildSteps' token counting.
function partialEquation(equation, upTo) {
  if (upTo == null) return equation;
  let out = '';
  let tokens = 0;
  for (const ch of equation) {
    if (/\d/.test(ch) || '+-*/^()'.includes(ch)) {
      if (tokens >= upTo) break;
      tokens += 1;
    }
    out += ch;
  }
  return out;
}

// ── Self-running gameplay-style solve (cursor + tray + operator pad) ─────────
// Drives a real engine-verified example (mode's examples[0]); the tray shows the
// mode's actual dice colors so Daily/Challenge animate with power dice.
function CoreLoop({ accent, example }) {
  const reduce = typeof window !== 'undefined' && window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const tray = example.dice;
  const colors = example.colors;
  const BUILD = useMemo(() => buildSteps(example.equation, example.usedIndices), [example]);

  const [step, setStep] = useState(reduce ? BUILD.length : 0);
  const [activeStep, setActiveStep] = useState(-1);
  const [pressing, setPressing] = useState(false);
  const [cursor, setCursor] = useState(null);
  const [solved, setSolved] = useState(reduce);
  const refs = useRef({});
  const containerRef = useRef(null);
  const a = ACCENT[accent];

  useEffect(() => {
    if (reduce) return;
    let cancelled = false;
    const timers = [];
    const PER = 950;

    const moveCursorTo = (i) => {
      const s = BUILD[i];
      const key = s.kind === 'die' ? `die-${s.tray}` : `op-${s.op}`;
      const el = refs.current[key];
      const c = containerRef.current;
      if (el && c) {
        const r = el.getBoundingClientRect();
        const cr = c.getBoundingClientRect();
        if (r.width > 0) setCursor({ x: r.left - cr.left + r.width / 2, y: r.top - cr.top + r.height / 2 });
      }
      setActiveStep(i);
    };

    const play = () => {
      setStep(0); setSolved(false); setActiveStep(-1);
      BUILD.forEach((_, i) => {
        timers.push(setTimeout(() => !cancelled && moveCursorTo(i), i * PER));
        timers.push(setTimeout(() => !cancelled && setPressing(true), i * PER + PER * 0.5));
        timers.push(setTimeout(() => { if (!cancelled) { setPressing(false); setStep(i + 1); } }, i * PER + PER * 0.78));
      });
      const end = BUILD.length * PER;
      timers.push(setTimeout(() => { if (!cancelled) { setActiveStep(-1); setCursor(null); setSolved(true); } }, end + 150));
      timers.push(setTimeout(() => !cancelled && play(), end + 3200));
    };
    timers.push(setTimeout(play, 350));
    return () => { cancelled = true; timers.forEach(clearTimeout); };
  }, [reduce, BUILD]);

  const built = BUILD.slice(0, step);
  const usedTray = new Set(built.filter((s) => s.kind === 'die').map((s) => s.tray));
  const active = activeStep >= 0 ? BUILD[activeStep] : null;

  // Live running total for the builder bar (mirrors the real game): evaluate the
  // equation typed so far — a number when it's a valid partial expression, else a
  // gold "?" — shown against the gold 37 target.
  const partial = partialEquation(example.equation, step);
  const { valid: pValid, result: pResult } = evaluateEquation(partial);
  const complete = step >= BUILD.length;
  const runningTotal = pValid && pResult != null ? pResult : '?';
  const runningColor = complete && pValid && pResult === 37
    ? 'text-emerald-400'
    : runningTotal === '?'
      ? 'text-slate-400'
      : 'text-slate-100';

  return (
    <div className="rounded-3xl border border-white/10 bg-white/[0.03] p-4 sm:p-5">
      <div ref={containerRef} className="relative">
        {/* dice tray (the hand you pick from — stays dice) */}
        <div className="flex flex-wrap justify-center gap-2">
          {tray.map((v, idx) => {
            const used = usedTray.has(idx);
            const pressed = pressing && active?.kind === 'die' && active.tray === idx;
            return (
              <div key={idx} ref={(el) => (refs.current[`die-${idx}`] = el)}>
                <motion.div animate={{ scale: pressed ? 0.84 : 1 }} transition={{ duration: 0.12 }}>
                  <Die value={v} color={colors[idx]} size={44} className={used ? 'opacity-25' : ''} />
                </motion.div>
              </div>
            );
          })}
        </div>

        {/* operator pad */}
        <div className="mt-3 flex flex-wrap justify-center gap-2">
          {OP_PAD.map(({ op, g }) => {
            const pressed = pressing && active?.kind === 'op' && active.op === op;
            return (
              <span
                key={op}
                ref={(el) => (refs.current[`op-${op}`] = el)}
                className={`w-11 h-11 grid place-items-center rounded-xl font-black text-lg text-white bg-gradient-to-br ${OPERATOR_COLORS[op]} shadow-md transition-all ${pressed ? 'translate-y-0.5 brightness-150 ring-2 ring-white/40' : ''}`}
              >
                {g}
              </span>
            );
          })}
        </div>

        {/* equation builder readout — mirrors the real game's bar: the equation
            being built (numerals), then a running total → gold 37 target with the
            "?" readout while the partial expression isn't a valid value yet. */}
        <div className="mt-4 rounded-2xl bg-slate-950/60 border border-white/5 px-3 py-3">
          <div className="min-h-[40px] flex flex-wrap items-center justify-center gap-1.5 text-2xl">
            {step === 0 && !solved && <span className="text-slate-500 text-sm">Tap dice and operators…</span>}
            <FancyEquation equation={example.equation} usedIndices={example.usedIndices} colors={colors} upTo={step} />
          </div>
          <div className="h-px bg-gradient-to-r from-transparent via-slate-600 to-transparent my-2" />
          <div className="flex items-center justify-end gap-1.5">
            <span className="text-slate-400 text-[10px] uppercase tracking-widest font-bold mr-auto">Running total</span>
            <motion.span
              key={runningTotal}
              initial={{ scale: 1.2, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              className={`text-2xl font-black font-mono ${runningColor}`}
            >
              {runningTotal}
            </motion.span>
            <span className="text-slate-500 text-xl font-bold">/</span>
            <Target37 accent={accent} className="text-2xl font-black font-mono" />
          </div>
        </div>

        {/* cursor puck */}
        {cursor && (
          <motion.div
            className="pointer-events-none absolute z-30 -translate-x-1/2 -translate-y-1/2"
            animate={{ left: cursor.x, top: cursor.y, scale: pressing ? 0.8 : 1 }}
            transition={{ type: 'spring', stiffness: 280, damping: 22, scale: { duration: 0.12 } }}
          >
            <div className={`w-8 h-8 rounded-full border-4 border-slate-900 shadow-2xl grid place-items-center ${pressing ? a.dot : 'bg-white'}`}>
              <div className={`w-2.5 h-2.5 rounded-full ${pressing ? 'bg-white' : a.dot}`} />
            </div>
          </motion.div>
        )}
      </div>

      <motion.div animate={{ opacity: solved ? 1 : 0 }} className="mt-3 text-center">
        <span className="text-sm font-bold" style={neonText(a.token)}>✓ That’s 37 — all 7 dice, each used once.</span>
      </motion.div>
    </div>
  );
}

// ── Winning-example board (real dice row = the rolled board; numeral equation
// builder below it = how those dice combine to 37) ──────────────────────────
function ExampleBoard({ ex, accent, mode }) {
  // 3D: Perfect Solves (all 3 power dice) get the gold outline treatment — the
  // same gold used on correctly-used power dice and on leaderboard perfect rows —
  // so Valid vs Perfect reads at a glance. Valid Solves use the mode accent chip.
  const isPerfect = ex.tag === 'PERFECT';
  const tagLabel = isPerfect ? 'Perfect Solve' : ex.tag === 'VALID' ? 'Valid Solve' : null;
  return (
    <div
      className="snap-center shrink-0 w-[340px] sm:w-full rounded-3xl border bg-gradient-to-b from-white/[0.05] to-white/[0.02] p-5"
      style={
        isPerfect
          ? { borderColor: GOLD, boxShadow: `0 0 22px -8px ${GOLD}, inset 0 0 22px -16px ${GOLD}` }
          : { borderColor: 'rgba(255,255,255,0.10)' }
      }
    >
      {/* 3C: no descriptive label above the equation — just the Valid/Perfect tag.
          Let the math speak for itself. */}
      {tagLabel && (
        <div className="flex justify-end mb-4">
          <span
            className="text-[10px] font-black tracking-wide px-2.5 py-0.5 rounded-full border"
            style={isPerfect
              ? { color: GOLD, borderColor: GOLD, background: `color-mix(in srgb, ${GOLD} 14%, transparent)`, textShadow: `0 0 8px color-mix(in srgb, ${GOLD} 55%, transparent)` }
              : neonChip(ACCENT[accent].token)}
          >
            {tagLabel}
          </span>
        </div>
      )}
      {/* the rolled board — rendered with the REAL gameplay DiceDisplay so it's
          pixel-identical to the live game (the 4+3 layout, sharper dice, correct
          per-mode power-dice hues). Static here: nothing used, clicks disabled. */}
      <div className="mb-4 flex justify-center">
        <DiceDisplay dice={ex.dice} usedIndices={[]} onDiceClick={() => {}} disabled mode={mode} colors={ex.colors} />
      </div>
      {/* the equation builder, filled in — NUMERALS (clicked dice become values) */}
      <div className="rounded-2xl bg-slate-950/60 border border-white/5 px-4 py-4 flex flex-wrap items-center justify-center gap-1.5 text-2xl">
        <FancyEquation equation={ex.equation} usedIndices={ex.usedIndices} colors={ex.colors} />
        <span className="mx-1 text-2xl font-black text-slate-500">=</span>
        <Target37 accent={accent} className="text-3xl font-black" />
      </div>
      {ex.powerCorrect > 0 && (
        <p className="mt-3 text-center text-xs text-slate-400 flex items-center justify-center gap-1.5">
          <span
            className="inline-block w-4 h-4 rounded border-2"
            style={{ borderColor: GOLD, boxShadow: '0 0 6px rgba(233,196,90,0.7)' }}
          />
          gold outline = power die used correctly · {ex.powerCorrect}/3
        </p>
      )}
    </div>
  );
}

export default function HowToPlayPage({ mode = 'daily', onBack, onStart, requireScroll = false, ctaLabel = null }) {
  const cfg = MODE_CONFIG[mode] || MODE_CONFIG.daily;
  const a = ACCENT[cfg.accent];
  const reduceMotion = useReducedMotion();

  // When the player had to SCROLL to unlock this, the button is the start of
  // play rather than an acknowledgement — so it says what it does. `cfg.name`
  // keeps it mode-specific without a second list: Begin Easy Daily / Begin
  // Daily Challenge / Begin Expert Daily.
  const doneLabel = ctaLabel ?? (requireScroll ? `Begin ${cfg.name}` : `Got it — Play ${cfg.name}`);
  const examples = examplesForMode(cfg.id);
  // The power-dice rule differs by mode — Challenge decorates a perfect solve,
  // Expert REQUIRES one — so it is asked per mode, not read from one constant.
  const powerRule = powerDiceRuleFor(cfg.id);

  // The self-running demo uses a PERFECT example when the mode has one (all 3
  // power dice light up gold — the richest teaching solve); Easy has no tags, so
  // it falls back to the first example. Selected independently of the
  // winning-examples DISPLAY order (Valid-first per L1-4) so reordering the cards
  // never changes which solve animates.
  const demoExample = examples.find((ex) => ex.tag === 'PERFECT') ?? examples[0];

  // home-condense H2: forced-scroll first-run. When requireScroll is set, the
  // footer CTA only unlocks once the player has scrolled to the bottom (proof
  // they've seen the whole how-to). When not required, it's unlocked from the
  // start. `reachedEnd` starts true in the non-required case.
  const scrollRef = useRef(null);
  const [reachedEnd, setReachedEnd] = useState(!requireScroll);

  const checkAtBottom = () => {
    const el = scrollRef.current;
    if (!el) return;
    // A small threshold absorbs sub-pixel rounding; also unlock immediately when
    // the content is shorter than the viewport (nothing to scroll).
    if (el.scrollHeight - el.scrollTop - el.clientHeight <= 24) setReachedEnd(true);
  };

  // On mount / when gating turns on: if the content already fits (no scroll
  // possible), don't trap the player — unlock right away.
  useEffect(() => {
    if (!requireScroll) { setReachedEnd(true); return; }
    checkAtBottom();
  }, [requireScroll]);

  // ── Footer-CTA tap reliability (Bryce, 1.0.281 iOS) ──────────────────────────
  // A plain onClick on this footer button is UNRELIABLE on the iOS WKWebView:
  // the tap gets swallowed and the button "appears dead," so closing the in-game
  // how-to ("Got it — return to puzzle") took ~7-10 taps. This is the same class
  // of defect — same reporter, same platform — that the in-game "?" hit on
  // 1.0.251 (it sits flush above the native AdMob banner and abuts the
  // momentum-scroll body), fixed there by firing on pointerdown instead of
  // onClick (DailyChallengeGame `handleHowToClick`). Mirror that proven remedy:
  //   • fire on pointerdown so the FIRST touch activates (no gesture ambiguity),
  //   • preventDefault so the trailing compatibility click can't double-fire,
  //   • touch-action:manipulation (on the button) drops the ~300ms tap delay.
  // Keyboard activation (Enter/Space) and the unit tests dispatch a click with NO
  // preceding pointerdown, so onClick stays as the accessibility/web path; a
  // click that TRAILS a pointerdown we just handled is ignored to avoid a
  // double-fire on mouse (where preventDefault on pointerdown doesn't cancel it).
  const pointerActivatedAtRef = useRef(0);
  // "Scroll down to continue" DOES the scrolling (David, 2026-10-18): players
  // tapped the locked button expecting it to act, and it sat there. A tap now
  // carries them all the way to the bottom of the how-to and unlocks the CTA.
  // It does NOT also start the game — the player still sees the end of the page
  // and taps "Begin …" themselves; the 700ms trailing-click guard below keeps
  // this same tap's compatibility click from doing that.
  const scrollToEndAndUnlock = () => {
    const el = scrollRef.current;
    if (el) {
      const top = el.scrollHeight;
      if (typeof el.scrollTo === 'function') el.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
      else el.scrollTop = top;
    }
    setReachedEnd(true);
  };
  const activateCta = () => {
    if (!reachedEnd) { scrollToEndAndUnlock(); return; }
    if (onStart) onStart();
  };
  const handleCtaPointerDown = (e) => {
    e.preventDefault();
    e.stopPropagation();
    pointerActivatedAtRef.current = Date.now();
    activateCta();
  };
  const handleCtaClick = () => {
    // Skip the synthetic click that trails a pointerdown we already handled.
    if (Date.now() - pointerActivatedAtRef.current < 700) return;
    activateCta();
  };

  // ── Back-arrow tap reliability (Bryce, 1.0.285 iOS) ──────────────────────────
  // Same defect class as the footer CTA above, same reporter and platform: during
  // gameplay the top-left back arrow "appeared dead" — Bryce tapped it 20+ times
  // across battles and a solo blitz before it closed. A plain onClick on the iOS
  // WKWebView gets swallowed (this arrow sits in a static header abutting the
  // momentum-scroll body), so it never reliably fires the FIRST touch. The footer
  // CTA got the pointerdown remedy in 1.0.281; the back arrow was missed. Mirror
  // the exact CTA pattern so both close paths behave identically and are testable:
  //   • fire on pointerdown so the first touch activates,
  //   • preventDefault + stopPropagation so the trailing compatibility click can't
  //     double-fire (and the tap doesn't bubble to the scroll body underneath),
  //   • touch-action:manipulation drops the ~300ms tap delay.
  // Keyboard activation (Enter/Space) and the unit tests dispatch a bare click with
  // NO preceding pointerdown, so onClick stays as the accessibility/web path; a
  // click that TRAILS a pointerdown we just handled is ignored to avoid a
  // double-fire on mouse (where preventDefault on pointerdown doesn't cancel it).
  const backPointerActivatedAtRef = useRef(0);
  const handleBackPointerDown = (e) => {
    e.preventDefault();
    e.stopPropagation();
    backPointerActivatedAtRef.current = Date.now();
    if (onBack) onBack();
  };
  const handleBackClick = () => {
    // Skip the synthetic click that trails a pointerdown we already handled.
    if (Date.now() - backPointerActivatedAtRef.current < 700) return;
    if (onBack) onBack();
  };

  return (
    <div className="fixed inset-0 flex flex-col overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100">
      {/* accent ambience — a neon glow bloom in the mode's token color */}
      <div
        className="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 w-[520px] h-[520px] rounded-full blur-3xl"
        style={{ background: `radial-gradient(circle, color-mix(in srgb, ${a.token} 24%, transparent), transparent 70%)` }}
      />

      {/* top bar — STATIC (never scrolls); buffered below the phone's status bar.
          env(safe-area-inset-top) is 0 on Android under edge-to-edge, so a 2rem
          floor guarantees the title clears the status icons. */}
      <div className="flex-none relative z-20 backdrop-blur bg-slate-950/95 border-b border-white/5" style={{ paddingTop: 'max(env(safe-area-inset-top, 0px), 2rem)' }}>
        <div className="max-w-xl mx-auto flex items-center gap-3 px-4 py-3">
          <button
            onPointerDown={handleBackPointerDown}
            onClick={handleBackClick}
            aria-label="Back"
            style={{ touchAction: 'manipulation' }}
            className="p-2 -ml-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5"
          >
            <ArrowLeft className="w-5 h-5" />
          </button>
          <div>
            <div className="text-[11px] font-bold uppercase tracking-[0.18em]" style={neonText(a.token)}>{cfg.eyebrow}</div>
            <div className="text-lg font-black leading-tight">How to Play · <span style={neonText(a.token)}>{cfg.name}</span></div>
          </div>
        </div>
      </div>

      {/* scrolling body — the ONLY scroll region; content passes UNDER the
          static header + footer and is never blocked by them or the ad */}
      <div ref={scrollRef} data-testid="howto-scroll" onScroll={requireScroll ? checkAtBottom : undefined} className="flex-1 overflow-y-auto relative z-10">
      <div className="relative max-w-xl mx-auto px-4 pb-8 pt-6 space-y-10">
        {/* hero */}
        <section className="text-center space-y-2">
          <h1 className="text-3xl sm:text-4xl font-black leading-tight">
            Build <Target37 accent={cfg.accent} />.
          </h1>
          <p className="text-slate-400 max-w-sm mx-auto">{cfg.blurb}</p>
        </section>

        {/* 1 — core loop */}
        <section className="space-y-3">
          <SectionLabel n="1" accent={a}>How to Play</SectionLabel>
          <p className="text-sm text-slate-400">Use all 7 dice (each once) with <span className="text-slate-200 font-semibold">+ − × ÷ ^ ( )</span> to hit <Target37 accent={cfg.accent} />. Watch one come together:</p>
          <CoreLoop accent={cfg.accent} example={demoExample} />
          <ul className="space-y-1 pt-1">
            {CORE_NOTES.map((note, i) => (
              <li key={i} className="text-xs text-slate-500 flex gap-2"><span style={neonText(a.token)}>›</span><span>{note}</span></li>
            ))}
          </ul>
        </section>

        {/* 2 — order of operations (E1). Every mode: the engine evaluates your
            equation by precedence, not left-to-right — the comprehension gap that
            makes power dice (and parentheses) feel arbitrary until you know it. */}
        <section className="space-y-3">
          <SectionLabel n="2" accent={a}>Order of Operations</SectionLabel>
          {/* Plain-English, no jargon: "precedence" reads past a 5th grader and
              past anyone whose first language isn't English (Bryce, 1.0.287).
              The numbered tiers below already say what the order IS. */}
          <p className="text-sm text-slate-400">Equations are solved in this order:</p>
          {/* NO SUB-LINE UNDER THE TIER NAMES (David, 2026-09-12). Each row used
              to carry a grey restatement — "grouped first", "powered next — after
              parentheses", "before any + or −", "last" — under its name. The
              numbered chips 1-4 already say the order, so the sub-line repeated
              the one thing the list's own shape communicates, at four times the
              height. The names and the numbers carry it. */}
          <div className="grid grid-cols-1 gap-2.5">
            {[
              { ops: ['(', ')'], label: 'Parentheses' },
              { ops: ['^'], label: 'Exponents' },
              { ops: ['*', '/'], label: 'Multiply & divide' },
              { ops: ['+', '-'], label: 'Add & subtract' },
            ].map((tier, i) => (
              <div key={i} className="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-3">
                <span className="shrink-0 w-6 h-6 rounded-lg grid place-items-center text-xs font-black border" style={neonChip(a.token)}>{i + 1}</span>
                <div className="flex gap-1.5">
                  {tier.ops.map((op) => <OpChip key={op} glyph={GLYPH[op]} size={30} tone="slate" />)}
                </div>
                <div className="flex-1">
                  <span className="font-bold text-slate-100 text-sm">{tier.label}</span>
                </div>
              </div>
            ))}
          </div>
          <div className="rounded-2xl border p-3 text-center" style={neonChip(a.token)}>
            <span className="font-bold">Known worldwide as PEMDAS · BODMAS · BIDMAS · GEMDAS.</span>{' '}
            <span className="opacity-80">
              {cfg.powerDice
                ? 'It’s why pairing a power die with the RIGHT operator (and parentheses) is what steers the result to 37.'
                : 'Use parentheses to control the order and steer the result to 37.'}
            </span>
          </div>
        </section>

        {/* 3 — power dice (challenge/daily) */}
        {cfg.powerDice && (
          <section className="space-y-3">
            <SectionLabel n="3" accent={a}>Power dice</SectionLabel>
            <p className="text-sm text-slate-400">Three dice are colored. Each wants its own operator:</p>
            <div className="grid grid-cols-1 gap-2.5">
              {POWER_DICE_RULES.map((r) => (
                <div key={r.color} className="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-3">
                  <Die value={r.color === 'green' ? 4 : r.color === 'blue' ? 5 : 2} color={r.color} size={44} />
                  <div className="flex-1">
                    <span className={`font-black ${POWER_TEXT[r.color]}`}>{r.label}</span>
                    <span className="text-slate-500 mx-2">→</span>
                    <span className="font-bold text-slate-100">{r.operators}</span>
                    <div className="text-xs text-slate-400">{r.note}</div>
                  </div>
                  <OpChip glyph={r.color === 'green' ? '+' : r.color === 'blue' ? '×' : '^'} size={34} tone={POWER_TONE[r.color]} />
                </div>
              ))}
            </div>
            <div className="rounded-2xl border p-3 text-center" style={neonChip(a.token)}>
              <span className="font-bold">{powerRule.headline}</span>
              {/* The perfect-solve REWARD line. Null in Expert practice, where
                  every solve is perfect by definition and practice awards
                  nothing — so there is no separate thing to promise. */}
              {powerRule.perfect && (
                <>
                  {' '}
                  <span
                    className="font-bold"
                    style={{ color: GOLD, textShadow: `0 0 8px color-mix(in srgb, ${GOLD} 45%, transparent)` }}
                  >
                    {powerRule.perfect}
                  </span>
                </>
              )}
            </div>
          </section>
        )}

        {/* 3 — winning examples */}
        <section className="space-y-3">
          <SectionLabel n={cfg.powerDice ? '4' : '3'} accent={a}>Winning examples</SectionLabel>
          {/* L1-4: the example cards are a horizontal swipe deck on phones — spell
              out the gesture so older / less tech-savvy players know to swipe for
              the rest (they'd otherwise see only the first card). Direction word
              dropped per 1.0.278 device feedback — "swipe" alone is clearer. */}
          <p className="text-sm text-slate-400">Swipe to see examples.</p>
          <div className="flex sm:flex-col gap-3 overflow-x-auto sm:overflow-visible snap-x -mx-4 px-4 sm:mx-0 sm:px-0">
            {examples.map((ex, i) => <ExampleBoard key={i} ex={ex} accent={cfg.accent} mode={cfg.id} />)}
          </div>
        </section>

        {/* 4 — this mode */}
        <section className="space-y-3">
          <SectionLabel n={cfg.powerDice ? '5' : '4'} accent={a}>This mode</SectionLabel>
          <div className="grid grid-cols-1 gap-2.5">
            {cfg.specifics.map((s, i) => {
              const Icon = ICONS[s.icon] || Target;
              return (
                <div key={i} className="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-3">
                  <div className="shrink-0 w-9 h-9 rounded-xl grid place-items-center border" style={neonChip(a.token)}>
                    <Icon className="w-4 h-4" />
                  </div>
                  <div>
                    <div className="font-bold text-slate-100 text-sm">{s.title}</div>
                    <div className="text-xs text-slate-400">{s.body}</div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        {/* home-condense H2: first-run "reopen" reassurance — only in forced-scroll
            mode. Tells the player the how-to isn't a one-shot; the "?" brings it
            back anytime. Also acts as the scroll-to-bottom target. */}
        {requireScroll && (
          <section className="text-center pt-2">
            <p className="text-xs text-slate-500">
              You can reopen this anytime with the <span className="font-black" style={neonText(a.token)}>?</span> button.
            </p>
          </section>
        )}
      </div>
      </div>

      {/* footer CTA — STATIC; sits ABOVE the ad banner (and home indicator) so the
          button is never covered, and the body scrolls cleanly underneath it.
          --ad-reserved-bottom is the live AdMob banner height (0 on web).

          The reservation is the SUM of the safe-area inset + the banner height —
          the SAME formula #root uses (index.css: `--safe-bottom + --ad-reserved-bottom`),
          NOT a max(). This overlay portals to <body> (HowToOverlay), so it escapes
          #root's padding and must reserve the band itself. On iOS the native banner
          floats ABOVE the home indicator, so the real occluded height is
          banner-height PLUS the safe-area inset; the old `max(ad, safe)` reserved
          only the larger of the two and left the CTA short by the safe-area → the
          "Got it" button was partially covered on iOS (Android's --safe-bottom is 0,
          so max and sum were equal there — which is why Android was fine).
          2026-07-08 device finding (David, S21/iPhone). */}
      <div
        className="flex-none relative z-20 backdrop-blur bg-slate-950/95 border-t border-white/5 px-4 pt-3"
        style={{ paddingBottom: 'calc(var(--ad-reserved-bottom) + env(safe-area-inset-bottom, 0px) + 0.4rem)' }}
      >
        <div className="max-w-xl mx-auto">
          {/* 🔴 THE SCROLL GATE HAS TO LOOK LIKE AN INSTRUCTION, NOT A DEAD
              CONTROL (David, from players, 2026-09-11). It was
              `rgba(255,255,255,0.08)` on 55%-opacity grey text — indistinguishable
              from a disabled button — so first-time players read the screen as
              broken and stopped, on the ONE screen standing between them and
              their first Daily.

              It now wears the mode's own accent (green / cyan / gold, the same
              `a.token` the rest of the page uses), so all three Dailies are
              colour-coordinated for free rather than by a second list that could
              drift. Outlined-and-tinted before, FILLED and brighter after — the
              state change is a fill, which reads at a glance without needing to
              re-read the words.

              The arrow nudges rather than pulses: a 4px travel over 1.6s, and
              nothing at all under prefers-reduced-motion. It is the only moving
              thing on the screen, which is what makes a small movement enough. */}
          {/* SECOND PASS, 2026-09-12 (David): still reading as dim. The 09-11 pass
              above got it off grey and onto the mode accent, which is why it is
              already colour-coordinated — but a 14% tint behind 55%-opacity
              border is "tinted", not "lit", and the only moving thing was a 4px
              arrow nudge inside the button.

              So: the locked state is brighter (22% fill, 75% border, a real
              outer glow), and the whole control now BREATHES via a glow ring
              behind it.

              ⚠️ THE PULSE IS OPACITY ON A SEPARATE LAYER, NOT box-shadow ON THE
              BUTTON. Animating box-shadow repaints every frame; opacity is
              composited. That distinction is not academic here — this app has a
              documented history of the Android WebView dropping or flickering
              layers under per-frame paint (docs/bugs.md 2026-07-13 logo,
              2026-07-02 operator bar, the badge grid). The ring is also a plain
              div with no SVG filter, which is the specific combination that
              caused the logo flicker.

              It is removed entirely once unlocked — the filled state is loud
              enough on its own — and under prefers-reduced-motion. */}
          <div className="relative">
            {!reachedEnd && !reduceMotion && (
              <motion.div
                aria-hidden="true"
                data-testid="howto-cta-pulse"
                className="absolute -inset-1 rounded-2xl pointer-events-none"
                style={{ boxShadow: `0 0 26px 2px ${a.token}` }}
                animate={{ opacity: [0.22, 0.65, 0.22] }}
                transition={{ duration: 1.8, repeat: Infinity, ease: 'easeInOut' }}
              />
            )}
          <button
            onPointerDown={handleCtaPointerDown}
            onClick={handleCtaClick}
            data-reached-end={String(reachedEnd)}
            className={`relative w-full h-14 rounded-2xl font-black text-lg transition-all duration-300 ${reachedEnd ? 'active:translate-y-0.5' : 'cursor-default'}`}
            style={reachedEnd
              ? {
                touchAction: 'manipulation',
                background: a.token,
                color: '#050310',
                // Brighter than the pre-scroll glow on purpose: unlocking is the
                // moment worth noticing.
                boxShadow: `0 0 40px -4px ${a.token}, inset 0 1px 0 rgba(255,255,255,0.45)`,
              }
              : {
                touchAction: 'manipulation',
                background: `color-mix(in srgb, ${a.token} 22%, transparent)`,
                color: `color-mix(in srgb, ${a.token} 88%, white)`,
                border: `2px solid color-mix(in srgb, ${a.token} 75%, transparent)`,
                boxShadow: `0 0 20px -6px ${a.token}, inset 0 0 18px -12px ${a.token}`,
              }}
          >
            {reachedEnd ? doneLabel : (
              <span className="inline-flex items-center gap-2">
                <motion.span
                  aria-hidden="true"
                  animate={reduceMotion ? undefined : { y: [0, 4, 0] }}
                  transition={reduceMotion ? undefined : { duration: 1.6, repeat: Infinity, ease: 'easeInOut' }}
                >
                  ↓
                </motion.span>
                Scroll down to continue
              </span>
            )}
          </button>
          </div>
        </div>
      </div>
    </div>
  );
}

function SectionLabel({ n, accent, children }) {
  return (
    <div className="flex items-center gap-2.5">
      <span className="shrink-0 w-7 h-7 rounded-lg grid place-items-center text-sm font-black border" style={neonChip(accent.token)}>{n}</span>
      <h2 className="text-xl font-black">{children}</h2>
    </div>
  );
}
