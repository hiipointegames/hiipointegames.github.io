// Per-mode derivation for every day-scoped Daily surface on the stats pages.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS MODULE EXISTS
// ─────────────────────────────────────────────────────────────────────────────
// Every stats surface here was designed when there was ONE Daily a day. A date
// keyed a row, a row keyed a day, and "your daily time" was one number. Three
// Dailies a day breaks all three assumptions at once:
//
//   * the calendar paints a day green because ONE of three modes was solved
//   * the streak card shows ONE number where Q-F rules THREE independent streaks
//   * the weekly list renders three rows for one date, indistinguishable
//   * "Solves by Mode" mixes practice counts and Daily counts on one axis, with
//     every bar drawn as a share of their own sum
//
// This module is the single place a row is asked "which Daily are you?", so the
// answer cannot be given four different ways by four components.
//
// ─────────────────────────────────────────────────────────────────────────────
// NOTHING HERE IS STORED
// ─────────────────────────────────────────────────────────────────────────────
// Every count, rate and date set below is derived on read from the
// daily_challenge_times / daily_challenge_attempts rows the page already loads.
// This project's documented disease is a stored aggregate drifting from that
// log (docs/bugs.md — the podium fix, the puzzle-points fix and the perfect-solve
// calendar fix were all the same disease). Re-cutting stats per mode is exactly
// where a new stored per-mode counter feels tempting. There isn't one.
//
// The ONE thing read rather than derived is `game_stats.perMode`, which
// W2-BOARDS derives server-side on read for the same reason — see readPerModeStats.
import {
  DAILY_MODE_KEYS,
  modeOf,
  hasPerfectConcept,
} from '@/game-modes';
import { isPerfectSolve } from '@/equation-engine';

/**
 * The mode a daily row belongs to when it does not say.
 *
 * Every row written before the `mode` column existed IS Challenge's Daily —
 * that is the property the NOT NULL DEFAULT 'daily' migrations rest on, and it
 * is why an absent mode backfills rather than being discarded. See
 * supabase/migrations/20260824012000_daily_modes.sql.
 */
export const LEGACY_DAILY_MODE = 'daily';

/**
 * Which Daily a `daily_challenge_times` / `daily_challenge_attempts` row is.
 *
 * Deliberately STRICTER than `normalizeModeKey`: a row in these tables is always
 * one of the three timed rounds, so a practice key ('easy', 'challenge',
 * 'expert') is junk here rather than a mode — and `normalizeModeKey` would
 * happily hand it back. Anything that is not a member of DAILY_MODE_KEYS reads
 * as the legacy Daily, which is both the safe answer and the true one for every
 * pre-column row.
 *
 * @param {{mode?: unknown}|null|undefined} row
 * @returns {string} a member of DAILY_MODE_KEYS
 */
export function rowModeKey(row) {
  const raw = row?.mode;
  return DAILY_MODE_KEYS.includes(/** @type {any} */(raw))
    ? /** @type {string} */(raw)
    : LEGACY_DAILY_MODE;
}

/**
 * Coerce a requested mode key to a real Daily mode.
 * @param {unknown} modeKey
 * @returns {string} a member of DAILY_MODE_KEYS
 */
export function normalizeDailyMode(modeKey) {
  return DAILY_MODE_KEYS.includes(/** @type {any} */(modeKey))
    ? /** @type {string} */(modeKey)
    : LEGACY_DAILY_MODE;
}

/**
 * The rows belonging to ONE Daily mode.
 *
 * This is the seam every day-scoped surface funnels through: scope the ROWS,
 * then hand them to the existing date-keyed derivation unchanged. That is what
 * lets the calendar, the weekly graph and the day modal go per-mode without any
 * of them learning what a mode is.
 *
 * @template T
 * @param {T[]|null|undefined} rows
 * @param {string} modeKey
 * @returns {T[]}
 */
export function filterByMode(rows, modeKey) {
  const target = normalizeDailyMode(modeKey);
  return (rows || []).filter(r => r && rowModeKey(/** @type {any} */(r)) === target);
}

/**
 * All three buckets at once, always with all three keys present (an empty array
 * for a mode with no rows). A missing key and an empty mode are different
 * questions, and no caller should have to guard the difference.
 *
 * @template T
 * @param {T[]|null|undefined} rows
 * @returns {Record<string, T[]>}
 */
export function groupByMode(rows) {
  /** @type {Record<string, any[]>} */
  const out = {};
  for (const key of DAILY_MODE_KEYS) out[key] = [];
  for (const row of rows || []) {
    if (!row) continue;
    out[rowModeKey(/** @type {any} */(row))].push(row);
  }
  return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// Display vocabulary
// ─────────────────────────────────────────────────────────────────────────────

/**
 * The player-facing name of a Daily mode — "Easy", "Challenge", "Expert".
 *
 * DERIVED from `modeOf`, never a hard-coded map, so adding a fourth key to
 * game-modes cannot leave a label behind. (The gold-outline seam F1 makes the
 * same argument for the same reason: neither side hard-codes a mode list.)
 *
 * @param {string} modeKey
 * @returns {string}
 */
export function dailyModeLabel(modeKey) {
  const tier = modeOf(normalizeDailyMode(modeKey));
  return tier.charAt(0).toUpperCase() + tier.slice(1);
}

/**
 * The long form — "Easy Daily" — for headings and empty states where "Easy"
 * alone would read as the untimed practice mode.
 * @param {string} modeKey
 * @returns {string}
 */
export const dailyModeFullLabel = (modeKey) => `${dailyModeLabel(modeKey)} Daily`;

// The tab/bar accent per difficulty tier.
//
// Keyed by TIER (`modeOf`), not by wire key, and deliberately NOT reusing
// badgeVisuals' MODE_ACCENT: that map is keyed by badge ARENA, where 'daily'
// means "the Daily arena" rather than Challenge's Daily, and a stylesheet drift
// test pins it to the [data-mode] rules. Two different questions, two maps.
//
// Easy green, Challenge CYAN and Expert GOLD are the project's canonical tier
// colours (David, 2026-08-27) -- all three now have a [data-mode] rule and a
// --u37-grad-* gradient in tokens.css, so this map is no longer a local choice.
//
// The earlier `--u37-magenta` pick here was withdrawn: magenta is already
// [data-mode="blitz-battle"], so an Expert wearing it would be visually
// identical to the Colosseum. `modeTheme.test.js` pins that they differ.
const TIER_ACCENT = {
  easy: 'var(--u37-green)',
  challenge: 'var(--u37-cyan)',
  expert: 'var(--u37-gold)',
};

/**
 * The `var(--u37-*)` accent for a Daily mode.
 * @param {string} modeKey
 * @returns {string}
 */
export function dailyModeAccent(modeKey) {
  return TIER_ACCENT[modeOf(normalizeDailyMode(modeKey))] ?? 'var(--u37-mode-accent)';
}

/**
 * The `[data-mode]` THEME NAME for a Daily mode — what a surface puts on its
 * root so `--u37-mode-accent` resolves to this tier for everything nested.
 *
 * It is the TIER, which is the same answer `modeThemeName` (src/game-flow) gives
 * and for the same reason: both rounds of a tier wear one colour. It is computed
 * here rather than imported from there ON PURPOSE. `@/game-flow` is a barrel that
 * transitively pulls in head-to-head and the profile components, so importing one
 * three-line pure function from it drags a page's worth of module graph into
 * every leaf stats component — measured, not assumed: it broke
 * DailyPerformanceSlide's suite outright, because that suite mocks
 * `@/game-mechanics` and the barrel walked into a module needing a different
 * export of it. src/leaderboard/DailyTab.jsx reaches the same value the same way
 * (`data-mode={modeOf(mode)}`).
 *
 * The three tier names are exactly the `[data-mode="easy|challenge|expert"]`
 * rules in ui/theme/tokens.css, which is what makes this safe to hand straight
 * to the attribute — the drift guard lives in dailyModeStats.test.js.
 *
 * @param {string} modeKey
 * @returns {string} 'easy' | 'challenge' | 'expert'
 */
export function dailyModeTheme(modeKey) {
  return modeOf(normalizeDailyMode(modeKey));
}

// ─────────────────────────────────────────────────────────────────────────────
// The get-player-stats blob — seam 3.5, consumed defensively
// ─────────────────────────────────────────────────────────────────────────────

/**
 * @typedef {{
 *   solved: number, currentStreak: number, longestStreak: number,
 *   podiumFinishes: {first: number, second: number, third: number},
 *   avgTime: number, fastestTime: number, tracked: boolean
 * }} DailyModeStats
 */

const ZERO_PODIUM = Object.freeze({ first: 0, second: 0, third: 0 });

const num = (v) => (Number.isFinite(Number(v)) ? Number(v) : 0);

const podium = (p) => ({
  first: num(p?.first),
  second: num(p?.second),
  third: num(p?.third),
});

/**
 * @param {boolean} [tracked]
 * @returns {DailyModeStats}
 */
const emptyModeStats = (tracked = false) => ({
  solved: 0,
  currentStreak: 0,
  longestStreak: 0,
  podiumFinishes: { ...ZERO_PODIUM },
  avgTime: 0,
  fastestTime: 0,
  tracked,
});

/**
 * Read `game_stats.perMode` (lane contract §3.5) — the per-mode solved/streak/
 * podium/time blob W2-BOARDS derives server-side.
 *
 * ⚠️ `perMode` MUST be tolerated as undefined. An old server does not send it,
 * and W2-BOARDS may not have merged when this ships. That tolerance is not a
 * nicety: it is precisely what makes the two lanes safe to merge in either
 * order — landing first, these surfaces simply show nothing new until BOARDS
 * lands.
 *
 * When it is absent this falls back to the LEGACY TOP-LEVEL FIELDS for
 * Challenge's Daily — which the contract says `perMode.daily` equals by
 * construction, so the fallback is the same number rather than an approximation
 * of it — and reports the other two modes as `tracked: false`.
 *
 * `tracked` is the distinction the UI actually needs. "This player has a zero
 * Easy streak" and "nothing has ever tracked an Easy streak" are different
 * facts, and rendering the second as a `0` tells the player they failed at
 * something that does not exist yet.
 *
 * @param {any} gameStats
 * @returns {{byMode: Record<string, DailyModeStats>, source: 'server'|'legacy'}}
 */
/**
 * Does this legacy stats blob actually record any Challenge Daily activity?
 *
 * The legacy top-level fields are always PRESENT — `num()` turns a missing one
 * into 0 — so their existence says nothing about whether the player has ever
 * played. Only a positive value does. Any one of the three is enough: a player
 * can hold a longest-streak record having broken their current one, and a
 * solved count with no streak is an ordinary non-consecutive player.
 *
 * @param {any} g a game_stats blob
 * @returns {boolean}
 */
function hasLegacyActivity(g) {
  return num(g.dailyChallengeSolved) > 0
    || num(g.dailyChallengeStreak) > 0
    || num(g.longestDailyChallengeStreak) > 0;
}

export function readPerModeStats(gameStats) {
  const g = gameStats || {};
  const perMode = g.perMode;
  // A server block only counts if it actually says something about one of the
  // three Dailies. `{}` used to satisfy `typeof === 'object'`, which skipped the
  // legacy fallback below and left Challenge's Daily reading "Not tracked yet" —
  // WORSE than sending no block at all, where it correctly shows the legacy
  // streak. That is reachable in production: get-player-stats wraps its perMode
  // derivation in a try/catch that omits the block on failure, and nothing on
  // the wire distinguishes that from an older deploy. An empty object carries no
  // information, so it is treated as no block rather than as an authoritative
  // "we tracked nothing". One real key is information, and still wins.
  const hasServer = perMode != null
    && typeof perMode === 'object'
    && DAILY_MODE_KEYS.some(k => perMode[k] != null && typeof perMode[k] === 'object');

  /** @type {Record<string, DailyModeStats>} */
  const byMode = {};

  for (const key of DAILY_MODE_KEYS) {
    const entry = hasServer ? perMode[key] : null;
    if (entry && typeof entry === 'object') {
      byMode[key] = {
        solved: num(entry.solved),
        currentStreak: num(entry.currentStreak),
        longestStreak: num(entry.longestStreak),
        podiumFinishes: podium(entry.podiumFinishes),
        avgTime: num(entry.avgTime),
        fastestTime: num(entry.fastestTime),
        tracked: true,
      };
    } else if (!hasServer && key === LEGACY_DAILY_MODE && hasLegacyActivity(g)) {
      // The legacy fallback. These top-level fields have ALWAYS meant Challenge's
      // Daily and keep that exact meaning under three modes — see the contract's
      // "EVERY existing key keeps its exact current meaning".
      //
      // ⚠️ NOW GATED ON `hasLegacyActivity` (David, 2026-09-11). Without it this
      // branch fired for ANY viewer on the legacy path, including one with no
      // stats at all — and `tracked: true` with every field at zero is what the
      // home launcher renders as a seven-day streak track reading
      // "CHALLENGE DAILY STREAK — 0 OF 7".
      //
      // Which meant a brand-new anonymous guest — no account, no solves, nothing
      // saved, and 1,540 of 1,576 prod accounts on 2026-09-05 — was shown a
      // weekly goal on ONE arbitrary mode, with Easy and Expert blank beside it.
      // David's reading, and it is the right one: "a guest will not have any
      // saved stats, so technically speaking they do not need to see this
      // anyway". Verified in the browser first — a fresh guest was indeed
      // rendering that track.
      //
      // The gate is deliberately on ACTIVITY rather than on "is this a guest":
      // this path is also reached by a REAL player when get-player-stats omits
      // perMode (its derivation is wrapped in a try/catch), and hiding a genuine
      // Challenge streak from them is the regression this fallback exists to
      // prevent. Data decides, not account type.
      byMode[key] = {
        solved: num(g.dailyChallengeSolved),
        currentStreak: num(g.dailyChallengeStreak),
        longestStreak: num(g.longestDailyChallengeStreak),
        podiumFinishes: podium(g.podiumFinishes),
        avgTime: num(g.lifetimeAvgTime),
        fastestTime: num(g.fastestTime),
        tracked: true,
      };
    } else {
      byMode[key] = emptyModeStats(false);
    }
  }

  return { byMode, source: hasServer ? 'server' : 'legacy' };
}

// ─────────────────────────────────────────────────────────────────────────────
// Derived-from-the-log counters
// ─────────────────────────────────────────────────────────────────────────────

/**
 * The distinct DATES a set of times rows says were completed.
 *
 * The single definition of "a completed day" for this module. Both counters the
 * stats page prints side by side call it, which is what makes
 * `solveCountsByMode(...).byMode[k] === completionRatesByMode(...)[k].completed`
 * true by construction instead of by coincidence — the coincidence is precisely
 * what stopped holding in the reported bug.
 *
 * @param {Array<{date?: string, forfeited?: boolean}>|null|undefined} rows
 * @returns {Set<string>}
 */
function completedDateSet(rows) {
  /** @type {Set<string>} */
  const dates = new Set();
  for (const row of rows || []) {
    if (!row || row.forfeited || !row.date) continue;
    dates.add(row.date);
  }
  return dates;
}

/**
 * How many of `dates` are fully-closed days — i.e. not `today`.
 * @param {Set<string>} dates
 * @param {string} today
 * @returns {number}
 */
function countClosed(dates, today) {
  let n = 0;
  for (const d of dates) if (d !== today) n += 1;
  return n;
}

/**
 * Completed DAYS per mode — the number captioned "N completed" on the stats page.
 *
 * ⚠️ DISTINCT DATES, NOT ROWS, and that is load-bearing.
 *
 * This number is rendered directly beside `completionRatesByMode`'s `attempted`
 * ("N Challenge days"). A player reading `3 completed` next to `2 days` sees an
 * arithmetic impossibility and concludes their stats are broken — which is
 * exactly what was reported (David, 2026-09-03: "I currently have 3 experts
 * completed on 2 attempts apparently"). Two counters shown side by side must be
 * counted over the same population, or the pair can contradict itself no matter
 * how correct each half is on its own. Counting DAYS here is half of that: it
 * makes this figure equal `completionRatesByMode(...).completed` BY
 * CONSTRUCTION rather than by two implementations happening to agree.
 *
 * `(user_id, date, mode)` is UNIQUE on `daily_challenge_times`, so today rows and
 * days are the same thing and the de-duplication changes no live number. It is
 * kept because the invariant must not depend on a constraint this module cannot
 * see, and because a merged/refetched array reaching here twice is cheap to
 * survive and expensive to debug.
 *
 * A row with no `date` is not a day and is not counted.
 *
 * ⚠️ `forfeited` does NOT exist on `daily_challenge_times` — the column lives on
 * `daily_challenge_attempts`, and a forfeit never writes a times row at all
 * (verified against the staging schema, 2026-09-04). The filter is kept as
 * defence for callers that pass merged attempt-shaped rows; it is not what makes
 * a forfeit stop counting here.
 *
 * @param {Array<{date?: string, forfeited?: boolean, mode?: string}>|null|undefined} times
 * @returns {{byMode: Record<string, number>, total: number}}
 */
export function solveCountsByMode(times) {
  const grouped = groupByMode(times);
  /** @type {Record<string, number>} */
  const byMode = {};
  let total = 0;
  for (const key of DAILY_MODE_KEYS) {
    const n = completedDateSet(grouped[key]).size;
    byMode[key] = n;
    total += n;
  }
  return { byMode, total };
}

/**
 * Perfect-solve counts per mode, with the Easy exemption made explicit.
 *
 * ⚠️ EASY HAS NO PERFECT-SOLVE CONCEPT. Easy deals all-white dice, so
 * `correctCount === 3` is not merely unmet there, it is ARITHMETICALLY
 * UNREACHABLE (see hasPerfectConcept). A per-mode perfect count that renders a
 * bare `0` for Easy therefore reports a failure at something impossible.
 *
 * `applicable: false` is how a caller knows to render "—" instead of "0". No
 * caller hard-codes which mode that is — the answer comes from
 * `hasPerfectConcept`, exactly as seam F1 requires of the gold outline.
 *
 * @param {Array<{mode?: string, date?: string, equation?: string, usedDiceIndices?: number[], diceColors?: string[]}>|null|undefined} times
 * @returns {Record<string, {count: number, applicable: boolean}>}
 */
export function perfectSolveCountsByMode(times) {
  const grouped = groupByMode(times);
  /** @type {Record<string, {count: number, applicable: boolean}>} */
  const out = {};
  for (const key of DAILY_MODE_KEYS) {
    if (!hasPerfectConcept(key)) {
      out[key] = { count: 0, applicable: false };
      continue;
    }
    const dates = new Set();
    for (const row of grouped[key]) {
      const { date, equation, usedDiceIndices, diceColors } = row || {};
      if (!date || !equation || !usedDiceIndices || !diceColors) continue;
      if (isPerfectSolve(equation, usedDiceIndices, diceColors)) dates.add(date);
    }
    out[key] = { count: dates.size, applicable: true };
  }
  return out;
}

/**
 * Per-mode completion counts and rate — D7.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * 🔴 THE BUG THIS SHAPE EXISTS TO KILL (David, 2026-09-03; reproduced on staging
 * 2026-09-04)
 * ─────────────────────────────────────────────────────────────────────────────
 * "The stats are not reflecting properly for each mode … I currently have 3
 * experts completed on 2 attempts apparently."
 *
 * Completed-exceeds-attempted is arithmetically impossible inside one row set,
 * and it was never produced inside one: the stats page reads its two counters
 * from two functions that scoped DIFFERENT DAYS.
 *
 *   "N completed"      solveCountsByMode  — every day, TODAY INCLUDED
 *   "N Challenge days" this function      — closed days only, today EXCLUDED
 *
 * Staging player A, Challenge: times on 2026-08-01 and 2026-09-04 (today),
 * one attempt row on 2026-09-04. First counter 2, second counter 1, same screen.
 * Neither function was wrong about the question it was asked. The defect was
 * that the screen asked two different questions and printed the answers as a
 * pair — so today's solve counted once and was excluded once.
 *
 * THE FIX: `completed` and `attempted` are now BOTH all-time day counts, so
 * `completed <= attempted` holds by construction and both agree with
 * `solveCountsByMode`. The ET cutoff moves onto the RATE alone, which is the
 * only figure that ever needed it — see below.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * WHY THE RATE STILL EXCLUDES TODAY, AND THE COUNTS DO NOT
 * ─────────────────────────────────────────────────────────────────────────────
 * Today is in flux: a started-but-unsolved Daily would drag a rate down at
 * midnight and lift it back on solve, so someone checking their stats at 8am
 * watches a number move for reasons that are not about their play. That
 * argument is about a RATIO being unstable. It was never an argument for hiding
 * a day from a raw count — and applying it to the count is what produced the
 * contradiction above.
 *
 * `closedCompleted` / `closedAttempted` are the rate's actual halves, exposed so
 * a caller can show the rate's own denominator when it wants that rather than
 * the lifetime one.
 *
 * ⚠️ FALLBACK ON A PLAYER'S FIRST DAY. With no closed history the closed ratio is
 * 0/0, and reporting 0% beside "1 completed" is the same class of contradiction
 * this function exists to remove. When nothing has closed yet the rate is taken
 * over all days instead: there is no stable rate to protect at that point, so
 * the cutoff has nothing left to buy.
 *
 * `attempted` is the number of distinct dates the player STARTED that mode on. A
 * completed date implies an attempt even when the attempt row is missing —
 * legacy completions predate parts of the attempts log, and staging player A's
 * 2026-08-01 completion has no attempt row at all — so the union is taken rather
 * than trusting either source alone.
 *
 * @param {Array<{date?: string, mode?: string, forfeited?: boolean}>|null|undefined} times
 * @param {Array<{date?: string, mode?: string}>|null|undefined} attempts
 * @param {string} today - today's ET date key (YYYY-MM-DD); excluded from the RATE.
 * @returns {Record<string, {completed: number, attempted: number, rate: number,
 *                           closedCompleted: number, closedAttempted: number}>}
 */
export function completionRatesByMode(times, attempts, today) {
  const groupedTimes = groupByMode(times);
  const groupedAttempts = groupByMode(attempts);

  /** @type {Record<string, {completed: number, attempted: number, rate: number, closedCompleted: number, closedAttempted: number}>} */
  const out = {};
  for (const key of DAILY_MODE_KEYS) {
    const completedDates = completedDateSet(groupedTimes[key]);
    const attemptedDates = new Set([
      ...groupedAttempts[key].map(a => a?.date).filter(Boolean),
      ...completedDates,
    ]);

    const closedCompleted = countClosed(completedDates, today);
    const closedAttempted = countClosed(attemptedDates, today);

    // Closed days decide the rate; all days decide it only before any day has
    // closed, where 0/0 would otherwise print a 0% that contradicts the counts.
    const [num, den] = closedAttempted > 0
      ? [closedCompleted, closedAttempted]
      : [completedDates.size, attemptedDates.size];

    out[key] = {
      completed: completedDates.size,
      attempted: attemptedDates.size,
      rate: den > 0 ? Math.round((num / den) * 100) : 0,
      closedCompleted,
      closedAttempted,
    };
  }
  return out;
}
