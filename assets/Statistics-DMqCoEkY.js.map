/**
 * Completion-rate + puzzle-piece-rate percentages for the Statistics page,
 * derived from authoritative edge-function metadata. Pure — extracted from
 * Statistics.jsx's loadStats.
 *
 * `totalAttempts` is the denominator: the greater of the lifetime completed
 * count and the raw attempts figure (they can disagree; the max is the safe
 * floor). Rates are integer-rounded and guarded against a zero denominator.
 * The puzzle-piece rate is intentionally NOT capped at 100 (matches the prior
 * inline behavior — a player can hold more puzzle points than attempts).
 *
 * @param {number} lifetimeCompletedCount - lifetime completed dailies.
 * @param {number} rawTotalAttempts - raw attempts from the stats payload.
 * @param {number} puzzlePoints - the player's puzzle points.
 * @returns {{totalAttempts: number, completionRate: number, puzzlePieceRate: number}}
 */
export function computeCompletionRates(lifetimeCompletedCount, rawTotalAttempts, puzzlePoints) {
  const totalAttempts = Math.max(lifetimeCompletedCount, rawTotalAttempts);
  const pct = (num) => totalAttempts > 0 ? Math.round((num / totalAttempts) * 100) : 0;
  return {
    totalAttempts,
    completionRate: pct(lifetimeCompletedCount),
    puzzlePieceRate: pct(puzzlePoints),
  };
}
