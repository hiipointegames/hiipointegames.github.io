import React from 'react';
import { motion } from 'framer-motion';
import moment from 'moment';
import 'moment-timezone';
import { nowET } from '@/daily-challenge';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { playSound } from '@/ui/feedback';

// `showPerfectLegend` (D3, 2026-08-27): Easy has NO perfect-solve concept —
// all-white dice make `correctCount === 3` arithmetically unreachable — so on an
// Easy calendar the gold ring can never appear. Leaving its legend key standing
// over a colour that will never show reads as a challenge the player is failing
// at, so the entry is dropped rather than left explaining nothing. Defaults true
// so any caller that has not been taught about modes is unchanged.
export default function CalendarView({ onDayClick, userCompletedDates, selectedMonth, onMonthChange, userFailedDates = [], perfectSolveDates = [], showPerfectLegend = true }) {
  const today = nowET();
  const currentMonth = selectedMonth ? moment.tz(selectedMonth, 'YYYY-MM', 'America/New_York') : today.clone();
  const isCurrentMonth = currentMonth.isSame(today, 'month');

  const handlePreviousMonth = () => {
    playSound('buttonTap');
    const newMonth = currentMonth.clone().subtract(1, 'month');
    onMonthChange(newMonth.format('YYYY-MM'));
  };

  const handleNextMonth = () => {
    if (!isCurrentMonth) {
      playSound('buttonTap');
      const newMonth = currentMonth.clone().add(1, 'month');
      onMonthChange(newMonth.format('YYYY-MM'));
    }
  };

  const startOfMonth = currentMonth.clone().startOf('month');
  const endOfMonth = currentMonth.clone().endOf('month');
  const startDate = startOfMonth.clone().startOf('week');
  const endDate = endOfMonth.clone().endOf('week');

  const calendar = [];
  const day = startDate.clone();

  while (day.isSameOrBefore(endDate, 'day')) {
    const dateStr = day.format('YYYY-MM-DD');
    const isCompleted = userCompletedDates.includes(dateStr);
    const isFailed = userFailedDates.includes(dateStr);
    const isTodayDate = day.isSame(today, 'day');
    const isPerfectSolve = perfectSolveDates.includes(dateStr);

    calendar.push({
      date: dateStr,
      day: day.date(),
      isCurrentMonth: day.month() === currentMonth.month(),
      isToday: isTodayDate,
      isPast: day.isBefore(today, 'day'),
      isCompleted: isCompleted,
      isFailed: isFailed,
      isPerfectSolve: isPerfectSolve
    });
    day.add(1, 'day');
  }

  const weekDays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  return (
    <div className="max-w-md mx-auto">
      {/* Month/Year Header with Navigation */}
      <div className="flex items-center justify-center mb-3 gap-4">
        <button
          onClick={handlePreviousMonth}
          className="p-2 rounded-lg hover:bg-slate-700/50 transition-colors"
        >
          <ChevronLeft className="w-5 h-5 text-purple-400" />
        </button>

        <h3 className="text-xl font-black text-slate-200 min-w-[180px] text-center">
          {currentMonth.format('MMMM YYYY')}
        </h3>

        {!isCurrentMonth ? (
          <button
            onClick={handleNextMonth}
            className="p-2 rounded-lg hover:bg-slate-700/50 transition-colors"
          >
            <ChevronRight className="w-5 h-5 text-purple-400" />
          </button>
        ) : (
          <div className="w-9" />
        )}
      </div>

      {/* Weekday Headers */}
      <div className="grid grid-cols-7 gap-1 mb-1">
        {weekDays.map(day => (
          <div key={day} className="text-center text-slate-400 text-xs font-semibold py-1">
            {day}
          </div>
        ))}
      </div>

      {/* Calendar Grid */}
      <div className="grid grid-cols-7 gap-1">
        {calendar.map((dayInfo, index) => (
          <motion.button
            key={dayInfo.date}
            initial={{ opacity: 0, scale: 0.8 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ delay: index * 0.01 }}
            onClick={() => {
              if (dayInfo.isCurrentMonth && (dayInfo.isPast || (dayInfo.isToday && dayInfo.isCompleted))) {
                playSound('buttonTap');
                onDayClick(dayInfo.date);
              }
            }}
            disabled={!dayInfo.isCurrentMonth || (!dayInfo.isPast && !(dayInfo.isToday && dayInfo.isCompleted))}
            className={`
              aspect-square rounded-md flex items-center justify-center font-semibold text-xs
              transition-all duration-200 relative
              ${!dayInfo.isCurrentMonth ? 'text-slate-600 cursor-default' : ''}
              ${dayInfo.isCurrentMonth && !dayInfo.isPast && !dayInfo.isToday ? 'text-slate-500 cursor-default' : ''}
              ${dayInfo.isToday ? `bg-gradient-to-br from-purple-500 to-pink-600 text-white shadow-[0_4px_12px_rgba(168,85,247,0.4),0_2px_4px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(255,255,255,0.25)] ${dayInfo.isCompleted ? 'hover:from-purple-600 hover:to-pink-700 hover:shadow-[0_6px_16px_rgba(168,85,247,0.5),0_3px_6px_rgba(0,0,0,0.3)] cursor-pointer' : 'cursor-not-allowed opacity-60'} ${dayInfo.isPerfectSolve ? 'border-2 border-amber-400 shadow-lg shadow-amber-500/30' : ''}` : ''}
              ${dayInfo.isPast && dayInfo.isCurrentMonth && !dayInfo.isToday ?
                dayInfo.isCompleted
                  ? `bg-gradient-to-br from-emerald-500/80 to-green-600/80 text-white hover:from-emerald-600/90 hover:to-green-700/90 cursor-pointer shadow-[0_3px_10px_rgba(16,185,129,0.35),0_1px_4px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(255,255,255,0.2)] ${dayInfo.isPerfectSolve ? 'border-2 border-amber-400 shadow-lg shadow-amber-500/30' : ''}`
                  : 'bg-slate-700/60 text-slate-300 hover:bg-slate-600/60 cursor-pointer shadow-[0_2px_6px_rgba(0,0,0,0.2)]'
                : ''
              }
              ${!dayInfo.isCurrentMonth || (!dayInfo.isPast && !dayInfo.isToday) ? 'opacity-30' : ''}
              ${dayInfo.isToday && !dayInfo.isCompleted ? 'opacity-60' : ''}
            `}
          >
            {dayInfo.day}
            {dayInfo.isCompleted && (
              <span className="absolute top-0.5 right-0.5 text-[10px]">✓</span>
            )}
            {dayInfo.isFailed && (
              <span className="absolute inset-0 flex items-center justify-center text-red-500 font-bold text-sm">✕</span>
            )}
          </motion.button>
        ))}
      </div>

      {/* Legend */}
      <div className="mt-3 flex flex-wrap gap-2 justify-center text-xs">
        <div className="flex items-center gap-1">
          <div className="w-3 h-3 rounded bg-gradient-to-br from-emerald-500 to-green-600"></div>
          <span className="text-slate-400">Completed</span>
        </div>
        {showPerfectLegend && (
          <div className="flex items-center gap-1">
            <div className="w-3 h-3 rounded bg-gradient-to-br from-emerald-500 to-green-600 border border-amber-400"></div>
            <span className="text-slate-400">Perfect Solve</span>
          </div>
        )}
        <div className="flex items-center gap-1">
          <div className="w-3 h-3 rounded bg-slate-700/50 relative">
            <span className="absolute inset-0 flex items-center justify-center text-red-500 text-[8px]">✕</span>
          </div>
          <span className="text-slate-400">Failed</span>
        </div>
        <div className="flex items-center gap-1">
          <div className="w-3 h-3 rounded bg-slate-700/50"></div>
          <span className="text-slate-400">Not Completed</span>
        </div>
        <div className="flex items-center gap-1">
          <div className="w-3 h-3 rounded bg-gradient-to-br from-purple-500 to-pink-600"></div>
          <span className="text-slate-400">Today</span>
        </div>
      </div>
    </div>
  );
}