import React from 'react';
import { motion } from 'framer-motion';
import { PUZZLE_POINTS } from '@/game-mechanics';
import { puzzlePieceRuleText } from './perModeTiles';

// PuzzlePiecesTile — the Puzzle Pieces metric tile (the player-facing name for
// the puzzle-point concept), extracted from DailyPerformanceSlide so the slide
// can decide WHETHER to show it without carrying its markup.
//
// ⚠️ THE CAPTION IS NOT WRITTEN HERE. It comes from `puzzlePieceRuleText`, which
// asks game-mechanics what earns a piece. The tile used to state the rule in a
// string literal — "Complete Daily Challenge with a Perfect Solve" — which made
// it a second source of truth for a rule that lives in
// game-mechanics/puzzlePoints.js and is being re-cut right now (an Expert Daily
// under 37 seconds is to award two pieces). A caption that restates a rule it
// does not own drifts the moment the rule moves. See perModeTiles.js for the
// seam and what game-mechanics has to export to close it.
//
// ⚠️ THE PIECE TOTAL IS ACCOUNT-WIDE, NOT PER MODE. `puzzlePoints` is the
// player's lifetime figure and the ladder it climbs (bronze/silver/gold) is
// account-wide too. That is exactly why the tile is hidden on Easy rather than
// shown with an Easy caption: under an Easy heading the same number reads as an
// Easy total, and Easy deals no power dice so it can contribute none of it.
// `showsPuzzlePieceTile` (perModeTiles.js) owns that decision.
//
/**
 * @param {{ modeKey: string, puzzlePoints: number, delay?: number }} props
 */
export default function PuzzlePiecesTile({ modeKey, puzzlePoints, delay = 0.8 }) {
  const nextTier = puzzlePoints >= PUZZLE_POINTS.GOLD
    ? '∞'
    : puzzlePoints >= PUZZLE_POINTS.SILVER
      ? PUZZLE_POINTS.GOLD
      : puzzlePoints >= PUZZLE_POINTS.BRONZE
        ? PUZZLE_POINTS.SILVER
        : PUZZLE_POINTS.BRONZE;

  return (
    <motion.div
      data-testid="puzzle-pieces-tile"
      data-mode-key={modeKey}
      initial={{ opacity: 0, y: 10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay }}
      className="bg-gradient-to-br from-blue-500/30 to-indigo-600/30 rounded-xl p-4 border-2"
      style={{
        borderColor: 'color-mix(in srgb, var(--u37-blue) 70%, transparent)',
        boxShadow: '0 0 18px -6px var(--u37-blue), inset 0 0 26px -16px var(--u37-blue)',
      }}
    >
      <div className="flex items-center justify-center gap-2 mb-2 min-h-[24px] sm:min-h-[28px]">
        <span className="text-lg">🧩</span>
        <h3 className="text-xs sm:text-sm font-bold text-blue-200 uppercase tracking-wider text-center">Puzzle Pieces</h3>
      </div>
      <div className="text-center mb-2">
        <motion.div
          className="text-2xl sm:text-3xl font-black"
          initial={{ scale: 0 }}
          animate={{ scale: 1 }}
          transition={{ delay: delay + 0.1, type: 'spring', stiffness: 200 }}
          key={puzzlePoints}
        >
          <span className="text-slate-100">{puzzlePoints}</span>
          <span className="text-slate-400 mx-1">/</span>
          <span className={`${puzzlePoints >= PUZZLE_POINTS.GOLD ? 'text-amber-300' :
            puzzlePoints >= PUZZLE_POINTS.SILVER ? 'bg-gradient-to-r from-yellow-300 via-amber-400 to-yellow-300 bg-clip-text text-transparent animate-pulse' :
              puzzlePoints >= PUZZLE_POINTS.BRONZE ? 'bg-gradient-to-r from-slate-300 via-slate-100 to-slate-300 bg-clip-text text-transparent' :
                'bg-gradient-to-r from-amber-400 via-orange-500 to-amber-400 bg-clip-text text-transparent animate-pulse'
            }`}>
            {nextTier}
          </span>
        </motion.div>
      </div>
      <p className="text-[10px] text-blue-100/80 text-center leading-tight">
        {puzzlePieceRuleText(modeKey)}
      </p>
    </motion.div>
  );
}
