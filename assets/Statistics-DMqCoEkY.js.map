import React from 'react';
import { motion } from 'framer-motion';
import { Sparkles, ArrowRight } from 'lucide-react';
import { Button } from '@/ui/primitives/button';

// Friendly empty-state for a GUEST viewing their own stats (2026-07-09, David
// V11). A guest has no server-side stats, so the stats edge call fails — which
// used to render the scary amber StatsLoadError ("temporary problem reaching the
// server"). For a brand-new guest that's misleading: nothing is wrong, they just
// haven't made an account yet. Only shown for a guest's OWN stats; a genuine
// load failure for a credentialed user still shows StatsLoadError.
//
// It used to point at the blue "Save Stats" button on the home screen. That
// button is gone (David, 2026-10-10), so the CTA now opens the signup itself
// via the app-wide 'openSaveStats' event Layout listens for. "Go to Home"
// stays as the quiet second option.
export default function GuestStatsPrompt({ onGoHome }) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 8 }}
      animate={{ opacity: 1, y: 0 }}
      className="max-w-md mx-auto mt-12 rounded-2xl p-6 text-center
        border shadow-[0_8px_24px_rgba(0,0,0,0.4)]"
      style={{
        background: 'var(--u37-panel-bg)',
        borderColor: 'color-mix(in srgb, var(--u37-cyan) 45%, transparent)',
      }}
    >
      <div className="flex justify-center mb-3">
        <Sparkles className="w-10 h-10" style={{ color: 'var(--u37-cyan)' }} />
      </div>
      <h2 className="text-xl font-black text-white mb-2">Start tracking your stats!</h2>
      <p className="text-slate-300 text-sm mb-5">
        You&apos;re playing as a guest, so nothing&apos;s saved yet. Create a free
        account — just a username and password — and your daily challenges,
        streaks, and podium finishes will show up right here.
      </p>
      <Button
        data-testid="guest-stats-create"
        onClick={() => window.dispatchEvent(new CustomEvent('openSaveStats'))}
        className="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500
          text-white border border-cyan-400/50 min-h-[48px] px-6 touch-manipulation shadow-lg"
      >
        Create free account
        <ArrowRight className="w-4 h-4 ml-2" />
      </Button>
      <button
        type="button"
        onClick={onGoHome}
        className="block mx-auto mt-3 min-h-[44px] px-4 text-sm text-slate-400 hover:text-white touch-manipulation"
      >
        Go to Home
      </button>
    </motion.div>
  );
}
