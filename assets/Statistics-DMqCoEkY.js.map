import React from 'react';
import { motion } from 'framer-motion';
import { Link } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { PlayerBadges } from '@/components/profile';

// StatsPageHeader — the identity strip at the top of the Statistics page: the
// country-flag avatar (falling back to the 37 mark), the title, and — own-view
// only — the points badges.
//
// WHY IT IS ITS OWN COMPONENT. It was ~80 lines of markup inline in
// Statistics.jsx, which sits under a HARD 800-line structural cap that is not
// grandfathered (only pages/Game.jsx is). The page had ~27 lines of headroom, so
// any further work on it had to start by giving something back. This block was
// the obvious tenant: it reads nothing from the page's state machine beyond four
// already-resolved values, has no effects, and is the one region of the page
// that is NOT about a Daily mode — which makes it the clean cut when the rest of
// the page is being scoped to a tier.
//
// It is deliberately NOT player-agnostic in the FeaturedBadges sense: it renders
// three different titles depending on whose stats these are, and the "← Back to
// Profile" link is the other-player path. That branching is the whole component.
//
// PRIVACY: the back-link addresses the player by `id`, never by email (David,
// 2026-07-13 — player emails must never be viewable), and OtherProfile only
// reads `?id=` anyway, so an `?email=` link loaded a blank page.

/**
 * @param {{
 *   user?: { username?: string, country?: string } | null,
 *   isOwnStats: boolean,
 *   idParam?: string | null,      // the ?id= of the player being viewed, if any
 *   puzzlePoints: number,
 *   battlePoints: number,
 * }} props
 */
export default function StatsPageHeader({ user, isOwnStats, idParam, puzzlePoints, battlePoints }) {
  const titleClass = 'text-2xl font-black bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400 bg-clip-text text-transparent';

  return (
    <motion.div
      data-testid="stats-page-header"
      initial={{ opacity: 0, y: -20 }}
      animate={{ opacity: 1, y: 0 }}
      className="flex items-center gap-3 sm:gap-4 mb-3 sm:mb-4"
    >
      {/* Top-left back button removed (item E, 2026-07-26): the bottom nav bar is
          now the primary navigation, so a Game back button was redundant here. */}
      <div className="flex items-center gap-2 sm:gap-3">
        <div className="w-10 h-10 rounded-full bg-slate-700/50 flex items-center justify-center border-2 border-slate-600 overflow-hidden">
          {user?.country ? (
            <img
              src={`https://flagcdn.com/w80/${user.country?.toLowerCase()}.png`}
              alt="Country flag"
              className="w-full h-full object-cover"
            />
          ) : (
            <svg viewBox="0 0 100 100" className="w-8 h-8">
              <text x="50" y="50" fontSize="48" fontWeight="900" textAnchor="middle" dominantBaseline="central" fill="url(#gradient)">
                37
              </text>
              <defs>
                <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stopColor="#fbbf24" />
                  <stop offset="50%" stopColor="#fcd34d" />
                  <stop offset="100%" stopColor="#fb923c" />
                </linearGradient>
              </defs>
            </svg>
          )}
        </div>
        <div>
          {!isOwnStats ? (
            <div>
              <Link
                to={`${createPageUrl('OtherProfile')}?id=${idParam}&returnTo=Statistics`}
                className="text-slate-400 hover:text-white text-xs block"
              >
                ← Back to Profile
              </Link>
              <div data-testid="stats-page-title" className={titleClass}>
                {user?.username || 'Player'}'s Stats
              </div>
            </div>
          ) : user?.username ? (
            <>
              <div data-testid="stats-page-title" className={titleClass}>
                {user.username}{user.username.endsWith('s') ? "'" : "'s"} Statistics
              </div>
              <div className="flex items-center gap-2">
                <PlayerBadges puzzlePoints={puzzlePoints} battlePoints={battlePoints} size="xl" />
              </div>
            </>
          ) : (
            <h1 data-testid="stats-page-title" className={titleClass}>
              Statistics
            </h1>
          )}
        </div>
      </div>
    </motion.div>
  );
}
