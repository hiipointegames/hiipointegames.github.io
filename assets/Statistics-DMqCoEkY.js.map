import React from 'react';
import { motion } from 'framer-motion';
import { dailyModeLabel } from './dailyModeStats';

// PerfectSolveTile — the Perfect Solves metric tile on the Daily Performance
// slide, for the ONE Daily the figure means anything on.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY BOTH NUMBERS, AND WHY ON ONE LINE
// ─────────────────────────────────────────────────────────────────────────────
// David asked for the count AND the share together — *"have it show perfect
// solves percentage and totals in the same tab. do it classy like."* The two
// answer different questions and neither replaces the other: the count is what
// you have done, the share is how often you do it. A player with 12 perfect
// solves out of 30 and a player with 12 out of 200 have the same tile without
// the share, and the same tile without the count if they have both solved 40%.
//
// They sit on ONE baseline, separated by a hairline, because two big numbers
// stacked read as two tiles crammed into one — and this tile shares a row with
// Puzzle Pieces, whose hero is also a pair (`50 / 111`). The count keeps the
// full weight of the other tiles' hero figures; the share is deliberately a
// step down in size and painted in the tile's own amber, so the eye takes the
// count first and the share as its qualifier.
//
// ⚠️ WHICH MODES GET THIS TILE IS NOT DECIDED HERE. `showsPerfectSolveTile`
// (perModeTiles.js) owns that, derived from game-modes: a mode with no power
// dice cannot reach a perfect solve, and a mode that REQUIRES one can never be
// below 100%. Both were rendered before and both were noise.
//
// ⚠️ NO PERCENTAGE UNTIL THERE IS A DENOMINATOR. `percentage: null` means "no
// solves yet", which is not the same fact as 0% and must not be drawn as one —
// the same distinction StreakCard draws with `tracked`.
//
/**
 * @param {{
 *   modeKey: string,
 *   summary: {count: number, completed: number, percentage: number|null},
 *   delay?: number,
 * }} props
 */
export default function PerfectSolveTile({ modeKey, summary, delay = 0.75 }) {
  const { count, completed, percentage } = summary;
  const label = dailyModeLabel(modeKey);

  return (
    <motion.div
      data-testid="perfect-solve-tile"
      data-mode-key={modeKey}
      data-perfect-count={String(count)}
      data-perfect-percentage={percentage === null ? '' : String(percentage)}
      initial={{ opacity: 0, y: 10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay }}
      className="bg-gradient-to-br from-amber-500/30 to-orange-600/30 rounded-xl p-4 border-2"
      style={{
        borderColor: 'color-mix(in srgb, var(--u37-gold) 70%, transparent)',
        boxShadow: '0 0 18px -6px var(--u37-gold), inset 0 0 26px -16px var(--u37-gold)',
      }}
    >
      <div className="flex items-center justify-center gap-2 mb-2 min-h-[24px] sm:min-h-[28px]">
        <span className="text-lg">🎯</span>
        <h3 className="text-xs sm:text-sm font-bold text-amber-200 uppercase tracking-wider text-center">Perfect Solves</h3>
      </div>

      <div className="text-center mb-2">
        <motion.div
          className="flex items-baseline justify-center gap-2"
          initial={{ scale: 0 }}
          animate={{ scale: 1 }}
          transition={{ delay: delay + 0.05, type: 'spring', stiffness: 200 }}
          key={`${count}-${percentage}`}
        >
          <span className="text-2xl sm:text-3xl font-black text-slate-100">{count}</span>
          {percentage !== null && (
            <>
              {/* A hairline, not a slash: `12 / 40%` reads as a fraction, and
                  these two are not one. */}
              <span
                aria-hidden="true"
                className="inline-block w-px self-stretch my-1"
                style={{ background: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)' }}
              />
              <span className="text-lg sm:text-xl font-black text-amber-200">{percentage}%</span>
            </>
          )}
        </motion.div>
      </div>

      <p className="text-[10px] text-amber-100/80 text-center leading-tight">
        {completed > 0
          ? `of ${completed} ${label} solve${completed === 1 ? '' : 's'} — all 3 power dice correct`
          : `No ${label} solves yet`}
      </p>
    </motion.div>
  );
}
