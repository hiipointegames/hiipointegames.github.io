import React from 'react';
import { motion } from 'framer-motion';
import { hasPerfectConcept, DAILY_MODE_KEYS } from '@/game-modes';
import {
  completedDatesFromTimes,
  visibleCompletedDates,
  perfectSolveDatesFromTimes,
} from '@/stats-aggregation';
import CalendarView from './CalendarView';
import DailyModeTabs from './DailyModeTabs';
import { filterByMode, dailyModeFullLabel, normalizeDailyMode, dailyModeAccent, dailyModeTheme } from './dailyModeStats';

// CalendarSlide — the "Past Challenges" slide, extracted from Statistics.jsx and
// re-cut for three Dailies (D3).
//
// ─────────────────────────────────────────────────────────────────────────────
// A DAY NOW HAS UP TO THREE OUTCOMES
// ─────────────────────────────────────────────────────────────────────────────
// The calendar painted a day green from a mode-blind row set, so a square went
// green because ONE of three modes was solved and gold because ONE was perfect.
// A green square stopped meaning anything specific — which is worse than showing
// less, because the player cannot tell that it is wrong.
//
// It is now scoped to ONE mode at a time, chosen above the grid. Three calendars
// stacked would not fit a phone, and a legend that had to encode 3 modes x
// 3 outcomes would be unreadable at this cell size.
//
// EVERY DERIVATION IS SCOPED, NOT JUST THE COMPLETIONS. The failed-day crosses
// come from the attempts log and the gold rings from the times log; leaving
// either mode-blind would put a red X or a gold ring from Expert onto Easy's
// calendar, which is the same defect wearing a different colour.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE ANTI-CHEAT GATE IS PER MODE TOO
// ─────────────────────────────────────────────────────────────────────────────
// `viewerCanSeeTodayByMode` is a record, not a boolean. Finishing Easy earns the
// right to see today's EASY answers and nothing else — un-scoped, a player could
// forfeit Easy in one tap at 00:01 and read the day's Challenge and Expert
// solutions before attempting either. The page resolves the three gates; this
// component only picks the one matching the mode on screen.
//
// ─────────────────────────────────────────────────────────────────────────────
// EASY HAS NO GOLD
// ─────────────────────────────────────────────────────────────────────────────
// A perfect solve is arithmetically unreachable on Easy's all-white dice, so
// `perfectSolveDatesFromTimes` returns [] for it — and the "Perfect Solve" key
// is dropped from the legend rather than left standing over a colour that can
// never appear. A legend entry for an impossible outcome reads as a challenge
// the player is failing.

/**
 * @param {{
 *   mode: string,
 *   onModeChange: (modeKey: string) => void,
 *   dailyChallengeTimes: any[],
 *   attempts: any[],                                 // daily_challenge_attempts rows
 *   viewerCanSeeTodayByMode: Record<string, boolean>,
 *   todayDate: string,
 *   selectedMonth: string,
 *   onMonthChange: (month: string) => void,
 *   onDayClick: (date: string) => void,
 *   expanded?: boolean,
 * }} props
 */
export default function CalendarSlide({
  mode,
  onModeChange,
  dailyChallengeTimes,
  attempts,
  viewerCanSeeTodayByMode,
  todayDate,
  selectedMonth,
  onMonthChange,
  onDayClick,
  expanded = true,
}) {
  const modeKey = normalizeDailyMode(mode);
  const accent = dailyModeAccent(modeKey);
  const times = filterByMode(dailyChallengeTimes, modeKey);

  const completedDates = completedDatesFromTimes(times, modeKey);
  const userCompletedDates = visibleCompletedDates(
    completedDates,
    todayDate,
    viewerCanSeeTodayByMode?.[modeKey] === true,
  );
  const perfectSolveDates = perfectSolveDatesFromTimes(times, modeKey);
  const userFailedDates = filterByMode(attempts, modeKey)
    .filter(a => a?.forfeited === true)
    .map(a => a.date);

  // A mode with no rows at all is the normal state today, not an error: prod has
  // one puzzle per date until the three-a-night cron is unheld.
  //
  // Read from DAILY_MODE_KEYS, never a literal list. The hand-rolled copy that
  // was here is exactly the drift this file's own header forbids ("nothing here
  // hard-codes which modes exist"): a fourth Daily added to game-modes would get
  // a tab from DailyModeTabs -- which DOES map DAILY_MODE_KEYS -- and then be
  // silently absent from the emptiness check behind it, so its tab would present
  // an all-zero calendar as a record of failure rather than as "no data yet".
  const emptyModes = DAILY_MODE_KEYS.filter(
    key => filterByMode(dailyChallengeTimes, key).length === 0,
  );

  return (
    // COLOUR FOLLOWS THE TIER. Before this, the "Past Challenges" card frame was
    // pinned to `var(--u37-green)` -- which is EASY's tier colour -- so an
    // Expert calendar was framed in Easy's green while claiming to be Expert.
    // That is worse than no colour: it is a confident wrong answer.
    //
    // `data-accent` mirrors what `data-mode` resolves to (happy-dom drops
    // `color-mix()`, so the inline styles are not assertable).
    <motion.div
      data-testid="calendar-slide"
      data-mode={dailyModeTheme(modeKey)}
      data-accent={accent}
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: 0.3 }}
      className="p-0 mb-0"
    >
      <DailyModeTabs
        value={modeKey}
        onChange={onModeChange}
        emptyModes={emptyModes}
        ariaLabel="Choose which Daily the calendar shows"
      />

      {/* 2A: discoverability hint — the calendar is interactive, not read-only.
          It now also names the mode, so a green square is never ambiguous. */}
      <p
        data-testid="calendar-mode-hint"
        className="text-sm mb-3"
        id="daily-mode-panel"
        style={{ color: accent }}
      >
        Tap any date to see your {dailyModeFullLabel(modeKey)} solve.
      </p>

      {expanded && (
        <motion.div
          initial={{ opacity: 0, height: 0 }}
          animate={{ opacity: 1, height: 'auto' }}
          exit={{ opacity: 0, height: 0 }}
        >
          <CalendarView
            onDayClick={onDayClick}
            userCompletedDates={userCompletedDates}
            selectedMonth={selectedMonth}
            onMonthChange={onMonthChange}
            userFailedDates={userFailedDates}
            perfectSolveDates={perfectSolveDates}
            showPerfectLegend={hasPerfectConcept(modeKey)}
          />
          {completedDates.length === 0 && (
            <p className="text-center text-slate-400 text-xs mt-3 leading-relaxed">
              No {dailyModeFullLabel(modeKey)} solves yet.
            </p>
          )}
        </motion.div>
      )}
    </motion.div>
  );
}
