// Read-side derivation for the Statistics "this week" bar chart + its summary
// counters. Pure — extracted from Statistics.jsx (inline render-body consts).

/**
 * @typedef {Object} WeekDay
 * @property {string} date - `YYYY-MM-DD`.
 * @property {string} [dayName] - short weekday label (passed through).
 * @property {string} [displayDate] - `M/D` label (passed through).
 * @property {boolean} isPast - whether the day is on/before today.
 */

/**
 * Map each of the week's 7 days to exactly one status — `completed`,
 * `forfeited`, `none` (a past day with no attempt), or `upcoming` (a future
 * day). Forfeits are authoritative from the attempt log (`userFailedDates`); a
 * completion is a NON-forfeited day with a recorded time (so a forfeit never
 * counts as a completion even if a stale time row exists).
 *
 * @param {WeekDay[]} weekDays - the 7 day descriptors (carry `isPast`).
 * @param {Array<{date: string, time?: number|null}>|null|undefined} dailyChallengeTimes
 *   the player's recorded daily times.
 * @param {string[]} userFailedDates - dates the player forfeited.
 * @returns {Array<WeekDay & {time: number|null, completed: boolean, forfeited: boolean, status: string}>}
 */
export function buildWeekData(weekDays, dailyChallengeTimes, userFailedDates) {
  return weekDays.map(day => {
    const row = dailyChallengeTimes?.find(t => t.date === day.date);
    const forfeited = userFailedDates.includes(day.date);
    const timeValue = !forfeited && row?.time != null ? row.time : null;
    const completed = timeValue != null;
    const status = forfeited
      ? 'forfeited'
      : completed
        ? 'completed'
        : day.isPast
          ? 'none'
          : 'upcoming';
    return { ...day, time: timeValue, completed, forfeited, status };
  });
}

/**
 * Summary counters for a week's rows. Only real, non-forfeited completions
 * count — a forfeit is not a completion, and the average is over completions
 * with a positive time only.
 *
 * @param {Array<{completed: boolean, forfeited: boolean, status: string, time: number|null}>} weekData
 * @returns {{completedPuzzles: number, forfeitedCount: number, avgTime: number}}
 */
export function summarizeWeek(weekData) {
  const completedWithTime = weekData.filter(d => d.completed && d.time > 0);
  const completedPuzzles = weekData.filter(d => d.completed).length;
  const forfeitedCount = weekData.filter(d => d.status === 'forfeited').length;
  const avgTime = completedWithTime.length > 0
    ? completedWithTime.reduce((sum, d) => sum + d.time, 0) / completedWithTime.length
    : 0;
  return { completedPuzzles, forfeitedCount, avgTime };
}
