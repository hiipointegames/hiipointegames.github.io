import React from 'react';
import { motion } from 'framer-motion';
import { DAILY_MODE_KEYS } from '@/game-modes';
import { dailyModeLabel, dailyModeAccent, solveCountsByMode } from './dailyModeStats';

// "Solves by Mode" — REBUILT for three Dailies (D1/D2).
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT WAS WRONG WITH IT, WHICH IS WHY DAVID CALLED THE PAGE OBSOLETE
// ─────────────────────────────────────────────────────────────────────────────
// It drew four bars — Total / Easy / Challenge / Daily — and had two defects
// that three Dailies turn from untidy into wrong:
//
//   1. TWO AXES ON ONE CHART. Easy and Challenge are counts of UNTIMED,
//      UNLIMITED practice solves; Daily is a count of TIMED, once-a-day ranked
//      rounds. A player who practises a lot and a player who never misses a
//      Daily produced the same-looking chart, and no reading of it was correct.
//
//   2. EVERY BAR WAS A SHARE OF THEIR OWN SUM. `pct(v) = v / totalSolved`, where
//      totalSolved is easy + challenge + daily. So a bar could only move by
//      another bar moving. Under three Dailies the Daily count silently became
//      the sum of three different games, which inflated the denominator — and a
//      player's Easy PRACTICE bar shrank because the Expert Daily now existed.
//      Nothing about their Easy play changed.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT REPLACES IT
// ─────────────────────────────────────────────────────────────────────────────
// Two groups, each with its OWN denominator, and a plain headline total instead
// of a 100%-wide "Total" bar that carried no information.
//
//   THE DAILY   — one bar per Daily mode, each a share of the Daily total.
//   PRACTICE    — one bar per practice mode, each a share of the practice total.
//
// Comparing within a group is now meaningful and comparing across groups is no
// longer offered, which is the honest arrangement: they are different games.
//
// The Daily group is driven by DAILY_MODE_KEYS, so it cannot forget a mode, and
// its labels and accents derive from the mode rather than a local table.
//
// ⚠️ THERE IS NO PERFECT-SOLVE BAR HERE, deliberately. Perfect solves are not
// comparable across these modes — Easy has no perfect-solve concept at all
// (all-white dice make it arithmetically unreachable), so a per-mode perfect bar
// would render Easy as a zero, reading as a failure at something impossible.
// Perfect-solve state lives on the Daily Performance slide, per mode, where the
// Easy case can be stated rather than implied.

/**
 * One labelled progress bar. `widthPct` is the animated fill target (a CSS width
 * string); `accent` is a `var(--u37-*)` token driving both label and fill.
 */
function ModeBar({ label, value, widthPct, accent, delay }) {
  return (
    <div>
      <div className="flex justify-between items-center mb-1.5">
        <span className="font-semibold text-sm" style={{ color: accent }}>{label}</span>
        <span className="text-slate-200 text-lg font-bold">{value}</span>
      </div>
      <div className="w-full bg-slate-700 rounded-full h-2 overflow-hidden">
        <motion.div
          initial={{ width: 0 }}
          animate={{ width: widthPct }}
          transition={{ delay, duration: 0.8, ease: 'easeOut' }}
          className="h-full rounded-full"
          style={{ background: accent }}
        />
      </div>
    </div>
  );
}

/** A group of bars sharing one denominator, named so the denominator is visible. */
function BarGroup({ heading, caption, rows, total, startDelay }) {
  const pct = (v) => (total > 0 ? `${(v / total) * 100}%` : '0%');
  return (
    <div className="mb-5 last:mb-0">
      <div className="flex items-baseline justify-between mb-2">
        <h3 className="text-xs font-black uppercase tracking-wider text-slate-300">{heading}</h3>
        <span className="text-slate-400 text-xs font-semibold">{total} total</span>
      </div>
      <p className="text-[10px] text-slate-500 mb-3 leading-tight">{caption}</p>
      <div className="space-y-3">
        {rows.map((row, i) => (
          <ModeBar
            key={row.key}
            label={row.label}
            value={row.value}
            widthPct={pct(row.value)}
            accent={row.accent}
            delay={startDelay + i * 0.05}
          />
        ))}
      </div>
    </div>
  );
}

/**
 * @param {{
 *   stats: any,
 *   expanded?: boolean,
 *   dailySolvesByMode?: Record<string, number>,  // derived from the times log
 * }} props
 */
export default function ModeBreakdown({ stats, expanded = true, dailySolvesByMode }) {
  // The page passes counts it has already derived; absent one, derive from the
  // times rows on `stats` rather than rendering three zeroes. Same source either
  // way — the times log — so the two paths cannot disagree.
  const dailyCounts = dailySolvesByMode ?? solveCountsByMode(stats.dailyChallengeTimes).byMode;

  const dailyRows = DAILY_MODE_KEYS.map((modeKey) => ({
    key: modeKey,
    label: dailyModeLabel(modeKey),
    value: dailyCounts[modeKey] || 0,
    accent: dailyModeAccent(modeKey),
  }));
  const dailyTotal = dailyRows.reduce((n, r) => n + r.value, 0);

  // Practice counters are per DIFFICULTY, not per wire key — 'easy'/'challenge'
  // are the practice keys and Expert practice has no UI yet, so it is listed
  // only once it has a counter rather than shown as a permanent zero.
  const practiceRows = [
    { key: 'easy', label: 'Easy', value: stats.easySolved || 0, accent: 'var(--u37-green)' },
    { key: 'challenge', label: 'Challenge', value: stats.challengeSolved || 0, accent: 'var(--u37-cyan)' },
    ...(stats.expertSolved ? [{ key: 'expert', label: 'Expert', value: stats.expertSolved, accent: 'var(--u37-magenta)' }] : []),
  ];
  const practiceTotal = practiceRows.reduce((n, r) => n + r.value, 0);

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: 0.4 }}
      className="p-0"
    >
      {expanded && (
        <motion.div
          initial={{ opacity: 0, height: 0 }}
          animate={{ opacity: 1, height: 'auto' }}
          exit={{ opacity: 0, height: 0 }}
        >
          {/* The headline total, as a number rather than a 100%-wide bar. A bar
              that is always full length says nothing; the figure it carried is
              the only part worth keeping. */}
          <div className="mb-5 text-center">
            <div className="text-4xl font-black text-amber-400">{dailyTotal + practiceTotal}</div>
            <div className="text-[11px] uppercase tracking-wider text-slate-400 font-bold mt-0.5">
              Total puzzles solved
            </div>
          </div>

          <BarGroup
            heading="The Daily"
            caption="Timed, once a day, ranked. Each bar is a share of your Daily solves."
            rows={dailyRows}
            total={dailyTotal}
            startDelay={0.6}
          />

          <div className="border-t border-slate-700/60 pt-4">
            <BarGroup
              heading="Practice"
              caption="Untimed and unlimited, off the leaderboard. Each bar is a share of your practice solves."
              rows={practiceRows}
              total={practiceTotal}
              startDelay={0.75}
            />
          </div>
        </motion.div>
      )}
    </motion.div>
  );
}
