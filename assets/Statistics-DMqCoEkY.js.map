// Blitz-stats slide config for the Stats carousel (L2-1 uniformity fix).
//
// Before: an OTHER player's "View Full Stats" showed a Blitz "Battle Stats"
// slide as a mid-carousel BUTTON (2nd page) that opened a modal, while your OWN
// stats showed Blitz as an INLINE slide at the END. Same information, two
// different positions and two different layouts — the page order didn't line up
// between the two views.
//
// After: the Blitz slide renders IDENTICALLY in both views — same label, same
// accent, same `id` (so ?card=blitz still deep-links), same inline layout, same
// LAST position in the carousel. The only thing that varies is whose stats load:
// your own (opponentId = null → HeadToHeadStats reads the current user) vs the
// player you're viewing (opponentId = viewingId).
//
// Keeping this decision in one pure function pins the uniformity: a future edit
// can't silently reintroduce an other-player-only special case without failing
// the test.

export const BLITZ_SLIDE_LABEL = 'Blitz Stats';
export const BLITZ_SLIDE_ACCENT = 'var(--u37-magenta)';
export const BLITZ_SLIDE_ID = 'blitz';

/**
 * @param {{ isOwnStats: boolean, viewingId?: string | null }} args
 * @returns {{ label: string, accent: string, id: string, inline: true, opponentId: string | null }}
 *   The slide's presentation is identical for own vs other; only `opponentId`
 *   differs (null for your own stats, the viewed player's id otherwise).
 */
export function getBlitzSlideConfig({ isOwnStats, viewingId = null }) {
  return {
    label: BLITZ_SLIDE_LABEL,
    accent: BLITZ_SLIDE_ACCENT,
    id: BLITZ_SLIDE_ID,
    inline: true,
    opponentId: isOwnStats ? null : (viewingId ?? null),
  };
}
