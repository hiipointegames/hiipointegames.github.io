
import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { HeadToHeadStats } from '@/head-to-head';
import { useNavigate, useSearchParams } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { apiClient } from '@/transport';
import { useAuth } from '@/auth';
import moment from 'moment';
import 'moment-timezone';
import { nowET, todayET, canViewerSeeToday } from '@/daily-challenge';
import CalendarSlide from '@/components/stats/CalendarSlide';
import DailyChallengeModal from '@/components/stats/DailyChallengeModal';
import WeeklyPerformanceGraph from '@/components/stats/WeeklyPerformanceGraph';
import DailyPerformanceSlide from '@/components/stats/DailyPerformanceSlide';
import ModeBreakdown from '@/components/stats/ModeBreakdown';
import { shouldPromptGuestCreateAccount, shouldShowSecureBanner } from '@/components/stats/statsGate';
import StatsCarousel, { StatsSlide } from '@/components/stats/StatsCarousel';
import { getBlitzSlideConfig } from '@/components/stats/blitzSlide';
import { useDayModal } from '@/components/stats/useDayModal';
import StatsPageHeader from '@/components/stats/StatsPageHeader';

import { getLeaderboard, getPlayerStats, countDailySolves, computeCompletionRates, getCraftBadgeState, getBlitzBadgeState, getExistingBadgeState } from '@/stats-aggregation';
import { DAILY_MODE_KEYS } from '@/game-modes';
import { readPerModeStats, solveCountsByMode, completionRatesByMode, filterByMode, rowModeKey, dailyModeAccent } from '@/components/stats/dailyModeStats';

// Badge System Redesign (Lane G): the L1 overview slide + the launch/earn
// celebrations. FeaturedBadges is presentational and player-agnostic (the
// OtherProfile card mounts the same component); this page only resolves WHOSE
// badges to load and owns the own-player celebration queue.
import FeaturedBadges from '@/components/stats/FeaturedBadges';
import { buildBadgeStateIndex } from '@/components/stats/badgeShowcaseModel';
import { AwardCelebrationSequence, RetroactiveBadgeMoment, badgesUrlForAwards, sealBadgeFirstRun, readEarnedStamps, stampEarnedBadges, planBadgeAnnouncement, readAnnouncedAwards, badgeSnapshotFromRecord, badgeSnapshotAwards, badgesAreFirstRun, markBadgeRetroShown, mergeAnnouncedAwards, writeAnnouncedAwards } from '@/game-flow';
import { reportedFallback } from '@/observability';

export default function Statistics() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const idParam = searchParams.get('id');
  const emailParam = searchParams.get('email');
  const [isOwnStats, setIsOwnStats] = useState(!emailParam && !idParam);
  const [stats, setStats] = useState({
    totalGamesPlayed: 0,
    totalSolved: 0,
    easySolved: 0,
    challengeSolved: 0,
    dailyChallengeSolved: 0,
    currentStreak: 0,
    bestStreak: 0,
    easyDailyStreak: 0,
    challengeDailyStreak: 0,
    dailyChallengeStreak: 0,
    longestDailyChallengeStreak: 0,
    podiumFinishes: { first: 0, second: 0, third: 0 },
    reachedMilestones: [],
    perfectStreakMilestones: {},
    lifetimeAvgTime: 0,
    lifetimeCompletedCount: 0,
    timeMilestones: {},
    fastestTimeMilestones: {},
    dailyChallengeTimes: []
  });
  const [loading, setLoading] = useState(true);
  // loadError: the stats edge call failed (vs. a genuine zero-stats player).
  // Drives the inline StatsLoadError card so an outage is visible, not silent.
  const [loadError, setLoadError] = useState(false);
  // isGuestOwnStats: a guest viewing their OWN stats has nothing saved server-side,
  // so the load would fail — show the friendly GuestStatsPrompt (create-an-account
  // CTA) instead of the scary StatsLoadError outage card. (David V11.)
  const [isGuestOwnStats, setIsGuestOwnStats] = useState(false);
  // Named-but-unsecured own-view: stats load, plus a "secure your account" nudge.
  const [showSecureBanner, setShowSecureBanner] = useState(false);
  // reloadKey: bumped by the Retry button to re-run the load effect.
  const [reloadKey, setReloadKey] = useState(0);
  const [leaderboard, setLeaderboard] = useState([]);
  const [userEmail, setUserEmail] = useState('');
  const [user, setUser] = useState(null);
  // ANTI-CHEAT, PER MODE (D3/D8). A record, never a boolean: finishing Easy
  // earns the right to see today's EASY answers and nothing else. Un-scoped, a
  // player could forfeit Easy in one tap at 00:01 and read the whole field's
  // Challenge and Expert solutions before attempting either.
  const [viewerCanSeeTodayByMode, setViewerCanSeeTodayByMode] = useState(
    /** @type {Record<string, boolean>} */({}),
  );
  // ONE page-level Daily mode, shared by the Daily Performance slide, the
  // calendar and the day modal. Two selectors for one concept would let the page
  // disagree with itself about which game you are looking at.
  const [dailyMode, setDailyMode] = useState('daily');
  const [selectedMonth, setSelectedMonth] = useState(nowET().format('YYYY-MM'));
  const [pastChallenges, setPastChallenges] = useState([]);
  const [userSolutions, setUserSolutions] = useState({});
  // (L2-1) `viewingEmail` state removed — it only gated the opponent
  // Head-to-Head modal, which the uniform inline Blitz slide replaced.
  // 2H: every section opens fully by default — no expand/collapse. Kept as a
  // constant (was useState) so the existing `expandedSections.X && (...)` gates
  // always render their content and the collapse chevrons could be removed.
  const expandedSections = {
    dailyChallenge: true,
    performance: true,
    calendar: true,
    modeBreakdown: true,
  };

  const [viewingId, setViewingId] = useState(null);
  const [selectedWeekOffset, setSelectedWeekOffset] = useState(0);
  const [puzzlePoints, setPuzzlePoints] = useState(0);
  const [battlePoints, setBattlePoints] = useState(0);
  // Badge System Redesign state. `badgeTargetId` is the resolved player whose
  // badges to derive (own or ?id=), set once loadStats knows who that is.
  const [badgeTargetId, setBadgeTargetId] = useState(null);
  const [badgeState, setBadgeState] = useState({});
  const [badgesLoading, setBadgesLoading] = useState(true);
  // The two celebration queues, own-player only. `retroBadgeAwards` is the ONE
  // launch moment; `liveBadgeAwards` are per-earn pops. `badgeSnapshot` is what
  // gets persisted once a queue drains, so nothing is ever announced twice.
  const [retroBadgeAwards, setRetroBadgeAwards] = useState([]);
  const [liveBadgeAwards, setLiveBadgeAwards] = useState([]);
  const [badgeSnapshot, setBadgeSnapshot] = useState(null);
  const [completionPercentage, setCompletionPercentage] = useState(0);
  const [totalAttempts, setTotalAttempts] = useState(0);
  const [currentStreak, setCurrentStreak] = useState(0);
  const [userFailedDates, setUserFailedDates] = useState([]);
  // The raw daily_challenge_attempts rows — they carry `mode`, which the
  // date-only list cannot.
  const [attempts, setAttempts] = useState([]);

  const { isLoadingAuth } = useAuth();

  useEffect(() => {
    const loadStats = async () => {
      // Don't try to fetch stats if auth is still initializing
      // Otherwise it falls back to anonKey, gets 401, and auto-logs out
      if (isLoadingAuth) return;

      try {
        setLoading(true);
        setLoadError(false);
        // Check if viewing another user's stats
        const currentUser = await apiClient.auth.me();

        const targetUserId = idParam || currentUser.id;
        const viewingOwnStats = targetUserId === currentUser.id;

        // Fresh guest (no username) → nothing to load, show the create-account
        // prompt. A NAMED account owns a profile + history that load fine, so it is
        // NOT short-circuited even while unsecured (fixes the legacy-username lockout).
        if (shouldPromptGuestCreateAccount({ viewingOwnStats, user: currentUser })) {
          setIsGuestOwnStats(true);
          setIsOwnStats(true);
          setLoading(false);
          // A guest has no saved history to derive badges from, and the badge
          // effect below never runs (no target id) — so clear its spinner here
          // or the Badges slide would load forever.
          setBadgesLoading(false);
          return;
        }
        setIsGuestOwnStats(false);
        setShowSecureBanner(shouldShowSecureBanner({ viewingOwnStats, user: currentUser }));

        // CANONICAL SOURCE: player stats via the stats-aggregation seam.
        const statsResult = await getPlayerStats(targetUserId);
        if (!statsResult.success) {
          // Backend failure (e.g. a dead edge-function key) — surface it instead
          // of painting an all-zero page that looks like erased stats.
          setLoadError(true);
          setLoading(false);
          setBadgesLoading(false);
          return;
        }
        const playerData = statsResult.data;

        // Use game_stats as canonical source
        const gameStats = playerData.game_stats;
        const lifetimeAvgTime = playerData.lifetimeAvgTime || 0;
        const lifetimeCompletedCount = playerData.lifetimeCompletedCount || 0;
        const respPuzzlePoints = playerData.puzzle_points || 0;
        const respBattlePoints = playerData.battle_points || 0;
        const respTotalAttempts = playerData.totalAttempts || 0;

        // Normalize mode-specific counters
        const easySolved = gameStats.easySolved || 0;
        const challengeSolved = gameStats.challengeSolved || 0;

        // Load daily challenge times for the target user
        const dailyTimes = await apiClient.entities.DailyChallengeTime.filter({ user_id: targetUserId });
        const dailyChallengeTimes = dailyTimes.map(t => ({
          date: t.date,
          // WHICH Daily this row is. Dropping it here is what made every
          // downstream surface mode-blind — the column has been selected by
          // DAILY_TIME_PUBLIC_COLUMNS since P3; only the mapper discarded it.
          mode: t.mode,
          time: t.solve_time_seconds,
          forfeited: t.forfeited,
          // Dice fields (leaderboard cols) → authoritative source for the calendar
          // perfect-solve derivation AND the day-modal solution, not the blob (#4).
          equation: t.equation,
          usedDiceIndices: t.usedDiceIndices,
          diceColors: t.diceColors,
          shuffledDice: t.shuffledDice,
        }));

        // 2G FIX: a daily "solve" is a COMPLETED daily, not a forfeit. Counting
        // the raw dailyChallengeTimes length (which includes forfeited rows)
        // overcounted Daily solves and inflated totalSolved — which then skewed
        // the Easy/Challenge percentage bars (each is solved/totalSolved). Count
        // only non-forfeited completions from the forfeit-aware rows we just loaded.
        // Across ALL three Dailies, asked for explicitly (`null`). Getting this
        // total by forgetting an argument is how one number came to stand for
        // three different games — see countDailySolves.
        const dailyChallengeSolved = countDailySolves(dailyChallengeTimes, null);
        const totalSolved = easySolved + challengeSolved + dailyChallengeSolved;

        const normalizedStats = {
          ...gameStats,
          easySolved,
          challengeSolved,
          dailyChallengeSolved,
          totalSolved,
          lifetimeAvgTime,
          lifetimeCompletedCount,
          dailyChallengeTimes // include in stats
        };

        // IMPORTANT: Store current user for checking viewing permissions
        setUser(playerData);
        setUserEmail(playerData.email);
        setIsOwnStats(viewingOwnStats);
        setViewingId(viewingOwnStats ? null : playerData.id);
        setStats(normalizedStats);
        // Hands the resolved player to the badge effect below — the badge
        // derivation reads its own logs, so it runs independently of this load.
        setBadgeTargetId(targetUserId);

        // Calculate current streak from server
        setCurrentStreak(gameStats.dailyChallengeStreak || 0);

        // ANTI-CHEAT: the viewer sees today's entry only if they've finished
        // today themselves (completed or forfeited). One read path in
        // daily-challenge; result held in component state (no window global).
        const todayCheck = todayET();
        try {
          const gates = await Promise.all(
            DAILY_MODE_KEYS.map(k => canViewerSeeToday(currentUser, todayCheck, k)),
          );
          setViewerCanSeeTodayByMode(
            Object.fromEntries(DAILY_MODE_KEYS.map((k, i) => [k, gates[i] === true])),
          );
        } catch (error) {
          console.error('Failed to check viewer status:', error);
          // Fail CLOSED, in every mode. An errored gate must never become an
          // unlock — that is the shape of the bug this gate already had once.
          setViewerCanSeeTodayByMode({});
        }

        setPuzzlePoints(respPuzzlePoints);
        setBattlePoints(respBattlePoints);

        // Calculate rates based on authoritative metadata from edge function
        // puzzlePieceRate is no longer displayed: that tile was puzzle points
        // over attempts, used as a PROXY for perfect solves. It is now a real
        // per-mode perfect-solve COUNT derived from the times log — and the
        // proxy was about to break anyway, since W2-ECONOMY is re-cutting what
        // earns a Puzzle Piece. computeCompletionRates still returns the figure
        // for any caller that wants it.
        const { totalAttempts: totalAttemptsCount, completionRate } =
          computeCompletionRates(lifetimeCompletedCount, respTotalAttempts, respPuzzlePoints);

        setTotalAttempts(totalAttemptsCount);
        setCompletionPercentage(completionRate);

        // Extract failed attempts (forfeited challenges)
        const allAttempts = await apiClient.entities.DailyChallengeAttempt.filter({
          user_id: targetUserId
        });
        // Keep the ROWS, not just the dates: an attempt row carries the mode,
        // and a mode-blind cross on the calendar is the same defect as a
        // mode-blind tick. Consumers that still want dates derive them.
        setAttempts(Array.isArray(allAttempts) ? allAttempts : []);
        setUserFailedDates(allAttempts.filter(a => a.forfeited === true).map(a => a.date));

        // Check for badge upgrades (only for own stats)
        if (viewingOwnStats) {
          // MEDALS ARE NO LONGER ANNOUNCED HERE (David R5, slice 5). The
          // puzzle/battle tier-up celebration moved to the post-solve queue on
          // the game page, where it wears BadgeUpgradeModal's treatment. Leaving
          // this call in place meant a player who solved and then opened Stats
          // saw the SAME medal twice — the double-pop this slice removes.
        }

        // Today's leaderboard is NOT read here — it depends on `dailyMode`, and
        // this effect only re-runs on [idParam, reloadKey]. It lives in its own
        // effect below, keyed on the mode, so switching tier re-reads the board.

        // Load past challenges for last 3 months
        const threeMonthsAgo = nowET().subtract(3, 'months').startOf('month').format('YYYY-MM-DD');
        const challenges = await apiClient.entities.DailyChallenge.list('-date', 200);
        const filteredChallenges = challenges.filter(ch => moment(ch.date).isSameOrAfter(threeMonthsAgo, 'day'));
        setPastChallenges(filteredChallenges);

        // Day-click modal's solution map from the AUTHORITATIVE times rows (they
        // carry equation/dice), not the drift-prone blob — else a completed day
        // missing from the blob opens as "You Missed" despite showing green.
        // Keyed by date AND mode: three rows share a date now, and a date-only
        // key silently kept whichever was written last — so opening a day could
        // show you a different game's solve.
        const solutions = {};
        (dailyChallengeTimes || []).forEach(t => {
          if (t.date) solutions[`${t.date}|${rowModeKey(t)}`] = t;
        });
        setUserSolutions(solutions);
      } catch (error) {
        console.error('Failed to load stats:', error);
        setLoadError(true);
        setBadgesLoading(false); // the badge effect never gets a target id here
      } finally {
        setLoading(false);
      }
    };

    loadStats();
  }, [idParam, reloadKey]);

  // Today's board for the SELECTED Daily, re-read whenever the tier changes.
  //
  // This used to sit inside the mount effect above with no `mode`, so it always
  // fetched Challenge's board. `userRank` is derived from it and drives the 🏆
  // Rank badge in Daily Performance — meaning an Easy or Expert player was
  // ranked against a board they never played, i.e. not found, i.e. rank 0.
  //
  // It cannot simply gain a `mode` argument up there: that effect's deps are
  // [idParam, reloadKey], so it would fetch once on mount and then go stale the
  // moment the player switched tier. Its own effect keyed on `dailyMode` is what
  // makes the badge track the selector.
  useEffect(() => {
    let cancelled = false;
    getLeaderboard({ date: todayET(), mode: dailyMode, enrichProfiles: true })
      .then((rows) => { if (!cancelled) setLeaderboard(rows); })
      // A decorative rank badge must never break the stats page; the existing
      // read was equally non-fatal (it sat inside the mount effect's try).
      .catch(() => { if (!cancelled) setLeaderboard([]); });
    return () => { cancelled = true; };
  }, [dailyMode, reloadKey]);



  // Badge System Redesign — derive the viewed player's badge state, then (own
  // player only) decide what to celebrate.
  //
  // The announcement is a DIFF against a persisted snapshot rather than against
  // a pre-solve state, which makes it idempotent: nothing pops twice across
  // reloads, and a badge earned while the app was closed still gets its moment.
  // On the very first run after launch every earned badge came from history, so
  // they collapse into ONE summary — never a pop-up storm.
  useEffect(() => {
    if (!badgeTargetId) return undefined;
    let cancelled = false;

    const loadBadges = async () => {
      setBadgesLoading(true);
      try {
        // Degrade to "nothing earned" rather than an error: a player seeing
        // their catalog unlit is a far better failure than a blank slide.
        const [craft, blitz, existing] = await Promise.all([
          getCraftBadgeState(badgeTargetId).catch(reportedFallback('stats.badges.craft')),
          getBlitzBadgeState(badgeTargetId).catch(reportedFallback('stats.badges.blitz')),
          getExistingBadgeState(badgeTargetId).catch(reportedFallback('stats.badges.existing')),
        ]);
        if (cancelled) return;

        const index = buildBadgeStateIndex(craft, blitz, existing);
        setBadgeState(index);

        // Celebrations belong to the CURRENT user only — viewing someone else's
        // stats must never fire a pop for their badges.
        if (isOwnStats) {
          // `isFirstRun` (no record of ANY kind, not merely an empty one) is what
          // routes a long-time player's whole history into the ONE retroactive
          // summary instead of a burst of pops. The record is PER ACCOUNT
          // (2026-10-18); own stats ⇒ badgeTargetId IS the signed-in player.
          // A first run is sealed QUIETLY (no "Your badge case" card) — see
          // @/game-flow badgeFirstRunSeal; the plan below then sees an ordinary record.
          sealBadgeFirstRun(index, badgeTargetId);
          const { record, isFirstRun } = readAnnouncedAwards(badgeTargetId);
          const plan = planBadgeAnnouncement({
            stateById: index,
            announced: badgesAreFirstRun(record, isFirstRun) ? null : badgeSnapshotFromRecord(record),
          });
          setBadgeSnapshot(plan.nextSnapshot);
          setRetroBadgeAwards(plan.retroactive);
          setLiveBadgeAwards(plan.live);
        }
      } finally {
        if (!cancelled) setBadgesLoading(false);
      }
    };

    loadBadges();
    return () => { cancelled = true; };
  }, [badgeTargetId, isOwnStats]);

  // Mark everything currently earned as announced. Called when a celebration
  // queue drains — never before, or a dismissed-early moment would be lost.
  const persistBadgeSnapshot = () => {
    if (!badgeSnapshot) return;
    // This surface shows BOTH the live pops and the retroactive summary, so the
    // whole snapshot is honestly announced here — unlike the post-solve path,
    // which shows only the live half and must record only that.
    //
    // It is also the ONLY surface that can answer "has the retroactive summary
    // happened?", so it is the only one that sets the marker. A queue drained on
    // a first run can only BE the retroactive moment: `planBadgeAnnouncement`
    // puts everything in `retroactive` and leaves `live` empty on that path.
    const { record } = readAnnouncedAwards(badgeTargetId);
    writeAnnouncedAwards(
      markBadgeRetroShown(mergeAnnouncedAwards(record, badgeSnapshotAwards(badgeSnapshot))),
      badgeTargetId,
    );
  };

  /** @param {Array<Record<string, any>>} stepAwards */
  const seeBadges = (stepAwards) => {
    stampEarnedBadges(liveBadgeAwards, badgeTargetId); // live earns are news; the retro backlog is not
    setRetroBadgeAwards([]);
    setLiveBadgeAwards([]);
    persistBadgeSnapshot();
    navigate(badgesUrlForAwards(stepAwards));
  };

  const today = todayET();
  // PER MODE. Mode-blind, `.find` returned whichever of up to three rows for
  // today happened to come back first — a real time, from a game the player may
  // not be looking at.
  const todayTime = filterByMode(stats.dailyChallengeTimes, dailyMode)
    .find(t => t.date === today);
  const userRank = leaderboard.findIndex(entry => entry.user_id === user?.id) + 1;

  // The day-modal machinery (open a past day, its winner, its forfeit status,
  // the solve to show) lives in useDayModal — all of it is mode-scoped now, and
  // none of it is the page's business. See that hook for why a date alone can no
  // longer identify a solve.
  const {
    selectedChallenge, showChallengeModal, closeDay, selectedDayWinner,
    selectedDayIsFailed, todayForfeitStatus, openDay, selectedSolve,
  } = useDayModal({
    mode: dailyMode,
    pastChallenges,
    userFailedDates,
    userSolutions,
    viewerId: viewingId || user?.id,
  });

  // The day-scoped date sets moved into CalendarSlide, which owns the mode they
  // are scoped to (D3). What stays here is what the whole page needs.
  const todayDate = todayET();
  // Per-mode solved counts and streaks. `perMode` is ABSENT on an old server and
  // W2-BOARDS may not have merged — readPerModeStats tolerates that and falls
  // back to the legacy top-level fields for Challenge's Daily, reporting the
  // other two as untracked rather than as zeroes.
  const perMode = readPerModeStats(stats).byMode;
  const dailySolvesByMode = solveCountsByMode(stats.dailyChallengeTimes).byMode;
  const ratesByMode = completionRatesByMode(stats.dailyChallengeTimes, attempts, todayDate);
  // THE TIER COLOUR (Easy green / Challenge cyan / Expert gold). Every other
  // Daily surface that shipped this month -- the boards, the podium, the home
  // streak track -- says which of the three Dailies you are looking at by
  // colour; this page said nothing, and worse, said the WRONG thing: the three
  // mode-scoped slides carried FIXED accents, so "Past Challenges" framed an
  // Expert calendar in `--u37-green`, which is Easy's tier colour, and "Daily
  // Performance" framed an Easy week in Challenge's cyan.
  //
  // Passed as an explicit accent STRING rather than as `var(--u37-mode-accent)`,
  // for the reason src/leaderboard/modeAccent.js gives: the slot resolves to the
  // same literal text for all three tiers, so neither a test nor a reviewer
  // could tell an Expert slide from an Easy one. The mode-scoped slides ALSO set
  // `data-mode` on their own roots, which is what puts the token slot in scope
  // for anything nested that paints from it -- the two mechanisms are the frame
  // and the subtree, not two ways of doing the same job.
  const modeAccent = dailyModeAccent(dailyMode);

  return (
    <div className="app-page-shell relative">
      {/* Decorative bottom shadow/buffer bars removed (2026-06-29, FU-1): the ad
          clearance is reserved by the calc(100vh-130px) scroll region below, NOT
          by these visual bars — so removing them frees the bottom content from the
          fade overlay without changing what's reserved or clickable. */}
      <div className="app-page-scroll pt-[60px] scroll-edge-fade-bottom">
        <div className="max-w-2xl mx-auto px-3 sm:px-4 pb-10 min-h-full flex flex-col">
        <StatsPageHeader
          user={user}
          isOwnStats={isOwnStats}
          idParam={idParam}
          puzzlePoints={puzzlePoints}
          battlePoints={battlePoints}
        />

        {/* Stats sections become a swipeable one-card-per-screen carousel (C4):
            each section is a full neon-outlined card, paged via swipe / chevrons
            / dots. Conditional sections (own-vs-other) that render nothing are
            dropped by the carousel. Modals live after the carousel. */}
        {/* The in-Stats "Today's Global Leaderboard" slide was removed (2026-06-30):
            it duplicated the unified Leaderboard entity's Daily › Global tab, which
            is reachable from the home Leaderboard button. The carousel now opens on
            Daily Performance. (`leaderboard` state is still loaded — the 🏆 Rank
            badge in Daily Performance uses it via userRank.) */}
        <div className="flex-1 min-h-0 flex flex-col">
        <StatsCarousel initialSlideId={searchParams.get('card')}>
        <StatsSlide label="Daily Performance" accent={modeAccent}>
        <DailyPerformanceSlide
          mode={dailyMode}
          onModeChange={setDailyMode}
          perMode={perMode}
          ratesByMode={ratesByMode}
          dailySolvesByMode={dailySolvesByMode}
          dailyTimes={stats.dailyChallengeTimes}
          expanded={expandedSections.dailyChallenge}
          loading={loading}
          isGuestOwnStats={isGuestOwnStats}
          isOwnStats={isOwnStats}
          loadError={loadError}
          showSecureBanner={showSecureBanner}
          stats={stats}
          currentStreak={currentStreak}
          todayTime={todayTime}
          userRank={userRank}
          todayForfeitStatus={todayForfeitStatus}
          completionPercentage={completionPercentage}
          totalAttempts={totalAttempts}
          puzzlePoints={puzzlePoints}
          onGoHome={() => navigate(createPageUrl('Game'))}
          onRetry={() => setReloadKey(k => k + 1)}
          onSecure={() => window.dispatchEvent(new CustomEvent('openSaveStats'))}
        />
        </StatsSlide>

        {/* L2-1: the Blitz slide used to appear HERE as a mid-carousel button
            (other-player only) opening a modal, while own-stats got an inline
            slide at the end — two positions, two layouts. It's now a single
            uniform inline slide at the END for BOTH views (see below + the
            getBlitzSlideConfig helper). */}

        {/* The "Achievements" slide is GONE (Badges Phase 2, Slice 2). It was the
            legacy display of the same facts the badge system now owns: its three
            milestone grids (streaks / perfect streaks / speed records) are the
            registry's streak+speed ladders, and its podium row moved into the
            showcase as <PodiumMedalPanel /> on the Daily tab. Two surfaces for
            one truth is how they drift apart — the Badges slide below and the
            full L2 showcase are now the only place badges are shown. */}

        {/* Badges L1 (Badge System Redesign, Lane G) — the one-screen overview:
            ✦ Just earned + ◗ So close + the CTA into the full L2 showcase. The
            component is shared with the OtherProfile card, so everything
            player-specific arrives as props.

            POSITION: badges sit SECOND, directly after Daily Performance and
            ahead of the Weekly Graph (device feedback, 2026-08-05 — "badges
            should be the second in the carousel, not this weeks results"). The
            reward surface outranks the week's chart. Slide order here is the
            only thing that decides carousel order; the `?card=` deep link
            resolves by slide `id`, not by index, so moving a slide never
            breaks a link. StatsCarousel.test.jsx pins this order. */}
        <StatsSlide label="Badges" accent="var(--u37-gold)" id="badges">
        <FeaturedBadges
          badgeState={badgeState}
          isOwnStats={isOwnStats}
          playerId={viewingId || idParam || undefined}
          playerName={user?.username}
          loading={badgesLoading}
          earnedStamps={isOwnStats && !badgesLoading ? readEarnedStamps(badgeTargetId) : undefined}
        />
        </StatsSlide>

        <StatsSlide label="Weekly Graph" accent={modeAccent}>
        {/* Performance Graph — extracted to WeeklyPerformanceGraph (R6) */}
        <WeeklyPerformanceGraph
          stats={stats}
          mode={dailyMode}
          selectedWeekOffset={selectedWeekOffset}
          onWeekOffsetChange={setSelectedWeekOffset}
          // The attempt ROWS, not just the flattened dates: an attempt row
          // carries its mode, and a forfeit in one Daily must not paint a red X
          // across the other two weeks. userFailedDates stays as the fallback.
          attempts={attempts}
          userFailedDates={userFailedDates}
          expanded={expandedSections.performance}
        />
        </StatsSlide>

        {/* Past Daily Challenges — the calendar, per Daily mode (extracted →
            @/components/stats/CalendarSlide, which owns the mode selector and
            every date derivation scoped to it). */}
        {
          pastChallenges.length > 0 && (
            <StatsSlide label="Past Challenges" accent={modeAccent}>
            <CalendarSlide
              mode={dailyMode}
              onModeChange={setDailyMode}
              dailyChallengeTimes={stats.dailyChallengeTimes}
              attempts={attempts}
              viewerCanSeeTodayByMode={viewerCanSeeTodayByMode}
              todayDate={todayDate}
              selectedMonth={selectedMonth}
              onMonthChange={setSelectedMonth}
              onDayClick={openDay}
              expanded={expandedSections.calendar}
            />
            </StatsSlide>
          )
        }

        <StatsSlide label="Solves by Mode" accent="var(--u37-cyan)">
        {/* Mode Breakdown (extracted → @/components/stats/ModeBreakdown) */}
        <ModeBreakdown
          stats={stats}
          expanded={expandedSections.modeBreakdown}
          dailySolvesByMode={dailySolvesByMode}
        />
        </StatsSlide>

        {/* Blitz Stats — battle + solo aggregate stats, rendered inline via
            HeadToHeadStats' inline mode. L2-1: this slide now renders for BOTH
            your own stats and another player's, in the SAME last position and
            SAME inline layout — the only difference is whose stats load
            (opponentId). getBlitzSlideConfig pins that uniformity. Its
            leaderboard button deep-links to the unified Battle Points tab. */}
        {(() => {
          const blitz = getBlitzSlideConfig({ isOwnStats, viewingId });
          return (
            <StatsSlide label={blitz.label} accent={blitz.accent} id={blitz.id}>
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.2 }}
              className="mb-8"
              id="blitz-stats"
            >
              <HeadToHeadStats
                inline
                opponentId={blitz.opponentId}
                onOpenLeaderboard={() => navigate(createPageUrl('Leaderboard') + '?tab=battle')}
              />
            </motion.div>
            </StatsSlide>
          );
        })()}
        </StatsCarousel>
        </div>

        {/* Modals — overlays, rendered after the section carousel (DOM position
            is irrelevant for fixed-position overlays). */}
        <DailyChallengeModal
          isOpen={showChallengeModal}
          onClose={closeDay}
          challenge={selectedChallenge}
          mode={dailyMode}
          userTime={selectedSolve?.time ?? null}
          userEquation={selectedSolve?.equation ?? null}
          userUsedIndices={selectedSolve?.usedDiceIndices ?? null}
          userDiceColors={selectedSolve?.diceColors ?? null}
          userShuffledDice={selectedSolve?.shuffledDice ?? null}
          winnerData={selectedDayWinner}
          selectedDayIsFailed={selectedDayIsFailed}
          viewingUsername={!isOwnStats ? user?.username : undefined}
        />

        {/* Badge celebrations — OWN player only, and only one at a time. The
            retroactive launch moment goes first (a single screen for the whole
            history-derived set); per-earn pops queue behind it through the same
            AwardCelebrationSequence every other award family uses. */}
        {isOwnStats && (
          <>
            {/* "See it in Badges" from either card: both queues are on this
                page's snapshot, so leaving early announces all of it. */}
            <RetroactiveBadgeMoment
              onSeeBadges={seeBadges}
              awards={retroBadgeAwards}
              isOpen={retroBadgeAwards.length > 0}
              onComplete={() => {
                setRetroBadgeAwards([]);
                if (liveBadgeAwards.length === 0) persistBadgeSnapshot();
              }}
            />
            <AwardCelebrationSequence
              awards={liveBadgeAwards}
              isOpen={liveBadgeAwards.length > 0 && retroBadgeAwards.length === 0}
              onComplete={() => { stampEarnedBadges(liveBadgeAwards, badgeTargetId); setLiveBadgeAwards([]); persistBadgeSnapshot(); }}
              onSeeBadges={seeBadges}
            />
          </>
        )}

        {/* (L2-1) The opponent Head-to-Head modal was removed — the Blitz slide
            above now renders an opponent's stats inline, uniformly with own. */}

        {/* Motivational Message */}
        {
          stats.totalSolved === 0 && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 0.5 }}
              className="mt-8 text-center"
            >
              <p className="text-slate-400 text-sm">
                {isOwnStats ? '🎲 Start playing to see your stats here!' : `🎲 ${user?.username || 'This player'} hasn't played any games yet`}
              </p>
            </motion.div>
          )
        }


        </div>
      </div>
    </div>
  );
}