import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { X, Clock, Trophy, Share2 } from 'lucide-react';
import moment from 'moment';
import 'moment-timezone';
import { nowET } from '@/daily-challenge';
import { buildDailyShareText, shareOrCopy } from '@/game-flow';
import { apiClient } from '@/transport';
import LeaderboardView from './LeaderboardView';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';
import { POWER_DICE_COLORS } from '@/dice';
import { getLeaderboard } from '@/stats-aggregation';
import { playSound, formatSolveTime } from '@/ui/feedback';
import { normalizeDailyMode, dailyModeFullLabel, dailyModeAccent } from './dailyModeStats';

// `mode` (D6, 2026-08-27): WHICH Daily this day's solve belongs to. The modal
// showed *the* solution for a past day, which stopped being a single thing the
// moment a date carried three of them — the caller now says which, and this
// names it on screen so a player is never left guessing whose game they are
// looking at. It also scopes the day's leaderboard: an unscoped board would rank
// Easy's 12-second solves against Expert's and call the result "the winner".
// Defaults to Challenge's Daily so an un-migrated caller is unchanged.
// NEON RE-SKIN (David, 2026-09-17).
//
// This modal - the past-Daily recap reached from the calendar - was the last
// surface still wearing the app's pre-neon palette: flat `purple-950` panels,
// `indigo-400` hairlines and a purple-to-pink gradient heading. Next to the
// launcher, Stats, Friends and Blitz (all on the `--u37-*` cosmic tokens) it
// read as a screen from a different app.
//
// It is a re-skin, not a rebuild: every element keeps its position and its
// meaning. What changes is the ground (cosmic panel instead of flat purple),
// the borders (a real accent hairline with a halo) and the headings (solid neon
// with a glow rather than a clipped gradient, which was also the least legible
// text in the modal).
//
// Semantic colours are PRESERVED because they carry meaning: green for a
// solution, gold for the champion, the mode accent for the tier.
const PANEL_CARD = 'rounded-2xl p-3.5 border-2';

/** A neon-outlined card on the cosmic ground. @param {string} accent */
const cardStyle = (accent) => ({
  background: 'var(--u37-panel-bg-cosmic)',
  borderColor: `color-mix(in srgb, ${accent} 55%, transparent)`,
  boxShadow: `0 0 24px -12px ${accent}, inset 0 0 26px -20px ${accent}`,
});

/** A heading that glows instead of being a clipped gradient. @param {string} accent */
const headingStyle = (accent) => ({
  color: accent,
  textShadow: `0 0 12px color-mix(in srgb, ${accent} 55%, transparent)`,
});

/** The footer actions. @param {string} accent */
const actionStyle = (accent) => ({
  color: `color-mix(in srgb, ${accent} 25%, white)`,
  background: `color-mix(in srgb, ${accent} 14%, transparent)`,
  border: `1.5px solid ${accent}`,
  boxShadow: `0 0 18px -6px ${accent}`,
});

export default function DailyChallengeModal({ isOpen, onClose, challenge, mode = 'daily', userTime, userEquation, userUsedIndices, userDiceColors, userShuffledDice, winnerData, viewingUsername, selectedDayIsFailed }) {
  const [showLeaderboard, setShowLeaderboard] = useState(false);
  const [leaderboard, setLeaderboard] = useState([]);
  const [loadingLeaderboard, setLoadingLeaderboard] = useState(false);
  const [currentUserId, setCurrentUserId] = useState('');
  const modeKey = normalizeDailyMode(mode);

  useEffect(() => {
    if (isOpen) {
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
      return () => {
        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.width = '';
      };
    }
  }, [isOpen]);

  useEffect(() => {
    const loadUser = async () => {
      try {
        const user = await apiClient.auth.me();
        setCurrentUserId(user.id);
      } catch (error) {
        console.error('Failed to load user:', error);
      }
    };
    loadUser();
  }, []);
  if (!challenge) return null;

  // Original puzzle dice (unshuffled, fixed color pattern)
  const originalPuzzleDice = challenge.dice;
  const originalPuzzleColors = POWER_DICE_COLORS;

  // Player's solution uses their actual shuffled dice and colors from game session
  const playerSolutionDice = userShuffledDice || originalPuzzleDice;
  const playerSolutionColors = userDiceColors || originalPuzzleColors;

  // Winner's solution uses their actual shuffled dice and colors from game session
  const winnerSolutionDice = winnerData?.shuffledDice || originalPuzzleDice;
  const winnerSolutionColors = winnerData?.diceColors || originalPuzzleColors;

  const handleViewLeaderboard = async () => {
    playSound('buttonTap');
    setLoadingLeaderboard(true);
    try {
      const sortedTimes = await getLeaderboard({
        date: challenge.date,
        mode: modeKey,
        enrichProfiles: true,
      });
      setLeaderboard(sortedTimes);
      setShowLeaderboard(true);
    } catch (error) {
      console.error('Failed to load leaderboard:', error);
    } finally {
      setLoadingLeaderboard(false);
    }
  };



  // 2B: share this day's solve via the device's native share sheet (SMS/email/
  // any target). Own solves only (not when viewing another player). Reuses the
  // canonical daily share-text builder + dispatcher.
  const canShare = !viewingUsername && !!userEquation;
  const handleShare = () => {
    playSound('buttonTap');
    const text = buildDailyShareText({
      status: userTime != null ? 'completed' : 'fallback',
      today: moment(challenge.date).format('MMMM D, YYYY'),
      todayTime: userTime != null ? { time: userTime } : undefined,
      leaderboard: [],
      userId: currentUserId,
    });
    shareOrCopy('native', text, { emailSubject: 'My 37 Daily Challenge solve' });
  };

  // Apply colors to equations - use stored colors from each session
  // 5A: perfect daily solves get the gold outline here too (this history view
  // was missing highlightAllWhenPerfect, so perfect solves showed no gold).
  const displayEquation = <SolvedEquation equation={userEquation} usedIndices={userUsedIndices} colors={playerSolutionColors} highlightAllWhenPerfect />;
  const winnerEquation = <SolvedEquation equation={winnerData?.equation} usedIndices={winnerData?.usedDiceIndices} colors={winnerSolutionColors} highlightAllWhenPerfect />;

  return (
    <AnimatePresence>
      {isOpen && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          className="fixed inset-0 z-50 flex flex-col items-center justify-start pt-12 px-4 u37-ad-safe-pb bg-black/70 backdrop-blur-sm"
          onClick={onClose}
        >
          <motion.div
            initial={{ scale: 0.9, opacity: 0, y: 20 }}
            animate={{ scale: 1, opacity: 1, y: 0 }}
            exit={{ scale: 0.9, opacity: 0, y: 20 }}
            onClick={(e) => e.stopPropagation()}
            className="w-full max-w-sm rounded-3xl p-5 pb-8 border-2 relative overflow-y-auto"
            style={{
              background: 'var(--u37-panel-bg-cosmic)',
              borderColor: `color-mix(in srgb, ${dailyModeAccent(modeKey)} 45%, transparent)`,
              boxShadow: `0 0 60px -20px ${dailyModeAccent(modeKey)}, 0 24px 60px -30px #000`,
              maxHeight: 'calc(100dvh - 48px - var(--safe-bottom) - var(--ad-reserved-bottom) - 1rem)',
            }}
          >
            {/* Close button */}
            <button
              onClick={() => {
                playSound('buttonTap');
                onClose();
              }}
              className="absolute top-4 right-4 text-slate-400 hover:text-slate-200 transition-colors z-10"
            >
              <X className="w-5 h-5" />
            </button>

            {/* Header - STACKED (David, 2026-09-17).
                It used to be one flex row holding the die, the tier label and the
                date, so on a phone the tier sat hard left while the date wrapped
                onto two ragged lines beside it. The three are a title block, not
                a row: die + tier on one quiet line, the date as its own heading
                underneath with room to sit on one line. `pr-8` keeps the block
                clear of the close button instead of centring underneath it. */}
            <div className="mb-4 pr-8 text-center">
              <div className="flex items-center justify-center gap-2">
                <span className="text-lg">🎲</span>
                <div
                  className="text-[10px] font-black uppercase tracking-widest"
                  style={headingStyle(dailyModeAccent(modeKey))}
                >
                  {dailyModeFullLabel(modeKey)}
                </div>
              </div>
              <h2
                className="text-xl font-black mt-1"
                style={headingStyle('var(--u37-text)')}
              >
                {moment(challenge.date).format('MMMM D, YYYY')}
              </h2>
            </div>

            {/* Dice Display */}
            <div className="mb-3">
              <h3
                className="text-xs font-bold mb-2 text-center uppercase tracking-wider"
                style={{ color: 'var(--u37-muted)' }}
              >
                📅 Puzzle Dice
              </h3>
              <div
                className="rounded-2xl p-3 border"
                style={{
                  background: 'var(--u37-surface)',
                  borderColor: `color-mix(in srgb, ${dailyModeAccent(modeKey)} 40%, transparent)`,
                }}
              >
                <div className="flex gap-2 flex-wrap justify-center">
                  {originalPuzzleDice?.map((dieValue, idx) => {
                    const color = originalPuzzleColors[idx];

                    const dotPositions = {
                      1: [[50, 50]],
                      2: [[25, 25], [75, 75]],
                      3: [[25, 25], [50, 50], [75, 75]],
                      4: [[25, 25], [75, 25], [25, 75], [75, 75]],
                      5: [[25, 25], [75, 25], [50, 50], [25, 75], [75, 75]],
                      6: [[25, 25], [75, 25], [25, 50], [75, 50], [25, 75], [75, 75]]
                    };

                    const colorStyles = {
                      white: { bg: 'from-slate-100 to-slate-200', dots: 'fill-slate-800' },
                      blue: { bg: 'from-blue-400 to-blue-500', dots: 'fill-white' },
                      red: { bg: 'from-red-400 to-red-500', dots: 'fill-white' },
                      green: { bg: 'from-green-400 to-green-500', dots: 'fill-white' }
                    };

                    const style = colorStyles[color];
                    const dots = dotPositions[dieValue] || [];

                    return (
                      <div
                        key={idx}
                        className={`w-12 h-12 sm:w-14 sm:h-14 rounded-xl shadow-lg bg-gradient-to-br ${style.bg}`}
                      >
                        <svg viewBox="0 0 100 100" className="w-full h-full p-2">
                          {dots.map(([cx, cy], i) => (
                            <circle
                              key={i}
                              cx={cx}
                              cy={cy}
                              r={10}
                              className={style.dots}
                            />
                          ))}
                        </svg>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>

            {/* Solution Display */}
            {userEquation ? (
              <div className="space-y-2.5 mb-3">
                <div className={PANEL_CARD} style={cardStyle('var(--u37-green)')}>
                  <h3 className="text-sm font-bold mb-2 text-center" style={headingStyle('var(--u37-green)')}>✅ {viewingUsername ? `${viewingUsername}${viewingUsername.endsWith('s') ? "'" : "'s"} Solution` : 'Your Solution'}</h3>
                  <p className="text-center text-lg sm:text-xl font-mono font-bold">
                    {displayEquation} <span className="font-black text-slate-300">= </span><Target37 className="font-black" />
                  </p>
                </div>

                {userTime !== null && userTime !== undefined && (
                  <div className={PANEL_CARD} style={cardStyle(dailyModeAccent(modeKey))}>
                    <h3 className="text-sm font-bold mb-2 text-center" style={headingStyle(dailyModeAccent(modeKey))}>⏱️ Time</h3>
                    <div className="flex items-center justify-center gap-3">
                      <Clock className="w-5 h-5" style={{ color: dailyModeAccent(modeKey) }} />
                      <span className="text-2xl font-black text-slate-100">{formatSolveTime(userTime)}</span>
                    </div>
                  </div>
                )}
              </div>
            ) : (
              <div className={`${PANEL_CARD} mb-3`} style={cardStyle('var(--u37-muted)')}>
                <div className="text-center">
                  {viewingUsername && moment(challenge.date).isSame(nowET(), 'day') ? (
                    <>
                      <div className="text-4xl mb-2">⏳</div>
                      <p className="text-slate-300 font-semibold text-base">Still waiting for {viewingUsername} to complete today's Daily Challenge.</p>
                    </>
                  ) : (
                    <>
                      <div className="text-4xl mb-2">❌</div>
                      {selectedDayIsFailed ? (
                        <p className="text-slate-300 font-semibold text-lg">{viewingUsername ? `${viewingUsername} Failed Today's 37 Daily Challenge` : "You Failed Today's 37 Daily Challenge"}</p>
                      ) : (
                        <p className="text-slate-300 font-semibold text-lg">{viewingUsername ? `${viewingUsername} Skipped Today's 37 Daily Challenge. Kiss Another Streak Goodbye` : "You Missed Today's 37 Daily Challenge - Check In Daily To Keep Your Streak Alive"}</p>
                      )}
                    </>
                  )}
                </div>
              </div>
            )}

            {/* Winner Display */}
            {winnerData && (
              <div className={`${PANEL_CARD} mb-3`} style={cardStyle('var(--u37-gold)')}>
                <h3 className="text-sm font-bold mb-3 text-center flex items-center justify-center gap-2" style={headingStyle('var(--u37-gold)')}>
                  {moment(challenge.date).isSame(nowET(), 'day') ? (
                    viewingUsername ? 'Current Global Leaderboard #1' : (
                      <>
                        <span className="text-2xl">🏆</span>
                        Global Leaderboard #1
                      </>
                    )
                  ) : (
                    <>
                      <span className="text-2xl">🏆</span>
                      Global Leaderboard Winner
                    </>
                  )}
                </h3>

                <div className="space-y-3">
                  <div className="text-center">
                    <p className="text-sm font-semibold mb-1" style={{ color: 'color-mix(in srgb, var(--u37-gold) 45%, white)' }}>Champion</p>
                    <div className="flex items-center justify-center gap-2">
                      {winnerData.user_country && (
                        <img
                          src={`https://flagcdn.com/w40/${winnerData.user_country.toLowerCase()}.png`}
                          alt="Flag"
                          className="w-6 h-4 object-cover rounded"
                        />
                      )}
                      <p className="text-slate-200 text-lg font-bold">{winnerData.user_name}</p>
                    </div>
                  </div>

                  {winnerEquation && (
                    <div className="text-center">
                      <p className="text-sm font-semibold mb-1" style={{ color: 'color-mix(in srgb, var(--u37-gold) 45%, white)' }}>Winning Solution</p>
                      <p className="text-lg sm:text-xl font-mono font-bold">
                        {winnerEquation} <span className="font-black text-slate-300">= </span><Target37 className="font-black" />
                      </p>
                    </div>
                  )}

                  <div className="text-center">
                    <p className="text-sm font-semibold mb-1" style={{ color: 'color-mix(in srgb, var(--u37-gold) 45%, white)' }}>Time</p>
                    <div className="flex items-center justify-center gap-2">
                      <Clock className="w-5 h-5" style={{ color: 'var(--u37-gold)' }} />
                      <span className="text-2xl font-black text-slate-100">{formatSolveTime(winnerData.solve_time_seconds)}</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* 2B: Share button — bottom of the day detail, own solves only */}
            {canShare && (
              <button
                onClick={handleShare}
                className="w-full mb-3 font-black py-3 rounded-xl transition-all flex items-center justify-center gap-2 min-h-[48px] touch-manipulation"
                style={actionStyle('var(--u37-green)')}
              >
                <Share2 className="w-4 h-4" />
                Share
              </button>
            )}

            {/* Action buttons */}
            <div className="grid grid-cols-2 gap-3">
              <button
                onClick={handleViewLeaderboard}
                disabled={loadingLeaderboard}
                className="font-black py-3 rounded-xl transition-all flex items-center justify-center gap-2 disabled:opacity-50 min-h-[48px] touch-manipulation"
                style={actionStyle('var(--u37-gold)')}
              >
                <Trophy className="w-4 h-4" />
                {loadingLeaderboard ? 'Loading...' : 'Leaderboard'}
              </button>
              <button
                onClick={() => {
                  playSound('buttonTap');
                  onClose();
                }}
                className="font-black py-3 rounded-xl transition-all min-h-[48px] touch-manipulation"
                style={actionStyle('var(--u37-violet)')}
              >
                Close
              </button>
            </div>
          </motion.div>
        </motion.div>
      )}

      {/* Leaderboard View */}
      {showLeaderboard && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          className="fixed inset-0 z-50 flex flex-col items-center justify-start pt-[60px] px-4 u37-ad-safe-pb bg-black/80 backdrop-blur-sm"
          onClick={() => setShowLeaderboard(false)}
        >
          <motion.div
            initial={{ scale: 0.9, opacity: 0, y: 20 }}
            animate={{ scale: 1, opacity: 1, y: 0 }}
            exit={{ scale: 0.9, opacity: 0, y: 20 }}
            onClick={(e) => e.stopPropagation()}
            className="w-full max-w-sm rounded-3xl p-6 pb-12 border-2 relative overflow-y-auto"
            style={{
              background: 'var(--u37-panel-bg-cosmic)',
              borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
              boxShadow: '0 0 60px -20px var(--u37-gold), 0 24px 60px -30px #000',
              maxHeight: 'calc(100dvh - 60px - var(--safe-bottom) - var(--ad-reserved-bottom) - 1rem)',
            }}
          >
            {/* Close button */}
            <button
              onClick={() => {
                playSound('buttonTap');
                setShowLeaderboard(false);
              }}
              className="absolute top-4 right-4 text-slate-400 hover:text-slate-200 transition-colors z-10"
            >
              <X className="w-5 h-5" />
            </button>

            {/* Leaderboard */}
            <div className="mb-6 h-[600px]">
              <LeaderboardView
                leaderboard={leaderboard}
                currentUserId={currentUserId}
                title="Leaderboard"
                subtitle={`${dailyModeFullLabel(modeKey)} — ${moment(challenge.date).format('MMMM D, YYYY')}`}
                // This modal is opened for ONE specific day (including a past day
                // via Stats → Past Challenges), so the board must announce that
                // day rather than "Today's".
                date={challenge.date}
              />
            </div>

            {/* Close button */}
            <button
              onClick={() => {
                playSound('buttonTap');
                setShowLeaderboard(false);
              }}
              className="w-full font-black py-3 rounded-xl transition-all min-h-[48px] touch-manipulation"
              style={actionStyle('var(--u37-violet)')}
            >
              Back to Puzzle
            </button>
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}