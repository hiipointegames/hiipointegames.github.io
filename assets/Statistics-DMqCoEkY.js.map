import React, { useState, useMemo, useRef, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Search, Users } from 'lucide-react';
import { Input } from '@/ui/primitives/input';
import { Link } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { PlayerBadges } from '@/components/profile';
import RankBadge from './RankBadge';
import { isPerfectSolve as isPerfectPowerDiceSolve } from '@/equation-engine';
import { apiClient } from '@/transport';
import { getFriendEdges, selectFriendIds } from '@/player';
import { playSound, formatSolveTime } from '@/ui/feedback';
import { todayET } from '@/daily-challenge';
import moment from 'moment';
import { rowDisplayName, isLinkableRow } from '@/leaderboard/guestName';

// Same 'ddd, M/D' shape as leaderboard/boardDate.formatBoardDate, inlined rather
// than imported: @/leaderboard already imports from @/components/stats
// (RankBadge), so pulling the helper across would close an import cycle.
const formatBoardDate = (date) => moment(date, 'YYYY-MM-DD').format('ddd, M/D');

// `date` is the board's own ET calendar day ('YYYY-MM-DD'). It exists because the
// average heading used to be hardcoded "Today's …" even when this view was opened
// from Stats → Past Challenges → <a past date> → Leaderboard, so a July-20 board
// announced itself as today's (Bryce, 1.0.287). Omitted → treated as today, which
// keeps every caller that genuinely shows today unchanged. Wording deliberately
// mirrors the newer leaderboard/GlobalTab heading ("Global Average for Mon, 7/20")
// so the two surfaces read identically.
export default function LeaderboardView({ leaderboard, currentUserId, title = null, subtitle = null, date = null }) {
  const [searchQuery, setSearchQuery] = useState('');
  const [scrollTop, setScrollTop] = useState(0);
  const [friendsOnly, setFriendsOnly] = useState(false);
  const [userFriends, setUserFriends] = useState([]);
  const scrollContainerRef = useRef(null);

  // Fetch friends on mount - check BOTH directions of friendship
  useEffect(() => {
    const loadFriends = async () => {
      try {
        const user = await apiClient.auth.me();

        // Friend IDs (both directions, deduped) from the one friend-edge read path
        const friendIdsArray = selectFriendIds(await getFriendEdges(user.id), user.id);
        console.log('Daily Leaderboard - Friends loaded (both directions):', friendIdsArray);
        console.log('Daily Leaderboard - All entries:', leaderboard.map(e => ({ id: e.user_id, name: e.user_name })));
        console.log('Daily Leaderboard - Friends in leaderboard:', leaderboard.filter(e => friendIdsArray.includes(e.user_id)).map(e => ({ id: e.user_id, name: e.user_name })));
        setUserFriends(friendIdsArray);
      } catch (error) {
        console.error('Failed to load friends:', error);
      }
    };
    loadFriends();
  }, [leaderboard]);

  // Check if an entry has a perfect solve (all 3 power dice correct)
  const isPerfectSolve = (entry) =>
    isPerfectPowerDiceSolve(entry.equation, entry.usedDiceIndices, entry.diceColors);

  const filteredLeaderboard = useMemo(() => {
    let result = leaderboard;

    // Apply friends filter (but always include current user)
    if (friendsOnly) {
      result = result.filter(entry => userFriends.includes(entry.user_id) || entry.user_id === currentUserId);
    }

    // Apply search filter
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      result = result.filter(entry =>
        entry.user_name.toLowerCase().includes(query)
      );
    }

    return result;
  }, [leaderboard, searchQuery, friendsOnly, userFriends, currentUserId]);

  // "Today" only when this really is today's board; otherwise the day it ran.
  const boardDateLabel = !date || date === todayET() ? 'Today' : formatBoardDate(date);

  const currentUserIndex = filteredLeaderboard.findIndex(entry => entry.user_id === currentUserId);
  const currentUserRank = leaderboard.findIndex(entry => entry.user_id === currentUserId) + 1;

  const handleScroll = (e) => {
    setScrollTop(e.target.scrollTop);
  };

  // Calculate visible window (10 items, each ~56px tall)
  const ITEM_HEIGHT = 56;
  const VISIBLE_ITEMS = 10;
  const firstVisibleIndex = Math.floor(scrollTop / ITEM_HEIGHT);
  const lastVisibleIndex = firstVisibleIndex + VISIBLE_ITEMS - 1;

  // Determine user position behavior
  const userInTopTen = currentUserIndex >= 0 && currentUserIndex < 10;
  const userBelowViewport = currentUserIndex > lastVisibleIndex;
  const userAboveViewport = currentUserIndex >= 0 && currentUserIndex < firstVisibleIndex;
  const userInViewport = currentUserIndex >= firstVisibleIndex && currentUserIndex <= lastVisibleIndex;

  // Build display list
  let displayEntries = [];
  let userStickyPosition = null;

  if (currentUserIndex === -1) {
    // User not in filtered list
    displayEntries = filteredLeaderboard;
  } else if (userInTopTen || userInViewport) {
    // User is in top 10 or naturally visible - show all entries normally
    displayEntries = filteredLeaderboard;
  } else if (userBelowViewport) {
    // User scrolled up past their position - stick to bottom
    displayEntries = filteredLeaderboard.filter((_, idx) => idx !== currentUserIndex);
    userStickyPosition = 'bottom';
  } else if (userAboveViewport) {
    // User scrolled down past their position - stick to top
    displayEntries = filteredLeaderboard.filter((_, idx) => idx !== currentUserIndex);
    userStickyPosition = 'top';
  }

  return (
    <div className="flex flex-col h-full">
      {/* Header with Title (only shown when title prop is provided) */}
      {title && (
        <div className="flex flex-col items-center justify-center gap-3 mb-4">
          <h2 className="text-2xl font-black bg-gradient-to-r from-amber-300 via-yellow-300 to-amber-300 bg-clip-text text-transparent">
            {title}
          </h2>
        </div>
      )}

      {/* Filter Buttons */}
      <div className="flex items-center justify-center gap-4 mb-4">
        <span className="text-xl">🏆</span>
        <div className="flex items-center justify-center gap-2">
          <button
            onClick={() => {
              playSound('buttonTap');
              setFriendsOnly(false);
            }}
            className={`text-xs font-bold px-2.5 py-1 rounded-lg transition-colors flex items-center gap-1.5 ${!friendsOnly
              ? 'bg-gradient-to-b from-indigo-600 via-purple-600 to-pink-600 text-white border border-purple-400/50'
              : 'bg-slate-700/60 text-slate-300 border border-slate-600/60'
              }`}
          >
            <span>🌍</span>
            <span>Global</span>
          </button>
          <button
            onClick={() => {
              playSound('buttonTap');
              setFriendsOnly(true);
            }}
            className={`text-xs font-bold px-2.5 py-1 rounded-lg transition-colors flex items-center gap-1.5 ${friendsOnly
              ? 'bg-emerald-500/60 text-emerald-100 border border-emerald-400/60'
              : 'bg-slate-700/60 text-slate-300 border border-slate-600/60'
              }`}
          >
            <Users className="w-4 h-4" />
            <span>Friends</span>
          </button>
        </div>
        <span className="text-xl">🏆</span>
      </div>

      {/* Daily Challenge Global/Friends Average — for the board's own date */}
      {leaderboard.length > 0 && (
        <div className="mb-4 bg-gradient-to-br from-indigo-500/20 to-purple-600/20 rounded-xl p-4 border border-indigo-400/40">
          <div className="flex items-center justify-center gap-2 mb-3">
            {friendsOnly ? (
              <Users className="w-5 h-5 text-emerald-400" />
            ) : (
              <span className="text-xl">🌍</span>
            )}
            <h3 className="text-xs sm:text-sm font-bold text-indigo-200 uppercase tracking-wider">
              {friendsOnly ? "Friends'" : 'Global'} Average for {boardDateLabel}
            </h3>
          </div>
          <div className="text-center">
            <div className="text-2xl sm:text-3xl font-black text-slate-100 mb-2">
              {(() => {
                const dataToUse = friendsOnly ? filteredLeaderboard : leaderboard;
                const validEntries = dataToUse.length > 0 ? dataToUse : leaderboard;
                return formatSolveTime(validEntries.reduce((sum, entry) => sum + entry.solve_time_seconds, 0) / validEntries.length);
              })()}
            </div>
            <div className="flex items-center justify-center gap-4 text-xs font-semibold">
              <div className="text-indigo-200">
                {(() => {
                  const dataToUse = friendsOnly ? filteredLeaderboard : leaderboard;
                  return `${dataToUse.length} player${dataToUse.length !== 1 ? 's' : ''} completed`;
                })()}
              </div>
              <div className="text-amber-300">
                {(() => {
                  let perfectCount = 0;
                  const dataToUse = friendsOnly ? filteredLeaderboard : leaderboard;
                  dataToUse.forEach(entry => {
                    if (isPerfectSolve(entry)) perfectCount++;
                  });
                  return perfectCount;
                })()} perfect solve{(() => {
                  let perfectCount = 0;
                  const dataToUse = friendsOnly ? filteredLeaderboard : leaderboard;
                  dataToUse.forEach(entry => {
                    if (isPerfectSolve(entry)) perfectCount++;
                  });
                  return perfectCount !== 1 ? 's' : '';
                })()}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Search Bar */}
      <div className="mb-4">
        <div className="relative">
          <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-slate-400" />
          <Input
            type="text"
            placeholder="Search for Friend's Usernames"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="pl-10 bg-slate-700/50 border-slate-600 text-slate-200 placeholder:text-slate-400"
          />
        </div>
      </div>

      {/* Perfect Solve Legend */}
      <div className="mb-4 text-xs text-slate-300 flex items-center justify-center gap-2">
        <div className="w-3 h-3 border-2 rounded" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }}></div>
        <span>Perfect Solve (All 3 Power Dice correct)</span>
      </div>

      {/* Leaderboard List */}
      {filteredLeaderboard.length > 0 ? (
        <div className="flex flex-col flex-1 min-h-0">
          {/* Sticky user at top */}
          {userStickyPosition === 'top' && (
            <div className="border-b-2 border-amber-500/30 pb-2 mb-2">
              <motion.div
                initial={{ opacity: 0, y: -20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{}}
                className={`flex items-center justify-between p-3 rounded-full bg-gradient-to-r from-amber-500/25 to-orange-500/25 ${isPerfectSolve(filteredLeaderboard[currentUserIndex])
                  ? 'shadow-[inset_0_0_4px_rgba(251,191,36,0.3),0_0_6px_rgba(251,191,36,0.6)] border-2 border-amber-400'
                  : 'shadow-[0_4px_16px_rgba(251,191,36,0.3),0_2px_6px_rgba(0,0,0,0.2),inset_0_1px_3px_rgba(255,255,255,0.2)] border border-amber-400/40'
                  }`}
              >
                <div className="flex items-center gap-3 min-w-0 flex-1">
                  <RankBadge rank={currentUserRank} />
                  <div className="flex flex-col gap-1 min-w-0 flex-1">
                    <div className="flex items-center gap-2">
                      {filteredLeaderboard[currentUserIndex].user_country && (
                        <img
                          src={`https://flagcdn.com/w80/${filteredLeaderboard[currentUserIndex].user_country.toLowerCase()}.png`}
                          alt="Flag"
                          className="h-10 w-14 object-cover rounded shadow-sm flex-shrink-0"
                        />
                      )}
                      <div className="text-slate-200 font-semibold truncate">
                        {filteredLeaderboard[currentUserIndex].user_name}
                      </div>
                    </div>
                    <PlayerBadges
                      puzzlePoints={filteredLeaderboard[currentUserIndex].puzzle_points || 0}
                      battlePoints={filteredLeaderboard[currentUserIndex].battle_points || 0}
                      size="xl"
                    />
                  </div>
                </div>
                <div className="text-emerald-400 font-bold text-lg">
                  {formatSolveTime(filteredLeaderboard[currentUserIndex].solve_time_seconds)}
                </div>
              </motion.div>
            </div>
          )}

          {/* Scrollable entries */}
          <div
            ref={scrollContainerRef}
            onScroll={handleScroll}
            className="flex-1 overflow-y-auto space-y-2 max-h-[560px] pb-6"
            style={{ scrollbarWidth: 'thin' }}
          >
            {displayEntries.map((entry, displayIndex) => {
              const actualRank = leaderboard.findIndex(e => e.id === entry.id) + 1;
              const isCurrentUser = entry.user_id === currentUserId;
              return (
                <motion.div
                  key={entry.id}
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: displayIndex * 0.02 }}
                  className={`flex items-center justify-between p-3 rounded-full ${isCurrentUser
                    ? `bg-gradient-to-r from-amber-500/25 to-orange-500/25 shadow-[0_4px_16px_rgba(251,191,36,0.3),0_2px_6px_rgba(0,0,0,0.2),inset_0_1px_3px_rgba(255,255,255,0.2)] ${isPerfectSolve(entry)
                      ? 'border-2 border-amber-400'
                      : 'border border-amber-400/40'
                    }`
                    : `bg-slate-700/60 shadow-[0_2px_8px_rgba(0,0,0,0.2)] ${isPerfectSolve(entry)
                      ? 'border-2 border-amber-400'
                      : ''
                    }`
                    }`}
                >
                  <div className="flex items-center gap-3 min-w-0 flex-1">
                    <RankBadge rank={actualRank} />
                    <div className="flex flex-col gap-1 min-w-0 flex-1">
                      <div className="min-w-0">
                        {/* One naming rule for every board (2026-10-10): guests read "Guest ####"
                            and never link. The old inline check also threw on a
                            row with no user_name (`.startsWith` of undefined). */}
                        {isLinkableRow(entry) && !isCurrentUser ? (
                          <Link
                            to={`${createPageUrl('OtherProfile')}?id=${entry.user_id}&returnTo=Statistics`}
                            onClick={() => playSound('buttonTap')}
                            className="text-slate-200 font-semibold hover:text-amber-400 transition-colors block truncate"
                          >
                            {rowDisplayName(entry)}
                          </Link>
                        ) : (
                          <span className="text-slate-200 font-semibold block truncate">
                            {rowDisplayName(entry)}
                          </span>
                        )}
                      </div>
                      <div className="flex items-center gap-2">
                        {entry.user_country && (
                          <img
                            src={`https://flagcdn.com/w80/${entry.user_country.toLowerCase()}.png`}
                            alt="Flag"
                            className="h-10 w-14 object-cover rounded shadow-sm flex-shrink-0"
                          />
                        )}
                        <PlayerBadges
                          puzzlePoints={entry.puzzle_points || 0}
                          battlePoints={entry.battle_points || 0}
                          size="xl"
                        />
                      </div>
                    </div>
                  </div>
                  <div className="text-emerald-400 font-bold text-lg">
                    {formatSolveTime(entry.solve_time_seconds)}
                  </div>
                </motion.div>
              );
            })}
          </div>

          {/* Sticky user at bottom */}
          {userStickyPosition === 'bottom' && (
            <div className="border-t-2 border-amber-500/30 pt-2 mt-2">
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{}}
                className={`flex items-center justify-between p-3 rounded-full bg-gradient-to-r from-amber-500/25 to-orange-500/25 ${isPerfectSolve(filteredLeaderboard[currentUserIndex])
                  ? 'shadow-[inset_0_0_4px_rgba(251,191,36,0.3),0_0_6px_rgba(251,191,36,0.6)] border-2 border-amber-400'
                  : 'shadow-[0_4px_16px_rgba(251,191,36,0.3),0_2px_6px_rgba(0,0,0,0.2),inset_0_1px_3px_rgba(255,255,255,0.2)] border border-amber-400/40'
                  }`}
              >
                <div className="flex items-center gap-3 min-w-0 flex-1">
                  <RankBadge rank={currentUserRank} />
                  <div className="flex flex-col gap-1 min-w-0 flex-1">
                    <div className="text-slate-200 font-semibold truncate">
                      {filteredLeaderboard[currentUserIndex].user_name}
                    </div>
                    <div className="flex items-center gap-2">
                      {filteredLeaderboard[currentUserIndex].user_country && (
                        <img
                          src={`https://flagcdn.com/w80/${filteredLeaderboard[currentUserIndex].user_country.toLowerCase()}.png`}
                          alt="Flag"
                          className="h-10 w-14 object-cover rounded shadow-sm flex-shrink-0"
                        />
                      )}
                      <PlayerBadges
                        puzzlePoints={filteredLeaderboard[currentUserIndex].puzzle_points || 0}
                        battlePoints={filteredLeaderboard[currentUserIndex].battle_points || 0}
                        size="xl"
                      />
                    </div>
                  </div>
                </div>
                <div className="text-emerald-400 font-bold text-lg">
                  {formatSolveTime(filteredLeaderboard[currentUserIndex].solve_time_seconds)}
                </div>
              </motion.div>
            </div>
          )}
        </div>
      ) : (
        <div className="text-center py-8">
          <p className="text-slate-400">
            {searchQuery ? 'No users found' : friendsOnly ? 'None of your friends completed today' : 'No times recorded'}
          </p>
        </div>
      )}
    </div>
  );
}