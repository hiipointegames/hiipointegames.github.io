import React from 'react';
import { motion } from 'framer-motion';
import moment from 'moment';
import { formatSolveTime } from '@/ui/feedback';
import GuestStatsPrompt from './GuestStatsPrompt';
import StatsLoadError from './StatsLoadError';
import SecureAccountBanner from './SecureAccountBanner';
import StreakCard from './StreakCard';
import PerfectSolveTile from './PerfectSolveTile';
import PuzzlePiecesTile from './PuzzlePiecesTile';
import { DAILY_MODE_KEYS } from '@/game-modes';
import {
  dailyModeLabel, dailyModeFullLabel, dailyModeAccent, dailyModeTheme,
  filterByMode, normalizeDailyMode,
} from './dailyModeStats';
import { showsPerfectSolveTile, showsPuzzlePieceTile, perfectSolveSummary } from './perModeTiles';

// DailyPerformanceSlide — the "Daily Performance" stats slide, extracted verbatim
// from Statistics.jsx (R6 blob decomposition). It's the biggest slide: the
// daily-challenge streak cards + the six metric tiles (today's time, all-time
// avg, fastest solve, completion rate, perfect-solve rate, puzzle pieces), with
// the loading / guest / error / ready branches. Behaviour is unchanged from the
// inline version; the parent (Statistics.jsx) keeps the <StatsSlide> wrapper and
// supplies the already-derived stats + the three callbacks (the slide itself has
// no routing/app-state of its own, matching the other extracted slides).
//
// ─────────────────────────────────────────────────────────────────────────────
// THREE DAILIES (D4, D7, and the "your daily time" assumption)
// ─────────────────────────────────────────────────────────────────────────────
// Two different treatments, on purpose:
//
//   THE STREAKS ARE SHOWN ALL AT ONCE. Q-F rules three independent streaks, and
//   that is a headline fact about the player, not a filter. A number you have to
//   go looking for behind a tab reads as a footnote. Three cards, always.
//
//   EVERYTHING ELSE IS SCOPED TO ONE MODE. Today's time, the average, the
//   fastest solve and the completion rate are all "per day" figures that assumed
//   ONE Daily a day. Averaged across three modes they describe nobody: Easy and
//   Expert are not the same game and their times are not commensurable.
//
// ⚠️ THE LAST TWO TILES ARE NOT SHOWN TO EVERY DAILY. Perfect Solves appears
// only where a perfect solve is POSSIBLE BUT NOT COMPULSORY, and Puzzle Pieces
// only where power dice are dealt at all — so Easy gets neither and Expert gets
// pieces alone. David: *"one cant get a perfect, and one is always a perfect."*
// An earlier pass wrote Easy an EXEMPTION NOTICE in place of a zero, which was
// honest but still spent a whole tile explaining an absence. Which modes those
// are is derived in perModeTiles.js from game-modes' own predicates, never
// hard-coded here; that module carries the full argument.
//
// THE THREE STREAK CARDS ARE THE MODE SELECTOR. There is no separate tab bar
// under them any more — see the streak row below for why.
//
// @param {{
//   expanded?: boolean,
//   loading: boolean,
//   isGuestOwnStats: boolean,
//   isOwnStats: boolean,
//   loadError: boolean,
//   showSecureBanner: boolean,
//   stats: object,
//   currentStreak: number,
//   todayTime: { time: number } | undefined,
//   userRank: number,
//   todayForfeitStatus: boolean,
//   completionPercentage: number,
//   totalAttempts: number,
//   puzzlePoints: number,
//   onGoHome: () => void,     // guest prompt "go home"
//   onRetry: () => void,      // load-error retry
//   onSecure: () => void,     // secure-account banner CTA
//   mode?: string,                            // the selected Daily mode key
//   onModeChange?: (modeKey: string) => void,
//   perMode?: Record<string, any>,            // readPerModeStats().byMode
//   ratesByMode?: Record<string, any>,        // completionRatesByMode()
//   dailySolvesByMode?: Record<string, number>,
//   dailyTimes?: any[],                       // the raw times rows (carry `mode`)
// }} props
export default function DailyPerformanceSlide({
  expanded = true,
  mode = 'daily',
  onModeChange,
  perMode = {},
  ratesByMode = {},
  dailySolvesByMode = {},
  dailyTimes = [],
  loading,
  isGuestOwnStats,
  isOwnStats,
  loadError,
  showSecureBanner,
  stats,
  currentStreak,
  todayTime,
  userRank,
  todayForfeitStatus,
  completionPercentage,
  totalAttempts,
  puzzlePoints,
  onGoHome,
  onRetry,
  onSecure,
}) {
  const modeKey = normalizeDailyMode(mode);
  const accent = dailyModeAccent(modeKey);
  const modeTimes = filterByMode(dailyTimes, modeKey).filter(t => !t.forfeited);
  const modeRate = ratesByMode[modeKey];
  const modeStats = perMode[modeKey];
  const perfect = perfectSolveSummary(dailyTimes, modeKey);
  const showsPerfect = showsPerfectSolveTile(modeKey);
  const showsPieces = showsPuzzlePieceTile(modeKey);
  const selectMode = onModeChange || (() => {});

  return (
    // COLOUR FOLLOWS THE TIER. `data-mode` puts this Daily's own
    // `--u37-mode-accent` in scope for the whole slide, so anything nested that
    // paints from the token slot follows the tab selection without being handed
    // a prop -- the same mechanism src/leaderboard/DailyTab.jsx uses, and the
    // one src/home/DailyStreakTrack.jsx demonstrates in miniature.
    //
    // `data-accent` MIRRORS what that resolves to. It has to: happy-dom's CSS
    // parser drops any declaration containing `color-mix()`, so the inline
    // styles below are not assertable and a test could not otherwise tell an
    // Expert slide from an Easy one. Same trick as BadgeCard/BadgeFrame.
    <motion.div
      data-testid="daily-performance-slide"
      data-mode={dailyModeTheme(modeKey)}
      data-accent={accent}
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ delay: 0.1, duration: 0.5 }}
      className="p-0 mb-0"
    >
      {/* Condensed header (item 9): the 🎲 emoji accent + a slimmed title are
          kept (the carousel label reads "Daily Performance", so this title is
          not a pure duplicate); only the size/margin shrank to fit more per
          screen. */}
      <div
        className="w-full flex items-center mb-3"
      >
        <div className="flex items-center gap-2">
          <motion.div
            animate={{ rotate: [0, 10, -10, 0] }}
            transition={{ duration: 2, repeat: Infinity, repeatDelay: 3 }}
          >
            <span className="text-2xl">🎲</span>
          </motion.div>
          <h2 className="text-base font-black bg-gradient-to-r from-purple-200 via-pink-200 to-orange-200
            bg-clip-text text-transparent">
            Daily Challenge Stats
          </h2>
        </div>
      </div>

      {expanded && (
        <motion.div
          initial={{ opacity: 0, height: 0 }}
          animate={{ opacity: 1, height: 'auto' }}
          exit={{ opacity: 0, height: 0 }}
        >
          {loading && (
            <div className="text-center py-12 flex flex-col items-center gap-3">
              <motion.div
                animate={{ rotate: [0, 10, -10, 0] }}
                transition={{ duration: 0.6, repeat: Infinity, repeatDelay: 0.2 }}
                className="text-7xl"
              >
                🎲
              </motion.div>
              <p className="text-slate-400">Loading stats...</p>
            </div>
          )}
          {!loading && isGuestOwnStats && (
            <GuestStatsPrompt onGoHome={onGoHome} />
          )}
          {!loading && !isGuestOwnStats && loadError && (
            <StatsLoadError
              onRetry={onRetry}
              viewingOther={!isOwnStats}
            />
          )}
          {!loading && !isGuestOwnStats && !loadError && (
            <>
              {showSecureBanner && (
                <SecureAccountBanner onSecure={onSecure} />
              )}
              {/* ═══ THE STREAK CARDS *ARE* THE MODE SELECTOR ═══════════════
                  Streaks are still shown ALL THREE AT ONCE (D4) — three
                  independent streaks is a headline fact about the player, not a
                  filter. What changed is that a tab bar used to sit directly
                  under them repeating the same three words, so the row said
                  EASY / CHALLENGE / EXPERT twice: once as a number you could not
                  touch, once as a control carrying no data. David, 2026-09-04:
                  *"remove that bar and make the streak counters themselves the
                  buttons that players click."*

                  Each card is WRAPPED in a real <button> rather than being made
                  into one. StreakCard is shared with another player's profile
                  (OtherProfile), where nothing is selectable — pushing the
                  interaction into the card itself would have made every consumer
                  inherit a control it has no handler for. The wrapper also keeps
                  the focus ring OUTSIDE the card's neon frame, where it stays
                  visible against it.

                  The affordance is deliberately quiet ("without being overly
                  dramatic"): unselected cards sit slightly dimmed and lift 2px
                  on hover, the selected one carries a soft ring in its own tier
                  accent. StreakCard's existing whileHover supplies the motion.
                  `data-selected` mirrors `aria-pressed` because happy-dom drops
                  the `color-mix()` in that ring, leaving the styles unassertable. */}
              <div
                role="group"
                aria-label="Choose which Daily these figures cover"
                className="grid grid-cols-3 gap-2 sm:gap-3 mb-3"
              >
                {DAILY_MODE_KEYS.map((key) => {
                  const m = perMode[key];
                  const isSelected = key === modeKey;
                  const keyAccent = dailyModeAccent(key);
                  return (
                    <button
                      key={key}
                      type="button"
                      aria-pressed={isSelected}
                      data-testid="streak-mode-button"
                      data-mode-key={key}
                      data-selected={String(isSelected)}
                      onClick={() => selectMode(key)}
                      className={`min-h-[44px] rounded-xl sm:rounded-2xl transition-all duration-200
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-200/70
                        focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900
                        hover:-translate-y-0.5 active:translate-y-0
                        ${isSelected ? '' : 'opacity-80 hover:opacity-100'}`}
                      style={isSelected ? {
                        boxShadow: `0 0 0 2px color-mix(in srgb, ${keyAccent} 85%, transparent), 0 0 20px -8px ${keyAccent}`,
                      } : undefined}
                    >
                      <StreakCard
                        streak={m?.currentStreak ?? 0}
                        label={dailyModeLabel(key)}
                        sublabel={m?.longestStreak ? `Longest ${m.longestStreak}` : undefined}
                        accent={keyAccent}
                        // An old server sends no perMode, and Easy's and Expert's
                        // Dailies do not exist in production data yet. Untracked is
                        // not the same as zero — see StreakCard.
                        tracked={m?.tracked === true}
                      />
                    </button>
                  );
                })}
              </div>

              {/* Times Grid - Show for all users */}
              {(
                <div
                  className="grid grid-cols-2 gap-3 sm:gap-4 pt-3 border-t-2"
                  style={{ borderTopColor: `color-mix(in srgb, ${accent} 35%, transparent)` }}
                >
                  {/* Today's Time */}
                  <motion.div
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.5 }}
                    className="bg-gradient-to-br from-cyan-500/20 to-blue-600/30 rounded-xl p-3 sm:p-4 border-2"
                    style={{
                      borderColor: 'color-mix(in srgb, var(--u37-cyan) 70%, transparent)',
                      boxShadow: '0 0 18px -6px var(--u37-cyan), inset 0 0 26px -16px var(--u37-cyan)',
                    }}
                  >
                    <div className="flex items-center justify-center gap-2 mb-2 min-h-[24px] sm:min-h-[28px]">
                      <span className="text-lg">⏱️</span>
                      <h3 className="text-xs sm:text-sm font-bold text-indigo-200 uppercase tracking-wider leading-tight text-center">Today&apos;s {dailyModeLabel(modeKey)}</h3>
                    </div>
                    {(() => {
                      return todayTime ? (
                        <div className="text-center">
                          <motion.div
                            className="text-xl sm:text-2xl lg:text-3xl font-black text-slate-100 mb-1 break-words"
                            initial={{ scale: 0 }}
                            animate={{ scale: 1 }}
                            transition={{ delay: 0.6, type: "spring", stiffness: 200 }}
                          >
                            {formatSolveTime(todayTime.time)}
                          </motion.div>
                          {userRank > 0 && (
                            <div className="text-indigo-200 text-[10px] sm:text-xs font-semibold">
                              🏆 Rank #{userRank}
                            </div>
                          )}
                        </div>
                      ) : todayForfeitStatus ? (
                        <div className="text-center py-1 sm:py-2">
                          <div className="text-red-400 text-[10px] sm:text-xs font-semibold break-words">
                            ❌ Forfeited
                          </div>
                        </div>
                      ) : (
                        <div className="text-center py-1 sm:py-2">
                          <div className="text-slate-300 text-[10px] sm:text-xs break-words">
                            {isOwnStats ? 'Not started' : 'Not completed'}
                          </div>
                        </div>
                      );
                    })()}
                  </motion.div>

                  {/* All-Time Average */}
                  <motion.div
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.55 }}
                    className="bg-gradient-to-br from-rose-500/30 to-pink-600/30 rounded-xl p-4 border-2"
                    style={{
                      borderColor: 'color-mix(in srgb, var(--u37-magenta) 70%, transparent)',
                      boxShadow: '0 0 18px -6px var(--u37-magenta), inset 0 0 26px -16px var(--u37-magenta)',
                    }}
                  >
                    <div className="flex items-center justify-center gap-2 mb-2 min-h-[24px] sm:min-h-[28px]">
                      <span className="text-lg">📈</span>
                      <h3 className="text-xs sm:text-sm font-bold text-rose-200 uppercase tracking-wider text-center">All-Time Avg</h3>
                    </div>
                    {(() => {
                      // PER MODE. The lifetime average was Challenge's Daily by
                      // construction; averaged across three it describes nobody.
                      // Prefer the server's per-mode figure, fall back to the
                      // times log (derived, never stored) so this is right even
                      // before W2-BOARDS lands.
                      const derived = modeTimes.length > 0
                        ? modeTimes.reduce((n, t) => n + (t.time || 0), 0) / modeTimes.length
                        : 0;
                      const avgTime = modeStats?.avgTime || derived;
                      const completedCount = dailySolvesByMode[modeKey] ?? modeTimes.length;

                      return (
                        <div className="text-center">
                          {avgTime > 0 ? (
                            <motion.div
                              className="text-2xl sm:text-3xl font-black text-slate-100 mb-1"
                              initial={{ scale: 0 }}
                              animate={{ scale: 1 }}
                              transition={{ delay: 0.65, type: "spring", stiffness: 200 }}
                            >
                              {formatSolveTime(avgTime)}
                            </motion.div>
                          ) : (
                            <div className="text-slate-300 text-xs py-2">No data yet</div>
                          )}
                          {completedCount > 0 && (
                            <div className="text-rose-200 text-xs font-semibold">
                              {completedCount} completed
                            </div>
                          )}
                        </div>
                      );
                    })()}
                  </motion.div>
                </div>
              )}

              {/* Fastest Solve & Completion Rate - Same Row */}
              <div
                className="grid grid-cols-2 gap-3 sm:gap-4 mt-3 border-t-2 pt-3"
                style={{ borderTopColor: `color-mix(in srgb, ${accent} 35%, transparent)` }}
              >
                {/* Fastest Solve Tracker */}
                <motion.div
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.6 }}
                  className="bg-gradient-to-br from-cyan-500/30 to-blue-600/30 rounded-xl p-4 border-2"
                  style={{
                    borderColor: 'color-mix(in srgb, var(--u37-cyan) 70%, transparent)',
                    boxShadow: '0 0 18px -6px var(--u37-cyan), inset 0 0 26px -16px var(--u37-cyan)',
                  }}
                >
                  <div className="flex items-center justify-center gap-2 mb-2 min-h-[24px] sm:min-h-[28px]">
                    <span className="text-lg">⚡</span>
                    <h3 className="text-xs sm:text-sm font-bold text-cyan-200 uppercase tracking-wider text-center">Fastest Solve</h3>
                  </div>
                  {(() => {
                    const times = modeTimes;
                    if (times.length === 0) {
                      return (
                        <div className="text-center">
                          <motion.div
                            className="text-2xl sm:text-3xl font-black text-cyan-200 mb-1"
                            initial={{ scale: 0 }}
                            animate={{ scale: 1 }}
                            transition={{ delay: 0.7, type: "spring", stiffness: 200 }}
                          >
                            --
                          </motion.div>
                          <div className="text-cyan-200 text-[10px] sm:text-xs font-semibold">
                            No {dailyModeFullLabel(modeKey)} times yet
                          </div>
                        </div>
                      );
                    }
                    const fastest = times.reduce((min, t) => t.time < min.time ? t : min, times[0]);
                    return (
                      <div className="text-center">
                        <motion.div
                          className="text-2xl sm:text-3xl font-black text-white mb-1"
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: 0.7, type: "spring", stiffness: 200 }}
                          key={fastest.time}
                        >
                          {formatSolveTime(fastest.time)}
                        </motion.div>
                        <div className="text-cyan-200 text-[10px] sm:text-xs font-semibold">
                          {moment(fastest.date).format('MMM D, YYYY')}
                        </div>
                      </div>
                    );
                  })()}
                </motion.div>

                {/* Completion Percentage */}
                <motion.div
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.65 }}
                  className="bg-gradient-to-br from-emerald-500/30 to-teal-600/30 rounded-xl p-4 border-2"
                  style={{
                    borderColor: 'color-mix(in srgb, var(--u37-green) 70%, transparent)',
                    boxShadow: '0 0 18px -6px var(--u37-green), inset 0 0 26px -16px var(--u37-green)',
                  }}
                >
                  <div className="flex items-center justify-center gap-2 mb-2 min-h-[24px] sm:min-h-[28px]">
                    <span className="text-lg">✅</span>
                    <h3 className="text-xs sm:text-sm font-bold text-emerald-200 uppercase tracking-wider text-center">Completion Rate</h3>
                  </div>
                  {/* PER MODE (D7), over fully-closed days only — today is
                      excluded from both halves, or the rate would dip at
                      midnight and recover on solve. Falls back to the
                      whole-account figures when no per-mode rate is available. */}
                  <div className="text-center mb-2">
                    <motion.div
                      className="text-2xl sm:text-3xl font-black text-slate-100"
                      initial={{ scale: 0 }}
                      animate={{ scale: 1 }}
                      transition={{ delay: 0.7, type: "spring", stiffness: 200 }}
                      key={modeRate ? modeRate.rate : completionPercentage}
                    >
                      {modeRate ? modeRate.rate : completionPercentage}%
                    </motion.div>
                  </div>
                  <p className="text-[10px] text-emerald-100/80 text-center leading-tight">
                    {modeRate
                      ? `${modeRate.attempted} ${dailyModeLabel(modeKey)} day${modeRate.attempted !== 1 ? 's' : ''}`
                      : `${totalAttempts} total attempt${totalAttempts !== 1 ? 's' : ''}`}
                  </p>
                </motion.div>
              </div>

              {/* ═══ THE TWO TILES NOT EVERY DAILY GETS ═══════════════════
                  Perfect Solves and Puzzle Pieces are the only tiles here whose
                  question some Dailies cannot be asked, so the row is BUILT
                  rather than fixed: both on Challenge, pieces alone on Expert,
                  and on Easy the row is not rendered at all. A lone surviving
                  tile goes full width rather than sitting in half a two-column
                  grid beside a hole. perModeTiles.js decides which. */}
              {(showsPerfect || showsPieces) && (
                <div
                  data-testid="per-mode-tiles"
                  className={`grid ${showsPerfect && showsPieces ? 'grid-cols-2' : 'grid-cols-1'} gap-3 sm:gap-4 mt-3 mb-4`}
                >
                  {showsPerfect && <PerfectSolveTile modeKey={modeKey} summary={perfect} />}
                  {showsPieces && <PuzzlePiecesTile modeKey={modeKey} puzzlePoints={puzzlePoints} />}
                </div>
              )}
            </>
          )}
        </motion.div>
      )}
    </motion.div>
  );
}
