import { filterByMode } from '@/components/stats/dailyModeStats';

// A daily "solve" is a COMPLETED daily challenge — NOT a forfeit.
//
// The Statistics "Solves by Mode" breakdown previously counted the raw
// daily_challenge_times array length, which includes forfeited rows. That
// overcounted Daily solves and inflated totalSolved, which in turn skewed the
// Easy/Challenge percentage bars (each is solved/totalSolved). This counts only
// non-forfeited completions. See docs/bugs.md (2G).

// PER MODE (D1/D2, 2026-08-27). Mode-blind, this counted every Daily a player
// has ever completed and Statistics then reported that single number as "Daily
// Challenge Mode" solves. Under three Dailies a day it silently becomes the SUM
// of three different games — inflating totalSolved, which is the denominator of
// every percentage bar in the breakdown, so a player's Easy PRACTICE bar shrank
// because Expert's Daily existed. `mode` follows the contract's shape
// (lane-contract §3.3): a required question with a 'daily' default, so a caller
// that has not been taught about modes keeps its exact current meaning —
// Challenge's Daily — instead of quietly losing the filter.
//
// Pass `null` to deliberately count ACROSS all modes (the "all Dailies" total).
// That is spelled out rather than being what you get by forgetting an argument.

/**
 * @param {Array<{ forfeited?: boolean, mode?: string }>} times - daily_challenge_times rows.
 * @param {string|null} [mode='daily'] - which Daily to count; `null` counts every mode.
 * @returns {number} count of non-forfeited completions (>= 0). Non-array → 0.
 */
export function countDailySolves(times, mode = 'daily') {
  if (!Array.isArray(times)) return 0;
  const rows = mode === null ? times : filterByMode(times, mode);
  let count = 0;
  for (const t of rows) {
    if (t && !t.forfeited) count++;
  }
  return count;
}
