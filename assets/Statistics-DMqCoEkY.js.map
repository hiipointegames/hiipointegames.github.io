import { isPerfectSolve } from '@/equation-engine';
import { hasPerfectConcept } from '@/game-modes';
import { filterByMode, normalizeDailyMode } from '@/components/stats/dailyModeStats';

// Read-side derivations of the daily-challenge completion-date sets the
// Statistics calendar renders. All pure — extracted from Statistics.jsx (they
// were inline `const`s in the render body). Kept as plain-arg functions so they
// unit-test without mounting the page.

/**
 * The list of dates the player has a daily-challenge time row for, FOR ONE MODE.
 *
 * ⚠️ D3 — the mode argument is not optional decoration. Mode-blind, this painted
 * a calendar day green because ONE of three modes was solved that day, which
 * made a green square stop meaning anything specific. `mode` therefore follows
 * the contract's shape (lane-contract §3.3): a required question with a `'daily'`
 * default, so every pre-three-modes caller keeps its exact current meaning —
 * Challenge's Daily — rather than silently losing the filter.
 *
 * @param {Array<{date: string, mode?: string}>|null|undefined} dailyChallengeTimes
 * @param {string} [mode='daily'] - which Daily to count.
 * @returns {string[]} the dates (order preserved; empty for missing input).
 */
export function completedDatesFromTimes(dailyChallengeTimes, mode = 'daily') {
  return filterByMode(dailyChallengeTimes, mode).map(t => t.date);
}

/**
 * The completed dates the VIEWER is allowed to see today's entry within.
 *
 * Anti-cheat: today's result is only shown to a viewer who has themselves
 * finished today (completed or forfeited → viewerCanSeeToday). When they can,
 * today is unioned in (deduped); when they can't, today is filtered out.
 *
 * @param {string[]} completedDates - the raw completed dates.
 * @param {string} todayDate - today's date key (ET).
 * @param {boolean} viewerCanSeeToday - whether the viewer has finished today.
 * @returns {string[]} the dates safe to show for this viewer.
 */
export function visibleCompletedDates(completedDates, todayDate, viewerCanSeeToday) {
  return viewerCanSeeToday
    ? [...new Set([...completedDates, todayDate])]
    : completedDates.filter(date => date !== todayDate);
}

/**
 * The subset of completed dates whose recorded solution was a PERFECT solve
 * (all three power dice used correctly). A date qualifies only when its stored
 * solution carries an equation + usedDiceIndices + diceColors and passes
 * isPerfectSolve.
 *
 * @param {string[]} completedDates - the dates to test.
 * @param {Object<string, {equation?: string, usedDiceIndices?: number[], diceColors?: string[]}>} userSolutions
 *   map of date → stored solution.
 * @returns {string[]} the dates that were perfect solves.
 */
export function perfectSolveDates(completedDates, userSolutions) {
  return completedDates.filter(date => {
    const solution = userSolutions[date];
    if (!solution?.equation || !solution?.usedDiceIndices || !solution?.diceColors) {
      return false;
    }
    return isPerfectSolve(solution.equation, solution.usedDiceIndices, solution.diceColors);
  });
}

/**
 * The dates that were PERFECT solves, derived straight from the authoritative
 * daily_challenge_times rows — which carry the equation/dice (`equation,
 * usedDiceIndices, diceColors`, the same leaderboard-visible columns). This is
 * the self-healing replacement for `perfectSolveDates(completedDates,
 * userSolutions)`, whose `userSolutions` came from the client `dailyChallengeSolutions`
 * blob that a backend migration partially dropped — leaving the calendar with
 * completed (green) days but never a perfect (gold) one (#4). Mirrors
 * `countPuzzlePointsFromTimes` (one is the count, this is the date set).
 *
 * ⚠️ PER MODE, AND EASY IS NOT MERELY EMPTY — IT IS EXEMPT. Easy deals all-white
 * dice, so `correctCount === 3` is arithmetically unreachable there
 * (`hasPerfectConcept`). This returns `[]` for Easy without inspecting a single
 * row, so a caller can never paint a gold perfect ring on an Easy calendar — and
 * the decision is read from the predicate, never from a hard-coded mode list
 * (the same rule seam F1 puts on the gold outline).
 *
 * @param {Array<{date?: string, mode?: string, equation?: string, usedDiceIndices?: number[], diceColors?: string[]}>|null|undefined} rows
 * @param {string} [mode='daily'] - which Daily to derive for.
 * @returns {string[]} distinct dates whose row is a perfect solve; always empty
 *   for a mode with no perfect-solve concept.
 */
export function perfectSolveDatesFromTimes(rows, mode = 'daily') {
  if (!hasPerfectConcept(normalizeDailyMode(mode))) return [];
  const dates = new Set();
  for (const row of filterByMode(rows, mode)) {
    if (!row) continue;
    const { date, equation, usedDiceIndices, diceColors } = row;
    if (!date || !equation || !usedDiceIndices || !diceColors) continue;
    if (isPerfectSolve(equation, usedDiceIndices, diceColors)) dates.add(date);
  }
  return [...dates];
}
