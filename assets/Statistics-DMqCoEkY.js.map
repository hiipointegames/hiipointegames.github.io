// Own-view Statistics gating — pure decisions, extracted so the branch logic
// that caused the legacy-username lockout is unit-testable (the page component
// itself is not mounted in tests).
//
// The bug: the own-view short-circuited to the "create an account" prompt for
// ANY anonymous account, walling legacy username-only players out of stats they
// own (and that other players can already see). The fix distinguishes a fresh
// guest from a NAMED account (has_custom_username) that owns a profile + history.
import { isGuest, isNamedAccount } from '@/auth';

/**
 * True when an own-view should short-circuit to the create-account prompt: a
 * FRESH guest (anonymous, no chosen username → no profile row, nothing to load).
 * A named account is intentionally NOT prompted here — it has stats to show.
 */
export function shouldPromptGuestCreateAccount({ viewingOwnStats, user }) {
  return Boolean(viewingOwnStats) && isGuest(user) && !isNamedAccount(user);
}

/**
 * True when an own-view should render stats AND a persistent "secure your
 * account" banner: a NAMED account that is still an unsecured guest. Its stats
 * live only on the current device's session until it is secured.
 */
export function shouldShowSecureBanner({ viewingOwnStats, user }) {
  return Boolean(viewingOwnStats) && isGuest(user) && isNamedAccount(user);
}
