/**
 * Compact axis-tick label for a solve-time value (in seconds): `M:SS` at a
 * minute or more, `SSs` below a minute (e.g. `2:05`, `42s`). Whole seconds
 * only — no hundredths; this is a chart axis, not a result readout (see
 * formatSolveTime for the precise `M:SS.HH` form). Seconds are truncated.
 *
 * @param {number} seconds
 * @returns {string}
 */
export function formatAxisTime(seconds) {
  const mins = Math.floor(seconds / 60);
  const secs = Math.floor(seconds % 60);
  return mins > 0 ? `${mins}:${secs.toString().padStart(2, '0')}` : `${secs}s`;
}
