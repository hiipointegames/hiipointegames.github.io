import React, { useState } from 'react';
import { ShieldCheck, X, ArrowRight } from 'lucide-react';
import { Button } from '@/ui/primitives/button';

// Persistent, dismissible "secure your account" nudge shown ABOVE the stats of a
// NAMED but still-unsecured account (isGuest && isNamedAccount). Unlike
// GuestStatsPrompt (which REPLACES the page for a fresh guest), this sits above
// real, loaded stats — the account can see everything; it just isn't backed up
// yet. Framed as a proactive security step, honest about the real risk: the
// stats live only on this device's session until a password is set.
//
// Presentational: onSecure opens the Save-Stats flow; dismissal is local.
export default function SecureAccountBanner({ onSecure }) {
  const [dismissed, setDismissed] = useState(false);
  if (dismissed) return null;

  return (
    <div
      className="max-w-3xl mx-auto mb-5 rounded-xl p-4 flex items-start gap-3 border"
      style={{
        background: 'var(--u37-panel-bg)',
        borderColor: 'color-mix(in srgb, var(--u37-cyan) 45%, transparent)',
      }}
      role="status"
    >
      <ShieldCheck className="w-6 h-6 shrink-0 mt-0.5" style={{ color: 'var(--u37-cyan)' }} />
      <div className="flex-1 min-w-0">
        <p className="text-white font-bold text-sm mb-1">Secure your account</p>
        <p className="text-slate-300 text-xs mb-3">
          Your stats live only on this device. Add a password to keep them and sign in anywhere.
        </p>
        <Button
          onClick={onSecure}
          className="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500
            text-white border border-cyan-400/50 min-h-[40px] px-4 text-sm touch-manipulation shadow-lg"
        >
          Secure my account
          <ArrowRight className="w-4 h-4 ml-2" />
        </Button>
      </div>
      <button
        type="button"
        onClick={() => setDismissed(true)}
        aria-label="Dismiss"
        className="shrink-0 p-1 text-slate-400 hover:text-white"
      >
        <X className="w-4 h-4" />
      </button>
    </div>
  );
}
