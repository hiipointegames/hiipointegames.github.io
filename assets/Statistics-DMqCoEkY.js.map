import React from 'react';
import { formatSolveTime, formatAxisTime } from '@/ui/feedback';

// WeekBarChart — the seven-day solve-time bars for ONE Daily tier.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS EXISTS INSTEAD OF recharts
// ─────────────────────────────────────────────────────────────────────────────
// recharts cost 380 KB in the bundle to draw exactly ONE chart — this one, in
// WeekModeSection, its only importer in the whole app. Measured 2026-09-11, the
// mobile OTA bundle was 11.32 MB against the ~10 MB ceiling CapGo's 25 s download
// timeout imposes, and a bundle that misses that timeout silently never applies.
//
// Lazy-loading did not help: recharts already sat in its own chunk behind the
// code-split Statistics route, but the OTA bundle ships EVERY file whether the
// player opens Statistics or not. The only way to stop paying for it was to stop
// shipping it.
//
// This is a deliberate re-implementation of what recharts drew, not a redesign —
// the layout constants below are recharts' own defaults, kept so the chart lands
// in the same place on the page.
//
// ⚠️ THE GRADIENT STOPS USE `style`, NOT AN ATTRIBUTE. The bars paint from the
// tier accent, which is a `var(--u37-*)` token. `var()` resolves in a CSS
// declaration but is NOT guaranteed to resolve in an SVG presentation attribute.
// This carried over from the recharts version and the reason is unchanged — see
// the same warning in WeekModeSection.
//
// ⚠️ WIDTH IS MEASURED, NOT ASSUMED. An SVG scaled by `viewBox` alone would scale
// its TEXT with the container, so the tick labels would grow on a wide screen.
// The chart measures its own width and lays out in real pixels, which is what
// recharts' ResponsiveContainer did. Tests pass an explicit `width` to skip
// measurement, because happy-dom reports clientWidth 0 — the same limitation that
// forced the old tests to stub recharts out entirely.

// recharts' own defaults, preserved so the chart occupies the same box.
const HEIGHT = 220;
const MARGIN = { top: 20, right: 5, left: 5, bottom: 5 };
const Y_AXIS_WIDTH = 60;
const X_AXIS_HEIGHT = 30;
const BAR_SIZE = 26;
const BAR_RADIUS = 4;
const AXIS_STROKE = '#94a3b8';
const GRID_STROKE = '#334155';

/**
 * "Nice" axis ticks COVERING [0, max] — steps of 1, 2, 2.5, 5 or 10 times a power
 * of ten, which is the same family of steps recharts picks. Without this the axis
 * reads 0, 23.4, 46.8 … instead of 0, 25, 50 ….
 *
 * The last tick is at or ABOVE `max`, and the caller scales to that tick rather
 * than to `max`. This is what recharts does, and skipping it is visible: with the
 * axis capped at the data maximum, the tallest bar rises past the topmost
 * gridline and the chart looks clipped. Caught in a render preview, not by a test.
 *
 * @param {number} max
 * @param {number} [count] target number of ticks (recharts' default is 5)
 * @returns {number[]}
 */
export function niceTicks(max, count = 5) {
  if (!(max > 0) || !Number.isFinite(max)) return [0];
  const rawStep = max / Math.max(1, count - 1);
  const magnitude = Math.pow(10, Math.floor(Math.log10(rawStep)));
  const normalized = rawStep / magnitude;
  const step = (normalized <= 1 ? 1
    : normalized <= 2 ? 2
      : normalized <= 2.5 ? 2.5
        : normalized <= 5 ? 5
          : 10) * magnitude;

  const ticks = [];
  // Guard the loop rather than trusting float accumulation to terminate.
  for (let i = 0; i <= count * 4; i++) {
    const value = Number((i * step).toPrecision(12));
    ticks.push(value);
    if (value >= max - step * 1e-9) break;
  }
  return ticks.length ? ticks : [0];
}

/**
 * A bar with rounded TOP corners only — recharts' `radius={[4, 4, 0, 0]}`.
 * The radius collapses for short or narrow bars so a 2px-tall bar cannot render
 * as a lopsided blob.
 */
function barPath(x, y, w, h, r) {
  const radius = Math.max(0, Math.min(r, w / 2, h));
  if (radius === 0) return `M${x},${y}h${w}v${h}h${-w}Z`;
  return [
    `M${x},${y + h}`,
    `L${x},${y + radius}`,
    `Q${x},${y} ${x + radius},${y}`,
    `L${x + w - radius},${y}`,
    `Q${x + w},${y} ${x + w},${y + radius}`,
    `L${x + w},${y + h}`,
    'Z',
  ].join('');
}

/**
 * Measure the container's width. Returns 0 until a real measurement lands, which
 * is the signal not to draw yet.
 */
function useMeasuredWidth(ref, override) {
  const [width, setWidth] = React.useState(override ?? 0);

  React.useEffect(() => {
    if (override != null) return undefined;
    const el = ref.current;
    if (!el) return undefined;

    const measure = () => setWidth(el.clientWidth || 0);
    measure();

    if (typeof ResizeObserver === 'undefined') {
      window.addEventListener('resize', measure);
      return () => window.removeEventListener('resize', measure);
    }
    const observer = new ResizeObserver(measure);
    observer.observe(el);
    return () => observer.disconnect();
  }, [ref, override]);

  return override ?? width;
}

/**
 * @param {{
 *   data: Array<{date?: string, dayName?: string, time?: number|null}>,
 *   accent: string,
 *   gradientId: string,
 *   markedDays?: string[],
 *   width?: number,
 * }} props
 */
export default function WeekBarChart({ data, accent, gradientId, markedDays = ['Mon', 'Wed'], width: widthOverride }) {
  const containerRef = React.useRef(null);
  const width = useMeasuredWidth(containerRef, widthOverride);

  // Same domain rule the recharts version used: at least 10, and always 10 of
  // headroom above the slowest solve so the tallest bar never touches the top.
  const times = data.filter((d) => d.time > 0).map((d) => d.time);
  const yMax = Math.max(10, ...(times.length ? times : [0])) + 10;
  const ticks = niceTicks(yMax);
  // Scale to the TOP TICK, not to yMax — so the highest gridline is the top of
  // the plot and no bar can overshoot it.
  const axisMax = ticks[ticks.length - 1] || yMax;

  const plotLeft = MARGIN.left + Y_AXIS_WIDTH;
  const plotRight = Math.max(plotLeft, width - MARGIN.right);
  const plotTop = MARGIN.top;
  const plotBottom = HEIGHT - MARGIN.bottom - X_AXIS_HEIGHT;
  const plotWidth = plotRight - plotLeft;
  const plotHeight = plotBottom - plotTop;

  const bandWidth = data.length ? plotWidth / data.length : 0;
  const bandCenter = (i) => plotLeft + bandWidth * (i + 0.5);
  const yOf = (value) => plotBottom - (value / axisMax) * plotHeight;

  return (
    <div ref={containerRef} style={{ width: '100%', height: HEIGHT }} data-testid="week-bar-chart">
      {width > 0 ? (
        <svg
          width={width}
          height={HEIGHT}
          role="img"
          aria-label="Solve times for each day this week"
          data-accent={accent}
        >
          <defs>
            {/* stopColor via `style` — see the warning at the top of this file. */}
            <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" style={{ stopColor: accent, stopOpacity: 0.95 }} />
              <stop offset="100%" style={{ stopColor: accent, stopOpacity: 0.35 }} />
            </linearGradient>
          </defs>

          {/* Grid — horizontal at each tick, vertical at each day. */}
          <g data-testid="week-bar-grid">
            {ticks.map((t) => (
              <line
                key={`h-${t}`}
                x1={plotLeft} x2={plotRight}
                y1={yOf(t)} y2={yOf(t)}
                stroke={GRID_STROKE} strokeDasharray="3 3"
              />
            ))}
            {data.map((d, i) => (
              <line
                key={`v-${d.date || d.dayName || i}`}
                x1={bandCenter(i)} x2={bandCenter(i)}
                y1={plotTop} y2={plotBottom}
                stroke={GRID_STROKE} strokeDasharray="3 3"
              />
            ))}
          </g>

          {/* The emphasised weekday markers the recharts version drew as ReferenceLines. */}
          {data.map((d, i) => (markedDays.includes(d.dayName) ? (
            <line
              key={`ref-${d.date || d.dayName || i}`}
              data-testid="week-bar-marker"
              x1={bandCenter(i)} x2={bandCenter(i)}
              y1={plotTop} y2={plotBottom}
              stroke={GRID_STROKE} strokeDasharray="3 3"
              strokeWidth={1.5} strokeOpacity={0.6}
            />
          ) : null))}

          {/* Axis lines */}
          <line x1={plotLeft} x2={plotRight} y1={plotBottom} y2={plotBottom} stroke={AXIS_STROKE} />
          <line x1={plotLeft} x2={plotLeft} y1={plotTop} y2={plotBottom} stroke={AXIS_STROKE} />

          {/* Y ticks */}
          <g>
            {ticks.map((t) => (
              <g key={`yt-${t}`}>
                <line x1={plotLeft - 6} x2={plotLeft} y1={yOf(t)} y2={yOf(t)} stroke={AXIS_STROKE} />
                <text
                  x={plotLeft - 9} y={yOf(t)}
                  textAnchor="end" dominantBaseline="middle"
                  fontSize="10" fill={AXIS_STROKE}
                >
                  {formatAxisTime(t)}
                </text>
              </g>
            ))}
          </g>

          {/* X ticks */}
          <g>
            {data.map((d, i) => (
              <g key={`xt-${d.date || d.dayName || i}`}>
                <line
                  x1={bandCenter(i)} x2={bandCenter(i)}
                  y1={plotBottom} y2={plotBottom + 6}
                  stroke={AXIS_STROKE}
                />
                <text
                  x={bandCenter(i)} y={plotBottom + 18}
                  textAnchor="middle" fontSize="10" fill={AXIS_STROKE}
                >
                  {d.dayName}
                </text>
              </g>
            ))}
          </g>

          {/* Bars + their in-bar value labels. A day with no solve draws nothing,
              which is what recharts did with a null dataKey value. */}
          <g>
            {data.map((d, i) => {
              if (!(d.time > 0)) return null;
              const barX = bandCenter(i) - BAR_SIZE / 2;
              const barY = yOf(d.time);
              const barH = plotBottom - barY;
              return (
                <g key={`bar-${d.date || d.dayName || i}`}>
                  <path
                    data-testid="week-bar"
                    d={barPath(barX, barY, BAR_SIZE, barH, BAR_RADIUS)}
                    fill={`url(#${gradientId})`}
                  />
                  <text
                    x={bandCenter(i)} y={barY + barH / 2}
                    textAnchor="middle" dominantBaseline="middle"
                    fontSize="9" fontWeight="bold" fill="#ffffff"
                  >
                    {formatSolveTime(d.time)}
                  </text>
                </g>
              );
            })}
          </g>
        </svg>
      ) : null}
    </div>
  );
}
