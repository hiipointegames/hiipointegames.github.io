import { useState, useEffect } from 'react';
import { apiClient } from '@/transport';
import { todayET } from '@/daily-challenge';
import { getLeaderboard } from '@/stats-aggregation';
import { rowModeKey, normalizeDailyMode } from './dailyModeStats';

// useDayModal — the "tap a calendar day" machinery, extracted from Statistics.jsx
// and made mode-aware (D6).
//
// ─────────────────────────────────────────────────────────────────────────────
// A DATE NO LONGER IDENTIFIES A SOLVE
// ─────────────────────────────────────────────────────────────────────────────
// The page kept `userSolutions` as a plain `{ [date]: row }` map. With three
// Dailies a day, three rows share a date and the last one written silently won —
// so opening a past day could show you a different game's equation, dice and
// time, with nothing on screen admitting it. The map is keyed `${date}|${mode}`
// and read back through the mode currently on screen.
//
// The winner lookup is scoped the same way: `getLeaderboard({ date, mode })`.
// An unscoped board would name whoever was fastest across all three modes as
// "the winner" of the one you are looking at.
//
// ⚠️ THE FORFEIT CHECK IS SCOPED TOO. It used `attempts[0]` over an unordered,
// unfiltered read — with one attempt row per player per day that was merely
// fragile; with three it is arbitrary, and forfeiting Easy would paint Expert as
// forfeited. It now filters to the mode before asking.

/**
 * @param {{
 *   mode: string,
 *   pastChallenges: any[],
 *   userFailedDates: string[],
 *   userSolutions: Record<string, any>,   // keyed `${date}|${mode}`
 *   viewerId: string | null | undefined,  // whose forfeit status to check
 * }} args
 */
export function useDayModal({ mode, pastChallenges, userFailedDates, userSolutions, viewerId }) {
  const modeKey = normalizeDailyMode(mode);
  const [selectedChallenge, setSelectedChallenge] = useState(null);
  const [showChallengeModal, setShowChallengeModal] = useState(false);
  const [selectedDayWinner, setSelectedDayWinner] = useState(null);
  const [selectedDayIsFailed, setSelectedDayIsFailed] = useState(false);
  const [todayForfeitStatus, setTodayForfeitStatus] = useState(false);

  // Did the viewed player forfeit TODAY'S <mode>?
  useEffect(() => {
    if (!viewerId) return undefined;
    let cancelled = false;
    (async () => {
      try {
        const rows = await apiClient.entities.DailyChallengeAttempt.filter({
          date: todayET(),
          user_id: viewerId,
        });
        // Scope to the mode on screen before reading a status off row zero.
        const mine = (rows || []).filter(a => rowModeKey(a) === modeKey);
        if (!cancelled) {
          setTodayForfeitStatus(
            mine.some(a => a.daily_status === 'forfeited' || a.forfeited === true),
          );
        }
      } catch (error) {
        console.error('Failed to check forfeit status:', error);
      }
    })();
    return () => { cancelled = true; };
  }, [viewerId, modeKey]);

  const openDay = async (date) => {
    const challenge = pastChallenges.find(c => c.date === date);
    if (!challenge) return;
    setSelectedChallenge(challenge);
    setSelectedDayIsFailed(userFailedDates.includes(date));

    try {
      // Paginated + server-ordered read (W2-F3): the old .filter({date}) capped
      // at ~1000 unordered rows, so the "winner" could be wrong on a big day.
      const sortedTimes = await getLeaderboard({ date, mode: modeKey });
      setSelectedDayWinner(
        sortedTimes.length > 0
          ? { ...sortedTimes[0], usedDiceIndices: sortedTimes[0].usedDiceIndices || null }
          : null,
      );
    } catch (error) {
      console.error('Failed to load day leaderboard:', error);
      setSelectedDayWinner(null);
    }
    setShowChallengeModal(true);
  };

  const selectedSolve = selectedChallenge
    ? userSolutions[`${selectedChallenge.date}|${modeKey}`] ?? null
    : null;

  return {
    selectedChallenge,
    showChallengeModal,
    closeDay: () => setShowChallengeModal(false),
    selectedDayWinner,
    selectedDayIsFailed,
    todayForfeitStatus,
    openDay,
    selectedSolve,
  };
}
