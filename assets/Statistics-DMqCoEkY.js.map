import React from 'react';
import { DAILY_MODE_KEYS } from '@/game-modes';
import { dailyModeLabel, dailyModeAccent, normalizeDailyMode } from './dailyModeStats';

// DailyModeTabs — the three-way Daily selector the day-scoped stats surfaces share.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY A SELECTOR RATHER THAN THREE OF EVERYTHING
// ─────────────────────────────────────────────────────────────────────────────
// Three Dailies a day could be shown two ways: render every surface three times,
// or scope each surface to one mode. Three calendars stacked on a phone is not a
// stats page, it is a scrolling contest — and the calendar, the weekly bar chart
// and the day modal are all already full-width on the smallest device we ship
// to. So the day-scoped surfaces take a mode, and this is where the player picks
// it.
//
// The trio that does NOT use this is the streak row: three independent streaks
// (Q-F) are a headline fact about the player, not a filter, so all three are
// shown at once. A number you have to go looking for reads as a footnote.
//
// ─────────────────────────────────────────────────────────────────────────────
// A MODE WITH NO PUZZLE IS STILL A REAL MODE
// ─────────────────────────────────────────────────────────────────────────────
// Production has exactly ONE puzzle per date today — Easy's and Expert's Dailies
// do not exist in prod data yet, and will not until the three-a-night cron is
// unheld. All three tabs still render: hiding a mode until it has data would
// make the stats page disagree with the home screen about which games exist, and
// would silently un-hide itself one night with no warning.
//
// `emptyModes` marks the ones with nothing behind them, so the tab can say so
// quietly rather than presenting an all-zero surface as a record of failure.
// It is advisory styling only — every tab stays selectable, because a player
// looking for "why is my Expert empty?" needs to be able to land there and read
// the answer.
//
// Nothing here hard-codes which modes exist: the tabs come from DAILY_MODE_KEYS
// in play order, and the labels and accents derive from the mode itself.

/**
 * @param {{
 *   value: string,                       // the selected Daily mode key
 *   onChange: (modeKey: string) => void,
 *   emptyModes?: string[],               // modes with no data behind them
 *   ariaLabel?: string,
 * }} props
 */
export default function DailyModeTabs({ value, onChange, emptyModes = [], ariaLabel = 'Choose a Daily mode' }) {
  const selected = normalizeDailyMode(value);

  return (
    <div
      role="tablist"
      aria-label={ariaLabel}
      className="flex items-stretch gap-1.5 mb-3 rounded-xl bg-slate-800/60 p-1 border border-slate-700/60"
    >
      {DAILY_MODE_KEYS.map((modeKey) => {
        const isSelected = modeKey === selected;
        const accent = dailyModeAccent(modeKey);
        const isEmpty = emptyModes.includes(modeKey);
        return (
          <button
            key={modeKey}
            type="button"
            role="tab"
            aria-selected={isSelected}
            aria-controls="daily-mode-panel"
            // Mirrored into attributes for the same reason DailyPerformanceSlide
            // does it: happy-dom drops `color-mix()`, so the selected RING is
            // untestable and a test must read state, not paint.
            data-testid="daily-mode-tab"
            data-mode-key={modeKey}
            data-selected={String(isSelected)}
            onClick={() => onChange(modeKey)}
            className={`flex-1 min-w-0 min-h-[44px] rounded-lg px-2 py-1.5 text-xs sm:text-sm font-bold
              uppercase tracking-wide truncate transition-all duration-200
              focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-200/70
              focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900
              hover:-translate-y-0.5 active:translate-y-0
              ${isSelected ? 'text-slate-100' : 'text-slate-400 opacity-80 hover:opacity-100 hover:text-slate-200'}
              ${isEmpty && !isSelected ? 'opacity-60' : ''}`}
            style={isSelected ? {
              background: `color-mix(in srgb, ${accent} 22%, transparent)`,
              // Same ring weight and glow as the streak-counter buttons, so the
              // carousel speaks ONE selected-language. Inset rather than outset
              // because this pill sits inside a track; an outer ring would collide
              // with the track's own border.
              boxShadow: `inset 0 0 0 2px color-mix(in srgb, ${accent} 85%, transparent), 0 0 20px -8px ${accent}`,
            } : undefined}
          >
            {dailyModeLabel(modeKey)}
          </button>
        );
      })}
    </div>
  );
}
