import React from 'react';
import { formatSolveTime } from '@/ui/feedback';
import { buildWeekData, summarizeWeek } from '@/stats-aggregation';
import WeekBarChart from './WeekBarChart';
import { filterByMode, dailyModeAccent, dailyModeFullLabel, dailyModeTheme } from './dailyModeStats';

// WeekModeSection — ONE Daily's week: the two summary counters, the seven-day
// state strip, and the bar chart. Extracted from WeeklyPerformanceGraph so that
// slide can render the same block three times instead of once.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS WEEK IS THREE WEEKS NOW
// ─────────────────────────────────────────────────────────────────────────────
// The weekly graph was the last surface still answering "how was your week?" for
// whichever Daily happened to be selected somewhere else on the page. David,
// 2026-09-04: *"needs to be updated to now include 3 color coordinated sections
// for easy, challenge and expert. same data and same style display, but for all
// modes."*
//
// That is a deliberate departure from the rest of the page, where day-scoped
// surfaces show ONE mode at a time (see DailyModeTabs' argument: three calendars
// stacked on a phone is a scrolling contest). A week is the exception because it
// is BOUNDED — seven days, a fixed strip and a short chart — and because
// comparing the three tiers across the same seven days is the actual question:
// which of them did you keep up with. Three calendars cannot be compared at a
// glance; three weeks can.
//
// ⚠️ THE SECTION FILTERS ITS OWN ROWS. It takes the whole times log and scopes
// it here rather than being handed a pre-filtered array, so the parent cannot
// pass Challenge's rows under an Expert heading — which is precisely the class
// of bug the mode-blind version had.
//
// ⚠️ THE CHART COLOUR COMES FROM `style`, NOT AN ATTRIBUTE. The bars paint from
// the tier accent, which is a `var(--u37-*)` token; `var()` resolves in a CSS
// declaration but is not guaranteed to resolve in an SVG presentation
// ATTRIBUTE. The gradient stops therefore set `style={{ stopColor }}`, which is
// a real declaration. `data-accent` mirrors the value for the same reason every
// other mode-scoped surface here does: happy-dom cannot read the resolved token.
// That rule moved WITH the bars into WeekBarChart — it is restated there.
//
/**
 * @param {{
 *   modeKey: string,
 *   weekDays: Array<{date: string, dayName: string, displayDate: string, isPast: boolean}>,
 *   times: Array<{date: string, mode?: string, time?: number|null, forfeited?: boolean}>|null|undefined,
 *   failedDates: string[],
 *   isSelected?: boolean,
 * }} props
 */
export default function WeekModeSection({ modeKey, weekDays, times, failedDates, isSelected = false }) {
  const accent = dailyModeAccent(modeKey);
  const weekData = buildWeekData(weekDays, filterByMode(times, modeKey), failedDates);
  const { completedPuzzles, forfeitedCount, avgTime } = summarizeWeek(weekData);
  const gradientId = `weekBar-${modeKey}`;

  return (
    <section
      data-testid="week-mode-section"
      data-mode={dailyModeTheme(modeKey)}
      data-accent={accent}
      data-selected={String(isSelected)}
      className="rounded-xl border p-3 mb-4"
      style={{
        borderColor: `color-mix(in srgb, ${accent} ${isSelected ? '70%' : '30%'}, transparent)`,
        // The SELECTED tier (the one the streak buttons picked) gets a soft
        // glow, so this slide and the Daily Performance slide agree about which
        // game the player is looking at without either shouting about it.
        boxShadow: isSelected ? `0 0 22px -12px ${accent}` : undefined,
      }}
    >
      <h4
        data-testid="week-mode-heading"
        className="text-sm font-bold mb-2"
        style={{ color: accent }}
      >
        {dailyModeFullLabel(modeKey)}
      </h4>

      {/* Week Stats Summary */}
      <div className="grid grid-cols-2 gap-3 mb-3">
        <div
          className="rounded-xl p-3 border"
          style={{
            borderColor: `color-mix(in srgb, ${accent} 35%, transparent)`,
            background: `color-mix(in srgb, ${accent} 10%, transparent)`,
          }}
        >
          <div className="text-slate-300 text-xs font-semibold uppercase mb-1">Completed</div>
          <div data-testid="week-completed" className="text-slate-200 text-2xl font-black">{completedPuzzles}/7</div>
        </div>
        <div
          className="rounded-xl p-3 border"
          style={{
            borderColor: `color-mix(in srgb, ${accent} 35%, transparent)`,
            background: `color-mix(in srgb, ${accent} 10%, transparent)`,
          }}
        >
          <div className="text-slate-300 text-xs font-semibold uppercase mb-1">Avg Time</div>
          <div data-testid="week-avg" className="text-slate-200 text-2xl font-black">
            {completedPuzzles > 0 ? formatSolveTime(avgTime) : '--'}
          </div>
        </div>
      </div>

      {/* 2D: per-day state strip — completed / forfeited / no-attempt, each with
          a distinct color + icon. Upcoming days are muted. */}
      <div className="mb-3">
        <div className="grid grid-cols-7 gap-1.5">
          {weekData.map((d) => {
            const s = {
              completed: { ring: 'border-emerald-400/70 bg-emerald-500/15', icon: '✓', iconClass: 'text-emerald-300' },
              forfeited: { ring: 'border-rose-400/70 bg-rose-500/15', icon: '✕', iconClass: 'text-rose-300' },
              none: { ring: 'border-slate-600/50 bg-slate-700/20', icon: '–', iconClass: 'text-slate-400' },
              upcoming: { ring: 'border-slate-700/40 bg-slate-800/20', icon: '·', iconClass: 'text-slate-600' },
            }[d.status];
            return (
              <div key={d.date} className={`rounded-lg border ${s.ring} flex flex-col items-center py-1.5`}>
                <span className="text-[10px] font-bold text-slate-300">{d.dayName}</span>
                <span className={`text-sm font-black leading-none mt-1 ${s.iconClass}`}>{s.icon}</span>
              </div>
            );
          })}
        </div>
        <div className="flex items-center justify-center flex-wrap gap-x-3 gap-y-1 mt-2 text-[10px] text-slate-400">
          <span className="flex items-center gap-1"><span className="text-emerald-300 font-black">✓</span>Completed</span>
          <span className="flex items-center gap-1"><span className="text-rose-300 font-black">✕</span>Forfeited{forfeitedCount > 0 ? ` (${forfeitedCount})` : ''}</span>
          <span className="flex items-center gap-1"><span className="text-slate-400 font-black">–</span>No attempt</span>
        </div>
      </div>

      {/* Bar Chart. Shorter than the single-mode version was (320 → 220): three
          of these stack on one phone screen now, and the bars still carry their
          own value labels, so the height was resolution the chart did not need.

          Drawn by WeekBarChart (plain SVG) rather than recharts since 2026-09-12.
          recharts cost 380 KB in the bundle for this one chart — its only importer
          in the app — while the mobile OTA bundle sat over CapGo's download
          ceiling. Same layout constants, same colours; see that file for why. */}
      <div className="h-56 w-full -mx-6">
        <WeekBarChart data={weekData} accent={accent} gradientId={gradientId} />
      </div>
    </section>
  );
}
