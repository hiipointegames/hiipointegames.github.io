import React from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { nowET } from '@/daily-challenge';
import { DAILY_MODE_KEYS } from '@/game-modes';
import WeekModeSection from './WeekModeSection';
import { filterByMode, dailyModeAccent, normalizeDailyMode, dailyModeTheme } from './dailyModeStats';

// WeeklyPerformanceGraph — the "Weekly Graph" stats slide. It owns the WEEK
// (which seven days, the navigator that moves them) and renders one
// WeekModeSection per Daily inside that window.
//
// ─────────────────────────────────────────────────────────────────────────────
// ALL THREE DAILIES, ONE WEEK
// ─────────────────────────────────────────────────────────────────────────────
// This slide used to draw a single mode's week — whichever tier was selected on
// another slide — which made the commonest question about a week unanswerable:
// you could see that you kept your Challenge streak, but not that Expert went
// untouched for five days. David, 2026-09-04: *"3 color coordinated sections for
// easy, challenge and expert. same data and same style display, but for all
// modes."* Green / cyan / gold, the project's canonical tier colours.
//
// The NAVIGATOR STAYS SINGULAR. One week window, three sections inside it: three
// independent navigators would let the page show Easy's last week beside
// Expert's this week, which is a comparison of nothing. `selectedWeekOffset`
// therefore remains one number owned by the parent, exactly as before.
//
// ─────────────────────────────────────────────────────────────────────────────
// FORFEITS ARE NOW SCOPED TO THE MODE THAT FORFEITED
// ─────────────────────────────────────────────────────────────────────────────
// ⚠️ `userFailedDates` is a DATE-ONLY list, flattened across all three Dailies
// before it ever reached this component — so forfeiting Easy on Tuesday painted
// a red ✕ on Tuesday in Challenge's week and Expert's too. With one Daily a day
// that was correct; with three it reports a failure in a game that was never
// started. The fix is the `attempts` ROWS, which carry `mode`, filtered per
// section the same way the times rows already were. `userFailedDates` is kept
// only as the fallback for a caller that has not been given the rows yet.
//
/**
 * @param {{
 *   stats: { dailyChallengeTimes?: Array<{date: string, time: number, mode?: string}> },
 *   mode: string,                        // the tier selected elsewhere on the page — emphasised, not filtered to
 *   selectedWeekOffset: number,          // 0 = current week, negative = weeks ago
 *   onWeekOffsetChange: (updater: number | ((prev: number) => number)) => void,
 *   attempts?: Array<{date?: string, mode?: string, forfeited?: boolean}>,
 *   userFailedDates?: Set<string> | string[],   // legacy, mode-blind fallback
 *   expanded?: boolean,                  // gate kept from the old expandedSections.performance
 * }} props
 */
export default function WeeklyPerformanceGraph({
  stats,
  mode,
  selectedWeekOffset,
  onWeekOffsetChange,
  attempts,
  userFailedDates,
  expanded = true,
}) {
  // Get all 7 days of selected week (Monday to Sunday)
  const today = nowET();
  const startOfWeek = nowET().startOf('isoWeek').add(selectedWeekOffset, 'weeks'); // Monday
  const endOfWeek = startOfWeek.clone().add(6, 'days'); // Sunday

  // Create array of all 7 days
  const weekDays = Array.from({ length: 7 }, (_, i) => {
    const day = startOfWeek.clone().add(i, 'days');
    return {
      date: day.format('YYYY-MM-DD'),
      dayName: day.format('ddd'),
      displayDate: day.format('M/D'),
      isPast: day.isSameOrBefore(today, 'day')
    };
  });

  // Format date range
  const dateRangeText = `${startOfWeek.format('MMM D')} - ${endOfWeek.format('MMM D, YYYY')}`;
  const isCurrentWeek = selectedWeekOffset === 0;
  const canGoForward = selectedWeekOffset < 0;
  const selectedMode = normalizeDailyMode(mode);
  const selectedAccent = dailyModeAccent(selectedMode);

  // The attempt ROWS are authoritative when supplied — an empty array is still
  // an answer ("this player forfeited nothing"), so presence is what decides,
  // not length. Only a caller that passed no rows at all falls back to the
  // flattened, mode-blind date list.
  //
  // ⚠️ AN ARRAY, NOT A SET. buildWeekData asks it `.includes(date)`, which a Set
  // does not answer — it would throw at render, and every test here mocks that
  // helper so no suite could have caught it. Deduped through a Set, handed on as
  // an array; the legacy prop is normalised the same way in case a caller passes
  // the Set its old type allowed.
  const hasAttemptRows = Array.isArray(attempts);
  const failedDatesFor = (modeKey) => (
    hasAttemptRows
      ? [...new Set(filterByMode(attempts, modeKey).filter(a => a?.forfeited === true).map(a => a.date))]
      : [...(userFailedDates ?? [])]
  );

  return (
    // `data-mode` / `data-accent` still name the SELECTED tier, because the
    // carousel frame around this slide is painted in it and one of the three
    // sections below is emphasised to match. They no longer say what the slide
    // is ABOUT — it is about all three — which is why each section carries its
    // own pair.
    <motion.div
      data-testid="weekly-performance-graph"
      data-mode={dailyModeTheme(selectedMode)}
      data-accent={selectedAccent}
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: 0.25 }}
      className="p-0 mb-0"
    >
      {/* Condensed header (item 9): the 📊 emoji accent + the live-state title
          ("This Week's Performance" vs "Week Performance") are kept — the title
          carries current-week state the carousel label ("Weekly Graph") does
          not — only the size/margin shrank to fit more per screen. The title no
          longer NAMES a Daily: every Daily is below it now, each under its own
          coloured heading. */}
      <div
        className="w-full flex items-center mb-3"
      >
        <div className="flex items-center gap-2">
          <span className="text-2xl">📊</span>
          <h3
            data-testid="weekly-graph-title"
            className="text-base font-bold text-slate-100"
          >
            {isCurrentWeek ? 'This Week — All Three Dailies' : 'Week Performance — All Three Dailies'}
          </h3>
        </div>
      </div>

      {expanded && (
        <motion.div
          initial={{ opacity: 0, height: 0 }}
          animate={{ opacity: 1, height: 'auto' }}
          exit={{ opacity: 0, height: 0 }}
        >
          {/* One section per Daily, in play order (Easy → Challenge → Expert),
              from DAILY_MODE_KEYS rather than a local list — the same reason
              DailyModeTabs maps it: a fourth tier must not need an edit here. */}
          {DAILY_MODE_KEYS.map((modeKey) => (
            <WeekModeSection
              key={modeKey}
              modeKey={modeKey}
              weekDays={weekDays}
              times={stats.dailyChallengeTimes}
              failedDates={failedDatesFor(modeKey)}
              isSelected={modeKey === selectedMode}
            />
          ))}

          {/* Week Navigation — ONE window for all three sections. */}
          <div className="mt-6 pt-4 border-t border-slate-700/50">
            <div className="text-center mb-4">
              <div className="text-slate-300 text-sm font-semibold">{dateRangeText}</div>
              <div className="text-slate-500 text-xs mt-0.5">
                {isCurrentWeek ? 'Current Week' : `${Math.abs(selectedWeekOffset)} week${Math.abs(selectedWeekOffset) > 1 ? 's' : ''} ago`}
              </div>
            </div>

            <div className="flex items-center justify-between gap-4">
              <Button
                onClick={() => onWeekOffsetChange(prev => prev - 1)}
                variant="outline"
                size="sm"
                className="bg-slate-700/50 hover:bg-slate-600/50 text-slate-300 border-slate-600"
              >
                ← Previous Week
              </Button>

              <Button
                onClick={() => onWeekOffsetChange(prev => prev + 1)}
                variant="outline"
                size="sm"
                disabled={!canGoForward}
                className="bg-slate-700/50 hover:bg-slate-600/50 text-slate-300 border-slate-600 disabled:opacity-30 disabled:cursor-not-allowed"
              >
                Next Week →
              </Button>
            </div>
          </div>

          <p className="text-slate-400 text-xs text-center mt-4">
            {/* ⚠️ 'ET', NOT 'EST' (David, 2026-09-17). EST is the winter offset;
                EDT runs until 1 November, so for seven months of the year this
                named a timezone the app was not using. Every other time string
                in the app already said ET — 'midnight ET', 'drawn Sundays 9pm
                ET' — so this was the lone holdout.

                ⚠️ AND 'STATS WEEK', because there are now TWO weeks in this app
                and they do not line up. This one is Monday–Sunday (startOf
                isoWeek, just above). The GIVEAWAY week is Sunday–Saturday. A
                player reading a bare 'Week resets Monday' on a stats screen
                could reasonably conclude their $37 entries reset then too, and
                that is a misunderstanding about money. */}
            📊 Stats week resets Monday 12:00am ET
          </p>
        </motion.div>
      )}
    </motion.div>
  );
}
