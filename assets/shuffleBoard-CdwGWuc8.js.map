// shuffleBoard — reorder the seven dice on the board, keeping colours and the
// player's in-progress equation attached to the RIGHT dice.
//
// Extracted from pages/Game.jsx's handleShuffle. It is three coupled operations
// that must agree exactly, and getting any pair of them out of step is silently
// wrong rather than loudly broken:
//
//   1. the dice move,
//   2. the POSITIONAL colour array must move with them — `diceColors[i]` is the
//      colour of the die at board slot i, not a property of the die, so shuffling
//      dice without shuffling colours repaints a red die green and changes which
//      operator the power-dice rule demands,
//   3. any die already placed in the equation draft must follow to its new slot,
//      because the draft stores board INDICES (ADR-0002), not die ids.
//
// Pure, seeded by an injectable RNG so a test can assert a specific permutation
// rather than "something changed". Game.jsx keeps the setState calls.

/**
 * @param {{
 *   dice: any[],
 *   diceColors: any[],
 *   random?: () => number,
 * }} p
 * @returns {{ dice: any[], diceColors: any[], indexMap: Record<number, number> }}
 *   `indexMap` maps each die's OLD board index to its NEW one — the shape
 *   useEquationDraft's remapDiceReferences expects.
 */
export function shuffleBoard({ dice, diceColors, random = Math.random }) {
  const indices = dice.map((_, i) => i);

  // Fisher-Yates.
  for (let i = indices.length - 1; i > 0; i -= 1) {
    const j = Math.floor(random() * (i + 1));
    [indices[i], indices[j]] = [indices[j], indices[i]];
  }

  // indices[newPosition] === oldIndex, so both arrays are gathered the same way
  // and cannot drift apart.
  const shuffledDice = indices.map((i) => dice[i]);
  const shuffledColors = indices.map((i) => diceColors[i]);

  /** @type {Record<number, number>} */
  const indexMap = {};
  indices.forEach((oldIndex, newPosition) => {
    indexMap[oldIndex] = newPosition;
  });

  return { dice: shuffledDice, diceColors: shuffledColors, indexMap };
}
