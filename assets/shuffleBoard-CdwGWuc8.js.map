// useHowToOverlay — the shared open/close state for the in-place how-to overlay.
//
// Any screen that offers a "?" / "View How to Play" reopen calls `openHowTo` and
// renders `howToNode`. Because the overlay mounts in place (z-[140]) OVER the
// current screen and closes locally — never navigating — the caller's own screen
// (a live game, the Daily start modal, the Blitz picker) stays mounted, so
// dismissal returns the player exactly where they were. This replaces the old
// `navigate('/HowToPlay')` reopen handlers that abandoned the screen and (for
// Daily) forced the ad to replay. See the 2026-07-08 occlusion audit.
//
// openHowTo(mode, { context, requireScroll, onComplete }):
//   context      → bottom-CTA label (default 'go-back'); see howToContextLabel
//   requireScroll → forced-scroll gate (first-run)
//   onComplete   → extra callback fired after close when the CTA is used (e.g.
//                  first-run: open the mode's pre-game start screen)
//   hidesNav     → default true; false when the host owns the bottom nav
//                  (an embedded battle inside Sector 73)

import React, { useCallback, useState } from 'react';
import HowToOverlay from './HowToOverlay';

export function useHowToOverlay() {
  const [cfg, setCfg] = useState(null); // { mode, context?, requireScroll?, onComplete? } | null

  const openHowTo = useCallback((mode, opts = {}) => setCfg({ mode, ...opts }), []);
  const closeHowTo = useCallback(() => setCfg(null), []);

  const howToNode = cfg ? (
    <HowToOverlay
      mode={cfg.mode}
      context={cfg.context ?? 'go-back'}
      requireScroll={cfg.requireScroll ?? false}
      testId={cfg.testId ?? 'ingame-howto'}
      hidesNav={cfg.hidesNav ?? true}
      onClose={closeHowTo}
      onComplete={() => {
        const done = cfg.onComplete;
        closeHowTo();
        if (done) done();
      }}
    />
  ) : null;

  return { openHowTo, closeHowTo, howToNode, isOpen: !!cfg };
}
