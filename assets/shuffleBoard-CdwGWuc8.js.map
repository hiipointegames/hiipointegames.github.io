import React from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { AlertTriangle } from 'lucide-react';
import { modeTierLabel } from '@/game-modes';

// `mode` is the Daily's wire key (daily / daily_easy / daily_expert). It used to
// be a `challengeType` string that the one Daily caller always passed as
// "Daily Challenge", so Easy and Expert players were told "Today's Challenge Is
// Forfeited". Each Daily keeps its OWN streak, and a forfeit resets only that
// one (supabase/functions/_shared/perModeDailyStats.ts), so the copy names the
// tier.
// `skin` ('sector73', the Sector 73 host) → data-skin/data-part on the scrim + card.
export default function ExitWarningModal({ isOpen, onConfirmExit, onCancel, mode = 'daily', isSoloBlitz = false, isBattleBlitz = false, blitzDurationSeconds, skin = undefined }) {
  const tier = modeTierLabel(mode) || 'Challenge';
  const [stayLockedRef] = React.useState({ locked: false });
  const [exitLockedRef] = React.useState({ locked: false });

  // Solo Blitz runs come in player-chosen lengths (no longer always 10 min), so
  // the warning names the actual total. Clean whole-minute totals read as
  // "full N minutes"; anything else falls back to a generic "full run".
  const blitzSecs = Number(blitzDurationSeconds);
  const soloFullLabel =
    blitzSecs > 0 && blitzSecs % 60 === 0
      ? `full ${blitzSecs / 60} minute${blitzSecs === 60 ? '' : 's'}`
      : 'full run';

  // ⚠️ DISMISSALS RUN ON click, NOT pointerdown — the D4 family.
  //
  // Found by sweeping for the pattern behind David's "Not Now" click loop on
  // beta 1.0.312 (ChallengeWarningModal). Closing an overlay on POINTERDOWN ends
  // it halfway through the tap, so pointerup and the synthesized click land on
  // whatever it was covering. preventDefault/stopPropagation cannot help — the
  // second half of the gesture goes to a DIFFERENT element that never saw the
  // first — and the locks below cannot either, because they guard a button that
  // has already unmounted.
  //
  // ⚠️ THIS ONE IS THE WORST OF THE FAMILY. What sits under these two buttons is
  // THE LIVE DICE BOARD, mid-Daily, on a running clock. A fall-through here does
  // not merely re-open a screen — it taps a DIE, silently editing the player's
  // equation during a timed attempt they get one of per day.
  //
  // Not reproduced, unlike D4 — reported as the same shape, which is why it is
  // fixed the same way rather than left for someone to hit.
  const handleStayClick = (e) => {
    if (stayLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();
    
    stayLockedRef.locked = true;
    onCancel();
    
    setTimeout(() => {
      stayLockedRef.locked = false;
    }, 50);
  };

  const handleExitClick = (e) => {
    if (exitLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();
    
    exitLockedRef.locked = true;
    onConfirmExit();
    
    setTimeout(() => {
      exitLockedRef.locked = false;
    }, 50);
  };

  // Prevent background scrolling when modal is open
  React.useEffect(() => {
    if (isOpen) {
      const scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      
      return () => {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollY);
      };
    }
  }, [isOpen]);
  
  // ⚠️ NO EXIT ANIMATION — the dialog UNMOUNTS THE INSTANT isOpen GOES FALSE.
  //
  // dragonpancakeslayer, 2026-09-29, iPhone on 1.0.314: tapped "Yes, Exit" at
  // 14:45 into the Expert Daily. The forfeit went through, but the screen stayed
  // on this dialog and nothing responded until he force-closed the app.
  //
  // It used to fade out inside <AnimatePresence>, which keeps a closing overlay
  // MOUNTED until its exit animation reports done. During that time it was still
  // a full-screen, tap-catching z-[200] layer sitting on top of the solve screen
  // (SuccessModal is z-50), and its buttons were dead ends: the forfeit had
  // already happened and isOpen was already false. If the exit animation stalls,
  // the dialog never leaves. That is exactly what he saw. Why it stalled on his
  // phone is not known. Removing the fade-out removes the whole class.
  //
  // This does NOT reopen the D4 tap-through above. Dismissal still fires on
  // `click`, the LAST event of the gesture, so the finger is already up when
  // the dialog disappears and nothing is left to land on the board.
  // The fade-IN is kept: an opening dialog cannot trap anything.
  if (!isOpen) return null;

  return (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          data-skin={skin}
          data-part={skin ? 'scrim' : undefined}
          className="fixed inset-0 z-[200] flex items-center justify-center p-4 u37-ad-safe-pb bg-black/90 backdrop-blur-sm"
        >
          <motion.div
            initial={{ scale: 0.9, y: 20 }}
            animate={{ scale: 1, y: 0 }}
            data-skin={skin}
            data-part={skin ? 'card' : undefined}
            className="w-full max-w-md rounded-2xl p-6 border-2"
            style={{
              background: 'var(--u37-panel-bg)',
              borderColor: 'color-mix(in srgb, #ff4d6d 55%, transparent)',
              boxShadow: '0 0 40px -12px #ff4d6d, 0 18px 60px rgba(0,0,0,0.6), inset 0 1px 3px rgba(255,255,255,0.05)',
            }}
          >
            {/* Warning Icon */}
            <div className="flex justify-center mb-4">
              <div className="w-16 h-16 rounded-full flex items-center justify-center" style={{ background: 'color-mix(in srgb, #ff4d6d 20%, transparent)' }}>
                <AlertTriangle className="w-9 h-9" style={{ color: '#ff9db0' }} />
              </div>
            </div>

            {/* Title */}
            <h2 className="text-2xl font-bold text-white text-center mb-3">
              {isBattleBlitz ? '⚔️ Retreat from the arena?' : isSoloBlitz ? '🏃 End your Blitz run early?' : `🎲 Forfeit the ${tier} Daily?`}
            </h2>

            {/* Message */}
            <div className="rounded-xl p-4 mb-6" style={{ background: 'var(--u37-surface)' }}>
              {isBattleBlitz ? (
                <div className="space-y-3 text-sm">
                  <p className="flex items-start gap-2 text-emerald-300">
                    <span className="text-emerald-400 mt-0.5">🏆</span>
                    <span className="font-semibold">{"You keep what you've solved and can still win."}</span>
                  </p>
                  <p className="flex items-start gap-2 text-slate-300">
                    <span className="text-red-400 mt-0.5">🚫</span>
                    <span>{"You can't come back to this battle."}</span>
                  </p>
                </div>
              ) : (
                <p className="text-slate-300 text-sm text-center leading-relaxed">
                  {isSoloBlitz ? (
                    `Quitting lowers your per-round average. Use the ${soloFullLabel}!`
                  ) : (
                    <>
                      <strong className="text-red-400">
                        {`Leaving ends this attempt and resets your ${tier} streak to 0.`}
                      </strong>
                      <br />
                      {"You'll get to see today's solutions."}
                    </>
                  )}
                </p>
              )}
            </div>

            {/* Action Buttons */}
            <div className="space-y-3">
              {/* Stay = the primary, safe action → bright green neon fill. */}
              <Button
                onClick={handleStayClick}
                className="w-full py-6 text-lg font-black rounded-xl touch-manipulation active:scale-95"
                style={{
                  background: 'var(--u37-green)',
                  color: '#050310',
                  boxShadow: '0 0 26px -7px var(--u37-green), inset 0 1px 0 rgba(255,255,255,0.4)',
                  WebkitTapHighlightColor: 'transparent',
                }}
              >
                {isBattleBlitz ? '✓ Keep Fighting' : isSoloBlitz ? '✓ Keep Going' : '✓ Keep Solving'}
              </Button>

              {/* Exit = destructive → a red neon OUTLINE (secondary), so the modal
                  visually nudges toward staying rather than offering two loud CTAs. */}
              <Button
                onClick={handleExitClick}
                className="w-full py-6 text-lg font-bold rounded-xl touch-manipulation active:scale-95"
                style={{
                  color: '#ff9db0',
                  background: 'color-mix(in srgb, #ff4d6d 12%, transparent)',
                  border: '2px solid color-mix(in srgb, #ff4d6d 60%, transparent)',
                  WebkitTapHighlightColor: 'transparent',
                }}
              >
                {isBattleBlitz ? '✗ Retreat' : isSoloBlitz ? '✗ End Run' : '✗ Forfeit & See Solves'}
              </Button>
            </div>
          </motion.div>
        </motion.div>
  );
}