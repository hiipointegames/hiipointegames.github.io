import React from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { AlertTriangle, HelpCircle } from 'lucide-react';
import { playSound } from '@/ui/feedback';
import { isDaily, hasPowerDice, requiresPerfectSolve, modeTierLabel } from '@/game-modes';
import { PUZZLE_PIECE_RULE_SHORT } from '@/game-mechanics';
import { DAILY_LIMIT_LABEL } from '@/daily-challenge/dailyLimit';
import { modeThemeName } from './modeTheme';
import { DAILY_CLUE_LINE, useSector73Enabled } from '@/sector73';
import { isMember, useOptionalAuthUser } from '@/auth';

/**
 * Pre-game warning modal (daily + blitz variants). All props optional so callers
 * pass only what they need (e.g. HeadToHeadGame omits onHowTo).
 * @param {object} props
 * @param {boolean} [props.isOpen]
 * @param {() => void} [props.onConfirm]
 * @param {() => void} [props.onCancel]
 * @param {string} [props.mode]
 * @param {boolean} [props.isSolo]
 * @param {string} [props.gameMode]
 * @param {() => void} [props.onHowTo] home-condense H2 — optional "?" reopen
 * @param {'sector73'} [props.skin] the Sector 73 host: data-skin/data-part on the
 *   scrim + card, and no "Every road leads to 37…" clue (you are already there)
 */
export default function ChallengeWarningModal({ isOpen, onConfirm, onCancel, mode, isSolo, gameMode, onHowTo, skin }) {
  const [confirmLockedRef] = React.useState({ locked: false });
  const [cancelLockedRef] = React.useState({ locked: false });
  const [isLoading, setIsLoading] = React.useState(false);
  // The Sector 73 clue is for members: a guest's 73 does nothing (David, 2026-10-19). Who is
  // viewing comes from the auth context already in memory — no auth.me() call on mount, so with
  // Sector 73 off this modal makes exactly the requests main's did (none).
  const viewerIsMember = isMember(useOptionalAuthUser());
  // ...and only while Sector 73 is switched on. The switch is read only when a MEMBER OPENS a
  // Daily — never for the closed modal on the home screen, a guest, or a Blitz.
  const showClue = useSector73Enabled(Boolean(isOpen) && isDaily(mode) && viewerIsMember && !skin);

  // The confirm button stays locked until onConfirm() actually SETTLES.
  //
  // It used to unlock on a hard-coded 3s timer that had nothing to do with the
  // work it was waiting for. On a slow connection the daily start takes longer
  // than that, so the spinner reverted to "✓ Confirm & Start" while the first
  // start was still in flight — the player saw a button that looked ready,
  // tapped it, and ran a SECOND concurrent start. That is verbatim the
  // 2026-09-16 report: "it didn't load in time, the button repopulated, I
  // clicked it again", and what followed was a Daily that was not the day's
  // puzzle. A timer cannot know when a network call finished; only the promise
  // does.
  //
  // Promise.resolve() wraps it because not every caller is async — the battle
  // paths hand back undefined, and those simply settle immediately.
  const handleConfirmClick = (e) => {
    if (confirmLockedRef.locked || isLoading) return;
    e.preventDefault();
    e.stopPropagation();

    confirmLockedRef.locked = true;
    setIsLoading(true);
    if (isDaily(mode) || isSolo) {
      playSound('shorterDiceRoll');
    } else {
      playSound('battleBegin');
    }

    const unlock = () => {
      confirmLockedRef.locked = false;
      setIsLoading(false);
    };

    let settled;
    try {
      settled = Promise.resolve(onConfirm?.());
    } catch {
      // A synchronous throw must not leave the button locked forever.
      unlock();
      return;
    }
    // On success the modal is normally unmounted by the caller, so this unlock
    // is for the paths that keep it open (a refusal, a failed start) — exactly
    // the cases where the player needs the button back.
    settled.then(unlock, unlock);
  };

  // ⚠️ THIS RUNS ON click, NOT pointerdown, AND THAT IS THE FIX.
  //
  // David, beta 1.0.312: "i am caught in a click loop because when i click not
  // now it double clicks and selects expert solo every time."
  //
  // Not a sensitivity problem — a gesture-ownership one. Closing on POINTERDOWN
  // ends the modal halfway through the tap: pointerup and the synthesized click
  // then land on whatever the modal was covering, which on the Blitz screen is
  // the Expert Solo card sitting exactly under this button. So one tap cancelled
  // the gate and immediately re-opened it, forever.
  //
  // `preventDefault`/`stopPropagation` cannot help, because the second half of
  // the gesture is delivered to a DIFFERENT element that never saw the first.
  // The lock below cannot help either: it guards THIS button, which by then has
  // unmounted.
  //
  // Moving to `click` makes the whole gesture complete on the modal before
  // anything closes. Nothing is lost in feel: the Button primitive still plays
  // its tap sound on pointerdown, so the response is as immediate as before —
  // only the ACTION waits for the gesture to finish, which is what a dismiss
  // should do anyway. Confirm keeps pointerdown: it transitions INTO a game
  // rather than uncovering the list, so it has nothing to fall through onto.
  const handleCancelClick = (e) => {
    if (cancelLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();

    cancelLockedRef.locked = true;
    onCancel();

    setTimeout(() => {
      cancelLockedRef.locked = false;
    }, 1000);
  };

  // COLOUR FOLLOWS THE TIER (David, 2026-08-27), resolved through the SAME
  // [data-mode] rules every other surface uses instead of a second hard-coded
  // palette living here. This gate used to paint every Daily cyan -- including
  // Easy's and Expert's, which are green and gold everywhere else -- because
  // `modeConfig` is keyed by WHICH GATE ('daily' | 'blitz') while `mode` carries
  // a tier ('daily_easy' fell through the `||` to the daily config).
  //
  // The blitz gate carries its tier in `gameMode`, not `mode`; an absent
  // `gameMode` (solo blitz) normalizes to Easy's green, exactly as before.
  const themeName = modeThemeName(mode === 'blitz' ? gameMode : mode);
  const ACCENT = 'var(--u37-mode-accent)';
  // The title names the TIER too (2026-09-12). It said "Start Daily Challenge?"
  // on all three gates, which became actively wrong twice over: there are three
  // Dailies, and PR #124 had just changed the button that OPENS this modal to
  // name its tier ("Start Expert Daily"). Tapping "Start Expert Daily" and being
  // asked "Start Daily Challenge?" reads as though the app misheard you.
  //
  // Only the DAILY gate is tiered — the blitz gate carries its tier in
  // `gameMode` and its own copy already handles that.
  const modeConfig = {
    daily: { title: `Start ${modeTierLabel(mode)} Daily?`, icon: '📅', accent: ACCENT },
    // ⚠️ SOLO AND BATTLE SHARE THIS GATE AND ARE NOT THE SAME THING (David,
    // 2026-09-17): "It should say start solo blitz, not blitz battle." A solo
    // run has no opponent, so announcing a battle is simply false — and
    // `isSolo` was already being passed in for the rules copy below, so the
    // title was the one place that ignored information it already had.
    blitz: {
      title: isSolo ? 'Start Solo Blitz?' : 'Start Blitz Battle?',
      icon: '⚔️',
      accent: ACCENT,
    },
  };

  const config = modeConfig[mode] || modeConfig.daily;

  // Which rules apply. The Blitz gate's `mode` is 'blitz' and its TIER rides in
  // `gameMode` ('easy' | 'challenge' | 'expert' — see head-to-head/blitzMode.js).
  const daily = isDaily(mode);
  const ruleKey = mode === 'blitz' ? gameMode : mode;
  const showPowerDice = hasPowerDice(ruleKey);
  const pieceRule = daily ? PUZZLE_PIECE_RULE_SHORT(mode) : null;

  // Prevent background scrolling when modal is open
  React.useEffect(() => {
    if (isOpen) {
      const scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';

      return () => {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollY);
      };
    }
  }, [isOpen]);

  return (
    <AnimatePresence>
      {isOpen && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          data-skin={skin}
          data-part={skin ? 'scrim' : undefined}
          className="fixed inset-0 z-[100] flex items-center justify-center p-4 u37-ad-safe-pb bg-black/80 backdrop-blur-sm"
        >
          <motion.div
            initial={{ scale: 0.9, y: 20 }}
            animate={{ scale: 1, y: 0 }}
            exit={{ scale: 0.9, y: 20 }}
            className="w-full max-w-md rounded-2xl p-5 border-2"
            data-mode={themeName}
            data-skin={skin}
            data-part={skin ? 'card' : undefined}
            style={{
              background: 'var(--u37-panel-bg)',
              borderColor: `color-mix(in srgb, ${config.accent} 55%, transparent)`,
              boxShadow: `0 0 40px -12px ${config.accent}, 0 18px 60px rgba(0,0,0,0.6), inset 0 1px 3px rgba(255,255,255,0.05)`,
            }}
          >
            {/* Warning Icon */}
            <div className="flex justify-center mb-1.5">
              <div className="w-11 h-11 rounded-full flex items-center justify-center" style={{ background: `color-mix(in srgb, ${config.accent} 20%, transparent)` }}>
                <AlertTriangle className="w-6 h-6" style={{ color: config.accent }} />
              </div>
            </div>

            {/* Title */}
            <h2 className="text-xl font-bold text-white text-center mb-2">
              {config.icon} {config.title}
            </h2>

            {/* Warning Content — condensed 2026-10-18 (copy-condense spec, item 1).
                Every rule the old paragraphs carried is still a row here; the
                icon key ("? = how-to, speaker = mute") moved behind View How to
                Play. History worth keeping:
                * The limit comes from DAILY_LIMIT_LABEL, never typed here — a rules
                  screen that misstated the limit cost delaney-37 a Daily (2026-09-09),
                  so "closing the app doesn't stop the clock" and "past the limit it
                  won't count" are both stated, not left to be learned by losing.
                * Power Dice are stated per TIER: Easy has none (row omitted),
                  Challenge accepts 2 of 3, Expert only counts all 3. The Blitz gate
                  carries its tier in `gameMode` (mode is 'blitz'), so an Expert
                  Blitz now states the all-3 rule too — it used to show no
                  power-dice row at all (fixed 2026-10-18).
                * The 🧩 row reads PUZZLE_PIECE_RULE_SHORT, the single source of the
                  Piece rule; it is null (row hidden) where a mode pays nothing.
                * LEAVING A BATTLE IS NOT A FORFEIT: `endBattleEarly` keeps every
                  solution and the player can still win. Only the Daily forfeits. */}
            <div className="rounded-xl p-3 mb-3 space-y-2" style={{ background: 'var(--u37-surface)' }}>
              {daily ? (
                <>
                  <RuleRow icon="⏰" iconClass="text-red-400">
                    <strong className="text-red-400">{DAILY_LIMIT_LABEL} to solve.</strong> The clock never stops — even if you close the app.
                  </RuleRow>
                  <RuleRow icon="🚫" iconClass="text-red-400">
                    Past {DAILY_LIMIT_LABEL} <strong className="text-red-400">it won&apos;t count.</strong> A 10-second countdown warns you.
                  </RuleRow>
                </>
              ) : (
                <RuleRow icon="⏱️" iconClass="text-orange-400">
                  <strong className="text-orange-400">One sitting</strong> — the timer never pauses.
                </RuleRow>
              )}

              {showPowerDice && (
                <RuleRow icon="🎨" iconClass="text-purple-400">
                  <strong className="text-purple-400">Power Dice:</strong>{' '}
                  {requiresPerfectSolve(ruleKey) ? "all 3 correct, or it doesn't count." : '2 of 3 correct = a valid solve.'}
                </RuleRow>
              )}

              {daily && pieceRule && (
                <RuleRow icon="🧩" iconClass="text-amber-400">
                  <strong className="text-amber-400">{pieceRule}.</strong>
                </RuleRow>
              )}

              {daily ? (
                <RuleRow icon="🏳️" iconClass="text-sky-400">
                  <strong className="text-sky-300">Forfeit &amp; See Solves</strong> ends your attempt. A crash or phone-lock won&apos;t.
                </RuleRow>
              ) : (
                !isSolo && (
                  <RuleRow icon="🚪" iconClass="text-yellow-400">
                    <strong className="text-yellow-400">Leave early:</strong> you keep your score and can still win. No rejoining.
                  </RuleRow>
                )
              )}
            </div>

            {/* Sector 73 clue (David, 2026-10-04) — faint, Daily only. */}
            {showClue && isDaily(mode) && viewerIsMember && !skin && (
              <p data-testid="sector73-clue" className="text-center text-[11px] italic text-violet-300/60 -mt-1 mb-3 tracking-wide">
                {DAILY_CLUE_LINE}
              </p>
            )}

            {/* home-condense H2 — reopen the how-to from the pre-game modal (no
                scroll gate; the first-run forced view already happened). Only
                rendered when the caller wires it. */}
            {onHowTo && (
              <div className="flex justify-center mb-3 -mt-1">
                <button
                  type="button"
                  onClick={() => { playSound('buttonTap'); onHowTo(); }}
                  aria-label="How to play"
                  className="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-300 hover:text-white rounded-lg px-3 py-1.5 border border-slate-600 hover:border-slate-500 transition-colors touch-manipulation"
                >
                  <HelpCircle className="w-4 h-4" />
                  View How to Play
                </button>
              </div>
            )}

            {/* Action Buttons */}
            <div className="space-y-2">
              <Button
                onPointerDown={handleConfirmClick}
                disableDefaultSound={true}
                disabled={isLoading}
                className="w-full py-4 text-lg font-black rounded-xl touch-manipulation active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                style={{
                  background: config.accent,
                  color: '#050310',
                  boxShadow: `0 0 26px -7px ${config.accent}, inset 0 1px 0 rgba(255,255,255,0.4)`,
                  WebkitTapHighlightColor: 'transparent',
                }}
              >
                {isLoading ? (
                  <>
                    <motion.div
                      animate={{ rotate: 360 }}
                      transition={{ duration: 1, repeat: Infinity, ease: "linear" }}
                      className="inline-block w-5 h-5 border-2 border-white border-t-transparent rounded-full mr-2"
                    />
                    Loading...
                  </>
                ) : (
                  <>✓ Confirm & Start</>
                )}
              </Button>

              <Button
                onClick={handleCancelClick}
                className="w-full py-4 text-lg font-semibold bg-slate-700 hover:bg-slate-600 text-white border-2 border-slate-600 hover:border-slate-500 transition-all touch-manipulation active:scale-95"
                style={{ WebkitTapHighlightColor: 'transparent' }}
              >
                Not Now
              </Button>
            </div>
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}

/** One icon + sentence row of the pre-game rules panel. */
function RuleRow({ icon, iconClass, children }) {
  return (
    <div className="flex gap-2.5 items-start">
      <span className={`${iconClass} text-base flex-shrink-0`}>{icon}</span>
      <p className="text-slate-300 text-sm">{children}</p>
    </div>
  );
}
