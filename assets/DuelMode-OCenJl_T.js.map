// The computer pilot (design-v2 D11): on the phone only — no server, no stars.
// (Sector 73 itself is members-only, so only signed-in pilots ever reach it.)
//
// It answers with a real solve of the round's dice (the app's own solver, createDailySolver),
// after a delay drawn from its speed. The delay is a MINIMUM: if the search is still running
// when it elapses, the answer goes in as soon as the search ends. A board with no solve gets
// no answer at all, and the round's 90 s void takes over (as on the server).
//
// The search stops at the FIRST acceptable solve. The solver is built for the forfeit screen,
// which wants a pool of up to 40 tidy solves; the pilot needs one. On an Easy board the pool
// can never reach its early exit (that needs a perfect solve, which Easy has none of), so the
// full search took ~0.7 s on desktop (S4 review). It is also spread across timer ticks in small
// steps, each tick capped at SLICE_BUDGET_MS of work, so the player's taps never wait long.

import { createDailySolver } from '@/equation-engine';

/** Solve-time windows, in ms [PICK, design-v2 D11; tune after play-testing]. */
export const COMPUTER_PILOTS = Object.freeze({
  cadet: Object.freeze({ id: 'cadet', label: 'Cadet', minMs: 45000, maxMs: 75000 }),
  ace: Object.freeze({ id: 'ace', label: 'Ace', minMs: 20000, maxMs: 40000 }),
  legend: Object.freeze({ id: 'legend', label: 'Legend', minMs: 8000, maxMs: 18000 }),
});
export const PILOT_SPEEDS = Object.freeze(['cadet', 'ace', 'legend']);

/** How long this pilot takes on a round, uniform within its window. Unknown speed → Ace. */
export function pickAnswerDelay(speed, rng = Math.random) {
  const p = COMPUTER_PILOTS[speed] || COMPUTER_PILOTS.ace;
  const r = Math.min(Math.max(rng(), 0), 1);
  return Math.round(p.minMs + r * (p.maxMs - p.minMs));
}

/**
 * The answer the pilot plays from a solver result: any solve the style accepts. Easy accepts any 37
 * on seven dice; Challenge accepts 2 or 3 power dice used right, so the plain "valid" one is
 * enough and the "perfect" one is the fallback. Expert (the 37 Expert rule) accepts ONLY a
 * perfect solve: all 3 power dice used right.
 * @param {{ valid: any, perfect: any } | null} result
 * @param {string} [style]
 * @returns {{ equation: string, usedIndices: number[] } | null}
 */
export function pickSolution(result, style = undefined) {
  const s = style === 'expert' ? (result?.perfect ?? null) : (result?.valid ?? result?.perfect ?? null);
  return s ? { equation: s.equation, usedIndices: [...s.usedIndices] } : null;
}

/** Max work per timer tick, in ms (a frame is ~16 ms; keep well under it). */
export const SLICE_BUDGET_MS = 6;
/** Solver ops per step inside a tick (~0.2–0.3 ms each on desktop). */
export const STEP_OPS = 1500;

/**
 * Search the board in time-boxed slices; calls onDone(solution | null) once, as soon as any
 * acceptable solve exists (or the search ends without one). Returns cancel().
 * @param {number[]} dice
 * @param {readonly string[]} colors
 * @param {{ onDone: (s: { equation: string, usedIndices: number[] } | null) => void, style?: string,
 *   stepOps?: number, budgetMs?: number, clock?: () => number,
 *   schedule?: (fn: () => void) => any, unschedule?: (h: any) => void, makeSolver?: typeof createDailySolver }} opts
 */
export function startSolve(dice, colors, {
  onDone, style = undefined, stepOps = STEP_OPS, budgetMs = SLICE_BUDGET_MS, clock = () => globalThis.performance?.now?.() ?? Date.now(),
  schedule = (fn) => setTimeout(fn, 0), unschedule = (h) => clearTimeout(h), makeSolver = createDailySolver,
}) {
  const solver = makeSolver(dice, colors);
  let handle = null;
  let cancelled = false;
  const tick = () => {
    if (cancelled) return;
    const start = clock();
    do {
      const { done } = solver.step(stepOps);
      const found = pickSolution(solver.getResult(), style);
      if (found || done) { onDone(found); return; }
    } while (clock() - start < budgetMs);
    handle = schedule(tick);
  };
  handle = schedule(tick);
  return () => { cancelled = true; if (handle != null) unschedule(handle); };
}
