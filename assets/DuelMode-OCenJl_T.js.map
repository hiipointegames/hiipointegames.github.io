// Expert dice for a practice duel vs the computer (live battles S5, design-v2 D11).
//
// Expert needs a VETTED board: the rule is all 3 power dice used right, and a random roll often has
// no such answer. So Expert dice never come from a roll:
//   • online: one draw_expert_deck call per match fills a queue (the same RPC the Colosseum uses);
//   • offline, or the draw failed or hasn't come back yet: a deck from the bundled pool
//     (expertDecks.json, exported by scripts/export-expert-decks.mjs; those decks are marked
//     `bundled` and live duels never serve them).
// The round never waits on the network: whatever is in hand when the 3-2-1 ends is dealt.
// Within one match a bundled deck isn't repeated until the bundle runs out.

import { supabase } from '@/transport/supabaseClient';
import { reportedFallback } from '@/observability';
import BUNDLE from './expertDecks.json';

/** How many decks one online draw asks for: enough for first to 10 plus a few void rounds. */
export const ONLINE_DRAW = 25;

const isDeck = (d) => Array.isArray(d) && d.length === 7 && d.every((v) => Number.isInteger(v) && v >= 1 && v <= 6);

/** The bundled decks (only well-formed ones). */
export const BUNDLED_DECKS = Object.freeze((BUNDLE?.decks || []).filter(isDeck));

/** Ask the vetted pool for `count` decks (signed-in only; RLS keeps the table itself closed). */
export async function drawOnlineDecks(count, client = supabase) {
  const { data, error } = await client.rpc('draw_expert_deck', { p_count: count });
  if (error) throw error;
  return (Array.isArray(data) ? data : []).map((row) => (Array.isArray(row) ? row : row?.dice)).filter(isDeck);
}

/**
 * @param {{ fetchDecks?: (count: number) => Promise<number[][]>, bundle?: readonly number[][],
 *   rng?: () => number, online?: () => boolean, report?: (e: unknown) => void }} [deps]
 */
export function createExpertDealer({
  fetchDecks = drawOnlineDecks, bundle = BUNDLED_DECKS, rng = Math.random,
  online = () => globalThis.navigator?.onLine !== false,
  report = reportedFallback('sector73.duel.expertDraw'),
} = {}) {
  let queue = [];
  let unused = bundle.map((_, i) => i);
  let generation = 0;
  return {
    /** Start a match: drop what's left of the last one and (if online) draw fresh decks. */
    prime() {
      generation += 1;
      const mine = generation;
      queue = [];
      unused = bundle.map((_, i) => i);
      if (!online()) return Promise.resolve(0);
      return Promise.resolve()
        .then(() => fetchDecks(ONLINE_DRAW))
        .then((decks) => {
          if (mine !== generation) return 0; // a newer match started meanwhile
          queue = decks.filter(isDeck).map((d) => [...d]);
          return queue.length;
        })
        .catch((e) => { report(e); return 0; }); // offline-ish: the bundle covers it
    },
    /** The next round's dice. @returns {{ dice: number[], source: 'online' | 'bundle' }} */
    next() {
      if (queue.length) return { dice: queue.shift(), source: 'online' };
      if (!bundle.length) throw new Error('no bundled Expert decks');
      if (!unused.length) unused = bundle.map((_, i) => i);
      const k = Math.min(unused.length - 1, Math.floor(Math.max(0, rng()) * unused.length));
      const [i] = unused.splice(k, 1);
      return { dice: [...bundle[i]], source: 'bundle' };
    },
  };
}
