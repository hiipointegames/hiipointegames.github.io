import React, { useCallback, useEffect, useReducer, useRef, useState } from 'react';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { haptic, usePrefersReducedMotion } from '../../fx';
import { ModeHeader } from '../ui';
import { duelReducer, initialDuelState, rollRound, matchWinner, COUNTDOWN_MS, REVEAL_MS, VOID_MS } from './duelReducer';
import { COMPUTER_PILOTS, pickAnswerDelay, startSolve } from './computerPilot';
import DuelSetup from './DuelSetup';
import DuelBoard from './DuelBoard';
import PilotStrip from './PilotStrip';
import RoundReveal from './RoundReveal';
import DuelResultCard from './DuelResultCard';
import { CPU_LOOKS, useMyLook } from './DuelShips';
import { createExpertDealer } from './expertDealer';
import './duel.css';

// Sector 73 mode `duel` (live battles S4): the battle screen, against a computer pilot.
//
//   setup (pilot · dice · first to) → 3-2-1 → round: same dice for both, first correct 37 wins
//     → reveal: the winning equation, the loser's ship takes a hit, a pip fills → 3-2-1 → …
//     → result card (Rematch / New settings / Back to orbit)
//
// The referee is local (duelReducer) and has the server's rules; the live duel (S6) swaps the
// computer for a served opponent on the same screen. Practice only: nothing is paid
// (no stars), and there is NO interstitial — the page hands every mode `showAd`, and
// this mode deliberately never calls it (David, design sign-off 2026-10-19).
//
// Expert (S5) is the 37 Expert rule — all 3 power dice used right — on vetted dice: one online
// draw per match, the bundled decks offline (expertDealer.js). The computer plays only a perfect
// solve there.
//
// Seams for tests: rng (dice + the pilot's delay), solve (the pilot's search), now, dealer (Expert dice).

export const STYLE_LABEL = Object.freeze({ easy: 'Easy', challenge: 'Challenge', expert: 'Expert' });

/** The board's label in a practice duel (D6-A): who you're up against and which dice. */
export const practiceDuelLabel = (opponent, style) => `VS ${String(opponent).toUpperCase()} · ${String(style).toUpperCase()} DICE`;

/**
 * @param {{ onExit: () => void, onReturnTo37: () => void, showAd?: () => Promise<void>,
 *   rng?: () => number, solve?: typeof startSolve, now?: () => number,
 *   dealer?: ReturnType<typeof createExpertDealer> }} props
 */
export default function DuelMode({ onExit, onReturnTo37, rng = Math.random, solve = startSolve, now = Date.now, dealer = undefined }) {
  const [s, dispatch] = useReducer(duelReducer, undefined, () => initialDuelState());
  const reducedMotion = usePrefersReducedMotion();
  const pilot = COMPUTER_PILOTS[s.settings.speed];
  const roundStart = useRef(0);
  const [elapsed, setElapsed] = useState(0);
  const [count, setCount] = useState(3);
  // The latest seams, read through a ref so a parent re-render never restarts a round's clocks.
  const seams = useRef({ rng, solve, now });
  seams.current = { rng, solve, now };
  const myLook = useMyLook();
  const ownDealer = useRef(null);
  const expert = dealer ?? (ownDealer.current ||= createExpertDealer());

  // A new Expert match draws its decks while the first 3-2-1 runs (never waited on).
  useEffect(() => {
    if (s.phase === 'countdown' && s.round === 1 && s.settings.style === 'expert') expert.prime();
  }, [s.phase, s.round, s.settings.style, expert]);

  // 3-2-1, then the round's dice.
  useEffect(() => {
    if (s.phase !== 'countdown') return undefined;
    setCount(3);
    const ticks = [setTimeout(() => setCount(2), 1000), setTimeout(() => setCount(1), 2000)];
    const serve = setTimeout(() => {
      const { dice, colors } = rollRound(s.settings.style, seams.current.rng, () => expert.next().dice);
      dispatch({ type: 'serve', dice, colors });
    }, COUNTDOWN_MS);
    return () => { ticks.forEach(clearTimeout); clearTimeout(serve); };
  }, [s.phase, s.round, s.settings.style, expert]);

  // The round: the clock, the computer's answer (after its delay AND its search), the 90 s void.
  useEffect(() => {
    if (s.phase !== 'round' || !s.board) return undefined;
    const { rng: r, solve: search, now: clock } = seams.current;
    roundStart.current = clock();
    setElapsed(0);
    const tick = setInterval(() => setElapsed(Math.floor((clock() - roundStart.current) / 1000)), 1000);
    let solution = null;
    let due = false;
    let sent = false;
    const answer = () => {
      if (sent || !due || !solution) return;
      sent = true;
      dispatch({ type: 'claim', by: 'cpu', equation: solution.equation, usedIndices: solution.usedIndices, ms: clock() - roundStart.current });
    };
    const cancelSearch = search(s.board.dice, s.board.colors, { style: s.settings.style, onDone: (sol) => { solution = sol; answer(); } });
    const delay = setTimeout(() => { due = true; answer(); }, pickAnswerDelay(s.settings.speed, r));
    const voidRound = setTimeout(() => dispatch({ type: 'void' }), VOID_MS);
    return () => { clearInterval(tick); clearTimeout(delay); clearTimeout(voidRound); cancelSearch(); };
  }, [s.phase, s.round, s.board, s.settings.speed, s.settings.style]);

  // The reveal: the loser's ship is hit (and the phone taps), then the next countdown or the result.
  useEffect(() => {
    if (s.phase !== 'reveal') return undefined;
    if (s.last?.by) haptic(s.last.by === 'me' ? 'medium' : 'heavy');
    const t = setTimeout(() => dispatch({ type: 'next' }), REVEAL_MS);
    return () => clearTimeout(t);
  }, [s.phase, s.last]);

  const onSolve = useCallback(({ equation, usedIndices }) => {
    dispatch({ type: 'claim', by: 'me', equation, usedIndices, ms: seams.current.now() - roundStart.current });
  }, []);

  const leave = useCallback(() => dispatch({ type: 'leave' }), []);
  const opponentName = pilot.label;
  const styleLabel = STYLE_LABEL[s.settings.style] ?? 'Easy';

  if (s.phase === 'setup' || s.phase === 'result') {
    const winner = matchWinner(s);
    return (
      <div className="s73-duel relative isolate flex h-full flex-col overflow-y-auto bg-[#04030d] pb-6" data-testid="duel-mode" data-phase={s.phase}>
        <ModeBackdrop theme="battle" />
        <ModeHeader title="Practice Duel" subtitle="vs computer" onExit={onExit} onReturnTo37={onReturnTo37} />
        {s.phase === 'setup' && (
          <DuelSetup settings={s.settings} onChange={(patch) => dispatch({ type: 'configure', patch })} onStart={() => dispatch({ type: 'start' })} />
        )}
        {s.phase === 'result' && winner && (
          <div className="flex flex-1 items-center px-4 pt-4">
            <DuelResultCard
              winner={winner}
              score={s.score}
              opponentName={opponentName}
              history={s.history}
              onRematch={() => dispatch({ type: 'rematch' })}
              onSettings={leave}
              onExit={onExit}
            />
          </div>
        )}
      </div>
    );
  }

  const hitSide = s.phase === 'reveal' && s.last?.by ? (s.last.by === 'me' ? 'cpu' : 'me') : null;
  return (
    <div className="s73-duel s73-duel-play relative isolate flex h-full flex-col bg-[#04030d]" data-testid="duel-mode" data-phase={s.phase} data-round={s.round}>
      <ModeBackdrop theme="battle" />
      <div style={{ paddingTop: 'var(--safe-top, 0px)' }}>
        <PilotStrip side="cpu" name={opponentName} caption={`Computer · ${styleLabel}`} wins={s.score.cpu} firstTo={s.settings.firstTo} hit={hitSide === 'cpu'} reducedMotion={reducedMotion} look={CPU_LOOKS[s.settings.speed]} lookId={`cpu-${s.settings.speed}`}>
          <button type="button" data-testid="duel-leave" aria-label="Leave the duel" onClick={leave}
            className="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-white/25 bg-white/5 text-slate-100 active:scale-95">✕</button>
        </PilotStrip>
      </div>
      <div className="relative min-h-0 flex-1">
        {s.phase === 'countdown' && (
          <div data-testid="duel-countdown" className="grid h-full place-items-center text-center">
            <div>
              <div className="text-[11px] font-bold uppercase tracking-[0.35em] text-violet-300/80">Round {s.round}</div>
              <div key={count} className={`s73-duel-count text-7xl font-black text-white${reducedMotion ? '' : ' is-animated'}`} data-testid="duel-count">{count}</div>
              <div className="text-xs text-slate-400">First to {s.settings.firstTo}</div>
            </div>
          </div>
        )}
        {s.phase === 'round' && s.board && (
          <DuelBoard key={s.round} dice={s.board.dice} colors={s.board.colors} style={s.settings.style} elapsedSeconds={elapsed} onSolve={onSolve}
            label={practiceDuelLabel(opponentName, styleLabel)} />
        )}
        {s.phase === 'reveal' && s.last && (
          <div className="grid h-full place-items-center px-4">
            <RoundReveal last={s.last} colors={s.board?.colors ?? []} opponentName={opponentName} />
          </div>
        )}
      </div>
      <PilotStrip side="me" name="You" caption={`First to ${s.settings.firstTo}`} wins={s.score.me} firstTo={s.settings.firstTo} hit={hitSide === 'me'} reducedMotion={reducedMotion} look={myLook} lookId="mine" />
    </div>
  );
}
