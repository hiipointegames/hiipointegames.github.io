import React from 'react';
import { PrimaryButton } from '../ui';
import { formatDuelTime } from './formatDuelTime';

// The end of a practice duel: the score, the fastest round you won, and the way on —
// Rematch (same pilot, dice and length), New settings, or Back to orbit.
// Computer matches pay nothing (design-v2 D11), so there is no reward line at all.

/**
 * @param {{ winner: 'me' | 'cpu', score: { me: number, cpu: number }, opponentName: string,
 *   history: import('./duelReducer').RoundResult[], onRematch: () => void, onSettings: () => void, onExit: () => void }} props
 */
export default function DuelResultCard({ winner, score, opponentName, history, onRematch, onSettings, onExit }) {
  const mine = history.filter((r) => r.by === 'me' && r.ms != null).map((r) => r.ms);
  const fastest = mine.length ? Math.min(...mine) : null;
  return (
    <div data-testid="duel-result" data-winner={winner} className="mx-auto w-full max-w-md rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white" style={{ boxShadow: '0 0 40px -14px #a855f7' }}>
      <div className="text-[10px] font-bold uppercase tracking-[0.3em] text-violet-300/80">Practice duel</div>
      <div className={`mt-1 text-3xl font-black ${winner === 'me' ? 'text-emerald-300' : 'text-rose-300'}`}>
        {winner === 'me' ? 'Victory' : `${opponentName} wins`}
      </div>
      <div data-testid="duel-final-score" className="mt-2 text-4xl font-black tabular-nums">
        {score.me} <span className="text-slate-500">–</span> {score.cpu}
      </div>
      <div className="mt-1 text-xs text-slate-400">You vs {opponentName}</div>
      {fastest != null && <p className="mt-3 text-sm text-slate-300">Your fastest round: <span data-testid="duel-fastest" className="tabular-nums">{formatDuelTime(fastest)}</span></p>}
      <div className="mt-5 space-y-2">
        <PrimaryButton testId="duel-rematch" tone="rose" onClick={onRematch}>REMATCH</PrimaryButton>
        <button type="button" data-testid="duel-settings" onClick={onSettings}
          className="w-full rounded-xl border border-fuchsia-300/50 bg-black/40 py-3 text-sm font-black tracking-widest text-fuchsia-100 active:scale-95">
          NEW SETTINGS
        </button>
        <button type="button" data-testid="duel-orbit" onClick={onExit}
          className="w-full rounded-xl border border-cyan-300/60 bg-black/40 py-3 text-sm font-black tracking-widest text-cyan-100 active:scale-95">
          BACK TO ORBIT ↑
        </button>
      </div>
    </div>
  );
}
