// The duel's round loop as a plain reducer (live battles S4, structure-v2 §S4).
//
//   setup ─start→ countdown ─serve→ round ─claim/void→ reveal ─next→ countdown … ─next→ result
//                                                                       result ─rematch→ countdown
//   any play phase ─leave→ setup (settings kept)
//
// It IS the local referee for the computer pilot, with the server's rules (design-v2 D1/D2):
// both pilots get the same dice at the same moment, the FIRST correct answer takes the round
// (a claim is only accepted while the round is open, so a second claim is ignored), wrong
// answers never reach here (the phone's pre-check), and a round nobody solves in 90 s is void:
// no point, fresh dice. First to N wins the match.
//
// Pure: no timers, no randomness. DuelMode owns the clocks; rollRound takes its rng.

import { POWER_DICE_COLORS, EASY_DICE_COLORS } from '@/dice';

export const FIRST_TO_OPTIONS = Object.freeze([3, 5, 7, 10]);
export const DEFAULT_FIRST_TO = 5;
/** The dice styles vs the computer. Expert = the 37 Expert rule: all 3 power dice used right (S5). */
export const DUEL_STYLES = Object.freeze(['easy', 'challenge', 'expert']);

/** 3-2-1 before each round's dice appear. */
export const COUNTDOWN_MS = 3000;
/** How long the winning equation stays up before the next countdown (reveal + countdown ≈ the server's 5 s gap). */
export const REVEAL_MS = 2500;
/** A round nobody solves in this long is void (the server's s73_duel_round_tick rule). */
export const VOID_MS = 90000;

/**
 * @typedef {'easy'|'challenge'|'expert'} DuelStyle
 * @typedef {'cadet'|'ace'|'legend'} PilotSpeed
 * @typedef {{ style: DuelStyle, speed: PilotSpeed, firstTo: number }} DuelSettings
 * @typedef {{ round: number, by: 'me'|'cpu'|null, equation: string|null, usedIndices: number[]|null, ms: number|null }} RoundResult
 * @typedef {{ phase: 'setup'|'countdown'|'round'|'reveal'|'result', settings: DuelSettings, round: number,
 *   score: { me: number, cpu: number }, board: { dice: number[], colors: readonly string[] } | null,
 *   last: RoundResult | null, history: RoundResult[] }} DuelState
 */

/** @type {DuelSettings} */
export const DEFAULT_SETTINGS = Object.freeze({ style: 'easy', speed: 'ace', firstTo: DEFAULT_FIRST_TO });

/** @param {Partial<DuelSettings>} [settings] @returns {DuelState} */
export function initialDuelState(settings = {}) {
  return { phase: 'setup', settings: { ...DEFAULT_SETTINGS, ...settings }, round: 0, score: { me: 0, cpu: 0 }, board: null, last: null, history: [] };
}

/**
 * Seven dice for one round, values 1–6, with the style's colours (Challenge and Expert = 3 power dice).
 * Easy/Challenge are rolled. Expert is never rolled: a random board often has no all-3-power answer,
 * so its dice come from a vetted deck (`dealExpert`, see expertDealer.js).
 * @param {DuelStyle} style
 * @param {() => number} [rng]
 * @param {() => number[]} [dealExpert]
 */
export function rollRound(style, rng = Math.random, dealExpert = undefined) {
  if (style === 'expert') {
    if (!dealExpert) throw new Error('Expert dice come from a vetted deck');
    return { dice: [...dealExpert()], colors: POWER_DICE_COLORS };
  }
  const dice = Array.from({ length: 7 }, () => Math.min(6, Math.floor(rng() * 6) + 1));
  return { dice, colors: style === 'challenge' ? POWER_DICE_COLORS : EASY_DICE_COLORS };
}

/** Who has won the match, if anyone. @param {DuelState} s */
export function matchWinner(s) {
  if (s.score.me >= s.settings.firstTo) return 'me';
  if (s.score.cpu >= s.settings.firstTo) return 'cpu';
  return null;
}

const freshMatch = (s) => ({ ...s, phase: 'countdown', round: 1, score: { me: 0, cpu: 0 }, board: null, last: null, history: [] });

const validSettings = (patch) => {
  const out = {};
  if (DUEL_STYLES.includes(patch.style)) out.style = patch.style;
  if (['cadet', 'ace', 'legend'].includes(patch.speed)) out.speed = patch.speed;
  if (FIRST_TO_OPTIONS.includes(patch.firstTo)) out.firstTo = patch.firstTo;
  return out;
};

/**
 * @param {DuelState} s
 * @param {{ type: string, [k: string]: any }} a
 * @returns {DuelState}
 */
export function duelReducer(s, a) {
  switch (a.type) {
    case 'configure':
      return s.phase === 'setup' ? { ...s, settings: { ...s.settings, ...validSettings(a.patch || {}) } } : s;
    case 'start':
      return s.phase === 'setup' ? freshMatch(s) : s;
    case 'rematch':
      return s.phase === 'result' ? freshMatch(s) : s;
    case 'serve':
      return s.phase === 'countdown' ? { ...s, phase: 'round', board: { dice: a.dice, colors: a.colors }, last: null } : s;
    case 'claim': {
      // First correct answer wins: once the round has closed, a later claim changes nothing.
      if (s.phase !== 'round' || (a.by !== 'me' && a.by !== 'cpu')) return s;
      /** @type {RoundResult} */
      const last = { round: s.round, by: a.by, equation: a.equation ?? null, usedIndices: a.usedIndices ?? null, ms: a.ms ?? null };
      return { ...s, phase: 'reveal', score: { ...s.score, [a.by]: s.score[a.by] + 1 }, last, history: [...s.history, last] };
    }
    case 'void': {
      if (s.phase !== 'round') return s;
      const last = { round: s.round, by: null, equation: null, usedIndices: null, ms: null };
      return { ...s, phase: 'reveal', last, history: [...s.history, last] };
    }
    case 'next':
      if (s.phase !== 'reveal') return s;
      return matchWinner(s) ? { ...s, phase: 'result', board: null } : { ...s, phase: 'countdown', round: s.round + 1, board: null };
    case 'leave':
      return { ...initialDuelState(s.settings) };
    default:
      return s;
  }
}
