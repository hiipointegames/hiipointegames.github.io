import React from 'react';
import { PrimaryButton } from '../ui';
import { COMPUTER_PILOTS, PILOT_SPEEDS } from './computerPilot';
import { DUEL_STYLES, FIRST_TO_OPTIONS } from './duelReducer';

// Before a practice duel: pick the computer pilot's speed, the dice and the match length.

const STYLE_LABEL = Object.freeze({ easy: 'Easy', challenge: 'Challenge', expert: 'Expert' });
const STYLE_LINE = Object.freeze({ easy: 'Seven white dice', challenge: '2 of 3 power dice', expert: 'All 3 power dice' });
const secs = (ms) => Math.round(ms / 1000);

/** @param {{ settings: import('./duelReducer').DuelSettings, onChange: (patch: object) => void, onStart: () => void }} props */
export default function DuelSetup({ settings, onChange, onStart }) {
  return (
    <div data-testid="duel-setup" className="mx-auto w-full max-w-md space-y-4 px-4 pt-3">
      <p className="text-center text-sm text-slate-300">Same dice for both pilots. First correct 37 takes the round.</p>

      <Section title="Computer pilot">
        <div className="grid grid-cols-3 gap-2">
          {PILOT_SPEEDS.map((id) => {
            const p = COMPUTER_PILOTS[id];
            return (
              <Choice key={id} testId={`duel-speed-${id}`} selected={settings.speed === id} onPick={() => onChange({ speed: id })}>
                <div className="text-sm font-black">{p.label}</div>
                <div className="text-[10px] text-slate-300">{secs(p.minMs)}–{secs(p.maxMs)} s</div>
              </Choice>
            );
          })}
        </div>
      </Section>

      <Section title="Dice">
        <div className="grid grid-cols-3 gap-2">
          {DUEL_STYLES.map((id) => (
            <Choice key={id} testId={`duel-style-${id}`} selected={settings.style === id} onPick={() => onChange({ style: id })}>
              <div className="text-sm font-black">{STYLE_LABEL[id]}</div>
              <div className="text-[10px] text-slate-300">{STYLE_LINE[id]}</div>
            </Choice>
          ))}
        </div>
      </Section>

      <Section title="First to">
        <div className="grid grid-cols-4 gap-2">
          {FIRST_TO_OPTIONS.map((n) => (
            <Choice key={n} testId={`duel-first-to-${n}`} selected={settings.firstTo === n} onPick={() => onChange({ firstTo: n })}>
              <div className="text-lg font-black tabular-nums">{n}</div>
            </Choice>
          ))}
        </div>
      </Section>

      <PrimaryButton testId="duel-start" tone="rose" onClick={onStart}>START DUEL</PrimaryButton>
      <p className="text-center text-[11px] text-slate-400">Practice match: no stars, no ads.</p>
    </div>
  );
}

function Section({ title, children }) {
  return (
    <div>
      <div className="mb-1.5 text-[10px] font-bold uppercase tracking-[0.25em] text-violet-300/80">{title}</div>
      {children}
    </div>
  );
}

function Choice({ selected, onPick, testId, children }) {
  return (
    <button
      type="button"
      data-testid={testId}
      aria-pressed={selected}
      onClick={onPick}
      className={`rounded-xl border px-2 py-2.5 text-center text-white active:scale-95 ${selected ? 'border-fuchsia-300 bg-fuchsia-500/25' : 'border-white/15 bg-black/40'}`}
      style={selected ? { boxShadow: '0 0 18px -6px #e879f9' } : undefined}
    >
      {children}
    </button>
  );
}
