import React from 'react';
import { Trophy } from 'lucide-react';

// V6: the leaderboard's top-3 rank marker. Ranks 1-3 get a metal-colored lucide
// Trophy (gold / silver / bronze) with the rank number small beside it — flashier
// and more rewarding than a plain numbered circle; ranks 4+ keep the original
// purple gradient circle unchanged. Extracted here because the same rank marker
// was duplicated three times in LeaderboardView (the scrollable row + the sticky
// top/bottom current-user rows); one component keeps them identical.

// gold · silver · bronze (the app's existing podium hues).
export const TROPHY_COLOR = Object.freeze({ 1: '#FBBF24', 2: '#CBD5E1', 3: '#C77B3B' });

export default function RankBadge({ rank }) {
  const metal = TROPHY_COLOR[rank];
  if (metal) {
    return (
      <div className="flex items-center gap-1 flex-shrink-0" aria-label={`Rank ${rank}`}>
        <Trophy
          className="w-6 h-6"
          strokeWidth={1.75}
          style={{ color: metal, fill: metal, filter: `drop-shadow(0 2px 6px ${metal}80)` }}
        />
        <span className="text-xs font-black text-slate-300">{rank}</span>
      </div>
    );
  }
  return (
    <div className="w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0 bg-gradient-to-br from-purple-500 to-pink-600 shadow-[0_4px_12px_rgba(168,85,247,0.4),inset_0_1px_2px_rgba(255,255,255,0.3)] text-white">
      {rank}
    </div>
  );
}
