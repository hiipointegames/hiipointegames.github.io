import React from 'react';

/**
 * A crisp, on-brand pip die used in stats / leaderboard / solved-equation views
 * and (at an explicit size) the login hero.
 *
 * `size` is OPTIONAL — omitted, the die keeps its default compact w-8 h-8
 * footprint. Marking it optional here keeps every caller that renders the
 * default die type-clean under checkJs (without the annotation TS infers all
 * three props as required, which breaks the ~15 default-size call sites).
 *
 * @param {{ value: number, color: string, size?: number }} props
 */
export default function MiniDice({ value, color, size }) {
  const colorClasses = {
    white: 'bg-white border-slate-300',
    red: 'bg-gradient-to-br from-red-500 to-red-600 border-red-400',
    blue: 'bg-gradient-to-br from-blue-500 to-blue-600 border-blue-400',
    green: 'bg-gradient-to-br from-green-500 to-green-600 border-green-400'
  };

  const dotColor = color === 'white' ? 'bg-slate-700' : 'bg-white';

  const getDotPattern = () => {
    const patterns = {
      1: [[1, 1]],
      2: [[0, 0], [2, 2]],
      3: [[0, 0], [1, 1], [2, 2]],
      4: [[0, 0], [0, 2], [2, 0], [2, 2]],
      5: [[0, 0], [0, 2], [1, 1], [2, 0], [2, 2]],
      6: [[0, 0], [0, 2], [1, 0], [1, 2], [2, 0], [2, 2]]
    };
    return patterns[value] || [];
  };

  // Optional explicit pixel size (e.g. the login hero die). Omitted → the die
  // keeps its default compact w-8 h-8 footprint used in stats/leaderboard/
  // solved-equation views, so those renders stay byte-identical. Given a size,
  // the face, padding, and pips all scale from it (0.1875 ≈ w-1.5 / w-8;
  // 0.125 ≈ p-1 / w-8; 0.22 ≈ rounded-lg on w-8) so the pip layout is identical
  // at any size — a crisp, on-brand die instead of a platform emoji.
  const scaled = typeof size === 'number';
  const faceStyle = scaled ? { width: size, height: size, borderRadius: size * 0.22 } : undefined;
  const faceClass = scaled
    ? `${colorClasses[color]} border shadow-md relative`
    : `w-8 h-8 rounded-lg ${colorClasses[color]} border shadow-md relative`;
  const gridStyle = scaled ? { padding: size * 0.125 } : undefined;
  const gridClass = scaled
    ? 'absolute inset-0 grid grid-cols-3 grid-rows-3'
    : 'absolute inset-0 grid grid-cols-3 grid-rows-3 p-1';
  const dotStyle = scaled ? { width: size * 0.1875, height: size * 0.1875 } : undefined;
  const dotClass = scaled ? `rounded-full ${dotColor}` : `w-1.5 h-1.5 rounded-full ${dotColor}`;

  return (
    <div className={faceClass} style={faceStyle}>
      <div className={gridClass} style={gridStyle}>
        {Array.from({ length: 9 }).map((_, i) => {
          const row = Math.floor(i / 3);
          const col = i % 3;
          const hasDot = getDotPattern().some(([r, c]) => r === row && c === col);
          return hasDot ? (
            <div key={i} className="flex items-center justify-center">
              <div className={dotClass} style={dotStyle} />
            </div>
          ) : <div key={i} />;
        })}
      </div>
    </div>
  );
}