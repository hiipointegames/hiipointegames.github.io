// webInterstitialController — INERT. Kept only so the two native-parity call
// sites in shell/interstitialAd.js keep a stable seam on web.
//
// HISTORY / WHY IT IS INERT: this used to bridge an imperative "show an ad, then
// continue" call to a React overlay (<WebInterstitial>) mounted at the app root.
// That overlay rendered `position: fixed; inset: 0` over the whole viewport, and
// its entire content was the word "Advertisement", one AdSense unit and a
// Continue button — a full-screen Google ad with zero publisher content on the
// page behind it. AdSense's policy against ads on screens without publisher
// content has no version of that which is compliant, so the overlay was deleted
// (2026-08-23, AdSense Phase 1) rather than tuned.
//
// Web behaviour now: the gated follow-up action (daily-challenge start warning,
// head-to-head start) fires immediately with no overlay. NATIVE IS UNCHANGED —
// shell/interstitialAd.js still calls AdMob.showInterstitial() on native, and
// this module is never reached there.
//
// Do NOT reintroduce an overlay here without a publisher-content story for the
// screen it covers.

/**
 * Web stand-in for the native interstitial. Resolves immediately and shows
 * nothing, so callers awaiting it continue straight to their gated action.
 * @returns {Promise<void>}
 */
export function requestWebInterstitial() {
  return Promise.resolve();
}
