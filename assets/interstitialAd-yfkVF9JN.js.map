// shell/adFreezeAlarm — notice when a full-screen ad opened and never closed.
//
// A frozen ad (2026-10-08: Google's close button broke, no X, taps dead) leaves
// the player no way out but killing the app, so nothing can be reported AT the
// moment it happens. Instead: write a note on the phone when an ad opens, erase
// it when the ad closes or fails to show. If the note is still there the next
// time the app runs, the last ad never closed — report `stale_open`.
//
// Every interstitial also reports shown / dismissed / failed_to_show, so
// stale_open ÷ shown in public.client_events is the freeze rate per platform and
// build. A rate above zero after the switch goes on is the signal to flip
// app_settings.native_interstitials back to 'off' (src/shell/adSwitch.js).

import { AdMob, InterstitialAdPluginEvents } from '@capacitor-community/admob';
import { recordOutcome } from '@/observability';

export const AD_OPEN_KEY = 'u37.interstitialOpenSince';

let listening = false;

function store(deps) {
  if (deps.storage) return deps.storage;
  try { return window.localStorage; } catch { return null; }
}

/** The ad is on screen: leave the note. */
export function markAdOpen(deps = {}) {
  try { store(deps)?.setItem(AD_OPEN_KEY, String((deps.now || Date.now)())); } catch { /* storage blocked: alarm off */ }
}

/** The ad ended (closed or never showed): erase the note. */
export function markAdClosed(deps = {}) {
  try { store(deps)?.removeItem(AD_OPEN_KEY); } catch { /* storage blocked: alarm off */ }
}

/**
 * If the last run ended with an ad still open, report it once and clear the note.
 * Call after sign-in is ready (client_events accepts authenticated inserts only).
 * @returns {boolean} whether a stale open ad was found
 */
export function reportStaleAdOpen(deps = {}) {
  let since = null;
  try { since = store(deps)?.getItem(AD_OPEN_KEY); } catch { return false; }
  if (!since) return false;
  markAdClosed(deps);
  (deps.record || recordOutcome)('interstitial', 'stale_open', { reason: 'app_closed_with_ad_open' });
  return true;
}

/**
 * Register the alarm's listeners once per app run. Never throws.
 * @param {{ AdMob?: any, record?: Function, storage?: Storage, now?: () => number }} [deps]
 */
export async function listenForAdFreezes(deps = {}) {
  if (listening && !deps.AdMob) return;
  listening = true;
  const admob = deps.AdMob || AdMob;
  const record = deps.record || recordOutcome;
  try {
    await admob.addListener(InterstitialAdPluginEvents.Showed, () => {
      markAdOpen(deps);
      record('interstitial', 'shown');
    });
    await admob.addListener(InterstitialAdPluginEvents.Dismissed, () => {
      markAdClosed(deps);
      record('interstitial', 'dismissed');
    });
    await admob.addListener(InterstitialAdPluginEvents.FailedToShow, (err) => {
      markAdClosed(deps);
      record('interstitial', 'failed_to_show', { code: err?.code != null ? String(err.code) : undefined });
    });
  } catch {
    listening = false; // try again next time
  }
}

// Test-only reset.
export function __resetAdFreezeAlarmForTests() { listening = false; }
