// shell/interstitialAd — wraps the Capacitor AdMob interstitial lifecycle.
//
// Exposes `useInterstitialAd()` — a hook that:
//   - registers event listeners on mount (Loaded / Dismissed / FailedToLoad)
//   - prepares the next ad in advance so it shows immediately when requested
//   - returns { isLoaded, show } so consumers can decide when to trigger
//
// No-op on web. On native, ad unit IDs are resolved per platform.
//
// See:
//   docs/architecture/subsystems.md  (#13 — shell)

import { useEffect, useState, useCallback } from 'react';
import { Capacitor } from '@capacitor/core';
import { AdMob, InterstitialAdPluginEvents } from '@capacitor-community/admob';
import { getInterstitialAdId, adIsTesting } from './adConfig';
import { whenAdsAllowed } from './adGate';
import { interstitialsAllowed } from './adSwitch';
import { listenForAdFreezes, reportStaleAdOpen } from './adFreezeAlarm';
import { requestWebInterstitial } from './web-ads/webInterstitialController';

async function prepareInterstitial() {
  // Switched off on the server (see adSwitch): never load an ad we won't show.
  if (!(await interstitialsAllowed())) return;
  listenForAdFreezes();
  // Respect UMP consent: never request an ad until the gate says ads are
  // allowed (and not at all if consent was denied).
  if (!(await whenAdsAllowed())) return;
  const adId = getInterstitialAdId();
  if (!adId) return;
  await AdMob.prepareInterstitial({ adId, isTesting: adIsTesting() });
}

/**
 * Lifecycle hook for the interstitial ad. Returns { isLoaded, show }.
 *   - isLoaded: true once the native plugin reports Loaded for the prepared ad.
 *   - show():   trigger AdMob.showInterstitial(); reloads the next ad
 *               automatically when the user dismisses.
 *
 * On web (Capacitor.isNativePlatform() === false) this is a no-op:
 * isLoaded stays false and show() resolves without doing anything.
 */
export function useInterstitialAd() {
  const [isLoaded, setIsLoaded] = useState(false);

  useEffect(() => {
    if (!Capacitor.isNativePlatform()) return undefined;
    // Did the last run end with an ad stuck open? Checked even while the switch
    // is off, so a freeze that made us flip it still gets counted.
    reportStaleAdOpen();
    let cancelled = false;
    // Track listener handles so we can remove them on unmount. Without this,
    // every mount (e.g. navigating Game <-> HeadToHead, which both use this
    // hook) leaks 3 listeners — and a stale instance's Dismissed handler would
    // keep firing prepareInterstitial() after unmount.
    const handles = [];
    const setup = async () => {
      try {
        handles.push(await AdMob.addListener(InterstitialAdPluginEvents.Loaded, () => {
          if (!cancelled) setIsLoaded(true);
        }));
        handles.push(await AdMob.addListener(InterstitialAdPluginEvents.Dismissed, () => {
          if (cancelled) return;
          setIsLoaded(false);
          // Pre-load the next one so it's ready when needed.
          prepareInterstitial().catch((e) =>
            console.error('Failed to re-prepare interstitial:', e)
          );
        }));
        handles.push(await AdMob.addListener(InterstitialAdPluginEvents.FailedToLoad, (error) => {
          console.error('Interstitial ad failed to load:', error);
        }));
        await prepareInterstitial();
      } catch (e) {
        console.error('Error initializing interstitial:', e);
      }
    };
    setup();
    return () => {
      cancelled = true;
      handles.forEach((h) => h?.remove?.());
    };
  }, []);

  const show = useCallback(async () => {
    if (!Capacitor.isNativePlatform()) {
      // Web parity: pop the placeholder/AdSense interstitial at the same
      // transition the native ad would fire, then continue.
      await requestWebInterstitial();
      return;
    }
    if (!isLoaded) return;
    // Re-checked at show time: if the server switch went off after this ad
    // loaded, it must not open.
    if (!(await interstitialsAllowed())) return;
    try {
      await AdMob.showInterstitial();
    } catch (e) {
      console.error('Failed to show interstitial:', e);
    }
  }, [isLoaded]);

  return { isLoaded, show };
}

/**
 * Imperative one-shot: show the currently-prepared interstitial, then
 * invoke onDismissed when the ad finishes (or immediately on web /
 * failure). Used by orchestration flows that need to gate a follow-up
 * action behind ad completion — e.g. "show ad, then show the daily
 * challenge confirmation modal".
 *
 * Registers and removes its own dismiss listener so callers don't have
 * to manage AdMob listener lifecycle.
 */
/**
 * @param {{ onDismissed?: () => void }} [opts]
 */
export async function showInterstitial({ onDismissed } = {}) {
  if (!Capacitor.isNativePlatform()) {
    // Web parity: show the placeholder/AdSense interstitial, THEN run the gated
    // follow-up — mirroring native's "ad dismissed → onDismissed".
    await requestWebInterstitial();
    onDismissed?.();
    return;
  }
  if (!(await interstitialsAllowed())) {
    // Switched off: go straight to the follow-up, as if the ad was dismissed.
    onDismissed?.();
    return;
  }
  // The follow-up must run exactly once, whichever way the ad ends.
  const handles = [];
  let finished = false;
  const finish = () => {
    if (finished) return;
    finished = true;
    handles.forEach((h) => h?.remove?.());
    onDismissed?.();
  };
  try {
    handles.push(await AdMob.addListener(InterstitialAdPluginEvents.Dismissed, finish));
    // The plugin keeps the last ad after it has been shown, so a quick second
    // Daily re-shows a spent ad. Google answers that with FailedToShow, never
    // Dismissed, and the player used to wait on the start screen forever.
    handles.push(await AdMob.addListener(InterstitialAdPluginEvents.FailedToShow, (err) => {
      console.error('Interstitial failed to show:', err);
      finish();
    }));
    await AdMob.showInterstitial();
  } catch (e) {
    console.error('Failed to show interstitial:', e);
    // Fail open: still invoke the callback so the UX flow isn't blocked.
    finish();
  }
}
