// First Contact — decode an alien equation (Wordle × Nerdle × Mastermind).
//
// The secret is an equation equal to 37 that uses the 7 shown dice once each,
// written in a known SHAPE (brackets fixed, 7 dice slots, 6 operator slots).
// Each guess must itself be a real 37 in that shape. Feedback per slot is
// Wordle's: green = right symbol, right slot; yellow = in the equation elsewhere;
// grey = not there. Dice slots and operator slots are scored SEPARATELY, so a die
// is never "yellow" because an operator matched.

import { evaluateTokens, hits } from '../sectorMath';
import { makeRng, rollDie, shuffle, pick } from '../rng';

export const TARGET = 37;
export const MAX_GUESSES = 6;
export const OPERATORS = ['+', '-', '*', '/', '^'];

/**
 * THE one "equals 37" test (audit 2026-10-18, design D2): the live pill, the "Ready to transmit"
 * line and checkGuess all ask this, so a row the pill calls 37 is a row TRANSMIT accepts. (The
 * pill used 1e-9 and the check 1e-6, so (1÷6)^(3×3)+(6×6+1) read "= 37.00 · 0.00 too high" yet sent.)
 * @param {number|null|undefined} v
 */
export const isThirtySeven = (v) => v != null && Number.isFinite(v) && hits(v, TARGET);

// D = die slot, O = operator slot. Exactly 7 D and 6 O each.
export const SHAPES = [
  ['(', 'D', 'O', 'D', ')', 'O', 'D', 'O', 'D', 'O', '(', 'D', 'O', 'D', 'O', 'D', ')'],
  ['D', 'O', '(', 'D', 'O', 'D', ')', 'O', '(', 'D', 'O', 'D', ')', 'O', 'D', 'O', 'D'],
  ['(', 'D', 'O', 'D', 'O', 'D', ')', 'O', '(', 'D', 'O', 'D', 'O', 'D', ')', 'O', 'D'],
  ['D', 'O', 'D', 'O', 'D', 'O', 'D', 'O', 'D', 'O', 'D', 'O', 'D'],
  ['(', 'D', 'O', 'D', ')', 'O', '(', 'D', 'O', 'D', ')', 'O', '(', 'D', 'O', 'D', 'O', 'D', ')'],
];

/**
 * Fill a shape: `dice` = the 7 die VALUES in slot order, `ops` = 6 operators.
 * Returns the token list + values array evaluateTokens wants.
 */
export function fillShape(shape, dice, ops) {
  /** @type {Array<{t: 'die', i: number} | {t: 'op', v: string}>} */
  const tokens = [];
  let d = 0;
  let o = 0;
  for (const cell of shape) {
    if (cell === 'D') { tokens.push({ t: 'die', i: d }); d++; }
    else if (cell === 'O') { tokens.push({ t: 'op', v: ops[o] }); o++; }
    else tokens.push({ t: 'op', v: cell });
  }
  return { tokens, values: dice };
}

export function evaluateFill(shape, dice, ops) {
  if (dice.length !== 7 || ops.length !== 6 || ops.some((x) => !x) || dice.some((x) => x == null)) return null;
  const { tokens, values } = fillShape(shape, dice, ops);
  const r = evaluateTokens(tokens, values);
  return r.ok ? r.value : null;
}

/**
 * Generate a signal: dice, shape and a secret (dice order + ops) equal to 37.
 * Random search — finding one solution takes milliseconds, which is all a
 * puzzle needs (see modes-design.md for why we don't enumerate everything).
 * Prefers secrets that use at least two distinct operators (all-"+" is dull).
 * `accept` (optional) can turn a found secret down and keep searching — ./fairness.js uses it to
 * keep every day's difficulty in the same band.
 */
export function generateSignal(seed, { maxTries = 400000, accept = null } = {}) {
  const rng = makeRng(seed);
  for (let attempt = 0; attempt < 40; attempt++) {
    const dice = Array.from({ length: 7 }, () => rollDie(rng));
    const shape = pick(rng, SHAPES);
    for (let k = 0; k < maxTries / 40; k++) {
      const order = shuffle(rng, dice);
      const ops = Array.from({ length: 6 }, () => OPERATORS[Math.floor(rng() * (rng() < 0.15 ? 5 : 4))]);
      if (new Set(ops).size < 2) continue;
      const v = evaluateFill(shape, order, ops);
      if (isThirtySeven(v)) {
        const sig = { dice: [...dice].sort((a, b) => a - b), shape, secret: { dice: order, ops } };
        if (!accept || accept(sig)) return sig;
      }
    }
  }
  // Practically unreachable; a hand-checked fallback keeps the mode playable.
  return {
    dice: [1, 1, 2, 3, 4, 5, 6],
    shape: SHAPES[3],
    // 6 × 5 + 4 + 3 − 2 + 1 + 1 = 37
    secret: { dice: [6, 5, 4, 3, 2, 1, 1], ops: ['*', '+', '+', '-', '+', '+'] },
  };
}

/** Wordle two-pass scoring of one symbol row against the secret row. */
export function scoreRow(guess, secret) {
  const res = guess.map(() => 'grey');
  const remaining = {};
  secret.forEach((s, i) => {
    if (guess[i] === s) res[i] = 'green';
    else remaining[s] = (remaining[s] || 0) + 1;
  });
  guess.forEach((g, i) => {
    if (res[i] === 'green') return;
    if (remaining[g] > 0) { res[i] = 'yellow'; remaining[g]--; }
  });
  return res;
}

/** Feedback for a whole guess: { dice: [...7], ops: [...6] }. */
export function scoreGuess(guess, secret) {
  return { dice: scoreRow(guess.dice, secret.dice), ops: scoreRow(guess.ops, secret.ops) };
}

/**
 * Is this a legal transmission? Uses each shown die exactly once and equals 37.
 * @returns {{ ok: boolean, reason?: 'incomplete'|'dice'|'invalid'|'not37', value?: number }}
 */
export function checkGuess(shape, boardDice, guess) {
  if (guess.dice.length !== 7 || guess.ops.length !== 6 || guess.ops.some((x) => !x)) return { ok: false, reason: 'incomplete' };
  const a = [...guess.dice].sort((x, y) => x - y).join();
  const b = [...boardDice].sort((x, y) => x - y).join();
  if (a !== b) return { ok: false, reason: 'dice' };
  const v = evaluateFill(shape, guess.dice, guess.ops);
  if (v == null) return { ok: false, reason: 'invalid' };
  if (!isThirtySeven(v)) return { ok: false, reason: 'not37', value: v };
  return { ok: true, value: v };
}

export const isSolved = (fb) => fb.dice.every((c) => c === 'green') && fb.ops.every((c) => c === 'green');

const EMOJI = { green: '🟩', yellow: '🟨', grey: '⬛' };

/** Emoji grid in SHAPE order (brackets omitted). */
export function shareGrid(shape, feedbacks) {
  return feedbacks.map((fb) => {
    let d = 0; let o = 0;
    return shape.map((cell) => {
      if (cell === 'D') return EMOJI[fb.dice[d++]];
      if (cell === 'O') return EMOJI[fb.ops[o++]];
      return '';
    }).join('');
  }).join('\n');
}

// Alien glyphs shown in a slot until it has been decoded (been green once).
export const GLYPHS = ['⟟', '⏃', '⏁', '⟒', '⌇', '⋔', '⍜', '⏚', '⌰', '⟊', '⎍', '⏀', '⊑'];
