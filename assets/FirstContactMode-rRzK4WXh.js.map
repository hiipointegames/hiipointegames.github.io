// First Contact — "same maths, any order" (design decision 1, David 2026-10-04).
//
// A guess wins if it is the hidden equation with the operands of its SUMS and
// PRODUCTS reordered: 2+3 ≡ 3+2, 4×5 ≡ 5×4, 5−(1+2) ≡ 5−2−1. Different maths that
// also makes 37 does not win. ÷ and ^ keep their order (a÷b ≢ b÷a, a^b ≢ b^a).
//
// Method: parse each filled shape into a tree, then reduce it to a CANONICAL STRING:
//   • a +/− chain → S( sorted signed terms )   (a − b contributes −b; brackets distribute signs)
//   • ^ → E( base, exponent )  (a^b ≢ b^a)
//   • a ×/÷ chain → P( sorted factors, each *f or /f )  (redesign 2026-10-22: × and ÷ mix freely)
// Two equations are equivalent iff their canonical strings are equal.
//
// The server mirror arrives with the ranked Daily (F4); a drift-guard test will pin them.

import { fillShape, scoreGuess } from './logic';

const PREC = { '+': 2, '-': 2, '*': 3, '/': 3, '^': 4 };

/** Parse a filled shape's token list into a tree (numbers, binary ops; brackets as grouping). */
export function parseFilled(tokens, values) {
  let pos = 0;
  const peek = () => tokens[pos];
  const primary = () => {
    const t = tokens[pos++];
    if (!t) throw new Error('incomplete');
    if (t.t === 'die') return { n: values[t.i] };
    if (t.v === '(') {
      const inner = expr(0);
      if (tokens[pos++]?.v !== ')') throw new Error('unclosed');
      return inner;
    }
    throw new Error('unexpected');
  };
  const expr = (min) => {
    let left = primary();
    for (;;) {
      const t = peek();
      if (!t || t.t !== 'op' || !(t.v in PREC) || PREC[t.v] < min) break;
      pos++;
      const right = expr(t.v === '^' ? PREC[t.v] : PREC[t.v] + 1);
      left = { op: t.v, l: left, r: right };
    }
    return left;
  };
  const tree = expr(0);
  if (pos !== tokens.length) throw new Error('trailing');
  return tree;
}

function sumTerms(node, sign, out) {
  if (node.op === '+') { sumTerms(node.l, sign, out); sumTerms(node.r, sign, out); }
  else if (node.op === '-') { sumTerms(node.l, sign, out); sumTerms(node.r, -sign, out); }
  else out.push(`${sign > 0 ? '+' : '-'}${canon(node)}`);
  return out;
}

// × and ÷ chains are ONE product of factors and inverse factors (redesign 2026-10-22, bug: the
// game said 6 × 4 ÷ 2 and 6 ÷ 2 × 4 were different maths, and so were a ÷ b ÷ c and a ÷ c ÷ b).
// a ÷ b contributes b as an inverse factor; a ÷ (b × c) distributes; a ÷ (b ÷ c) flips c back.
function prodFactors(node, inv, out) {
  if (node.op === '*') { prodFactors(node.l, inv, out); prodFactors(node.r, inv, out); }
  else if (node.op === '/') { prodFactors(node.l, inv, out); prodFactors(node.r, !inv, out); }
  else out.push(`${inv ? '/' : '*'}${canon(node)}`);
  return out;
}

/** Canonical string for a tree. */
export function canon(node) {
  if (node.n !== undefined) return String(node.n);
  if (node.op === '+' || node.op === '-') return `S(${sumTerms(node, 1, []).sort().join(',')})`;
  if (node.op === '*' || node.op === '/') return `P(${prodFactors(node, false, []).sort().join(',')})`;
  return `E(${canon(node.l)},${canon(node.r)})`;
}

/** Canonical form of a filled shape (dice values in slot order, operators in slot order). */
export function canonicalOf(shape, dice, ops) {
  const { tokens, values } = fillShape(shape, dice, ops);
  return canon(parseFilled(tokens, values));
}

/** Is this guess the hidden equation, up to reordering sums and products? */
export function isEquivalent(shape, guess, secret) {
  try {
    return canonicalOf(shape, guess.dice, guess.ops) === canonicalOf(shape, secret.dice, secret.ops);
  } catch {
    return false; // an incomplete or malformed guess is never equivalent
  }
}

const greens = (fb) => fb.dice.filter((c) => c === 'green').length + fb.ops.filter((c) => c === 'green').length;
const swapped = (arr, i, j) => { const a = [...arr]; [a[i], a[j]] = [a[j], a[i]]; return a; };

const sameFb = (a, b) => a.dice.every((c, i) => c === b.dice[i]) && a.ops.every((c, i) => c === b.ops[i]);

/**
 * Does this candidate answer agree with everything the player has been shown? Every earlier row
 * must score EXACTLY the colours it got; a revealed box (Decode) must hold its piece; a Scan's sign
 * counts must hold.
 * @param {{ dice: number[], ops: string[] }} cand
 * @param {{ history?: Array<{dice:number[],ops:string[],fb:{dice:string[],ops:string[]}}>,
 *   known?: Record<string, number|string>, counts?: Record<string, number>|null }} [shown]
 */
export function agreesWith(cand, { history = [], known = {}, counts = null } = {}) {
  for (const [key, v] of Object.entries(known)) if ((key[0] === 'd' ? cand.dice : cand.ops)[Number(key.slice(1))] !== v) return false;
  if (counts) for (const [op, n] of Object.entries(counts)) if (cand.ops.filter((o) => o === op).length !== n) return false;
  return history.every((g) => sameFb(scoreGuess(g, cand), g.fb));
}

/**
 * Line the hidden answer up with the NEW guess (sweep review 2026-10-05, Mathler precedent;
 * re-done every guess since the redesign of 2026-10-22). Under "same maths, any order" the answer
 * is a whole CLASS of equivalent orderings; scoring against one arbitrary member made
 * correct-but-reordered terms show yellow. Each guess we move to the equivalent member that gives
 * this guess the most greens — but ONLY among members that agree with everything already shown
 * (`shown`: every earlier row's exact colours, revealed boxes, Scan counts; see agreesWith). So
 * earlier colours never change. (Before, the answer was lined up with guess 1 only and then
 * frozen: on ~16–27% of second guesses a box showed yellow/grey although an equivalent answer
 * that agreed with guess 1 had that piece right there — research synthesis C1/C2.)
 *
 * Hill-climb from `secret` (which must itself agree with `shown` — the previous alignment does):
 * try swapping two dice, two operators, or one of each; keep any swap that is still equivalent,
 * still agrees, and adds greens. The result is always a correct answer that agrees with every
 * earlier row; it may miss the global best (fine — it is never wrong).
 * @returns {{ dice: number[], ops: string[] }}
 */
export function alignSecret(shape, guess, secret, shown = {}) {
  let target;
  try { target = canonicalOf(shape, secret.dice, secret.ops); } catch { return secret; }
  const same = (c) => { try { return canonicalOf(shape, c.dice, c.ops) === target; } catch { return false; } };
  const ok = (c) => agreesWith(c, shown) && same(c);
  let best = secret;
  let bestScore = greens(scoreGuess(guess, best));
  for (let round = 0; round < 8; round++) {
    let improved = false;
    const nd = best.dice.length; const no = best.ops.length;
    const moves = [];
    for (let i = 0; i < nd; i++) for (let j = i + 1; j < nd; j++) moves.push({ dice: swapped(best.dice, i, j), ops: best.ops });
    for (let i = 0; i < no; i++) for (let j = i + 1; j < no; j++) moves.push({ dice: best.dice, ops: swapped(best.ops, i, j) });
    for (let i = 0; i < nd; i++) for (let j = i + 1; j < nd; j++) {
      for (let a = 0; a < no; a++) for (let b = a + 1; b < no; b++) moves.push({ dice: swapped(best.dice, i, j), ops: swapped(best.ops, a, b) });
    }
    for (const m of moves) {
      const sc = greens(scoreGuess(guess, m));
      if (sc > bestScore && ok(m)) { best = m; bestScore = sc; improved = true; }
    }
    if (!improved) break;
  }
  return best;
}

const RANK = { grey: 0, yellow: 1, green: 2 };

/**
 * Button colour memory (Wordle keyboard): the best state each die VALUE and each
 * OPERATOR has reached across all feedback so far.
 * @param {Array<{dice:number[],ops:string[],fb:{dice:string[],ops:string[]}}>} guesses
 * @returns {{ dice: Record<number,string>, ops: Record<string,string> }}
 */
export function buttonMemory(guesses) {
  /** @type {Record<number, string>} */
  const dice = {};
  /** @type {Record<string, string>} */
  const ops = {};
  const bump = (map, key, state) => { if (map[key] === undefined || RANK[state] > RANK[map[key]]) map[key] = state; };
  for (const g of guesses) {
    g.dice.forEach((v, i) => bump(dice, v, g.fb.dice[i]));
    g.ops.forEach((o, i) => bump(ops, o, g.fb.ops[i]));
  }
  return { dice, ops };
}
