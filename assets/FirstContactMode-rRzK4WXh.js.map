import React, { useEffect, useState } from 'react';
import { motion } from 'framer-motion';
import { DISPLAY } from '../sectorMath';
import { usePrefersReducedMotion } from '../../fx';
import { SHAPES, GLYPHS } from './logic';
import ShapeRow, { rowSizes, BRIEF_BUDGET, BRIEF_MAX_WIDTH } from './ShapeRow';

// First Contact's briefing demo (audit 2026-10-18, design D1; Slice 5b): ~6 s, code-drawn, the core
// loop in one glance — a guess (a real 37) → TRANSMIT → its tiles flip green / yellow / grey → the
// next row starts with the greens carried → it is filled → TRANSMIT → the signal decodes.
// Every equation is real and every colour is what scoreGuess gives (tested with logic.js itself).
// Holds while the app is hidden or How it works covers it. Reduce-motion: three still frames.

/** The demo signal's shape: ( D O D ) O D O D O ( D O D O D ). */
export const FC_DEMO_SHAPE = SHAPES[0];
/** The hidden answer: (1 − 2) + 3 + 4 − (5 − 6 × 6) = 37. */
export const FC_DEMO_SECRET = Object.freeze({ dice: [1, 2, 3, 4, 5, 6, 6], ops: ['-', '+', '+', '-', '-', '*'] });
/** The first guess, itself a real 37: (1 + 2) × 3 × 5 − (6 − 4 + 6) = 37. */
export const FC_DEMO_GUESS = Object.freeze({ dice: [1, 2, 3, 5, 6, 4, 6], ops: ['+', '*', '*', '-', '-', '+'] });
/** Its feedback, written out (the test checks it is exactly scoreGuess(guess, secret)). */
export const FC_DEMO_FEEDBACK = Object.freeze({
  dice: ['green', 'green', 'green', 'yellow', 'yellow', 'yellow', 'green'],
  ops: ['yellow', 'yellow', 'grey', 'green', 'green', 'yellow'],
});
const ALL_GREEN = { dice: Array(7).fill('green'), ops: Array(6).fill('green') };
const EMPTY = { dice: [], ops: [] };
// The next row starts with the greens carried; the rest of its slots are empty. Drawn UNCOLOURED,
// as the real game draws its current row (FirstContactMode renders it with no feedback).
const carry = (row, fb) => row.map((v, k) => (fb[k] === 'green' ? v : null));
const CARRIED = { dice: carry(FC_DEMO_GUESS.dice, FC_DEMO_FEEDBACK.dice), ops: carry(FC_DEMO_GUESS.ops, FC_DEMO_FEEDBACK.ops) };
const SCORED = { ...FC_DEMO_GUESS, fb: FC_DEMO_FEEDBACK };

/**
 * The beats. `ms` = how long each holds (the flips and the decode hold longest).
 * row1 / row2: what each log row shows (fb = its colours). strip: how much of the incoming signal
 * is decoded (none · the greens · all). transmit: the button (dim · lit · pressed). flip: which row's
 * tiles flip over on this beat. The loop STARTS on the filled guess (review 5b M1): its first frame
 * never shows empty boards that look like the real shape under it.
 */
/** @typedef {{ dice: Array<number|null>, ops: Array<string|null>, fb?: { dice: string[], ops: string[] } }} DemoRow */
/** @typedef {{ row1: DemoRow, row2: DemoRow, strip: 'none'|'greens'|'all', transmit: 'dim'|'lit'|'press', chip?: string, flip?: 'row1'|'row2', decoded?: boolean, ms: number }} DemoStep */
/** @type {ReadonlyArray<DemoStep>} */
export const FC_DEMO_STEPS = Object.freeze([
  { row1: { ...FC_DEMO_GUESS }, row2: { ...EMPTY }, strip: 'none', transmit: 'lit', chip: '= 37', ms: 1100 },
  { row1: { ...FC_DEMO_GUESS }, row2: { ...EMPTY }, strip: 'none', transmit: 'press', chip: '= 37', ms: 500 },
  { row1: SCORED, row2: { ...EMPTY }, strip: 'greens', transmit: 'dim', flip: 'row1', ms: 1600 },
  { row1: SCORED, row2: CARRIED, strip: 'greens', transmit: 'dim', ms: 700 },
  { row1: SCORED, row2: { ...FC_DEMO_SECRET }, strip: 'greens', transmit: 'lit', chip: '= 37', ms: 500 },
  { row1: SCORED, row2: { ...FC_DEMO_SECRET }, strip: 'greens', transmit: 'press', chip: '= 37', ms: 400 },
  { row1: SCORED, row2: { ...FC_DEMO_SECRET, fb: ALL_GREEN }, strip: 'all', transmit: 'dim', chip: 'makes 37 ✓', flip: 'row2', decoded: true, ms: 1600 },
]);
export const FC_DEMO_LOOP_MS = FC_DEMO_STEPS.reduce((n, s) => n + s.ms, 0);
const STILLS = [0, 2, 6]; // reduce-motion: the filled guess → its feedback → decoded
/** The demo frame's own `px-2` (16 px) + its 1-px border (2 px), on top of the card's (review 5b m1). */
export const DEMO_FRAME_PAD = 18;
/** Small dice (the shape itself sits below at full size), inside the card AND the demo frame. */
export const DEMO_BUDGET = { ...BRIEF_BUDGET, pad: BRIEF_BUDGET.pad + DEMO_FRAME_PAD, max: 20 };

/** The incoming signal: alien glyphs until a slot has been green, then its real symbol. */
function Strip({ reveal }) {
  let d = 0; let o = 0; let g = 0;
  return (
    <div data-testid="fc-demo-strip" className="flex flex-wrap items-center justify-center gap-0.5 text-xs font-black">
      {FC_DEMO_SHAPE.map((cell, k) => {
        if (cell === '(' || cell === ')') return <span key={k} className="text-violet-300/70">{cell}</span>;
        const isDie = cell === 'D';
        const idx = isDie ? d++ : o++;
        const glyph = GLYPHS[g++ % GLYPHS.length];
        const green = (isDie ? FC_DEMO_FEEDBACK.dice : FC_DEMO_FEEDBACK.ops)[idx] === 'green';
        const shown = reveal === 'all' || (reveal === 'greens' && green);
        const value = isDie ? FC_DEMO_SECRET.dice[idx] : DISPLAY[FC_DEMO_SECRET.ops[idx]];
        return (
          <span key={k} data-revealed={shown ? 'true' : 'false'} className={shown ? 'text-emerald-200' : 'text-cyan-300/60'}>
            {shown ? value : glyph}
          </span>
        );
      })}
    </div>
  );
}

function Frame({ step, sizes, still = false }) {
  const s = FC_DEMO_STEPS[step];
  return (
    <div data-testid={still ? 'fc-demo-still' : 'fc-demo-frame'} data-step={step}
      className="space-y-1 rounded-2xl border border-cyan-300/30 bg-black/40 px-2 py-1.5 opacity-80">
      {/* Labelled and dimmed so it never reads as the real board below it (review 5b M1). */}
      <div data-testid="fc-demo-label" className="text-[10px] font-bold uppercase tracking-[0.25em] text-cyan-200/80">How it plays</div>
      <Strip reveal={s.strip} />
      <div key={`r1-${step}`} data-testid="fc-demo-row1">
        <ShapeRow shape={FC_DEMO_SHAPE} dice={s.row1.dice} ops={s.row1.ops} feedback={s.row1.fb ?? null} flip={s.flip === 'row1' && !still} sizes={sizes} />
      </div>
      <div key={`r2-${step}`} data-testid="fc-demo-row2">
        <ShapeRow shape={FC_DEMO_SHAPE} dice={s.row2.dice} ops={s.row2.ops} feedback={s.row2.fb ?? null} flip={s.flip === 'row2' && !still} sizes={sizes} />
      </div>
      <div className="flex h-5 items-center justify-center gap-1.5">
        {s.chip && (
          <motion.span key={`c${step}`} data-testid="fc-demo-chip" initial={still ? false : { opacity: 0, scale: 0.6 }} animate={{ opacity: 1, scale: 1 }}
            transition={still ? { duration: 0 } : { type: 'spring', stiffness: 380, damping: 16 }}
            className="rounded-full border border-emerald-300/70 px-1.5 text-xs font-black text-emerald-200">{s.chip}</motion.span>
        )}
        {!s.decoded && (
          <motion.span key={`t${step}`} data-testid="fc-demo-transmit" data-state={s.transmit}
            animate={s.transmit === 'press' && !still ? { scale: [1, 0.82, 1] } : { scale: 1 }}
            transition={{ duration: 0.35 }}
            className={`rounded-full px-2 text-[11px] font-black ${s.transmit === 'dim' ? 'bg-slate-700 text-slate-400' : 'bg-cyan-500 text-white'}`}>TRANSMIT 📡</motion.span>
        )}
      </div>
    </div>
  );
}

/**
 * The looping demo (or three stills under reduce-motion). `paused`: hold the current beat.
 * `width`: the measured screen width (the rows are sized from it, as the briefing's shape is).
 */
export default function FirstContactDemo({ paused = false, width = globalThis.innerWidth || 400 }) {
  const reduced = usePrefersReducedMotion();
  const [step, setStep] = useState(0);
  const [tick, setTick] = useState(0); // re-arms the timer while a beat is being held
  useEffect(() => {
    if (reduced || paused) return undefined;
    const id = setTimeout(() => {
      if (typeof document !== 'undefined' && document.hidden) setTick((n) => n + 1);
      else setStep((n) => (n + 1) % FC_DEMO_STEPS.length);
    }, FC_DEMO_STEPS[step].ms);
    return () => clearTimeout(id);
  }, [reduced, paused, step, tick]);
  const sizes = rowSizes(FC_DEMO_SHAPE, Math.min(width, BRIEF_MAX_WIDTH), DEMO_BUDGET);
  if (reduced) {
    return (
      <div data-testid="fc-demo" data-reduced="true" className="space-y-1.5" aria-hidden="true">
        {STILLS.map((k) => <Frame key={k} step={k} sizes={sizes} still />)}
      </div>
    );
  }
  return <div data-testid="fc-demo" aria-hidden="true"><Frame step={step} sizes={sizes} /></div>;
}
