// First Contact — power-ups (redesign 2026-10-22; world framework §C; David's Q1 = A). Pure.
//
// Each costs ONE TRANSMISSION and can be used once per game, the same in the Daily and in
// practice. A transmission is what the Daily board ranks by, so a power-up is a fair trade on the
// board with no server change ("Decoded in 4 of 6 (1 Decode)").
//
//   📡 Scan   — the sign keys show how many of each sign the signal has (a 0 key goes grey).
//   🔓 Decode — the ONE box the player selected turns green with its right piece. Never more than
//              that box, and never without a selected box (David, 2026-10-22).
//
// What a power-up showed is a FACT from then on: alignSecret only moves to answers that keep a
// revealed box and the Scan counts (equivalence.js agreesWith), so it can never change later.

import { OPERATORS } from './logic';

export const POWER_COST = 1; // transmissions

/** @typedef {{ uses: string[], counts: Record<string, number> | null, known: Record<string, number|string>, gaveUp?: boolean }} Powers */
/** @returns {Powers} */
export const noPowers = () => ({ uses: [], counts: null, known: {} });

/** Transmissions spent: rows sent + power-ups used. */
export const spentOf = (guesses, powers) => guesses.length + (powers?.uses?.length ?? 0);

/** Scan: how many of each sign the (aligned) answer has. */
export function scanCounts(answer) {
  /** @type {Record<string, number>} */
  const counts = {};
  for (const op of OPERATORS) counts[op] = answer.ops.filter((o) => o === op).length;
  return counts;
}

/** Decode: the right piece for exactly one box ('d3' / 'o1') of the (aligned) answer. */
export const decodeAt = (answer, key) => (key[0] === 'd' ? answer.dice : answer.ops)[Number(key.slice(1))];

/** "die box 3" / "sign box 2" (1-based, as the player counts). */
export const boxName = (key) => `${key[0] === 'd' ? 'die' : 'sign'} box ${Number(key.slice(1)) + 1}`;

/**
 * The tray's power-ups for this moment (coach kit PowerUp shape).
 * @param {{ powers: Powers, spent: number, max: number, over: boolean, cursor: string|null, cursorDecoded: boolean, practice?: boolean }} p
 *   cursor: the selected box · cursorDecoded: that box is already known (green before, or revealed)
 */
export function powerUpList({ powers, spent, max, over, cursor, cursorDecoded, practice = false }) {
  const spare = max - spent >= POWER_COST + 1; // keep a transmission to send after it
  const common = (id) => (powers.uses.includes(id) ? 'Used — once per game.' : over ? 'The game is over.' : !spare ? 'Needs a transmission to spare.' : undefined);
  const decodeWhy = common('decode') ?? (!cursor ? 'Tap a box first — Decode reveals only that box.' : cursorDecoded ? 'That box is already decoded — select another.' : undefined);
  return [
    {
      id: 'scan', icon: '📡', name: 'Scan', what: 'Show how many of each sign the signal has.',
      cost: '1 transmission', badge: powers.uses.includes('scan') ? '✓' : '−1', left: powers.uses.includes('scan') ? 0 : 1,
      disabledReason: common('scan'),
    },
    {
      id: 'decode', icon: '🔓', name: 'Decode', what: cursor ? `Turn the selected ${boxName(cursor)} green.` : 'Turn the box you select green.',
      cost: '1 transmission', badge: powers.uses.includes('decode') ? '✓' : '−1', left: powers.uses.includes('decode') ? 0 : 1,
      disabledReason: decodeWhy,
    },
    // Practice only (redesign Q4 = A): give up and see the answer. Never on the Daily.
    ...(practice ? [{
      id: 'answer', icon: '🏳️', name: 'Answer', what: 'Show the answer and end this signal.',
      cost: 'practice only', disabledReason: over ? 'The game is over.' : undefined,
    }] : []),
  ];
}

/**
 * Apply a power-up. Returns the new powers, or null if it can't be used now (same rules as the tray).
 * Decode touches ONE key: the selected box.
 * @param {'scan'|'decode'|'answer'} id
 * @param {{ powers: Powers, answer: { dice: number[], ops: string[] }, spent: number, max: number, over: boolean,
 *   cursor: string|null, cursorDecoded: boolean, practice?: boolean }} p
 * @returns {Powers | null}
 */
export function applyPowerUp(id, p) {
  const item = powerUpList(p).find((x) => x.id === id);
  if (!item || item.disabledReason) return null;
  if (id === 'answer') return { ...p.powers, gaveUp: true }; // practice only (not in the Daily's list)
  if (id === 'scan') return { ...p.powers, uses: [...p.powers.uses, 'scan'], counts: scanCounts(p.answer) };
  const key = /** @type {string} */ (p.cursor);
  return { ...p.powers, uses: [...p.powers.uses, 'decode'], known: { ...p.powers.known, [key]: decodeAt(p.answer, key) } };
}

/** "(1 Scan)" / "(1 Scan, 1 Decode)" for the results and the share text; '' when none. */
export function powerNote(powers) {
  const names = { scan: 'Scan', decode: 'Decode' };
  const used = (powers?.uses ?? []).map((u) => `1 ${names[u] ?? u}`);
  return used.length ? `(${used.join(', ')})` : '';
}
