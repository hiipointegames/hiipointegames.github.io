import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { PrimaryButton, ClickShield } from '../ui';
import { DISPLAY } from '../sectorMath';
import { MAX_GUESSES } from './logic';
import { BOUNTY_STARS, LEGEND, DICE_NOTE, bonusChipText } from './signalInfo';
import ShapeRow, { rowSizes, BRIEF_BUDGET, BRIEF_MAX_WIDTH } from './ShapeRow';
import HowItWorks from '../HowItWorks';
import FirstContactDemo from './FirstContactDemo';
import { NeonDieFace } from '../dice/NeonDie';

// First Contact's pre-decode briefing (overnight 2026-10-11; card redesign audit 2026-10-18, D1).
// SHORT ON PURPOSE (David, 2026-10-14: pre-game screens were "way too crowded"): one caption, the
// shape drawn as the real slots (rounded squares = dice, circles = signs, the real brackets — the
// same ShapeRow the log uses), the dice, the clue and the Bonus. Everything else is one tap away in
// "ⓘ How it works". The clue stays TRUE whatever you send first (./signalInfo.js says why).
// "Practice first" (as Re-Entry) makes the one-attempt Daily less scary: a random practice signal.

export const BRIEF_CAPTION = 'Find the secret way to make 37. Every guess must make 37 too.';
/** The third rule (redesign 2026-10-22): what the colours mean, in the fewest words. */
export const BRIEF_COLOURS = '🟩 right box · 🟨 wrong box · ⬛ not in it';

/** The full rules, behind ⓘ. */
export const howItWorksItems = ({ bounty, practice }) => [
  `📡 Decode the hidden equation in ${MAX_GUESSES} transmissions. It uses the 7 dice shown, once each, in the shape shown: the squares are dice, the circles are signs.`,
  '✅ Every transmission must itself equal 37 — a wrong guess still has to be a real 37. A full row that isn’t 37 is not sent and uses no guess.',
  '✏️ Fill the boxes in any order: tap a box to select it (it glows, with a ▼), then a die or sign goes in there, replacing what is there. ⌫ Clear empties it.',
  '📡 Scan shows how many of each sign the signal has. 🔓 Decode turns the box you selected green. Each costs 1 transmission, once per game.',
  practice ? '🏳️ Practice only: Answer shows the answer and ends the signal.' : null,
  `🟩🟨⬛ ${LEGEND}. Dice and signs are scored separately.`,
  `🎲 ${DICE_NOTE}`,
  '🔁 Same maths in a different order counts as the answer (sums and products can be reordered).',
  `🔎 The clue is always true. Signs: ${['+', '-', '*', '/', '^'].map((o) => DISPLAY[o]).join(' ')}`,
  bounty ? `${bounty.icon} Bonus +${BOUNTY_STARS}★ (optional): ${bounty.text} — ${practice ? 'Daily only, so no ★ in practice' : 'paid when you decode today’s Daily'}.` : null,
];

/**
 * @param {{ label: string, shape: string[], dice: number[], clue: { text: string },
 *   bounty: null | { icon: string, text: string, short: string }, practice: boolean, onStart: () => void,
 *   onLeave?: () => void, onPractice?: () => void, onBackToDaily?: () => void, width?: number, signedOut?: boolean }} props
 *   onPractice: shown on the Daily ("Practice first"); onBackToDaily: shown on practice while today's Daily is unflown.
 *   width: the measured screen width (the shape is sized from it with rowSizes).
 */
export default function SignalBriefing({
  label, shape, dice, clue, bounty, practice, onStart,
  onLeave = undefined, onPractice = undefined, onBackToDaily = undefined, width = globalThis.innerWidth || 400, signedOut = false,
}) {
  const [how, setHow] = useState(false);
  const [demo, setDemo] = useState(false); // the demo plays on request (▶ See how it plays)
  const sizes = rowSizes(shape, Math.min(width, BRIEF_MAX_WIDTH), BRIEF_BUDGET);
  return (
    <div data-testid="fc-briefing" className="absolute inset-0 z-40 grid place-items-center overflow-y-auto bg-black/75 px-4 py-6">
      <ClickShield className="w-full max-w-sm">
        <motion.div initial={{ scale: 0.88, opacity: 0, y: 14 }} animate={{ scale: 1, opacity: 1, y: 0 }} transition={{ type: 'spring', stiffness: 320, damping: 24 }}
          className="rounded-3xl border-2 border-cyan-300/70 bg-[#04121c]/95 p-4 text-center" style={{ boxShadow: '0 0 40px -10px #22d3ee' }}>
          <div className="text-[11px] uppercase tracking-[0.35em] text-cyan-200">📡 Incoming · {label}</div>
          {/* The ~6-s demo (Slice 5b) is one tap away (redesign 2026-10-22: two equations on the card —
              the demo's and today's — looked alike). Holds while How it works covers it. */}
          {demo
            ? <div className="mt-3"><FirstContactDemo paused={how} width={width} /></div>
            : <button type="button" data-testid="fc-brief-demo" onClick={() => setDemo(true)} className="mt-2 rounded-full border border-violet-300/50 px-3 py-1 text-xs font-bold text-violet-100">▶ See how it plays</button>}

          {/* Named, so the real shape + dice are never mistaken for the demo's (review 5b M1). */}
          <div data-testid="fc-brief-shape-label" className="mt-3 text-[11px] font-bold uppercase tracking-[0.25em] text-violet-200">{practice ? 'Your signal' : 'Today’s signal'}</div>
          <div data-testid="fc-brief-shape" className="mt-1"><ShapeRow shape={shape} dice={[]} ops={[]} sizes={sizes} /></div>
          {/* Today's dice drawn as dice (they were the bare digits "1 1 3 4 4 6 6"); the digits stay for screen readers. */}
          <div data-testid="fc-brief-dice" className="mt-2 flex justify-center gap-1.5">
            {dice.map((v, i) => (
              <span key={i} className="inline-flex"><span className="sr-only">{i ? ` ${v}` : v}</span><NeonDieFace value={v} color="white" size={30} /></span>
            ))}
          </div>
          <div data-testid="fc-brief-caption" className="mt-2 text-lg font-black leading-snug text-white">{BRIEF_CAPTION}</div>
          <div data-testid="fc-brief-colours" className="mt-1 text-sm font-bold text-slate-200">{BRIEF_COLOURS}</div>

          <div className="mt-3 flex flex-wrap justify-center gap-1.5 text-xs font-bold">
            <span data-testid="fc-brief-clue" className="rounded-full border border-sky-300/60 bg-sky-950/40 px-2.5 py-1 text-sky-100">🔎 {clue.text}</span>
            {bounty && (
              <span data-testid="fc-brief-bounty" className="rounded-full border border-amber-300/60 bg-amber-500/10 px-2.5 py-1 text-amber-100">
                {bonusChipText(bounty, practice ? 'practice' : 'open', { signedOut })}
              </span>
            )}
          </div>

          <div className="mt-4">
            <PrimaryButton testId="fc-brief-start" tone="cyan" onClick={onStart}>START DECODING 📡</PrimaryButton>
          </div>
          <div className="mt-3 flex flex-wrap justify-center gap-2 text-xs font-bold">
            <button type="button" data-testid="fc-brief-how" onClick={() => setHow(true)} className="rounded-full border border-sky-300/50 px-3 py-1.5 text-sky-100">ⓘ How it works</button>
            {!practice && onPractice && (
              <button type="button" data-testid="fc-brief-practice" onClick={onPractice} className="rounded-full border border-white/25 px-3 py-1.5 text-slate-100">Practice first</button>
            )}
            {practice && onBackToDaily && (
              <button type="button" data-testid="fc-back-to-daily" onClick={onBackToDaily} className="rounded-full border border-amber-300/60 bg-amber-500/10 px-3 py-1.5 text-amber-100">Back to today&apos;s signal</button>
            )}
          </div>
          {onLeave && (
            <button type="button" data-testid="fc-brief-leave" onClick={onLeave} className="mt-3 w-full text-center text-xs text-slate-400 underline">
              Not now — back to orbit
            </button>
          )}
        </motion.div>
      </ClickShield>
      {how && <HowItWorks title="First Contact" testId="fc-how" onClose={() => setHow(false)} items={howItWorksItems({ bounty, practice })} />}
    </div>
  );
}
