// First Contact — the transmission being composed (sweep SW10).
//
// A row is a set of SLOTS (7 dice, 6 operators), so the next row can start with last row's GREEN
// slots already in place (David, 2026-10-05: "carry greens forward" — editable, only a head start).
//
// THE CURSOR (David, 2026-10-22: "you can not select individual boxes to alter their number or
// sign… hard to tell where your cursor is"). One box is selected at a time (`cursor`, a slot key
// like 'd3' / 'o1'; null = the first empty box, and no box at all once the row is full):
//   • tap a box (empty or filled) to select it — a tap never erases;
//   • a die goes INTO the selected box, replacing what is there; a sign likewise. A key of the other
//     kind goes to the next box of ITS kind after the cursor (redesign Q2 = A);
//   • a die already used elsewhere in this row MOVES to the selected box;
//   • then the cursor jumps to the next empty box (wrapping), or to no box when the row is full;
//   • ⌫ Clear empties the selected box, or steps back to the box before it when it is empty.
//
// Pure: the screen holds a row in state and calls these.

import { evaluateTokens } from '../sectorMath';

/**
 * @typedef {{ dice: (number|null)[], ops: (string|null)[], board: (number|null)[],
 *   history: string[], carried: string[], cursor: string|null }} Row
 * dice/ops: values per slot · board: which board die fills each dice slot · history: placement
 * order as slot keys ('d3', 'o1'), newest last · carried: the keys still holding a green carried
 * from the last row (not placed by the player; a cleared or replaced slot leaves the list) ·
 * cursor: the selected box (null = the first empty one).
 */

/** @returns {Row} */
export const emptyRow = () => ({ dice: Array(7).fill(null), ops: Array(6).fill(null), board: Array(7).fill(null), history: [], carried: [], cursor: null });

/** Shape cells that hold a piece, in order: [{ c: 'D'|'O', slot, k }] (k = index in the shape). */
export function slotsOf(shape) {
  let d = 0; let o = 0;
  const out = [];
  shape.forEach((c, k) => {
    if (c === 'D') out.push({ c, slot: d++, k });
    else if (c === 'O') out.push({ c, slot: o++, k });
  });
  return out;
}

/** Index of the first empty slot of one kind (dice or ops, in shape order), or -1 when that kind is full. */
const firstEmpty = (cells) => cells.findIndex((v) => v == null);
/** Is there an empty slot of this kind ('D' die / 'O' sign)? */
export const hasEmpty = (row, kind) => firstEmpty(kind === 'D' ? row.dice : row.ops) >= 0;

export const filledCount = (row) => row.dice.filter((v) => v != null).length + row.ops.filter((v) => v != null).length;
export const isComplete = (row) => filledCount(row) === 13;

/** The slot keys in shape (reading) order: ['d0', 'o0', 'd1', …]. */
export const keysOf = (shape) => slotsOf(shape).map(({ c, slot }) => `${c === 'D' ? 'd' : 'o'}${slot}`);
/** Is this slot filled? */
export const isFilled = (row, key) => (key[0] === 'd' ? row.dice : row.ops)[Number(key.slice(1))] != null;

/** The first empty box in reading order, or null when the row is full. */
export function firstEmptyKey(shape, row) {
  return keysOf(shape).find((k) => !isFilled(row, k)) ?? null;
}

/** The selected box: the row's cursor, else the first empty box, else null (the row is full). */
export function cursorOf(shape, row) {
  const keys = keysOf(shape);
  if (row.cursor && keys.includes(row.cursor)) return row.cursor;
  return firstEmptyKey(shape, row);
}

/** Select a box (tap). A tap never erases. */
export function selectSlot(shape, row, key) {
  return keysOf(shape).includes(key) ? { ...row, cursor: key } : row;
}

/** The next empty box after `key` in reading order (wrapping), or null when the row is full. */
function nextEmptyAfter(shape, row, key) {
  const keys = keysOf(shape);
  const at = keys.indexOf(key);
  for (let n = 1; n <= keys.length; n++) {
    const k = keys[(at + n) % keys.length];
    if (!isFilled(row, k)) return k;
  }
  return null;
}

/**
 * Where a key of `kind` ('d' die / 'o' sign) lands: the selected box if it is that kind, else the
 * next EMPTY box of that kind after it (wrapping) — so several dice typed while a sign box is
 * selected fill several boxes — else the next box of that kind. Null when no box is selected (a
 * full row: tap one first).
 */
export function targetFor(shape, row, kind) {
  const cur = cursorOf(shape, row);
  if (!cur) return null;
  if (cur[0] === kind) return cur;
  const keys = keysOf(shape);
  const at = keys.indexOf(cur);
  const after = Array.from({ length: keys.length - 1 }, (_, n) => keys[(at + n + 1) % keys.length]).filter((k) => k[0] === kind);
  return after.find((k) => !isFilled(row, k)) ?? after[0] ?? null;
}

/**
 * Put a piece in a slot (replacing what is there) and move the cursor on. If the key landed AWAY
 * from the selected box `stay` (a key of the other kind) and that box is still empty, it stays selected.
 */
function put(shape, row, key, value, boardIdx = null, stay = null) {
  const slot = Number(key.slice(1));
  const history = [...row.history.filter((h) => h !== key), key];
  const carried = (row.carried || []).filter((h) => h !== key); // now the player's piece
  let next;
  if (key[0] === 'd') {
    const dice = [...row.dice]; const board = [...row.board];
    dice[slot] = value; board[slot] = boardIdx;
    next = { ...row, dice, board, history, carried };
  } else {
    const ops = [...row.ops];
    ops[slot] = value;
    next = { ...row, ops, history, carried };
  }
  if (stay && stay !== key && !isFilled(next, stay)) return { ...next, cursor: stay };
  return { ...next, cursor: nextEmptyAfter(shape, next, key) };
}

/**
 * Place a board die at the cursor (see targetFor). A die already in this row moves here (its old
 * box empties); a die replaced here goes back to the tray.
 */
export function placeDie(shape, row, boardIdx, boardDice) {
  const key = targetFor(shape, row, 'd');
  if (!key) return row;
  const from = row.board.indexOf(boardIdx);
  if (from === Number(key.slice(1))) return { ...row, cursor: nextEmptyAfter(shape, row, key) }; // already there
  const base = from >= 0 ? clearSlot(row, `d${from}`) : row;
  return put(shape, base, key, boardDice[boardIdx], boardIdx, cursorOf(shape, row));
}

/** Place a sign at the cursor (see targetFor), replacing what is there. */
export function placeOp(shape, row, op) {
  const key = targetFor(shape, row, 'o');
  return key ? put(shape, row, key, op, null, cursorOf(shape, row)) : row;
}

/**
 * ⌫ Clear: empty the selected box; if it is already empty (or the row is full and no box is
 * selected), step back to the nearest filled box before it, empty that, and select it.
 */
export function backspace(shape, row) {
  const keys = keysOf(shape);
  const cur = cursorOf(shape, row);
  if (cur && isFilled(row, cur)) return { ...clearSlot(row, cur), cursor: cur };
  const end = cur ? keys.indexOf(cur) : keys.length;
  for (let i = end - 1; i >= 0; i--) {
    if (isFilled(row, keys[i])) return { ...clearSlot(row, keys[i]), cursor: keys[i] };
  }
  return row;
}

/**
 * Put a known piece (a power-up's reveal) into a slot of this row: a die takes a free board die of
 * that value, or moves one already in the row. Kept as a carried (pre-filled, editable) piece.
 */
export function placeKnown(shape, row, key, value, boardDice) {
  if (key[0] === 'o') {
    const r = put(shape, row, key, value);
    return { ...r, carried: [...(r.carried || []), key] };
  }
  const slot = Number(key.slice(1));
  if (row.dice[slot] === value) return { ...row, carried: [...new Set([...(row.carried || []), key])] };
  let idx = boardDice.findIndex((v, i) => v === value && !row.board.includes(i));
  let base = row;
  if (idx < 0) { // every copy is in the row: move one (not one in this slot)
    const at = row.board.findIndex((b, s) => b != null && boardDice[b] === value && s !== slot);
    if (at < 0) return row;
    idx = row.board[at];
    base = clearSlot(row, `d${at}`);
  }
  const r = put(shape, base, key, value, idx);
  return { ...r, carried: [...(r.carried || []), key] };
}

/**
 * Empty one slot ('d3', 'o1'), wherever it is (the cursor is not moved; backspace does that).
 */
export function clearSlot(row, key) {
  if (!row.history.includes(key)) return row;
  const slot = Number(key.slice(1));
  const history = row.history.filter((h) => h !== key);
  const carried = (row.carried || []).filter((h) => h !== key); // refilled later = the player's piece
  if (key[0] === 'd') {
    const dice = [...row.dice]; const board = [...row.board];
    dice[slot] = null; board[slot] = null;
    return { ...row, dice, board, history, carried };
  }
  const ops = [...row.ops];
  ops[slot] = null;
  return { ...row, ops, history, carried };
}

/**
 * A new row with last guess's GREEN slots pre-filled, plus any `known` slots (a power-up's
 * reveal: { d3: 4, o1: '*' }). Each die takes a free board die of that value (any copy — they are
 * interchangeable). The cursor starts on the first empty box.
 * @param {{ dice: number[], ops: string[], fb: { dice: string[], ops: string[] } } | null} guess
 * @param {number[]} boardDice
 * @param {Record<string, number|string>} [known]
 */
export function carryGreens(guess, boardDice, known = {}) {
  const dice = Array(7).fill(null); const board = Array(7).fill(null); const ops = Array(6).fill(null); const history = [];
  const want = { ...known };
  if (guess) {
    guess.fb.dice.forEach((state, slot) => { if (state === 'green') want[`d${slot}`] = guess.dice[slot]; });
    guess.fb.ops.forEach((state, slot) => { if (state === 'green') want[`o${slot}`] = guess.ops[slot]; });
  }
  for (const [key, value] of Object.entries(want)) {
    const slot = Number(key.slice(1));
    if (key[0] === 'd') {
      const idx = boardDice.findIndex((v, i) => v === value && !board.includes(i));
      if (idx < 0) continue;
      dice[slot] = /** @type {number} */ (value); board[slot] = idx;
    } else {
      ops[slot] = /** @type {string} */ (value);
    }
    history.push(key);
  }
  return { dice, ops, board, history, carried: [...history], cursor: null };
}

/** The finished guess ({ dice, ops } arrays) for checking. */
export const toGuess = (row) => ({ dice: [...row.dice], ops: [...row.ops] });

/**
 * Live total while composing (David: "≈ 41 · needs 37"): the filled run of slots from the start
 * of the shape up to the first empty slot. Hidden (null) only when a piece the PLAYER placed sits
 * after an empty slot (audit 2026-10-18 — with free-order filling, "all 7 dice first" would
 * otherwise read "so far <first die>"). Carried greens further along do not hide it (slice-3
 * review M1: they did, on ~75% of mid-row steps). Trailing operators / open brackets are dropped
 * and unclosed brackets are closed. Null too when nothing evaluable is there yet.
 */
export function partialTotal(shape, row) {
  /** @type {Array<{t:'die',i:number}|{t:'op',v:string}>} */
  const tokens = [];
  const carried = row.carried || [];
  let d = 0; let o = 0;
  let gap = false; // passed an empty slot
  for (const cell of shape) {
    if (cell === 'D' || cell === 'O') {
      const isDie = cell === 'D';
      const value = isDie ? row.dice[d] : row.ops[o];
      const key = isDie ? `d${d}` : `o${o}`;
      if (value == null) gap = true;
      else if (gap) { if (!carried.includes(key)) return null; } // the player's piece past a hole
      else tokens.push(isDie ? { t: 'die', i: d } : { t: 'op', v: /** @type {string} */ (value) });
      if (isDie) d++; else o++;
    } else if (!gap) {
      tokens.push({ t: 'op', v: cell });
    }
  }
  // Trim to something evaluable: no trailing binary operator or '('.
  for (;;) {
    const last = tokens[tokens.length - 1];
    if (!last || last.t !== 'op' || last.v === ')') break;
    tokens.pop();
  }
  let open = 0;
  for (const t of tokens) if (t.t === 'op') open += t.v === '(' ? 1 : t.v === ')' ? -1 : 0;
  for (; open > 0; open--) tokens.push({ t: 'op', v: ')' });
  if (!tokens.some((t) => t.t === 'die')) return null;
  const r = evaluateTokens(tokens, row.dice.map((v) => v ?? 0));
  return r.ok ? r.value : null;
}
