// First Contact — every day about as hard as the next (contrarian review 2026-10-14).
//
// A guess wins if it is the SAME MATHS as the hidden equation (sums and products reordered, see
// ./equivalence.js), and the answer is re-aligned to your first guess. So a signal whose answer can
// be written in many equivalent dice orders is far easier than one with a single rigid order.
// Measured over 60 Daily seeds (first-contact-2026-11-01..60, sameMathsCount on the unfiltered
// generator): 1 to 240 equivalent orders, median 6, middle 80% 2-24.
// The generator now only keeps signals inside SAME_MATHS_BAND (the middle of that spread; ~63% of
// raw signals qualify, ~10 ms to check each), so no Daily is a free gift or a brick wall.

import { generateSignal } from './logic';
import { canonicalOf } from './equivalence';

export const SAME_MATHS_BAND = Object.freeze([3, 12]);

/** Distinct orderings of a list (duplicates collapsed). */
function orderings(values) {
  const seen = new Set(); const out = [];
  const rec = (acc, rest) => {
    if (!rest.length) { const k = acc.join(','); if (!seen.has(k)) { seen.add(k); out.push(acc); } return; }
    rest.forEach((x, i) => { if (rest.indexOf(x) === i) rec([...acc, x], [...rest.slice(0, i), ...rest.slice(i + 1)]); });
  };
  rec([], values);
  return out;
}

/** How many dice orders (same operators) are the same maths as the signal's answer. */
export function sameMathsCount(sig) {
  const want = canonicalOf(sig.shape, sig.secret.dice, sig.secret.ops);
  let n = 0;
  for (const order of orderings(sig.secret.dice)) if (canonicalOf(sig.shape, order, sig.secret.ops) === want) n++;
  return n;
}

export const inFairBand = (sig) => {
  const n = sameMathsCount(sig);
  return n >= SAME_MATHS_BAND[0] && n <= SAME_MATHS_BAND[1];
};

/** The signal the game plays: like generateSignal, but always inside the fair band. */
export const generateFairSignal = (seed) => generateSignal(seed, { accept: inFairBand });
