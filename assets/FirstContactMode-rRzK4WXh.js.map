import React, { useMemo, useState, useRef, useEffect } from 'react';
import { motion } from 'framer-motion';
import { ModeHeader, ShareButton } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { useFx, runTimeline } from '../../fx';

// "Signal Decoded" (sweep SW14b; storyboard juice.md §3.2): a transmitted row's tiles flip over
// one by one (Wordle); on a win the alien glyphs lock into the real equation left to right and
// radio rings pulse out. The row itself + its sizing live in ./ShapeRow.jsx (audit 2026-10-19).
import ShapeRow, { FLIP_STAGGER_MS, FLIP_MS, rowSizes, traySizes, useMeasuredWidth, LOG_BUDGET, LOSS_BUDGET, STRIP_BUDGET } from './ShapeRow';
export { FLIP_STAGGER_MS, FLIP_MS, rowSizes };
export const decodeAtMs = (pieces = 13) => pieces * FLIP_STAGGER_MS + FLIP_MS;
import { DISPLAY } from '../sectorMath';
import { playSynth } from '../../synth';
import { recordBest } from '../bests';
import { todayEastern, randomSeed, dayBefore } from '../rng';
import { SECTOR_URL } from '../share';
import { isEquivalent, buttonMemory, alignSecret } from './equivalence';
import { emptyRow, filledCount, placeDie, placeOp, backspace, selectSlot, cursorOf, targetFor, carryGreens, placeKnown, toGuess, partialTotal } from './row';
import { noPowers, spentOf, powerUpList, applyPowerUp, powerNote } from './powerUps';
import { NeonDieFace } from '../dice/NeonDie';
import SignalBriefing, { howItWorksItems } from './SignalBriefing';
import FcControls, { TransmissionDots } from './FcControls';
import HowItWorks from '../HowItWorks';
import { DailyChip, PracticeChip, useStuckTimer } from '../coach';
import { stuckTip } from './tips';
import { clueFor, bountyFor, bountyById, bountyMet, bonusState, bonusChipText, BOUNTY_STARS } from './signalInfo';
import { earnStars } from '../stars';
import { startDaily, finishDaily } from '../dailyRuns';
import { beforeDailyAttempt } from '../dailyAd';
import DailyBoard, { DailyPlace } from '../DailyBoard';

// The Daily is saved as you play, so leaving and coming back resumes it (or shows the result)
// instead of dealing a fresh attempt at the same signal (overnight audit 2026-10-11).
const DAILY_KEY = 'sector73.firstContact.daily';
export const dailySeedFor = (date) => `first-contact-${date}`;
const isPracticeSeed = (s) => s.startsWith('first-contact-practice-');
function loadDaily(seed) {
  try {
    const s = JSON.parse(globalThis.localStorage?.getItem(DAILY_KEY) ?? 'null');
    return s && s.seed === seed && Array.isArray(s.guesses) ? s : null;
  } catch {
    return null;
  }
}
const writeDaily = (s) => { try { globalThis.localStorage?.setItem(DAILY_KEY, JSON.stringify(s)); } catch { /* storage blocked: the Daily just won't resume */ } };
// A save only counts as an attempt once START was pressed (older builds saved an unstarted briefing).
const began = (s) => Boolean(s && s.status !== 'elsewhere' && (s.briefed || s.guesses.length));
export { dayBefore }; // (lives in ../rng.js, shared with Star Chart's Daily)
// The Daily to open at mount: today's, unless yesterday's was started and not finished — a Daily
// begun at 23:55 and reopened at 00:05 resumes as yesterday's (the server still takes yesterday's
// finish, sector73_daily_finish `day >= today - 1`). Anything older: today's briefing (audit 2026-10-18).
function openingSeed(today) {
  const y = loadDaily(dailySeedFor(dayBefore(today)));
  const last = y?.guesses[y.guesses.length - 1];
  const finished = Boolean(y) && ((last && isSolved(last.fb)) || spentOf(y.guesses, y.powers) >= MAX_GUESSES);
  return began(y) && !finished ? dailySeedFor(dayBefore(today)) : dailySeedFor(today);
}
// TRANSMIT waits at most this long for the server's claim (audit 2026-10-18: a slow network must not lock it).
export const CLAIM_WAIT_MS = 4000;
/**
 * A total (or a gap) for display: whole numbers as they are, others to 2 places — but never so
 * rounded that a not-37 reads "37.00" (or its gap "0.00"): near 37 / near 0 it takes up to 6 places
 * (slice-3 review m1: real rows hit 37.0039, which isThirtySeven rightly refuses).
 * @param {number} n
 */
export const fmt = (n) => {
  if (Number.isInteger(n)) return n;
  for (let k = 2; k < 6; k++) {
    const s = n.toFixed(k);
    if (Number(s) !== 37 && Number(s) !== 0) return s;
  }
  return n.toFixed(6);
};

/** The live line under the log: how far the row is from 37 (overnight 2026-10-11: "N to go"). */
export function soFarText(total, full) {
  const gap = Math.abs(total - 37);
  if (full) return isThirtySeven(total) ? '= 37 ✓ ready to transmit' : `= ${fmt(total)} · ${fmt(gap)} too ${total > 37 ? 'high' : 'low'}`;
  return isThirtySeven(total) ? `so far 37 · on target` : `so far ${fmt(total)} · ${fmt(gap)} ${total < 37 ? 'to go' : 'past 37'}`;
}
/** The line when there is no total to show: a hole in the row, or nothing placed yet (design D4). */
export const FILL_HINT = 'Fill the slots — the total shows here';
/** A full row that makes 37 (the slot's green "good" tone adds the ✓). */
export const READY_TEXT = '= 37 · ready to transmit';
/** A full row that doesn't work out (÷ by 0): there is no total, so say so instead of FILL_HINT. */
export const NO_TOTAL = 'That doesn’t work out — change a sign or a die';
const NO_GUESS = 'every guess must make 37 (no guess used)';
/**
 * Why a full row was not sent (design D2). It costs nothing — no guess used, no fail sound, no
 * shake — so it is said plainly, not as an error.
 * @param {{ reason?: string, value?: number }} verdict from checkGuess
 */
export const refusalText = (verdict) => (verdict.reason === 'not37'
  ? `Makes ${fmt(verdict.value)} — ${NO_GUESS}`
  : `That doesn’t work out — ${NO_GUESS}`);


// The Bonus chip's look per state (design D7): gold while it can be had (a met ÷/^ goal too: it is
// paid only on the decode), green once decoded and paid, grey when missed, faint grey on practice.
const BONUS_CHIP = {
  track: 'border-amber-300/70 bg-amber-500/10 text-amber-100',
  open: 'border-amber-300/70 bg-amber-500/10 text-amber-100',
  done: 'border-amber-300/70 bg-amber-500/10 text-amber-100',
  won: 'border-emerald-300/70 text-emerald-100',
  missed: 'border-slate-600 text-slate-500',
  practice: 'border-slate-700 text-slate-500 opacity-70',
};
import {
  checkGuess, scoreGuess, isSolved, shareGrid, isThirtySeven, MAX_GUESSES, GLYPHS,
} from './logic';
import { generateFairSignal } from './fairness';

// First Contact — decode the alien signal. See ./logic.js for the rules.

/**
 * First Contact. "Back to today's signal" (after Practice first, design D1) remounts the run, so the
 * Daily is opened exactly as on entry — its save re-read, its briefing START running the ad + claim.
 */
/**
 * The launch contract (world framework §D): openMode('firstContact', { entry: 'daily' | 'practice' }).
 * The world shows a Practice object for this game only when its mode exports ACCEPTS_ENTRY.
 *   'daily'    — today's Daily briefing (ad + claim at START), or its result / the "done" card
 *   'practice' — a practice signal: never the Daily, never a claim, never an ad
 *   no params  — as before (the Daily).
 */
export const ACCEPTS_ENTRY = true;

/** @param {{ onExit: () => void, onReturnTo37: () => void, user?: any, params?: { entry?: string } | null }} props */
export default function FirstContactMode({ onExit, onReturnTo37, user = undefined, params = null }) {
  const [visit, setVisit] = useState(0);
  // "Back to today's signal" opens the Daily, even from a Practice launch.
  const [entry, setEntry] = useState(params?.entry === 'practice' ? 'practice' : 'daily');
  return <FirstContactRun key={visit} onExit={onExit} onReturnTo37={onReturnTo37} user={user} entry={entry} onBackToDaily={() => { setEntry('daily'); setVisit((n) => n + 1); }} />;
}

const practiceSeed = () => `first-contact-practice-${randomSeed()}`;

function FirstContactRun({ onExit, onReturnTo37, user = undefined, onBackToDaily, entry = 'daily' }) {
  // MIDNIGHT-SAFE (audit 2026-10-18): the Daily is pinned to its date + seed at START (or when a
  // started Daily is resumed), so a signal decoded across midnight still saves and posts as its own
  // day. Before START the briefing's seed says which day it was dealt for; practice never pins.
  const [seed, setSeed] = useState(() => (entry === 'practice' ? practiceSeed() : openingSeed(todayEastern())));
  const [saved] = useState(() => loadDaily(seed)); // the phone's own record of today's Daily
  const [pin, setPin] = useState(() => (began(saved) ? { date: seed.slice('first-contact-'.length), seed } : null));
  const isDaily = pin ? seed === pin.seed : !isPracticeSeed(seed);
  const today = pin?.date ?? (isPracticeSeed(seed) ? todayEastern() : seed.slice('first-contact-'.length)); // the Daily's day
  const signal = useMemo(() => generateFairSignal(seed), [seed]); // every day equally hard (./fairness.js)

  const resumed = began(saved) ? saved : null;
  const [guesses, setGuesses] = useState(() => resumed?.guesses ?? []); // [{ dice, ops, fb }]
  const [aligned, setAligned] = useState(() => resumed?.aligned ?? null); // the hidden answer, lined up with the guesses
  // Power-ups used (powerUps.js): each costs a transmission; Scan counts + Decoded boxes are facts from then on.
  const [powers, setPowers] = useState(() => resumed?.powers ?? noPowers());
  // (Older saves also carry a `rejects` count: it is ignored — a refused row costs nothing, design D2.)
  const [briefed, setBriefed] = useState(() => Boolean(resumed));
  const [celebrate, setCelebrate] = useState(0); // bumps when the win sequence fires
  const [recorded, setRecorded] = useState(0); // bumps when the server has today's result (board refresh)
  // This account already took today's Daily. Remembered in the save, so a revisit shows the card at
  // once — no second ad, no second claim (audit 2026-10-18).
  const [usedElsewhere, setUsedElsewhere] = useState(() => saved?.status === 'elsewhere');
  // This visit learned today's Daily is taken (memory too: storage may be blocked), so practice
  // never offers "Back to today's signal" for it.
  const [dailyGone, setDailyGone] = useState(false);
  // The server claim made at START: none (no claim this visit / offline) | pending | ok. Only
  // pending holds TRANSMIT back, and only for CLAIM_WAIT_MS (audit 2026-10-18).
  const [claim, setClaim] = useState(/** @type {'none'|'pending'|'ok'} */ ('none'));
  useEffect(() => {
    if (claim !== 'pending') return undefined;
    const id = setTimeout(() => setClaim((c) => (c === 'pending' ? 'none' : c)), CLAIM_WAIT_MS);
    return () => clearTimeout(id);
  }, [claim]);
  const [boardOpen, setBoardOpen] = useState(false);
  // What the player is doing NOW, for answers that arrive late (a claim after the 4-s give-up).
  const live = useRef({ seed, sent: 0 });
  useEffect(() => { live.current = { seed, sent: guesses.length }; }, [seed, guesses]);
  // How this visit's Daily result went (Re-Entry's opt-in place states, design D8). null = nothing sent
  // THIS visit (a revisit of a finished Daily): the place line then keeps the plain board button, since
  // "Sending…" would never end and "on the board" isn't known.
  const [sent, setSent] = useState(/** @type {'pending'|'posted'|'queued'|'dropped'|null} */ (null));
  const recordDaily = (score) => {
    setSent('pending');
    finishDaily('firstContact', score).then((how) => { setSent(how); setRecorded((n) => n + 1); });
  };

  /** A briefing dealt before midnight: deal `date`'s Daily briefing instead (or its card, if taken). */
  const restartForDay = (date) => {
    const next = dailySeedFor(date);
    const local = loadDaily(next);
    setSeed(next); setPin(null); setClaim('none');
    setGuesses([]); setAligned(null); setBriefed(false); setPowers(noPowers());
    setResult(null); setCelebrate(0); setCur(emptyRow()); setMessage(null); setSent(null);
    setUsedElsewhere(local?.status === 'elsewhere' || began(local));
  };
  // START on today's Daily claims the attempt on the server: one per ACCOUNT, so a second phone or
  // cleared app data cannot decode the same signal again. Offline, the phone's own save still rules.
  const beginBriefed = () => {
    // START re-reads the date: a briefing left open across midnight opens the NEW day's signal
    // instead of starting (and claiming) yesterday's.
    if (!pin && !isPracticeSeed(seed) && seed !== dailySeedFor(todayEastern())) { restartForDay(todayEastern()); return; }
    if (!isDaily) { setBriefed(true); return; } // practice: no ad
    const local = loadDaily(seed); // the phone's own record first: no ad for a Daily already taken
    if (local?.status === 'elsewhere' || began(local)) { setUsedElsewhere(true); setDailyGone(true); return; }
    beforeDailyAttempt(() => { // the Daily ad first
      const now = todayEastern(); // midnight can pass while the ad is up
      if (seed !== dailySeedFor(now)) { restartForDay(now); return; }
      setPin({ date: now, seed });
      setBriefed(true);
      setClaim('pending');
      startDaily('firstContact').then((c) => {
        // Moved on (practice, or rows already sent after the give-up): a late "used" changes nothing —
        // no card over practice, no wiping a Daily already played (contrarian 2026-10-18).
        if (live.current.seed !== seed || live.current.sent > 0) { setClaim((s) => (s === 'pending' ? 'none' : s)); return; }
        if (!c?.used) { setClaim((s) => (s === 'pending' ? (c ? 'ok' : 'none') : s)); return; }
        writeDaily({ seed, status: 'elsewhere', guesses: [], aligned: null, briefed: false });
        setUsedElsewhere(true); setDailyGone(true); setClaim('none');
      });
    });
  };
  const [result, setResult] = useState(null); // { newBest, stars } from the win just played
  const answer = aligned || signal.secret;
  const [cur, setCur] = useState(() => {
    const last = resumed?.guesses?.[resumed.guesses.length - 1];
    return last && !isSolved(last.fb) ? carryGreens(last, signal.dice, resumed?.powers?.known) : carryGreens(null, signal.dice, resumed?.powers?.known);
  }); // the row being composed (./row.js)
  const [message, setMessage] = useState(null);
  const solved = guesses.length > 0 && isSolved(guesses[guesses.length - 1].fb);
  const spent = spentOf(guesses, powers); // rows sent + power-ups (each costs a transmission)
  // Practice can also be given up (🏳️ Answer, Q4 = A); a Daily never can.
  const over = solved || spent >= MAX_GUESSES || (!isDaily && Boolean(powers.gaveUp));
  // Every row is sized from the measured screen, per shape (audit 2026-10-19: no surface overflows at 320-384 px).
  const rootRef = useRef(null);
  const screenWidth = useMeasuredWidth(rootRef);
  const sizes = useMemo(() => rowSizes(signal.shape, screenWidth, LOG_BUDGET), [signal.shape, screenWidth]);
  const lossSizes = useMemo(() => rowSizes(signal.shape, screenWidth, LOSS_BUDGET), [signal.shape, screenWidth]);
  const strip = useMemo(() => rowSizes(signal.shape, screenWidth, STRIP_BUDGET), [signal.shape, screenWidth]);
  const tray = useMemo(() => traySizes(screenWidth), [screenWidth]);

  const clue = useMemo(() => clueFor(seed, signal.secret), [seed, signal]);
  const bountyId = useMemo(() => bountyFor(seed, signal.secret), [seed, signal]);
  const bountyInfo = bountyById(bountyId);

  // Only the pinned (started) Daily is saved: an unstarted briefing or practice never touches
  // DAILY_KEY, and an 'elsewhere' record is never overwritten (audit 2026-10-18).
  useEffect(() => {
    if (!pin || seed !== pin.seed || usedElsewhere) return;
    writeDaily({ seed, guesses, aligned, briefed, powers });
  }, [pin, seed, usedElsewhere, guesses, aligned, briefed, powers]);

  // No turn-taking (design D4): a die goes in the first empty die slot, a sign in the first empty
  // sign slot, in any order. The total shows only while the filled slots are a prefix of the row.
  const filled = filledCount(cur);
  const soFar = filled ? partialTotal(signal.shape, cur) : null;
  const readyToSend = filled === 13 && isThirtySeven(soFar);

  // Slots decoded (green at least once) reveal their true symbol in the signal strip.
  // Button colour memory (Wordle keyboard): best state per die value / operator so far.
  const memory = useMemo(() => buttonMemory(guesses), [guesses]);
  const fx = useFx();
  const stripRef = useRef(null);
  // A decoded slot locks in after its row has flipped; on a win they lock left to right.
  const lockIn = (k) => ({
    initial: { opacity: 0, scale: 1.7 },
    animate: { opacity: 1, scale: 1 },
    transition: { delay: (decodeAtMs() + (solved ? k * 45 : 0)) / 1000, type: 'spring', stiffness: 500, damping: 22 },
  });

  const decoded = useMemo(() => {
    const dice = Array(7).fill(false); const ops = Array(6).fill(false);
    guesses.forEach(({ fb }) => {
      fb.dice.forEach((c, i) => { if (c === 'green') dice[i] = true; });
      fb.ops.forEach((c, i) => { if (c === 'green') ops[i] = true; });
    });
    for (const key of Object.keys(powers.known)) (key[0] === 'd' ? dice : ops)[Number(key.slice(1))] = true; // 🔓 Decoded
    return { dice, ops };
  }, [guesses, powers]);

  // The cursor (David, 2026-10-22): a key fills the SELECTED box (row.js). A full row has no box
  // selected, so keys wait until you tap one.
  const cursor = over ? null : cursorOf(signal.shape, cur);
  const isDecodedKey = (key) => (key[0] === 'd' ? decoded.dice : decoded.ops)[Number(key.slice(1))];
  // The power-up tray (Q1 = A): each costs a transmission, once per game, Daily and practice alike.
  const powerCtx = { powers, answer, spent, max: MAX_GUESSES, over, cursor, cursorDecoded: Boolean(cursor && isDecodedKey(cursor)), practice: !isDaily };
  const powerUps = powerUpList(powerCtx);
  const onPowerUp = (id) => {
    const next = applyPowerUp(id, powerCtx);
    if (!next) return;
    if (id === 'answer') { setPowers(next); setMessage(null); return; } // practice: show the answer, end the signal
    playSynth('dock');
    setMessage(null);
    setAligned(answer); // pin the answer it read: what it showed is a fact from now on (alignSecret keeps it)
    setPowers(next);
    if (id === 'decode') setCur((c) => placeKnown(signal.shape, c, /** @type {string} */ (cursor), next.known[/** @type {string} */ (cursor)], signal.dice));
  };
  // The middle scrolls (rows grow to 6), so bring the row being built into view after each send.
  const scrollRef = useRef(null);
  const curRowRef = useRef(null);
  useEffect(() => { curRowRef.current?.scrollIntoView?.({ block: 'nearest' }); }, [guesses.length]);
  const [helpOpen, setHelpOpen] = useState(false); // ⓘ the colours / rules, from the chip under the dots
  // The ONE stuck tip (framework §B1.3): after 30 s with no change, or 2 refused rows in a row.
  const [refusals, setRefusals] = useState(0);
  const progressKey = `${guesses.length}|${cur.dice.join()}|${cur.ops.join()}`;
  const { stuck, dismiss: dismissTip } = useStuckTimer({ progressKey, refusals, active: briefed && !over && !usedElsewhere });
  const tipText = useMemo(() => (stuck ? stuckTip({
    shape: signal.shape, boardDice: signal.dice, guesses, row: cur, clue, secret: signal.secret, answer,
    daily: isDaily, refusals, rowMakes37: readyToSend, seed,
  }) : null), [stuck, progressKey, refusals]); // eslint-disable-line react-hooks/exhaustive-deps -- recomputed per board state
  // The one message line (coach kit TipSlot): a refusal, else the stuck tip, else "ready", else the live total.
  const lineMessages = {
    refusal: message,
    tip: tipText,
    good: readyToSend ? READY_TEXT : null,
    coach: soFar != null ? soFarText(soFar, filled === 13) : filled === 13 ? NO_TOTAL : FILL_HINT,
  };
  const tapDie = (boardIdx) => {
    if (over || !targetFor(signal.shape, cur, 'd')) return; // (SpaceDie plays its own blip)
    setMessage(null);
    setCur((c) => placeDie(signal.shape, c, boardIdx, signal.dice));
  };
  const tapOp = (op) => {
    if (over || !targetFor(signal.shape, cur, 'o')) return;
    playSynth('blip');
    setMessage(null);
    setCur((c) => placeOp(signal.shape, c, op));
  };
  const del = () => {
    setMessage(null);
    setCur((c) => backspace(signal.shape, c));
  };
  const selectAt = (key) => {
    if (over) return;
    setCur((c) => selectSlot(signal.shape, c, key));
  };

  // The Daily's TRANSMIT waits for the server claim while it is in flight, so a row cannot post
  // (and pay ★) for an attempt the server is about to refuse (audit 2026-10-18).
  const claimWait = isDaily && claim === 'pending';
  const transmit = () => {
    if (claimWait || usedElsewhere) return;
    const guess = toGuess(cur);
    const verdict = checkGuess(signal.shape, signal.dice, guess);
    if (!verdict.ok) {
      // TRANSMIT lights on a full row (David's Hyperjump rule, design D2). A row that isn't 37 is
      // not sent and costs nothing: a plain line, no fail sound, no shake. It shows in the "so far"
      // line, so nothing below it moves.
      setMessage(refusalText(verdict));
      setRefusals((n) => n + 1); // two in a row → the stuck tip
      return;
    }
    setRefusals(0);
    // "Same maths, any order" wins outright (design decision 1): an equivalent guess
    // reads as all-green even if its terms are in a different order.
    // Line the hidden answer up with THIS guess, among the answers that agree with every colour
    // already shown (redesign 2026-10-22; see alignSecret), so earlier colours never change.
    const secret = alignSecret(signal.shape, guess, aligned ?? signal.secret, { history: guesses, known: powers.known, counts: powers.counts });
    setAligned(secret);
    const fb = isEquivalent(signal.shape, guess, secret)
      ? { dice: guess.dice.map(() => 'green'), ops: guess.ops.map(() => 'green') }
      : scoreGuess(guess, secret);
    const entry = { dice: guess.dice, ops: guess.ops, fb };
    const nextGuesses = [...guesses, entry];
    setGuesses(nextGuesses);
    // Carry this row's greens into the next one (editable head start).
    setCur(isSolved(fb) ? emptyRow() : carryGreens(entry, signal.dice, powers.known));
    const spentNow = spentOf(nextGuesses, powers); // a power-up costs a transmission, on the board too
    if (isSolved(fb)) {
      // Only the Daily counts toward your best and pays ★; practice is for practice (audit
      // 2026-10-11: a lucky practice signal set the "best decode" on the docking card).
      const newBest = isDaily && recordBest('firstContact', spentNow);
      const stars = isDaily && bountyMet(bountyId, { guesses: nextGuesses, spent: spentNow }) ? BOUNTY_STARS : null;
      if (stars) earnStars('fc_bounty', seed); // paid by the server (★ on the account)
      if (isDaily) recordDaily({ transmissions: spentNow, solved: true });
      setResult({ newBest, stars });
      // After the flips: the win cue, then radio rings pulse out of the decoded signal.
      const at = decodeAtMs(fb.dice.length + fb.ops.length);
      runTimeline([
        // The win (David, S21 2026-10-10: "not awarded with enough juice"): flash + wave + title,
        // 37-confetti from three points, three radio rings, a heavier shake.
        { at, run: () => { setCelebrate((n) => n + 1); fx.cue('modeWin', { at: stripRef, color: '#34d399', heat: 1 }); fx.shake(0.45); } },
        { at: at + 120, run: () => fx.burst({ x: 60, y: 140 }, { preset: 'confetti37', color: '#67e8f9', heat: 1 }) },
        { at: at + 220, run: () => fx.burst({ x: (globalThis.innerWidth || 400) - 60, y: 140 }, { preset: 'confetti37', color: '#86efac', heat: 1 }) },
        { at: at + 200, run: () => fx.burst(stripRef, { preset: 'ring', color: '#22d3ee' }) },
        { at: at + 420, run: () => fx.burst(stripRef, { preset: 'ring', color: '#22d3ee' }) },
        { at: at + 640, run: () => fx.burst(stripRef, { preset: 'ring', color: '#34d399' }) },
      ]);
    } else if (spentNow >= MAX_GUESSES) {
      fx.cue('fail');
      if (isDaily) recordDaily({ transmissions: spentNow, solved: false });
    } else {
      playSynth('dock');
    }
  };

  /** A random practice signal (never today's: practice seeds have their own prefix). `play`: skip its briefing. */
  const newSignal = (play = false) => {
    setSeed(practiceSeed());
    setGuesses([]);
    setAligned(null);
    setBriefed(play);
    setUsedElsewhere(false);
    setClaim('none');
    setResult(null);
    setCelebrate(0);
    setCur(emptyRow());
    setMessage(null);
    setSent(null);
    setRefusals(0);
    setPowers(noPowers());
  };

  const shareTextFor = () => {
    const label = isDaily ? `First Contact ${today}` : 'First Contact (practice)';
    const note = powerNote(powers); // "(1 Decode)": a power-up counts as a transmission, said openly
    const score = `${solved ? `${spent}/${MAX_GUESSES}` : `X/${MAX_GUESSES}`}${note ? ` ${note}` : ''}`;
    return `📡 ${label} ${score}\n${shareGrid(signal.shape, guesses.map((g) => g.fb))}\nSector 73 · ${SECTOR_URL}`;
  };

  // After a win the strip shows YOUR winning equation: an equivalent-but-reordered win used to
  // show the hidden ordering, which didn't match the row you'd just sent (audit 2026-10-11).
  const shown = solved ? guesses[guesses.length - 1] : answer;
  const titleIn = celebrate > 0 || (solved && !result); // a resumed win shows its title without the fanfare
  // The Bonus chip (design D7): live, so a lost bonus shows the moment it is lost.
  const bonus = bountyInfo ? bonusState(bountyId, { guesses, solved, over, daily: isDaily, answer, spent }) : null;
  // Why your place might not show (design D8, as Re-Entry). `user` undefined = not passed (tests).
  const placeStatus = user === null ? 'signedOut' : user?.is_anonymous ? 'guest' : sent ?? undefined;
  // Practising while today's Daily is unflown (design D1, as Re-Entry): offer the way back to it.
  const todaySave = loadDaily(dailySeedFor(todayEastern()));
  // A pin from an earlier day (yesterday's Daily, resumed and finished) does not hide today's
  // (contrarian 5a #2); the remount re-reads the save, so it can never open a second attempt.
  const dailyOpen = !isDaily && (!pin || pin.date !== todayEastern()) && !dailyGone && !began(todaySave) && todaySave?.status !== 'elsewhere';
  const showBriefing = !briefed && guesses.length === 0 && !usedElsewhere;
  const backToDaily = dailyOpen ? onBackToDaily : undefined;
  const backButton = backToDaily && !showBriefing && (
    <button type="button" data-testid="fc-back-to-daily" onClick={backToDaily}
      className="rounded-xl border border-amber-300/60 bg-amber-500/10 px-4 py-2 text-sm font-bold text-amber-100">Back to today&apos;s signal</button>
  );
  let gd = 0; let go = 0;
  return (
    // The root does not scroll: the middle scrolls, the controls stay pinned above the ad band (redesign 2026-10-22).
    <div ref={rootRef} className="relative isolate flex h-full flex-col overflow-hidden" style={{ background: 'radial-gradient(ellipse at top, #10294a 0%, #04030d 60%)' }}>
      <ModeBackdrop theme="firstContact" />
      {celebrate > 0 && (
        <motion.div key={celebrate} aria-hidden="true" data-testid="fc-win-flash" className="pointer-events-none absolute inset-0 z-20"
          style={{ background: 'radial-gradient(circle at 50% 25%, rgba(110,231,183,0.75), rgba(34,211,238,0.25) 45%, transparent 75%)' }}
          initial={{ opacity: 0 }} animate={{ opacity: [0, 1, 0] }} transition={{ duration: 0.9 }} />
      )}
      {/* DAILY / PRACTICE at a glance, the same chip in every Sector 73 game (framework §D3). */}
      <ModeHeader title="First Contact" subtitle={isDaily ? <DailyChip date={today} /> : <PracticeChip />} onExit={onExit} onReturnTo37={onReturnTo37} />

      {/* Today's Daily already taken: none of the play area renders under the card (audit 2026-10-18). */}
      {!usedElsewhere && (<>
      <div ref={scrollRef} data-testid="fc-scroll" className="relative min-h-0 flex-1 overflow-y-auto pb-3">
      {!over && backButton && <div className="mt-2 flex justify-center">{backButton}</div>}
      {/* The incoming signal: glyphs until decoded. */}
      <div className="mt-3 px-3">
        {/* "= 37" sits on the label line so the strip never wraps (audit 2026-10-19). */}
        <div data-testid="fc-strip-label" className="text-center text-[10px] uppercase tracking-[0.35em] text-cyan-300/80">
          Incoming transmission · <span className="font-black tracking-normal text-cyan-100">makes 37</span>
        </div>
        {/* Fixed-width cells from rowSizes: a glyph and its decoded die take the same room, so the */}
        {/* strip does not re-flow as it decodes (audit 2026-10-19). */}
        <div ref={stripRef} data-testid="fc-strip" data-row-die={strip.die} className="mt-2 flex items-center justify-center font-black" style={{ gap: strip.gap }}>
          {signal.shape.map((cell, k) => {
            if (cell === '(' || cell === ')') return <span key={k} className="shrink-0 text-center leading-none text-cyan-300/70" style={{ width: strip.bracket, fontSize: strip.die }}>{cell}</span>;
            const isDie = cell === 'D';
            const i = isDie ? gd++ : go++;
            const w = isDie ? strip.die : strip.op;
            const glyph = isDie ? GLYPHS[(i * 3 + 1) % GLYPHS.length] : GLYPHS[(i * 5 + 7) % GLYPHS.length];
            const isDecoded = isDie ? decoded.dice[i] : decoded.ops[i];
            // Every cell always draws its alien glyph (centred, sized to the cell, never clipped), and a
            // decoded symbol locks in OVER it: a cell is never blank while its lock-in waits on the row's
            // flips (audit 2026-10-19: the browser check saw blank strip cells).
            const glyphEl = (
              <span data-testid="fc-glyph" aria-hidden="true" className={`leading-none animate-pulse ${isDie ? 'text-cyan-200/80' : 'text-cyan-200/60'}`}
                style={{ fontSize: Math.max(12, isDie ? strip.die : strip.op + 2) }}>{glyph}</span>
            );
            return (
              <span key={k} data-strip-cell={isDie ? 'die' : 'op'} data-decoded={isDecoded ? 'yes' : 'no'} className="relative grid shrink-0 place-items-center overflow-visible" style={{ width: w, height: strip.die }}>
                {isDecoded ? (
                  <>
                    <motion.span className="absolute inset-0 grid place-items-center" initial={{ opacity: 1 }} animate={{ opacity: 0 }} transition={{ delay: lockIn(k).transition.delay, duration: 0.1 }}>{glyphEl}</motion.span>
                    {isDie
                      ? <motion.span className="relative" {...lockIn(k)}><NeonDieFace value={shown.dice[i]} color="green" size={strip.die} /></motion.span>
                      : <motion.span className="relative leading-none text-emerald-300" style={{ fontSize: strip.die }} {...lockIn(k)}>{DISPLAY[shown.ops[i]]}</motion.span>}
                  </>
                ) : glyphEl}
              </span>
            );
          })}
        </div>
        {/* The clue stays on screen the whole game (design D5) — the briefing's own words. */}
        <div data-testid="fc-clue" className="mt-1.5 text-center text-[11px] text-sky-200/90">🔎 {clue.text}</div>
        {/* The Bonus: optional, so it looks like a reward on its own row (Hyperjump's Bonus, design D7). */}
        {bountyInfo && (
          <div className="mt-1 flex justify-center">
            <span data-testid="fc-bonus" data-state={bonus}
              className={`rounded-full border px-2.5 py-0.5 text-center text-[11px] font-bold ${BONUS_CHIP[bonus]}`}>
              {bonusChipText(bountyInfo, bonus, { signedOut: user === null })}
            </span>
          </div>
        )}
      </div>

      {/* Transmission log: the rows SENT, then the row being built — no empty rows (redesign Q3 = A: */}
      {/* the 5 empty rows took ~240 px and held nothing); what is left shows as dots below. */}
      <div className="mt-4 space-y-2.5 px-1">
        {guesses.map((g, row) => (
          <motion.div key={row} animate={celebrate ? { y: [0, -10, 0] } : {}} transition={{ delay: row * 0.06, duration: 0.4 }}>
            <ShapeRow shape={signal.shape} dice={g.dice} ops={g.ops} feedback={g.fb} flip sizes={sizes} />
          </motion.div>
        ))}
        {!over && (
          // No shake for a refused row (design D2). The selected box glows (row.js cursor).
          <div ref={curRowRef} data-testid="fc-current-row" className="pt-3">
            <ShapeRow shape={signal.shape} dice={cur.dice} ops={cur.ops} sizes={sizes} onSlot={selectAt} cursor={cursor} carried={cur.carried} />
          </div>
        )}
      </div>
      <TransmissionDots spent={spent} max={MAX_GUESSES} over={over} />
      {!over && (
        <div className="mt-1 flex flex-col items-center gap-1.5">
          <p data-testid="fc-hint" className="text-center text-[11px] text-slate-400">
            {readyToSend ? 'Ready to transmit. · ' : ''}{cursor ? 'Tap any box to select it.' : 'Tap a box to change it.'}
          </p>
          {/* What the colours mean lives in ⓘ How it works (it took two lines under TRANSMIT). */}
          <button type="button" data-testid="fc-legend" onClick={() => setHelpOpen(true)}
            className="rounded-full border border-slate-600 px-2.5 py-0.5 text-[11px] text-slate-300">🟩🟨⬛ What do the colours mean?</button>
        </div>
      )}

      {over && (
        <div className="mt-4 space-y-3 px-4 text-center">
          {/* Results as Re-Entry (design D8): the headline, the answer if lost, your place, Share, practice. */}
          {solved ? (
            <motion.div data-testid="fc-win-title" initial={{ scale: 2.2, opacity: 0, letterSpacing: '0.4em' }}
              animate={titleIn ? { scale: 1, opacity: 1, letterSpacing: '0.04em' } : { opacity: 0 }}
              transition={{ type: 'spring', stiffness: 260, damping: 16 }}
              className="text-3xl font-black text-emerald-200" style={{ textShadow: '0 0 18px #34d399, 0 0 42px #22d3ee' }}>
              Decoded in {spent} of {MAX_GUESSES}
            </motion.div>
          ) : (
            <div data-testid="fc-lost-title" className="text-2xl font-black text-rose-300">Signal lost</div>
          )}
          {powerNote(powers) && <div data-testid="fc-power-note" className="text-xs font-bold text-violet-200">Power-ups used {powerNote(powers)} — each cost a transmission</div>}
          {!solved && (
            <div data-testid="fc-answer" className="text-sm text-slate-300">
              The message was:{' '}
              {/* Its own budget: this row sits in px-4, not the log's px-1 (audit 2026-10-19). */}
              <ShapeRow shape={signal.shape} dice={answer.dice} ops={answer.ops} feedback={{ dice: Array(7).fill('green'), ops: Array(6).fill('green') }} sizes={lossSizes} />
            </div>
          )}
          {result?.newBest && (
            <div className="flex justify-center">
              <span data-testid="fc-chip-best" className="rounded-full border border-emerald-300/70 px-2 py-0.5 text-xs font-bold text-emerald-200">🏅 New best</span>
            </div>
          )}
          {isDaily && <DailyPlace game="firstContact" recorded={recorded} day={pin?.date ?? null} status={placeStatus} quiet={!solved} />}
          <div className="flex flex-wrap justify-center gap-2">
            <ShareButton text={shareTextFor} />
            {backButton}
            <button type="button" data-testid="fc-practice" onClick={() => newSignal()} className="rounded-xl bg-violet-500 px-4 py-2.5 text-sm font-black text-white active:scale-95">{isDaily ? 'Practice signal' : 'New signal'}</button>
          </div>
        </div>
      )}
      </div>
      {!over && (
        <FcControls dice={signal.dice} usedBoard={cur.board} tray={tray} memory={memory}
          messages={lineMessages} onDismissTip={dismissTip} powerUps={powerUps} onPowerUp={onPowerUp} counts={powers.counts} onDie={tapDie} onOp={tapOp} onClear={del}
          canSend={filled === 13} claimWait={claimWait} onTransmit={transmit} />
      )}
      </>)}
      {helpOpen && <HowItWorks title="First Contact" testId="fc-how-play" onClose={() => setHelpOpen(false)} items={howItWorksItems({ bounty: bountyInfo, practice: !isDaily })} />}
      {showBriefing && (
        // "Practice first" goes straight into play: a second briefing would just repeat this one.
        <SignalBriefing label={isDaily ? `Daily ${today.slice(5)}` : 'Practice'} shape={signal.shape} dice={signal.dice}
          clue={clue} bounty={bountyInfo} practice={!isDaily} onStart={beginBriefed} onLeave={onExit}
          onPractice={() => newSignal(true)} onBackToDaily={backToDaily} width={screenWidth} signedOut={user === null} />
      )}
      {usedElsewhere && (
        // Full cover (nothing playable underneath), so it carries the header's two ways out itself.
        <div data-testid="fc-daily-used" role="dialog" aria-modal="true" aria-labelledby="fc-daily-used-title" className="absolute inset-0 z-40 grid place-items-center bg-black/80 px-4 py-6">
          <div className="w-full max-w-sm space-y-3 rounded-2xl border border-cyan-300/40 bg-[#07102a]/95 p-4 text-center text-white">
          <div id="fc-daily-used-title" className="text-lg font-black">📡 Today&apos;s Daily is done</div>
          <p className="text-sm text-slate-300">Your account already took today&apos;s Daily signal. A new one arrives tomorrow.</p>
          <div className="flex flex-wrap justify-center gap-2">
            <button type="button" onClick={() => setBoardOpen(true)} className="rounded-xl border border-amber-300/50 px-4 py-2.5 text-sm font-bold text-amber-100">🏆 Today&apos;s board</button>
            <button type="button" onClick={() => newSignal()} className="rounded-xl bg-violet-500 px-4 py-2.5 text-sm font-black text-white">Practice signal</button>
          </div>
          <div className="flex justify-center gap-4 text-xs">
            <button type="button" data-testid="fc-used-return" onClick={onReturnTo37} className="text-fuchsia-200 underline">← Return to 37</button>
            <button type="button" data-testid="fc-used-orbit" onClick={onExit} className="text-cyan-200 underline">Back to orbit</button>
          </div>
          </div>
        </div>
      )}
      {boardOpen && <DailyBoard game="firstContact" day={today} onClose={() => setBoardOpen(false)} />}
    </div>
  );
}
