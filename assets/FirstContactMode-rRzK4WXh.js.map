// First Contact — the briefing's clue and the signal's bounty (overnight 2026-10-11; Hyperjump's
// pre-jump briefing and Bounties, adapted). Pure.
//
// THE CLUE MUST STAY TRUE. The hidden answer is re-aligned to your first guess (alignSecret picks
// an equivalent ordering), so a clue may only state something every equivalent ordering shares.
// Reordering sums can turn a + into a − (a+(b−c) ≡ a−(c−b)), but the number of ×, ÷ and ^ never
// changes (each is its own node in the canonical form, ./equivalence.js), and so neither does
// the number of + and − together. Clues are built only from those counts.

import { makeRng } from '../rng';
import { REWARDS } from '../rewards';
import { buttonMemory } from './equivalence';

export const BOUNTY_STARS = REWARDS.fc_bounty; // what the server pays (../rewards)

// What the colours mean, said truthfully (audit 2026-10-18, design D3 — wording only, no scoring
// change). A repeated sign can be grey while another copy of it is green or yellow (Wordle
// duplicates), so grey is not only "not in it". Dice are never grey: a guess must use all 7.
// One wording for the screen's legend and How it works.
export const LEGEND = 'green = right place · yellow = in it, elsewhere · grey = not in it, or no more of that one';
export const DICE_NOTE = 'Dice are only green or yellow — all 7 are in the answer.';
export const QUICK_GUESSES = 4;
export const SHARP_GUESSES = 3;

const countOf = (ops, op) => ops.filter((o) => o === op).length;
const times = (k, sym) => (k === 0 ? `no ${sym}` : k === 1 ? `exactly one ${sym}` : `exactly ${k} ${sym}`);

/**
 * Every clue that is true of this secret (only equivalence-proof facts).
 * The ^ clue is given only when the signal HAS a ^: ^ is rare (~3% of operator slots), so "the
 * signal has no ^" was true almost every day and told the player nothing (review 2026-10-14).
 */
export function cluesFor(secret) {
  const plusMinus = countOf(secret.ops, '+') + countOf(secret.ops, '-');
  const powers = countOf(secret.ops, '^');
  return [
    { id: 'times', text: `The signal has ${times(countOf(secret.ops, '*'), '×')}.` },
    { id: 'divide', text: `The signal has ${times(countOf(secret.ops, '/'), '÷')}.` },
    ...(powers > 0 ? [{ id: 'power', text: `The signal has ${times(powers, '^')}.` }] : []),
    // "signs", the word the keys use; "1 … is" (it read "1 of the 6 operators are", contrarian 2026-10-22).
    { id: 'plusMinus', text: `${plusMinus} of the 6 signs ${plusMinus === 1 ? 'is' : 'are'} + or −.` },
  ];
}

/** The signal's clue, the same for every player on a seed. */
export function clueFor(seed, secret) {
  const all = cluesFor(secret);
  return all[Math.floor(makeRng(`${seed}-clue`)() * all.length)];
}

const sentWith = (op) => ({ guesses }) => guesses.some((g) => g.ops.includes(op));

/**
 * id, text, when it can be offered (the secret proves it is possible), and the check. `lasting`:
 * once met it stays met (the screen shows ✓); the others can still be lost (it shows "on track").
 * ctx: { guesses: [{ dice, ops, fb }], spent? } — spent = rows + power-ups (each costs a transmission). Pays only on a decoded signal. (A refused row — not 37 —
 * is never sent and costs nothing, so there is no reject count; design D2.)
 */
export const BOUNTIES = Object.freeze([
  { id: 'quick', icon: '⚡', text: `Decode it in ${QUICK_GUESSES} transmissions or fewer`, short: `Decode in ≤${QUICK_GUESSES}`, offer: () => true, met: ({ guesses, spent = guesses.length }) => spent <= QUICK_GUESSES },
  // Replaced 2026-10-14 (contrarian review): "4+ greens on the opener" was nearly free (the answer
  // re-aligns to guess 1), and "every transmission is a real 37" was free (the live total shows it).
  { id: 'sharp', icon: '🎯', text: `Decode it in ${SHARP_GUESSES} transmissions or fewer`, short: `Decode in ≤${SHARP_GUESSES}`, offer: () => true, met: ({ guesses, spent = guesses.length }) => spent <= SHARP_GUESSES },
  { id: 'noGrey', icon: '🧠', text: 'Never re-send an operator the keys show as grey', short: 'Skip grey signs', offer: () => true, met: ({ guesses }) => guesses.every((g, k) => {
    const memory = buttonMemory(guesses.slice(0, k));
    return g.ops.every((o) => memory.ops[o] !== 'grey');
  }) },
  { id: 'divide', icon: '÷', text: 'Send a transmission that uses ÷', short: 'Use ÷ once', offer: (secret) => secret.ops.includes('/'), lasting: true, met: sentWith('/') },
  { id: 'power', icon: '^', text: 'Send a transmission that uses ^', short: 'Use ^ once', offer: (secret) => secret.ops.includes('^'), lasting: true, met: sentWith('^') },
]);
export const bountyById = (id) => BOUNTIES.find((b) => b.id === id) || null;

/** The signal's bounty, the same for every player on a seed. */
export function bountyFor(seed, secret) {
  const pool = BOUNTIES.filter((b) => b.offer(secret));
  return pool[Math.floor(makeRng(`${seed}-bounty`)() * pool.length)].id;
}

/** Met so far? (`solved` gates the payout; the live ✓ on the screen ignores it.) */
export const bountyMet = (id, ctx) => Boolean(bountyById(id)?.met(ctx));

// ── The Bonus chip (audit 2026-10-19, design D7 — Hyperjump's "Bonus" row, adapted) ──────────────
// The bounty is shown as an optional "Bonus +1★" under the clue for the whole game, so the player
// sees the moment it is lost — not just at the end.
const ALL_GREEN = Object.freeze({ dice: Array(7).fill('green'), ops: Array(6).fill('green') });

/**
 * The Bonus chip's state. Pure.
 *   practice — never pays: shown greyed "(Daily only)"
 *   won      — decoded and met: the ★ is paid
 *   missed   — can no longer be met (or the game ended without it)
 *   done     — a lasting goal already met, the decode still to come: shown as "on track" (gold),
 *              NOT ✓ — a ✓ reads as paid, and losing the game would then seem to take it away
 *   track    — met so far, and could still be lost ("on track")
 *   open     — a lasting goal not met yet (still possible)
 * "Can it still be met?" = would decoding it with the NEXT transmission meet it. The answer's own
 * signs can never be grey in the key memory (best colour wins), so this is exact for every bounty.
 * @param {string} id bounty id
 * @param {{ guesses: any[], solved: boolean, over: boolean, daily: boolean, answer: { dice: number[], ops: string[] }, spent?: number }} p  spent: rows + power-ups
 */
export function bonusState(id, { guesses, solved, over, daily, answer, spent = guesses.length }) {
  if (!daily) return 'practice';
  const metNow = bountyMet(id, { guesses, spent });
  if (solved) return metNow ? 'won' : 'missed';
  if (over) return 'missed';
  const canStill = bountyMet(id, { guesses: [...guesses, { dice: answer.dice, ops: answer.ops, fb: ALL_GREEN }], spent: spent + 1 });
  if (bountyById(id)?.lasting) return metNow ? 'done' : canStill ? 'open' : 'missed';
  return canStill ? 'track' : 'missed';
}

/** What the chip says after the goal, per state. */
export const BONUS_SUFFIX = Object.freeze({
  practice: '(Daily only)', won: '✓', missed: '✗ missed', done: '· on track', track: '· on track', open: '',
});

/** Longest chip text allowed: one line in an 11-px pill at 360 px (contrarian slice 4, m4). */
export const BONUS_CHIP_MAX = 40;
/**
 * The chip's words: "Bonus +1★ · Decode in ≤4 · on track". The short goal (the full sentence is on the
 * briefing). Signed out, no "+1★": a ★ earned while signed out would be queued on the phone and paid to
 * whichever account signs in later (as Re-Entry, contrarian slice 4).
 * @param {{ short: string }} bounty
 * @param {keyof typeof BONUS_SUFFIX} state
 * @param {{ signedOut?: boolean }} [opts]
 */
export const bonusChipText = (bounty, state, { signedOut = false } = {}) =>
  `${signedOut ? 'Bonus' : `Bonus +${BOUNTY_STARS}★`} · ${bounty.short}${BONUS_SUFFIX[state] ? ` ${BONUS_SUFFIX[state]}` : ''}`;
