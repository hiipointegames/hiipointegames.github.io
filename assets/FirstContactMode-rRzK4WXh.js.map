import React, { useLayoutEffect, useState } from 'react';
import { motion } from 'framer-motion';
import { DISPLAY } from '../sectorMath';
import { NeonDieFace } from '../dice/NeonDie';

// "Signal Decoded" (sweep SW14b; storyboard juice.md §3.2): a transmitted row's tiles flip over
// one by one (Wordle).
export const FLIP_STAGGER_MS = 90;
export const FLIP_MS = 250;

// Row sizing (audit 2026-10-19): the old formula assumed 4 brackets and the window width, so the
// 6-bracket shape and the loss screen's answer row overflowed at 360-384 px. Now each SHAPE is
// counted (its brackets, its gaps) against the width it really has (the measured screen minus
// this surface's own side padding).
/** @typedef {{ pad: number, gap: number, min: number, max: number }} RowBudget */
/** The transmission log: `px-1` around rows, 2-px gaps. */
export const LOG_BUDGET = { pad: 8, gap: 2, min: 14, max: 44 };
/** The loss screen's answer row: sits in `px-4`. */
export const LOSS_BUDGET = { pad: 32, gap: 2, min: 14, max: 44 };
/** The incoming-signal strip: `px-3`, small dice (~16-18 px) so it never wraps. */
export const STRIP_BUDGET = { pad: 24, gap: 3, min: 10, max: 18 };
/** The briefing card's shape: the overlay's `px-4` + the card's `p-4` + its 2-px border (design D1). */
export const BRIEF_BUDGET = { pad: 68, gap: 2, min: 12, max: 30 };
/** The briefing card stops growing at `max-w-sm` (384 px) + the overlay's `px-4`. */
export const BRIEF_MAX_WIDTH = 384 + 32;

const OP_RATIO = 0.7;
const BRACKET_RATIO = 0.3;
const opFor = (die) => Math.round(die * OP_RATIO);
const bracketFor = (die) => Math.max(5, Math.floor(die * BRACKET_RATIO));

/** Total px a row takes (cells + gaps + the surface's padding). */
export function rowWidth(shape, { die, op, bracket, gap }, pad = 0) {
  const brackets = shape.filter((c) => c === '(' || c === ')').length;
  const dice = shape.filter((c) => c === 'D').length;
  const ops = shape.length - brackets - dice;
  return dice * die + ops * op + brackets * bracket + (shape.length - 1) * gap + pad;
}

/**
 * Die / operator / bracket sizes so this shape's row fits `width` (the screen's width; the budget
 * takes off its own padding). Starts from the even split and steps down until it really fits
 * (rounding can push the estimate a pixel over).
 * @param {string[]} shape
 * @param {number} width
 * @param {RowBudget} [budget]
 */
export function rowSizes(shape, width, budget = LOG_BUDGET) {
  const { pad, gap, min, max } = budget;
  const brackets = shape.filter((c) => c === '(' || c === ')').length;
  const units = 7 + 6 * OP_RATIO + brackets * BRACKET_RATIO;
  const avail = width - pad - (shape.length - 1) * gap;
  let die = Math.max(min, Math.min(max, Math.floor(avail / units)));
  const at = (d) => ({ die: d, op: opFor(d), bracket: bracketFor(d), gap });
  while (die > min && rowWidth(shape, at(die), pad) > width - 1) die--; // 1 px slack: the measured width rounds
  return at(die);
}

// The dice tray + operator keys under the log (audit 2026-10-19: 7 × 48-px dice + gaps + px-3 is
// 396 px, so the last die was cut off at 360). Same measured width; dice capped at 48.
export const TRAY_BUDGET = { pad: 24, gap: 6, max: 48, cols: 7 };
/** Tray die size, and the width of one operator-key column (the key grid is 7 equal columns). */
export function traySizes(width) {
  const { pad, gap, max, cols } = TRAY_BUDGET;
  const die = Math.min(max, Math.floor((width - pad - 6 * gap) / 7));
  const keyCol = Math.floor((width - pad - (cols - 1) * gap) / cols);
  return { die, keyCol, gap };
}
/** Total px the tray takes. */
export const trayWidth = ({ die, gap }) => 7 * die + 6 * gap + TRAY_BUDGET.pad;

/**
 * The screen's width, measured from `ref` (and kept current with a ResizeObserver). Falls back to
 * the window width where nothing can be measured (tests, first paint).
 */
export function useMeasuredWidth(ref) {
  const [width, setWidth] = useState(() => globalThis.innerWidth || 400);
  useLayoutEffect(() => {
    const el = ref.current;
    if (!el) return undefined;
    const read = () => { if (el.clientWidth > 0) setWidth(el.clientWidth); };
    read();
    if (typeof ResizeObserver === 'undefined') return undefined;
    const ro = new ResizeObserver(read);
    ro.observe(el);
    return () => ro.disconnect();
  }, [ref]);
  return width;
}

const DIE_TINT = { green: 'green', yellow: 'yellow', grey: 'grey', empty: 'white', carried: 'green' };
const TILE = {
  green: 'bg-emerald-500 border-emerald-300 text-white',
  yellow: 'bg-amber-500 border-amber-300 text-white',
  grey: 'bg-slate-700 border-slate-600 text-slate-300',
  empty: 'bg-black/40 border-violet-400/40 text-white',
  carried: 'bg-emerald-600/40 border-emerald-300/70 text-white',
};

// The selected box (David, 2026-10-22: "hard to tell where your cursor is"): a cyan ring + glow, a ▼
// above it, and a blinking caret while it is empty. Same look on dice and sign boxes.
const SELECTED = 'outline outline-[2.5px] outline-cyan-300 shadow-[0_0_12px_#22d3ee] z-10';

// One row of the log (or the loss screen's answer). onSlot makes EVERY box of the row being built
// tappable — a tap selects it (never erases; row.js). `cursor` = the selected box's key ('d3'), or null.
// Every empty box shows its KIND — a die box is a rounded square, a sign box a circle.
export default function ShapeRow({ shape, dice, ops, feedback = null, flip = false, sizes = rowSizes(shape, globalThis.innerWidth || 400), onSlot = null, cursor = null, carried = [] }) {
  const { die: SLOT_DIE, op: SLOT_OP, bracket, gap } = sizes;
  const tapSelect = (key, filled, kind) => (onSlot ? {
    role: 'button', 'data-testid': `fc-slot-${key}`, 'data-filled': filled ? 'yes' : 'no',
    'aria-label': `${kind === 'die' ? 'Die' : 'Sign'} box ${Number(key.slice(1)) + 1}${filled ? '' : ', empty'}${key === cursor ? ', selected' : ''}`,
    'aria-pressed': key === cursor,
    onPointerDown: (e) => { e.preventDefault(); onSlot(key); },
  } : {});
  const marker = (key) => (key === cursor ? (
    <span data-testid="fc-cursor" aria-hidden="true" className="pointer-events-none absolute left-1/2 -translate-x-1/2 animate-bounce text-[10px] leading-none text-cyan-300"
      style={{ top: -Math.max(11, Math.round(SLOT_DIE * 0.42)) }}>▼</span>
  ) : null);
  const caret = (key, filled) => (key === cursor && !filled ? (
    <span aria-hidden="true" className="pointer-events-none absolute inset-0 m-auto h-[60%] w-[2px] animate-pulse bg-cyan-300" />
  ) : null);
  let d = 0; let o = 0;
  let order = 0; // flip order across dice + operators
  const flipIn = (n) => (flip ? {
    initial: { rotateX: 90, opacity: 0.2 },
    animate: { rotateX: 0, opacity: 1 },
    transition: { delay: (n * FLIP_STAGGER_MS) / 1000, duration: FLIP_MS / 1000 },
  } : {});
  return (
    <div data-row-die={SLOT_DIE} className="flex items-center justify-center" style={{ gap }}>
      {shape.map((cell, k) => {
        if (cell === '(' || cell === ')') {
          // A fixed-width cell, so the bracket counted in rowSizes is the bracket drawn.
          return <span key={k} className="shrink-0 text-center font-black text-violet-300/80" style={{ width: bracket, fontSize: Math.max(10, Math.round(SLOT_DIE * 0.65)) }}>{cell}</span>;
        }
        const isDie = cell === 'D';
        const idx = isDie ? d++ : o++;
        const n = order++;
        const value = isDie ? dice[idx] : ops[idx];
        const key = `${isDie ? 'd' : 'o'}${idx}`;
        // A piece carried from the last row (or revealed by a power-up) shows faintly green until you change it.
        const state = feedback ? (isDie ? feedback.dice[idx] : feedback.ops[idx]) : value != null && carried.includes(key) ? 'carried' : 'empty';
        const sel = key === cursor ? SELECTED : '';
        if (isDie) {
          return (
            <motion.span key={k} data-slot-kind="die" data-slot-state={state} data-cursor={key === cursor ? 'yes' : undefined} {...flipIn(n)} {...tapSelect(key, value != null, 'die')}
              className={`relative shrink-0 rounded-md ${value == null ? 'border border-violet-400/40 bg-black/40' : ''} ${sel}`}
              style={{ width: SLOT_DIE, height: SLOT_DIE }}>
              {marker(key)}{caret(key, value != null)}
              {value != null && <NeonDieFace value={value} color={DIE_TINT[state] || 'white'} size={SLOT_DIE} />}
            </motion.span>
          );
        }
        return (
          <motion.span
            key={k}
            data-slot-kind="sign"
            data-slot-state={state}
            data-cursor={key === cursor ? 'yes' : undefined}
            {...flipIn(n)}
            {...tapSelect(key, value != null, 'sign')}
            className={`relative grid shrink-0 place-items-center rounded-full border font-black ${TILE[state]} ${sel}`}
            style={{ width: SLOT_OP, height: SLOT_OP, fontSize: Math.round(SLOT_OP * 0.55) }}
          >
            {marker(key)}{caret(key, value != null)}
            {value == null ? '' : DISPLAY[value]}
          </motion.span>
        );
      })}
    </div>
  );
}
