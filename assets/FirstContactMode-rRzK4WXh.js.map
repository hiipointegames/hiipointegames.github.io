// First Contact — the ONE stuck tip (redesign 2026-10-22; world framework §B1.3 / §B2). Pure.
//
// It shows after 30 s without progress or 2 refused rows in a row (the coach kit's useStuckTimer)
// and gives ONE concrete next step. Every tip must be TRUE and move you forward, and on the Daily it
// must never hand over the answer (§B2.6–7). So each tip is built only from:
//   • what the colours have already shown (the answer agrees with every shown colour — alignSecret),
//   • the clue (counts that hold for every equivalent answer — signalInfo.js),
//   • a DIFFERENT legal 37 (never the answer's maths on the Daily) for "how do I even make 37?".

import { DISPLAY } from '../sectorMath';
import { makeRng, shuffle } from '../rng';
import { evaluateFill, isThirtySeven, fillShape, OPERATORS } from './logic';
import { buttonMemory, isEquivalent, parseFilled } from './equivalence';

const sym = (op) => DISPLAY[op];
const countOf = (ops, op) => ops.filter((o) => o === op).length;

/** The clue's claim as numbers: { ops: ['*'], n: 2 } or { ops: ['+','-'], n: 3 }. */
function clueClaim(clueId, secret) {
  if (clueId === 'times') return { ops: ['*'], n: countOf(secret.ops, '*') };
  if (clueId === 'divide') return { ops: ['/'], n: countOf(secret.ops, '/') };
  if (clueId === 'power') return { ops: ['^'], n: countOf(secret.ops, '^') };
  if (clueId === 'plusMinus') return { ops: ['+', '-'], n: countOf(secret.ops, '+') + countOf(secret.ops, '-') };
  return null;
}

/**
 * A legal 37 for this board that keeps the row's carried (known-right) pieces, and — on the Daily —
 * is NOT the answer's maths. Seeded, so the same board gives the same tip. Null if none is found.
 */
export function findOtherThirtySeven({ shape, boardDice, row, answer, daily, seed = 'tip', tries = 30000 }) {
  const rng = makeRng(`${seed}-37`);
  const keep = new Set(row.carried || []);
  const fixedDice = row.dice.map((v, i) => (keep.has(`d${i}`) ? v : null));
  const fixedOps = row.ops.map((v, i) => (keep.has(`o${i}`) ? v : null));
  const pool = [...boardDice];
  for (const v of fixedDice) if (v != null) pool.splice(pool.indexOf(v), 1);
  for (let k = 0; k < tries; k++) {
    const rest = shuffle(rng, pool);
    const dice = fixedDice.map((v) => (v != null ? v : rest.pop()));
    const ops = fixedOps.map((v) => v ?? OPERATORS[Math.floor(rng() * (rng() < 0.1 ? 5 : 4))]);
    const v = evaluateFill(shape, dice, ops);
    if (!isThirtySeven(v)) continue;
    if (daily && isEquivalent(shape, { dice, ops }, answer)) continue; // never the answer itself
    return { dice, ops };
  }
  return null;
}

/** The biggest two-dice step inside an equation ("6 × 6 = 36"): a node whose children are both dice. */
export function biggestStep(shape, fill) {
  const { tokens, values } = fillShape(shape, fill.dice, fill.ops);
  let tree;
  try { tree = parseFilled(tokens, values); } catch { return null; }
  let best = null;
  const walk = (n) => {
    if (!n || n.n !== undefined) return;
    if (n.l.n !== undefined && n.r.n !== undefined) {
      const a = n.l.n; const b = n.r.n;
      const v = n.op === '+' ? a + b : n.op === '-' ? a - b : n.op === '*' ? a * b : n.op === '/' ? a / b : a ** b;
      if (Number.isInteger(v) && (!best || v > best.v)) best = { a, op: n.op, b, v };
    }
    walk(n.l); walk(n.r);
  };
  walk(tree);
  return best;
}

/**
 * The stuck tip for this moment, or null. First that applies:
 *   1. a sign in your row whose key is grey (shown: none in the signal)
 *   2. your full row breaks the clue's count
 *   3. a piece sitting where an earlier row already showed it 🟨 (shown: it goes elsewhere)
 *   4. no 37 yet (refused rows, or no total): a real step from ANOTHER legal 37
 *   5. a yellow in the last row: swap them; else: change a sign, keep the greens
 * @param {{ shape: string[], boardDice: number[], guesses: any[], row: any, clue: { id: string },
 *   secret: { ops: string[] }, answer: { dice: number[], ops: string[] }, daily: boolean,
 *   refusals?: number, rowMakes37?: boolean, seed?: string }} p
 *   secret: the signal's own secret (clue counts hold for every equivalent answer) · answer: the aligned answer.
 * @returns {{ kind: 'grey'|'clue'|'yellow'|'step'|'swap'|'general', text: string, [k: string]: any } | null}
 *   The kind + its facts (for the truth tests); the screen shows `text`.
 */
export function stuckTipFor({ shape, boardDice, guesses, row, clue, secret, answer, daily, refusals = 0, rowMakes37 = false, seed = 'tip' }) {
  const memory = buttonMemory(guesses);
  // 1. A grey sign in the row.
  const greyOp = row.ops.find((o) => o && memory.ops[o] === 'grey');
  if (greyOp) return { kind: 'grey', op: greyOp, text: `${sym(greyOp)} is grey — the signal has no ${sym(greyOp)}.` };

  // 2. The clue, against a full set of signs.
  const claim = clueClaim(clue?.id, secret);
  if (claim && row.ops.every((o) => o != null)) {
    const m = row.ops.filter((o) => claim.ops.includes(o)).length;
    if (m !== claim.n) {
      return {
        kind: 'clue', ops: claim.ops, want: claim.n, have: m,
        text: claim.ops.length === 1
          ? `The clue says ${claim.n} ${sym(claim.ops[0])}; your row has ${m}.`
          : `The clue says ${claim.n} + or − signs; your row has ${m}.`,
      };
    }
  }

  // 3. A piece where an earlier row showed it yellow (so the answer does NOT have it there).
  for (const g of guesses) {
    for (let i = 0; i < 7; i++) {
      if (g.fb.dice[i] === 'yellow' && row.dice[i] === g.dice[i]) return { kind: 'yellow', key: `d${i}`, value: g.dice[i], text: `Your yellow ${g.dice[i]} belongs in another die box.` };
    }
    for (let i = 0; i < 6; i++) {
      if (g.fb.ops[i] === 'yellow' && row.ops[i] === g.ops[i]) return { kind: 'yellow', key: `o${i}`, value: g.ops[i], text: `Your yellow ${sym(g.ops[i])} belongs in another sign box.` };
    }
  }

  // 4. Can't find a 37: a real step from another legal 37 that keeps your known pieces.
  if (refusals >= 2 || !rowMakes37) {
    const other = findOtherThirtySeven({ shape, boardDice, row, answer, daily, seed });
    const step = other && biggestStep(shape, other);
    if (step) return { kind: 'step', other, step, text: `Try ${step.a} ${sym(step.op)} ${step.b} = ${step.v} first, then make the rest fit.` };
  }

  // 5. Last resort, still true.
  const last = guesses[guesses.length - 1];
  if (last && [...last.fb.dice, ...last.fb.ops].includes('yellow')) return { kind: 'swap', text: 'Swap two yellow pieces — each belongs in another box.' };
  return { kind: 'general', text: guesses.length ? 'Change one sign and keep every green.' : 'Any 37 works as a first guess — transmit it.' };
}

/** Just the words (what the screen shows). */
export const stuckTip = (p) => stuckTipFor(p)?.text ?? null;

/** Every fixed tip wording, for the copy-rule test (templates filled with sample values). */
export const SAMPLE_TIPS = Object.freeze([
  '× is grey — the signal has no ×.',
  'The clue says 2 ×; your row has 1.',
  'The clue says 3 + or − signs; your row has 4.',
  'Your yellow 4 belongs in another die box.',
  'Your yellow ÷ belongs in another sign box.',
  'Try 6 × 6 = 36 first, then make the rest fit.',
  'Swap two yellow pieces — each belongs in another box.',
  'Change one sign and keep every green.',
  'Any 37 works as a first guess — transmit it.',
]);
