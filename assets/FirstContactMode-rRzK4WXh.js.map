import React from 'react';
import { SpaceDie, PrimaryButton } from '../ui';
import { DISPLAY } from '../sectorMath';
import { TipSlot, PowerUpTray } from '../coach';

// First Contact's controls, PINNED to the bottom of the game area (redesign 2026-10-22): the one
// message slot, the power-up tray, the dice, the sign keys and TRANSMIT. They never scroll, so
// TRANSMIT is always above the ad band — measured before: 25 px under it at 360×740 and 125 px
// at 360×640 (a 105-px Android band), where the old screen needed a scroll to reach it.

// Sign keys keep their colour memory (Wordle keyboard): a grey key = not in the signal. (The dice
// rings went: after guess 1 every die was ringed — dice are always in the answer — so they said nothing.)
const MEMORY_KEY = {
  green: 'border-emerald-300 bg-emerald-600/70 text-white',
  yellow: 'border-amber-300 bg-amber-600/70 text-white',
  grey: 'border-slate-600 bg-slate-800 text-slate-500',
};
export const SIGN_KEYS = Object.freeze(['+', '-', '*', '/', '^']);

/**
 * @param {{
 *   dice: number[], usedBoard: (number|null)[], tray: { die: number, gap: number },
 *   messages: { refusal?: string|null, tip?: string|null, good?: string|null, coach?: string|null },
 *   onDismissTip?: () => void,
 *   memory: { ops: Record<string, string> }, counts?: Record<string, number> | null,
 *   powerUps?: any[], onPowerUp?: (id: string) => void,
 *   onDie: (i: number) => void, onOp: (op: string) => void, onClear: () => void,
 *   canSend: boolean, claimWait: boolean, onTransmit: () => void,
 * }} props
 *   counts: the Scan power-up's sign counts (a badge per key; a 0 key goes grey).
 */
export default function FcControls({
  dice, usedBoard, tray, messages, onDismissTip, memory, counts = null, powerUps = [], onPowerUp = () => {},
  onDie, onOp, onClear, canSend, claimWait, onTransmit,
}) {
  return (
    <div data-testid="fc-controls" className="relative shrink-0 space-y-2 border-t border-cyan-300/10 bg-[#04030d]/85 px-3 pb-2 pt-1 backdrop-blur-sm">
      <TipSlot testId="fc-so-far" messages={messages} onDismissTip={onDismissTip} />
      <PowerUpTray powerUps={powerUps} onUse={onPowerUp} testId="fc-power-ups" />
      {/* Tray dice sized from the measured width (audit 2026-10-19: 48-px dice overflowed at 360). */}
      <div data-testid="fc-tray" data-tray-die={tray.die} className="flex justify-center" style={{ gap: tray.gap }}>
        {dice.map((v, i) => (
          <span key={i} data-used={usedBoard.includes(i) ? 'yes' : undefined} className="rounded-xl">
            {/* A die already in the row stays tappable (dimmed): tapping it MOVES it to the selected box. */}
            <SpaceDie value={v} size={tray.die} used={false} dim={usedBoard.includes(i)} onClick={() => onDie(i)} />
          </span>
        ))}
      </div>
      <div data-testid="fc-keys" className="grid grid-cols-7 gap-1.5">
        {SIGN_KEYS.map((op) => {
          const n = counts ? (counts[op] ?? 0) : null;
          const tone = n === 0 ? 'grey' : memory.ops[op];
          return (
            <button key={op} type="button" data-memory={memory.ops[op] || 'none'} data-count={n ?? undefined}
              onPointerDown={(e) => { e.preventDefault(); onOp(op); }}
              className={`relative h-12 min-w-0 rounded-xl border text-2xl font-black active:scale-90 ${MEMORY_KEY[tone] || 'border-cyan-400/40 bg-cyan-950/50 text-cyan-100'}`}>
              {DISPLAY[op]}
              {n != null && <span data-testid={`fc-count-${op}`} className="absolute right-1 top-0.5 text-[10px] font-black leading-none text-white">×{n}</span>}
            </button>
          );
        })}
        <button type="button" data-testid="fc-clear" onPointerDown={(e) => { e.preventDefault(); onClear(); }}
          className="col-span-2 h-12 min-w-0 rounded-xl border border-white/15 bg-white/5 text-sm font-bold text-slate-200 active:scale-90">⌫ Clear</button>
      </div>
      <PrimaryButton tone="cyan" testId="fc-transmit" disabled={!canSend || claimWait} onClick={onTransmit}>{claimWait ? 'Checking today’s signal…' : 'TRANSMIT 📡'}</PrimaryButton>
    </div>
  );
}

/** "Transmissions left" as dots (redesign Q3 = A): ● spent · ◉ this one · ○ left. */
export function TransmissionDots({ spent, max, over }) {
  const left = Math.max(0, max - spent);
  return (
    <div data-testid="fc-dots" data-spent={spent} className="mt-2 text-center text-xs text-slate-400">
      <span aria-hidden="true" className="tracking-[0.3em] text-cyan-300">
        {Array.from({ length: max }, (_, i) => (i < spent ? '●' : i === spent && !over ? '◉' : '○')).join('')}
      </span>
      <span className="ml-1">{over ? '' : `· ${left} transmission${left === 1 ? '' : 's'} left`}</span>
    </div>
  );
}
