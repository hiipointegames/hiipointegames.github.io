// The result blob a player's client writes for a finished battle run.
//
// Extracted from HeadToHeadGame's two finalize branches (saveResults and the
// early-exit path), which built the same nine-field object inline and byte-apart.
// It now has one tested home — and, more importantly, ONE definition to keep in
// step with the server's `_shared/battleResultBlob.ts`, which composes the same
// blob once BATTLE_SERVER_RESULT_ENABLED flips. Two copies of a jsonb shape that
// must agree is exactly how the finalize came to drop four fields (see that
// module's header: the badge gate).
//
// Every field here has a reader:
//   completed / run_status  → ChallengeResults, ChallengeList, challengeView
//   completed_date          → challengeView.stableDate, blitzBattleBadges ordering
//   total_time_seconds      → ChallengeResults' "Total Time", player/recommendations
//   fastest_solve_time      → the tiebreak, and blitzBattleBadges' bestFastestSolve
//   early_exit              → blitzBattleBadges' Total Eclipse
//   solutions[]             → the results review, Phoenix Rising, Photo Finish
//
// ET (not UTC) for completed_date: badge dates are the first 10 chars of this
// string, so a UTC stamp would file every evening battle on the next day.

import { nowET } from '@/daily-challenge';

/**
 * Build the stored result blob for a finished battle run, from this player's side.
 *
 * @param {object} p
 * @param {object} [p.base] - the player's existing result column, spread first.
 *   The early-exit path carries it forward (it may already hold fields written at
 *   accept time); the full-run path starts clean.
 * @param {Array<object>} p.solutions - this run's solves, in dice_sequence order.
 * @param {number} p.totalTimeSeconds - run length in seconds.
 * @param {number} p.fastestSolveTime - fastest single solve in seconds; `Infinity`
 *   when nothing was solved (the long-standing sentinel — it JSON-round-trips to
 *   null, which `fastestSolveOf` treats as absent).
 * @param {boolean} [p.earlyExit=false] - the player left before the clock ran out.
 * @param {string} [p.completedDate] - override the ET stamp (tests).
 * @returns {object} a new blob; `base` is never mutated.
 */
export function buildBattleRunResult({
  base,
  solutions,
  totalTimeSeconds,
  fastestSolveTime,
  earlyExit = false,
  completedDate,
}) {
  const runSolutions = Array.isArray(solutions) ? solutions : [];
  return {
    ...(base || {}),
    run_status: 'completed',
    completed: true,
    completed_date: completedDate || nowET().format('YYYY-MM-DD HH:mm:ss'),
    total_solved: runSolutions.length,
    total_time_seconds: totalTimeSeconds,
    fastest_solve_time: fastestSolveTime,
    solutions: runSolutions,
    early_exit: earlyExit,
  };
}
