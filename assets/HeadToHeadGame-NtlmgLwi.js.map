import React, { useState, useEffect, useCallback, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { CheckCircle, Trophy, X } from 'lucide-react';
import { apiClient } from '@/transport';
import { useNavigate } from 'react-router-dom';
import { validateChallengeModeRules, evaluateEquation, collectDraftErrors, isSubmittableSolution } from '@/equation-engine';
import { useEquationDraft } from '@/equation-draft';
import { generateBlitzDice } from '@/dice';

import { DailyChallengeGame, nowET } from '@/daily-challenge';
import { ChallengeWarningModal } from '@/game-flow';
import { ExitWarningModal } from '@/game-flow';
import { AwardCelebrationSequence, shuffleBoard, recordAnnouncedAwards, badgesUrlForAwards } from '@/game-flow';
import { playSound } from '@/ui/feedback';
import { getProfileById } from '@/player';
import { useHowToOverlay } from '@/how-to-play';
import { perspectiveOf } from './challengeView';
import { nextBattleDice } from './battleDice';
import { blitzDiceColors, blitzEnforcesPowerDice, resolveBlitzMode } from './blitzMode';
import { buildBlitzRunPayload, outcomeFor } from './blitzRunPayload';
import { finalizeBattleFromGame } from './battleWrites';
import { BATTLE_SERVER_RESULT_ENABLED } from './battleConfig';
import { finalizeBattleViaServer } from './submitBattleResult';
import { buildBattleRunResult } from './battleRunBlob';
import BattleVerifyingScreen from './BattleVerifyingScreen';
import { foldSoloBlitzRun } from './soloBlitzStats';
import { collectBattleAwards } from './blitzAwards';
import { useWakeLock } from './useWakeLock';
import { useRunFinish } from './useRunFinish';
import CelebrationGuard from './CelebrationGuard';
import { reportedFallback } from '@/observability';

/** Every ending leaves through one `finish` (useRunFinish): onFinished(payload) if given, else /BlitzStats.
 * `embedded` (Sector 73's overlay) drops "See it in Badges" and leaves the bottom nav to the host. `player` = an
 * already-loaded apiClient.auth.me() (no run without a user, F5); `autoStart` ends a run whose clock ran out unseen (F1).
 * @param {{ challenge?: any, soloMode?: any, durationSeconds?: number, onCancel: () => void, onFinished?: (payload: object) => void, embedded?: boolean, player?: any, autoStart?: boolean }} props */
export default function HeadToHeadGame({ challenge = null, soloMode = null, durationSeconds = 600, onCancel, onFinished, embedded = false, player = null, autoStart = false }) {
  // Timer duration (seconds). Both battle and solo honor the resolved
  // `durationSeconds` prop, falling back to the legacy 10-minute race when it is
  // absent. For battles the parent passes `challenge.time_limit_seconds ?? 600`,
  // so old rows / a missing column (flag OFF) resolve to 600 — identical to the
  // pre-M3 fixed-length race. Solo Blitz passes the player's chosen preset (4A),
  // client-only, so no battle-schema change is involved.
  const timerDuration = durationSeconds ?? 600;

  const [currentPuzzleIndex, setCurrentPuzzleIndex] = useState(0);
  // Battle-point award celebration queue — shown between finishing a battle and
  // returning to the Colosseum when a WIN crosses a battle-point tier.
  const [pendingAwards, setPendingAwards] = useState([]);
  const [dice, setDice] = useState([]);
  const [diceColors, setDiceColors] = useState(/** @type {readonly string[]} */ ([]));
  const {
    equation,
    usedDiceIndices,
    cursorPosition,
    clickDie,
    insertOperator,
    deleteAtCursor,
    clear: clearDraft,
    setCursor,
    remapDiceReferences,
  } = useEquationDraft(dice);
  const [timeRemaining, setTimeRemaining] = useState(timerDuration);
  const [solutions, setSolutions] = useState([]);
  const [puzzleStartTime, setPuzzleStartTime] = useState(null);
  const [isComplete, setIsComplete] = useState(false);
  const [shakeEquation, setShakeEquation] = useState(false);
  const [showWarning, setShowWarning] = useState(true);
  const [isActive, setIsActive] = useState(false);
  const [showExitWarning, setShowExitWarning] = useState(false);
  const [shakeButton, setShakeButton] = useState(false);
  const [showTryAgain, setShowTryAgain] = useState(false);
  const [showColorRuleError, setShowColorRuleError] = useState(false);
  // M3: covers the server-authoritative finalize round-trip (flag ON only).
  const [verifying, setVerifying] = useState(false);

  const user = useRef(player);
  const timerIntervalRef = useRef(null);
  const startTimeRef = useRef(null);
  const isSoloMode = !!soloMode;
  const navigate = useNavigate();
  const finish = useRunFinish({ onFinished, navigate });
  const solutionsRef = useRef([]);
  const hasExitedRef = useRef(false); // claimed by the first ending (time-up or Exit): one write
  const pendingExitRef = useRef(null); // results parked while the award celebration plays
  // Expert-only safety net: set when the vetted deck ran out, so the results
  // screen can say so rather than showing an ordinary time-up. With a 250-deck
  // against an all-time record of 61 solves this should never fire in production
  // — if it does, that is a signal, not a feature. See battleDice.js.
  const deckClearedRef = useRef(false);
  // In-place how-to overlay for the Blitz pre-game warning's "View How to Play"
  // (battle + solo, both modes). Opening it overlays the warning and closes back
  // to it — never navigates away. (2026-07-08 beta finding: the Blitz pre-game
  // screen had no how-to affordance at all, unlike Daily/Easy/Challenge.)
  const { requestWakeLock, releaseWakeLock } = useWakeLock();
  const { openHowTo, howToNode } = useHowToOverlay();

  useEffect(() => {
    const loadUser = async () => {
      user.current = await apiClient.auth.me();
      // Don't auto-start - let warning modal show first
    };
    if (!user.current) loadUser();
  }, []);
  useEffect(() => { if (autoStart) startChallenge(); }, []);

  // Initialize game data on confirmation
  // CRITICAL: Blitz timer lifecycle must not be coupled to reusable components
  const startChallenge = () => {
    // Request wake lock to prevent screen sleep
    requestWakeLock();

    if (isSoloMode) {
      // Solo mode - generate random dice
      setDice(generateBlitzDice());
      // Colours come from the tier, via the one resolver. This used to be an
      // inline `=== 'challenge'` ternary — one of six — every one of which would
      // have dealt Expert an all-white board.
      setDiceColors(blitzDiceColors(soloMode));
      setPuzzleStartTime(Date.now());
      startTimeRef.current = Date.now();
      setTimeRemaining(timerDuration);
      setShowWarning(false);
      setIsActive(true);
      startTimer();
    } else if (challenge && challenge.dice_sequence && challenge.dice_sequence.length > 0) {
      // Battle mode — colours come from the tier, same resolver as solo.
      setDiceColors(blitzDiceColors(resolveBlitzMode({ challenge })));
      const { myResult, myResultKey } = perspectiveOf(challenge, user.current?.id);

      // Check if resuming - restore previous progress
      if (myResult?.run_status === 'in_progress' && myResult?.start_time) {
        const elapsedSeconds = (Date.now() - new Date(myResult.start_time).getTime()) / 1000;
        const remaining = Math.max(0, timerDuration - elapsedSeconds);

        if (remaining <= 0) {
          solutionsRef.current = myResult.solutions || []; // time ran out while away: end with the solves already saved
          handleTimeUp();
          return;
        }

        // Restore progress.
        //
        // ⚠️ THE BUG THIS FIXES. The resume path used to index the array directly
        // — `dice_sequence[n] || dice_sequence[0]` — instead of going through
        // `nextBattleDice`. Past the stored deck that `||` fired and silently
        // served PUZZLE 0 again, desyncing a refreshing player from an opponent
        // who had not refreshed. Reachable today: 43 of 71 production battles
        // carry a 10-length deck and players have reached index 61.
        const resumeIndex = myResult.solutions?.length || 0;
        const resumeDice = nextBattleDice(challenge, resumeIndex);
        if (resumeDice === null) {
          // Expert exhausted its vetted deck while away: ending is the only safe answer (battleDice).
          solutionsRef.current = myResult.solutions || []; // ...with the solves already saved
          handleTimeUp();
          return;
        }
        setSolutions(myResult.solutions || []);
        setCurrentPuzzleIndex(resumeIndex);
        setDice(resumeDice);
        setTimeRemaining(remaining);
        startTimeRef.current = Date.now() - (elapsedSeconds * 1000);
        setPuzzleStartTime(Date.now());
      } else {
        // Starting fresh
        setDice(challenge.dice_sequence[0]);
        startTimeRef.current = Date.now();
        setTimeRemaining(timerDuration);

        // Save start time
        const updateData = {
          [myResultKey]: { ...myResult, run_status: 'in_progress', start_time: new Date().toISOString() },
        };
        apiClient.entities.HeadToHeadChallenge.update(challenge.id, updateData);
      }

      setPuzzleStartTime(Date.now());
      setShowWarning(false);
      setIsActive(true);
      startTimer();
    }
  };

  // CRITICAL: Blitz timer must maintain single session authority - no coupling to UI components
  const startTimer = () => {
    if (timerIntervalRef.current) {
      clearInterval(timerIntervalRef.current);
      timerIntervalRef.current = null;
    }

    timerIntervalRef.current = setInterval(() => {
      if (!startTimeRef.current) return;
      const elapsed = (Date.now() - startTimeRef.current) / 1000;
      const remaining = Math.max(0, timerDuration - elapsed);
      setTimeRemaining(remaining);

      if (remaining <= 0) {
        clearInterval(timerIntervalRef.current);
        timerIntervalRef.current = null;
        handleTimeUp();
      }
    }, 100);
  };

  const stopTimer = () => {
    if (timerIntervalRef.current) {
      clearInterval(timerIntervalRef.current);
      timerIntervalRef.current = null;
    }
  };

  // Cleanup on unmount
  useEffect(() => {
    return () => {
      releaseWakeLock();
      stopTimer();
    };
  }, []);

  const handleTimeUp = async () => {
    // One ending per run: clock, dry deck and a confirmed "Exit" can race; first wins.
    if (hasExitedRef.current) return;
    hasExitedRef.current = true;
    stopTimer();
    setIsActive(false);
    releaseWakeLock();

    // Use ref to get accurate solutions count
    const finalSolutions = solutionsRef.current;
    const totalTime = timerDuration;

    console.log('⏰ TIME UP - Saving stats. Mode:', soloMode, 'Solutions:', finalSolutions.length);

    // Save to the database FIRST, and use what it learned.
    //
    // ⚠️ THE BUG THIS FIXES. The payload used to be built BEFORE this call, with
    // `opponentName: null` hard-coded and no outcome at all — so the normal
    // clock-expiry path, which is how most battles end, reached the results
    // screen unable to say who won. `saveResults` already resolved the winner; it
    // simply threw the answer away. Broken for Easy and Challenge too, not just
    // Expert.
    const settled = await saveResults();

    const payload = buildBlitzRunPayload({
      challenge,
      soloMode,
      solutions: finalSolutions,
      totalTime,
      startedAtMs: startTimeRef.current,
      outcome: settled?.outcome,
      opponentName: settled?.opponentName ?? null,
      opponentScore: settled?.opponentScore ?? null,
      deckCleared: deckClearedRef.current,
      saved: !!settled, // false: nothing was written (offline, rejected, no user) — the host must not say "logged"
    });

    // Celebrate, THEN leave: the sequence's onComplete calls finish() (it used to navigate at once, unmounting them).
    if (settled?.awards?.length) {
      pendingExitRef.current = payload;
      setShowWarning(false); // a resume whose clock already ran out ends from behind the warning
      setShowExitWarning(false);
      setPendingAwards(settled.awards);
      return;
    }
    finish(payload);
  };

  // ⚠️ THIS IS NOT A FORFEIT, DESPITE WHAT IT WAS CALLED.
  //
  // It was named `forfeitChallenge` while doing the opposite: it writes
  // `run_status: 'completed'`, `completed: true` and `early_exit: true` with the
  // player's solutions, total time and fastest solve intact (buildBattleRunResult).
  // A player who leaves early keeps everything they solved and CAN STILL WIN if
  // that beats their opponent. Only the Daily has a real forfeit.
  //
  // Renamed 2026-09-12 because the old name caused an actual misdiagnosis: asked
  // to check the battle rules copy, I read the call site, saw `endBattleEarly()`
  // and reported to David that leaving a battle forfeits it. It does not, and the
  // body said so in a comment the whole time. A name is not evidence of behaviour,
  // but it is what a reader reaches for first — so the name is now the truth.
  const endBattleEarly = async () => {
    try {
      if (!user.current || hasExitedRef.current) return;
      hasExitedRef.current = true;

      releaseWakeLock();
      stopTimer();

      if (isSoloMode) {
        // Solo mode - navigate to stats with current progress
        const totalTime = timerDuration - timeRemaining;
        const finalSolutions = solutionsRef.current;

        await saveResults();

        finish(buildBlitzRunPayload({
          soloMode,
          solutions: finalSolutions,
          totalTime,
          startedAtMs: startTimeRef.current,
          earlyExit: true,
        }));
        return;
      }

      // Save current stats (not a forfeit - just early completion with partial stats)
      const { myResult, myResultKey, opponentResultKey, opponentId } = perspectiveOf(challenge, user.current.id);

      const totalTime = timerDuration - timeRemaining;
      const finalSolutions = solutionsRef.current;

      // Calculate fastest solve time for tiebreaker
      const fastestSolve = finalSolutions.length > 0
        ? Math.min(...finalSolutions.map(s => s.solve_time))
        : Infinity;

      const completedResult = buildBattleRunResult({
        base: myResult,
        solutions: finalSolutions,
        totalTimeSeconds: totalTime,
        fastestSolveTime: fastestSolve,
        earlyExit: true,
      });

      const updateData = { [myResultKey]: completedResult };

      await apiClient.entities.HeadToHeadChallenge.update(challenge.id, updateData);

      // Re-fetch challenge to get fresh opponent status and opponent profile
      const freshChallenge = await apiClient.entities.HeadToHeadChallenge.filter({ id: challenge.id });
      const updatedChallenge = freshChallenge[0];
      const freshOpponentResult = updatedChallenge[opponentResultKey];

      // Fetch opponent profile for name
      const opponentFinished = !!(freshOpponentResult?.completed
        || freshOpponentResult?.run_status === 'completed');
      let opponentName = null;
      let opponentTotalSolved = null;
      if (opponentFinished) {
        const opponentProfile = await getProfileById(opponentId);
        if (opponentProfile) {
          opponentName = opponentProfile.username;
        }
        // Read the score whether or not the profile lookup succeeded — a missing
        // username must not also cost the player their opponent's score.
        opponentTotalSolved = freshOpponentResult.total_solved || 0;
      }

      // Check if opponent already completed - if so, finalize the battle now
      // (decide winner + persist status/winner_id + fold into blitzStats).
      let earlyExitWinner = null;
      if (opponentFinished) {
        if (BATTLE_SERVER_RESULT_ENABLED) {
          // M3: server-authoritative finalize on early-exit too.
          setVerifying(true);
          const outcome = await finalizeBattleViaServer({
            challengeId: challenge.id,
            myId: user.current.id,
            solutions: finalSolutions,
            totalTimeSeconds: totalTime,
            earlyExit: true,
          });
          setVerifying(false);
          earlyExitWinner = outcome?.winnerId ?? null;
        } else {
          earlyExitWinner = await finalizeBattleFromGame({
            challengeId: challenge.id,
            myId: user.current.id,
            opponentId,
            myScore: finalSolutions.length,
            opponentScore: freshOpponentResult.total_solved || 0,
            myFastestSolve: fastestSolve,
            opponentFastestSolve: freshOpponentResult.fastest_solve_time,
            opponentSolutions: freshOpponentResult.solutions,
          });
        }
      }

      finish(buildBlitzRunPayload({
        challenge,
        solutions: finalSolutions,
        totalTime,
        startedAtMs: startTimeRef.current,
        earlyExit: true,
        outcome: outcomeFor({
          winnerId: earlyExitWinner,
          myId: user.current.id,
          opponentFinished,
        }),
        opponentName,
        opponentScore: opponentTotalSolved,
        deckCleared: deckClearedRef.current,
      }));
    } catch (error) {
      console.error('Failed to save partial results:', error);
      onCancel();
    }
  };

  const saveResults = async () => {
    try {
      if (!user.current) return;

      releaseWakeLock();
      stopTimer();

      if (isSoloMode) {
        // Solo mode — fold this run into soloBlitz stats + persist. The caller
        // leaves via finish().
        const currentUser = await apiClient.auth.me();
        const runSolutions = solutionsRef.current;
        const gameStats = foldSoloBlitzRun(
          currentUser['game_stats'], soloMode, runSolutions.length,
          runSolutions.length > 0 ? Math.min(...runSolutions.map((s) => s.solve_time)) : null,
        );
        await apiClient.auth.updateMe({ game_stats: gameStats });
        return;
      }

      const { myResultKey, opponentResultKey, opponentId } = perspectiveOf(challenge, user.current.id);

      // Use ref for accurate count
      const finalSolutions = solutionsRef.current;

      // Calculate actual time used
      const elapsedTime = startTimeRef.current ? (Date.now() - startTimeRef.current) / 1000 : timerDuration;
      const totalTime = Math.min(elapsedTime, timerDuration);

      const fastestSolve = finalSolutions.length > 0
        ? Math.min(...finalSolutions.map(s => s.solve_time))
        : Infinity;

      const result = buildBattleRunResult({
        solutions: finalSolutions,
        totalTimeSeconds: totalTime,
        fastestSolveTime: fastestSolve,
      });

      const updateData = { [myResultKey]: result };

      await apiClient.entities.HeadToHeadChallenge.update(challenge.id, updateData);

      // Re-fetch challenge to get fresh opponent status
      const freshChallenge = await apiClient.entities.HeadToHeadChallenge.filter({ id: challenge.id });
      const updatedChallenge = freshChallenge[0];

      // Check if both players completed - only then finalize and update stats
      const otherResult = updatedChallenge[opponentResultKey];
      // A battle is only decidable once the opponent is in. Named so the outcome
      // can distinguish "we tied" from "they have not played yet" — both of which
      // leave `winner` null, and conflating them would tell the first player to
      // finish that they had drawn a battle nobody else had started.
      const opponentFinished = !!(otherResult?.completed || otherResult?.run_status === 'forfeited');
      let winner = null;
      if (opponentFinished) {
        if (BATTLE_SERVER_RESULT_ENABLED) {
          // M3: server re-verifies + scores + writes the authoritative winner_id
          // (client never decides). Verifying screen covers the round-trip.
          setVerifying(true);
          const outcome = await finalizeBattleViaServer({
            challengeId: challenge.id,
            myId: user.current.id,
            solutions: finalSolutions,
            totalTimeSeconds: totalTime,
          });
          setVerifying(false);
          winner = outcome.winnerId;
        } else {
          // Legacy client-side finalize (decide winner + persist + blitzStats).
          winner = await finalizeBattleFromGame({
            challengeId: challenge.id,
            myId: user.current.id,
            opponentId,
            myScore: finalSolutions.length,
            opponentScore: otherResult.total_solved || 0,
            myFastestSolve: result.fastest_solve_time,
            opponentFastestSolve: otherResult.fastest_solve_time,
            opponentSolutions: otherResult.solutions,
          });
        }
      }

      // What the caller needs to tell the player. Computed here because this is
      // where the winner is actually known — it used to be discarded, which is
      // why the results screen could not name a victor.
      const settled = {
        outcome: outcomeFor({ winnerId: winner, myId: user.current.id, opponentFinished }),
        opponentName: null,
        opponentScore: otherResult?.total_solved ?? null,
      };
      if (opponentFinished && opponentId) {
        const opponentProfile = await getProfileById(opponentId).catch(reportedFallback('battle.opponent'));
        settled.opponentName = opponentProfile?.username ?? null;
      }

      // Celebrate whatever this battle just earned, before returning to the
      // Colosseum. Two families, and until now only the first one worked.
      //
      // ⚠️ THE BUG THIS FIXES. This called `detectNewAwards({ points })` with NO
      // `badges` argument, so a badge earned in a BATTLE was structurally
      // unannounceable — the sixth award family could not fire. The solve path
      // was fixed on 2026-09-03 (docs/bugs.md); the battle path was left behind.
      //
      // Badge state is read through game-flow's PUBLIC surface, the same one the
      // solve path uses, so a badge announces exactly once whichever surface
      // reaches it first. Nothing here names a badge id or counts badges — that
      // vocabulary is owned elsewhere and is actively changing.
      //
      // Best-effort throughout: this runs on a screen the player has already
      // finished, so no failure here may block navigation. The caller shows
      // them, then exits — saveResults itself never leaves (it used to call the
      // host's onComplete() here, a second exit on top of the caller's).
      const awards = await collectBattleAwards({
        isWinner: !!winner && winner === user.current.id,
        userId: user.current.id,
      });
      return { ...settled, awards };
    } catch (error) {
      console.error('Failed to save results:', error);
      return null;
    }
  };

  const handleDiceClick = useCallback((index) => {
    if (!isActive) return;
    clickDie(index);
  }, [isActive, clickDie]);

  const handleOperatorClick = useCallback((operator) => {
    if (!isActive) return;
    const { rejected } = insertOperator(operator);
    if (rejected) {
      setShakeEquation(true);
      setTimeout(() => setShakeEquation(false), 500);
    }
  }, [isActive, insertOperator]);

  const handleDelete = useCallback(() => {
    if (!isActive) return;
    deleteAtCursor();
  }, [isActive, deleteAtCursor]);

  const handleClear = useCallback(() => {
    clearDraft();
  }, [clearDraft]);

  // Uses game-flow's shared `shuffleBoard` rather than the hand-rolled
  // Fisher-Yates this file used to carry. The two were the same algorithm with
  // the same three coupled invariants (dice move, POSITIONAL colours move with
  // them, the draft's board indices follow) — a clone whose halves could drift.
  const handleShuffle = useCallback(() => {
    playSound('swosh');
    // `diceColors` is held as readonly (the palettes are frozen constants);
    // shuffleBoard takes a mutable array, so copy rather than widen the state.
    const next = shuffleBoard({ dice, diceColors: [...diceColors] });
    setDice(next.dice);
    setDiceColors(next.diceColors);
    remapDiceReferences(next.indexMap);
  }, [dice, diceColors, remapDiceReferences]);

  const handleSubmit = useCallback(async () => {
    // Build shuffledDice for submission validation
    const shuffledDiceForValidation = dice.map((value, idx) => ({
      value,
      color: diceColors[idx] || 'white',
      originalIndex: idx,
      id: idx
    }));

    const { valid, result } = evaluateEquation(equation, usedDiceIndices, shuffledDiceForValidation);
    const mode = resolveBlitzMode({ soloMode, challenge });
    // ⚠️ THE MODE ARGUMENT IS LOAD-BEARING. `validateChallengeModeRules` was
    // called here WITHOUT it, and an omitted mode means the legacy contract:
    // exactly 2 power dice correct, whatever the tier. That is right for
    // Challenge and WRONG for Expert, which requires all 3. Passing the mode is
    // what makes Expert perfect-only — the same fix the Daily got in 2f6f918,
    // which deliberately left head-to-head alone because no Expert tier existed
    // yet.
    const challengeRulesMet = blitzEnforcesPowerDice(mode)
      ? validateChallengeModeRules(equation, usedDiceIndices, dice, diceColors, mode)
      : true;

    // Defense in depth: never accept a submit with a resting structural error.
    if (collectDraftErrors(equation, usedDiceIndices).length > 0) return;

    if (valid && result === 37 && usedDiceIndices.length === 7) {
      // Play specific success sound based on mode
      if (isSoloMode) {
        playSound('soloBlitzSubmit');
      } else {
        playSound('swordClash');
      }
      // Power-dice rule: Challenge needs 2 of 3, Expert needs all 3, Easy has no
      // coloured dice at all. A failure REFUSES the solve — the puzzle index does
      // not advance and nothing is recorded, which is exactly how Expert's Daily
      // behaves and what David ruled for Expert battles (D3).
      if (blitzEnforcesPowerDice(mode) && !challengeRulesMet) {
        setShakeButton(true);
        setShowTryAgain(true);
        setShowColorRuleError(true);
        setTimeout(() => {
          setShakeButton(false);
          setShowTryAgain(false);
          setShowColorRuleError(false);
        }, 3000);
        return;
      }
      const solveTime = (Date.now() - puzzleStartTime) / 1000;

      const newSolution = {
        dice: [...dice],
        colors: [...diceColors],
        equation: equation,
        solve_time: solveTime,
        usedDiceIndices: [...usedDiceIndices]
      };

      const updatedSolutions = [...solutions, newSolution];
      setSolutions(updatedSolutions);
      solutionsRef.current = updatedSolutions;

      // Save progress to database for battle mode (allows resume after refresh)
      if (!isSoloMode && challenge) {
        const { myResult, myResultKey } = perspectiveOf(challenge, user.current.id);
        const progressUpdate = {
          ...myResult,
          run_status: 'in_progress',
          solutions: updatedSolutions,
          total_solved: updatedSolutions.length
        };
        const updateData = { [myResultKey]: progressUpdate };
        apiClient.entities.HeadToHeadChallenge.update(challenge.id, updateData).catch(err => {
          console.error('Failed to save progress:', err);
        });
      }

      if (isSoloMode) {
        // Solo mode - generate new dice
        setDice(generateBlitzDice());
        setDiceColors(blitzDiceColors(soloMode));
        clearDraft();
        setPuzzleStartTime(Date.now());
        setCurrentPuzzleIndex(prev => prev + 1);
      } else {
        // Head-to-head mode
        const nextIndex = currentPuzzleIndex + 1;

        // Battle continues until the timer runs out. Both players must race the
        // identical puzzle at each index: read the shared stored `dice_sequence`
        // while in range, then fall back to a DETERMINISTIC seed (challenge.id +
        // index) so the two devices stay in sync past the array's end. The old
        // `generateBlitzDice()` fallback here rolled per-client Math.random, so
        // opponents diverged once past the sequence — see docs/bugs.md 2026-07-30.
        const nextDice = nextBattleDice(challenge, nextIndex);

        // Expert has run out of VETTED puzzles. Ending the run is the only safe
        // answer — dealing the unvetted deterministic roll could hand both
        // players a puzzle with no findable perfect solve, in a race whose index
        // does not advance until someone finds one. With a 250-deck against an
        // all-time record of 61 solves this should never happen; it is an
        // assertion boundary, not an ending anyone is meant to reach.
        if (nextDice === null) {
          deckClearedRef.current = true;
          handleTimeUp();
          return;
        }

        setCurrentPuzzleIndex(nextIndex);
        setDice(nextDice);

        // CRITICAL: Reset colors to base configuration for each puzzle
        // This ensures colored dice appear in same positions for all players
        setDiceColors(blitzDiceColors(resolveBlitzMode({ challenge })));
        clearDraft();
        setPuzzleStartTime(Date.now());
      }
    } else {
      setShakeEquation(true);
      setTimeout(() => setShakeEquation(false), 500);
    }
  }, [equation, usedDiceIndices, dice, currentPuzzleIndex, challenge, puzzleStartTime, solutions, isSoloMode, soloMode]);

  // Build shuffledDice structure
  const shuffledDice = dice.map((value, idx) => ({
    value,
    color: diceColors[idx] || 'white',
    originalIndex: idx,
    id: idx
  }));

  const { valid, result } = evaluateEquation(equation, usedDiceIndices, shuffledDice);
  const mode = resolveBlitzMode({ soloMode, challenge });

  // Structural errors block Submit but never editing (see collectDraftErrors).
  const draftErrors = collectDraftErrors(equation, usedDiceIndices);
  // The SUBMIT BUTTON's gate. It must ask the same question the submit handler
  // asks, with the same mode — otherwise the button lights up for a solve the
  // handler then refuses, which is precisely the shape of the Expert bug on the
  // Daily (a celebrated win the server threw away).
  const challengeRulesMet = blitzEnforcesPowerDice(mode)
    ? validateChallengeModeRules(equation, usedDiceIndices, dice, diceColors, mode)
    : true;
  // Shared win gate + this surface's liveness guards (round not done + active).
  const canSubmit = isSubmittableSolution({ valid, result, usedDiceIndices, challengeRulesMet, draftErrors }) && !isComplete && isActive;

  if (showWarning && autoStart) return null; // no warning for a run that is already over; finish() follows the save
  if (showWarning) {
    const warnMode = isSoloMode ? soloMode : (challenge?.blitz_mode || 'easy');
    return (
      <>
        <ChallengeWarningModal
          isOpen={showWarning}
          onConfirm={startChallenge}
          onCancel={onCancel}
          mode="blitz"
          isSolo={isSoloMode}
          gameMode={warnMode}
          onHowTo={() => openHowTo(warnMode, { context: 'go-back', hidesNav: !embedded })}
        />
        {howToNode}
      </>
    );
  }

  return (
    <>
      {/* M3: server-authoritative finalize is in flight — covers the round-trip
          so the client never flashes a client-computed result first. */}
      {verifying && <BattleVerifyingScreen />}

      {/* Battle-point award celebration — plays after a battle's clock runs out, before the
          results. The guard leaves for the results if it crashes or sticks (CelebrationGuard). */}
      <CelebrationGuard active={pendingAwards.length > 0} onGiveUp={() => finish(pendingExitRef.current)}>
      <AwardCelebrationSequence
        awards={pendingAwards}
        isOpen={pendingAwards.length > 0}
        hidesNav={!embedded}
        onComplete={() => {
          // Whoever drains a queue records that queue — ALL of it, the battle
          // medal as well as the badges. Only now has the player actually SEEN
          // them; recording earlier marks a moment announced that never rendered.
          try { recordAnnouncedAwards(pendingAwards, user.current?.id); } catch { /* never block the exit */ }
          setPendingAwards([]);
          finish(pendingExitRef.current);
        }}
        // Record, push the result (/BlitzStats) THEN Badges, so Back lands on the
        // result. Not offered embedded: Sector 73 keeps the player in the world.
        onSeeBadges={embedded ? undefined : (stepAwards) => {
          try { recordAnnouncedAwards(pendingAwards, user.current?.id); } catch { /* never block the exit */ }
          setPendingAwards([]);
          finish(pendingExitRef.current);
          navigate(badgesUrlForAwards(stepAwards));
        }}
      />
      </CelebrationGuard>

      {/* Exit Warning Modal */}
      <ExitWarningModal
        isOpen={showExitWarning}
        onConfirmExit={() => {
          stopTimer();
          endBattleEarly();
        }}
        onCancel={() => setShowExitWarning(false)}
        isSoloBlitz={isSoloMode}
        isBattleBlitz={!isSoloMode}
        blitzDurationSeconds={timerDuration}
      />

      {/* Compact Mobile Screen */}
      <DailyChallengeGame
        dice={dice}
        diceColors={diceColors}
        equation={equation}
        usedDiceIndices={usedDiceIndices}
        solved={isComplete}
        dailyChallengeTimer={timeRemaining}
        onDiceClick={handleDiceClick}
        onOperatorClick={handleOperatorClick}
        onDelete={handleDelete}
        onClear={handleClear}
        onSubmit={handleSubmit}
        showColorRuleError={showColorRuleError}
        shakeButton={shakeButton}
        showTryAgain={showTryAgain}
        mode={isSoloMode ? soloMode : (challenge?.blitz_mode || 'easy')}
        themeMode={isSoloMode ? 'solo-blitz' : 'blitz-battle'}
        cursorPosition={cursorPosition}
        onCursorPositionChange={setCursor}
        onExit={() => setShowExitWarning(true)}
        onRollNewDice={undefined}
        onShuffle={handleShuffle}
        equationsSolved={solutions.length}
        shuffledDice={shuffledDice}
        timerMaxDuration={timerDuration}
      />
    </>
  );
}