// blitzRunPayload — builds the object handed to /BlitzStats via router state.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS EXISTS
// ─────────────────────────────────────────────────────────────────────────────
// `HeadToHeadGame.jsx` built this object THREE times, as three near-identical
// literals (solo time-up, solo forfeit, battle early-exit), each ~25 lines. They
// had already drifted: only the early-exit one attached `opponentName`, so the
// NORMAL clock-expiry path — the way most battles end — reached the results
// screen with `opponentName: null` hard-coded and no winner information at all.
// A player finished a battle and the app never told them whether they had won.
//
// ⚠️ NOT TO BE CONFUSED WITH `battleRunBlob.js`. That builds the DATABASE result
// blob (`challenger_result` / `opponent_result`) and its field names are a
// storage contract read by badges and stats. THIS builds the throwaway NAVIGATION
// payload for one screen. They are different objects with overlapping names and
// must not be merged.
//
// ─────────────────────────────────────────────────────────────────────────────
// TWO FIELDS ARE DELIBERATELY GONE
// ─────────────────────────────────────────────────────────────────────────────
// `accuracyPercent: 100` and `equationsSolvedIncorrectly: 0` were CONSTANTS
// rendered as measurements. They could not be anything else: an incorrect
// submission returns early from the submit handler and is never recorded
// anywhere, so the app has no idea how many a player got wrong. A statistic that
// is structurally incapable of varying is not a statistic.
//
// They are removed rather than fixed. Making them real means building a
// miss-tracking pipeline and deciding what a "miss" is in a no-skip speed race —
// a feature, not a bug fix. The tiles that read them are removed in the same
// commit, so nothing renders a default 0 in their place.
//
// ─────────────────────────────────────────────────────────────────────────────
// AND FIVE MORE WENT ON 2026-09-10
// ─────────────────────────────────────────────────────────────────────────────
// `mode`, `totalTime`, `completedAt` and `solutions` were duplicates of
// `blitz_mode`, `totalDuration`, `endTimestamp` and `solveBreakdown`, emitted
// only because BlitzStats destructured both sets behind a "LEGACY FORMAT
// (pre-2024)" comment. Since this producer always wrote BOTH halves of every
// pair, the legacy half never once won a fallback — it was an echo, not a
// compatibility shim. BlitzStats stopped reading them in the same commit.
//
// `averageSolveTimeMs` went with them. It was `(totalTime / solved) * 1000` —
// wall-clock divided by solves — rendered under the label "Avg Per Puzzle" beside
// two REAL per-solve measurements. The screen now takes the mean of the solves in
// `solveBreakdown`, which is what the label always claimed.
import { resolveBlitzMode } from './blitzMode';

/**
 * Outcome of a finished battle, from the perspective of the player who just
 * finished. `unresolved` is a real state, not an error: a battle finalizes only
 * when the SECOND player finishes, so whoever finishes first legitimately does
 * not know the result yet.
 * @typedef {'win'|'loss'|'tie'|'unresolved'} BattleOutcome
 */

/**
 * Decide the outcome for the player who just finished.
 *
 * Kept separate from `resolveBattleWinner` (which answers "who won?" for the
 * DATABASE) because this answers "what do I tell THIS player?", and the two give
 * different answers in the common case: a null winner means "tie" once both
 * sides are in, but "not decided yet" when the opponent has not played.
 *
 * @param {{ winnerId: string|null|undefined, myId: string, opponentFinished: boolean }} args
 * @returns {BattleOutcome}
 */
export const outcomeFor = ({ winnerId, myId, opponentFinished }) => {
  if (!opponentFinished) return 'unresolved';
  if (!winnerId) return 'tie';
  return winnerId === myId ? 'win' : 'loss';
};

/**
 * Build the /BlitzStats navigation payload for a finished run.
 *
 * @param {object} args
 * @param {{id: string, blitz_mode?: string}|null} [args.challenge] battle row, or null for solo
 * @param {string|null} [args.soloMode] solo tier, or null for a battle
 * @param {Array<object>} args.solutions the run's accepted solves
 * @param {number} args.totalTime seconds actually played
 * @param {number} [args.startedAtMs] Date.now() when the run began
 * @param {boolean} [args.earlyExit] did the player leave before the clock expired
 * @param {BattleOutcome} [args.outcome] battles only
 * @param {string|null} [args.opponentName]
 * @param {number|null} [args.opponentScore]
 * @param {boolean} [args.deckCleared] Expert safety net — see blitzDeck
 * @param {boolean} [args.saved] battles only: did this run's result write land? (false = time-up save failed)
 * @returns {object} router state for /BlitzStats
 */
export const buildBlitzRunPayload = ({
  challenge = null,
  soloMode = null,
  solutions = [],
  totalTime = 0,
  startedAtMs = null,
  earlyExit = false,
  outcome = undefined,
  opponentName = null,
  opponentScore = null,
  deckCleared = false,
  saved = true,
}) => {
  const isBattle = !soloMode;
  const mode = resolveBlitzMode({ soloMode, challenge });
  const completedAt = new Date().toISOString();
  const startTimestamp = startedAtMs ? new Date(startedAtMs).toISOString() : completedAt;
  const solved = solutions.length;

  return {
    blitzId: challenge?.id ?? `solo-${completedAt}`,
    modeType: isBattle ? 'battle' : mode,
    blitz_mode: mode,
    startTimestamp,
    endTimestamp: completedAt,
    totalDuration: totalTime,
    equationsAttempted: solved,
    equationsSolvedCorrectly: solved,
    solveBreakdown: solutions.map((sol) => ({
      diceSequence: sol.dice,
      // The stored per-solve colours, never re-derived from the mode: a solve is
      // a historical record of the board the player actually saw.
      diceColors: sol.colors,
      equationUsed: sol.equation,
      timeToSolveMs: sol.solve_time * 1000,
      isCorrect: true,
      usedDiceIndices: sol.usedDiceIndices,
    })),
    isBattle,
    earlyExit,
    // Battle-only. Absent for solo so the screen can distinguish "solo run" from
    // "battle whose result we failed to compute".
    // `saved` is false only when the time-up write failed: the outcome is then
    // 'unresolved' because nothing is known, not because the opponent is still to play.
    ...(isBattle ? { outcome: outcome ?? 'unresolved', opponentName, opponentScore, saved } : {}),
    ...(deckCleared ? { deckCleared: true } : {}),
  };
};
