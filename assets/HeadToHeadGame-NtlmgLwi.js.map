import { useCallback, useEffect, useRef } from 'react';
import { createPageUrl } from '@/routing/createPageUrl';

// useRunFinish — the ONE way a Blitz run (battle or solo) leaves HeadToHeadGame.
//
// There used to be three hand-written `navigate('/BlitzStats', …)` calls (clock
// expiry, a solo "Exit", a battle "Exit"), and the clock path ALSO called the
// host's `onComplete()` from inside saveResults just before navigating — two
// exits for one run, with the award celebration unmounted in between (research
// synthesis, CONTRADICTION 1). Every ending now funnels through `finish`.
//
// Contract:
//   • `finish(payload)` runs at most once per mount. A second call (the clock
//     landing while an "Exit" is mid-save, a double tap) is a no-op.
//   • With `onFinished` → `onFinished(payload)` and no navigation: the host
//     (Sector 73's battle overlay) decides what comes next.
//   • Without it → `navigate('/BlitzStats', { state: payload })`, exactly what
//     the Colosseum has always done.
//   • `payload` is buildBlitzRunPayload's object — the /BlitzStats router state.
//   • Callers finish AFTER the result write has settled; this hook does no I/O.
//   • After unmount it is a no-op. "Not Now" during a resumed-expired run's save
//     closes the game while the save is in flight; the host must not then get an
//     exit (Colosseum: a yank to /BlitzStats; embedded: onFinished on a closed overlay).
//
// `onFinished` is read through a ref so a timer callback captured at start time
// still reaches the host's latest handler.

/**
 * @param {{ onFinished?: (payload: object) => void, navigate: (to: string, opts?: object) => void }} args
 * @returns {(payload: object) => void}
 */
export function useRunFinish({ onFinished, navigate }) {
  const doneRef = useRef(false);
  const mountedRef = useRef(false);
  const onFinishedRef = useRef(onFinished);
  onFinishedRef.current = onFinished;

  useEffect(() => {
    mountedRef.current = true;
    return () => { mountedRef.current = false; };
  }, []);

  return useCallback((payload) => {
    if (doneRef.current || !mountedRef.current) return;
    doneRef.current = true;
    const host = onFinishedRef.current;
    if (host) host(payload);
    else navigate(createPageUrl('BlitzStats'), { state: payload });
  }, [navigate]);
}
