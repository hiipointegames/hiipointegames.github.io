// useWakeLock — hold the screen awake for the duration of a timed Blitz run.
//
// A Blitz run is up to ten minutes during which the player may spend a long
// stretch thinking without touching the screen. Without a wake lock the device
// dims and sleeps mid-race, and the clock keeps running.
//
// Extracted from HeadToHeadGame.jsx, where the lock ref and its two async
// helpers were inline. The behaviour is deliberately unchanged, including that
// BOTH helpers swallow their errors: `navigator.wakeLock` is unavailable on some
// browsers and rejects outright when the document is not visible, and neither is
// a reason to interrupt a game. The lock is a comfort, not a correctness
// requirement — nothing downstream may branch on whether it was acquired.
import { useRef, useCallback } from 'react';

/**
 * @returns {{ requestWakeLock: () => Promise<void>, releaseWakeLock: () => Promise<void> }}
 */
export function useWakeLock() {
  const wakeLockRef = useRef(/** @type {any} */ (null));

  const requestWakeLock = useCallback(async () => {
    try {
      if ('wakeLock' in navigator) {
        wakeLockRef.current = await (/** @type {any} */ (navigator).wakeLock.request('screen'));
        console.log('Wake Lock active');
      }
    } catch (err) {
      console.error('Wake Lock error:', err);
    }
  }, []);

  const releaseWakeLock = useCallback(async () => {
    if (wakeLockRef.current) {
      try {
        await wakeLockRef.current.release();
        // Cleared even on a failed release: a stale handle would make a later
        // request think a lock was already held and skip re-acquiring it.
        wakeLockRef.current = null;
        console.log('Wake Lock released');
      } catch (err) {
        wakeLockRef.current = null;
        console.error('Wake Lock release error:', err);
      }
    }
  }, []);

  return { requestWakeLock, releaseWakeLock };
}
