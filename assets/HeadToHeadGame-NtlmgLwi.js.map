import React from 'react';
import { motion } from 'framer-motion';
import { Loader2, Swords } from 'lucide-react';

// Full-screen overlay shown while the server re-verifies both players' battle
// solutions (M3). It covers the submit-battle-result round-trip — the latency
// AND the window in which the server is the authority deciding the winner, so
// the client never flashes a client-computed result first. Presentational: the
// parent renders it while its submit call is in flight.
export default function BattleVerifyingScreen({
  message = 'Verifying battle…',
  subMessage = "Checking both players' solutions on the server.",
}) {
  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      role="status"
      aria-live="polite"
      className="fixed inset-0 z-[70] flex items-center justify-center bg-black/85 backdrop-blur-sm p-6 u37-ad-safe-pb"
    >
      <motion.div
        initial={{ scale: 0.92, y: 16 }}
        animate={{ scale: 1, y: 0 }}
        className="max-w-sm w-full rounded-2xl p-8 text-center border-2"
        style={{
          background: 'color-mix(in srgb, var(--u37-magenta) 10%, #0b1020)',
          borderColor: 'color-mix(in srgb, var(--u37-magenta) 50%, transparent)',
          boxShadow: '0 0 40px -12px var(--u37-magenta), inset 0 0 28px -18px var(--u37-magenta)',
        }}
      >
        <div className="relative mx-auto mb-5 flex items-center justify-center" style={{ width: 72, height: 72 }}>
          <motion.div
            animate={{ rotate: 360 }}
            transition={{ repeat: Infinity, ease: 'linear', duration: 2.4 }}
            className="absolute inset-0 flex items-center justify-center"
          >
            <Loader2 className="w-[72px] h-[72px]" style={{ color: 'var(--u37-magenta)' }} />
          </motion.div>
          <motion.div
            animate={{ scale: [1, 1.12, 1] }}
            transition={{ repeat: Infinity, duration: 1.4 }}
          >
            <Swords className="w-8 h-8 text-white" />
          </motion.div>
        </div>

        <h2
          className="text-xl font-black mb-2"
          style={{ color: 'var(--u37-magenta)', textShadow: '0 0 12px color-mix(in srgb, var(--u37-magenta) 45%, transparent)' }}
        >
          {message}
        </h2>
        <p className="text-sm text-slate-300 leading-relaxed">{subMessage}</p>
      </motion.div>
    </motion.div>
  );
}
