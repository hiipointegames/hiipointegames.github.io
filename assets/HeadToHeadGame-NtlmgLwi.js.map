// Pure fold of one finished solo-blitz run into `game_stats.soloBlitz`.
//
// Extracted from HeadToHeadGame.saveResults so the counter math has a
// unit-tested home and to keep HeadToHeadGame under the 800-line arch cap (the
// M3 finalize-wiring pushed it over). The caller reads the fresh user, calls
// this, and persists the returned game_stats. Returns a NEW object (does not
// mutate the input) and preserves the untouched mode + any other game_stats keys.
//
// `bestSolveTime` (Badge System Redesign, Lane D) is the one stored field the
// Blitz badge set needed that isn't reconstructible after the fact: solo runs
// persist only counters, not the per-solve `solutions[]` a battle row keeps, so
// a solo personal-best solve time cannot be derived retroactively. It rides the
// SAME fire-and-forget write that already folds the run — no extra round-trip,
// no gameplay coupling. Powers Warp Reflex.

import { normalizeBlitzMode } from './blitzMode';

/** Finite-positive guard — a solve time of 0/NaN/Infinity/absent is no record. */
const positiveTime = (v) => (typeof v === 'number' && Number.isFinite(v) && v > 0 ? v : null);

/**
 * Fold one finished solo-blitz run into game_stats.
 *
 * @param {object|null|undefined} gameStats - the player's current game_stats blob
 * @param {string} soloMode - a Blitz tier; anything unrecognised falls back to 'easy'
 * @param {number} solvedCount - puzzles solved in this run
 * @param {number|null} [runFastestSolveTime] - the run's fastest SINGLE solve, in
 *   seconds (min over every solve in the run). Absent/non-positive leaves any
 *   existing `bestSolveTime` untouched, so an older record is never erased by a
 *   run that recorded no usable time.
 * @returns {object} a new game_stats blob
 */
export function foldSoloBlitzRun(gameStats, soloMode, solvedCount, runFastestSolveTime = null) {
  const stats = { ...(gameStats || {}) };
  const soloBlitz = { ...(stats.soloBlitz || { easy: {}, challenge: {} }) };
  const modeKey = normalizeBlitzMode(soloMode);
  const prev = soloBlitz[modeKey] || { totalRuns: 0, totalPuzzlesSolved: 0, bestRun: 0 };

  const runFastest = positiveTime(runFastestSolveTime);
  const prevBest = positiveTime(prev.bestSolveTime);
  const bestSolveTime =
    runFastest === null ? prevBest : prevBest === null ? runFastest : Math.min(prevBest, runFastest);

  const next = {
    ...prev,
    totalRuns: (prev.totalRuns || 0) + 1,
    totalPuzzlesSolved: (prev.totalPuzzlesSolved || 0) + solvedCount,
    bestRun: Math.max(prev.bestRun || 0, solvedCount),
  };
  // Only written once there IS a record — keeps the blob free of null noise for
  // players who have never recorded a timed solo solve.
  if (bestSolveTime !== null) next.bestSolveTime = bestSolveTime;

  soloBlitz[modeKey] = next;
  stats.soloBlitz = soloBlitz;
  return stats;
}
