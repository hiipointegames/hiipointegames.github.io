import React, { useRef, useState } from 'react';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { playSound } from '@/ui/feedback';

// Swipeable one-card-per-screen carousel for the Stats page. Shows ONE slide at
// a time inside a full neon-outlined card; horizontal swipe or the chevrons/dots
// move between them (same gesture model as the unified Leaderboard). Pagination
// dots double as a jump control and announce the section labels. Vertical
// scrolling inside a tall slide still works — only a mostly-horizontal drag
// changes the card.
//
// Two equivalent APIs:
//   - `slides`: [{ id, label, accent?, node }] (used in tests).
//   - `children`: each direct child carries `label` (+ optional `accent`) props
//     — lower-churn for wrapping existing page sections in place. Falsy children
//     (conditional sections that render nothing) are dropped.

const SWIPE_THRESHOLD = 60;
const DEFAULT_ACCENT = 'var(--u37-violet)';

// Thin slide marker for the children API: carries `label`/`accent`/`id` (read off
// the element by the carousel, not used here) and renders its section JSX. Keeps
// page integration to wrapping each existing section in <StatsSlide label=…> … </StatsSlide>.
// An optional `id` lets a caller deep-link to this slide (e.g. ?card=blitz).
export function StatsSlide({ children, label, accent, id = null }) {
  void label; // declared so the carousel can read them as props; not rendered here
  void accent;
  void id;
  return <>{children}</>;
}

const slidesFromChildren = (children) =>
  React.Children.toArray(children)
    .filter((c) => c && React.isValidElement(c))
    .map((c, i) => {
      const child = /** @type {any} */ (c);
      return {
        id: child.props.id ?? child.key ?? `slide-${i}`,
        label: child.props.label,
        accent: child.props.accent,
        node: child,
      };
    });

export default function StatsCarousel({ slides = null, children = null, initialSlideId = null }) {
  const items = (slides ? slides.filter(Boolean) : slidesFromChildren(children));
  const [active, setActive] = useState(() => {
    if (!initialSlideId) return 0;
    const i = items.findIndex((s) => s.id === initialSlideId);
    return i >= 0 ? i : 0;
  });
  const touch = useRef(null);

  if (items.length === 0) return null;
  const idx = Math.min(active, items.length - 1);
  const current = items[idx];
  const accent = current.accent || DEFAULT_ACCENT;

  const goTo = (next) => {
    if (next < 0 || next >= items.length || next === idx) return;
    playSound('buttonTap');
    setActive(next);
  };

  const onTouchStart = (e) => {
    const t = e.touches[0];
    touch.current = { x: t.clientX, y: t.clientY };
  };
  const onTouchEnd = (e) => {
    if (!touch.current) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - touch.current.x;
    const dy = t.clientY - touch.current.y;
    touch.current = null;
    if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
      goTo(idx + (dx < 0 ? 1 : -1)); // swipe left → next
    }
  };

  return (
    // h-full so the carousel fills the height its parent gives it: one card per
    // screen, no dead space below short content (the card grows to fill).
    <div data-testid="stats-carousel" className="h-full flex flex-col">
      {/* Merged nav row (2H condense): ONE compact row of ‹ prev — centered neon
          LABEL with the position dots tucked directly underneath — next ›. This
          replaces the old two stacked rows (a standalone dots row + a separate
          label/arrow row), reclaiming top space on BOTH pages that share this
          carousel (Stats + Blitz Colosseum). Arrows flank a centered column so
          the whole control collapses into a single row's height. */}
      <div data-testid="carousel-nav" className="flex items-center justify-between gap-2 mb-3 flex-shrink-0">
        <button
          onClick={() => goTo(idx - 1)}
          disabled={idx === 0}
          aria-label="Previous section"
          className="w-9 h-9 rounded-xl flex items-center justify-center bg-white/[0.06] border border-white/10 disabled:opacity-30 hover:bg-white/[0.12] transition-colors flex-shrink-0"
        >
          <ChevronLeft className="w-5 h-5 text-slate-200" />
        </button>

        {/* Center column: the neon section label with the section-indicator dots
            (tappable jump + label announcement) tucked directly beneath it. */}
        <div className="flex-1 min-w-0 flex flex-col items-center gap-1">
          <div
            className="w-full text-center text-sm font-black uppercase tracking-wider truncate px-2"
            style={{ color: accent, textShadow: `0 0 8px color-mix(in srgb, ${accent} 55%, transparent)` }}
          >
            {current.label}
          </div>
          <div className="flex items-center justify-center gap-2" role="tablist" aria-label="Stats sections">
            {items.map((s, i) => {
              const isActive = i === idx;
              const dotAccent = s.accent || DEFAULT_ACCENT;
              return (
                <button
                  key={s.id}
                  role="tab"
                  aria-selected={isActive}
                  aria-label={s.label}
                  onClick={() => goTo(i)}
                  className="rounded-full transition-all"
                  style={{
                    width: isActive ? 24 : 8,
                    height: 8,
                    background: isActive ? dotAccent : 'rgba(255,255,255,0.22)',
                    boxShadow: isActive ? `0 0 8px -1px ${dotAccent}` : undefined,
                  }}
                />
              );
            })}
          </div>
        </div>

        <button
          onClick={() => goTo(idx + 1)}
          disabled={idx === items.length - 1}
          aria-label="Next section"
          className="w-9 h-9 rounded-xl flex items-center justify-center bg-white/[0.06] border border-white/10 disabled:opacity-30 hover:bg-white/[0.12] transition-colors flex-shrink-0"
        >
          <ChevronRight className="w-5 h-5 text-slate-200" />
        </button>
      </div>

      {/* The active slide, in a full neon-outlined card that FILLS the available
          height. Content centers when short (m-auto) and scrolls inside the card
          when it's taller than the screen — so the card uses the whole space
          instead of leaving a void above the ad. */}
      <div
        className="flex-1 min-h-0 rounded-3xl border p-3 sm:p-4 backdrop-blur-sm overflow-y-auto scroll-smooth flex flex-col"
        style={{
          borderColor: accent,
          background: `color-mix(in srgb, ${accent} 7%, transparent)`,
          boxShadow: `0 0 22px -10px ${accent}, inset 0 0 50px -34px ${accent}`,
        }}
        onTouchStart={onTouchStart}
        onTouchEnd={onTouchEnd}
      >
        <div className="m-auto w-full">{current.node}</div>
      </div>
    </div>
  );
}
