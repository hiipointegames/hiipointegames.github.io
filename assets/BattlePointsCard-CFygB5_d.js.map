import React from 'react';
import { motion } from 'framer-motion';
import { BATTLE_POINTS } from '@/game-mechanics';

// ─────────────────────────────────────────────────────────────────────────────
// The Battle Points card — the ONE thing the two Blitz stats surfaces genuinely
// shared, extracted 2026-09-10.
//
// `BlitzStats` (the post-run receipt) and `HeadToHeadStats` (the lifetime ledger)
// each carried their own copy: the same four-branch threshold ladder, the same
// next-milestone expression, the same "Win Blitz Battles to earn Battle Points"
// string. They differed only in two text colours and a loading branch. Those are
// the deltas a duplicate accumulates before it starts disagreeing outright.
//
// Nothing else about those two screens is shared. They describe different
// subjects (one finished run vs a career), read different sources (router state
// vs the database) and answer to different lifetimes — so this is the only
// extraction the pair earns, and merging them further would invent work.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THE MEDAL TOKENS
// ─────────────────────────────────────────────────────────────────────────────
// Both copies hard-coded their tier gradients (`from-yellow-300 via-amber-400`,
// `from-slate-300 via-slate-100`, `from-amber-400 via-orange-500`) while
// `--u37-medal-gold/silver/bronze` had existed all along for exactly this
// semantic — literal podium metals, deliberately named apart from reward-gold so
// that restyling one cannot silently repaint the other (tokens.css § medals).
// A points ladder IS a podium, so it uses them.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * The next milestone this player is climbing toward, and the metal it wears.
 * `null` once GOLD is reached — there is nothing further to show, and rendering
 * a target they have already passed would read as a demotion.
 *
 * @param {number} points
 * @returns {{ target: number, metal: string } | null}
 */
export const nextBattleMilestone = (points) => {
  if (points >= BATTLE_POINTS.GOLD) return null;
  if (points >= BATTLE_POINTS.SILVER) return { target: BATTLE_POINTS.GOLD, metal: 'var(--u37-medal-gold)' };
  if (points >= BATTLE_POINTS.BRONZE) return { target: BATTLE_POINTS.SILVER, metal: 'var(--u37-medal-silver)' };
  return { target: BATTLE_POINTS.BRONZE, metal: 'var(--u37-medal-bronze)' };
};

/**
 * @param {object} props
 * @param {number} props.points
 * @param {boolean} [props.loading] show a placeholder instead of a total. The
 *   receipt fetches its own points on mount; the ledger already has them.
 * @param {boolean} [props.failed] the fetch failed. Distinct from `loading` and
 *   from a genuine zero: rendering "0 / 37" after a network error is a confident,
 *   plausible, false statement about the player's record.
 * @param {boolean} [props.compact] tighter padding for an embedded card.
 */
export default function BattlePointsCard({ points, loading = false, failed = false, compact = false }) {
  const next = nextBattleMilestone(points);

  return (
    <div
      className={`rounded-xl ${compact ? 'p-4' : 'p-5'} border-2 min-w-[240px]`}
      style={{
        background: 'color-mix(in srgb, var(--u37-magenta) 12%, transparent)',
        borderColor: 'color-mix(in srgb, var(--u37-magenta) 50%, transparent)',
        boxShadow: '0 0 18px -8px var(--u37-magenta), inset 0 0 20px -14px var(--u37-magenta)',
      }}
    >
      <div className="flex items-center justify-center gap-2 mb-2">
        <span className="text-2xl">⚔️</span>
        <h3
          className="text-xs sm:text-sm font-bold uppercase tracking-wider"
          style={{ color: 'color-mix(in srgb, var(--u37-magenta) 30%, white)' }}
        >
          Battle Points
        </h3>
      </div>

      <div className="text-center mb-3">
        {loading || failed ? (
          <div
            className="text-2xl sm:text-3xl font-black"
            style={{ color: failed ? 'var(--u37-danger)' : 'var(--u37-muted)' }}
          >
            {failed ? 'Unavailable' : <>&mdash;</>}
          </div>
        ) : (
          <motion.div
            className="text-2xl sm:text-3xl font-black"
            initial={{ scale: 0 }}
            animate={{ scale: 1 }}
            transition={{ type: 'spring', stiffness: 200 }}
            key={points}
          >
            <span style={{ color: 'var(--u37-text)' }}>{points}</span>
            {next && (
              <>
                <span className="mx-1" style={{ color: 'var(--u37-muted)' }}>/</span>
                <span style={{ color: next.metal }}>{next.target}</span>
              </>
            )}
          </motion.div>
        )}
      </div>

      <p className="text-xs text-center leading-relaxed" style={{ color: 'var(--u37-muted)' }}>
        {failed ? 'Your points are safe — we just could not load them.' : 'Win Blitz Battles to earn Battle Points'}
      </p>
    </div>
  );
}
