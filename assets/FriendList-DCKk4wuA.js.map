import React from 'react';
import { Navigate } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';

// The standalone Friends page is dissolved — friend management (search, list,
// recommended players, requests) now lives inside the Blitz Colosseum's
// FriendsSection, and the friends daily-challenge leaderboard moved to the
// unified Leaderboard's Daily › Friends tab. This route survives only as a
// redirect so any lingering /FriendList link lands in the Colosseum.
export default function FriendList() {
  return <Navigate to={createPageUrl('HeadToHead')} replace />;
}
