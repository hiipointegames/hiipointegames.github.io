import React, { useCallback, useEffect, useRef, useState } from 'react';
import { isMember } from '@/auth';
import { useHowToOverlay } from '@/how-to-play';
import { isDaily, isKnownModeKey, modeOf, modeTierLabel } from '@/game-modes';
import { showInterstitial as shellShowInterstitial } from '@/shell';
import { usePlayerRecord, useThreeDailies, useRoundSession, loadGameMount, RoundStage } from '@/game-flow';
import { reportedFallback } from '@/observability';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { DAILY_RUN_EVENT } from '../dailyRuns';

/** Tell the page a timed Daily is running (game) or over (null): the same signal the four games send. */
const announceDailyRun = (game) => {
  try { globalThis.dispatchEvent?.(new CustomEvent(DAILY_RUN_EVENT, { detail: { game } })); } catch { /* no window */ }
};
import './cosmic37.css';

// Sector 73 mode `thirtySeven` (session 2026-10-19-s73-37-inside, design-v2 D3/D4, slice 3): a
// round of 37 — practice or a Daily — played INSIDE Sector 73, with the cosmic skin.
//
//   openMode('thirtySeven', { mode, entry })   entry: 'practice' | 'daily' | 'continue'
//
// It is the SAME round as 37's /Game: the same @/game-flow session (board, entry paths, solve,
// results, autosave), the same three Daily machines and the same player record, so a round here
// counts exactly as it does in 37 (David, 2026-10-19). What differs is the host:
//   - a REAL `mode` state, so the win screen's "play the next Daily" and the live-Daily redirect
//     switch mode here, as they do on /Game;
//   - the player is loaded with loadGameMount, with ONLY its landing `setMode` turned off (the
//     planet or moon you picked is the mode), and never useGameMount (it would overwrite 37's
//     remembered home mode);
//   - NO_MIRROR: inside Sector 73 a 73 is not a warp — the board says "73 isn't 37", exactly as
//     for any player who has already found the sector;
//   - the how-to overlay never shows the app's bottom nav (the cockpit owns it), nor does the
//     award celebration;
//   - the results card stays in the world: Home reads "Back to orbit" and every link that would
//     leave the page is hidden (inWorld.exits is empty until the info-screens session);
//   - there is no launcher. When nothing of the round is on screen any more — practice X, a
//     cancelled start screen, the first-run how-to's back arrow, results X or Back to orbit —
//     the mode closes itself (D4). It never closes while an interstitial is showing: the ad is
//     tracked (adBusy) from the call until its Dismissed, which opens the start screen in the
//     same batch. Closing a forfeited Daily first waits for the forfeit to save (≤ 4 s, "Saving…"
//     if slow, one retry if it failed); a refused start or a cross-promo shows one line of why.

/** This mode reads `params.entry` (the world lane's launch contract, world/entryReady.js). */
export const ACCEPTS_ENTRY = true;

/** Sector 73 never warps from inside: a 73 here is "73 isn't 37" (design-v2 D3, m1). */
export const NO_MIRROR = Object.freeze({
  unlocked: true,
  board: 'used',
  canWarp: () => false,
  asWhite: (/** @type {string[]} */ c) => c,
  recheck() {},
  start() {},
  enter: undefined,
  overlay: null,
});

/** No route exits from the results card until the info-screens session adds in-world ones. */
const IN_WORLD = Object.freeze({ exits: Object.freeze({}) });

const ENTRIES = ['practice', 'daily', 'continue'];

/** An interstitial that never reports Dismissed stops holding the mode open after this long. */
export const AD_GUARD_MS = 60_000;
/** Longest the close waits for a forfeit to reach the server (design-v2 D6). */
export const SAVE_WAIT_MS = 4000;
/** "Saving…" shows only if the wait is noticeable. */
export const SAVING_SHOW_MS = 300;
/** How long the one-line "why" stays up before the mode returns to orbit. */
export const NOTICE_MS = 1800;

/** Where each tier lives in the world: its Daily planet and its practice moon. */
const PLACES = Object.freeze({ easy: 'Terra', challenge: 'Ember', expert: 'Titan' });

/**
 * The one line the mode shows before it returns to orbit, or null (review m2): a Daily start the
 * server refused, or a results cross-promo to a mode that lives somewhere else.
 * @param {{ mode: string, shownMode: string, dc: { status?: string, puzzleMissing?: boolean | null }, startTried: boolean }} a
 * @returns {string | null}
 */
export function closeNotice({ mode, shownMode, dc, startTried }) {
  const tier = modeTierLabel(mode);
  if (startTried && isDaily(mode)) {
    if (dc?.puzzleMissing) return `Today's ${tier} Daily isn't ready yet.`;
    if (dc?.status === 'completed') return `You've already finished today's ${tier} Daily.`;
    if (dc?.status === 'forfeited') return `Today's ${tier} Daily is over for you.`;
    return `Couldn't start the ${tier} Daily. Try again.`;
  }
  if (mode !== shownMode) {
    const place = PLACES[modeOf(mode)] ?? 'Terra';
    return isDaily(mode) ? `The ${tier} Daily is on ${place}.` : `${tier} practice is on ${place} Moon.`;
  }
  return null;
}

/**
 * How the round ended, for the page (a Daily's terminal state; null for practice / unfinished).
 * @param {string} mode
 * @param {{ status?: string, puzzleMissing?: boolean | null }} dc
 * @returns {'completed' | 'forfeited' | 'puzzleMissing' | null}
 */
export function outcomeOf(mode, dc) {
  if (!isDaily(mode)) return null;
  if (dc?.status === 'completed') return 'completed';
  if (dc?.status === 'forfeited') return 'forfeited';
  if (dc?.puzzleMissing) return 'puzzleMissing';
  return null;
}

/**
 * @param {{
 *   user?: Record<string, any> | null,
 *   params?: { mode?: string, entry?: string } | null,
 *   onExit: (result?: { mode: string, outcome: ReturnType<typeof outcomeOf> }) => void,
 *   onReturnTo37?: () => void,
 *   showAd?: unknown,
 *   showInterstitial?: (opts: { onDismissed?: () => void }) => unknown,
 *   loadMount?: typeof loadGameMount,
 *   adGuardMs?: number, saveWaitMs?: number, noticeMs?: number,
 * }} props
 */
export default function ThirtySevenMode({
  user = null, params = null, onExit, showInterstitial = shellShowInterstitial, loadMount = loadGameMount,
  adGuardMs = AD_GUARD_MS, saveWaitMs = SAVE_WAIT_MS, noticeMs = NOTICE_MS,
}) {
  const member = isMember(user);
  const [mode, setMode] = useState(() => (isKnownModeKey(params?.mode) ? params.mode : 'easy'));
  const entry = ENTRIES.includes(params?.entry ?? '') ? params.entry : 'practice';

  const { openHowTo: rawOpenHowTo, howToNode, isOpen: howToOpen } = useHowToOverlay();
  // Every how-to the round opens keeps the bottom nav hidden (design-v2 D8).
  const openHowTo = useCallback((m, o = {}) => rawOpenHowTo(m, { ...o, hidesNav: false }), [rawOpenHowTo]);

  const record = usePlayerRecord();
  const threeDailies = useThreeDailies();

  // The tracked ad (D4): busy from the call until the ad's onDismissed — NOT until the call
  // returns. On Android the plugin resolves showInterstitial() when the ad APPEARS (slice-3 review
  // B1), so the call settling says nothing about the ad being gone. The shell runs onDismissed
  // exactly once on every path (web, ads switched off, Dismissed, FailedToShow, an error), and it
  // opens the start screen in the same batch that clears adBusy, so there is never an idle frame.
  // A long guard (adGuardMs) only covers an ad that never reports back at all.
  const [adBusy, setAdBusy] = useState(false);
  const trackedAd = useCallback((opts = {}) => {
    let over = false;
    setAdBusy(true);
    const guard = setTimeout(() => {
      if (over) return;
      over = true;
      reportedFallback('sector73.thirtySeven.adNeverDismissed')(new Error('interstitial never reported Dismissed'));
      setAdBusy(false);
    }, adGuardMs);
    return Promise.resolve(showInterstitial({
      onDismissed: () => {
        if (over) return;
        over = true;
        clearTimeout(guard);
        setAdBusy(false);
        opts.onDismissed?.();
      },
    })).catch(reportedFallback('sector73.thirtySeven.ad')).then(() => undefined);
  }, [showInterstitial, adGuardMs]);

  const session = useRoundSession({ mode, setMode, record, threeDailies, openHowTo, mirror: NO_MIRROR, showInterstitial: trackedAd });

  // A Daily start the server refuses (already completed / forfeited / no puzzle) closes its start
  // screen and leaves nothing on screen. Remember that a start was tried, so the close can say why
  // (review m2); the board coming up clears it.
  const startTried = useRef(false);
  if (session.dc.showGame) startTried.current = false;
  const stage = {
    ...session,
    stageProps: {
      ...session.stageProps,
      startDailyChallenge: () => { startTried.current = true; return session.stageProps.startDailyChallenge(); },
    },
  };

  // Load the player, restore the three Dailies (the server is the truth), then press the entry.
  const [loaded, setLoaded] = useState(false);
  const mountArgs = useRef({ dailyByMode: threeDailies.dailyByMode, knownPointsRef: record.knownPointsRef, mountApply: record.mountApply });
  useEffect(() => {
    if (!member) return undefined;
    let live = true;
    const { dailyByMode, knownPointsRef, mountApply } = mountArgs.current;
    Promise.resolve(loadMount({
      dailyByMode, locationState: null, knownPointsRef,
      apply: { ...mountApply, setMode: () => {} }, // the picked planet/moon IS the mode
    })).catch(reportedFallback('sector73.thirtySeven.mount')).then(() => { if (live) setLoaded(true); });
    return () => { live = false; };
  }, [member, loadMount]);

  // Press the entry once, after the load (so the first tap lands past the page's ClickShield).
  const [entered, setEntered] = useState(false);
  const [entryPending, setEntryPending] = useState(false);
  const pressed = useRef(false);
  const sessionRef = useRef(session);
  sessionRef.current = session;
  useEffect(() => {
    if (!loaded || pressed.current) return;
    pressed.current = true;
    setEntered(true);
    const s = sessionRef.current;
    if (entry === 'continue') {
      setEntryPending(true);
      Promise.resolve().then(() => s.handleContinueDaily()).catch(reportedFallback('sector73.thirtySeven.continue')).then(() => setEntryPending(false));
      return;
    }
    // A Daily already finished or forfeited today: say so and go back, WITHOUT an ad (world lane
    // 2026-10-22, contrarian M2). The load above restored it from the server, so this is the truth;
    // the ad used to play first and the refusal only came after it.
    if (isDaily(mode) && (s.dc.status === 'completed' || s.dc.status === 'forfeited')) {
      startTried.current = true; // the close then says "already finished" / "over for you"
      return;
    }
    s.handleRollDice(); // practice: start screen (or the first-run how-to); Daily: ad → start screen
  }, [loaded, entry, mode]);

  // A Daily round on the board is announced like the four games' timed Dailies (modes/dailyRuns),
  // so a live-duel invite holds back its Accept while it runs (world lane 2026-10-22, review B2).
  // Running = its board is up and not solved yet (after a solve the board stays behind the results).
  const dailyOnBoard = isDaily(mode) && Boolean(session.dc.showGame) && !session.solved;
  useEffect(() => {
    if (!dailyOnBoard) return undefined;
    announceDailyRun('thirtySeven');
    return () => { announceDailyRun(null); };
  }, [dailyOnBoard]);

  // Idle = nothing of the round on screen → close (D4). A guest never gets a round at all.
  // The close waits one tick and re-checks: a surface opened from an EFFECT (the Daily's timeout
  // reveal) lands one render after the board goes, and that single render must not end the mode.
  const active = session.surfaceUp || howToOpen || adBusy;
  const idle = !member || (entered && !entryPending && !active);
  // The mode the player was last looking at — a cross-promo (results "Try Challenge") switches
  // `mode` and leaves nothing on screen; the close then says where that mode lives (review m2).
  const shownMode = useRef(mode);
  if (active) shownMode.current = mode;
  const latest = useRef({ idle, mode, dc: session.dc, onExit });
  latest.current = { idle, mode, dc: session.dc, onExit };
  const closed = useRef(false);
  const [closing, setClosing] = useState(/** @type {null | { saving?: boolean, notice?: string }} */ (null));

  /** Close: a forfeit's save first (D6, review M1), then a one-line why (review m2), then onExit. */
  const finish = useCallback(async (now) => {
    const outcome = outcomeOf(now.mode, now.dc);
    if (outcome === 'forfeited') {
      // The forfeit write must land before the player can reach the other page, or /Game can
      // restore this Daily as "Continue". Race it against saveWaitMs; say "Saving…" if it is slow.
      const slow = setTimeout(() => setClosing({ saving: true }), SAVING_SHOW_MS);
      const saved = await Promise.race([
        Promise.resolve().then(() => now.dc.whenSaved?.() ?? true).catch(() => false),
        new Promise((r) => { setTimeout(() => r(null), saveWaitMs); }),
      ]);
      clearTimeout(slow);
      // Not saved: retry once (token 'unknown' — the server finds the attempt by user + date) and
      // close anyway. Telling the player it may not have saved is slice 4b's.
      if (saved === false) {
        Promise.resolve().then(() => now.dc.forfeit?.()).catch(reportedFallback('sector73.thirtySeven.forfeitRetry'));
      }
    }
    const notice = closeNotice({ mode: now.mode, shownMode: shownMode.current, dc: now.dc, startTried: startTried.current });
    if (notice) {
      setClosing({ notice });
      await new Promise((r) => { setTimeout(r, noticeMs); });
    }
    now.onExit({ mode: now.mode, outcome });
  }, [saveWaitMs, noticeMs]);

  useEffect(() => {
    if (!idle || closed.current) return undefined;
    const t = setTimeout(() => {
      const now = latest.current;
      if (!now.idle || closed.current) return;
      closed.current = true;
      finish(now);
    }, 0);
    return () => clearTimeout(t);
  }, [idle, finish]);

  if (!member) return null;
  return (
    <div className="s73-37 relative isolate h-full w-full bg-[#04030d]" data-testid="thirty-seven-mode" data-mode-key={mode}>
      <ModeBackdrop theme="thirtySeven" />
      {!entered && (
        <div data-testid="thirty-seven-loading" className="grid h-full place-items-center text-sm tracking-[0.3em] text-violet-300">
          CHARTING COURSE…
        </div>
      )}
      <RoundStage session={stage} howToNode={howToNode} skin="sector73" inWorld={IN_WORLD} hidesNav={false} />
      {closing && (
        <div className="absolute inset-0 z-[120] grid place-items-center px-6">
          <p data-testid={closing.notice ? 'thirty-seven-notice' : 'thirty-seven-saving'} role="status"
            className="rounded-full border border-violet-300/50 bg-black/70 px-5 py-2.5 text-center text-sm font-bold text-violet-100"
            style={{ boxShadow: '0 0 24px -8px #a855f7' }}>
            {closing.notice ?? 'Saving…'}
          </p>
        </div>
      )}
    </div>
  );
}
