import React from 'react';

// The target "37": highly-polished, BRIGHT metallic gold. A saturated vertical
// gold gradient with a specular sheen band (the polished-metal highlight) clipped
// to the text; a crisp bright-gold keyline (paint-order stroke-under-fill)
// sharpens the edges; a short deep-gold extrude adds a hint of 3D; and a small
// tight gold sheen keeps a hint of neon glow. Scales at any font-size. (`accent`
// is accepted but ignored so call sites can pass a per-mode accent uniformly.)
// Chosen 2026-06-30 ("N4+++"); glow dialed WAY down 2026-07-10 — the old
// multi-layer 54/104/160px halo bloomed hard on iOS and smeared the "37" at small
// sizes (legibility). Kept present but subtle: two short, low-opacity layers only.
export function Target37({ className = '', accent = null }) {
  return (
    <span
      className={`relative inline-block leading-none font-black ${className}`}
      style={{
        backgroundImage:
          'linear-gradient(180deg,#FFE873 0%,#FFD21F 26%,#F7B916 44%,#FFF9CE 50%,#F7B916 56%,#E7A012 78%,#FFDB4D 100%)',
        WebkitBackgroundClip: 'text',
        backgroundClip: 'text',
        color: 'transparent',
        WebkitTextStroke: '1.2px #FFE256',
        paintOrder: 'stroke fill',
        textShadow:
          '1px 1px 0 #B47E14, 2px 2px 0 #8f640f, 0 0 5px rgba(255,245,200,0.55), 0 0 13px rgba(255,215,90,0.38)',
      }}
    >
      37
    </span>
  );
}
