import React from 'react';

// The shiny metallic gold for the "used-correctly" power-die OUTLINE. One home so
// every surface that outlines a correct power die — the live equation builder, the
// How-To-Play demo, and the read-only SolvedEquation (win / forfeit / leaderboard /
// overlap) — draws the exact same gold. Static values (no animation) as of
// 2026-07-10 (David: shiny gold, NO pulsating glow).
// Mirrors the canonical --u37-gold theme token (#ffcf3a) so the power-die outline
// matches every "perfect solve" gold legend swatch app-wide. Kept as a concrete
// hex (not var(--u37-gold)) so it resolves in non-CSS contexts (tests/inline).
export const POWER_DIE_GOLD = '#ffcf3a';
export const POWER_DIE_GOLD_GLOW = '0 0 4px 0 rgba(255,207,58,0.5)';

// A power die / number used correctly gets a shiny GOLD OUTLINE (following its
// shape) — a crisp bright-gold border with a small, STATIC gold sheen. The pulsing
// animation was removed 2026-07-10 (it was distracting on-device); the outline is
// now a steady shiny gold. Shared by the How-To-Play demo and the live equation
// builder so "used correctly" looks the same everywhere.
export function GoldPulseRing({ children, active = true, radius = 'rounded-2xl' }) {
  if (!active) return <>{children}</>;
  return (
    <span className="relative inline-flex">
      <span
        aria-hidden="true"
        className={`absolute -inset-[2px] ${radius} border-2`}
        style={{ borderColor: POWER_DIE_GOLD, boxShadow: POWER_DIE_GOLD_GLOW }}
      />
      <span className="relative">{children}</span>
    </span>
  );
}
