import React, { useState, useEffect } from 'react';
import { Capacitor } from '@capacitor/core';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { Trophy, X, Clock, Skull } from 'lucide-react';
import { apiClient } from '@/transport';
import { isPerfectSolve } from '@/equation-engine';
import { SolvedEquation } from '@/equation-display';
import BlitzModeBadge from './BlitzModeBadge';
import { blitzDiceColors, normalizeBlitzMode, blitzHasPerfectConcept } from './blitzMode';
import { Target37 } from '@/dice-visuals';
import { POWER_DICE_COLORS, EASY_DICE_COLORS } from '@/dice';
import PlayerBadges from '@/components/profile/PlayerBadges';
import { getProfilesByIds } from '@/player';
import { perspectiveOf } from './challengeView';
import { playSound, formatSolveTime } from '@/ui/feedback';

const DiceFace = ({ value, color = 'white' }) => {
  const dotPositions = {
    1: [[50, 50]],
    2: [[25, 25], [75, 75]],
    3: [[25, 25], [50, 50], [75, 75]],
    4: [[25, 25], [75, 25], [25, 75], [75, 75]],
    5: [[25, 25], [75, 25], [50, 50], [25, 75], [75, 75]],
    6: [[25, 25], [75, 25], [25, 50], [75, 50], [25, 75], [75, 75]]
  };

  const dots = dotPositions[value] || [];

  // Color styles for dice
  const colorStyles = {
    white: {
      bg: 'from-slate-100 to-slate-200',
      shadow: 'shadow-lg',
      badge: ''
    },
    blue: {
      bg: 'from-blue-400 to-blue-600',
      shadow: 'shadow-blue-500/50 shadow-lg',
      badge: 'bg-blue-500/90'
    },
    red: {
      bg: 'from-red-400 to-red-600',
      shadow: 'shadow-red-500/50 shadow-lg',
      badge: 'bg-red-500/90'
    },
    green: {
      bg: 'from-green-400 to-green-600',
      shadow: 'shadow-green-500/50 shadow-lg',
      badge: 'bg-green-500/90'
    }
  };

  const style = colorStyles[color] || colorStyles.white;

  return (
    <div className="relative">
      <div className={`w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-gradient-to-br ${style.bg} ${style.shadow} relative before:absolute before:inset-0 before:rounded-lg before:bg-gradient-to-b before:from-white/25 before:to-transparent before:opacity-50`}>
        <svg viewBox="0 0 100 100" className="w-full h-full p-1.5">
          {dots.map(([cx, cy], i) => (
            <g key={i}>
              <circle cx={cx} cy={cy + 2} r={10} className="fill-black/25" />
              <circle cx={cx} cy={cy} r={10} className="fill-slate-800" />
              <circle cx={cx - 2.5} cy={cy - 2.5} r={3.5} className="fill-white/50" />
            </g>
          ))}
        </svg>
      </div>
      {color !== 'white' && style.badge && (
        <div className={`absolute -top-1 -right-1 w-3 h-3 rounded-full ${style.badge} border-2 border-slate-900`} />
      )}
    </div>
  );
};

export default function ChallengeResults({ challenge, onClose }) {
  const [userId, setUserId] = useState('');
  const [opponentName, setOpponentName] = useState('');
  const [challengerName, setChallengerName] = useState('');
  const [challengerProfile, setChallengerProfile] = useState(null);
  const [opponentProfile, setOpponentProfile] = useState(null);

  const battleMode = normalizeBlitzMode(challenge?.blitz_mode);
  // 🔴 THE WORST OF THE 'challenge' TERNARIES, because it is not a label — it
  // decides which DICE the solved equations are drawn with. It read
  // `=== 'challenge' ? POWER_DICE_COLORS : EASY_DICE_COLORS`, so an EXPERT
  // battle's results screen rendered every solve in all-white Easy dice.
  // Expert is the tier where all three Power Dice must be placed correctly, so
  // this hid the exact thing the player had just been judged on.
  // `blitzDiceColors` is the shared answer and already knows all three tiers.
  const diceColors = blitzDiceColors(battleMode);

  useEffect(() => {
    // Prevent background scrolling
    document.body.style.overflow = 'hidden';
    document.body.style.position = 'fixed';
    document.body.style.width = '100%';

    return () => {
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
    };
  }, []);

  useEffect(() => {
    const loadData = async () => {
      const user = await apiClient.auth.me();
      setUserId(user.id);

      const profileMap = await getProfilesByIds([challenge.challenger_id, challenge.opponent_id]);
      const challenger = profileMap.get(challenge.challenger_id);
      const opponent = profileMap.get(challenge.opponent_id);

      setChallengerProfile(challenger || null);
      setOpponentProfile(opponent || null);
      setChallengerName(challenger?.username || 'Player 1');
      setOpponentName(opponent?.username || 'Player 2');
    };
    loadData();
  }, [challenge]);

  const { isChallenger, myResult, opponentResult: theirResult } = perspectiveOf(challenge, userId);
  const myName = isChallenger ? challengerName : opponentName;
  const theirName = isChallenger ? opponentName : challengerName;

  const winnerName = challenge.winner_id === userId ? myName : theirName;
  const iWon = challenge.winner_id === userId;

  // Check if battle is pending (one completed, one hasn't)
  const myCompleted = myResult?.completed || false;
  const theirCompleted = theirResult?.completed || false;
  const isPending = myCompleted && !theirCompleted;

  // Check if player forfeited without starting (no solutions, no time)
  const myForfeitedWithoutStarting = myResult?.run_status === 'forfeited' && (!myResult?.solutions || myResult.solutions.length === 0) && (!myResult?.total_time_seconds || myResult.total_time_seconds === 0);
  const theirForfeitedWithoutStarting = theirResult?.run_status === 'forfeited' && (!theirResult?.solutions || theirResult.solutions.length === 0) && (!theirResult?.total_time_seconds || theirResult.total_time_seconds === 0);

  // Calculate fastest solve times
  const myFastestSolve = myResult?.solutions?.length > 0
    ? Math.min(...myResult.solutions.map(s => s.solve_time))
    : null;
  const theirFastestSolve = theirResult?.solutions?.length > 0
    ? Math.min(...theirResult.solutions.map(s => s.solve_time))
    : null;

  // Calculate perfect solves (all 3 power dice correct) for challenge mode
  const calculatePerfectSolves = (solutions) => {
    // `blitzHasPerfectConcept`, not `=== 'challenge'`. EXPERT is the tier where
    // a perfect solve is the ONLY way to score, so gating perfect-solve counting
    // on Challenge alone reported every Expert battle as zero perfect solves and
    // hid the markers on the one screen that exists to show them.
    if (!blitzHasPerfectConcept(battleMode) || !solutions) return 0;
    return solutions.filter(sol =>
      isPerfectSolve(sol.equation, sol.usedDiceIndices, sol.colors)
    ).length;
  };

  const myPerfectSolves = calculatePerfectSolves(myResult?.solutions);
  const theirPerfectSolves = calculatePerfectSolves(theirResult?.solutions);

  // Missing/zero times render as 00:00.00 in the results view.
  const formatTime = (seconds) => formatSolveTime(seconds, { nullGuard: true });

  // Cosmic-neon treatment for the INNER cards (score panels + per-puzzle
  // solution cards), matching the magenta shell. Semantic colors are kept
  // separately: winners stay emerald, perfect solves keep the gold border.
  const COSMIC_CARD_STYLE = {
    background: 'var(--u37-panel-bg-cosmic)',
    borderColor: 'color-mix(in srgb, var(--u37-magenta) 32%, transparent)',
    boxShadow: '0 0 22px -12px var(--u37-magenta), inset 0 0 24px -18px var(--u37-magenta)',
  };

  const renderEquation = (equation, solutionDice = null, solutionColors = null, usedIndices = null) => {
    if (!equation) return '';

    // For challenge mode with colors, use AST-based colorization
    if (blitzHasPerfectConcept(battleMode) && solutionDice && usedIndices && solutionColors) {
      return <SolvedEquation equation={equation} usedIndices={usedIndices} colors={solutionColors} />;
    }

    // Plain text for non-challenge mode
    let result = equation;
    result = result.replace(/\*/g, '×');
    result = result.replace(/\//g, '÷');
    result = result.replace(/-/g, '−');
    return result;
  };


  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      // Anchor the card to the TOP on phones (items-start) and reserve the status
      // bar / notch (safe-area-inset-top). Centered, a tall battle result pushed
      // its own header + X above the reachable viewport / under the status bar, so
      // the close X was untappable (Bryce device report). Stays centered on ≥sm.
      className="fixed inset-0 z-50 flex items-start sm:items-center justify-center bg-black/80 backdrop-blur-sm p-4 u37-ad-safe-pb overflow-auto"
      style={{ paddingTop: 'max(env(safe-area-inset-top, 0px), 1rem)' }}
    >
      {/* max-h-FULL, not 90vh. The overlay already reserves the unreachable band
          at the bottom of the screen via `u37-ad-safe-pb` (home indicator +
          native AdMob banner + nav) — the native banner is drawn OVER the
          webview, so anything rendered under it is invisible and untappable even
          though the webview believes it's on-screen. A `vh` height ignores that
          padding entirely: the card overflowed the overlay's content box and its
          last child — the pink Close button — landed under the banner (measured
          65px past the reachable line at a 390px-wide phone). Scrolling didn't
          save it: the card owns the touch scroll, so the overlay never scrolled.
          `max-h-full` resolves against the overlay's CONTENT box, which has both
          insets already subtracted, so Close always lands in reachable space.
          (Bryce device report: Blitz → Completed → Victories/Defeats → View
          Results.) */}
      <motion.div
        initial={{ scale: 0.9, y: 20 }}
        animate={{ scale: 1, y: 0 }}
        className="rounded-2xl sm:rounded-3xl px-3 sm:px-6 pb-3 sm:pb-6 max-w-3xl w-full border-2 max-h-full overflow-auto"
        style={{
          background: 'var(--u37-panel-bg)',
          borderColor: 'color-mix(in srgb, var(--u37-magenta) 50%, transparent)',
          boxShadow: '0 0 44px -12px var(--u37-magenta), 0 20px 70px rgba(0,0,0,0.6)',
        }}
      >
        {/* Sticky header — keeps the title + close X pinned to the card top so
            the X is always reachable no matter how far the results scroll (L).
            The card carries NO top padding (only px + pb): this header owns the
            top space (pt-3/6) so it sits FLUSH at the card top and its opaque
            background fully covers scrolled content — otherwise the card's old
            top padding left a band above the header where the winner banner
            peeked through on scroll (David, 2026-07-13). */}
        <div
          className="sticky top-0 z-20 -mx-3 sm:-mx-6 px-3 sm:px-6 pt-3 sm:pt-6 pb-3 mb-2 sm:mb-4"
          style={{ background: 'var(--u37-panel-bg)' }}
        >
          <div className="flex items-center justify-center mb-2 sm:mb-3 relative">
            <div className="flex items-center gap-2.5">
              <span className="text-2xl sm:text-3xl">⚔️</span>
              <h2 className="text-xl sm:text-3xl font-black" style={{ color: 'var(--u37-magenta)', textShadow: '0 0 12px color-mix(in srgb, var(--u37-magenta) 55%, transparent)' }}>Battle Results</h2>
              <span className="text-2xl sm:text-3xl">⚔️</span>
            </div>
            <button onClick={() => { playSound('buttonTap'); onClose(); }} aria-label="Close" className="absolute right-0 text-slate-400 hover:text-white transition-colors">
              <X className="w-5 h-5 sm:w-6 sm:h-6" />
            </button>
          </div>
          <div className="flex items-center justify-center gap-2 flex-wrap">
            <span className="text-slate-400 text-xs sm:text-sm font-semibold">Mode:</span>
            {/* Was a two-branch ternary: an Expert battle's result screen
                announced the battle as "Easy" with a white die. */}
            <BlitzModeBadge mode={battleMode} />
          </div>
        </div>

        {/* Winner/Pending Banner */}
        <div className={`rounded-xl sm:rounded-2xl p-4 sm:p-8 mb-4 sm:mb-6 text-center border-2 shadow-xl ${isPending
            ? 'bg-gradient-to-br from-purple-500/20 via-pink-500/20 to-purple-500/20 border-purple-400/60 shadow-purple-500/30'
            : iWon
              ? 'bg-gradient-to-br from-amber-500/20 via-yellow-500/20 to-orange-500/20 border-amber-400/60 shadow-amber-500/30'
              : 'bg-gradient-to-br from-slate-700/40 via-slate-600/40 to-slate-700/40 border-slate-500/50 shadow-slate-500/20'
          }`}>
          <motion.div
            initial={{ scale: 0, rotate: -180 }}
            animate={{ scale: 1, rotate: 0 }}
            transition={{ type: "spring", duration: 0.8 }}
            className="text-5xl sm:text-7xl mb-2 sm:mb-4"
          >
            {isPending ? '⏳' : iWon ? '🏆' : '❌'}
          </motion.div>
          <h3 className={`text-2xl sm:text-4xl font-black mb-1 sm:mb-2 ${isPending
              ? 'bg-gradient-to-r from-purple-300 via-pink-400 to-purple-300 bg-clip-text text-transparent'
              : iWon
                ? 'bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-300 bg-clip-text text-transparent'
                : 'text-slate-300'
            }`}>
            {isPending ? 'Nice Blitz!' : `${winnerName} Won!`}
          </h3>
          {isPending && (
            <p className="text-purple-300 text-sm sm:text-base font-semibold">Let's see if {theirName} can beat it!</p>
          )}
          {challenge.status === 'forfeited' && (
            <p className="text-orange-300 text-xs sm:text-sm font-semibold">🏳️ Opponent forfeited the battle</p>
          )}
        </div>

        {/* Score Comparison */}
        <div className="grid grid-cols-2 gap-2 sm:gap-4 mb-4 sm:mb-6">
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.2 }}
            className={`rounded-xl sm:rounded-2xl p-3 sm:p-6 border-2 shadow-lg ${iWon
                ? 'bg-gradient-to-br from-emerald-600/30 via-green-600/20 to-emerald-700/30 border-emerald-400/60 shadow-emerald-500/30'
                : ''
              }`}
            style={iWon ? undefined : COSMIC_CARD_STYLE}
          >
            <div className="text-center">
              <div className="flex items-center justify-center gap-2 mb-1 sm:mb-2">
                <div className="text-purple-300 text-xs sm:text-sm font-semibold truncate">{myName}</div>
                {isChallenger && challengerProfile && (
                  <PlayerBadges
                    puzzlePoints={challengerProfile.puzzle_points || 0}
                    battlePoints={challengerProfile.battle_points || 0}
                    size="sm"
                  />
                )}
                {!isChallenger && opponentProfile && (
                  <PlayerBadges
                    puzzlePoints={opponentProfile.puzzle_points || 0}
                    battlePoints={opponentProfile.battle_points || 0}
                    size="sm"
                  />
                )}
              </div>
              {myForfeitedWithoutStarting ? (
                <div className="flex flex-col items-center justify-center py-4 sm:py-8">
                  <p className="text-red-400 text-lg sm:text-xl font-bold">You Forfeit</p>
                </div>
              ) : (
                <>
                  <div className="text-3xl sm:text-5xl font-black text-white mb-1 sm:mb-2 drop-shadow-lg">{myResult?.total_solved || 0}</div>
                  <div className="text-purple-300 text-xs sm:text-sm mt-1 sm:mt-3 font-semibold">
                    Total Time: 🕐 {formatTime(myResult?.total_time_seconds)}
                  </div>
                  <div className={`text-xs sm:text-sm mt-1 sm:mt-2 font-bold ${iWon ? 'text-amber-400' : 'text-slate-400'}`}>
                    Fastest Solve: {myFastestSolve !== null ? `⚡ ${formatTime(myFastestSolve)}` : ''}
                  </div>
                  {blitzHasPerfectConcept(battleMode) && (
                    <div className="flex items-center justify-center gap-1.5 mt-1 sm:mt-2">
                      <span className="text-xs font-bold text-purple-300">Perfect Solves: <span className="text-amber-400">= {myPerfectSolves}</span></span>
                    </div>
                  )}
                </>
              )}
            </div>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.2 }}
            className={`rounded-xl sm:rounded-2xl p-3 sm:p-6 border-2 shadow-lg ${!iWon && challenge.status === 'completed'
                ? 'bg-gradient-to-br from-emerald-600/30 via-green-600/20 to-emerald-700/30 border-emerald-400/60 shadow-emerald-500/30'
                : ''
              }`}
            style={!iWon && challenge.status === 'completed' ? undefined : COSMIC_CARD_STYLE}
          >
            <div className="text-center">
              <div className="flex items-center justify-center gap-2 mb-1 sm:mb-2">
                <div className="text-purple-300 text-xs sm:text-sm font-semibold truncate">{theirName}</div>
                {isChallenger && opponentProfile && (
                  <PlayerBadges
                    puzzlePoints={opponentProfile.puzzle_points || 0}
                    battlePoints={opponentProfile.battle_points || 0}
                    size="sm"
                  />
                )}
                {!isChallenger && challengerProfile && (
                  <PlayerBadges
                    puzzlePoints={challengerProfile.puzzle_points || 0}
                    battlePoints={challengerProfile.battle_points || 0}
                    size="sm"
                  />
                )}
              </div>
              {isPending ? (
                <div className="flex flex-col items-center justify-center py-4 sm:py-8">
                  <div className="text-4xl sm:text-5xl mb-3 sm:mb-4">⏳</div>
                  <p className="text-purple-300 text-sm sm:text-base font-semibold px-2">
                    Waiting for {theirName} to complete the challenge
                  </p>
                </div>
              ) : theirForfeitedWithoutStarting ? (
                <div className="flex flex-col items-center justify-center py-4 sm:py-8">
                  <p className="text-red-400 text-lg sm:text-xl font-bold">Forfeit</p>
                </div>
              ) : (
                <>
                  <div className="text-3xl sm:text-5xl font-black text-white mb-1 sm:mb-2 drop-shadow-lg">{theirResult?.total_solved || 0}</div>
                  <div className="text-purple-300 text-xs sm:text-sm mt-1 sm:mt-3 font-semibold">
                    Total Time: 🕐 {formatTime(theirResult?.total_time_seconds)}
                  </div>
                  <div className={`text-xs sm:text-sm mt-1 sm:mt-2 font-bold ${!iWon ? 'text-amber-400' : 'text-slate-400'}`}>
                    Fastest Solve: {theirFastestSolve !== null ? `⚡ ${formatTime(theirFastestSolve)}` : ''}
                  </div>
                  {blitzHasPerfectConcept(battleMode) && (
                    <div className="flex items-center justify-center gap-1.5 mt-1 sm:mt-2">
                      <span className="text-xs font-bold text-purple-300">Perfect Solves: <span className="text-amber-400">= {theirPerfectSolves}</span></span>
                    </div>
                  )}
                </>
              )}
            </div>
          </motion.div>
        </div>

        {/* Detailed Solutions */}
        {((myResult?.solutions && myResult.solutions.length > 0) || (theirResult?.solutions && theirResult.solutions.length > 0)) && (
          <div className="space-y-3 sm:space-y-4">
            <div className="flex flex-wrap items-center justify-between gap-4 mb-2 sm:mb-4">
              <h3 className="text-base sm:text-xl font-black" style={{ color: 'var(--u37-magenta)', textShadow: '0 0 12px color-mix(in srgb, var(--u37-magenta) 55%, transparent)' }}>Solution Comparison</h3>
              {blitzHasPerfectConcept(battleMode) && (
                <div className="flex items-center gap-2 text-xs text-slate-400">
                  <div className="w-12 h-6 border-2 rounded" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }}></div>
                  <span>= Perfect Solve - All 3 Power Dice Correct</span>
                </div>
              )}
            </div>

            <div className="max-h-[400px] sm:max-h-[500px] overflow-y-auto pr-1 sm:pr-2 space-y-3 sm:space-y-4">
              {Array.from({ length: Math.max(myResult?.solutions?.length || 0, theirResult?.solutions?.length || 0) }).map((_, index) => {
                const mySolution = myResult?.solutions?.[index];
                const theirSolution = theirResult?.solutions?.[index];

                // Pre-compute perfect solve status to avoid IIFE in JSX (iOS Safari incompatibility)
                let myIsPerfect = false;
                if (blitzHasPerfectConcept(battleMode) && mySolution?.usedDiceIndices && mySolution?.colors) {
                  myIsPerfect = isPerfectSolve(mySolution.equation, mySolution.usedDiceIndices, mySolution.colors);
                }

                let theirIsPerfect = false;
                if (blitzHasPerfectConcept(battleMode) && theirSolution?.usedDiceIndices && theirSolution?.colors) {
                  theirIsPerfect = isPerfectSolve(theirSolution.equation, theirSolution.usedDiceIndices, theirSolution.colors);
                }

                return (
                  <motion.div
                    key={index}
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.3 + index * 0.05 }}
                    className="rounded-xl sm:rounded-2xl p-3 sm:p-5 border-2 shadow-lg"
                    style={COSMIC_CARD_STYLE}
                  >
                    <div className="text-xs sm:text-sm font-semibold text-purple-300 mb-2 sm:mb-3 text-center">🎲 Puzzle #{index + 1}</div>

                    {/* Dice Display - Wrap on mobile */}
                    {(mySolution?.dice || theirSolution?.dice) && (
                      <div className="flex flex-wrap gap-1.5 sm:gap-2 mb-3 sm:mb-4 justify-center">
                        {(mySolution?.dice || theirSolution?.dice).map((die, i) => {
                          const dieColor = (mySolution?.colors || theirSolution?.colors)?.[i] || 'white';
                          return <DiceFace key={i} value={die} color={dieColor} />;
                        })}
                      </div>
                    )}

                    {/* Stack on mobile, side by side on desktop */}
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-4">
                      {/* My Solution */}
                      {mySolution ? (
                        <div>
                          <div className="text-xs font-semibold text-emerald-300 mb-1.5 sm:mb-2 truncate">{myName}</div>
                          <div className={`bg-slate-900/60 rounded-lg sm:rounded-xl p-2 sm:p-3 text-xs sm:text-sm border ${myIsPerfect ? 'border-amber-400 shadow-lg shadow-amber-500/50' : 'border-fuchsia-500/25'}`}>
                            <div className="text-slate-100 font-mono break-all leading-relaxed">
                              {renderEquation(mySolution.equation, mySolution.dice, mySolution.colors, mySolution.usedDiceIndices)} <span className="font-bold text-slate-300">= </span><Target37 className="font-bold" />
                            </div>
                            <div className="text-purple-300 text-xs mt-1.5 sm:mt-2 font-semibold">
                              ⏱️ {formatTime(mySolution.solve_time)}
                            </div>
                          </div>
                        </div>
                      ) : (
                        <div className="text-slate-500 text-xs text-center flex items-center justify-center">No solution</div>
                      )}

                      {/* Their Solution */}
                      {theirSolution ? (
                        <div className="sm:text-right">
                          <div className="text-xs font-semibold text-orange-300 mb-1.5 sm:mb-2 truncate">{theirName}</div>
                          <div className={`bg-slate-900/60 rounded-lg sm:rounded-xl p-2 sm:p-3 text-xs sm:text-sm border ${theirIsPerfect ? 'border-amber-400 shadow-lg shadow-amber-500/50' : 'border-fuchsia-500/25'}`}>
                            <div className="text-slate-100 font-mono break-all leading-relaxed">
                              {renderEquation(theirSolution.equation, theirSolution.dice, theirSolution.colors, theirSolution.usedDiceIndices)} <span className="font-bold text-slate-300">= </span><Target37 className="font-bold" />
                            </div>
                            <div className="text-purple-300 text-xs mt-1.5 sm:mt-2 font-semibold">
                              ⏱️ {formatTime(theirSolution.solve_time)}
                            </div>
                          </div>
                        </div>
                      ) : (
                        <div className="text-slate-500 text-xs text-center flex items-center justify-center">No solution</div>
                      )}
                    </div>
                  </motion.div>
                );
              })}
            </div>
          </div>
        )}

        <Button
          onClick={onClose}
          className="w-full mt-4 sm:mt-6 font-black text-base sm:text-lg py-4 sm:py-6"
          style={{ background: 'var(--u37-magenta)', color: '#050310', boxShadow: '0 0 26px -7px var(--u37-magenta), inset 0 1px 0 rgba(255,255,255,0.4)' }}
        >
          Close
        </Button>
        {/* Spacer reserving native iOS AdMob banner height. On web the banner
            placeholder (WebAdSlot) sits BEHIND this modal's z-50 backdrop, so
            the gap would be dead space — collapse it off-native. */}
        {Capacitor.isNativePlatform() && <div className="h-16 sm:h-0 flex-shrink-0" />}
      </motion.div>
    </motion.div>
  );
}