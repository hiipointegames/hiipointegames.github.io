import { pendingActionKind } from './challengeView';

// The deep-link receiver's routing decision, as a pure + tested function.
//
// A Notifications your-move row (or a stale invite deep-link) navigates to
// `HeadToHead?challenge=<id>&from=<origin>`. The receiver resolves the id to the
// live challenge and asks this helper what to do with it:
//
//   'invite'      — a pending battle addressed to me (normally resolved inline in
//                   the inbox now, but a stale deep-link still lands safely on the
//                   pre-battle confirm)
//   'your-move'   — an accepted battle whose opponent finished, waiting on me
//   'unavailable' — missing / stale / finished / not-mine id → fall back to the
//                   normal Colosseum list (never crash, never open a dead battle)
//
// Built on the canonical `pendingActionKind` classifier (the SAME predicate the
// Notifications hook uses to bucket items) so the deep-link can never disagree
// with the row the player tapped.
export function resolveChallengeTarget(challenge, me) {
  if (!challenge || !me) return 'unavailable';
  const kind = pendingActionKind(challenge, me);
  return kind === 'invite' || kind === 'your-move' ? kind : 'unavailable';
}
