import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { X, Swords, Loader2, Clock, HelpCircle } from 'lucide-react';
import { apiClient } from '@/transport';
import moment from 'moment-timezone';
import PlayerBadges from '@/components/profile/PlayerBadges';
import { playSound } from '@/ui/feedback';
import { getFriendEdges, selectFriendIds, getProfilesByIds } from '@/player';
import { derivePlayerBattleStats } from './playerBattles';
import { BATTLE_DURATIONS_ENABLED, DEFAULT_BATTLE_SECONDS } from './battleConfig';
import { buildBattleDiceSequence } from './battleDeck';
import { BLITZ_TIER_ACCENT, normalizeBlitzMode } from './blitzMode';
import BlitzModeBadge from './BlitzModeBadge';
import BattleDurationPicker from './BattleDurationPicker';

export default function ChallengeFriend({ isOpen, onClose, onSuccess, battleMode = 'easy', onHowTo }) {
  const [friends, setFriends] = useState([]);
  const [loading, setLoading] = useState(true);
  const [challengingId, setChallengingId] = useState(null);
  const [error, setError] = useState('');
  // M3 battle length (gated). A single selector at the top of the modal applies
  // to whichever friend you then battle. When the flag is off it stays at the
  // legacy 10-minute default and no picker shows.
  const [durationSeconds, setDurationSeconds] = useState(DEFAULT_BATTLE_SECONDS);

  // The tier this invite is for, resolved ONCE. Every colour on this screen now
  // derives from it instead of from a `=== 'challenge'` branch that painted
  // Expert in Easy's emerald.
  const tierAccent = BLITZ_TIER_ACCENT(normalizeBlitzMode(battleMode));

  useEffect(() => {
    if (isOpen) {
      setLoading(true);
      setError('');
      loadFriends();

      // Prevent background scrolling
      const scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';

      return () => {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollY);
      };
    }
  }, [isOpen]);

  const loadFriends = async () => {
    try {
      const user = await apiClient.auth.me();

      // Get friend IDs from the one friend-edge read path
      const friendIds = selectFriendIds(await getFriendEdges(user.id), user.id);

      // Get friend profiles (one batched read by id)
      const friendProfiles = [...(await getProfilesByIds(friendIds)).values()];

      // Get existing challenges
      const allChallenges = await apiClient.entities.HeadToHeadChallenge.list();
      const pendingChallenges = allChallenges.filter(
        c => c.status === 'pending' || c.status === 'accepted'
      );
      const completedChallenges = allChallenges.filter(c => c.status === 'completed');

      // Track whether I already have an UNANSWERED invite out to each friend in
      // THIS mode — that alone still shows "Pending" so we never fire duplicate
      // identical invites. (The old 3-open-battles-per-opponent CAP was removed
      // 2026-07-13 per David: players can now have unlimited battles open against
      // one another, so we no longer count outstanding challenges.)
      const hasPendingFromMe = {};
      pendingChallenges.forEach(c => {
        if (c.challenger_id === user.id && c.status === 'pending' && c.blitz_mode === battleMode) {
          hasPendingFromMe[c.opponent_id] = true;
        }
      });

      setFriends(friendProfiles.map(f => {
        const battlePoints = derivePlayerBattleStats(completedChallenges, f.id).battlePoints;
        return {
          ...f,
          hasPendingChallenge: hasPendingFromMe[f.id] || false,
          battlePoints: battlePoints,
          puzzlePoints: f.puzzle_points || 0
        };
      }));
      setLoading(false);
    } catch (error) {
      console.error('Failed to load friends:', error);
      setError('Failed to load friends');
      setLoading(false);
    }
  };

  const handleChallenge = async (friendId, hasPending) => {
    // hasPending = I already have an unanswered invite out to this friend in
    // this mode; there's no longer a numeric cap on total open battles.
    if (challengingId === friendId || hasPending) return;

    try {
      setChallengingId(friendId);
      setError('');

      const user = await apiClient.auth.me();

      // Pre-generate the shared dice sequence. Both players read this same
      // stored array by index, so it must be long enough to never be exhausted
      // in a time-boxed battle. This path used to generate only 10, which made
      // battles diverge at puzzle #11 — see BATTLE_DICE_SEQUENCE_LENGTH.
      //
      // Expert DRAWS from the vetted pool instead of rolling, and THROWS if the
      // pool cannot supply a full deck. See battleDeck.js.
      const diceSequence = await buildBattleDiceSequence({ mode: battleMode });

      await apiClient.entities.HeadToHeadChallenge.create({
        challenger_id: user.id,
        opponent_id: friendId,
        blitz_mode: battleMode,
        status: 'pending',
        dice_sequence: diceSequence,
        challenger_result: {
          run_status: 'not_started',
          completed: false,
          total_solved: 0,
          total_time_seconds: 0,
          solutions: []
        },
        opponent_result: {
          run_status: 'not_started',
          completed: false,
          total_solved: 0,
          total_time_seconds: 0,
          solutions: []
        },
        // Send the chosen length only when B's column exists (flag). Without the
        // gate an unknown column would fail the insert — see battleConfig.js.
        // This is the fix for the Colosseum flow silently defaulting to 600s.
        ...(BATTLE_DURATIONS_ENABLED ? { time_limit_seconds: durationSeconds } : {})
      });

      // Update friend list locally without reloading
      setFriends(prevFriends =>
        prevFriends.map(f =>
          f.id === friendId
            ? { ...f, hasPendingChallenge: true }
            : f
        )
      );

      setChallengingId(null);
    } catch (error) {
      // ⚠️ SURFACE THE REAL MESSAGE WHEN WE HAVE ONE (2026-09-11).
      // `buildBattleDiceSequence` throws ExpertDeckUnavailableError carrying a
      // sentence written FOR the player — that Expert is not available yet and
      // that Easy or Challenge will work right now. Flattening it into "try
      // again" told someone to repeat the one action that cannot succeed, and
      // hid the fact that the other two tiers would. Harmless while Expert was
      // unreachable; not harmless now that it ships.
      const friendly = error?.name === 'ExpertDeckUnavailableError' ? error.message : null;
      console.error('Failed to create challenge:', error);
      setError(friendly || 'Failed to send challenge. Please try again.');
      setChallengingId(null);
    }
  };

  if (!isOpen) return null;

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4 u37-ad-safe-pb"
        onClick={onClose}
      >
        <motion.div
          initial={{ scale: 0.9, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          exit={{ scale: 0.9, opacity: 0 }}
          onClick={(e) => e.stopPropagation()}
          className="bg-gradient-to-b from-indigo-950 to-slate-900 rounded-2xl w-full max-w-md max-h-[80vh] overflow-hidden border border-indigo-800/50"
        >
          {/* Header */}
          <div className="flex items-center justify-between p-6 border-b border-indigo-800/50">
            <div>
              {/* Was a two-branch ternary that rendered an Expert battle as
                  "Easy Mode Battle" in emerald with a white die. Also note the
                  old Challenge branch was ORANGE — Challenge's accent is cyan;
                  the hand-picked colour had drifted from the tier tokens too. */}
              <h2 className="text-xl font-bold" style={{ color: BLITZ_TIER_ACCENT(normalizeBlitzMode(battleMode)) }}>
                Challenge a Friend
              </h2>
              <div className="mt-1">
                <BlitzModeBadge mode={battleMode} variant="inline" suffix=" Mode Battle" />
              </div>
            </div>
            <button
              onClick={() => { playSound('buttonTap'); onClose(); }}
              className="text-slate-400 hover:text-white transition-colors p-2 min-h-[44px] min-w-[44px] touch-manipulation"
            >
              <X className="w-5 h-5" />
            </button>
          </div>

          {/* Content */}
          <div className="p-6 pb-12 overflow-y-auto max-h-[calc(80vh-80px)]">
            {/* Slice E button-hint (mirrored from the daily pre-game modal, blitz
                variant): point out the in-battle controls. Blitz has the in-game
                how-to "?" and mute, but no daily-style forfeit lockdown.
                home-condense H2: a tappable "How to Play" reopen (no scroll gate)
                when the caller wires onHowTo. */}
            <div className="mb-4 flex gap-2 items-center rounded-lg bg-slate-900/50 border border-slate-700/50 px-3 py-2">
              <span className="text-sky-400 text-base flex-shrink-0">💡</span>
              <p className="text-slate-300 text-xs flex-1">
                In a battle, tap <strong className="text-sky-300">?</strong> for how-to-play and the <strong className="text-sky-300">speaker</strong> to mute.
              </p>
              {onHowTo && (
                <button
                  type="button"
                  onClick={() => { playSound('buttonTap'); onHowTo(); }}
                  aria-label="How to play"
                  className="flex-shrink-0 inline-flex items-center gap-1 text-xs font-semibold text-slate-200 hover:text-white rounded-lg px-2 py-1 border border-slate-600 hover:border-slate-500 transition-colors touch-manipulation"
                >
                  <HelpCircle className="w-3.5 h-3.5" />
                  How to Play
                </button>
              )}
            </div>
            {/* M3 battle-length picker (gated) — applies to whichever friend you
                battle from this modal. Fixes the Colosseum flow that skipped the
                picker and always created a 600s battle. */}
            {BATTLE_DURATIONS_ENABLED && (
              <BattleDurationPicker
                value={durationSeconds}
                onChange={setDurationSeconds}
                battleMode={battleMode}
              />
            )}
            {loading ? (
              <div className="flex items-center justify-center py-8">
                <Loader2 className="w-6 h-6 text-purple-400 animate-spin" />
              </div>
            ) : friends.length === 0 ? (
              <div className="text-center py-8">
                <p className="text-slate-400 mb-2">No friends yet</p>
                <p className="text-sm text-slate-500">Add friends to challenge them!</p>
              </div>
            ) : (
              <div className="space-y-3">
                {friends.map(friend => {
                  const isPending = friend.hasPendingChallenge;
                  const isLoading = challengingId === friend.id;

                  return (
                    <motion.div
                      key={friend.id}
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      // Tinted from the TIER's accent rather than a two-branch
                      // class pair that painted Expert in Easy's emerald (and
                      // Challenge in orange, which is not its colour either).
                      className="rounded-xl p-4 border"
                      style={{
                        background: `linear-gradient(to bottom right, color-mix(in srgb, ${tierAccent} 14%, transparent), transparent)`,
                        borderColor: `color-mix(in srgb, ${tierAccent} 45%, transparent)`,
                      }}
                    >
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-white font-semibold">{friend.username}</div>
                          <div className="flex items-center gap-2 mt-1">
                            {friend.country && (
                              <img
                                src={`https://flagcdn.com/w40/${friend.country.toLowerCase()}.png`}
                                alt={friend.country}
                                className="w-6 h-4 object-cover rounded"
                              />
                            )}
                            <PlayerBadges
                              puzzlePoints={friend.puzzlePoints}
                              battlePoints={friend.battlePoints}
                              size="sm"
                            />
                          </div>
                        </div>
                        <Button
                          onClick={() => {
                            if (!isPending) {
                              playSound('swordClash');
                            }
                            handleChallenge(friend.id, isPending);
                          }}
                          disableDefaultSound={!isPending}
                          size="sm"
                          className={`min-h-[44px] touch-manipulation font-bold shadow-lg ${isPending
                            ? 'bg-gradient-to-r from-slate-800 via-indigo-950 to-slate-800 hover:from-slate-700 hover:via-indigo-900 hover:to-slate-700 text-slate-300 border border-indigo-900/40'
                            : 'bg-gradient-to-r from-slate-800 via-indigo-950 to-slate-800 hover:from-slate-700 hover:via-indigo-900 hover:to-slate-700 border border-indigo-900/40'
                            }`}
                        >
                          {isLoading ? (
                            <Loader2 className="w-4 h-4 animate-spin" />
                          ) : isPending ? (
                            <>
                              <Clock className="w-4 h-4 mr-1" />
                              Pending
                            </>
                          ) : (
                            <>
                              <span className="text-base">⚔️</span>
                              {/* 7A: was dark-red gradient text on a dark button (unreadable).
                                  Solid light text keeps the battle feel + is legible. */}
                              <span className="font-black text-red-200">Battle</span>
                            </>
                          )}
                        </Button>
                      </div>
                    </motion.div>
                  );
                })}
              </div>
            )}

            {error && (
              <div className="mt-4 p-3 bg-red-900/30 border border-red-500/50 rounded-lg text-red-200 text-sm">
                {error}
              </div>
            )}
          </div>
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}