import React, { useEffect, useState } from 'react';
import { motion } from 'framer-motion';
import { Swords, UserPlus } from 'lucide-react';
import { getPlayerBattleStats } from './playerBattles';
import { buildInviteText, shareOrCopy } from '@/game-flow';
import { playSound } from '@/ui/feedback';

// Prominent Blitz battle-record summary, pinned near the top of the Colosseum so
// the battle results aren't buried at the bottom of the collapsible Battles
// section (item 12). Shows the player's Easy AND Challenge win–loss records plus
// battle points, points to the full Victories/Defeats history on the Completed
// page, and offers Invite-Friends as a well-timed secondary action.

const MAGENTA = 'var(--u37-magenta)';
const GOLD = 'var(--u37-gold)';

function RecordRow({ label, wins, losses }) {
  return (
    <div className="flex items-center justify-between rounded-xl bg-white/[0.04] border border-white/10 px-3 py-2">
      <span className="text-sm font-bold text-slate-200">{label}</span>
      <span className="text-sm font-black">
        <span className="text-emerald-300">{wins}W</span>
        <span className="text-slate-500 mx-1.5">–</span>
        <span className="text-rose-300">{losses}L</span>
      </span>
    </div>
  );
}

export default function BattleRecordCard({ userId }) {
  const [record, setRecord] = useState(null);

  useEffect(() => {
    if (!userId) return undefined;
    let cancelled = false;
    getPlayerBattleStats(userId)
      .then((r) => { if (!cancelled) setRecord(r); })
      .catch((error) => console.error('Failed to load battle record:', error));
    return () => { cancelled = true; };
  }, [userId]);

  const easy = record?.byMode?.easy || { wins: 0, losses: 0 };
  const challenge = record?.byMode?.challenge || { wins: 0, losses: 0 };
  const battlePoints = record?.battlePoints ?? 0;

  return (
    <motion.div
      data-testid="battle-record-card"
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className="rounded-2xl border-2 p-5 mb-8 backdrop-blur"
      style={{
        borderColor: `color-mix(in srgb, ${MAGENTA} 45%, transparent)`,
        background: 'linear-gradient(to bottom, rgba(15,23,42,0.6), color-mix(in srgb, var(--u37-magenta) 10%, transparent))',
        boxShadow: `0 0 26px -10px ${MAGENTA}, inset 0 0 30px -22px ${MAGENTA}`,
      }}
    >
      <div className="flex items-center gap-2.5 mb-4">
        <Swords className="w-5 h-5" style={{ color: MAGENTA }} />
        <h2 className="text-lg font-black" style={{ color: MAGENTA, textShadow: `0 0 8px color-mix(in srgb, ${MAGENTA} 55%, transparent)` }}>
          Your Battle Record
        </h2>
        <div className="ml-auto text-right leading-none">
          <div className="text-2xl font-black font-mono" style={{ color: GOLD }}>{battlePoints}</div>
          <div className="text-[10px] uppercase tracking-widest font-bold text-slate-400">Battle Pts</div>
        </div>
      </div>

      <div className="grid grid-cols-1 gap-2 mb-3">
        <RecordRow label="Easy Battles" wins={easy.wins} losses={easy.losses} />
        <RecordRow label="Challenge Battles" wins={challenge.wins} losses={challenge.losses} />
      </div>

      <p className="text-xs text-slate-400 text-center mb-4">
        Your full Victories &amp; Defeats history is on the <span className="text-slate-200 font-semibold">Completed</span> page ⚔️
      </p>

      <button
        onClick={() => { playSound('buttonTap'); shareOrCopy('native', buildInviteText()); }}
        className="w-full min-h-[48px] rounded-xl border font-bold flex items-center justify-center gap-2 transition-all touch-manipulation hover:brightness-110"
        style={{
          color: 'var(--u37-green)',
          borderColor: 'var(--u37-green)',
          background: 'color-mix(in srgb, var(--u37-green) 12%, transparent)',
          boxShadow: '0 0 14px -6px var(--u37-green)',
        }}
      >
        <UserPlus className="w-4 h-4" />
        Invite Friends
      </button>
    </motion.div>
  );
}
