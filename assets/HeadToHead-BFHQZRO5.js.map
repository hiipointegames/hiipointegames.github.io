import React, { useState, useEffect } from 'react';
import { ChevronDown, ChevronUp } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import { MiniDice } from '@/puzzle-input';
import { getPlayerBattles, deriveOpponentBreakdown } from '@/head-to-head';
import { getProfilesByIds } from '@/player';
import { playSound } from '@/ui/feedback';
import { BLITZ_MODES, BLITZ_TIER_ACCENT, BLITZ_TIER_LABEL, blitzTierPresentation } from '@/head-to-head';

// Cosmic-neon shell for the whole section (U3). The Blitz Record area is the
// battle family, so the outer panel takes the magenta blitz-battle accent; the
// per-mode sub-panels keep their own accents (Easy=green, Challenge=cyan).
const PANEL_CLASS = 'rounded-2xl p-6 border-2 backdrop-blur';
const PANEL_STYLE = {
  background: 'var(--u37-panel-bg-cosmic)',
  borderColor: 'color-mix(in srgb, var(--u37-magenta) 50%, transparent)',
  boxShadow: '0 0 30px -12px var(--u37-magenta), inset 0 1px 3px rgba(255,255,255,0.05)',
};

// Win / loss stat chip — green neon for wins, red neon for losses (there's no red
// token, so the loss red is a fixed neon hex used consistently here).
function StatChip({ emoji, value, label, tone }) {
  const c = tone === 'win' ? 'var(--u37-green)' : '#ff4d6d';
  const text = tone === 'win' ? 'var(--u37-green)' : '#ff9db0';
  return (
    <div
      className="rounded-lg px-3 py-1.5 text-center border"
      style={{
        background: `color-mix(in srgb, ${c} 20%, transparent)`,
        borderColor: `color-mix(in srgb, ${c} 50%, transparent)`,
      }}
    >
      <div className="text-lg mb-0.5">{emoji}</div>
      <div className="font-black text-base mb-0.5" style={{ color: text }}>{value}</div>
      <div className="text-[10px] font-semibold uppercase" style={{ color: `color-mix(in srgb, ${text} 75%, transparent)` }}>{label}</div>
    </div>
  );
}

// One mode's head-to-head block (Easy=green, Challenge=cyan). `icon` is the
// mode's dice glyph; `stats` is the per-mode {wins, losses, puzzlesSolved,
// opponentPuzzlesSolved} slice.
function ModeBattlePanel({ accent, icon, label, stats }) {
  return (
    <div
      className="p-3 rounded-lg border"
      style={{
        background: `color-mix(in srgb, ${accent} 10%, transparent)`,
        borderColor: `color-mix(in srgb, ${accent} 32%, transparent)`,
      }}
    >
      <div className="text-sm font-bold mb-2 flex items-center gap-1.5" style={{ color: accent }}>
        {icon} {label}
      </div>
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          <StatChip emoji="🏆" value={stats.wins} label="Wins" tone="win" />
          <StatChip emoji="❌" value={stats.losses} label="Losses" tone="loss" />
        </div>
        <div className="text-right">
          <div className="text-[10px] font-semibold uppercase tracking-wide mb-1" style={{ color: `color-mix(in srgb, ${accent} 70%, transparent)` }}>
            Total Puzzles Solved
          </div>
          <div className="text-sm font-bold" style={{ color: accent }}>
            You: {stats.puzzlesSolved} 🧩
          </div>
          <div className="text-sm" style={{ color: `color-mix(in srgb, ${accent} 70%, transparent)` }}>
            Them: {stats.opponentPuzzlesSolved || 0} 🧩
          </div>
        </div>
      </div>
    </div>
  );
}

// `variant` (headtohead | friendslist) used to switch the panel background; the
// U3 cosmic-neon shell is now shared by both, so the prop is no longer read.
/** What a tier with no recorded battles looks like. */
const EMPTY_MODE = Object.freeze({
  wins: 0, losses: 0, puzzlesSolved: 0, opponentPuzzlesSolved: 0,
});

export default function TopBattleOpponents({ currentUserId }) {
  const [isExpanded, setIsExpanded] = useState(false);
  const [topOpponents, setTopOpponents] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (!currentUserId) {
      setLoading(false);
      return;
    }
    const loadTopOpponents = async () => {
      try {
        // Get all completed battles for current user (one read path), then the
        // per-opponent breakdown from head-to-head's pure derivation.
        const userChallenges = await getPlayerBattles(currentUserId);
        const sortedOpponents = deriveOpponentBreakdown(userChallenges, currentUserId).slice(0, 5);

        // Get user profiles for the top opponents (one batched read)
        const profileMap = await getProfilesByIds(sortedOpponents.map(s => s.odId));
        const enrichedOpponents = sortedOpponents.map(stats => {
          const profile = profileMap.get(stats.odId);
          return {
            ...stats,
            username: profile?.username || 'Unknown',
            country: profile?.country
          };
        });

        setTopOpponents(enrichedOpponents);
      } catch (error) {
        console.error('Failed to load top opponents:', error);
      } finally {
        setLoading(false);
      }
    };

    if (currentUserId) {
      loadTopOpponents();
    } else {
      setLoading(false);
    }
  }, [currentUserId]);

  if (loading) {
    return (
      <div className={PANEL_CLASS} style={PANEL_STYLE}>
        <div className="text-center text-slate-300 py-4 font-semibold">⚔️ Loading battle stats...</div>
      </div>
    );
  }

  if (topOpponents.length === 0) {
    return (
      <div className={PANEL_CLASS} style={PANEL_STYLE}>
        <div className="text-center text-slate-300 py-4 font-semibold opacity-70">
          No battles
        </div>
      </div>
    );
  }

  return (
    <div className={PANEL_CLASS} style={PANEL_STYLE}>
      <button
        onClick={() => { playSound('buttonTap'); setIsExpanded(!isExpanded); }}
        className="w-full flex items-center justify-between mb-4 hover:opacity-80 transition-opacity"
      >
        <h3 className="text-xl font-bold flex items-center gap-2">
          <span className="text-2xl">⚔️</span>
          <span
            className="font-black"
            style={{ color: 'var(--u37-magenta)', textShadow: '0 0 14px color-mix(in srgb, var(--u37-magenta) 55%, transparent)' }}
          >
            Top Battle Opponents
          </span>
        </h3>
        {isExpanded ? (
          <ChevronUp className="w-5 h-5" style={{ color: 'var(--u37-magenta)' }} />
        ) : (
          <ChevronDown className="w-5 h-5" style={{ color: 'var(--u37-magenta)' }} />
        )}
      </button>

      <AnimatePresence>
        {isExpanded && (
          <motion.div
            initial={{ height: 0, opacity: 0 }}
            animate={{ height: 'auto', opacity: 1 }}
            exit={{ height: 0, opacity: 0 }}
            transition={{ duration: 0.2 }}
            className="overflow-hidden"
          >
            <div className="space-y-3 max-h-[640px] overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-fuchsia-700 scrollbar-track-slate-800 snap-y snap-mandatory">
              {topOpponents.map((opponent, index) => (
                <div
                  key={opponent.odId}
                  className="p-4 rounded-xl border snap-start"
                  style={{
                    background: 'var(--u37-surface)',
                    borderColor: 'color-mix(in srgb, var(--u37-magenta) 30%, transparent)',
                  }}
                >
                  <div className="flex items-center gap-3 mb-3">
                    <div
                      className="text-2xl font-black"
                      style={{ color: 'var(--u37-gold)', textShadow: '0 0 10px color-mix(in srgb, var(--u37-gold) 50%, transparent)' }}
                    >
                      #{index + 1}
                    </div>
                    {opponent.country && (
                      <img
                        src={`https://flagcdn.com/w40/${opponent.country?.toLowerCase()}.png`}
                        alt="Flag"
                        className="w-6 h-4 object-cover rounded"
                      />
                    )}
                    <div className="flex-1">
                      <div className="text-white font-bold">{opponent.username}</div>
                      <div className="text-xs text-slate-300">⚔️ {opponent.totalBattles} battles</div>
                    </div>
                  </div>

                  {/* One panel per tier. Was two hand-written panels reading
                      `opponent.easyMode` / `opponent.challengeMode`, which is
                      the shape `deriveOpponentBreakdown` produced when it
                      bucketed Expert battles INTO Challenge's record. Both
                      halves are fixed together: the reducer now buckets by tier
                      and this maps the result, so a fourth tier needs neither. */}
                  {BLITZ_MODES.map((tier) => (
                    <div key={tier} className="mb-2 last:mb-0">
                      <ModeBattlePanel
                        accent={BLITZ_TIER_ACCENT(tier)}
                        label={`${BLITZ_TIER_LABEL(tier)} Battles`}
                        icon={(
                          <span className="flex gap-1">
                            {blitzTierPresentation(tier).dice.map((d, i) => (
                              <MiniDice key={i} value={d.value} color={d.color} />
                            ))}
                          </span>
                        )}
                        // `?? emptyModeBreakdown`-shaped fallback: a row built
                        // by an older build has no bucket for a newer tier, and
                        // a missing bucket must render an empty panel rather
                        // than crash the whole profile on `.wins`.
                        stats={opponent.byMode?.[tier] ?? EMPTY_MODE}
                      />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
