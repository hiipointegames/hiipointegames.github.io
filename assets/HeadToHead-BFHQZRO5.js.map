
import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { useNavigate, useSearchParams } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { apiClient } from '@/transport';
import { useInterstitialAd } from '@/shell';
import { playSound } from '@/ui/feedback';

import { BattleRecordCard } from '@/head-to-head';
import { ChallengeList } from '@/head-to-head';
import { HeadToHeadGame } from '@/head-to-head';
import { ChallengeResults } from '@/head-to-head';
import { ChallengeFriend } from '@/head-to-head';
import { HeadToHeadStats } from '@/head-to-head';
import { resolveChallengeTarget } from '@/head-to-head';
import { BATTLE_LENGTH_TAGLINE } from '@/head-to-head';
import { offeredBlitzTiers } from '@/head-to-head';
import { normalizeBlitzMode } from '@/head-to-head';
import { BattleModeCard } from '@/head-to-head';
import { SoloModeCard } from '@/head-to-head';
import StatsCarousel, { StatsSlide } from '@/components/stats/StatsCarousel';
import { TopBattleOpponents } from '@/components/profile';
import { BADGE_IMAGES } from '@/assets/badges';
import { useHowToOverlay } from '@/how-to-play';

export default function HeadToHead() {
  const navigate = useNavigate();
  // In-place how-to overlay: opening "?" from the friend-picker overlays the
  // picker and closes back to it (never navigates away / kicks out of the
  // Colosseum). RC2 fix — see 2026-07-08 occlusion audit.
  const { openHowTo, howToNode } = useHowToOverlay();
  const [activeChallenge, setActiveChallenge] = useState(null);
  const [viewingResults, setViewingResults] = useState(null);
  const [refreshKey, setRefreshKey] = useState(0);
  const [soloBlitzMode, setSoloBlitzMode] = useState(null);
  const [showChallengeFriend, setShowChallengeFriend] = useState(false);
  const [battleMode, setBattleMode] = useState(null);
  // The tiers this build offers, gate already applied. One list feeds BOTH the
  // battle picker and the solo picker so they cannot disagree about Expert.
  const tiers = offeredBlitzTiers();
  // N: the collapsible Battles/Solo/Stats sections became a swipeable one-card-
  // per-screen carousel (Battles | Solo Blitz | Stats & Record). `returnTab` is
  // the slide the carousel opens on when it re-mounts after a pre-game "Not Now"
  // / a finished game — set at the moment a battle/solo run is started so the
  // player lands back on the section they came from (replaces the old
  // setExpandedBattles/setExpandedSolo re-expand; see headToHeadCancel.test.js).
  const [returnTab, setReturnTab] = useState('battles');
  // The origin a deep-linked pre-battle was reached from ('home' via the Home
  // Notifications inbox, 'colosseum' otherwise). Drives where "Not Now" returns:
  // home → back to the Game home; colosseum/default → the Colosseum Battles tab.
  const [battleFrom, setBattleFrom] = useState('colosseum');
  const [searchParams, setSearchParams] = useSearchParams();

  // The battle-points global leaderboard now lives in the unified Leaderboard
  // (Battle Points tab); deep-link there instead of the retired standalone modal.
  // No playSound here. This is passed to HeadToHeadStats' "Battle Points Global
  // Leaderboard" Button, and the Button primitive already plays 'buttonTap' on
  // pointerdown — calling it again from onClick made that one button tap twice
  // (Bryce, 1.0.287). The primitive's 150ms debounce doesn't catch it: it only
  // de-dupes repeat POINTERDOWNS, not a separate direct call from the handler.
  // Same defect and same fix as Invite Friends (docs/bugs.md 2026-07-30).
  const goToBattleLeaderboard = () => {
    navigate(createPageUrl('Leaderboard') + '?tab=battle');
  };
  // 4A: Solo Blitz time preset (minutes). Fixed options, no free-form entry.
  const SOLO_TIME_PRESETS = [1, 3, 5, 7, 10];
  const [soloDurationMin, setSoloDurationMin] = useState(10);
  const [user, setUser] = useState(null);
  // Prepares an interstitial on mount + re-prepares after each dismiss; show()
  // is a fail-safe no-op on web or when no ad is loaded.
  const { show: showInterstitialAd } = useInterstitialAd();

  useEffect(() => {
    const loadUser = async () => {
      try {
        const currentUser = await apiClient.auth.me();
        setUser(currentUser);
      } catch (error) {
        console.error('Failed to load user:', error);
      }
    };
    loadUser();
  }, []);

  // Deep-link receiver: a Notifications your-move row (or a stale invite link)
  // navigates here as `?challenge=<id>&from=<origin>`. Resolve the id to the live
  // challenge, classify it, and open its PRE-BATTLE screen (HeadToHeadGame always
  // shows the ChallengeWarningModal first — never a running timer). Defensive:
  // a missing / stale / finished / not-mine id just clears the param and falls
  // back to the Battles list. The param is cleared either way so a refresh / back
  // never re-fires the deep-link.
  useEffect(() => {
    const challengeId = searchParams.get('challenge');
    if (!challengeId) return;
    const from = searchParams.get('from') === 'home' ? 'home' : 'colosseum';
    let cancelled = false;
    (async () => {
      try {
        const me = (await apiClient.auth.me())?.id;
        const all = await apiClient.entities.HeadToHeadChallenge.list('-created_date');
        const challenge = all.find((c) => String(c.id) === String(challengeId));
        if (cancelled) return;
        const target = resolveChallengeTarget(challenge, me);
        // Clear the deep-link param regardless of outcome (replace so Back skips it).
        setSearchParams({}, { replace: true });
        if (target === 'your-move' || target === 'invite') {
          setReturnTab('battles');
          setBattleFrom(from);
          setActiveChallenge(challenge); // → pre-battle ChallengeWarningModal
        }
      } catch (error) {
        if (!cancelled) {
          console.error('Failed to resolve battle deep-link:', error);
          setSearchParams({}, { replace: true });
        }
      }
    })();
    return () => { cancelled = true; };
  }, [searchParams, setSearchParams]);

  const handleStartChallenge = async (challenge) => {
    setReturnTab('battles');
    setBattleFrom('colosseum');
    await showInterstitialAd();
    setActiveChallenge(challenge);
  };

  const handleStartSoloBlitz = async (mode) => {
    setReturnTab('solo');
    await showInterstitialAd();
    setSoloBlitzMode(mode);
  };

  if (activeChallenge) {
    return (
      <div className="min-h-screen">
        <HeadToHeadGame
          key={`battle-${activeChallenge.id}`}
          challenge={activeChallenge}
          durationSeconds={activeChallenge?.time_limit_seconds ?? 600}
          // A finished battle leaves for /BlitzStats on its own (no onFinished
          // here). The old onComplete reset ran only just before that navigation.
          onCancel={() => {
            // "Not Now" returns to ORIGIN: a battle reached via the Home
            // Notifications inbox (from=home) goes back Home; a colosseum battle
            // (default) lands on the Colosseum Battles tab via the carousel's
            // returnTab (2026-07-08 beta finding).
            setActiveChallenge(null);
            setRefreshKey(prev => prev + 1);
            const goHome = battleFrom === 'home';
            setBattleFrom('colosseum');
            if (goHome) navigate(createPageUrl('Game'));
          }}
          soloMode={null}
        />
      </div>
    );
  }

  if (soloBlitzMode) {
    return (
      <div className="min-h-screen">
        <HeadToHeadGame
          key={`solo-${soloBlitzMode}-${soloDurationMin}`}
          challenge={null}
          soloMode={soloBlitzMode}
          durationSeconds={soloDurationMin * 60}
          // "Not Now" on a solo pre-game returns to the Solo Blitz tab (returnTab
          // was set to 'solo' when the run was started).
          onCancel={() => { setSoloBlitzMode(null); }}
        />
      </div>
    );
  }

  return (
    <div className="app-page-shell relative">
      {/* Decorative bottom shadow/buffer bars removed (2026-06-29, FU-1): ad
          clearance is reserved by the calc(100vh-130px) scroll region below. */}
      <div className="app-page-scroll pt-[60px] scroll-edge-fade-bottom">
        <div className="max-w-2xl mx-auto px-3 sm:px-4 pb-10 min-h-full flex flex-col">
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          className="flex items-center gap-4 mb-3"
        >
          {/* Top-left back button removed (item E, 2026-07-26): the bottom nav
              bar is now the primary navigation, so the Game back button was
              redundant on this nav-bar tab page. */}
          <div data-mode="blitz-battle" className="flex-1 flex items-center gap-2.5 justify-center relative">
            <span className="text-2xl">⚔️</span>
            <h1
              className="text-2xl font-black"
              style={{ color: 'var(--u37-magenta)', textShadow: '0 0 14px color-mix(in srgb, var(--u37-magenta) 55%, transparent)' }}
            >
              BLITZ COLOSSEUM
            </h1>
            <span className="text-2xl">⚔️</span>

          </div>
        </motion.div>

        {/* Notifications live ONLY on the home screen (David, 2026-07-11) — not in
            the Colosseum. The shared inbox is still reachable app-wide from the
            hamburger "Notifications" item. */}

        {/* N: the old Blitz-Modes-Stats section + two collapsible Battles/Solo
            sections are now ONE swipeable one-card-per-screen carousel —
            Battles | Solo Blitz | Stats & Record — matching the unified
            Leaderboard/Statistics gesture model. `returnTab` opens the right
            slide after a pre-game "Not Now". The Stats & Record slide ABSORBS the
            old "View Stats → Statistics?card=blitz" jump (item M): it renders the
            player's own blitz stats inline (with the Battle Points leaderboard
            button) plus the record + by-opponent breakdown. */}
        <div className="flex-1 min-h-0 flex flex-col">
          <StatsCarousel initialSlideId={returnTab}>
            {/* ── Battles ── */}
            <StatsSlide label="Battles" id="battles" accent="var(--u37-magenta)">
              {/* Duplicate "Blitz Battles" <h2> dropped (item 9 condense): the
                  carousel label already names this slide "Battles". Keep the
                  Spartan-helmet badge for identity + the useful subtitle. */}
              <div className="flex items-center gap-3 mb-2">
                {/* The original Bronze Battle Badge (Spartan helmet), bundled in
                    the app (src/assets/badges) — no external URL. */}
                <img src={BADGE_IMAGES.battle.bronze} alt="Battle Badge" className="w-10 h-10 object-contain" />
                <p className="text-slate-400 text-sm">{BATTLE_LENGTH_TAGLINE}</p>
              </div>

              {/* Battle Mode Cards — compact, one per OFFERED tier.
                  Was two cards written out by hand (David 2026-07-11); became a
                  map on 2026-09-11 so Expert could appear at all. `offeredBlitzTiers`
                  is the single place the Expert gate is applied — the old
                  hardcoded pair is exactly why BATTLE_EXPERT_ENABLED could be
                  flipped without Expert showing up in the Colosseum.
                  Three columns when Expert is on, two when it is not. */}
              <div className={`grid ${tiers.length === 3 ? 'grid-cols-3' : 'grid-cols-2'} gap-2 mb-4`}>
                {tiers.map((t) => (
                  <BattleModeCard
                    key={t.mode}
                    mode={t.mode}
                    onSelect={(mode) => {
                      setBattleMode(mode);
                      setShowChallengeFriend(true);
                    }}
                  />
                ))}
              </div>
              <ChallengeList
                key={refreshKey}
                mode="open"
                onStartChallenge={handleStartChallenge}
                onViewResults={setViewingResults}
              />
            </StatsSlide>

            {/* ── Solo Blitz ── */}
            <StatsSlide label="Solo Blitz" id="solo" accent="var(--u37-cyan)">
              {/* Duplicate "Solo Blitz" title row dropped (item 9 condense): the
                  carousel label already names this slide and there is no subtitle
                  worth keeping — the Time-limit selector leads directly. */}
              <div className="space-y-3">
                {/* 4A: fixed time-preset selector (no free-form entry) */}
                <div>
                  <p className="text-xs font-bold uppercase tracking-wider text-blue-300/80 mb-2">Time limit</p>
                  <div className="grid grid-cols-5 gap-2">
                    {SOLO_TIME_PRESETS.map((min) => {
                      const selected = soloDurationMin === min;
                      return (
                        <button
                          key={min}
                          onClick={() => { playSound('buttonTap'); setSoloDurationMin(min); }}
                          aria-pressed={selected}
                          className={`py-2.5 rounded-xl text-sm font-black border-2 transition-all touch-manipulation min-h-[44px] ${
                            selected
                              ? 'bg-gradient-to-br from-blue-500 to-blue-700 text-white border-blue-300 shadow-lg shadow-blue-500/30'
                              : 'bg-slate-800/60 text-blue-200 border-blue-700/40 hover:border-blue-500/60'
                          }`}
                        >
                          {min}<span className="text-[10px] font-bold ml-0.5">min</span>
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* One solo card per offered tier — same list, same gate as
                    the battle cards above, so the two pickers cannot disagree
                    about whether Expert exists. */}
                {tiers.map((t) => (
                  <SoloModeCard
                    key={t.mode}
                    mode={t.mode}
                    durationMin={soloDurationMin}
                    onStart={(mode) => {
                      playSound('buttonTap');
                      handleStartSoloBlitz(mode);
                    }}
                  />
                ))}
              </div>
            </StatsSlide>

            {/* ── Completed ── the completed history + Pending/Victories/Defeats
                sub-tabs. Sits BEFORE Stats: David re-cut the order on
                2026-09-17 to battles · solo · completed · stats · record.
                (It sat after Stats from 2026-07-13 until then.) */}
            <StatsSlide label="Completed" id="completed" accent="var(--u37-blue)">
              {/* Duplicate "Completed Battles" title row dropped (item 9
                  condense): the carousel label already names this slide and
                  there is no subtitle worth keeping. */}
              <ChallengeList
                key={refreshKey}
                mode="completed"
                onStartChallenge={handleStartChallenge}
                onViewResults={setViewingResults}
              />
            </StatsSlide>

            {/* ── Stats (David 2026-07-13) ── the blitz-mode stats on their own
                page (split out of the old "Stats & Record"), incl. the Battle
                Points global-leaderboard button. Visuals live in HeadToHeadStats. */}
            <StatsSlide label="Stats" id="stats" accent="var(--u37-violet)">
              <HeadToHeadStats inline opponentId={null} onOpenLeaderboard={goToBattleLeaderboard} />
            </StatsSlide>

            {/* ── Record (David 2026-07-13) ── the overall W/L record header + the
                by-opponent "top battle opponents" expandable, split onto the final
                page. */}
            <StatsSlide label="Record" id="record" accent="var(--u37-magenta)">
              <div className="space-y-6">
                <BattleRecordCard userId={user?.id} />
                <TopBattleOpponents currentUserId={user?.id} />
              </div>
            </StatsSlide>
          </StatsCarousel>
        </div>
        </div>
      </div>

      {/* Results Modal */}
      {viewingResults && (
        <ChallengeResults
          challenge={viewingResults}
          onClose={() => setViewingResults(null)}
        />
      )}

      {/* Challenge Friend Modal */}
      <ChallengeFriend
        isOpen={showChallengeFriend}
        onClose={() => {
          setShowChallengeFriend(false);
          setBattleMode(null);
        }}
        onSuccess={() => {
          setRefreshKey(prev => prev + 1);
          setBattleMode(null);
        }}
        battleMode={battleMode}
        // 🔴 NOT A LABEL BUG — A WRONG RULEBOOK. This collapsed every non-
        // Challenge tier to 'easy', so a player setting up an EXPERT battle who
        // tapped "how to play" was shown the EASY how-to: no power dice, no
        // perfect-solve requirement. Exactly the rules Expert does not use.
        onHowTo={() => openHowTo(normalizeBlitzMode(battleMode), { context: 'choose-opponent', testId: 'picker-howto' })}
      />

      {howToNode}
    </div>
  );
}