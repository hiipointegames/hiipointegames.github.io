import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { Trophy, Clock, CheckCircle, XCircle, Play, Skull } from 'lucide-react';
import { apiClient } from '@/transport';
import moment from 'moment-timezone';
import { nowET, todayET } from '@/daily-challenge';
import PlayerBadges from '@/components/profile/PlayerBadges';
import { getProfilesByIds } from '@/player';
import { perspectiveOf, involvesPlayer, bucketChallenge } from './challengeView';
import BlitzModeBadge from './BlitzModeBadge';
import { recordForfeit, acceptBattleInvite, declineBattleInvite, cancelBattleInvite } from './battleWrites';
import { DEFAULT_BATTLE_SECONDS } from './battleConfig';
import { playSound } from '@/ui/feedback';

// Neon-cosmic palette helpers (David 2026-07-13): the completed history read
// off-theme (Challenge badge amber-orange, purple "solved" text, purple→pink
// action). These pull from the theme accents so the Colosseum's Completed slide
// matches the rest of the app — Easy=green, Challenge=cyan, and the
// View-Results action carries the magenta battle identity.
// The mode badge lives in `BlitzModeBadge` now, along with the account of the
// two-branch bug that used to live here — this file had its own `? 'Challenge' :
// 'Easy'` pair, which rendered Expert as Easy. Fixing it here alone, hours
// before David found the identical bug still live in the notifications centre,
// is why it became one shared component.
// Battle-length badge (David 2026-07-30, from Bryce's 1.0.285 feedback). Battle
// durations became selectable in 1.0.285 (stored on the challenge as
// `time_limit_seconds`), so a card must say whether it's a 3- or 10-minute race
// — otherwise two "Easy" battles from the same opponent are indistinguishable.
// Legacy battles created before durations were selectable have no
// `time_limit_seconds`; those were always 10-minute races, so fall back to the
// historical DEFAULT_BATTLE_SECONDS rather than rendering "undefined min".
const battleDurationMinutes = (challenge) => {
  const seconds = challenge?.time_limit_seconds ?? DEFAULT_BATTLE_SECONDS;
  return Math.round(seconds / 60);
};

const SUBTAB_COLORS = { pending: '#fbbf24', victories: 'var(--u37-green)', defeats: '#f43f5e' };
const subTabStyle = (key, active) => {
  const c = SUBTAB_COLORS[key];
  return active
    ? { color: `color-mix(in srgb, ${c} 22%, white)`, background: `color-mix(in srgb, ${c} 20%, transparent)`, border: `1.5px solid ${c}`, boxShadow: `0 0 14px -5px ${c}` }
    : { color: '#cbd5e1', background: 'rgba(30,41,59,0.55)', border: '1.5px solid rgba(255,255,255,0.08)' };
};

// `mode` selects which battle list this instance renders — the Colosseum shows
// New/Open on the Battles slide and the completed history (Pending/Victories/
// Defeats sub-tabs) on its own "Completed" slide, so each slide mounts one
// ChallengeList with a fixed mode instead of an in-list Open/Completed toggle.
export default function ChallengeList({ onStartChallenge, onViewResults, mode = 'open' }) {
  const [challenges, setChallenges] = useState([]);
  const [userId, setUserId] = useState('');
  const [loading, setLoading] = useState(true);
  const filter = mode; // 'open' | 'completed' — fixed per slide (no in-list toggle)
  // ⚠️ THE DEFAULT FOLLOWS THE PILL ORDER. When David re-cut the pills to
  // Victories · Defeats · Pending on 2026-09-17, leaving this at 'pending' would
  // have opened the Completed slide on the THIRD pill — which reads as a bug
  // rather than as a choice, and is the kind of thing a reorder quietly breaks.
  const [completedSubTab, setCompletedSubTab] = useState('victories'); // victories, defeats, pending
  const [liveTimers, setLiveTimers] = useState({});

  useEffect(() => {
    loadChallenges();
  }, []);

  // Live timer countdown for in-progress battles
  useEffect(() => {
    const interval = setInterval(() => {
      const timers = {};
      challenges.forEach(challenge => {
        const myResult = getMyResult(challenge);
        if (myResult?.run_status === 'in_progress' && myResult?.start_time) {
          const startTime = new Date(myResult.start_time).getTime();
          const elapsed = (Date.now() - startTime) / 1000;
          const remaining = Math.max(0, 600 - elapsed);
          timers[challenge.id] = remaining;
        }
      });
      setLiveTimers(timers);
    }, 100);

    return () => clearInterval(interval);
  }, [challenges, userId]);

  const loadChallenges = async () => {
    try {
      const user = await apiClient.auth.me();
      setUserId(user.id);

      const allChallenges = await apiClient.entities.HeadToHeadChallenge.list('-created_date');

      // Filter challenges involving this user
      const userChallenges = allChallenges.filter(c => involvesPlayer(c, user.id));

      // Check for expired challenges AND orphaned forfeits
      const today = todayET();
      for (const challenge of userChallenges) {
        // Fix: Update any challenge where someone forfeited but status isn't 'completed'
        const challengerForfeited = challenge.challenger_result?.run_status === 'forfeited';
        const opponentForfeited = challenge.opponent_result?.run_status === 'forfeited';

        if ((challengerForfeited || opponentForfeited) && challenge.status !== 'completed' && challenge.status !== 'forfeited') {
          // Someone forfeited - finalize the battle
          const winner = challengerForfeited ? challenge.opponent_id : challenge.challenger_id;
          // Intended as a stable finalized_date (the creation date) so the card
          // never "rolls" to today. In practice `created_date` is not a column
          // (the table has `created_at`), so this always falls through to now.
          const stableFinalizedDate = challenge.created_date || new Date().toISOString();
          await apiClient.entities.HeadToHeadChallenge.update(challenge.id, {
            status: 'completed',
            winner_id: winner,
            finalized_date: stableFinalizedDate
          });
        }

        // Check expired challenges
        if (challenge.status === 'accepted' && challenge.expiry_date && challenge.expiry_date < today) {
          const challengerDone = challenge.challenger_result?.completed;
          const opponentDone = challenge.opponent_result?.completed;

          if (!challengerDone || !opponentDone) {
            // Someone didn't complete - forfeit
            const winner = challengerDone ? challenge.challenger_id : (opponentDone ? challenge.opponent_id : null);
            // Use the completing player's completed_date (stable). With nobody
            // finished, the `created_date` fallback is not a column (the table has
            // `created_at`), so this falls through to now.
            const stableForfeitDate =
              (challengerDone ? challenge.challenger_result?.completed_date : null) ||
              (opponentDone ? challenge.opponent_result?.completed_date : null) ||
              challenge.created_date ||
              new Date().toISOString();
            await apiClient.entities.HeadToHeadChallenge.update(challenge.id, {
              status: 'forfeited',
              winner_id: winner,
              finalized_date: stableForfeitDate
            });
          }
        }
      }

      // Reload after cleanup — sort by created_date so display order is stable
      // and not affected by when the forfeit was detected
      const updatedChallenges = await apiClient.entities.HeadToHeadChallenge.list('-created_date', 100);
      const finalChallenges = updatedChallenges.filter(c => involvesPlayer(c, user.id));

      setChallenges(finalChallenges);
      setLoading(false);
    } catch (error) {
      console.error('Failed to load challenges:', error);
      setLoading(false);
    }
  };

  const handleAcceptChallenge = async (challenge) => {
    try {
      await acceptBattleInvite(challenge.id);
      await loadChallenges();
    } catch (error) {
      console.error('Failed to accept challenge:', error);
    }
  };

  const handleDeclineChallenge = async (challenge) => {
    try {
      await declineBattleInvite(challenge.id);
      loadChallenges();
    } catch (error) {
      console.error('Failed to decline challenge:', error);
    }
  };

  const handleCancelChallenge = async (challenge) => {
    try {
      // Retract a pending invite I sent (challenger-side). Deletes the pending
      // row so it disappears for both players; loadChallenges refreshes the list.
      await cancelBattleInvite(challenge.id);
      loadChallenges();
    } catch (error) {
      console.error('Failed to cancel challenge:', error);
    }
  };

  const handleForfeitChallenge = async (challenge) => {
    try {
      const user = await apiClient.auth.me();
      const { myResult, myResultKey, opponentId } = perspectiveOf(challenge, user.id);
      // Forfeiter loses → opponent is the winner. recordForfeit writes the
      // forfeited result column + finalize and folds the loss into blitzStats
      // via the shared applyBattleOutcome (was inline-duplicated here).
      await recordForfeit({
        currentUser: user,
        challengeId: challenge.id,
        myResultKey,
        myResult,
        opponentId,
      });

      loadChallenges();
    } catch (error) {
      console.error('Failed to forfeit challenge:', error);
    }
  };

  const getOpponentId = (challenge) => perspectiveOf(challenge, userId).opponentId;

  const [opponentNames, setOpponentNames] = useState({});
  const [opponentProfiles, setOpponentProfiles] = useState({});

  useEffect(() => {
    const loadNames = async () => {
      if (!userId) return; // Wait for user ID to be loaded

      // One batched read for every opponent (was 2 queries per opponent).
      const opponentIds = [...new Set(challenges.map(getOpponentId))];
      try {
        const profileMap = await getProfilesByIds(opponentIds);
        const names = {};
        const profiles = {};
        for (const opId of opponentIds) {
          const profile = profileMap.get(opId);
          names[opId] = profile?.username || 'Unknown Player';
          if (profile) profiles[opId] = profile;
        }
        setOpponentNames(names);
        setOpponentProfiles(profiles);
      } catch {
        const names = {};
        for (const opId of opponentIds) names[opId] = 'Unknown Player';
        setOpponentNames(names);
      }
    };
    if (challenges.length > 0 && userId) {
      loadNames();
    }
  }, [challenges, userId]);

  const getMyResult = (challenge) => perspectiveOf(challenge, userId).myResult;
  const getOpponentResult = (challenge) => perspectiveOf(challenge, userId).opponentResult;

  // Tab routing via the pure bucketChallenge classifier. The (filter,
  // completedSubTab) → bucket mapping below preserves the original predicate
  // exactly, including: non-completed battles excluded from the completed tab,
  // a finalized tie ('completed-other') matching no sub-tab, and the
  // unrecognized-subTab fall-through to "show".
  const filteredChallenges = challenges.filter(c => {
    c._stableDate = perspectiveOf(c, userId).stableDate;
    const bucket = bucketChallenge(c, userId);

    if (filter === 'open') return bucket === 'open';
    if (filter === 'completed') {
      if (bucket === 'open' || bucket === null) return false; // not in the completed set
      if (completedSubTab === 'pending') return bucket === 'pending';
      if (completedSubTab === 'victories') return bucket === 'victories';
      if (completedSubTab === 'defeats') return bucket === 'defeats';
    }
    return true;
  });

  // Sort battles: Always newest at the top (Reverse-Chronological)
  const sortedChallenges = filteredChallenges.sort((a, b) => {
    // Primary sort: Date (Stable completion date or creation date)
    const dateA = a._stableDate || '';
    const dateB = b._stableDate || '';
    const dateComparison = dateB.localeCompare(dateA);

    if (filter === 'open') {
      // Secondary sort for open battles: status (accepted/active before pending/invite)
      if (dateComparison !== 0) return dateComparison;
      const aStatus = a.status;
      const bStatus = b.status;
      if (aStatus === 'accepted' && bStatus === 'pending') return -1;
      if (aStatus === 'pending' && bStatus === 'accepted') return 1;
      return 0;
    }

    return dateComparison;
  });

  if (loading) {
    return <div className="text-center text-slate-400 py-8">Loading challenges...</div>;
  }

  return (
    <div>
      {/* Which battle list this instance renders is fixed by `mode` (the Battles
          slide passes 'open', the Completed slide 'completed') — the old in-list
          Open/Completed toggle is gone. */}

      {/* Completed Sub-Tabs — neon-outline pills in the accent for each bucket
          (amber pending, green victories, rose defeats). */}
      {filter === 'completed' && (
        <div className="flex gap-2 mb-4">
          {/* Victories · Defeats · Pending (David, 2026-09-17). Was
              Pending-first. */}
          {[['victories', 'Victories'], ['defeats', 'Defeats'], ['pending', 'Pending']].map(([key, label]) => (
            <button
              key={key}
              onClick={() => { playSound('buttonTap'); setCompletedSubTab(key); }}
              className="px-3 py-2 rounded-lg text-xs font-bold transition-all min-h-[40px] touch-manipulation"
              style={subTabStyle(key, completedSubTab === key)}
            >
              {label}
            </button>
          ))}
        </div>
      )}

      {/* Challenge List */}
      {sortedChallenges.length === 0 ? (
        <div className="text-center text-slate-400 py-8">
          {filter === 'open'
            ? 'No open battles'
            : completedSubTab === 'pending'
              ? 'No pending battles'
              : completedSubTab === 'victories'
                ? 'No victories yet'
                : 'No defeats yet'}
        </div>
      ) : (
        <div className={`space-y-3 ${filter === 'completed' ? 'max-h-[600px] overflow-y-auto pr-2' : ''}`}>
          {sortedChallenges.map(challenge => {
            const opId = getOpponentId(challenge);
            const opponentName = opponentNames[opId] || 'Loading...';
            const myResult = getMyResult(challenge);
            const opponentResult = getOpponentResult(challenge);
            const isChallenger = challenge.challenger_id === userId;

            // Determine run status
            const runStatus = myResult?.run_status || 'not_started';
            const isInProgress = runStatus === 'in_progress';
            const isForfeited = runStatus === 'forfeited';
            const isCompleted = runStatus === 'completed' || myResult?.completed;

            // Color scheme for completed battles
            const isWinner = challenge.winner_id === userId;
            const isTie = !challenge.winner_id && challenge.status === 'completed';

            // Pre-compute label strings to avoid IIFEs in JSX (iOS Safari crash)
            const opponentDidForfeit = opponentResult?.run_status === 'forfeited';
            const iForfeited = runStatus === 'forfeited';


            let victoryLabel = '🏆 Victory!';
            if (completedSubTab === 'victories' && opponentDidForfeit) {
              victoryLabel = '🏆 Victory (Opponent Forfeited)';
            }

            let defeatLabel = '💀 Defeated';
            if (completedSubTab === 'defeats' && iForfeited) {
              defeatLabel = '💀 Defeated (You Forfeited)';
            } else if (completedSubTab === 'defeats' && opponentDidForfeit) {
              defeatLabel = '💀 Defeated (Opponent Forfeited - Fewer Solved)';
            }

            let expiryLabel = '';
            if (challenge.status === 'accepted' && challenge.expiry_date) {
              const today = nowET();
              const expiry = moment.tz(challenge.expiry_date, 'America/New_York');
              const daysLeft = expiry.diff(today, 'days');
              expiryLabel = daysLeft > 0 ? `${daysLeft} day${daysLeft !== 1 ? 's' : ''} left` : 'Expires today';
            }

            return (
              <motion.div
                key={challenge.id}
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                className={`backdrop-blur rounded-2xl p-4 border-2 shadow-lg ${filter === 'completed'
                  ? (isCompleted && !opponentResult?.completed && challenge.status === 'accepted')
                    ? 'bg-gradient-to-br from-amber-600/20 via-orange-600/10 to-red-600/20 border-amber-400/50 shadow-amber-500/20'
                    : isWinner
                      ? 'bg-gradient-to-br from-emerald-600/20 via-green-600/10 to-emerald-700/20 border-emerald-400/50 shadow-emerald-500/20'
                      : isTie
                        ? 'bg-gradient-to-br from-blue-500/20 via-cyan-500/10 to-purple-500/20 border-blue-400/50 shadow-blue-500/20'
                        : 'bg-gradient-to-br from-slate-800/60 via-purple-900/20 to-slate-800/60 border-purple-500/30 shadow-purple-500/10'
                  : challenge.status === 'pending'
                    ? 'bg-gradient-to-br from-orange-600/20 via-red-600/10 to-orange-700/20 border-orange-400/50 shadow-orange-500/20'
                    : 'bg-gradient-to-br from-slate-800/60 via-red-900/20 to-slate-800/60 border-red-500/30 shadow-red-500/10'
                  }`}
              >
                <div className="flex items-start justify-between mb-3">
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 mb-1 flex-wrap">
                      <span className={`font-bold text-lg ${filter === 'completed' && isWinner
                        ? 'text-emerald-300'
                        : filter === 'open'
                          ? 'text-orange-300'
                          : 'text-slate-200'
                        }`}>{opponentName}</span>
                      {opponentProfiles[opId] && (
                        <PlayerBadges
                          puzzlePoints={opponentProfiles[opId].puzzle_points || 0}
                          battlePoints={opponentProfiles[opId].battle_points || 0}
                          size="sm"
                        />
                      )}
                    </div>

                    {/* Mode Badge with mini dice.

                        ⚠️ THIS ROW MUST WRAP. Reported by David 2026-09-12: on a
                        completed CHALLENGE battle the duration pill overlapped the
                        "View Results" button. The row was `flex` with no wrap, and a
                        flex child defaults to `min-width: auto` — it will not shrink
                        below its content, so it OVERFLOWS the column (which is
                        `flex-1 min-w-0`, i.e. allowed to be narrower than its
                        contents) straight over the button beside it.

                        Measured in a reproduction of this markup at 360px wide,
                        gap between the pill's right edge and the button's left:

                          badge "EASY"                  +114px   fine
                          badge "CHALLENGE BATTLE ⚀⚁⚂"    -1px   OVERLAP
                          longer                         -45px   OVERLAP

                        Which is why David saw it on Challenge and not on Easy —
                        Challenge is simply the first badge wide enough to cross
                        over. `flex-wrap` + `shrink-0` takes all three to a clean
                        gap, AND leaves the pill inline when there is room (the
                        short-badge case is unchanged at +114px), so this is not a
                        layout change for the cards that were already fine. */}
                    <div className="flex items-center flex-wrap gap-y-1 mb-2 -ml-1">
                      {/* One shared badge across every surface that answers
                          "which battle is this?" — see BlitzModeBadge. This site
                          was fixed first, on its own, hours before David found
                          the SAME two-branch bug still live in the notifications
                          centre. Fixing one copy of a repeated mistake leaves
                          the rest; the component is what ends it. */}
                      <BlitzModeBadge mode={challenge.blitz_mode} className="scale-[0.85] origin-left" />
                      {/* Duration badge (Bryce feedback): which battle length this
                          is, now that durations vary. Slate chip keeps the mode
                          pill's accent as the primary signal. */}
                      <span className="ml-2 shrink-0 inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full font-semibold text-slate-300 bg-slate-700/40 border border-slate-500/40">
                        <Clock className="w-3 h-3" />
                        {battleDurationMinutes(challenge)} min
                      </span>
                    </div>
                    <div className={`text-sm font-semibold ${filter === 'completed'
                      ? isWinner
                        ? 'text-emerald-400'
                        : isTie
                          ? 'text-blue-400'
                          : 'text-slate-400'
                      : filter === 'open'
                        ? 'text-orange-400'
                        : 'text-slate-400 text-xs'
                      }`}>
                      {challenge.status === 'pending' && !isChallenger && 'Waiting for you to accept'}
                      {challenge.status === 'pending' && isChallenger && `Waiting for ${opponentName} to accept or decline the battle`}
                      {challenge.status === 'accepted' && isForfeited && 'Did not complete'}
                      {challenge.status === 'accepted' && !isCompleted && !isForfeited && !opponentResult?.completed && 'Ready to start'}
                      {challenge.status === 'accepted' && !isCompleted && !isForfeited && opponentResult?.completed && (
                        <span className="text-amber-400">They're waiting</span>
                      )}
                      {challenge.status === 'completed' && (challenge.winner_id === userId
                        ? victoryLabel
                        : challenge.winner_id
                          ? defeatLabel
                          : '⚡ Battle Tied! - Fastest solve wins tiebreaker, check results')}
                      {challenge.status === 'accepted' && isCompleted && `Waiting on ${opponentName} to complete battle`}
                      {challenge.status === 'forfeited' && (challenge.winner_id === userId ? '🏳️ Won by Forfeit!' : '🏳️ Defeated (You Forfeited)')}
                    </div>
                    {expiryLabel && (
                      <div className="text-xs text-amber-400 mt-1">
                        {expiryLabel}
                      </div>
                    )}
                  </div>

                  {challenge.status === 'pending' && !isChallenger && (
                    <div className="flex flex-col gap-2">
                      <Button
                        onClick={() => handleAcceptChallenge(challenge)}
                        size="sm"
                        className="bg-emerald-600 hover:bg-emerald-700 min-h-[44px] touch-manipulation"
                      >
                        Accept
                      </Button>
                      <Button
                        onClick={() => handleDeclineChallenge(challenge)}
                        size="sm"
                        variant="outline"
                        className="border-red-600 text-red-400 hover:bg-red-600/20 min-h-[44px] touch-manipulation"
                      >
                        Decline
                      </Button>
                    </div>
                  )}

                  {challenge.status === 'pending' && isChallenger && (
                    <div className="flex flex-col gap-2">
                      <div className="flex items-center justify-center gap-1 text-amber-400 text-xs font-semibold min-h-[28px]">
                        <Clock className="w-4 h-4" />
                        Pending
                      </div>
                      {/* Let the challenger retract an unanswered invite (David
                          2026-07-13): the opponent may never respond, so the
                          sender needs a way to clear it. */}
                      <Button
                        onClick={() => { playSound('buttonTap'); handleCancelChallenge(challenge); }}
                        disableDefaultSound
                        size="sm"
                        variant="outline"
                        className="border-red-600 text-red-400 hover:bg-red-600/20 min-h-[44px] touch-manipulation"
                      >
                        Cancel
                      </Button>
                    </div>
                  )}

                  {challenge.status === 'accepted' && runStatus === 'not_started' && (
                    <div className="flex flex-col gap-2">
                      <Button
                        onClick={() => onStartChallenge(challenge)}
                        size="sm"
                        className="bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-700 hover:to-red-700 font-bold shadow-lg min-h-[44px] touch-manipulation"
                      >
                        <Play className="w-4 h-4 mr-1" />
                        Start
                      </Button>
                      <Button
                        onClick={() => handleForfeitChallenge(challenge)}
                        size="sm"
                        variant="outline"
                        className="border-red-600 text-red-400 hover:bg-red-600/20 min-h-[44px] touch-manipulation"
                      >
                        Forfeit
                      </Button>
                    </div>
                  )}



                  {challenge.status === 'accepted' && isForfeited && (
                    <Button
                      disabled
                      size="sm"
                      variant="outline"
                      className="opacity-50 cursor-not-allowed border-red-600/50 text-red-400"
                    >
                      Did Not Complete
                    </Button>
                  )}

                  {((challenge.status === 'completed' || challenge.status === 'forfeited') || (challenge.status === 'accepted' && isCompleted)) && (
                    <Button
                      disableDefaultSound={true}
                      onClick={() => {
                        if (completedSubTab === 'victories') playSound('victoryResults');
                        else if (completedSubTab === 'defeats') playSound('punch');
                        else playSound('buttonTap');
                        onViewResults(challenge);
                      }}
                      size="sm"
                      className={`min-h-[40px] shrink-0 touch-manipulation text-xs px-3 flex flex-col gap-0 font-bold ${filter === 'completed'
                        ? 'text-white shadow-lg'
                        : 'border-slate-600 text-slate-300'
                        }`}
                      style={filter === 'completed' ? { background: 'var(--u37-grad-blitz-battle)', boxShadow: '0 0 16px -6px var(--u37-magenta)' } : undefined}
                      variant={filter === 'completed' ? 'default' : 'outline'}
                    >
                      <span>View</span>
                      <span>Results</span>
                    </Button>
                  )}
                </div>

                {/* Progress indicators */}
                {(challenge.status === 'accepted' || challenge.status === 'completed' || challenge.status === 'forfeited') && (
                  <div>
                    {filter === 'completed' && (
                      <div className="text-slate-300 text-xs font-semibold mb-1.5 opacity-90">
                        {moment(challenge._stableDate).tz('America/New_York').format('MMMM D, YYYY')}
                      </div>
                    )}
                    <div className={`flex gap-4 text-sm ${filter === 'completed' || filter === 'open' ? 'font-semibold' : 'text-xs'
                      }`}>
                      <div className="flex items-center gap-1.5">
                        {myResult?.completed ? (
                          <CheckCircle className="w-5 h-5 text-emerald-400" />
                        ) : (
                          <Clock className="w-5 h-5 text-amber-400" />
                        )}
                        <span className={filter === 'completed' ? 'text-slate-200' : filter === 'open' ? 'text-orange-300' : 'text-slate-300'}>
                          You: {myResult?.total_solved || 0} solved
                        </span>
                      </div>
                      <div className="flex items-center gap-1.5">
                        {opponentResult?.completed ? (
                          <CheckCircle className="w-5 h-5 text-emerald-400" />
                        ) : (
                          <Clock className="w-5 h-5 text-amber-400" />
                        )}
                        <span className={filter === 'completed' ? 'text-slate-200' : filter === 'open' ? 'text-orange-300' : 'text-slate-300'}>
                          {opponentName}: {opponentResult?.total_solved || 0} solved
                        </span>
                      </div>
                    </div>
                    {filter === 'completed' && (completedSubTab === 'victories' || completedSubTab === 'defeats') &&
                      (challenge.status === 'completed' || challenge.status === 'forfeited') &&
                      myResult?.total_solved === opponentResult?.total_solved &&
                      myResult?.total_solved >= 1 && opponentResult?.total_solved >= 1 && (
                        <div className="text-xs text-amber-400 mt-2 font-semibold">
                          ⚡ Check tiebreaker times
                        </div>
                      )}
                  </div>
                )}
              </motion.div>
            );
          })}
        </div>
      )}
    </div>
  );
}