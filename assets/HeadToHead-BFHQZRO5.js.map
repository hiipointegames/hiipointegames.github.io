import React from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';

import { BLITZ_TIER_ACCENT } from './blitzMode';
import { blitzTierPresentation, blitzSoloCardTitle } from './blitzTierPresentation';

// One solo-Blitz card in the Colosseum ("Easy Mode Blitz" and friends).
//
// Extracted alongside BattleModeCard for the same reason and in the same pass
// (David, 2026-09-11 — Expert had to appear in the Colosseum): the solo picker
// was also two cards written out by hand, Easy in emerald literals and Challenge
// painting from a `data-mode` slot, with the duration sentence duplicated in
// both. Adding Expert by hand would have made three.
//
// The whole card is the control — the old markup had a `<Button>` inside a
// clickable `<motion.div>`, so the button was decorative and the div carried the
// handler. That is kept rather than "fixed": the entire surface being tappable
// is the right target size on a phone, and the button reads as the affordance.
// What changed is that `disableDefaultSound` and the sound call now live in one
// place instead of being repeated per card.

/**
 * @param {object} props
 * @param {string} props.mode the blitz tier ('easy' | 'challenge' | 'expert')
 * @param {number} props.durationMin the chosen solo length, in minutes
 * @param {(mode: string) => void} props.onStart called with the chosen tier
 */
export default function SoloModeCard({ mode, durationMin, onStart }) {
  const { soloBlurb } = blitzTierPresentation(mode);
  const accent = BLITZ_TIER_ACCENT(mode);

  return (
    <motion.div
      whileHover={{ scale: 1.02 }}
      whileTap={{ scale: 0.98 }}
      data-testid="solo-mode-card"
      data-mode={mode}
      // The accent, stated as an attribute so it is OBSERVABLE. This card is a
      // motion.div: framer-motion applies `style` through the style property and
      // never writes the attribute, and happy-dom cannot parse `color-mix()`
      // into `.style.borderColor` either — so there is no way to assert from the
      // DOM that this card wears the right tier colour. Rather than delete the
      // assertion (the old Easy card's hardcoded emerald is precisely what this
      // pass removed, so it is worth guarding) the value is published here.
      data-accent={accent}
      className="bg-gradient-to-br from-slate-800 via-indigo-950 to-slate-800 backdrop-blur rounded-xl p-4 border-2 cursor-pointer"
      style={{ borderColor: `color-mix(in srgb, ${accent} 40%, transparent)` }}
      onClick={() => onStart(mode)}
    >
      <div className="flex items-center justify-between gap-3">
        <div className="min-w-0">
          <h3 className="text-xl font-black mb-1" style={{ color: accent }}>
            {blitzSoloCardTitle(mode)}
          </h3>
          <p className="text-sm leading-snug" style={{ color: `color-mix(in srgb, ${accent} 55%, white)` }}>
            {durationMin} minute{durationMin > 1 ? 's' : ''} • {soloBlurb}
          </p>
        </div>
        {/* The whole card is the control; this button works by BUBBLING — a
            click (or Enter on it while focused) reaches the card's onClick and
            starts the blitz. That is the original behaviour and it is kept.
            `disableDefaultSound` because the card's handler plays the tap.

            An earlier draft marked this `tabIndex={-1}` + `aria-hidden`, on the
            theory that it was decorative. It is not: it is reachable, it works,
            and hiding it would have removed the only keyboard affordance on the
            card. The Button primitive's prop types reject `tabIndex` anyway,
            which is what surfaced the mistake. */}
        <Button
          disableDefaultSound={true}
          className="min-h-[44px] touch-manipulation font-bold shadow-lg border-2 flex-shrink-0"
          style={{
            background: `color-mix(in srgb, ${accent} 22%, transparent)`,
            borderColor: accent,
            color: accent,
          }}
        >
          Start
        </Button>
      </div>
    </motion.div>
  );
}
