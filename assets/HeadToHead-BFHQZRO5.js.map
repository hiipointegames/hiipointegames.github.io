import React from 'react';
import { Users } from 'lucide-react';
import { Button } from '@/ui/primitives/button';
import { MiniDice } from '@/puzzle-input';

import { BLITZ_TIER_ACCENT } from './blitzMode';
import { blitzTierPresentation, blitzBattleCardTitle } from './blitzTierPresentation';

// One "Battle Friends" card in the Colosseum's battle picker.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT LEFT HeadToHead.jsx
// ─────────────────────────────────────────────────────────────────────────────
// David, 2026-09-11: "i also still do not see anything within the blitz
// colosseum about expert mode battles - that doesnt appear anywhere within the
// game". The reason was not the feature flag. The picker was TWO CARDS WRITTEN
// OUT BY HAND — Easy in hardcoded emerald literals, Challenge painting from a
// `data-mode` slot — and nothing in it read `BATTLE_EXPERT_ENABLED` at all.
// Flipping that flag would have changed the stats tabs and the profile card and
// left the Colosseum exactly as it was.
//
// A third hand-written card would have made that worse: three copies of the same
// markup in one 442-line page, in two different colour idioms, is how Expert
// ends up a slightly different shape from the other two. So the card became a
// component the picker MAPS over, and the tier list comes from
// `offeredBlitzTiers()` — the one place the Expert gate is applied.
//
// COLOUR COMES FROM `BLITZ_TIER_ACCENT`, not from literals. The old Easy card
// was `border-emerald-400/50` + `from-emerald-600 to-green-700`; the tier's
// actual accent is `var(--u37-green)`. Same family, but only one of them changes
// when the palette does, and the profile's ChallengeBattleCard had already moved
// onto the tokens — so this closes the last surface where the two disagreed.

/**
 * @param {object} props
 * @param {string} props.mode the blitz tier ('easy' | 'challenge' | 'expert')
 * @param {(mode: string) => void} props.onSelect called with the chosen tier
 */
export default function BattleModeCard({ mode, onSelect }) {
  const { dice, diceBlurb } = blitzTierPresentation(mode);
  const accent = BLITZ_TIER_ACCENT(mode);

  return (
    <div
      data-testid="battle-mode-card"
      data-mode={mode}
      className="bg-slate-900/60 backdrop-blur rounded-xl p-3 border-2 flex flex-col items-center text-center"
      style={{
        borderColor: `color-mix(in srgb, ${accent} 50%, transparent)`,
        boxShadow: `0 0 12px color-mix(in srgb, ${accent} 30%, transparent)`,
      }}
    >
      <div className="flex justify-center gap-1 mb-1.5">
        {dice.map((d, i) => <MiniDice key={i} value={d.value} color={d.color} />)}
      </div>
      <h3 className="text-sm font-black leading-tight mb-0.5" style={{ color: accent }}>
        {blitzBattleCardTitle(mode)}
      </h3>
      {/* No length here: since 1.0.285 the battle length is chosen in the NEXT
          step (3/5/7/10 min), so a fixed "10 min" was simply wrong (Bryce,
          1.0.287). The card describes the DICE; the picker owns the clock. */}
      <p className="text-[10px] mb-2.5 leading-snug" style={{ color: `color-mix(in srgb, ${accent} 55%, white)` }}>
        {diceBlurb}
      </p>
      <Button
        onClick={() => onSelect(mode)}
        className="w-full min-h-[44px] touch-manipulation font-bold text-[11px] whitespace-nowrap px-1 border-2 mt-auto"
        style={{
          background: `color-mix(in srgb, ${accent} 22%, transparent)`,
          borderColor: accent,
          color: accent,
        }}
      >
        <Users className="w-3.5 h-3.5 mr-1 flex-shrink-0" />
        Battle
      </Button>
    </div>
  );
}
