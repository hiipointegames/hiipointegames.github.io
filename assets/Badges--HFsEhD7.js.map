import React from 'react';

import BadgeCard from './BadgeCard';
import { isBadgeEarned } from './badgeShowcaseModel';

// BadgeGrid — one section of the showcase (Lane F, §9.2).
//
// A heading, a counter, and the cards. Entries arrive ALREADY ordered, so this
// component does no sorting: arrangement is the model's job, painting is this
// one's.
//
// ONE KIND OF SECTION since 2026-09-04. Every section is a category holding
// both halves of its catalog — earned badges first, then the ones still to get —
// and the counter reads "3/5", which is how the heading itself reports progress.
//
// The separate flat LOCKED grid this used to special-case is gone. It collapsed
// every unearned badge in a mode into one unlabelled wall, which on the live
// screen meant four of five tabs rendered a single heading — `Locked` — over 3
// to 13 cards. See the note above `SHOWCASE_SECTIONS` in badgeShowcaseModel.js.
//
// Renders nothing at all for an empty section, which is what keeps a mode tab
// from showing hollow headings for categories it has no badges in.

/**
 * @param {Object} props
 * @param {string} [props.title]
 * @param {string} [props.sectionId]
 * @param {import('./badgeShowcaseModel').BadgeEntry[]} [props.entries]
 * @param {(badge: import('@/game-mechanics/badgeRegistry').Badge) => void} [props.onSelect]
 * @param {string} [props.className]
 */
export default function BadgeGrid({ title, sectionId, entries = [], onSelect, className = '' }) {
  if (entries.length === 0) return null;

  const earnedCount = entries.filter((e) => isBadgeEarned(e.state)).length;

  return (
    <section
      data-testid="badge-grid"
      data-section={sectionId}
      className={`mb-6 ${className}`}
    >
      {title && (
        <div className="flex items-baseline justify-between gap-3 mb-2 px-0.5">
          <h3
            data-testid="badge-grid-title"
            className="text-[11px] font-black uppercase tracking-[0.2em]"
            style={{ color: 'var(--u37-mode-accent)' }}
          >
            {title}
          </h3>
          <span data-testid="badge-grid-count" className="text-[10px] font-bold" style={{ color: 'var(--u37-muted)' }}>
            {`${earnedCount}/${entries.length}`}
          </span>
        </div>
      )}

      <div className="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
        {entries.map(({ badge, state }) => (
          <BadgeCard
            key={badge.id}
            badge={badge}
            state={state ?? undefined}
            onSelect={onSelect}
          />
        ))}
      </div>
    </section>
  );
}
