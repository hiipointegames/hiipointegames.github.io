import React, { useEffect, useState } from 'react';
import { useSearchParams } from 'react-router-dom';

import { apiClient } from '@/transport';
import { getCraftBadgeState, getBlitzBadgeState, getExistingBadgeState } from '@/stats-aggregation';
import BadgeShowcase from '@/components/stats/BadgeShowcase';
import { buildBadgeStateIndex } from '@/components/stats/badgeShowcaseModel';
import { parseBadgesTarget } from '@/components/stats/badgeDeepLink';
import ProfileBackButton from './ProfileBackButton';
import { reportedFallback } from '@/observability';

// Badges — the route that hosts the L2 full badge showcase (Lane F, §9.2).
//
// This page is the ONLY place in the lane that touches the data layer: it
// resolves WHICH player is being viewed, fetches their derived badge state from
// Lanes B (craft) and D (Blitz), merges the two into one lookup keyed by
// registry badge id, and hands it to the presentational <BadgeShowcase />.
//
// CROSS-PLAYER. `?id=<playerId>` renders another player's badges, exactly like
// `Statistics?id=` does — the same convention, so a "View all badges" link can
// forward the id it already has. Without `?id=` it renders the signed-in user's.
// `?name=` is an optional display-name hint from the linking page (both
// Statistics and OtherProfile already hold the username), used only for the
// header; the badge data never depends on it.
//
// DEEP LINK (2026-10-18). `?mode=<tab>&badge=<id>[,<id>…]` opens that tab and
// scrolls to / glows those badges — how a "See it in Badges" pop-up tap lands
// on the exact badge just won. Written and read only by badgeDeepLink.js.
//
// A failed load degrades to an EMPTY state index rather than an error screen:
// every registry badge still renders, just unearned. A player seeing their
// catalog with nothing lit is a far better failure than a blank page.

export default function Badges() {
  const [searchParams] = useSearchParams();
  const idParam = searchParams.get('id');
  const nameParam = searchParams.get('name');
  // Read once: the showcase takes its starting tab on mount, like ?card= on Stats.
  const [target] = useState(() => parseBadgesTarget(searchParams));

  const [badgeState, setBadgeState] = useState(/** @type {Record<string, any>} */({}));
  const [isOwnStats, setIsOwnStats] = useState(!idParam);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;

    const load = async () => {
      setLoading(true);
      try {
        const currentUser = await apiClient.auth.me().catch(reportedFallback('badges.me'));
        const targetUserId = idParam || currentUser?.id;
        if (!cancelled) setIsOwnStats(!idParam || targetUserId === currentUser?.id);

        if (!targetUserId) {
          if (!cancelled) setBadgeState({});
          return;
        }

        // Three awaits, all player-parameterized. `gameStats: undefined` lets
        // Lane D fetch the blob itself — this page holds no stats of its own to
        // pass through (Statistics/OtherProfile do, and should pass theirs).
        const [craft, blitz, existing] = await Promise.all([
          getCraftBadgeState(targetUserId).catch(reportedFallback('badges.badges.craft')),
          getBlitzBadgeState(targetUserId).catch(reportedFallback('badges.badges.blitz')),
          getExistingBadgeState(targetUserId).catch(reportedFallback('badges.badges.existing')),
        ]);
        if (!cancelled) setBadgeState(buildBadgeStateIndex(craft, blitz, existing));
      } finally {
        if (!cancelled) setLoading(false);
      }
    };

    load();
    return () => { cancelled = true; };
  }, [idParam]);

  return (
    <div className="app-page-shell relative">
      <div className="app-page-scroll pt-[60px] scroll-edge-fade-bottom">
        <div className="max-w-2xl mx-auto px-3 sm:px-4 pb-12">
          <div className="mb-3">
            <ProfileBackButton />
          </div>

          <BadgeShowcase
            badgeState={badgeState}
            isOwnStats={isOwnStats}
            playerName={nameParam ?? undefined}
            initialModeId={target.modeId ?? undefined}
            highlightBadgeIds={target.badgeIds}
            loading={loading}
          />
        </div>
      </div>
    </div>
  );
}
