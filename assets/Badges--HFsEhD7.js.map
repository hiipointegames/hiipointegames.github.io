import React from 'react';

import BadgeCard from './BadgeCard';
import { isBadgeEarned } from './badgeShowcaseModel';

// DailyFeatsHero — the ✦ DAILY FEATS ✦ marquee that leads the Daily tab
// (Lane F, §9.2).
//
// The redesign's central prestige claim: a craft feat earned on the DAILY is the
// real trophy, and its Challenge twin is practice. That has to be visible before
// a player reads a single word, so the ten marquee Daily craft feats lead the tab
// in their own framed section rather than sitting in the plain "Craft" section
// below it.
//
// ROUND 2 — THE GOLD IS GONE (David, 2026-08-01). This section used to be framed,
// titled and counted in gold, in five hard-coded places, back when gold marked
// "the Daily half of a twin". Two things killed that: the twins are separated by
// TAB now, so gold was not carrying information; and `--u37-gold` is byte-for-byte
// `--u37-tier-6`, the top RARITY stop, so a gold section frame was quietly
// claiming the same colour that means "mythic" on every badge inside it.
//
// It is now framed in the DAILY MODE ACCENT, read from `--u37-mode-accent` — the
// slot the showcase root sets for the active tab. So the marquee agrees with the
// tab it leads instead of fighting it, and the section is still unmistakably
// framed. PRESTIGE IS NOW CARRIED BY POSITION AND FRAME, NOT BY HUE.
//
// Presentational only. Entries arrive already paired with state and already
// ordered earned-first.

/**
 * @param {Object} props
 * @param {import('./badgeShowcaseModel').BadgeEntry[]} [props.entries]
 * @param {(badge: import('@/game-mechanics/badgeRegistry').Badge) => void} [props.onSelect]
 * @param {string} [props.className]
 */
export default function DailyFeatsHero({ entries = [], onSelect, className = '' }) {
  if (entries.length === 0) return null;

  const earnedCount = entries.filter((e) => isBadgeEarned(e.state)).length;

  return (
    <section
      data-testid="daily-feats-hero"
      className={`rounded-3xl border-2 p-3 pt-4 mb-6 ${className}`}
      style={{
        background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-mode-accent) 10%, #05030f) 0%, var(--u37-bg) 70%)',
        borderColor: 'color-mix(in srgb, var(--u37-mode-accent) 45%, transparent)',
        boxShadow: '0 0 40px -18px var(--u37-mode-accent), inset 0 1px 3px rgba(255,255,255,0.06)',
      }}
    >
      <h2
        data-testid="daily-feats-title"
        className="text-center text-sm font-black uppercase tracking-[0.28em] mb-0.5"
        style={{
          background: 'linear-gradient(90deg, color-mix(in srgb, var(--u37-mode-accent) 55%, #05030f) 0%, var(--u37-mode-accent) 50%, color-mix(in srgb, var(--u37-mode-accent) 55%, #05030f) 100%)',
          WebkitBackgroundClip: 'text',
          backgroundClip: 'text',
          color: 'transparent',
        }}
      >
        ✦ Daily Feats ✦
      </h2>
      <p className="text-center text-[10px] font-semibold mb-3" style={{ color: 'var(--u37-muted)' }}>
        Earned on the Daily Challenge —{' '}
        <span data-testid="daily-feats-count" style={{ color: 'var(--u37-mode-accent)' }}>
          {earnedCount}/{entries.length}
        </span>{' '}
        collected
      </p>

      <div className="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
        {entries.map(({ badge, state }) => (
          <BadgeCard
            key={badge.id}
            badge={badge}
            state={state ?? undefined}
            onSelect={onSelect}
          />
        ))}
      </div>
    </section>
  );
}
