import React from 'react';

import { SHOWCASE_MODES } from './badgeShowcaseModel';

// BadgeFilterChips — the showcase's PRIMARY division (Lane F, §9.2).
//
// Mode first, category second: a player thinks "what can I earn on the Daily?",
// not "show me every streak badge". The chips scroll horizontally so the row
// never wraps into a second line on a phone.
//
// Each chip paints in its mode's accent via the `[data-mode]` tokens
// (Daily=cyan · Challenge=cyan · Easy=green · Solo Blitz=blue ·
// Blitz Battle=magenta), so the active tab colours the whole screen beneath it.
//
// The row WRAPS rather than scrolling horizontally: a scroll container would
// need a `::-webkit-scrollbar` rule (not expressible inline, and this lane adds
// no global CSS), and a visible scrollbar under the chips reads as a bug.
//
// A11y: a real tablist — `role="tab"` + `aria-selected`, so the tab state is
// announced rather than inferred from colour alone.

/**
 * @param {Object} props
 * @param {string} props.value Active mode id.
 * @param {(modeId: string) => void} [props.onChange]
 * @param {Record<string, {earned:number, total:number}>} [props.counts] Per-mode earned/total.
 * @param {typeof SHOWCASE_MODES} [props.modes]
 * @param {string} [props.className]
 */
export default function BadgeFilterChips({ value, onChange, counts = {}, modes = SHOWCASE_MODES, className = '' }) {
  return (
    <div
      role="tablist"
      aria-label="Badge modes"
      data-testid="badge-filter-chips"
      className={`flex flex-wrap gap-2 ${className}`}
    >
      {modes.map((mode) => {
        const active = mode.id === value;
        const tally = counts[mode.id];
        return (
          <button
            key={mode.id}
            type="button"
            role="tab"
            aria-selected={active}
            data-testid="badge-filter-chip"
            data-mode-id={mode.id}
            data-mode={mode.theme}
            onClick={() => onChange?.(mode.id)}
            className="shrink-0 px-3 py-1.5 rounded-full border-2 text-[11px] font-black uppercase tracking-wider transition-transform active:scale-[0.96] whitespace-nowrap"
            style={active
              ? {
                  background: 'var(--u37-mode-grad)',
                  borderColor: 'color-mix(in srgb, var(--u37-mode-accent) 70%, transparent)',
                  color: 'var(--u37-text)',
                  boxShadow: '0 0 20px -8px var(--u37-mode-accent)',
                }
              : {
                  background: 'var(--u37-surface)',
                  borderColor: 'var(--u37-hair)',
                  color: 'var(--u37-muted)',
                }}
          >
            {mode.label}
            {tally && (
              <span data-testid="badge-filter-chip-count" className="ml-1.5 font-bold opacity-80">
                {tally.earned}/{tally.total}
              </span>
            )}
          </button>
        );
      })}
    </div>
  );
}
