import React, { useEffect, useMemo, useRef, useState } from 'react';

import { BADGES } from '@/game-mechanics';
import { useSector73Enabled, sector73BadgeCatalog } from '@/sector73';
import { scrollIntoOwnContainer, flashRing } from '@/shell';
import BadgeDetailModal from './BadgeDetailModal';
import BadgeFilterChips from './BadgeFilterChips';
import BadgeGrid from './BadgeGrid';
import DailyFeatsHero from './DailyFeatsHero';
import PodiumMedalPanel from './PodiumMedalPanel';
import {
  dailyModeFor,
  SHOWCASE_MODES,
  DEFAULT_SHOWCASE_MODE_ID,
  BADGE_SYSTEM_LAUNCH_DATE,
  showcaseMode,
  showcaseModeAccent,
  sectionsForMode,
  dailyFeatEntries,
  podiumSectionEntries,
  modeBadgeCounts,
  isBadgeEarned,
} from './badgeShowcaseModel';

// BadgeShowcase — L2 of the badge drill-down: the FULL screen (Lane F, §9.2).
//
// L1 is the stats-page teaser, L2 is this, L3 is the detail modal (Lane E).
// Tapping any card here opens L3 with the full tier carousel.
//
// STRUCTURE. Primary division is by MODE (the chips). Inside a mode the two
// halves are shaped differently on purpose: what you've EARNED stays grouped by
// category (Craft · Streaks & Records · Speed · Milestones · Arena), and
// everything still LOCKED collapses into one flat "Locked" grid at the bottom —
// no category sub-headers on badges you've never seen. Every locked card carries
// a progress rail, so that grid reads as a list of goals rather than a wall of
// blanks. The Daily tab leads with the ✦ DAILY FEATS ✦ hero.
//
// TWO DAILY SECTIONS ARE DRAWN BY THIS FILE'S CHILDREN, NOT BY `sectionsForMode`:
// the hero (the ten marquee craft feats) and — since Round 2 § D5 — the Podium
// BLOCK, which merges the medal tallies and the podium badges that used to be
// two separate treatments two sections apart. Both are skipped out of `sections`
// BY BADGE ID, so nothing renders twice and nothing falls out of the tab.
//
// COLOUR. The whole subtree repaints in the active mode's BADGE accent (Daily
// gold · Challenge cyan · Easy teal · both Blitz surfaces blue · Firsts
// magenta). That deliberately differs from what `[data-mode]` alone would give
// it — the GAME screens paint Daily cyan and Easy green, and green is also
// `--u37-tier-1`, the lowest rarity stop, so on a wall of badges the two
// palettes collide. Two mechanisms carry it, on purpose:
//   · `--u37-mode-accent` inline, so this subtree's own children (the section
//     headings) take the accent straight from the model.
//   · `data-badge-theme` + `data-mode-id`, which tokens.css keys the badge
//     palette off. The filter chips re-declare `[data-mode]` on THEMSELVES,
//     which overrides anything inherited — so the chip row can only be repainted
//     from a stylesheet rule, not from this element's style.
// `data-mode` stays for anything keying off the game theme name.
//
// IT RENDERS; IT DOES NOT DERIVE. Badge definitions come from the registry
// (Lane C) and earned-state from `badgeState`, a lookup keyed by REGISTRY BADGE
// ID that the caller builds with `buildBadgeStateIndex(craft, blitz)` from
// Lanes B/D. Every registry badge renders — a badge with NO state entry renders
// unearned — so a detector landing later lights up its card with zero change
// here.
//
// CROSS-PLAYER BY CONSTRUCTION. The same component renders another player's
// badges (`Statistics?id=…` / the OtherProfile card): it takes `isOwnStats` and
// `playerName` as props and NEVER reads the signed-in user. Own-only
// affordances (the "keep going" nudge) are suppressed on someone else's page —
// their earned set is theirs to show, not a to-do list for the viewer.

/**
 * @param {Object} props
 * @param {import('@/game-mechanics/badgeRegistry').Badge[]} [props.badges] Registry catalog; defaults to the whole thing.
 * @param {Record<string, import('./badgeVisuals').BadgeState>} [props.badgeState] Merged Lane B/D state, keyed by badge id.
 * @param {boolean} [props.isOwnStats] False when viewing another player.
 * @param {string} [props.playerName] The viewed player's name (other-player header copy).
 * @param {string} [props.launchDate] ISO badge-system launch date; drives the retroactive ribbon.
 * @param {string} [props.initialModeId]
 * @param {string[]} [props.highlightBadgeIds] Deep-link targets (`/Badges?badge=`): scrolled to and glowed once loaded.
 * @param {boolean} [props.loading]
 * @param {string} [props.className]
 */
/** @type {string[]} */
const NO_HIGHLIGHTS = [];

export default function BadgeShowcase({
  badges: catalog = BADGES,
  badgeState = {},
  isOwnStats = true,
  playerName,
  launchDate = BADGE_SYSTEM_LAUNCH_DATE,
  initialModeId = DEFAULT_SHOWCASE_MODE_ID,
  highlightBadgeIds = NO_HIGHLIGHTS,
  loading = false,
  className = '',
}) {
  // Sector 73's badges (Looking Glass) exist only while Sector 73 is switched on: off, they are
  // not in the grid, the counts or the "x of N" total — the showcase is the 37 one.
  const s73On = useSector73Enabled();
  const badges = useMemo(() => sector73BadgeCatalog(catalog, s73On), [catalog, s73On]);
  const [modeId, setModeId] = useState(
    () => (showcaseMode(initialModeId) ? initialModeId : DEFAULT_SHOWCASE_MODE_ID),
  );
  const [selected, setSelected] = useState(/** @type {import('@/game-mechanics/badgeRegistry').Badge | null} */(null));

  // DEEP-LINK ARRIVAL (2026-10-18). A "See it in Badges" tap lands here with
  // the badge ids it just announced. Once the cards exist, scroll the first into
  // view — inside the page's OWN scroller, never #root (the iOS top-inset
  // regression; see @/shell scrollIntoOwnContainer) — and glow every target.
  // Once per arrival: switching tabs afterwards must not re-scroll the player.
  const rootRef = useRef(/** @type {HTMLDivElement | null} */(null));
  const highlighted = useRef(false);
  const highlightKey = highlightBadgeIds.join(',');
  useEffect(() => {
    if (loading || highlighted.current || !highlightKey || !rootRef.current) return;
    const root = rootRef.current;
    const cards = highlightKey.split(',')
      .map((id) => root.querySelector(`[data-testid="badge-card"][data-badge-id="${id}"]`))
      .filter(/** @returns {el is HTMLElement} */ (el) => el instanceof HTMLElement);
    if (cards.length === 0) return;
    highlighted.current = true;
    scrollIntoOwnContainer(cards[0]);
    for (const card of cards) {
      card.setAttribute('data-highlighted', 'true');
      flashRing(card, { duration: 1000, pulses: 2 });
    }
  }, [loading, highlightKey, modeId]);

  const mode = showcaseMode(modeId) ?? SHOWCASE_MODES[0];
  // ALL THREE Dailies lead with their craft feats and their podium block since
  // the five-section split — the hero is not a property of Challenge's Daily,
  // it is what a Daily section looks like. `dailyModeFor` returns null for
  // Practice and the Colosseum, which have rows instead.
  const dailyMode = dailyModeFor(mode.id);
  const isDaily = Boolean(dailyMode);
  const modeAccent = showcaseModeAccent(mode.id);

  const counts = useMemo(
    () => Object.fromEntries(SHOWCASE_MODES.map((m) => [m.id, modeBadgeCounts(badges, m.id, badgeState)])),
    [badges, badgeState],
  );

  const heroEntries = useMemo(
    () => (isDaily ? dailyFeatEntries(badges, badgeState, dailyMode) : []),
    [isDaily, dailyMode, badges, badgeState],
  );
  // Round 2 § D5: the podium badges are drawn by the Podium BLOCK, not by a
  // section of their own — see PodiumMedalPanel. Empty on every other tab,
  // because `competition` is Daily-only since § D4.
  const podiumEntries = useMemo(
    () => (isDaily ? podiumSectionEntries(badges, mode.id, badgeState) : []),
    [isDaily, badges, mode.id, badgeState],
  );

  // Two callers draw their own cards on the Daily tab, so exactly THOSE ids are
  // skipped below — otherwise each would render twice. Ids, not categories:
  // skipping the whole Craft category (what this did before Round 2 § D4) would
  // blank the Daily's Craft SECTION, and skipping the `podium` SECTION would
  // drop unearned podium badges out of the flat Locked grid as well.
  const sections = useMemo(
    () => sectionsForMode(badges, mode.id, badgeState, {
      skipBadgeIds: [...heroEntries, ...podiumEntries].map((e) => e.badge.id),
    }),
    [badges, mode.id, badgeState, heroEntries, podiumEntries],
  );

  const totalEarned = badges.filter((b) => isBadgeEarned(badgeState[b.id])).length;
  const title = isOwnStats ? 'Your Badges' : `${playerName || 'Player'}'s Badges`;

  // React's CSSProperties type rejects raw CSS custom properties, so type the
  // root style as `any` — same pattern as RocketLaunchScreen's --rk-* accents.
  /** @type {any} */
  const rootStyle = { '--u37-mode-accent': modeAccent };

  return (
    <div
      ref={rootRef}
      data-testid="badge-showcase"
      data-badge-theme=""
      data-mode={mode.theme}
      data-mode-id={mode.id}
      data-mode-accent={modeAccent}
      className={className}
      style={rootStyle}
    >
      <header className="mb-3">
        <h1 data-testid="badge-showcase-title" className="text-2xl font-black tracking-wide" style={{ color: 'var(--u37-text)' }}>
          {title}
        </h1>
        <p data-testid="badge-showcase-total" className="text-xs font-semibold" style={{ color: 'var(--u37-muted)' }}>
          {totalEarned} of {badges.length} earned
        </p>
      </header>

      <BadgeFilterChips value={mode.id} onChange={setModeId} counts={counts} className="mb-4" />

      {loading ? (
        <p data-testid="badge-showcase-loading" className="text-center text-sm py-10" style={{ color: 'var(--u37-muted)' }}>
          Loading badges…
        </p>
      ) : (
        <>
          {isDaily && <DailyFeatsHero entries={heroEntries} onSelect={setSelected} />}

          {/* Round 2 § D5 — ONE Podium block. It used to be two: this panel
              (medal tallies, in the deleted Achievements slide's gold/silver/
              bronze language) plus a separate `PODIUM` badge section two
              sections further down. Same concept, two treatments, not even
              adjacent. The panel now holds BOTH registers — tallies, hairline,
              podium badge cards — and `podiumEntries` is skipped out of
              `sections` so nothing renders twice. It keeps the tallies' old
              position directly under the hero: of the two, that is the more
              prominent slot, and podium standing is the Daily's headline. */}
          {isDaily && (
            <PodiumMedalPanel
              badgeState={badgeState}
              entries={podiumEntries}
              dailyMode={dailyMode}
              onSelect={setSelected}
              isOwnStats={isOwnStats}
              playerName={playerName}
            />
          )}

          {sections.map((section) => (
            <BadgeGrid
              key={section.id}
              sectionId={section.id}
              title={section.title}
              entries={section.entries}
              onSelect={setSelected}
            />
          ))}

          {/* A mode with nothing in it at all (only reachable with a filtered
              catalog) still needs to say something rather than render blank. */}
          {sections.length === 0 && heroEntries.length === 0 && podiumEntries.length === 0 && (
            <p data-testid="badge-showcase-empty" className="text-center text-sm py-10" style={{ color: 'var(--u37-muted)' }}>
              No badges in this mode yet.
            </p>
          )}

          {/* Own-only affordance: chasing the next badge is a nudge to the player
              themselves, not something to show a viewer about someone else. */}
          {isOwnStats && sections.length > 0 && (
            <p data-testid="badge-showcase-nudge" className="text-center text-[11px] pb-4" style={{ color: 'var(--u37-muted)' }}>
              Every badge shows where you are on it — tap one to see exactly what the next rung needs.
            </p>
          )}
        </>
      )}

      <BadgeDetailModal
        isOpen={Boolean(selected)}
        onClose={() => setSelected(null)}
        badge={selected ?? undefined}
        state={selected ? badgeState[selected.id] : undefined}
        launchDate={launchDate}
        isOwnStats={isOwnStats}
        playerName={playerName}
      />
    </div>
  );
}
