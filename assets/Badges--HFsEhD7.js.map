import React from 'react';

import BadgeCard from './BadgeCard';
import { modeAccentVar } from './badgeVisuals';

// PodiumMedalPanel — the Daily tab's Podium block.
//
// ONE BLOCK, ONE REGISTER (R2-H, David, 2026-08-05, from device review).
//
// This block used to hold two registers: a row of struck gold/silver/bronze
// medal discs answering "how many?", then a hairline, then the podium badge
// cards answering "how far up the ladder?". The argument for keeping both was
// that they say different things.
//
// On a real phone they did not. Both rows carried the SAME number — "1ST PLACE
// 5" directly above "1st Place Finishes ×5" — one row apart, in one block. The
// distinction was real in the model and invisible on the screen, which is the
// only place it had to hold. David's verdict on seeing it: "the podium is still
// duplicated." So the tally row is gone and the cards are the whole block.
//
// THE CARDS NOW CARRY THE METAL. Removing the tally row took the gold/silver/
// bronze with it, and all three ladders render at the same tier colour — so
// first, second and third became indistinguishable at a glance. Podium metal is
// not decoration; it IS the meaning. `badgeVisuals.badgeMedalColor` therefore
// paints these three ids in their place metal instead of their rung colour (see
// PODIUM_PLACE_METAL there), and `badgeMedalAxis` reports 'medal' so the axis
// never claims 'tier' while metal is on the glass.
//
// That is safe from R2-C's "gold quietly claims mythic rarity" problem for the
// same reason the struck discs were: each of these carries a 1/2/3 numeral, so
// the metal reads as podium place. The rung is still shown — as the tier caption
// and the ×N pill — it just no longer owns the fill.
//
// FIRST PODIUM LIVES HERE. It is a one-time shield, not a place, so it keeps its
// identity colour (PODIUM_PLACE_METAL is keyed by id, not by category, precisely
// so it is not swept up). It belongs in this block because it is the entry
// ticket to the story — a Podium block claiming to be the whole podium story
// while one podium badge sits elsewhere is the incoherence this block exists to
// remove. It arrives in `entries`, so nothing here hard-codes it.
//
// THE HEADLINE COUNT SURVIVED THE TALLY ROW. `podiumCountsFromBadgeState` still
// feeds the "N medals" figure in the heading — that was the one thing the tally
// row said that the cards do not, and it costs one line instead of a row.
//
// IT RENDERS; IT DOES NOT DERIVE. Counts come from the SAME `badgeState` index
// the cards render against, so the heading and the cards cannot disagree. Entry
// ARRANGEMENT is the model's job (`podiumSectionEntries`), so this stays a leaf.
//
// CROSS-PLAYER BY CONSTRUCTION. Never reads the signed-in user — `badgeState` is
// already whosever page this is; `isOwnStats` / `playerName` only choose the
// caption's wording.

/**
 * Pull the three medal tallies out of a badge-state index.
 *
 * Tolerant on purpose: a missing entry, a missing count, or junk in the count
 * all read as 0 rather than throwing — one malformed state must not blank the
 * panel. `progressValue` is accepted as a fallback because the derivation ships
 * it alongside `count` for ladder badges, and an older/partial state may carry
 * only one of the two.
 *
 * PER DAILY (2026-10-18 fix). The block renders on all three Daily tabs, and
 * each Daily has its own three ladders (`podiumFirst`, `podiumFirstEasy`,
 * `podiumFirstExpert`, …). This used to read the Challenge ids on every tab, so
 * the Easy and Expert tabs headlined the Challenge medal count. `dailyMode` is
 * the tab's registry mode (`dailyModeFor`); an unknown mode reads Challenge,
 * which is what every caller got before.
 *
 * @param {Record<string, import('./badgeShowcaseModel').BadgeState>} [badgeState]
 * @param {string} [dailyMode] Registry mode: 'daily' | 'dailyEasy' | 'dailyExpert'.
 * @returns {{ first: number, second: number, third: number }}
 */
export function podiumCountsFromBadgeState(badgeState, dailyMode = 'daily') {
  const suffix = PODIUM_ID_SUFFIX[dailyMode] ?? '';
  const read = (/** @type {string} */ badgeId) => {
    const state = badgeState?.[`${badgeId}${suffix}`];
    const raw = Number(state?.count ?? state?.progressValue ?? 0);
    return Number.isFinite(raw) && raw > 0 ? Math.floor(raw) : 0;
  };
  return {
    first: read('podiumFirst'),
    second: read('podiumSecond'),
    third: read('podiumThird'),
  };
}

/** Registry-id suffix of each Daily's podium ladders (badgeRegistry.js). */
const PODIUM_ID_SUFFIX = { daily: '', dailyEasy: 'Easy', dailyExpert: 'Expert' };

/** The leaderboard each Daily's caption names. */
const PODIUM_BOARD_NAME = {
  daily: 'Daily Challenge',
  dailyEasy: 'Easy Daily',
  dailyExpert: 'Expert Daily',
};


/**
 * @param {Object} props
 * @param {Record<string, import('./badgeShowcaseModel').BadgeState>} [props.badgeState] Registry-keyed state index.
 * @param {import('./badgeShowcaseModel').BadgeEntry[]} [props.entries] The podium badges, already ordered (`podiumSectionEntries`).
 * @param {(badge: import('@/game-mechanics/badgeRegistry').Badge) => void} [props.onSelect]
 * @param {boolean} [props.isOwnStats] False when viewing another player.
 * @param {string} [props.playerName] The viewed player's name (other-player caption).
 * @param {string} [props.dailyMode] The tab's registry mode ('daily' | 'dailyEasy' | 'dailyExpert').
 * @param {string} [props.className]
 */
export default function PodiumMedalPanel({
  badgeState = {},
  entries = [],
  onSelect,
  isOwnStats = true,
  playerName,
  dailyMode = 'daily',
  className = '',
}) {
  const counts = podiumCountsFromBadgeState(badgeState, dailyMode);
  const boardName = PODIUM_BOARD_NAME[dailyMode] ?? PODIUM_BOARD_NAME.daily;
  const total = counts.first + counts.second + counts.third;
  // Possessive rather than a verb phrase so the line reads the same at 0 medals
  // as at 45 — "You have finished in the top three" is false for a player with
  // none, and this panel deliberately still renders for them.
  const whose = isOwnStats ? 'Your' : `${playerName || 'This player'}'s`;

  // Read the outline colour from the badges the block actually holds, so it can
  // never disagree with the cards inside it. Falls back to the inherited slot
  // (the active tab's accent) when the block renders with no entries at all.
  const accent = entries[0]?.badge?.mode ? modeAccentVar(entries[0].badge.mode) : 'var(--u37-mode-accent)';

  return (
    <section
      data-testid="podium-medal-panel"
      data-podium-total={total}
      data-podium-badges={entries.length}
      data-accent={accent}
      className={`rounded-3xl border p-3 pt-4 mb-6 ${className}`}
      style={{
        borderColor: `color-mix(in srgb, ${accent} 32%, transparent)`,
        background: `color-mix(in srgb, ${accent} 6%, var(--u37-bg))`,
      }}
    >
      {/* ONE heading for the whole block. The old panel and the old badge
          section each had their own — that duplication was half the defect. */}
      <div className="flex items-baseline justify-between gap-3 mb-2 px-0.5">
        <h3
          data-testid="podium-medal-panel-title"
          className="text-[11px] font-black uppercase tracking-[0.2em]"
          style={{ color: accent }}
        >
          Podium
        </h3>
        {/* The block's headline number is MEDALS, not an earned/total badge
            ratio: "9 medals" and "4/4" side by side reads as "9 of what?". The
            ladder progress a ratio would have carried is already on every card
            below, as its tier caption. */}
        <span
          data-testid="podium-medal-panel-total"
          className="text-[10px] font-bold"
          style={{ color: 'var(--u37-muted)' }}
        >
          {total} {total === 1 ? 'medal' : 'medals'}
        </span>
      </div>

      <p className="text-[10px] font-semibold mb-3 px-0.5" style={{ color: 'var(--u37-muted)' }}>
        {whose} top-three finishes on the {boardName} leaderboard.
      </p>

      {/* ONE register. R2-H (David, 2026-08-05) — see the header note: the
          struck-medal tally row that used to sit above these cards said the
          same numbers they do, one row apart, so the block still read as
          duplicated on a real device. The cards carry the metal now. */}
      {entries.length > 0 && (
        <div className="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
          {entries.map(({ badge, state }) => (
            <BadgeCard key={badge.id} badge={badge} state={state ?? undefined} onSelect={onSelect} />
          ))}
        </div>
      )}
    </section>
  );
}
