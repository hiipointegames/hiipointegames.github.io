import React from 'react';
import { MiniDice } from '@/puzzle-input';

import { BLITZ_TIER_ACCENT, BLITZ_TIER_LABEL, normalizeBlitzMode } from './blitzMode';
import { blitzTierPresentation } from './blitzTierPresentation';

// "Which battle is this?" — the tier's dice and its name, in its own colour.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS IS A COMPONENT AND NOT THREE MORE TERNARIES
// ─────────────────────────────────────────────────────────────────────────────
// Reported by David on the S21, 2026-09-11, with a screenshot: an EXPERT battle
// he had just played against dragonpancakes was announced in the notifications
// centre as "Easy battle · they solved 3".
//
// The cause was not a notifications bug. It was the same two-branch shape
// repeated across six places:
//
//     blitz_mode === 'challenge' ? 'Challenge' : 'Easy'
//
// That is correct while there are exactly two tiers and silently WRONG the
// moment there is a third: 'expert' is not 'challenge', so it falls to the else
// branch and is announced as Easy, in green, with a white die. Every surface had
// written its own copy, so enabling Expert in 1.0.302 mislabelled it in all of
// them at once:
//
//     NotificationsInbox   the invite subtitle, the your-move row, the
//                          accepted-battle sentence  ← what David saw
//     ChallengeFriend      "Easy Mode Battle" + a white die, in emerald
//     ChallengeResults     an "Easy" pill on the results screen
//     ChallengeList        an "Easy" pill in the battle list
//     HeadToHead           opened the EASY how-to for an Expert battle, which is
//                          a wrong RULEBOOK rather than a wrong label
//
// `blitzMode.js` predicted exactly this: the surface "used to decide mode with
// ~40 inline string comparisons whose `else` branches disagreed about whether an
// unknown value meant Easy or Challenge, so a third value could not be
// introduced safely." The predicates were centralised; these display sites were
// not. This is the display half of that job.
//
// ⚠️ EVERY MODE GOES THROUGH `normalizeBlitzMode`. Rows are read from the
// database, where `blitz_mode` can be null on a legacy battle or a value a newer
// build wrote. Normalising means an unknown tier renders as Easy — the documented
// default — rather than as a blank badge or a crash.

/**
 * @param {object} props
 * @param {string} props.mode a blitz_mode from a battle row (may be null/unknown)
 * @param {'pill'|'inline'} [props.variant] pill = bordered chip; inline = dice + text
 * @param {string} [props.suffix] appended to the label, e.g. ' Mode Battle'
 * @param {string} [props.className] extra classes for the wrapper
 */
export default function BlitzModeBadge({ mode, variant = 'pill', suffix = '', className = '' }) {
  const tier = normalizeBlitzMode(mode);
  const accent = BLITZ_TIER_ACCENT(tier);
  const { dice } = blitzTierPresentation(tier);
  const label = `${BLITZ_TIER_LABEL(tier)}${suffix}`;

  const pill = variant === 'pill';

  return (
    <span
      data-testid="blitz-mode-badge"
      data-mode={tier}
      // The accent, stated as an attribute so it is OBSERVABLE. Every colour on
      // this badge is a `color-mix()`, which happy-dom cannot parse — it drops
      // each property, and with all of them dropped the style ATTRIBUTE itself
      // disappears, so `getAttribute('style')` is null in tests. Verified by
      // probe rather than assumed. Publishing the token keeps "Expert wears
      // gold, not Easy's green" an assertion instead of a hope.
      data-accent={accent}
      className={`${pill
        ? 'text-xs sm:text-sm px-2 sm:px-3 py-0.5 sm:py-1 rounded-full font-bold border'
        : 'text-sm font-semibold'
      } inline-flex items-center gap-1.5 ${className}`}
      style={pill
        ? {
          color: `color-mix(in srgb, ${accent} 25%, white)`,
          background: `color-mix(in srgb, ${accent} 22%, transparent)`,
          borderColor: `color-mix(in srgb, ${accent} 55%, transparent)`,
        }
        : { color: accent }}
    >
      <span className="flex items-center gap-1">
        {dice.map((d, i) => <MiniDice key={i} value={d.value} color={d.color} />)}
      </span>
      {label}
    </span>
  );
}
