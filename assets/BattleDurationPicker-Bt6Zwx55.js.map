// Build the shared `dice_sequence` a battle is played from.
//
// Both players read this one stored array by index, so it is the thing that keeps
// them on the same puzzle. Two tiers build it two different ways:
//
//   Easy / Challenge — rolled here, unvetted. Correct: ANY equation reaching 37
//                      scores, so an arbitrary roll is always playable.
//   Expert           — DRAWN from the vetted pool. Only a perfect solve scores,
//                      and an unvetted roll carries no guarantee that a findable
//                      perfect solve exists. Dealing one would hand both players
//                      a puzzle neither can clear, in a race where the deck does
//                      not advance until someone does. That is a wedge.
//
// ⚠️ THIS FUNCTION FAILS RATHER THAN DEGRADES. If the vetted pool cannot supply a
// full deck, Expert battle creation THROWS. It deliberately does not fall back to
// unvetted rolls and does not quietly deal a shorter deck:
//
//   * falling back to unvetted rolls defeats the entire reason the pool exists;
//   * a short deck reintroduces the exhaustion path, and `battleDice.nextBattleDice`
//     returns null past the deck for Expert precisely so no unvetted roll is ever
//     dealt — so a short deck converts "pool is still filling" into "the battle
//     ends early", which is a worse failure because it happens mid-race rather
//     than at creation.
//
// Failing at creation is visible, attributable, and costs a player nothing but a
// retry. David's R3 ruling is that the deck is NEVER depleted and Expert matches
// the existing 250, so anything less than a full deck is not an Expert battle.

import { supabase } from '@/transport';
import { generateBlitzDice } from '@/dice';

import { BATTLE_DICE_SEQUENCE_LENGTH } from './battleConfig';
import { blitzRequiresPerfectSolve } from './blitzMode';

/** Thrown when the vetted pool cannot supply a full Expert deck. */
export class ExpertDeckUnavailableError extends Error {
  /**
   * @param {number} got how many vetted rolls the pool returned
   * @param {number} need how many a full deck requires
   */
  constructor(got, need) {
    super(
      'Expert battles are not available yet — the vetted puzzle pool is still filling. '
      + 'Please try again later, or start an Easy or Challenge battle.',
    );
    this.name = 'ExpertDeckUnavailableError';
    this.got = got;
    this.need = need;
  }
}

/**
 * Rolls one unvetted sequence. Easy and Challenge only.
 *
 * @param {number} length
 * @returns {number[][]}
 */
function rollUnvettedSequence(length) {
  return Array.from({ length }, () => generateBlitzDice());
}

/**
 * Build the `dice_sequence` for a new battle.
 *
 * @param {object} [opts]
 * @param {string} [opts.mode] the battle's `blitz_mode`
 * @param {number} [opts.length] deck length; defaults to BATTLE_DICE_SEQUENCE_LENGTH
 * @param {typeof supabase} [opts.client] injectable for tests
 * @returns {Promise<number[][]>} the sequence
 * @throws {ExpertDeckUnavailableError} when Expert cannot be dealt a full vetted deck
 */
export async function buildBattleDiceSequence({
  mode,
  length = BATTLE_DICE_SEQUENCE_LENGTH,
  client = supabase,
} = {}) {
  if (!blitzRequiresPerfectSolve(mode)) {
    return rollUnvettedSequence(length);
  }

  // `draw_expert_deck` is a read-only SECURITY DEFINER RPC. The pool table itself
  // is RLS-closed to clients — a player who could enumerate every vetted roll
  // could pre-solve them — so this RPC is the only client path to it.
  const { data, error } = await client.rpc('draw_expert_deck', { p_count: length });
  if (error) throw error;

  const rows = Array.isArray(data) ? data : [];
  // The RPC returns rows of `{ dice }`; tolerate a bare array too so a future
  // return-shape change degrades to the check below rather than to garbage dice.
  const sequence = rows
    .map((row) => (Array.isArray(row) ? row : row?.dice))
    .filter((dice) => Array.isArray(dice) && dice.length === 7);

  if (sequence.length < length) {
    throw new ExpertDeckUnavailableError(sequence.length, length);
  }

  return sequence;
}
