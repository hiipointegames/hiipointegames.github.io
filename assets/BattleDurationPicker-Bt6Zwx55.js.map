import React from 'react';
import { playSound } from '@/ui/feedback';
import { BATTLE_DURATION_OPTIONS } from './battleConfig';
import { BLITZ_TIER_ACCENT, normalizeBlitzMode } from './blitzMode';

// Shared M3 battle-length selector (3/5/7/10 min). Used by BOTH create paths —
// CreateChallenge (OtherProfile "Battle" button) and ChallengeFriend (Blitz
// Colosseum → Battle Friends). Extracted so the picker + the chosen
// time_limit_seconds are surfaced from both, not just one: the Colosseum flow
// previously created challenges directly and silently defaulted to 600s (bug).
//
// Purely the picker UI — the caller owns the selected value and gates rendering
// behind BATTLE_DURATIONS_ENABLED (so it stays invisible on main until the flag
// flips). `battleMode` only themes the accent color (emerald easy / orange
// challenge).
export default function BattleDurationPicker({ value, onChange, battleMode = 'easy' }) {
  const tierAccent = BLITZ_TIER_ACCENT(normalizeBlitzMode(battleMode));
  return (
    <div className="mb-3 sm:mb-4">
      {/* Tier accent, not an easy/not-easy pair that painted Expert orange. */}
      <h3 className="text-xs sm:text-sm font-bold mb-2 sm:mb-3" style={{ color: BLITZ_TIER_ACCENT(normalizeBlitzMode(battleMode)) }}>Battle Length</h3>
      <div className="grid grid-cols-4 gap-2">
        {BATTLE_DURATION_OPTIONS.map((opt) => {
          const selected = value === opt.seconds;
          return (
            <button
              key={opt.seconds}
              type="button"
              onClick={() => {
                playSound('buttonTap');
                onChange(opt.seconds);
              }}
              aria-pressed={selected}
              // Selected chips wear the TIER's accent. Was an easy/not-easy
              // class pair, so an Expert battle's duration picker was orange —
              // which is not Challenge's colour either (that is cyan).
              className={`min-h-[44px] rounded-lg text-xs sm:text-sm font-bold border-2 transition-all touch-manipulation ${selected
                ? 'text-white'
                : 'bg-slate-700/60 border-slate-600/50 text-slate-300 hover:bg-slate-600/60'
                }`}
              style={selected ? {
                background: `color-mix(in srgb, ${tierAccent} 40%, transparent)`,
                borderColor: tierAccent,
              } : undefined}
            >
              {opt.label}
            </button>
          );
        })}
      </div>
    </div>
  );
}
