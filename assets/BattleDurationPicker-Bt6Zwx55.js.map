// What each Blitz tier LOOKS like on a picker card: its sample dice and the one
// line that describes its rule.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS EXISTS
// ─────────────────────────────────────────────────────────────────────────────
// Before this, every surface that offered a tier wrote its own copy of both.
// `ChallengeBattleCard` had a TIERS array; `HeadToHead.jsx` had the same dice
// hand-written twice more (once for the battle cards, once for the solo cards),
// each with its own wording — "White dice" / "Power dice" on one, "Solve as many
// easy puzzles as you can" on the other.
//
// That was survivable while there were two tiers and they never changed. Adding
// Expert (David, 2026-09-11: "this expert battle needs to be in the colosseum,
// on the blitz stats page, and within peoples public profile pages") meant
// writing a third variant into three or four places at once — which is how a
// surface ends up describing Expert as "all three Power Dice must be correct" in
// one place and "Power dice" in another.
//
// So: one list, three consumers. Adding a fourth tier is an entry here.
//
// ⚠️ DICE VALUES ARE ILLUSTRATIVE, NOT DEALT. These are the faces a card shows
// to convey what a tier's dice look like — white for Easy, the three coloured
// Power Dice for Challenge and Expert. Real battle dice come from
// `buildBattleDiceSequence` (unvetted rolls for Easy/Challenge, the vetted pool
// for Expert) and never from here.

import { BLITZ_MODES, BLITZ_TIER_LABEL } from './blitzMode';
import { BATTLE_EXPERT_ENABLED } from './battleConfig';

/**
 * @typedef {{ value: number, color: string }} SampleDie
 * @typedef {{
 *   mode: string, dice: readonly SampleDie[], diceBlurb: string, soloBlurb: string,
 * }} TierPresentation
 */

// The three coloured Power Dice as they are ILLUSTRATED, shared by Challenge and
// Expert so the two can never drift apart.
//
// Ordered green-blue-red so the faces read 3-6-5 left to right (David,
// 2026-09-12). Before this, Challenge showed red5/blue3/green4 and Expert
// red6/blue2/green5 — two arbitrary hands that differed for no reason a player
// could see, which made the two tiers look like they used different dice.
//
// ⚠️ THIS IS NOT THE GAME'S DICE ORDER. `POWER_DICE_COLORS` in @/dice is
// blue-red-green at board positions 4-6 and governs actual play. This array is
// artwork; changing it cannot affect a puzzle.
const POWER_DICE_SAMPLE = Object.freeze([
  { value: 3, color: 'green' },
  { value: 6, color: 'blue' },
  { value: 5, color: 'red' },
]);

/** @type {Record<string, Omit<TierPresentation, 'mode'>>} */
const PRESENTATION = Object.freeze({
  easy: {
    dice: [{ value: 1, color: 'white' }],
    diceBlurb: 'White dice',
    soloBlurb: 'Solve as many easy puzzles as you can',
  },
  challenge: {
    dice: POWER_DICE_SAMPLE,
    diceBlurb: 'Colored Power Dice rules',
    soloBlurb: 'Solve as many challenge puzzles as you can',
  },
  expert: {
    dice: POWER_DICE_SAMPLE,
    // Expert's rule is the whole reason it is a separate tier, so the blurb
    // states it rather than repeating Challenge's "Power dice". A player who
    // reads "Power dice" on both has been told nothing about the difference.
    diceBlurb: 'All three Power Dice must be correct',
    soloBlurb: 'Solve as many perfect puzzles as you can',
  },
});

/**
 * The presentation for one tier.
 *
 * @param {string} mode
 * @returns {TierPresentation}
 */
export function blitzTierPresentation(mode) {
  const p = PRESENTATION[mode] || PRESENTATION.easy;
  return { mode, ...p };
}

/**
 * The tiers a picker should offer right now, in difficulty order.
 *
 * ⚠️ THIS IS THE ONE PLACE THE EXPERT GATE IS APPLIED FOR PICKERS. Every picker
 * calls this rather than filtering `BLITZ_MODES` itself, because the previous
 * arrangement — each surface hardcoding its own two-item list — is exactly why
 * `BATTLE_EXPERT_ENABLED` could be flipped without Expert appearing anywhere.
 * The flag's own comment records that correction: "It used to say 'THE PICKER
 * ONLY'. No picker reads it."
 *
 * @returns {TierPresentation[]}
 */
export function offeredBlitzTiers() {
  return BLITZ_MODES
    .filter((m) => m !== 'expert' || BATTLE_EXPERT_ENABLED)
    .map(blitzTierPresentation);
}

/**
 * "Easy Battle" / "Challenge Battle" / "Expert Battle".
 * @param {string} mode
 * @returns {string}
 */
export const blitzBattleCardTitle = (mode) => `${BLITZ_TIER_LABEL(mode)} Battle`;

/**
 * "Easy Mode Blitz" etc — the solo card's heading.
 * @param {string} mode
 * @returns {string}
 */
export const blitzSoloCardTitle = (mode) => `${BLITZ_TIER_LABEL(mode)} Mode Blitz`;
