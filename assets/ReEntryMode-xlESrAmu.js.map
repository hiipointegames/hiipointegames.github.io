// Re-Entry's power-ups (redesign 2026-10-22, PROPOSAL §3E with David's changes). The cost is always a WAIT on the
// game clock (visible time only) with FIRE locked, so no server change is needed and the board stays fair:
//   ↩ Undo      take back your last burn                 5 s wait (its own button: it pulses when you're stranded)
//   🔍 Scan     light up 7 dice that make this burn       Daily 20 s wait · Practice free; not on burn 3
//   🧭 Autopilot fly this burn for you                     60 s wait · 1 per descent · never the last burn
// Scan and Autopilot only ever pick dice that still land (solver.findBurn, + − ×: a found burn is certain).
import { BURNS } from './logic';

export const SCAN_WAIT_MS = 20_000; // the Daily; practice scans are free
export const AUTOPILOT_WAIT_MS = 60_000;
export const AUTOPILOTS = 1; // per descent

/** What each running wait says on the coach line (≤ 12 words). */
export const waitText = (kind, seconds) => (
  kind === 'scan' ? `🔍 Scanning your dice: ${seconds} s`
    : kind === 'autopilot' ? `🧭 Autopilot flies this burn in ${seconds} s`
      : `↩ Undoing your last burn in ${seconds} s`
);

/** The coach line once a Scan has finished. */
export const scanText = (range) => `🔍 Use the gold dice for ${range.exact ? `exactly ${range.min}` : `${range.min} to ${range.max}`}.`;

/**
 * The tray's power-ups (the shared PowerUpTray's shape) for this moment.
 * @param {{ daily: boolean, index: number, autopilotsUsed: number, waitKind: string | null, found: boolean, flying: boolean }} s
 *   found: a burn that fits and still lands exists from here (else Scan/Autopilot have nothing to show)
 */
export function powerUpList({ daily, index, autopilotsUsed, waitKind, found, flying }) {
  const last = index >= BURNS - 1;
  const busy = waitKind ? 'Wait for the countdown to finish.' : undefined;
  const none = !found ? 'No landing found from here: Undo first.' : undefined;
  return [
    {
      id: 'scan', icon: '🔍', name: 'Scan', what: 'Light up 7 dice that make this burn.',
      cost: daily ? '20 s wait' : 'free in practice', badge: daily ? '20s' : 'free',
      active: waitKind === 'scan',
      disabledReason: !flying ? 'Start the descent first.' : last ? 'Burn 3 uses all your dice.' : waitKind === 'scan' ? undefined : busy ?? none,
    },
    {
      id: 'autopilot', icon: '🧭', name: 'Autopilot', what: 'Fly this burn for you.',
      cost: '60 s wait', badge: AUTOPILOTS - autopilotsUsed, left: AUTOPILOTS - autopilotsUsed,
      active: waitKind === 'autopilot',
      disabledReason: !flying ? 'Start the descent first.'
        : last ? "Autopilot can't fly the last burn."
          : autopilotsUsed >= AUTOPILOTS ? 'Used: 1 per descent.'
            : waitKind === 'autopilot' ? undefined : busy ?? none,
    },
  ];
}
