import React from 'react';
import { motion } from 'framer-motion';
import { ShareButton } from '../ui';
import { DailyPlace } from '../DailyBoard';
import { clockText, shareText } from './logic';

// Re-Entry's results (audit 2026-10-18, D6; redesign 2026-10-22, PROPOSAL §3G). The ★ line says exactly what was
// paid (before: "+1★" while two rewards were requested); the clean-landing reward is the Bonus ★ (framework §A).

/** The ★ lines for a Daily landing: what's paid, and the Bonus (earned or missed). Pure, for tests. */
export function starLines({ undos, powerUps = 0 }) {
  return ['★ +1 Daily landing', undos === 0 && powerUps === 0 ? 'Bonus ★ +1: clean landing, no help' : 'Bonus missed: a clean landing uses no Undo or power-ups'];
}

/** "🔍 1 scan · 🧭 1 autopilot", or null when none were used. */
export const helpLine = ({ scans = 0, autopilots = 0 }) => (scans || autopilots ? `🔍 ${scans} scan${scans === 1 ? '' : 's'} · 🧭 ${autopilots} autopilot${autopilots === 1 ? '' : 's'}` : null);

/**
 * @param {{ phase: 'landed'|'lost', isDaily: boolean, user: any, result: { ms: number, undos: number, newBest: boolean } | null,
 *   burns: number[], today: string, pinnedDay: string | null, recorded: number, placeStatus: string,
 *   dailyOpen: boolean, help?: { scans: number, autopilots: number }, onBackToDaily: () => void, onFlyAgain: () => void, onNew: () => void }} props
 */
export default function LandingResults({ phase, isDaily, user, result, burns, today, pinnedDay, recorded, placeStatus, dailyOpen, help = { scans: 0, autopilots: 0 }, onBackToDaily, onFlyAgain, onNew }) {
  const landed = phase === 'landed';
  return (
    <div className="mt-5 space-y-3 px-4 text-center">
      <motion.div data-testid="reentry-grade" className={`text-3xl font-black ${landed ? 'text-emerald-300' : 'text-rose-300'}`}
        initial={{ scale: 2.4, rotate: -8, opacity: 0 }} animate={{ scale: 1, rotate: 0, opacity: 1 }} transition={{ type: 'spring', stiffness: 420, damping: 18 }}>
        {landed ? 'TOUCHDOWN' : 'Lost in the atmosphere.'}
      </motion.div>
      {landed && result && (
        <div data-testid="reentry-result" className="text-lg font-bold text-white">
          ⏱ {clockText(result.ms)} · {result.undos ? `${result.undos} undo${result.undos === 1 ? '' : 's'}` : 'No undos ✨'}
        </div>
      )}
      {!landed && <div className="text-sm text-slate-300">{isDaily ? 'You gave up. This one ranks last.' : 'You gave up. Practice is never ranked.'}</div>}
      {landed && (
        <div className="mx-auto max-w-xs space-y-1 rounded-xl border border-white/10 bg-black/40 p-3 text-sm text-slate-300">
          {burns.map((b, i) => <div key={i} className="flex justify-between"><span>Burn {i + 1}</span><span className="font-bold text-white">−{b}</span></div>)}
          {helpLine(help) && <div data-testid="reentry-help-used" className="flex justify-between"><span>Power-ups</span><span>{helpLine(help)}</span></div>}
          <div data-testid="reentry-rank-note" className="border-t border-white/10 pt-1 text-xs">
            {isDaily ? (result?.newBest ? '🏅 New best: fastest landing.' : 'Ranked by the fastest landing.') : 'Practice: not ranked.'}
          </div>
        </div>
      )}
      {landed && isDaily && user !== null && result && (
        <div data-testid="reentry-stars" className="mx-auto max-w-xs space-y-0.5 rounded-xl border border-amber-700 bg-amber-950/40 px-3 py-2 text-sm font-bold text-amber-200">
          {starLines({ undos: result.undos, powerUps: help.scans + help.autopilots }).map((line) => <div key={line}>{line}</div>)}
        </div>
      )}
      {isDaily && <DailyPlace game="reEntry" recorded={recorded} day={pinnedDay} status={placeStatus} quiet={!landed} />}
      <div className="flex flex-wrap justify-center gap-2">
        {landed && result && (
          <ShareButton text={() => shareText({ ms: result.ms, burns, undos: result.undos, ...help, daily: isDaily, date: today })} label="Share landing" />
        )}
        {dailyOpen && (
          <button type="button" data-testid="re-back-to-daily-results" onClick={onBackToDaily}
            className="rounded-xl border border-amber-300/60 bg-amber-500/10 px-4 py-2.5 text-sm font-bold text-amber-100">Back to today&apos;s Daily</button>
        )}
        <button type="button" data-testid="reentry-fly-again" onClick={onFlyAgain} className="rounded-xl border border-white/20 px-4 py-2.5 text-sm font-bold text-white">Practice this descent</button>
        <button type="button" data-testid="reentry-new" onClick={onNew} className="rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-black text-white">Practice a new one</button>
      </div>
    </div>
  );
}
