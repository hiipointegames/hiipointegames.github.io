import React, { useEffect, useState } from 'react';
import { motion } from 'framer-motion';
import { NeonDieFace } from '../dice/NeonDie';
import { usePrefersReducedMotion } from '../../fx';
import FlightPlan from './FlightPlan';

// Re-Entry's ~7-second demo (audit 2026-10-18, D5; flight plan 2026-10-22): teach with motion, on the play
// screen's own flight plan. Dice fly in → "216 fits" → FIRE → the bar shrinks → … → the last burn makes exactly
// what's left → LAND → touchdown. Code-drawn (no video). Loops while the briefing is open; holds while the app is
// hidden or the How-it-works sheet covers it. Reduce-motion: three still frames instead.
//
// It is ONE FIXED example descent (never today's: the briefing must not show today's numbers before START),
// built the way the game builds them: start 512, ranges 205–227 and 190–210, last burn exactly 96.

export const DEMO_START = 512;
export const DEMO_RANGES = Object.freeze([{ lo: 205, hi: 227 }, { lo: 190, hi: 210 }]);

// 7 dice per burn (the real rule): 6×6×6×1×1×1×1 = 216 · 5×5×4×2+3−2−1 = 200 · 4×4×6+1−1+2−2 = 96.
const B1 = [6, '×', 6, '×', 6, '×', 1, '×', 1, '×', 1, '×', 1];
const B2 = [5, '×', 5, '×', 4, '×', 2, '+', 3, '−', 2, '−', 1];
const B3 = [4, '×', 4, '×', 6, '+', 1, '−', 1, '+', 2, '−', 2];

/** The beats. `alt` = altitude; `burns` = burns already fired; `ms` = how long the beat holds (✓ beats longest). */
export const DEMO_STEPS = Object.freeze([
  { index: 0, burns: [], tokens: [], alt: 512, ms: 500 },
  { index: 0, burns: [], tokens: B1, chip: '216 fits', fire: 'FIRE 🔥', alt: 512, ms: 1400 },
  { index: 1, burns: [216], tokens: [], alt: 296, ms: 600, flare: true },
  { index: 1, burns: [216], tokens: B2, chip: '200 fits · leaves 96', fire: 'FIRE 🔥', alt: 296, preview: 200, ms: 1400 },
  { index: 2, burns: [216, 200], tokens: [], alt: 96, ms: 600, flare: true },
  { index: 2, burns: [216, 200], tokens: B3, chip: '96: LAND', fire: 'LAND 🪂', alt: 96, ms: 1400 },
  { index: 2, burns: [216, 200, 96], tokens: [], alt: 0, ms: 900, flare: true, landed: true },
]);
export const DEMO_LOOP_MS = DEMO_STEPS.reduce((n, s) => n + s.ms, 0);
const STILLS = [1, 2, 6]; // reduce-motion: make it → it drops → it lands

function Frame({ step, still = false }) {
  const s = DEMO_STEPS[step];
  return (
    <div data-testid={still ? 're-demo-still' : 're-demo-frame'} data-step={step} className="space-y-1.5 rounded-2xl border border-white/10 bg-black/40 py-2">
      <div className="text-[10px] font-bold uppercase tracking-[0.2em] text-orange-200/70">Example descent</div>
      <FlightPlan start={DEMO_START} altitude={s.alt} ranges={DEMO_RANGES} index={s.index} burns={s.burns}
        preview={s.preview ?? null} previewState={s.preview ? 'ok' : null} landed={Boolean(s.landed)} reduced={still} flare={!still && s.flare ? step : 0} testId="re-demo" />
      <div className="flex min-h-[18px] flex-wrap items-center justify-center gap-0.5 px-2">
        {s.landed && <span className="text-xs font-black text-amber-200">🪂 TOUCHDOWN</span>}
        {s.tokens.map((v, k) => (
          <motion.span key={`${step}-${k}`} className="inline-flex items-center" initial={still ? false : { y: 14, opacity: 0 }} animate={{ y: 0, opacity: 1 }}
            transition={still ? { duration: 0 } : { delay: k * 0.03, type: 'spring', stiffness: 300, damping: 20 }}>
            {typeof v === 'number' ? <NeonDieFace value={v} size={15} /> : <span className="text-[10px] font-black text-sky-300">{v}</span>}
          </motion.span>
        ))}
      </div>
      <div className="flex h-5 items-center justify-center gap-1.5">
        {s.chip && (
          // the ✓ arrives after the dice have flown in; then the button is pressed
          <motion.div key={`c${step}`} initial={still ? false : { opacity: 0, scale: 0.6 }} animate={{ opacity: 1, scale: 1 }}
            transition={still ? { duration: 0 } : { delay: 0.45, type: 'spring', stiffness: 380, damping: 16 }}
            className="rounded-full border border-emerald-300/70 px-1.5 text-xs font-black text-emerald-200">✓ {s.chip}</motion.div>
        )}
        {s.fire && (
          <motion.div key={`f${step}`} data-testid="re-demo-fire" initial={still ? false : { opacity: 0 }}
            animate={still ? { opacity: 1 } : { opacity: 1, scale: [1, 1, 0.82, 1] }}
            transition={still ? { duration: 0 } : { delay: 0.75, duration: 0.5, times: [0, 0.5, 0.75, 1] }}
            className="rounded-full bg-rose-500 px-2 text-[11px] font-black text-white">{s.fire}</motion.div>
        )}
      </div>
    </div>
  );
}

/** The looping demo (or three stills under reduce-motion). `paused`: hold the current beat. */
export default function DescentDemo({ paused = false }) {
  const reduced = usePrefersReducedMotion();
  const [step, setStep] = useState(0);
  const [tick, setTick] = useState(0); // re-arms the timer while a beat is being held
  useEffect(() => {
    if (reduced || paused) return undefined;
    const id = setTimeout(() => {
      if (typeof document !== 'undefined' && document.hidden) setTick((n) => n + 1); // app hidden: hold this beat
      else setStep((n) => (n + 1) % DEMO_STEPS.length);
    }, DEMO_STEPS[step].ms);
    return () => clearTimeout(id);
  }, [reduced, paused, step, tick]);
  if (reduced) {
    return (
      <div data-testid="re-demo" data-reduced="true" className="space-y-1.5" aria-hidden="true">
        {STILLS.map((k) => <Frame key={k} step={k} still />)}
      </div>
    );
  }
  return <div data-testid="re-demo" aria-hidden="true"><Frame step={step} /></div>;
}
