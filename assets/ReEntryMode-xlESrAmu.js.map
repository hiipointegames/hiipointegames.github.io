import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { PrimaryButton, ClickShield } from '../ui';
import HowItWorks from '../HowItWorks';
import { DailyChip, PracticeChip } from '../coach';
import DescentDemo from './DescentDemo';

// Re-Entry's briefing (audit 2026-10-18, D5; flight plan 2026-10-22, framework §B1.1): at most three short rules,
// a looping demo of a FIXED example descent, a big START, and everything else one tap away in "ⓘ How it works".
// Today's numbers never appear here: they show at START, with the clock running (contrarian M2).

/** The three rules on the card (≤ 14 words each, verb or number first). */
export const BRIEF_RULES = Object.freeze([
  ['🔥', 'Use 7 dice per burn, 3 burns: every die gets used.'],
  ['🎯', 'Make a number in the green range on burns 1 and 2.'],
  ['🪂', 'Make exactly what’s left on burn 3 to land.'],
]);

/** The full rules, behind ⓘ. */
export const howItWorksItems = (daily) => [
  '🗺️ The flight plan shows all three burns. Burns 1 and 2 have fixed ranges; burn 3 is exactly what’s left.',
  '🎯 The line under your burn says what it makes, and on burn 2 what it leaves for the last 7 dice.',
  '🔢 Every burn is a whole number, and dice can’t touch: put a sign between them (3 4 is not 34, and (3)(4) is not 12).',
  '⚡ ^ means “to the power of”: 2 ^ 3 = 2 × 2 × 2 = 8. ÷ is fine if the burn comes out whole.',
  '🎨 The key colours show the order the maths works in: red ^ first, then blue × ÷, then green + −. Brackets ( ) go before all of them.',
  '👆 Tap a die again to take it back out of the burn.',
  '↩ Undo takes your last burn back after a 5 s wait, so you can pick other dice. If no landing is left, the game says so and points to Undo.',
  daily ? '🎯 The Daily has no free tips: just the line about your own burn, and paid power-ups.' : '💡 Stuck for 30 s? A tip shows a real first step. Tap it away if you like.',
  daily ? '🔍 Scan lights up 7 dice that make this burn, after a 20 s wait.' : '🔍 Scan lights up 7 dice that make this burn. Free in practice.',
  '🧭 Autopilot flies one burn for you after a 60 s wait: once per descent, never the last burn.',
  ...(daily ? ['✨ Bonus ★: land clean, with no Undo and no power-ups.'] : []),
  daily ? '🏳 Give up ends the descent. It ranks last.' : '🏳 Give up ends the descent.',
  daily ? "🏆 Fastest landing wins today's board. One attempt a day; practise as much as you like." : '⏱ Practice is never ranked.',
];

/**
 * @param {{ daily: boolean, date?: string | null, onStart: () => void, onLeave?: () => void,
 *   onPractice?: () => void, onBackToDaily?: () => void }} props
 *   onPractice: shown on a Daily ("Practice first"); onBackToDaily: shown on practice while today's Daily is unflown.
 */
export default function DescentBriefing({ daily, date = null, onStart, onLeave = undefined, onPractice = undefined, onBackToDaily = undefined }) {
  const [how, setHow] = useState(false);
  return (
    <div data-testid="re-briefing" className="absolute inset-0 z-40 grid place-items-center overflow-y-auto bg-black/75 px-4 py-6">
      <ClickShield className="w-full max-w-sm">
        <motion.div initial={{ scale: 0.88, opacity: 0, y: 14 }} animate={{ scale: 1, opacity: 1, y: 0 }} transition={{ type: 'spring', stiffness: 320, damping: 24 }}
          className="rounded-3xl border-2 border-orange-300/70 bg-[#140806]/95 p-4 text-center" style={{ boxShadow: '0 0 40px -10px #fb923c' }}>
          <div className="flex items-center justify-between">
            {daily ? <DailyChip date={date} /> : <PracticeChip />}
            <div className="text-[11px] uppercase tracking-[0.3em] text-orange-200">{daily ? "Today's descent" : 'Practice descent'}</div>
          </div>
          <div className="mt-3"><DescentDemo paused={how} /></div>
          <ul data-testid="re-brief-rules" className="mt-3 space-y-2 text-left">
            {BRIEF_RULES.map(([icon, text]) => (
              <li key={text} className="flex gap-2 text-[15px] font-bold leading-snug text-white"><span aria-hidden="true">{icon}</span><span>{text}</span></li>
            ))}
          </ul>
          {daily
            ? <div data-testid="re-brief-daily" className="mt-2 text-xs font-bold text-amber-200">One attempt today · fastest landing wins</div>
            : <div data-testid="re-brief-practice-note" className="mt-2 text-xs font-bold text-slate-300">Not ranked · no ad · as many as you like</div>}
          <div className="mt-4">
            <PrimaryButton testId="re-brief-start" tone="rose" onClick={onStart}>START 🔥</PrimaryButton>
          </div>
          <div className="mt-3 flex flex-wrap justify-center gap-2 text-xs font-bold">
            <button type="button" data-testid="re-brief-how" onClick={() => setHow(true)} className="rounded-full border border-sky-300/50 px-3 py-1.5 text-sky-100">ⓘ How it works</button>
            {daily && onPractice && (
              <button type="button" data-testid="re-brief-practice" onClick={onPractice} className="rounded-full border border-white/25 px-3 py-1.5 text-slate-100">Practice first</button>
            )}
            {!daily && onBackToDaily && (
              <button type="button" data-testid="re-back-to-daily" onClick={onBackToDaily} className="rounded-full border border-amber-300/60 bg-amber-500/10 px-3 py-1.5 text-amber-100">Today&apos;s Daily ▸</button>
            )}
          </div>
          {onLeave && (
            <button type="button" data-testid="re-brief-leave" onClick={onLeave} className="mt-3 w-full text-center text-xs text-slate-400 underline">
              Not now — back to orbit
            </button>
          )}
        </motion.div>
      </ClickShield>
      {how && <HowItWorks title="Re-Entry" items={howItWorksItems(daily)} onClose={() => setHow(false)} testId="re-how" />}
    </div>
  );
}
