// Re-Entry — the FLIGHT PLAN (redesign 2026-10-22, approved by David with changes; replaces Guided Descent's
// moving landing zones). The player is told three things:
//   🔥 Use 7 dice per burn, 3 burns: every die gets used.
//   🎯 Make a number in the green range on burns 1 and 2.
//   🪂 Make exactly what's left on burn 3 to land.
//
// Burns 1 and 2 each have a FIXED range of burn numbers, set at the start and never moving (before: a landing
// zone whose burn range was recomputed from wherever burn 1 left you). Burn 3 must make exactly what's left.
// Every descent is built FROM a hidden solution (three 7-dice + − × burns), and each hidden burn sits at a RANDOM
// spot inside its range, so the range never gives the answer away. Every legal pair of burns 1–2 leaves a last burn
// of 3 to 300 (FINAL_MIN..FINAL_MAX), so the last burn is never a giant or a zero.
// The keypad keeps + − × ÷ ^ ( ) (David, 2026-10-22). One Re-Entry-only rule: no hidden × — `(3)(4)` or `2(3)`
// counts as dice touching, the same as `34`.

import { evaluateTokens } from '../sectorMath';
import { makeRng, rollDie, shuffle } from '../rng';

export const POOL_SIZE = 21;
export const BURN_DICE = 7;
export const BURNS = 3;
export const RANGE_SHARE = 0.05; // half-width of a burn range, as a share of its hidden burn…
export const RANGE_MIN_HALF = 5; // …but never narrower than ±5
export const START_BAND = Object.freeze([300, 1500]);
export const FINAL_MIN = 3;
export const FINAL_MAX = 300;

/** Today's Daily seed. v3 = the flight plan (2026-10-22); Sector 73 had no live players on v2. */
export const dailySeedFor = (date) => `re-entry-v3-${date}`;

/** One hidden burn: 7 dice and +/−/× operators (at least one ×), worth a whole number ≥ 20. */
function hiddenBurn(rng) {
  for (let k = 0; k < 2000; k++) {
    const dice = Array.from({ length: BURN_DICE }, () => rollDie(rng));
    const ops = Array.from({ length: BURN_DICE - 1 }, () => ['+', '-', '*', '*'][Math.floor(rng() * 4)]);
    if (!ops.includes('*')) continue;
    /** @type {Array<{t:'die',i:number}|{t:'op',v:string}>} */
    const tokens = [];
    dice.forEach((_, i) => { if (i) tokens.push({ t: 'op', v: ops[i - 1] }); tokens.push({ t: 'die', i }); });
    const r = evaluateTokens(tokens, dice);
    if (r.ok && Number.isInteger(r.value) && r.value >= 20) return { dice, ops, value: r.value };
  }
  return null;
}

/** A burn range around a hidden burn value: ±5% (at least ±5), with the hidden value at a random spot inside. */
export function rangeAround(rng, value) {
  const half = Math.max(RANGE_MIN_HALF, Math.round(value * RANGE_SHARE));
  const lo = value - Math.floor(rng() * (2 * half + 1));
  return { lo, hi: lo + 2 * half };
}

/**
 * The last burn's possible span for any legal burns 1–2.
 * @param {number} start @param {ReadonlyArray<{lo:number,hi:number}>} ranges
 */
export const finalSpan = (start, ranges) => ({ lo: start - ranges[0].hi - ranges[1].hi, hi: start - ranges[0].lo - ranges[1].lo });

// The hand-checked descent used only if generation ever fails (never in 365 days, measured):
// 6×6×6×1×1×1×1 = 216 · 5×5×4×2+3−2−1 = 200 · 4×4×6+1−1+2−2 = 96 → start 512.
const FALLBACK_WITNESS = Object.freeze([
  { dice: [6, 6, 6, 1, 1, 1, 1], ops: ['*', '*', '*', '*', '*', '*'], value: 216 },
  { dice: [5, 5, 4, 2, 3, 2, 1], ops: ['*', '*', '*', '+', '-', '-'], value: 200 },
  { dice: [4, 4, 6, 1, 1, 2, 2], ops: ['*', '*', '+', '-', '+', '-'], value: 96 },
]);

/**
 * Today's descent. The same seed gives everyone the same descent.
 * @returns {{ altitude: number, pool: Array<{id:number,value:number,spent:boolean,burn?:number}>,
 *   ranges: Array<{ lo: number, hi: number }>, witness: Array<{dice:number[],ops:string[],value:number}> }}
 */
export function newDescent(seed) {
  const rng = makeRng(seed);
  for (let attempt = 0; attempt < 5000; attempt++) {
    const burns = [hiddenBurn(rng), hiddenBurn(rng), hiddenBurn(rng)];
    if (burns.some((b) => !b)) continue;
    const start = burns[0].value + burns[1].value + burns[2].value;
    if (start < START_BAND[0] || start > START_BAND[1]) continue;
    const ranges = [rangeAround(rng, burns[0].value), rangeAround(rng, burns[1].value)];
    const last = finalSpan(start, ranges);
    if (last.lo < FINAL_MIN || last.hi > FINAL_MAX) continue;
    const values = shuffle(rng, burns.flatMap((b) => b.dice));
    return { altitude: start, pool: values.map((value, id) => ({ id, value, spent: false })), ranges, witness: burns };
  }
  return {
    altitude: 512,
    pool: FALLBACK_WITNESS.flatMap((b) => b.dice).map((value, id) => ({ id, value, spent: false })),
    ranges: [{ lo: 205, hi: 227 }, { lo: 190, hi: 210 }],
    witness: FALLBACK_WITNESS.map((b) => ({ ...b })),
  };
}

/** Which burn is next (0, 1 or 2), from how many dice are spent. */
export const burnIndex = (pool) => Math.min(BURNS - 1, Math.floor(pool.filter((d) => d.spent).length / BURN_DICE));

/**
 * What this burn must make: burns 1–2 their fixed range; the last burn exactly what's left.
 * @returns {{ min: number, max: number, exact: boolean }}
 */
export function rangeFor(ranges, index, altitude) {
  if (index >= BURNS - 1) return { min: altitude, max: altitude, exact: true };
  return { min: ranges[index].lo, max: ranges[index].hi, exact: false };
}

/** "Burn 1 of 3 · make 205–227" / "Burn 3 of 3 · make exactly 96" */
export const burnBanner = (index, range) => `Burn ${index + 1} of ${BURNS} · make ${range.exact ? `exactly ${range.min}` : `${range.min}–${range.max}`}`;

/**
 * Hidden ×: a die or ")" right before a die or "(" (other than two dice, which the engine already calls "fused"),
 * e.g. `(3)(4)`, `2(3+4)`, `(3)4`. Re-Entry only: the shared engine allows it, as the 37 game does.
 */
export function hiddenTimes(tokens) {
  let n = 0;
  for (let k = 1; k < tokens.length; k++) {
    const a = tokens[k - 1]; const b = tokens[k];
    const leftEnds = a.t === 'die' || a.v === ')';
    const rightStarts = b.t === 'die' || b.v === '(';
    if (leftEnds && rightStarts && !(a.t === 'die' && b.t === 'die')) n += 1;
  }
  return n;
}

/**
 * Judge a burn.
 * @param {Array} tokens  token list over the POOL (die tokens index into `pool`)
 * @param {Array<{value:number,spent:boolean}>} pool
 * @param {number} altitude  altitude before the burn
 * @param {{min:number,max:number,exact:boolean}} range  what this burn must make
 * @returns {{ ok: boolean, reason?: string, value?: number, after?: number, lands?: boolean }}
 */
export function judgeBurn(tokens, pool, altitude, range) {
  const values = pool.map((d) => d.value);
  const r = evaluateTokens(tokens, values);
  const used = r.usedIndices;
  if (used.some((i) => pool[i]?.spent)) return { ok: false, reason: 'spent' };
  if (new Set(used).size !== used.length) return { ok: false, reason: 'reused' };
  if (used.length !== BURN_DICE) return { ok: false, reason: 'count', value: r.value };
  if (!r.ok) return { ok: false, reason: r.error === 'non-finite' ? 'too-big' : r.error === 'divide-by-zero' ? 'divide-by-zero' : 'invalid' };
  if (r.fusedPairs > 0 || hiddenTimes(tokens) > 0) return { ok: false, reason: 'fused' };
  if (!Number.isInteger(r.value)) return { ok: false, reason: 'fraction', value: r.value };
  if (r.value < 1) return { ok: false, reason: 'too-small', value: r.value };
  const after = altitude - r.value;
  if (range.exact) {
    if (after !== 0) return { ok: false, reason: after > 0 ? 'short-of-ground' : 'past-ground', value: r.value, after };
    return { ok: true, value: r.value, after, lands: true };
  }
  if (r.value < range.min) return { ok: false, reason: 'short', value: r.value, after };
  if (r.value > range.max) return { ok: false, reason: 'big', value: r.value, after };
  return { ok: true, value: r.value, after, lands: false };
}

const bracketsClosed = (tokens) => {
  let depth = 0;
  for (const t of tokens) if (t.t === 'op') depth += t.v === '(' ? 1 : t.v === ')' ? -1 : 0;
  return depth <= 0; // no bracket left open (an extra ")" is broken for good)
};

/** A chip-sized number: whole numbers as-is, fractions to 2 places, anything enormous as "huge". */
const chipNumber = (v) => (Math.abs(v) >= 1e7 ? (v < 0 ? '−huge' : 'huge') : Number.isInteger(v) ? String(v) : String(Number(v.toFixed(2))));

/**
 * The live coach line (framework §B1.2), in burn numbers. It describes the player's OWN burn — never a hint —
 * so it is the same in the Daily and in practice.
 * @param {Array} tokens  the burn being built
 * @param {{ ok: boolean, value: number|null, error?: string|null, usedIndices: number[], fusedPairs?: number }} result
 * @param {{ min: number, max: number, exact: boolean }} range
 * @param {{ index: number, altitude: number, landing?: 'yes'|'no'|'unknown'|'checking'|null }} [ctx]
 *   landing: can the dice left after this burn still land? (burns 1–2, only once the burn fits)
 * @returns {{ state: 'partial'|'ok'|'warn'|'checking'|'need'|'big'|'invalid', text: string } | null}  null = nothing to say yet
 */
export function chipFor(tokens, result, range, ctx = { index: 0, altitude: 0, landing: null }) {
  if (!tokens.length) return null;
  const n = result.usedIndices.length;
  if (!result.ok) {
    // Only once the equation COULD be finished: never flash an error after "3 +" or "(".
    const last = tokens[tokens.length - 1];
    const ended = last.t === 'die' || last.v === ')';
    if (!ended || !bracketsClosed(tokens)) return null;
    if (result.error === 'non-finite') return { state: 'invalid', text: 'Too big to fly. Try a smaller power.' };
    if (result.error === 'divide-by-zero') return { state: 'invalid', text: "Can't divide by 0. Try another sign." };
    return { state: 'invalid', text: 'Not a burn yet. Check your signs.' };
  }
  if (result.fusedPairs > 0 || hiddenTimes(tokens) > 0) return { state: 'invalid', text: 'Put a sign between dice.' };
  const v = result.value; const shown = chipNumber(v);
  // Not exactly 7 dice (fewer OR more): it's still being built — never a ✓ FIRE can't honour.
  if (n !== BURN_DICE) return { state: n > BURN_DICE ? 'big' : 'partial', text: `${shown} · ${n} of ${BURN_DICE} dice` };
  if (!Number.isInteger(v)) return { state: 'invalid', text: `${shown}: burns are whole numbers. Try × or +.` };
  if (v < 1) return { state: 'need', text: `${shown}: a burn must be 1 or more.` };
  if (range.exact) return v === range.min ? { state: 'ok', text: `${v}: LAND` } : { state: v < range.min ? 'need' : 'big', text: `${shown}: need exactly ${range.min}` };
  if (v < range.min) return { state: 'need', text: `${shown}: need ${range.min} to ${range.max}` };
  if (v > range.max) return { state: 'big', text: `${shown}: too big, max ${range.max}` };
  const left = ctx.altitude - v;
  const lastBurnNext = ctx.index === BURNS - 2;
  if (ctx.landing === 'no') {
    return { state: 'warn', text: lastBurnNext ? `⚠ ${v} fits, but no landing found for ${left}` : `⚠ ${v} fits, but no landing found after it` };
  }
  // Still checking: say so in neutral words, never a green ✓ that might turn into ⚠ (contrarian build review m3).
  if (ctx.landing === 'checking') return { state: 'checking', text: lastBurnNext ? `${v} fits · checking your last 7…` : `${v} fits · checking the landing…` };
  if (ctx.landing === 'yes' && lastBurnNext) return { state: 'ok', text: `${v} fits · leaves ${left} for your last 7` };
  return { state: 'ok', text: `${v} fits` };
}

/** Where the rocket would be after this burn, or null when the burn has no usable value. */
export function ghostAltitude(altitude, result) {
  if (!result.ok || !result.usedIndices.length || !Number.isInteger(result.value) || result.value < 1) return null;
  return altitude - result.value;
}

/**
 * Take pool die `i` back out of the burn being built (tap a lifted die), with the operator that
 * joined it — the one before it, or after it when it comes first — so the rest still reads.
 */
export function withoutDie(tokens, i) {
  const k = tokens.findIndex((t) => t.t === 'die' && t.i === i);
  if (k < 0) return tokens;
  const binary = (t) => t?.t === 'op' && t.v !== '(' && t.v !== ')';
  const [from, to] = binary(tokens[k - 1]) ? [k - 1, k] : binary(tokens[k + 1]) ? [k, k + 1] : [k, k];
  return [...tokens.slice(0, from), ...tokens.slice(to + 1)];
}

/** Mark the dice used by a burn as spent (and which burn spent them, 1-based, for the "used by burn N" look). */
export function spend(pool, usedIndices, burn = 0) {
  const used = new Set(usedIndices);
  return pool.map((d, i) => (used.has(i) ? { ...d, spent: true, burn } : d));
}

/** Unspent dice left. */
export const diceLeft = (pool) => pool.filter((d) => !d.spent).length;

/** m:ss.t */
export function clockText(ms) {
  const tenths = Math.floor(Math.max(0, ms) / 100);
  const m = Math.floor(tenths / 600);
  const s = Math.floor((tenths % 600) / 10);
  return `${m}:${String(s).padStart(2, '0')}.${tenths % 10}`;
}

/** "Landed · 2:14.3 · no undos" / "Landed · 2:14.3 · 1 undo" */
export const resultText = ({ ms, undos = 0 }) => `Landed · ${clockText(ms)}${undos ? ` · ${undos} undo${undos === 1 ? '' : 's'}` : ' · no undos'}`;

/** Share text: time, one bar per burn sized by how much it took off, and any help used. */
export function shareText({ ms, burns, undos = 0, scans = 0, autopilots = 0, daily, date }) {
  const bars = burns.map((v) => (v >= 300 ? '🟥' : v >= 100 ? '🟧' : '🟨')).join('');
  const help = [undos && `↩ ${undos}`, scans && `🔍 ${scans}`, autopilots && `🧭 ${autopilots}`].filter(Boolean).join(' ');
  const clean = help ? ` · ${help}` : ' · clean landing ✨';
  return `🚀 Re-Entry${daily ? ` · Daily ${date}` : ''}\n🪂 Landed in 3 burns · ⏱ ${clockText(ms)}${clean}\n${bars}🪂\nSector 73 · https://37themathpuzzle.app`;
}

export const REASON_TEXT = {
  spent: 'One of those dice already burned.',
  reused: 'Each die can only fire once.',
  count: `Every burn uses exactly ${BURN_DICE} dice.`,
  invalid: 'Not a burn yet. Check your signs.',
  'too-big': 'Too big to fly. Try a smaller power.',
  'divide-by-zero': "Can't divide by 0. Try another sign.",
  fused: 'Put a sign between dice.',
  fraction: 'Burns are whole numbers. Try × or +.',
  'too-small': 'A burn must be 1 or more.',
  short: 'Not enough for this burn yet.',
  big: 'Too much for this burn.',
  'short-of-ground': 'Not enough. Land on exactly 0.',
  'past-ground': 'Too much. Land on exactly 0.',
};

export { makeRng };
