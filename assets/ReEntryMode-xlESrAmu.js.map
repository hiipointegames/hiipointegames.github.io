// Re-Entry's landing solver (redesign 2026-10-22, PROPOSAL §3B + David's changes): "can these dice still land?"
// for the coach line, and "find a burn that fits and still lands" for Scan, Autopilot and Practice tips.
//
// Two searches over a multiset of dice, both with any brackets:
//   • PLUS-MINUS-TIMES (+ − ×): fast (a 7-dice hand is ~5 ms cold), keeps an equation for every number it reaches.
//   • EXTENDED (+ − × ÷ ^ over WHOLE numbers, |v| ≤ 1e6, exponents 0..20): slower (72 ms median, ~0.5 s worst,
//     desktop), numbers only. Run only when + − × says no.
// A "yes" from either is a real landing. A "no" from both is "no landing FOUND": routes through fractions (e.g.
// 3 ÷ 2 × 4) are not searched, so the screen never says "impossible" (David kept ÷ and ^, 2026-10-22).

import { BURN_DICE } from './logic';

const CAP = 1e6;
const MAX_EXP = 20;
const sortKey = (dice) => [...dice].sort((a, b) => a - b);

/** Every way to split a sorted multiset into two non-empty parts, each split once. */
function splitsOf(ms) {
  const out = []; const seen = new Set(); const n = ms.length;
  for (let mask = 1; mask < (1 << n) - 1; mask++) {
    if (!(mask & 1)) continue; // die 0 always on the left
    const A = []; const B = [];
    for (let i = 0; i < n; i++) ((mask >> i) & 1 ? A : B).push(ms[i]);
    const k = `${A.join(',')}|${B.join(',')}`;
    if (!seen.has(k)) { seen.add(k); out.push([A, B]); }
  }
  return out;
}

/**
 * @typedef {{ leaf: number } | { op: '+'|'-'|'*', left: Node, right: Node }} Node  an equation tree over dice values
 */

/** One solver = one memo (keep one per descent). */
export function makeSolver() {
  const pmMemo = new Map(); // key → Map<value, Node>
  const xMemo = new Map(); // key → Set<value>

  /** + − × with brackets: every reachable whole number → one equation for it. */
  const reachPM = (dice) => {
    const ms = sortKey(dice); const k = ms.join(',');
    const hit = pmMemo.get(k); if (hit) return hit;
    /** @type {Map<number, Node>} */
    const out = new Map();
    if (ms.length === 1) out.set(ms[0], { leaf: ms[0] });
    else {
      for (const [A, B] of splitsOf(ms)) {
        const RA = reachPM(A); const RB = reachPM(B);
        for (const [a, na] of RA) {
          for (const [b, nb] of RB) {
            if (!out.has(a + b)) out.set(a + b, { op: '+', left: na, right: nb });
            if (!out.has(a - b)) out.set(a - b, { op: '-', left: na, right: nb });
            if (!out.has(b - a)) out.set(b - a, { op: '-', left: nb, right: na });
            if (!out.has(a * b)) out.set(a * b, { op: '*', left: na, right: nb });
          }
        }
      }
    }
    pmMemo.set(k, out);
    return out;
  };

  /** + − × ÷ ^ over whole numbers (bounded): the set of reachable numbers. */
  const reachX = (dice) => {
    const ms = sortKey(dice); const k = ms.join(',');
    const hit = xMemo.get(k); if (hit) return hit;
    const out = new Set();
    if (ms.length === 1) out.add(ms[0]);
    else {
      const add = (v) => { if (Number.isInteger(v) && Math.abs(v) <= CAP) out.add(v); };
      for (const [A, B] of splitsOf(ms)) {
        const RA = reachX(A); const RB = reachX(B);
        for (const a of RA) {
          for (const b of RB) {
            add(a + b); add(a - b); add(b - a); add(a * b);
            if (b !== 0 && a % b === 0) add(a / b);
            if (a !== 0 && b % a === 0) add(b / a);
            if (b >= 0 && b <= MAX_EXP) add(a ** b);
            if (a >= 0 && a <= MAX_EXP) add(b ** a);
          }
        }
      }
    }
    xMemo.set(k, out);
    return out;
  };

  /** Can exactly these dice make `target`? true = a real landing exists; false = none FOUND. */
  const canMake = (dice, target) => reachPM(dice).has(target) || reachX(dice).has(target);

  /**
   * After burn 1: can these 14 dice make a burn-2 number in `range` and then land exactly? (+ − × only: fast, and
   * a yes is certain.) Returns the split that does it, or null.
   * @returns {{ burn: number[], value: number, rest: number[] } | null}
   */
  const finishFrom = (dice14, altitude, range) => {
    for (const [A, rest] of sevens(dice14)) {
      const RA = reachPM(A); const RR = reachPM(rest);
      for (let v = range.lo; v <= range.hi; v++) {
        if (altitude - v >= 1 && RA.has(v) && RR.has(altitude - v)) return { burn: A, value: v, rest };
      }
    }
    return null;
  };

  return { reachPM, reachX, canMake, finishFrom };
}

/** Every distinct way to pick 7 dice from a multiset, with what's left. */
export function sevens(dice) {
  const cnt = [0, 0, 0, 0, 0, 0, 0]; dice.forEach((v) => { cnt[v] += 1; });
  const picks = [];
  const rec = (v, left, pick) => {
    if (v > 6) { if (!left) picks.push(pick.slice()); return; }
    for (let k = 0; k <= Math.min(cnt[v], left); k++) {
      for (let j = 0; j < k; j++) pick.push(v);
      rec(v + 1, left - k, pick);
      for (let j = 0; j < k; j++) pick.pop();
    }
  };
  rec(1, BURN_DICE, []);
  return picks.map((A) => { const rest = [...dice]; A.forEach((v) => rest.splice(rest.indexOf(v), 1)); return [A, rest]; });
}

/** A hidden burn ({dice, ops}, no brackets) → value tokens. */
const witnessTokens = (burn) => burn.dice.flatMap((v, k) => (k ? [{ t: 'op', v: burn.ops[k - 1] }, { t: 'val', v }] : [{ t: 'val', v }]));

/** The biggest run of × in a hidden burn: [6, 6, 6]. */
function witnessProduct(burn) {
  let best = null; let run = [burn.dice[0]];
  const close = () => { if (run.length >= 2) { const v = run.reduce((a, b) => a * b, 1); if (!best || v > best.value) best = { dice: [...run].sort((a, b) => b - a), value: v }; } };
  for (let k = 1; k < burn.dice.length; k++) {
    if (burn.ops[k - 1] === '*') run.push(burn.dice[k]); else { close(); run = [burn.dice[k]]; }
  }
  close();
  return best;
}

/**
 * A burn that fits this burn's range AND still lands (+ − × only, so a found burn is certain), or null.
 * Burn 1 is always flown from the start, where the hidden solution works; burns 2–3 are searched.
 * @param {ReturnType<typeof makeSolver>} solver
 * @param {{ pool: Array<{value:number,spent:boolean}>, altitude: number, index: number,
 *   ranges: Array<{lo:number,hi:number}>, witness: Array<{dice:number[],ops:string[],value:number}> }} state
 * @returns {{ tokens: Array, used: number[], value: number, chunk: { dice: number[], value: number } | null } | null}
 */
export function findBurn(solver, { pool, altitude, index, ranges, witness }) {
  const free = pool.filter((d) => !d.spent).map((d) => d.value);
  if (index === 0) {
    const w = witness[0];
    return { ...toPoolTokens(witnessTokens(w), pool), value: w.value, chunk: witnessProduct(w) };
  }
  let node = null; let value = altitude;
  if (index === 1) {
    const found = solver.finishFrom(free, altitude, ranges[1]);
    if (!found) return null;
    value = found.value; node = solver.reachPM(found.burn).get(found.value);
  } else {
    node = solver.reachPM(free).get(altitude) ?? null;
  }
  if (!node) return null;
  return { ...toPoolTokens(treeTokens(node), pool), value, chunk: biggestProduct(node) };
}

const PREC = { '+': 1, '-': 1, '*': 2 };

/**
 * An equation tree → keypad tokens over dice VALUES ({t:'val', v} | {t:'op', v}), with only the brackets it needs.
 * @param {Node} node
 */
export function treeTokens(node) {
  if ('leaf' in node) return [{ t: 'val', v: node.leaf }];
  const side = (child, right) => {
    const toks = treeTokens(child);
    if ('leaf' in child) return toks;
    const p = PREC[child.op]; const q = PREC[node.op];
    const wrap = p < q || (right && p === q && node.op === '-');
    return wrap ? [{ t: 'op', v: '(' }, ...toks, { t: 'op', v: ')' }] : toks;
  };
  return [...side(node.left, false), { t: 'op', v: node.op }, ...side(node.right, true)];
}

/**
 * Value tokens → pool tokens: each die value takes the next unspent, unused pool die of that value.
 * @param {Array<{t:'val',v:number}|{t:'op',v:string}>} valueTokens
 * @param {Array<{value:number, spent:boolean}>} pool
 * @returns {{ tokens: Array<{t:'die',i:number}|{t:'op',v:string}>, used: number[] }}
 */
export function toPoolTokens(valueTokens, pool) {
  const taken = new Set();
  const tokens = valueTokens.map((tk) => {
    if (tk.t !== 'val') return tk;
    const i = pool.findIndex((d, j) => !d.spent && !taken.has(j) && d.value === tk.v);
    taken.add(i);
    return { t: /** @type {'die'} */ ('die'), i };
  });
  return { tokens, used: [...taken] };
}

/** The biggest product of dice alone inside an equation (for a Practice tip): [6, 6, 5] or null. */
export function biggestProduct(node) {
  let best = null;
  const productDice = (n) => ('leaf' in n ? [n.leaf] : n.op === '*' ? ((l, r) => (l && r ? [...l, ...r] : null))(productDice(n.left), productDice(n.right)) : null);
  const walk = (n) => {
    if ('leaf' in n) return;
    const p = productDice(n);
    if (p && p.length >= 2) {
      const v = p.reduce((a, b) => a * b, 1);
      if (!best || v > best.value) best = { dice: [...p].sort((a, b) => b - a), value: v };
      return;
    }
    walk(n.left); walk(n.right);
  };
  walk(node);
  return best;
}
