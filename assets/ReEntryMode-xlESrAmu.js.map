// Re-Entry's words for help (redesign 2026-10-22, framework §B; David's change Q7: NO stuck tips in the Daily — a
// dice-pair tip there is either useless or gives too much away. The Daily keeps only the factual coach line, and
// the factual stranded line below. Practice gets one generous stuck tip per burn.)
import { BURNS } from './logic';

/** Undo's wait on the game clock (David, 2026-10-22). */
export const UNDO_WAIT_MS = 5_000;

/** Stranded: no landing was found from here (both modes — it's a fact about your dice, not a hint). */
export const STRANDED_TEXT = '⚠ No landing found from here: ↩ Undo the last burn (5 s)';

const SIGN = { '*': '×' };

/**
 * The Practice stuck tip, built from a REAL burn that fits and still lands (solver.findBurn): its biggest × of
 * dice, then what the burn must make. Never the whole equation.
 * @param {{ chunk: { dice: number[] } | null } | null} found  findBurn's answer for this burn (null = none found)
 * @param {{ min: number, max: number, exact: boolean }} range
 * @param {number} index  which burn (0–2)
 * @returns {string | null}
 */
export function practiceTip(found, range, index) {
  // No + − × burn found: on burn 3 (not stranded) only ÷ or ^ can land, so say exactly that; elsewhere the
  // stranded line says what to do (contrarian build review m5).
  if (!found) return index === BURNS - 1 ? `Use ÷ or ^ here. You need exactly ${range.min}.` : null;
  const need = range.exact ? `You need exactly ${range.min}.` : `You need ${range.min} to ${range.max}.`;
  const big = (found.chunk?.dice ?? []).filter((d) => d > 1).slice(0, 4); // "× 1" says nothing
  if (big.length >= 2) return `Start with ${big.join(` ${SIGN['*']} `)}. ${need}`;
  return index === BURNS - 1 ? `Add and take away: ${need.toLowerCase()}` : `Multiply your biggest dice. ${need}`;
}
