import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { createPortal } from 'react-dom';
import { ModeHeader, SpaceDie, Keypad, EquationReadout, PrimaryButton, useTokenDraft, ActionDock, POWER_KEY_TINTS } from '../ui';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { useFx, runTimeline, prefersReducedMotion, usePrefersReducedMotion } from '../../fx';
import { playSynth } from '../../synth';
import { recordBest, readBestValue } from '../bests';
import { todayEastern, randomSeed } from '../rng';
import {
  newDescent, dailySeedFor, judgeBurn, spend, REASON_TEXT, clockText, burnIndex, resultText, BURN_DICE,
  rangeFor, chipFor, ghostAltitude, withoutDie, diceLeft,
} from './logic';
import { useLandingCheck, useStranded, makeLandingKit } from './useLandingCheck';
import { findBurn } from './solver';
import { practiceTip, STRANDED_TEXT, UNDO_WAIT_MS } from './tips';
import { powerUpList, waitText, scanText, SCAN_WAIT_MS, AUTOPILOT_WAIT_MS, AUTOPILOTS } from './powerUps';
import DescentBriefing from './DescentBriefing';
import FlightPlan from './FlightPlan';
import { earnStars } from '../stars';
import { startDaily, finishDaily } from '../dailyRuns';
import { beforeDailyAttempt } from '../dailyAd';
import LandingResults from './LandingResults';
import DailyDoneCard from './DailyDoneCard';
import { TipSlot, DailyChip, PracticeChip, useStuckTimer, PowerUpTray } from '../coach';
import { useDailyBackGuard } from '@/daily-challenge';

// Re-Entry's signature moment, "Touchdown" (sweep SW14a; storyboard juice.md §3.4): the landing
// burn fires, the rocket settles, a freeze-frame, then dust + a heavy impact; the result slams
// in like a stamp. A tap skips it.
export const TOUCHDOWN_IMPACT_MS = 550;
export const TOUCHDOWN_LAND_MS = 900;

/**
 * Play the touchdown: impact at 550 ms, results at 900 ms. Reduced motion: both at once.
 * @returns {{ skip: () => void, cancel: () => void } | null} the timeline (null when instant)
 */
export function startTouchdown({ impact, land, reduced = prefersReducedMotion() }) {
  if (reduced) { impact(); land(); return null; }
  return runTimeline([
    { at: TOUCHDOWN_IMPACT_MS, run: impact },
    { at: TOUCHDOWN_LAND_MS, run: land },
  ]);
}

// SAFETY + HELP (audit 2026-10-18, D8/D9; redesign 2026-10-22).
export const UNDO_CAP = 99; // the server rejects more (sector73_daily_finish), so the app stops here

// Re-Entry — the flight plan (redesign 2026-10-22). See ./logic.js.

// One Daily attempt: START marks the attempt; leaving mid-descent uses it; a finished Daily keeps its
// result. Afterwards the same descent can still be flown as practice, unranked.
const DAILY_KEY = 'sector73.reEntry.daily';
export function readDaily(date) {
  try {
    const s = JSON.parse(globalThis.localStorage?.getItem(DAILY_KEY) ?? 'null');
    return s && s.date === date ? s : null;
  } catch { return null; }
}
const writeDaily = (state) => { try { globalThis.localStorage?.setItem(DAILY_KEY, JSON.stringify(state)); } catch { /* storage blocked */ } };

/**
 * This mode reads `params.entry` (redesign 2026-10-22, framework §D): the world shows Re-Entry's Daily object and
 * its Practice object once a game says so.
 */
export const ACCEPTS_ENTRY = true;

/** 'daily' | 'practice' from the launch params; anything else (older callers) → null. */
export const entryOf = (params) => (params?.entry === 'daily' || params?.entry === 'practice' ? params.entry : null);

const practiceSeed = () => `re-entry-practice-${randomSeed()}`;

export default function ReEntryMode({ onExit, onReturnTo37, user = undefined, params = null }) {
  const entry = entryOf(params);
  // MIDNIGHT-SAFE (audit D9): a Daily is pinned to its date + seed at START, so a descent that
  // runs past midnight still finishes — and posts — as that day's Daily. Before START, "today"
  // is the live date.
  const pin = useRef(/** @type {{date:string, seed:string}|null} */ (null));
  const today = pin.current?.date ?? todayEastern();
  const dailySeed = pin.current?.seed ?? dailySeedFor(today);
  const [usedDaily, setUsedDaily] = useState(() => readDaily(today)); // today's attempt, if any
  // The Practice object opens practice straight away (never the Daily, no ad); the Daily object opens today's
  // Daily — or its done card when it's used; no entry (older callers): as before.
  const [seed, setSeed] = useState(() => (entry === 'practice' ? practiceSeed() : dailySeed));
  const [practice, setPractice] = useState(() => entry === 'practice' || Boolean(readDaily(today))); // the Daily already flown
  const isDaily = seed === dailySeed && !practice;

  const [descent, setDescent] = useState(() => newDescent(seed)); // altitude, 21 dice, the two burn ranges
  const [pool, setPool] = useState(() => descent.pool);
  const [altitude, setAltitude] = useState(() => descent.altitude);
  const start0 = descent.altitude;
  // briefing | done (the Daily object, already flown) | flying | touchdown | landed | lost
  const [phase, setPhase] = useState(() => (entry === 'daily' && readDaily(today) ? 'done' : 'briefing'));
  const [abortArmed, setAbortArmed] = useState(false);
  const [message, setMessage] = useState(/** @type {string|null} */ (null)); // a refusal (FIRE pressed but not allowed)
  const [burns, setBurns] = useState(/** @type {number[]} */ ([]));
  const [history, setHistory] = useState(/** @type {Array<{pool:any[], altitude:number, burns:number[]}>} */ ([]));
  const [undos, setUndos] = useState(0);
  const [help, setHelp] = useState({ scans: 0, autopilots: 0 }); // power-ups used this descent (results, share, Bonus)
  const [scanLit, setScanLit] = useState(/** @type {{ key: string, indices: Set<number> } | null} */ (null));
  const [result, setResult] = useState(null); // { ms, undos, newBest }
  const fx = useFx();
  const planRef = useRef(null);
  const touchdown = useRef(null);
  useEffect(() => () => touchdown.current?.cancel(), []);
  useEffect(() => {
    if (phase !== 'lost') return;
    fx.cue('fail');
    fx.burst(planRef, { preset: 'dust', color: '#fb923c', heat: 0.6 }); // no shake: that is Touchdown's alone (D2)
  }, [phase, fx]);
  const reduced = usePrefersReducedMotion();
  const [flare, setFlare] = useState(0); // bumps on every FIRE → one thruster flare

  // The stopwatch: one clock for the whole descent, START to touchdown, counting only while the app is
  // visible (a long gap counts as at most 1 s). It doesn't pause for an Undo: the time spent is its cost.
  const elapsed = useRef(0);
  const [shownSec, setShownSec] = useState(0);

  // WAITS (David, 2026-10-22): Undo (and the power-ups) cost a wait on THIS clock — visible time only, so
  // switching apps never speeds one up — with FIRE locked until it ends. No server change: the time is the cost.
  const [wait, setWait] = useState(/** @type {{ kind: string, endsAt: number } | null} */ (null));
  const waitRef = useRef(/** @type {{ kind: string, endsAt: number, run: () => void } | null} */ (null));
  const startWait = (kind, ms, run) => {
    if (waitRef.current) return;
    waitRef.current = { kind, endsAt: elapsed.current + ms, run };
    setWait({ kind, endsAt: elapsed.current + ms });
  };
  const cancelWait = () => { waitRef.current = null; setWait(null); };

  useEffect(() => {
    if (phase !== 'flying') return undefined;
    let last = Date.now();
    const id = setInterval(() => {
      const now = Date.now();
      if (!(typeof document !== 'undefined' && document.hidden)) elapsed.current += Math.min(1000, now - last);
      last = now;
      setShownSec(Math.floor(elapsed.current / 1000));
      const w = waitRef.current;
      if (w && elapsed.current >= w.endsAt) { waitRef.current = null; setWait(null); w.run(); }
    }, 200);
    return () => clearInterval(id);
  }, [phase]);

  const values = useMemo(() => pool.map((d) => d.value), [pool]);
  const draft = useTokenDraft(values);
  const next = burnIndex(pool);
  const range = rangeFor(descent.ranges, next, altitude);

  const restart = (nextSeed, asPractice) => {
    pin.current = null;
    setSeed(nextSeed); setPractice(asPractice);
    const fresh = newDescent(nextSeed);
    setDescent(fresh);
    setPool(fresh.pool);
    setAltitude(fresh.altitude); setPhase('briefing');
    setAbortArmed(false); setMessage(null); setBurns([]); setHistory([]); setUndos(0); setResult(null); setHelp({ scans: 0, autopilots: 0 }); setScanLit(null);
    elapsed.current = 0; setShownSec(0); cancelWait();
    draft.clear();
  };

  /** Show `date`'s Daily briefing (or practice, if that Daily was already flown). */
  const restartForDay = (date) => {
    const flown = readDaily(date);
    setUsedDaily(flown);
    restart(flown ? practiceSeed() : dailySeedFor(date), Boolean(flown));
  };

  // Today's Daily not flown yet (practising first): offer the way back to it.
  const dailyOpen = practice && !pin.current && !readDaily(todayEastern()) && usedDaily?.date !== todayEastern(); // memory too: storage may be blocked

  const [recorded, setRecorded] = useState(0); // bumps when the server has today's result (board refresh)
  const [sent, setSent] = useState(/** @type {'posted'|'queued'|'dropped'|null} */ (null)); // how the result went
  // START on the Daily claims it on the server: one attempt per ACCOUNT (another phone or cleared
  // app data cannot fly it again). Offline, the phone's own rule still applies.
  const start = () => {
    // A briefing left open across midnight: START opens the NEW day's Daily briefing instead of
    // flying (or claiming) yesterday's descent.
    const now = todayEastern();
    if (!practice && seed !== dailySeedFor(now)) { restartForDay(now); return; }
    if (!isDaily) { setPhase('flying'); return; } // practice: no ad
    beforeDailyAttempt(() => startDailyDescent()); // the Daily ad first
  };
  const startDailyDescent = () => {
    const now = todayEastern(); // the date at the START tap, not the last render
    pin.current = { date: now, seed: dailySeedFor(now) };
    setPhase('flying');
    const s = { date: now, status: 'started' }; writeDaily(s); setUsedDaily(s);
    startDaily('reEntry').then((claim) => {
      if (!claim?.used) return;
      const used = { date: now, status: 'elsewhere' }; writeDaily(used); setUsedDaily(used);
      restart(practiceSeed(), true);
    });
  };

  const finish = (status, extra = {}) => {
    if (!isDaily) return;
    const s = { date: today, status, ...extra }; writeDaily(s); setUsedDaily(s);
    const score = status === 'landed' ? { landed: true, ms: extra.ms, undos: extra.undos, scans: extra.scans, autopilots: extra.autopilots } : { landed: false };
    finishDaily('reEntry', score).then((how) => {
      setSent(how); setRecorded((n) => n + 1);
      writeDaily({ ...s, sent: how }); // the done card only says "on the board" when the server took it
    });
  };

  const abort = () => { setPhase('lost'); finish('lost'); };

  // LEAVING MID-DAILY asks once (Return to 37, Orbit, Android Back). Leave = give up: posted, ranks last.
  // The clock keeps running under the question (as with Undo, time spent is the cost). Web browser
  // Back is not guarded — the same as the 37 Daily (parity decision, CLAUDE.md).
  const [leaveTo, setLeaveTo] = useState(/** @type {{ go: () => void } | null} */ (null));
  const flyingDaily = phase === 'flying' && isDaily;
  const guardLeave = (go) => () => (flyingDaily ? setLeaveTo({ go }) : go?.());
  const leaveNow = () => { const go = leaveTo?.go; setLeaveTo(null); abort(); go?.(); };
  // Android Back opens the question; Back again while it's open means "stay".
  const askLeave = useCallback(() => setLeaveTo((cur) => (cur ? null : { go: onExit })), [onExit]);
  useEffect(() => {
    if (!leaveTo) return undefined;
    const onKey = (e) => { if (e.key === 'Escape') setLeaveTo(null); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [leaveTo]);
  useDailyBackGuard(flyingDaily, askLeave);

  const inDraft = new Set(draft.result.usedIndices);
  const tapDie = (i) => {
    if (phase !== 'flying' || pool[i].spent) return;
    if (inDraft.has(i)) { draft.setTokens(withoutDie(draft.tokens, i)); return; } // tap again = take it back out
    setAbortArmed(false);
    setMessage(null);
    draft.addDie(i);
  };

  const fire = () => {
    if (waitRef.current) return; // FIRE is locked while a wait counts down
    const verdict = judgeBurn(draft.tokens, pool, altitude, range);
    if (!verdict.ok) { // the button is disabled for these; kept as a guard
      playSynth('fail');
      setMessage(REASON_TEXT[verdict.reason] || 'Burn rejected.');
      return;
    }
    const nextPool = spend(pool, draft.result.usedIndices, next + 1);
    setHistory((h) => [...h, { pool, altitude, burns }]);
    setPool(nextPool);
    setBurns((b) => [...b, verdict.value]);
    setAltitude(verdict.after);
    setAbortArmed(false);
    draft.clear();
    setMessage(null);
    if (verdict.lands) {
      playSynth('success');
      const ms = elapsed.current;
      let newBest = false;
      if (isDaily) {
        newBest = recordBest('reEntry', ms);
        finish('landed', { ms, undos, ...help, burns: [...burns, verdict.value] });
        earnStars('re_landing', today); // ★ for a Daily landing…
        if (undos === 0 && !help.scans && !help.autopilots) earnStars('re_one_turn', today); // …+1 Bonus: a clean one (no Undo, no power-ups)
      }
      setResult({ ms, undos, newBest });
      setPhase('touchdown');
      touchdown.current = startTouchdown({
        impact: () => fx.cue('touchdown', { at: planRef, color: '#fdba74' }),
        land: () => setPhase('landed'),
      });
      return;
    }
    playSynth('warp');
    setFlare((n) => n + 1);
    fx.burst(planRef, { preset: 'ring', color: '#86efac' });
  };

  // UNDO: take back the last burn — its 7 dice return and the altitude goes back. It costs a 5 s wait on the
  // game clock (David, 2026-10-22: the rescue when you strand yourself, at a price), with FIRE locked meanwhile.
  const undo = () => {
    const last = history[history.length - 1];
    if (!last || phase !== 'flying' || undos >= UNDO_CAP || waitRef.current) return;
    playSynth('blip');
    setAbortArmed(false);
    startWait('undo', UNDO_WAIT_MS, () => {
      setHistory((h) => h.slice(0, -1));
      setPool(last.pool); setAltitude(last.altitude); setBurns(last.burns);
      setUndos((n) => n + 1);
      draft.clear();
      setMessage(null);
    });
  };

  // The live coach line, in burn numbers: "216 · 4 of 7 dice" / "200 fits · leaves 96 for your last 7".
  const liveVerdict = draft.result.ok ? judgeBurn(draft.tokens, pool, altitude, range) : null;
  // ONE solver + answer cache per descent for every landing question (contrarian build review M1).
  const kit = useMemo(() => makeLandingKit(), [descent]);
  const landing = useLandingCheck({ kit, pool, usedIndices: draft.result.usedIndices, verdict: liveVerdict, index: next, ranges: descent.ranges });
  const chip = chipFor(draft.tokens, draft.result, range, { index: next, altitude, landing });
  const ghost = phase === 'flying' ? ghostAltitude(altitude, draft.result) : null;
  const preview = ghost == null ? null : altitude - ghost;
  const previewState = !liveVerdict?.ok ? 'off' : chip?.state === 'warn' ? 'warn' : 'ok';
  // STRANDED (both modes: a fact about your dice, not a hint): no landing found from here → point at Undo.
  const stranded = useStranded({ kit, pool, altitude, index: next, ranges: descent.ranges, active: phase === 'flying' }) && history.length > 0 && undos < UNDO_CAP;
  // PRACTICE stuck tip (framework §B1.3; none in the Daily, David 2026-10-22): after 30 s without a FIRE or an Undo,
  // one tip from a real burn that still lands. It goes when you make progress, or when you tap it away.
  const { stuck, dismiss: dismissTip } = useStuckTimer({
    progressKey: `${descent.altitude}|${burns.length}|${undos}`,
    active: phase === 'flying' && !isDaily && !stranded && !liveVerdict?.ok && !wait,
  });
  const tipSolver = kit.solver;
  // A burn that fits AND still lands from here (Scan and Autopilot show it; none = stranded).
  const found = useMemo(() => (phase === 'flying' && next < 2 ? findBurn(tipSolver, { pool, altitude, index: next, ranges: descent.ranges, witness: descent.witness }) : null),
    [phase, pool, altitude, next, tipSolver, descent]);
  const progressKey = `${burns.length}|${undos}`;
  const lit = scanLit?.key === progressKey ? scanLit.indices : null; // a Scan lasts until you fire or undo
  const usePowerUp = (id) => {
    if (!found || waitRef.current) return;
    const burn = found;
    if (id === 'scan') {
      setHelp((h) => ({ ...h, scans: h.scans + 1 }));
      const show = () => setScanLit({ key: progressKey, indices: new Set(burn.used) });
      if (isDaily) startWait('scan', SCAN_WAIT_MS, show); else show(); // practice: free
    } else if (id === 'autopilot' && help.autopilots < AUTOPILOTS) {
      setHelp((h) => ({ ...h, autopilots: h.autopilots + 1 }));
      startWait('autopilot', AUTOPILOT_WAIT_MS, () => draft.setTokens(burn.tokens));
    }
  };
  const tip = useMemo(() => (stuck
    ? practiceTip(findBurn(tipSolver, { pool, altitude, index: next, ranges: descent.ranges, witness: descent.witness }), range, next)
    : null), [stuck]); // computed once per stuck spell, from the state at that moment
  const waitLeft = wait ? Math.max(1, Math.ceil((wait.endsAt - elapsed.current) / 1000)) : 0;
  // Why your place might not show (D6). `user` undefined = not passed (tests / older callers): no claim.
  const placeStatus = user === null ? 'signedOut' : user?.is_anonymous ? 'guest' : sent === 'posted' ? 'posted' : sent ?? 'pending';
  const best = readBestValue('reEntry');
  const timeShown = phase === 'flying' || phase === 'briefing' ? clockText(shownSec * 1000).slice(0, -2) : clockText(result?.ms ?? elapsed.current);
  const messages = {
    refusal: message,
    tip: stranded ? null : tip,
    good: wait || stranded ? null : chip?.state === 'ok' ? chip.text : lit && !chip ? scanText(range) : null,
    coach: wait ? waitText(wait.kind, waitLeft) : stranded ? STRANDED_TEXT : chip && chip.state !== 'ok' ? chip.text : null,
  };
  const shell = 'relative isolate flex h-full flex-col overflow-y-auto pb-6';
  const sky = { background: 'radial-gradient(ellipse at bottom, #4a1d0a 0%, #04030d 65%)' };

  // The Daily object after today's attempt: its done card, never a silent practice run (framework §D2).
  if (phase === 'done' && usedDaily) {
    return (
      <div className={shell} style={sky}>
        <ModeBackdrop theme="reEntry" />
        <ModeHeader title="Re-Entry" onExit={onExit} onReturnTo37={onReturnTo37} />
        <DailyDoneCard used={usedDaily} user={user} onPractice={() => restart(practiceSeed(), true)} onLeave={onExit} />
      </div>
    );
  }

  return (
    <div className={shell} style={sky}>
      <ModeBackdrop theme="reEntry" />
      <ModeHeader title="Re-Entry" onExit={guardLeave(onExit)} onReturnTo37={guardLeave(onReturnTo37)} />
      {leaveTo && createPortal(
        <div data-testid="reentry-leave" className="fixed inset-0 z-[10001] grid place-items-center bg-black/70 px-6" role="dialog" aria-modal="true">
          <div className="w-full max-w-xs rounded-2xl border border-rose-300/60 bg-[#140806] p-4 text-center text-white">
            <div className="text-lg font-black">Leave? Today&apos;s Daily ends here.</div>
            <div className="mt-1 text-sm text-slate-300">It counts as giving up: it ranks last.</div>
            <div className="mt-4 grid gap-2">
              <button type="button" data-testid="reentry-leave-stay" autoFocus onClick={() => setLeaveTo(null)} className="rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-black">Keep flying</button>
              <button type="button" data-testid="reentry-leave-go" onClick={leaveNow} className="rounded-xl border border-rose-300/60 px-4 py-2.5 text-sm font-bold text-rose-100">Leave</button>
            </div>
          </div>
        </div>,
        document.body,
      )}
      {practice && usedDaily && phase !== 'landed' && phase !== 'lost' && (
        <div data-testid="reentry-daily-used" className="mx-3 mt-1 rounded-lg border border-amber-300/30 bg-amber-500/10 px-2 py-1 text-center text-[11px] text-amber-100">
          {usedDaily.status === 'landed' ? `Today's Daily: ${resultText({ ms: usedDaily.ms ?? 0, undos: usedDaily.undos ?? 0 })}` : usedDaily.status === 'lost' ? "Today's Daily: lost" : usedDaily.status === 'elsewhere' ? "Today's Daily was already flown on your account" : "Today's Daily attempt was used (you left mid-descent)"}. This one is practice.
        </div>
      )}

      {/* The chip row: DAILY / PRACTICE at a glance (framework §D3), the clock, Give up. */}
      <div className="mt-2 flex items-center justify-between gap-2 px-3">
        {isDaily ? <DailyChip date={today} /> : <PracticeChip />}
        <div className="flex items-center gap-2">
          <span className="text-base font-black tabular-nums text-white"><span aria-hidden="true">⏱ </span><span data-testid="reentry-clock">{timeShown}</span></span>
          {phase === 'flying' && (
            <button type="button" data-testid="reentry-abort" onClick={() => (abortArmed ? abort() : setAbortArmed(true))}
              className={`rounded-full border px-2.5 py-1 text-[11px] font-bold ${abortArmed ? 'border-rose-300 bg-rose-600 text-white' : 'border-white/25 text-slate-300'}`}>
              {abortArmed ? (isDaily ? 'Tap again: ranks last' : 'Tap again to give up') : 'Give up'}
            </button>
          )}
        </div>
      </div>
      {isDaily && best != null && phase !== 'flying' && <div className="px-3 text-right text-[10px] text-slate-500">Your best: {clockText(best)}</div>}

      <div className="mt-2" ref={planRef}>
        <FlightPlan start={start0} altitude={altitude} ranges={descent.ranges} index={next} burns={burns}
          preview={phase === 'flying' ? preview : null} previewState={previewState} hidden={phase === 'briefing'}
          landed={phase === 'landed' || phase === 'touchdown'} reduced={reduced} flare={flare} />
      </div>

      {phase === 'briefing' && (
        <DescentBriefing daily={isDaily} date={today} onStart={start} onLeave={onExit}
          onPractice={() => restart(practiceSeed(), true)}
          onBackToDaily={dailyOpen ? () => restartForDay(todayEastern()) : undefined} />
      )}
      {phase === 'touchdown' && (
        <div className="absolute inset-0 z-30" data-testid="reentry-touchdown" role="presentation" onClick={() => touchdown.current?.skip()} />
      )}
      {phase === 'touchdown' ? <div className="h-48" /> : phase === 'flying' || phase === 'briefing' ? (
        <div className="mt-2 space-y-1.5 px-3">
          <div className="grid grid-cols-7 gap-1 justify-items-center">
            {/* Dice keep their places. Spent = an outlined slot showing which burn used it; in this burn = lifted + ringed. */}
            {pool.map((d, i) => (
              <div key={d.id} data-pool-index={i} data-state={d.spent ? 'spent' : inDraft.has(i) ? 'burn' : 'free'} data-scan={lit?.has(i) || undefined}
                className={`rounded-xl transition-transform ${inDraft.has(i) ? '-translate-y-1' : ''} ${lit?.has(i) && !inDraft.has(i) ? 'ring-2 ring-amber-300 shadow-[0_0_12px_-2px_#fbbf24]' : ''}`}>
                {d.spent
                  ? <div aria-label={`die ${d.value}, used by burn ${d.burn}`} className="grid place-items-center rounded-xl border border-dashed border-orange-300/50 text-[11px] font-bold text-orange-300/60" style={{ width: 36, height: 36 }}>{d.value}</div>
                  // Face-down until START: no studying today's dice before the clock runs.
                  : <SpaceDie value={d.value} size={36} hidden={phase === 'briefing'} glow={inDraft.has(i)} label={phase === 'briefing' ? 'hidden die' : `die ${d.value}${inDraft.has(i) ? ', in this burn' : ''}`} onClick={() => tapDie(i)} />}
              </div>
            ))}
          </div>
          <EquationReadout tokens={draft.tokens} values={values} result={draft.result} cursor={draft.cursor} onCursor={draft.setCursor}
            target={null} accepted={liveVerdict?.ok ?? false} dieSize={24} lines={2} />
          <div data-testid="reentry-live" data-state={chip?.state ?? 'none'}>
            <TipSlot messages={messages} testId="reentry-coach" onDismissTip={stranded ? undefined : dismissTip} />
          </div>
          {/* One counter: 7 dots that fill as dice go into this burn (red past 7). */}
          <div data-testid="reentry-dots" data-count={draft.result.usedIndices.length} className="flex justify-center gap-1" role="img" aria-label={`${draft.result.usedIndices.length} of ${BURN_DICE} dice in this burn, ${diceLeft(pool)} dice left`}>
            {Array.from({ length: BURN_DICE }, (_, k) => {
              const n = draft.result.usedIndices.length;
              return <span key={k} className={`h-2.5 w-2.5 rounded-full border ${k < n ? (n > BURN_DICE ? 'border-rose-300 bg-rose-400' : 'border-amber-200 bg-amber-300') : 'border-white/30'}`} />;
            })}
          </div>
          {/* The tray (framework §C2): Undo — one tap, its own button so it can pulse when you're stranded — then
              the shared PowerUpTray (tap → card → USE) for Scan and Autopilot. */}
          <div className="flex items-center justify-center gap-2">
            <button type="button" data-testid="reentry-undo" disabled={!history.length || undos >= UNDO_CAP || Boolean(wait)} onClick={undo} data-stuck={stranded || undefined}
              data-wait={wait?.kind === 'undo' ? waitLeft : undefined} aria-label="Undo: take back your last burn (5 s wait)"
              className={`relative flex h-[56px] min-w-[60px] flex-col items-center justify-center rounded-xl border border-sky-300/50 bg-[#0c1a33] px-1.5 text-xl active:scale-95 disabled:opacity-40 ${stranded ? `ring-2 ring-sky-300 ${reduced ? '' : 'animate-pulse'}` : ''}`}>
              <span aria-hidden="true">↩</span>
              <span className="mt-0.5 text-[10px] font-bold leading-none text-slate-200">{wait?.kind === 'undo' ? `${waitLeft} s` : 'Undo'}</span>
              <span className="absolute -right-1.5 -top-1.5 rounded-full bg-sky-700 px-1.5 text-[10px] font-black text-white">5s</span>
            </button>
            <PowerUpTray powerUps={powerUpList({ daily: isDaily, index: next, autopilotsUsed: help.autopilots, waitKind: wait?.kind ?? null, found: Boolean(found), flying: phase === 'flying' })}
              onUse={usePowerUp} testId="reentry-tray" />
          </div>
          <Keypad ops={['+', '-', '*', '/', '^', '(', ')']} onOp={draft.addOp} onDelete={draft.del} onClear={draft.clear} tints={POWER_KEY_TINTS} />
          <ActionDock>
            {/* FIRE lights up when the burn makes a number in its range (or exactly what's left on burn 3). */}
            <PrimaryButton tone="rose" testId="reentry-fire" disabled={phase !== 'flying' || !liveVerdict?.ok || Boolean(wait)} onClick={fire}>
              {liveVerdict?.lands ? 'LAND 🪂' : 'FIRE 🔥'}
            </PrimaryButton>
          </ActionDock>
        </div>
      ) : (
        <LandingResults phase={phase === 'landed' ? 'landed' : 'lost'} isDaily={isDaily} user={user} result={result} burns={burns} today={today}
          pinnedDay={pin.current?.date ?? null} recorded={recorded} placeStatus={placeStatus} dailyOpen={dailyOpen}
          help={help} onBackToDaily={() => restartForDay(todayEastern())} onFlyAgain={() => restart(seed, true)} onNew={() => restart(practiceSeed(), true)} />
      )}
    </div>
  );
}
