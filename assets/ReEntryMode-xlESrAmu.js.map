import { useEffect, useMemo, useState } from 'react';
import { makeSolver } from './solver';
import { BURNS } from './logic';
import { canMakeExtended } from './landingAsync';

// "Can these dice still land?" (redesign 2026-10-22, PROPOSAL §3B with David's change: FIRE is never blocked by it —
// with ÷ and ^ on the keypad a "no" can't be proven quickly). Two questions, ONE solver + answer cache per descent
// (contrarian build review M1: before, three solvers searched the same 7 dice twice):
//   • useLandingCheck — for the burn being built: can the dice it leaves still land?
//   • useStranded — for where you are now: is any landing left?
// The exact last burn: + − × first (~5 ms, on the main thread); only if that fails, whole-number + − × ÷ ^ in a Web
// Worker (landingAsync), so the screen never freezes. After burn 1 (14 dice): + − × only (≤ 40 ms cold).
// Each runs once per complete, fitting burn / per position, never per keystroke.

/** @typedef {'yes' | 'no' | 'unknown'} Answer  unknown = the worker failed; the screen then claims nothing */

/** One solver + one answer cache for a descent. Keep it in a `useMemo` keyed by the descent. */
export function makeLandingKit() {
  return { solver: makeSolver(), answers: /** @type {Map<string, Answer>} */ (new Map()) };
}

/** Ask (or recall) one question; `settle` is called with the answer, now or later. Returns a cancel. */
function ask(kit, { index, dice, target, range2 }, settle) {
  const key = `${index}|${dice.join('')}|${target}`;
  const known = kit.answers.get(key);
  if (known) { settle(known); return () => {}; }
  const done = (a) => { kit.answers.set(key, a); settle(a); };
  if (index === 0) { done(kit.solver.finishFrom(dice, target, range2) ? 'yes' : 'no'); return () => {}; }
  if (kit.solver.reachPM(dice).has(target)) { done('yes'); return () => {}; }
  return canMakeExtended(kit.solver, dice, target, (ok) => done(ok === null ? 'unknown' : ok ? 'yes' : 'no'));
}

/** Shared by both hooks: the answer for `q` (null when there's nothing to ask), re-rendering when it arrives. */
function useAnswer(kit, q) {
  const key = q ? `${q.index}|${q.dice.join('')}|${q.target}` : null;
  const [, setTick] = useState(0);
  useEffect(() => {
    if (!q || kit.answers.has(key)) return undefined;
    return ask(kit, q, () => setTick((n) => n + 1));
  }, [kit, key]); // `key` encodes the question
  if (!key) return null;
  return kit.answers.get(key) ?? 'checking';
}

const sorted = (values) => [...values].sort((a, b) => a - b);

/**
 * @param {{ kit: ReturnType<typeof makeLandingKit>, pool: Array<{value:number,spent:boolean}>, usedIndices: number[],
 *   verdict: { ok: boolean, lands?: boolean, after?: number } | null, index: number, ranges: Array<{lo:number,hi:number}> }} args
 * @returns {Answer | 'checking' | null}  null = nothing to check (no fitting burn yet, or the last burn)
 */
export function useLandingCheck({ kit, pool, usedIndices, verdict, index, ranges }) {
  const fits = Boolean(verdict?.ok && !verdict.lands && index < BURNS - 1);
  const usedKey = usedIndices.join(',');
  const q = useMemo(() => {
    if (!fits) return null;
    const used = new Set(usedIndices);
    // after burn 1 the question is about burn 2 + landing (index 0); after burn 2, the exact landing (index 1 → exact)
    return { index: index === 0 ? 0 : 2, dice: sorted(pool.filter((d, i) => !d.spent && !used.has(i)).map((d) => d.value)), target: verdict.after, range2: ranges[1] };
  }, [fits, pool, usedKey, verdict?.after, index, ranges]); // usedKey stands in for usedIndices (a new array each render)
  return useAnswer(kit, q);
}

/**
 * Stranded? Can the dice NOT yet spent still land from here (David, 2026-10-22: "make the stranded state obvious and
 * point to Undo")? Burn 3: can the last 7 make exactly the altitude? Burn 2: can the 14 make a burn-2 number and then
 * land (+ − × only, so rarely a ÷ ^ route is missed — the line says "no landing FOUND")? Burn 1 never strands.
 * @param {{ kit: ReturnType<typeof makeLandingKit>, pool: Array<{value:number,spent:boolean}>, altitude: number, index: number,
 *   ranges: Array<{lo:number,hi:number}>, active: boolean }} args
 * @returns {boolean}  true only once a search has finished and found no landing
 */
export function useStranded({ kit, pool, altitude, index, ranges, active }) {
  const q = useMemo(() => (active && index > 0
    ? { index: index === 1 ? 0 : 2, dice: sorted(pool.filter((d) => !d.spent).map((d) => d.value)), target: altitude, range2: ranges[1] }
    : null), [active, index, pool, altitude, ranges]);
  return useAnswer(kit, q) === 'no';
}
