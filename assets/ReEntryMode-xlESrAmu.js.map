import React from 'react';
import { ShareButton } from '../ui';
import { DailyPlace } from '../DailyBoard';
import { DailyChip } from '../coach';
import { clockText, shareText } from './logic';

// The Daily object, already flown today (framework §D2; mockup 9): your result, your place, Share, and "Practice
// instead" — never a silent practice run that looks like the Daily.

/** What today's attempt came to, in one line. */
export function doneLine(used) {
  if (used.status === 'landed') return `⏱ ${clockText(used.ms ?? 0)} · ${used.undos ? `${used.undos} undo${used.undos === 1 ? '' : 's'}` : 'no undos'}`;
  if (used.status === 'lost') return 'You gave up. It ranks last.';
  if (used.status === 'elsewhere') return 'Already flown on your account.';
  return 'You left mid-descent, so it counts as given up.';
}

/**
 * @param {{ used: { date: string, status: string, ms?: number, undos?: number, burns?: number[], scans?: number, autopilots?: number, sent?: string }, user: any,
 *   onPractice: () => void, onLeave?: () => void }} props
 */
export default function DailyDoneCard({ used, user, onPractice, onLeave = undefined }) {
  const landed = used.status === 'landed';
  // Only what we know (contrarian build review m2): the server's answer when it came, else the neutral board button.
  const status = user === null ? 'signedOut' : user?.is_anonymous ? 'guest' : ['posted', 'queued', 'dropped'].includes(used.sent) ? used.sent : undefined;
  return (
    <div data-testid="reentry-done" className="mx-4 mt-6 rounded-3xl border-2 border-orange-300/70 bg-[#140806]/95 p-4 text-center" style={{ boxShadow: '0 0 40px -10px #fb923c' }}>
      <div className="flex items-center justify-between">
        <DailyChip date={used.date} />
        <div className="text-[11px] uppercase tracking-[0.3em] text-orange-200">Today&apos;s descent</div>
      </div>
      <div className="mt-4 text-2xl font-black text-white">{landed ? '✓ Done for today' : "Today's Daily is used"}</div>
      <div data-testid="reentry-done-line" className="mt-1 text-lg font-bold text-amber-100">{doneLine(used)}</div>
      <DailyPlace game="reEntry" recorded={1} day={used.date} status={status} quiet={!landed} />
      <div className="mt-1 text-xs text-slate-400">A new descent comes at midnight ET.</div>
      <div className="mt-3 flex flex-wrap justify-center gap-2">
        {landed && used.burns?.length === 3 && (
          <ShareButton text={() => shareText({ ms: used.ms ?? 0, burns: used.burns, undos: used.undos ?? 0, scans: used.scans ?? 0, autopilots: used.autopilots ?? 0, daily: true, date: used.date })} label="Share landing" />
        )}
      </div>
      <button type="button" data-testid="reentry-done-practice" onClick={onPractice} className="mt-3 w-full rounded-2xl bg-orange-500 py-3 text-base font-black text-white">Practice instead</button>
      {onLeave && (
        <button type="button" onClick={onLeave} className="mt-3 w-full text-center text-xs text-slate-400 underline">Not now — back to orbit</button>
      )}
    </div>
  );
}
