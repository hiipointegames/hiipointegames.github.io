// Ask "can these dice make exactly `target` with + − × ÷ ^?" without blocking the screen: in a Web Worker
// (landingWorker.js) where there is one, else on the main thread after a tick (tests; very old WebViews).
// The answer: true / false, or null when the worker failed (the caller then claims nothing).

let worker = /** @type {Worker | false | null} */ (null); // null = not tried yet; false = unavailable
let seq = 0;
const pending = new Map();

function getWorker() {
  if (worker !== null) return worker || null;
  try {
    if (typeof Worker === 'undefined' || import.meta.env?.MODE === 'test') throw new Error('no worker');
    worker = new Worker(new URL('./landingWorker.js', import.meta.url), { type: 'module' });
    worker.onmessage = (e) => { const cb = pending.get(e.data.id); pending.delete(e.data.id); cb?.(e.data.ok); };
    worker.onerror = () => { worker = false; for (const cb of pending.values()) cb(null); pending.clear(); };
  } catch {
    worker = false;
  }
  return worker || null;
}

/**
 * @param {{ reachX: (dice: number[]) => Set<number> }} solver  the main-thread fallback
 * @param {number[]} dice
 * @param {number} target
 * @param {(ok: boolean | null) => void} done
 * @returns {() => void} cancel (the answer is then never delivered)
 */
export function canMakeExtended(solver, dice, target, done) {
  const w = getWorker();
  if (!w) {
    const t = setTimeout(() => done(solver.reachX(dice).has(target)), 0);
    return () => clearTimeout(t);
  }
  const id = ++seq;
  pending.set(id, done);
  w.postMessage({ id, dice, target });
  return () => { pending.delete(id); };
}
