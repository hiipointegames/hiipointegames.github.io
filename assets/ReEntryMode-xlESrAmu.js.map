import React from 'react';
import { motion } from 'framer-motion';
import { BURNS } from './logic';

// The flight plan (redesign 2026-10-22, PROPOSAL §3A; mockups 2–7): the whole descent at a glance. Three cards —
// burn 1's range, burn 2's range, burn 3 "what's left" (filled in live as you build burn 2) — and one full-width
// altitude bar from the start to the ground, with a striped preview of the burn being built. It replaces the
// thin side gauge, whose zones were ~11 px tall on a median day (research Q2).

/**
 * @param {{
 *   start: number, altitude: number, ranges: ReadonlyArray<{lo:number,hi:number}>, index: number, burns: number[],
 *   preview?: number | null,      // the value of the burn being built, when it is a usable whole number
 *   previewState?: 'ok' | 'warn' | 'off' | null,  // fits / fits but no landing found / doesn't fit
 *   hidden?: boolean,             // briefing: today's numbers stay hidden until START
 *   landed?: boolean, reduced?: boolean, flare?: number, testId?: string,
 * }} props
 */
export default function FlightPlan({ start, altitude, ranges, index, burns, preview = null, previewState = null, hidden = false, landed = false, reduced = false, flare = 0, testId = 'reentry' }) {
  const pct = (v) => `${Math.max(0, Math.min(1, v / start)) * 100}%`;
  const lastLive = index === BURNS - 2 && preview != null && previewState !== 'off' ? altitude - preview : null;
  const card = (k) => {
    const done = k < burns.length;
    const now = !landed && k === index && !done;
    const label = `BURN ${k + 1}${done ? ' ✓' : now ? ' · NOW' : ''}`;
    let value;
    if (done) value = `−${burns[k]}`;
    else if (k < BURNS - 1) value = hidden ? '?' : `${ranges[k].lo}–${ranges[k].hi}`;
    else if (hidden) value = 'what’s left';
    else if (index === BURNS - 1) value = `exactly ${altitude}`;
    else if (lastLive != null) value = `exactly ${lastLive}?`;
    else value = 'what’s left';
    return (
      <div key={k} data-testid={`${testId}-step-${k + 1}`} data-state={done ? 'done' : now ? 'now' : 'next'}
        className={`rounded-xl border px-1 py-1.5 text-center ${now ? 'border-2 border-emerald-400 bg-emerald-950/70 shadow-[0_0_18px_-6px_#34d399]' : done ? 'border-white/10 bg-black/40 opacity-80' : 'border-white/15 bg-black/40'}`}>
        <div className={`text-[10px] font-extrabold tracking-[0.12em] ${now ? 'text-emerald-200' : 'text-slate-400'}`}>{label}</div>
        <div className={`font-black tabular-nums leading-tight ${done ? 'text-emerald-200' : 'text-white'} ${k === BURNS - 1 && !done ? 'text-sm' : 'text-[17px]'}`}>{value}</div>
      </div>
    );
  };

  // The bar runs from the start (left) to the ground (right): what's been burned, what's left, and the preview.
  const burnedPct = pct(start - altitude);
  const tone = previewState === 'ok' ? '#34d39966' : previewState === 'warn' ? '#fbbf2466' : '#fb718566';
  return (
    <div data-testid={`${testId}-plan`} className="px-3">
      <div className="grid grid-cols-3 gap-1.5">{[0, 1, 2].map(card)}</div>
      <div data-testid={`${testId}-bar`} className="relative mt-2 h-7 overflow-hidden rounded-full border border-orange-300/40 bg-black/60"
        role="img" aria-label={hidden ? 'Today’s flight plan appears at START' : `${altitude} to go of ${start}`}>
        <motion.div className="absolute inset-y-0 left-0 bg-[#3f1d0e]" initial={false} animate={{ width: burnedPct }}
          transition={reduced ? { duration: 0 } : { type: 'spring', stiffness: 80, damping: 16 }} />
        <motion.div className="absolute inset-y-0 right-0 bg-gradient-to-r from-orange-800 to-orange-700" initial={false} animate={{ width: pct(altitude) }}
          transition={reduced ? { duration: 0 } : { type: 'spring', stiffness: 80, damping: 16 }} />
        {preview != null && preview > 0 && (
          <div data-testid={`${testId}-drop`} data-state={previewState ?? 'off'} aria-hidden="true" className="absolute inset-y-0"
            style={{ left: burnedPct, width: pct(Math.min(preview, altitude)), background: `repeating-linear-gradient(45deg, ${tone} 0 6px, transparent 6px 12px)` }} />
        )}
        <span className="absolute left-2.5 top-1/2 -translate-y-1/2 text-[11px] font-extrabold text-white">
          {hidden ? 'Today’s plan appears at START' : landed ? 'Landed' : altitude}
        </span>
        {flare > 0 && !reduced && (
          <motion.span key={flare} data-testid={`${testId}-flare`} aria-hidden="true" className="absolute top-1/2 -translate-y-1/2 text-base" style={{ left: `calc(${burnedPct} - 10px)` }}
            initial={{ opacity: 1, scale: 1.4 }} animate={{ opacity: 0, scale: 0.6 }} transition={{ duration: 0.7 }}>🔥</motion.span>
        )}
      </div>
      <div className="mt-0.5 flex justify-between px-1 text-[10px] text-orange-200/80">
        <span>{hidden ? '' : burns.length ? `−${burns.reduce((a, b) => a + b, 0)} done` : 'you are here'}</span>
        <span>ground 0 ▸</span>
      </div>
    </div>
  );
}
