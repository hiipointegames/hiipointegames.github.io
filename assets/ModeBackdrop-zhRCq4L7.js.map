import React from 'react';
import './backdrop.css';

// Each mode's living background (sweep SW7). Sits behind the mode's content: the mode's root
// must be `relative isolate` so this z-index:-1 layer stays above the root's own gradient and
// below its content. Purely decorative (aria-hidden, no pointer events).

/** Per-mode palette: star colours and the two nebula tints. */
export const BACKDROP_THEMES = Object.freeze({
  hyperjump: { star: '#c4b5fd', near: '#ede9fe', a: 'rgba(124,58,237,0.35)', b: 'rgba(236,72,153,0.18)' },
  reEntry: { star: '#fed7aa', near: '#fff7ed', a: 'rgba(234,88,12,0.32)', b: 'rgba(220,38,38,0.18)' },
  firstContact: { star: '#a5f3fc', near: '#ecfeff', a: 'rgba(8,145,178,0.32)', b: 'rgba(16,185,129,0.16)' },
  starChart: { star: '#bfdbfe', near: '#eff6ff', a: 'rgba(37,99,235,0.30)', b: 'rgba(139,92,246,0.16)' },
  battle: { star: '#f5d0fe', near: '#fdf4ff', a: 'rgba(192,38,211,0.32)', b: 'rgba(124,58,237,0.20)' },
  thirtySeven: { star: '#ddd6fe', near: '#f5f3ff', a: 'rgba(109,40,217,0.32)', b: 'rgba(14,165,233,0.16)' },
});

export function ModeBackdrop({ theme }) {
  const t = BACKDROP_THEMES[theme] || BACKDROP_THEMES.hyperjump;
  return (
    <div
      className="s73-backdrop"
      aria-hidden="true"
      data-testid="mode-backdrop"
      data-theme={theme}
      style={/** @type {React.CSSProperties} */ ({ '--s73-star': t.star, '--s73-star-near': t.near, '--s73-nebula-a': t.a, '--s73-nebula-b': t.b })}
    >
      <div className="s73-nebula" />
      <div className="s73-stars s73-stars--far" />
      <div className="s73-stars s73-stars--near" />
    </div>
  );
}
