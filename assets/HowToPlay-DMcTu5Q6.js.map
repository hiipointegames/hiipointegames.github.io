// Route wrapper for the How-To-Play page. Reads the mode from the URL
// (?mode=easy|challenge|daily, default daily) and wires back/start navigation.
// Keeps HowToPlayPage itself pure/presentational for easy testing.

import React from 'react';
import { useNavigate, useSearchParams, useLocation } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { HowToPlayPage, markSeen } from '@/how-to-play';

export default function HowToPlay() {
  const navigate = useNavigate();
  const location = useLocation();
  const [params] = useSearchParams();
  const mode = params.get('mode') || 'daily';

  // home-condense H2 — first-run gating. When Game.jsx routes here on the first
  // roll of a mode, it passes { requireScroll: true, autoRoll: true } via nav
  // state: requireScroll forces a full scroll before the CTA unlocks; autoRoll
  // tells Game.jsx to roll once on return (so the how-to is a one-time speed bump,
  // not a dead end). A plain "?" open (top row / pre-game modal) passes neither.
  const requireScroll = location?.state?.requireScroll === true;
  const autoRoll = location?.state?.autoRoll === true;

  // Back arrow: return to the mode's home WITHOUT rolling and WITHOUT marking seen
  // (they didn't complete the first-run read, so they'll be gated again).
  const onBack = () => navigate(createPageUrl('Game'), { state: { mode } });

  // "Got it — Play": they've seen it → mark seen, then return. Carry autoRoll ONLY
  // for a first-run visit so it rolls once on arrival; a plain "?" visit returns
  // to the launcher with just { mode } (no auto-roll).
  const onStart = () => {
    markSeen(mode);
    navigate(createPageUrl('Game'), { state: { mode, ...(autoRoll ? { autoRoll: true } : {}) } });
  };

  return <HowToPlayPage mode={mode} onBack={onBack} onStart={onStart} requireScroll={requireScroll} />;
}
