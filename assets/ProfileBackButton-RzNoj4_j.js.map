import { createPageUrl } from '@/routing/createPageUrl';

// Pure resolver for OtherProfile's Back button (WS3 nav sweep, 2026-07-13).
//
// The bug it fixes: OtherProfile used to send Back to a hard-coded Colosseum
// (`createPageUrl('HeadToHead')`) whenever no `returnTo` query param was present.
// The three entry points inside the home "Friends & Players" screen (UserSearch,
// FriendsList, RecommendedPlayers) pass only `?id=`, so opening a player from
// home and pressing Back dumped you on the Colosseum instead of where you came
// from.
//
// The intended semantics (David's call): Back means BACK.
//   1. If a caller explicitly named where to return (`returnTo`), honor it.
//   2. Otherwise, if there's real in-app history, pop it (browser back) so you
//      land on the exact screen you came from (Friends screen, search, etc.).
//   3. Otherwise (deep link / notification / cold load straight to a profile —
//      no history to pop), fall back to Home so Back never dead-ends.
//
// Kept pure (no router, no window) so every branch is unit-tested; the component
// supplies `canGoBack` from the history stack and acts on the returned intent.
//
/**
 * @param {{ returnTo?: string|null, canGoBack?: boolean }} params
 * @returns {{ back: true } | { to: string }}
 */
export function resolveProfileBack({ returnTo, canGoBack } = {}) {
  if (returnTo) return { to: createPageUrl(returnTo) };
  if (canGoBack) return { back: true };
  return { to: createPageUrl('Game') };
}
