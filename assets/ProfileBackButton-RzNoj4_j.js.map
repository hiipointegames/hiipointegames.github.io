import React from 'react';
import { useNavigate, useSearchParams } from 'react-router-dom';
import { Button } from '@/ui/primitives/button';
import { ArrowLeft } from 'lucide-react';
import { resolveProfileBack } from './resolveProfileBack';

// The OtherProfile Back button (extracted from OtherProfile.jsx, WS3 nav sweep).
//
// Back means BACK: honor an explicit `returnTo` query param, else pop real
// in-app history so you return to the exact screen you came from (e.g. the home
// "Friends & Players" screen), else fall back to Home so Back never dead-ends.
// The old inline code hard-defaulted to the Colosseum, which is why opening a
// player from Friends and pressing Back jumped you there. Decision logic lives in
// the pure, unit-tested resolveProfileBack; this component only wires it to the
// router.
export default function ProfileBackButton() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();

  const handleBack = () => {
    const returnTo = searchParams.get('returnTo');
    const canGoBack = (window.history.state?.idx ?? 0) > 0;
    const dest = resolveProfileBack({ returnTo, canGoBack });
    // `dest` is a discriminated union ({ back: true } | { to }); narrow with `in`
    // so checkJs can see which arm we're on (was `dest.back`, a TS2339 on the
    // { to } arm).
    if ('back' in dest) navigate(-1);
    else navigate(dest.to);
  };

  return (
    <Button
      onClick={handleBack}
      aria-label="Back"
      className="bg-gradient-to-r from-indigo-600 to-purple-700 hover:from-indigo-700 hover:to-purple-800 text-white border border-purple-500/50 min-h-[48px] min-w-[48px] sm:min-h-[44px] sm:min-w-[44px] touch-manipulation shadow-lg"
    >
      <ArrowLeft className="w-5 h-5" />
    </Button>
  );
}
