import React, { useCallback, useEffect, useState } from 'react';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { haptic, usePrefersReducedMotion } from '../../fx';
import { ModeHeader } from '../ui';
import { useDailyBackGuard } from '@/daily-challenge';
import DuelBoard from './DuelBoard';
import PilotStrip from './PilotStrip';
import RoundReveal from './RoundReveal';
import LiveResultCard from './LiveResultCard';
import { useMyLook } from './DuelShips';
import { useLiveDuel } from '../../duel/useLiveDuel';
import { mmss } from '../../duel/reconnectClock';
import { STYLE_NAME } from '../../duel/DuelInvites';
import { fetchPilots } from '../../multiplayer/useSectorRoom';
import { DEFAULT_LOOK } from '../../world/shipArt';
import './duel.css';

// The LIVE battle screen (slice S6 + the S7 minimum, 2026-10-20): the same screen as the practice
// duel (ships, pips, the main game's board, the winning-equation reveal), driven by the server
// through useLiveDuel. Opened by the page as openMode('liveDuel', { duelId, opponentName, onRematch })
// once an invite is accepted (its own mode, so the practice DuelMode is untouched).
//
// Leaving while the duel is live is a FORFEIT (David: "30 s to reconnect, then forfeit"; leaving on
// purpose ends it at once), so the ✕, Return to 37 and Android Back all ask first. Before the duel is
// live, leaving just cancels it (no forfeit, no ★).

const PRE_LIVE = new Set(['loading', 'ad', 'waiting']);
const LIVE = new Set(['countdown', 'round', 'reveal']);

/**
 * @param {{ onExit: () => void, onReturnTo37: () => void, user: any,
 *   params: { duelId: string, opponentName?: string, onRematch?: (opts: { theirId: string, name: string, style: string, firstTo: number }) => Promise<string|null> } }} props
 */
export default function LiveDuelMode({ onExit, onReturnTo37, user, params: live }) {
  const { state: s, submit, leave, reconnect, roundClock, countdownLeft } = useLiveDuel({ duelId: live.duelId, myId: user?.id });
  const reducedMotion = usePrefersReducedMotion();
  const myLook = useMyLook();
  const [them, setThem] = useState({ name: live.opponentName || 'Pilot', look: DEFAULT_LOOK });
  const [confirm, setConfirm] = useState(false);

  useEffect(() => {
    if (!s.theirId) return undefined;
    let alive = true;
    fetchPilots([s.theirId]).then((got) => {
      const p = got.get(s.theirId);
      if (alive && p) setThem({ name: p.name, look: p.look ?? DEFAULT_LOOK });
    }).catch(() => { /* keep the name we were given */ });
    return () => { alive = false; };
  }, [s.theirId]);

  // The loser's ship is hit (and the phone taps) when a round's result comes in.
  useEffect(() => {
    if (s.phase === 'reveal' && s.last?.by) haptic(s.last.by === 'me' ? 'medium' : 'heavy');
  }, [s.phase, s.last]);

  const isLive = LIVE.has(s.phase);
  // Every way out: ask while live (forfeit), cancel quietly before live, just go once it's over.
  const away = useCallback((go) => {
    if (LIVE.has(s.phase)) { setConfirm(true); return; }
    if (PRE_LIVE.has(s.phase)) { leave().finally(go); return; }
    go();
  }, [s.phase, leave]);
  // Android Back: while live it asks (forfeit); before the start it cancels (S6 review m9).
  const backGuard = useCallback(() => {
    if (LIVE.has(s.phase)) setConfirm(true);
    else leave().finally(onExit);
  }, [s.phase, leave, onExit]);
  useDailyBackGuard(isLive || PRE_LIVE.has(s.phase), backGuard);

  const opponentName = them.name;
  const styleName = STYLE_NAME[s.style] ?? 'Easy';

  if (!isLive) {
    const rematch = live.onRematch && s.theirId
      ? () => live.onRematch({ theirId: s.theirId, name: opponentName, style: s.style, firstTo: s.firstTo })
      : null;
    return (
      <div className="s73-duel relative isolate flex h-full flex-col overflow-y-auto bg-[#04030d] pb-6" data-testid="live-duel" data-phase={s.phase}>
        <ModeBackdrop theme="battle" />
        <ModeHeader title="Live duel" subtitle={`vs ${opponentName}`} onExit={() => away(onExit)} onReturnTo37={() => away(onReturnTo37)} />
        <div className="flex flex-1 items-center px-4 pt-4">
          {s.phase === 'result' && s.result ? (
            <LiveResultCard result={s.result} score={s.score} opponentName={opponentName} history={s.history} onRematch={rematch} onExit={onExit} />
          ) : (
            <div data-testid="live-duel-status" className="mx-auto w-full max-w-md rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white">
              <div className="text-[10px] font-bold uppercase tracking-[0.3em] text-violet-300/80">{styleName} · first to {s.firstTo}</div>
              <div className="mt-2 text-lg font-black">{statusLine(s, opponentName)}</div>
              {s.note && <p className="mt-2 text-xs text-slate-300">{s.note}</p>}
              <button type="button" data-testid="live-duel-back" onClick={() => away(onExit)}
                className="mt-4 w-full rounded-xl border border-cyan-300/60 bg-black/40 py-3 text-sm font-black tracking-widest text-cyan-100 active:scale-95">
                {PRE_LIVE.has(s.phase) ? 'CANCEL' : 'BACK TO ORBIT ↑'}
              </button>
            </div>
          )}
        </div>
      </div>
    );
  }

  const hitSide = s.phase === 'reveal' && s.last?.by ? (s.last.by === 'me' ? 'cpu' : 'me') : null;
  const board = s.board;
  return (
    <div className="s73-duel s73-duel-play relative isolate flex h-full flex-col bg-[#04030d]" data-testid="live-duel" data-phase={s.phase} data-round={s.n}>
      <ModeBackdrop theme="battle" />
      <div style={{ paddingTop: 'var(--safe-top, 0px)' }}>
        <PilotStrip side="cpu" name={opponentName} caption={`Live · ${styleName}`} wins={s.score.cpu} firstTo={s.firstTo} hit={hitSide === 'cpu'} reducedMotion={reducedMotion} look={them.look} lookId={`pilot-${s.theirId}`}>
          <button type="button" data-testid="duel-leave" aria-label="Leave the duel" onClick={() => setConfirm(true)}
            className="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-white/25 bg-white/5 text-slate-100 active:scale-95">✕</button>
        </PilotStrip>
        {reconnect != null && (
          <div data-testid="live-duel-reconnect" className="mx-3 rounded-lg border border-amber-300/50 bg-amber-500/15 px-3 py-1 text-center text-xs font-bold text-amber-100">
            {opponentName} reconnecting… <span className="tabular-nums">{mmss(reconnect)}</span>
          </div>
        )}
      </div>
      <div className="relative min-h-0 flex-1">
        {s.phase === 'countdown' && (
          <div data-testid="duel-countdown" className="grid h-full place-items-center text-center">
            <div>
              <div className="text-[11px] font-bold uppercase tracking-[0.35em] text-violet-300/80">Round {s.n}</div>
              <div key={countdownLeft} className={`s73-duel-count text-7xl font-black text-white${reducedMotion ? '' : ' is-animated'}`} data-testid="duel-count">{countdownLeft}</div>
              <div className="text-xs text-slate-400">First to {s.firstTo}</div>
            </div>
          </div>
        )}
        {s.phase === 'round' && board && (
          <>
            <DuelBoard key={s.n} dice={board.dice} colors={board.colors} style={board.style} elapsedSeconds={roundClock} onSolve={submit} />
            {(s.note || s.sent || s.submitting) && (
              <div data-testid="live-duel-note" className="pointer-events-none absolute inset-x-0 top-1 mx-auto w-fit rounded-full border border-white/20 bg-black/80 px-3 py-1 text-xs font-bold text-slate-100">
                {s.submitting ? 'Sending…' : s.note}
              </div>
            )}
            {(s.sent || s.submitting || !board.clockStarted) && <div className="absolute inset-0" data-testid="live-duel-locked" aria-hidden="true" />}
          </>
        )}
        {s.phase === 'reveal' && s.last && (
          <div className="grid h-full place-items-center px-4">
            <RoundReveal last={s.last} colors={board?.colors ?? []} opponentName={opponentName} />
          </div>
        )}
      </div>
      <PilotStrip side="me" name="You" caption={`First to ${s.firstTo}`} wins={s.score.me} firstTo={s.firstTo} hit={hitSide === 'me'} reducedMotion={reducedMotion} look={myLook} lookId="mine" />

      {confirm && (
        <div className="absolute inset-0 z-50 grid place-items-center bg-black/70 px-6" data-testid="live-duel-confirm">
          <div className="w-full max-w-sm rounded-2xl border border-rose-300/50 bg-[#0b0820] p-5 text-center text-white">
            <div className="text-lg font-black">Leave the duel?</div>
            <p className="mt-1 text-sm text-slate-300">You forfeit the match and {opponentName} wins.</p>
            <div className="mt-4 grid grid-cols-2 gap-2">
              <button type="button" data-testid="live-duel-stay" onClick={() => setConfirm(false)}
                className="rounded-xl border border-white/25 bg-white/5 py-2.5 text-sm font-black">Stay</button>
              <button type="button" data-testid="live-duel-forfeit" onClick={() => { setConfirm(false); leave(); }}
                className="rounded-xl border border-rose-300/70 bg-rose-500/30 py-2.5 text-sm font-black">Leave</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function statusLine(s, name) {
  switch (s.phase) {
    case 'loading': return 'Linking up…';
    case 'ad': return 'Get ready…';
    case 'waiting': return `Waiting for ${name}…`;
    case 'over':
      if (s.over === 'ready_timeout') {
        if (s.notReady === 'me') return "You didn't make it to the start, so the duel was called off.";
        if (s.notReady === 'them') return `${name} didn't make it to the start.`;
        return "One of you didn't make it to the start.";
      }
      if (s.over === 'abandoned') return 'Both pilots were gone too long. No winner.';
      return 'This duel was called off.';
    case 'error': return s.note || 'Something went wrong.';
    default: return '';
  }
}
