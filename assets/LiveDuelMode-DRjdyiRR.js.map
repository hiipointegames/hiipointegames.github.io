// useLiveDuel — one live duel on this phone (slice S6 + the S7 minimum, 2026-10-20).
//
// Owns every clock and call of the match; the screen (modes/duel/LiveDuelMode.jsx) only draws it.
//
//   1. Read my duel row. Accepted and I'm not ready → the interstitial (design-v2 D10):
//      showInterstitial({ onDismissed }) and `ready` is called ONLY from onDismissed — never when the
//      ad opens. Then join the duel topic (private; presence only; the server alone broadcasts).
//   2. `here` every 10 s (stamps my server last_seen, enforces the 60 s ready window lazily, and tells
//      me my opponent's last_seen for the reconnect clock).
//   3. 3-2-1 to the server's starts_at (server-clock offset) → s73_duel_serve_round(n) → the board.
//      One warm-up `ping` to the referee during the first countdown (no cold start on answer 1).
//   4. An answer that passes the phone's pre-check (DuelBoard) goes to s73-duel-submit.
//   5. Round results come from the duel topic's broadcast. SAFETY NET (design D6): every 5 s during a
//      round the round row is re-read (and on every SUBSCRIBED); once a round is overdue — 90 s after
//      its start, or 3 s after my correct answer with no result — BOTH phones call round_tick, which
//      voids or closes it on the server.
//   6. Opponent gone: "reconnecting… 0:30" counts to their SERVER last_seen + 30 s; at zero my phone
//      calls s73_duel_claim_forfeit, which the server grants only if it really is 30 s.
//   7. Leave (✕ / Android Back, after a confirm): s73_duel_leave → the other pilot wins by forfeit.
//      Before the duel is live, leaving is a plain cancel (no forfeit).
//
// Seams for tests: api (duelApi), client (channel), show (the interstitial), now, fetchLook.

import { useCallback, useEffect, useReducer, useRef, useState } from 'react';
import { supabase } from '@/transport';
import { showInterstitial } from '@/shell';
import { duelTopic, DUEL_EVENTS } from './topics';
import { createDuelApi } from './duelApi';
import { liveDuelReducer, initialLiveState, LIVE_REVEAL_MS } from './liveDuelReducer';
import { secondsLeft } from './reconnectClock';
import { refreshStarBalance } from '../modes/stars';
import { reportedFallback } from '@/observability';

export const HERE_MS = 10000;
export const REREAD_MS = 5000;
export const VOID_AFTER_MS = 90000;
export const OVERDUE_AFTER_SENT_MS = 3000;
export const CLAIM_RETRY_MS = 5000;

const LIVE_PHASES = new Set(['countdown', 'round', 'reveal']);

/**
 * @param {{ duelId: string, myId: string, api?: import('./duelApi').DuelApi, client?: any,
 *   show?: typeof showInterstitial, now?: () => number, onStars?: () => void }} opts
 */
export function useLiveDuel({ duelId, myId, api: apiIn, client = supabase, show = showInterstitial, now = Date.now, onStars = refreshStarBalance }) {
  const api = useRef(apiIn ?? null);
  if (!api.current) api.current = createDuelApi(client);
  const [s, dispatch] = useReducer(liveDuelReducer, undefined, () => initialLiveState(duelId, myId));
  const state = useRef(s);
  state.current = s;
  const clock = useRef(now);
  clock.current = now;
  const [joined, setJoined] = useState(false);
  const [present, setPresent] = useState(true);
  const [tickNow, setTickNow] = useState(() => now());
  const myAnswer = useRef(null);
  const sentAt = useRef(0);
  const adShown = useRef(false);
  const pinged = useRef(false);

  const call = useCallback((name, ...args) => api.current[name](duelId, ...args), [duelId]);

  /** Re-read the duel row (and the current round, when one is on) — the safety net for lost messages. */
  const resync = useCallback(async () => {
    const d = await call('readDuel');
    if (d.data) dispatch({ type: 'duelRow', duel: d.data, now: clock.current() });
    const cur = state.current;
    if (cur.n > 0 && (cur.phase === 'round' || cur.phase === 'countdown' || (cur.phase === 'reveal' && cur.roundOver))) {
      const r = await call('readRound', cur.n);
      if (r.data?.closed_at) {
        const duel = d.data;
        dispatch({ type: 'roundResult', payload: { ...r.data, challenger_score: duel?.challenger_score, opponent_score: duel?.opponent_score, status: duel?.status, finished: duel ? duel.status !== 'live' : undefined }, myAnswer: myAnswer.current });
      }
    }
  }, [call]);

  // 1. Load the duel.
  useEffect(() => {
    let alive = true;
    call('readDuel').then((d) => {
      if (!alive) return;
      if (d.error) { dispatch({ type: 'error', note: d.error }); return; }
      dispatch({ type: 'loaded', duel: d.data, now: clock.current() });
      if (d.data && d.data.status !== 'accepted') setJoined(true);
    });
    return () => { alive = false; };
  }, [call]);

  // 1b. The ad, then ready — ready ONLY from onDismissed (design-v2 D10; Oct-8 close-freeze class:
  // an ad that never closes simply lets the 60 s ready window cancel the duel, with no forfeit).
  useEffect(() => {
    if (s.phase === 'waiting' && !joined) setJoined(true); // already ready (a re-open)
    if (s.phase !== 'ad' || adShown.current) return;
    adShown.current = true;
    let done = false;
    const onDismissed = () => {
      if (done) return;
      done = true;
      dispatch({ type: 'adClosed' });
      setJoined(true);
      call('ready').then((r) => {
        if (r.error) { dispatch({ type: 'note', note: r.error }); return; }
        dispatch({ type: 'lifecycle', reply: r.data, now: clock.current() });
      });
    };
    Promise.resolve().then(() => show({ onDismissed })).catch(() => onDismissed());
  }, [s.phase, joined, call, show]);

  // 2. The duel topic: server messages + my presence.
  useEffect(() => {
    if (!joined || !myId) return undefined;
    const ch = client.channel(duelTopic(duelId), {
      config: { private: true, presence: { key: myId }, broadcast: { self: false } },
    });
    const at = () => clock.current();
    ch.on('broadcast', { event: DUEL_EVENTS.start }, ({ payload }) => dispatch({ type: 'start', payload, now: at() }));
    ch.on('broadcast', { event: DUEL_EVENTS.roundResult }, ({ payload }) => dispatch({ type: 'roundResult', payload, myAnswer: myAnswer.current }));
    ch.on('broadcast', { event: DUEL_EVENTS.roundVoid }, ({ payload }) => dispatch({ type: 'roundResult', payload: { ...payload, outcome: 'void' } }));
    ch.on('broadcast', { event: DUEL_EVENTS.finished }, ({ payload }) => dispatch({ type: 'finished', payload }));
    ch.on('broadcast', { event: DUEL_EVENTS.cancelled }, ({ payload }) => { dispatch({ type: 'cancelled', reason: payload?.reason }); resync(); });
    ch.on('presence', { event: 'sync' }, () => {
      const st = ch.presenceState?.() ?? {};
      const theirs = state.current.theirId;
      if (theirs) setPresent(Object.prototype.hasOwnProperty.call(st, theirs));
    });
    ch.subscribe(async (status) => {
      if (status === 'SUBSCRIBED') {
        try { await ch.track({ uid: myId, at: Date.now() }); } catch { /* presence is a hint only */ }
        resync();
      }
    });
    return () => { client.removeChannel(ch); };
  }, [joined, duelId, myId, client, resync]);

  // 2b. `here` every 10 s while the duel is on (also enforces the ready window while I wait).
  const active = s.phase === 'waiting' || LIVE_PHASES.has(s.phase);
  useEffect(() => {
    if (!joined || !active) return undefined;
    const beat = () => call('here').then((r) => {
      if (r.data) dispatch({ type: 'lifecycle', reply: r.data, now: clock.current() });
    });
    beat();
    const t = setInterval(beat, HERE_MS);
    return () => clearInterval(t);
  }, [joined, active, call]);

  // Waiting for my partner's ready: re-read every 5 s in case duel_start was lost.
  useEffect(() => {
    if (s.phase !== 'waiting' || !joined) return undefined;
    const t = setInterval(resync, REREAD_MS);
    return () => clearInterval(t);
  }, [s.phase, joined, resync]);

  // 3. The countdown → serve round n (retrying "too early" at the server's start, "not ready" in 1 s).
  useEffect(() => {
    if (s.phase !== 'countdown' || s.n < 1) return undefined;
    let alive = true;
    let timer = null;
    if (s.n === 1 && !pinged.current) { pinged.current = true; Promise.resolve(api.current.ping()).catch(reportedFallback('sector73.duel.ping', null)); }
    const serve = () => {
      if (!alive) return;
      call('serve', s.n).then((r) => {
        if (!alive) return;
        const reply = r.data;
        if (reply?.ok) {
          if (reply.closed_at) { resync(); return; }
          dispatch({ type: 'served', reply, now: clock.current() });
          return;
        }
        if (reply?.reason === 'too_early') {
          const due = Date.parse(reply.starts_at) - Date.parse(reply.server_now);
          timer = setTimeout(serve, Math.max(100, Math.min(10000, Number.isFinite(due) ? due + 50 : 1000)));
          return;
        }
        if (reply?.reason === 'not_live') { resync(); return; }
        timer = setTimeout(serve, 1000); // not_ready / a network error: try again shortly
      });
    };
    const startLocal = s.startsAt != null ? s.startsAt - s.offset : clock.current();
    timer = setTimeout(serve, Math.max(0, startLocal - clock.current()));
    return () => { alive = false; clearTimeout(timer); };
  }, [s.phase, s.n, s.startsAt, s.offset, call, resync]);

  // 5. During a round: re-read every 5 s; tick once the round is overdue (90 s, or my answer unanswered).
  useEffect(() => {
    if (s.phase !== 'round') return undefined;
    const startLocal = s.startsAt != null ? s.startsAt - s.offset : s.servedAt ?? clock.current();
    const t = setInterval(() => {
      const t0 = clock.current();
      const overdue = t0 >= startLocal + VOID_AFTER_MS || (state.current.sent && t0 >= sentAt.current + OVERDUE_AFTER_SENT_MS);
      if (overdue) call('tick', state.current.n).then(() => resync());
      else resync();
    }, REREAD_MS);
    const voidAt = setTimeout(() => { call('tick', state.current.n).then(() => resync()); }, Math.max(0, startLocal + VOID_AFTER_MS + 500 - clock.current()));
    return () => { clearInterval(t); clearTimeout(voidAt); };
  }, [s.phase, s.n, s.startsAt, s.offset, s.servedAt, call, resync]);

  // A won match whose last-round message is late: fetch it; give up waiting after 3 s.
  useEffect(() => {
    if (!s.result || s.phase !== 'round') return undefined;
    resync();
    const t = setTimeout(() => dispatch({ type: 'finished', payload: { ...s.result, winner_id: s.result.winner === 'me' ? myId : s.theirId, end_reason: s.result.reason }, force: true }), 3000);
    return () => clearTimeout(t);
  }, [s.result, s.phase, s.theirId, myId, resync]);

  // The reveal, then the next countdown (or the result). A finished match with no finish yet re-reads.
  useEffect(() => {
    if (s.phase !== 'reveal') return undefined;
    const t = setTimeout(() => dispatch({ type: 'next' }), LIVE_REVEAL_MS);
    let poll = null;
    if (s.roundOver && !s.result) poll = setInterval(resync, REREAD_MS);
    return () => { clearTimeout(t); if (poll) clearInterval(poll); };
  }, [s.phase, s.roundOver, s.result, resync]);

  // Result: the ★ (the broadcast says how many; otherwise read my ledger) and a fresh balance.
  useEffect(() => {
    if (s.phase !== 'result' || !s.result) return;
    if (s.result.stars == null && s.result.winner === 'me') {
      api.current.myDuelStars(duelId, myId).then((n) => { if (n != null) dispatch({ type: 'stars', stars: n }); });
    }
    Promise.resolve(onStars?.()).catch(reportedFallback('sector73.duel.starBalance', null));
  }, [s.phase, s.result, duelId, myId, onStars]);

  // 6. The reconnect clock (a 1 s tick while the duel is live).
  useEffect(() => {
    if (!LIVE_PHASES.has(s.phase)) return undefined;
    const t = setInterval(() => setTickNow(clock.current()), 1000);
    return () => clearInterval(t);
  }, [s.phase]);
  const reconnect = LIVE_PHASES.has(s.phase)
    ? secondsLeft({ lastSeen: s.opponentLastSeen, offset: s.offset, present, now: tickNow })
    : null;
  // At 0:00 my phone claims; the server decides (30 s gone, AND I was here). A refused or failed
  // claim is retried every 5 s while the clock stays at 0 (S6 review m6): a network blip on the claim
  // must not leave "0:00" up for ever.
  const claiming = useRef(false);
  const [claimTry, setClaimTry] = useState(0);
  useEffect(() => {
    if (reconnect !== 0 || claiming.current) return undefined;
    claiming.current = true;
    let retry = null;
    call('claimForfeit').then((r) => {
      claiming.current = false;
      const reply = r.data;
      if (reply?.ok) { dispatch({ type: 'finished', payload: reply, force: true }); return; }
      if (reply) dispatch({ type: 'lifecycle', reply, now: clock.current() });
      retry = setTimeout(() => setClaimTry((n) => n + 1), CLAIM_RETRY_MS);
    });
    return () => { if (retry) clearTimeout(retry); };
  }, [reconnect, call, claimTry]);

  // 4. An answer that passed the phone's pre-check.
  const submit = useCallback(async ({ equation, usedIndices }) => {
    const cur = state.current;
    if (cur.phase !== 'round' || cur.submitting || cur.sent || !cur.board) return;
    myAnswer.current = { equation, usedIndices };
    dispatch({ type: 'submitting' });
    const r = await api.current.submit(duelId, cur.n, { equation, usedIndices, dice: cur.board.dice, colors: cur.board.colors });
    if (r.error) { dispatch({ type: 'submitted', sent: false, note: r.error }); return; }
    const d = r.data || {};
    if (d.result) dispatch({ type: 'roundResult', payload: d.result, myAnswer: myAnswer.current });
    if (d.accepted) { sentAt.current = clock.current(); dispatch({ type: 'submitted', sent: true, note: 'Answer in! The referee is checking…' }); return; }
    const NOTE = {
      too_fast: 'One answer a second, pilot.',
      not_eligible: 'Beaten to it: your opponent answered first.',
      not_served: 'Beaten to it: your opponent answered first.',
      window_closed: 'Beaten to it.',
      too_late: 'Time is up for this round.',
      closed: null,
    };
    const note = d.correct === false ? 'The referee says that is not 37.' : (NOTE[d.reason] ?? null);
    dispatch({ type: 'submitted', sent: false, note });
  }, [duelId]);

  // 7. Leave. Live → forfeit (the other pilot wins). Before live → cancel (no forfeit).
  const leave = useCallback(async () => {
    const cur = state.current;
    if (LIVE_PHASES.has(cur.phase)) {
      const r = await call('leave');
      if (r.data?.ok) { dispatch({ type: 'finished', payload: r.data, force: true, left: true }); return true; }
      if (r.data) { dispatch({ type: 'lifecycle', reply: r.data, now: clock.current() }); return true; }
      return false;
    }
    if (cur.phase === 'ad' || cur.phase === 'waiting' || cur.phase === 'loading') await call('cancel');
    return true;
  }, [call]);

  const roundClock = s.phase === 'round' && s.servedAt != null ? Math.max(0, Math.floor((tickNow - s.servedAt) / 1000)) : 0;
  const countdownLeft = s.phase === 'countdown' && s.startsAt != null
    ? Math.max(1, Math.min(3, Math.ceil((s.startsAt - s.offset - tickNow) / 1000)))
    : 3;

  return { state: s, submit, leave, reconnect, present, roundClock, countdownLeft };
}
