import React, { useState } from 'react';
import { PrimaryButton } from '../ui';
import { formatDuelTime } from './formatDuelTime';

// The end of a LIVE duel (slice S6): the score, how it ended, the ★ the server paid, the fastest
// round you won (hundredths), and Rematch (a new invite with the same settings) / Back to orbit.
// The ★ line is the server's word: 2★ a win, at most 5 paid a day and 2 a day per opponent; a
// forfeit pays only after a round was played (design-v2 D8).

/**
 * @param {{ result: { winner: 'me'|'cpu', reason: string, stars: number|null, left?: boolean }, score: { me: number, cpu: number },
 *   opponentName: string, history: Array<{ by: string|null, ms: number|null }>,
 *   onRematch?: (() => Promise<string|null>) | null, onExit: () => void }} props
 */
export default function LiveResultCard({ result, score, opponentName, history, onRematch = null, onExit }) {
  const [error, setError] = useState(/** @type {string|null} */ (null));
  const [busy, setBusy] = useState(false);
  const won = result.winner === 'me';
  const mine = history.filter((r) => r.by === 'me' && r.ms != null).map((r) => r.ms);
  const fastest = mine.length ? Math.min(...mine) : null;
  // A forfeit is a leave OR 30 s gone. The server does not say which, but a loser's phone knows when
  // it called leave itself (S6 review m7); otherwise it lost by being gone.
  let how = `You vs ${opponentName}`;
  if (result.reason === 'forfeit') {
    if (won) how = `${opponentName} forfeited the duel`;
    else how = result.left ? 'You left the duel' : 'You were gone over 30 s';
  }
  let stars = null;
  if (won && result.stars > 0) stars = `+${result.stars} ★`;
  else if (won && result.stars === 0) stars = 'No ★ this time (daily duel limit, or no round played)';
  const rematch = async () => {
    if (!onRematch || busy) return;
    setBusy(true);
    const why = await onRematch();
    setBusy(false);
    if (why) setError(why);
  };
  return (
    <div data-testid="live-duel-result" data-winner={result.winner} data-reason={result.reason}
      className="mx-auto w-full max-w-md rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white" style={{ boxShadow: '0 0 40px -14px #a855f7' }}>
      <div className="text-[10px] font-bold uppercase tracking-[0.3em] text-violet-300/80">Live duel</div>
      <div className={`mt-1 text-3xl font-black ${won ? 'text-emerald-300' : 'text-rose-300'}`}>
        {won ? 'Victory' : `${opponentName} wins`}
      </div>
      <div data-testid="live-duel-final-score" className="mt-2 text-4xl font-black tabular-nums">
        {score.me} <span className="text-slate-500">–</span> {score.cpu}
      </div>
      <div className="mt-1 text-xs text-slate-400">{how}</div>
      {stars && <p data-testid="live-duel-stars" className="mt-3 text-lg font-black text-amber-200" style={{ textShadow: '0 0 8px #f59e0b' }}>{stars}</p>}
      {fastest != null && <p className="mt-2 text-sm text-slate-300">Your fastest round: <span data-testid="live-duel-fastest" className="tabular-nums">{formatDuelTime(fastest)}</span></p>}
      {error && <p data-testid="live-duel-rematch-error" className="mt-2 text-xs font-bold text-rose-300">{error}</p>}
      <div className="mt-5 space-y-2">
        {onRematch && <PrimaryButton testId="live-duel-rematch" tone="rose" onClick={rematch}>{busy ? 'SENDING…' : 'REMATCH'}</PrimaryButton>}
        <button type="button" data-testid="live-duel-orbit" onClick={onExit}
          className="w-full rounded-xl border border-cyan-300/60 bg-black/40 py-3 text-sm font-black tracking-widest text-cyan-100 active:scale-95">
          BACK TO ORBIT ↑
        </button>
      </div>
    </div>
  );
}
