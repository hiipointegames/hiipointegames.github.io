// A live duel on this phone, as a plain reducer (slice S6, 2026-10-20). The SERVER is the referee;
// this only follows what it says (replies, broadcasts, re-reads) and never decides a round.
//
//   loading ─loaded→ ad ─(ad closed → ready)→ waiting ─start→ countdown ─served→ round
//     round ─roundResult / roundVoid→ reveal ─next→ countdown (round n+1) … ─next→ result
//   any ─finished→ result (after the last reveal)        any ─cancelled→ over
//
// Every event can arrive twice (a broadcast AND a re-read AND the edge reply), so each is applied
// once: a round result is keyed by its round number, a finish by the duel being over.
// Pure: no timers, no I/O. useLiveDuel owns the clocks and the calls.

/** @typedef {'loading'|'ad'|'waiting'|'countdown'|'round'|'reveal'|'result'|'over'|'error'} LivePhase */

/** The round reveal on screen before the next 3-2-1 (the server gives 5 s between rounds). */
export const LIVE_REVEAL_MS = 2500;

const ms = (iso) => { const t = Date.parse(String(iso ?? '')); return Number.isFinite(t) ? t : null; };

export function initialLiveState(duelId, myId) {
  return {
    phase: /** @type {LivePhase} */ ('loading'),
    duelId,
    myId,
    role: /** @type {'challenger'|'opponent'|null} */ (null),
    theirId: null,
    style: 'easy',
    firstTo: 3,
    offset: 0, // server ms − local ms
    n: 0,
    startsAt: null, // SERVER ms of the next round's start
    board: null, // { dice, colors, style, clockStarted }
    servedAt: null, // local ms my dice arrived
    submitting: false,
    sent: false, // a correct answer is with the referee
    note: null,
    score: { me: 0, cpu: 0 },
    last: null,
    history: [],
    result: null, // { winner: 'me'|'cpu', reason, stars, left } — left: THIS phone called leave
    over: null, // why the duel never got going (cancelled / declined / expired / …)
    notReady: /** @type {'me'|'them'|null} */ (null), // a ready_timeout: who missed the start
    opponentLastSeen: null,
    roundOver: false, // the round's result says the match is over: wait for the finish
  };
}

const scoresFrom = (s, row) => {
  const ch = Number(row?.challenger_score ?? 0);
  const op = Number(row?.opponent_score ?? 0);
  return s.role === 'challenger' ? { me: ch, cpu: op } : { me: op, cpu: ch };
};

const winnerSide = (s, winnerId) => (winnerId == null ? null : winnerId === s.myId ? 'me' : 'cpu');

const withOffset = (s, serverNow, now) => {
  const t = ms(serverNow);
  return t == null || !Number.isFinite(now) ? s : { ...s, offset: t - now };
};

const resultFromRow = (s, row, stars = null) => ({
  winner: winnerSide(s, row.winner_id) ?? 'cpu',
  reason: row.end_reason ?? row.status,
  stars,
});

/** Who missed the ready window: 'me' | 'them' | null (unknown), from a row or a lifecycle reply. */
function notReadyFrom(s, row) {
  const ch = row.challenger_ready ?? (row.challenger_ready_at === undefined ? undefined : row.challenger_ready_at != null);
  const op = row.opponent_ready ?? (row.opponent_ready_at === undefined ? undefined : row.opponent_ready_at != null);
  if (ch === undefined || op === undefined) return null;
  const mine = s.role === 'challenger' ? ch : op;
  const theirs = s.role === 'challenger' ? op : ch;
  if (!mine) return 'me';
  if (!theirs) return 'them';
  return null;
}

/** The duel row (a read or a lifecycle reply) → the state it implies. */
function fromDuelRow(s, row, now) {
  if (!row) return s;
  const status = row.status;
  if (status === 'finished' || status === 'forfeited') {
    if (s.result) return s;
    const result = resultFromRow(s, row);
    // A finished match whose last round is still to be shown: let the reveal finish first.
    return s.phase === 'reveal' ? { ...s, result } : { ...s, phase: 'result', result };
  }
  if (['cancelled', 'declined', 'expired', 'abandoned'].includes(status)) {
    if (s.result || s.phase === 'result') return s;
    return { ...s, phase: 'over', over: row.end_reason || status, notReady: notReadyFrom(s, row) ?? s.notReady };
  }
  if (status === 'live' && (s.phase === 'waiting' || s.phase === 'loading' || s.phase === 'ad')) {
    if (s.phase === 'ad') return s; // my ad is still on: the start is picked up after it closes
    const round = Math.max(1, Number(row.round) || 1);
    const startsAt = round === 1 ? ms(row.starts_at) : null;
    return { ...s, phase: 'countdown', n: round, startsAt: startsAt ?? (now + s.offset), board: null };
  }
  return s;
}

/**
 * @param {ReturnType<typeof initialLiveState>} s
 * @param {{ type: string, [k: string]: any }} a
 */
export function liveDuelReducer(s, a) {
  switch (a.type) {
    case 'loaded': {
      const row = a.duel;
      if (!row) return { ...s, phase: 'error', note: 'That duel was not found.' };
      const role = row.challenger_id === s.myId ? 'challenger' : 'opponent';
      const base = {
        ...s,
        role,
        theirId: role === 'challenger' ? row.opponent_id : row.challenger_id,
        style: row.style,
        firstTo: Number(row.first_to) || 3,
      };
      const scored = { ...base, score: scoresFrom(base, row) };
      if (row.status === 'accepted') {
        const mineReady = role === 'challenger' ? row.challenger_ready_at : row.opponent_ready_at;
        return { ...scored, phase: mineReady ? 'waiting' : 'ad' };
      }
      if (row.status === 'live') return fromDuelRow({ ...scored, phase: 'waiting' }, row, a.now);
      if (row.status === 'invited') return { ...scored, phase: 'over', over: 'not_accepted' };
      return fromDuelRow(scored, row, a.now);
    }
    case 'adClosed':
      return s.phase === 'ad' ? { ...s, phase: 'waiting' } : s;
    case 'lifecycle': {
      // ready / here / claim / leave replies: { ok, status, server_now, starts_at, *_last_seen, … }
      const r = a.reply || {};
      let next = withOffset(s, r.server_now, a.now);
      const lastSeen = s.role === 'challenger' ? r.opponent_last_seen : r.challenger_last_seen;
      if (lastSeen) next = { ...next, opponentLastSeen: lastSeen };
      if (r.status === 'finished' || r.status === 'forfeited') {
        if (next.result) return next;
        const result = resultFromRow(next, r, r.stars ?? null);
        return next.phase === 'reveal' ? { ...next, result } : { ...next, phase: 'result', result };
      }
      if (r.status === 'live' && next.phase === 'waiting') {
        return { ...next, phase: 'countdown', n: 1, startsAt: ms(r.starts_at) ?? (a.now + next.offset), board: null };
      }
      return fromDuelRow(next, r.status ? { ...r, round: undefined } : null, a.now);
    }
    case 'duelRow':
      return fromDuelRow(withOffset(s, a.serverNow, a.now), a.duel, a.now);
    case 'start': {
      // duel_start broadcast { starts_at, server_now }
      if (s.phase !== 'waiting') return s;
      const next = withOffset(s, a.payload?.server_now, a.now);
      return { ...next, phase: 'countdown', n: 1, startsAt: ms(a.payload?.starts_at) ?? (a.now + next.offset), board: null };
    }
    case 'served': {
      const r = a.reply || {};
      // A round that already closed (a resume, a lost broadcast) is picked up by the re-read instead.
      if (s.phase !== 'countdown' || r.ok !== true || Number(r.n) !== s.n || r.closed_at) return s;
      const next = withOffset(s, r.server_now, a.now);
      return {
        ...next,
        phase: 'round',
        board: { dice: r.dice, colors: r.colors, style: r.style, clockStarted: r.clock_started !== false },
        servedAt: a.now,
        submitting: false,
        sent: false,
        note: r.clock_started === false ? 'Your opponent already answered this one.' : null,
      };
    }
    case 'submitting':
      return s.phase === 'round' ? { ...s, submitting: true, note: null } : s;
    case 'submitted': {
      if (s.phase !== 'round') return s;
      return { ...s, submitting: false, sent: Boolean(a.sent), note: a.note ?? null };
    }
    case 'note':
      return { ...s, note: a.note ?? null };
    case 'roundResult': {
      const p = a.payload || {};
      const n = Number(p.n);
      if (!Number.isFinite(n) || n < s.n || (s.last && s.last.round >= n && s.phase !== 'round')) return s;
      if (s.history.some((h) => h.round === n)) return s;
      if (p.outcome !== 'won' && p.outcome !== 'void') return s;
      const by = p.outcome === 'void' ? null : winnerSide(s, p.winner_id);
      const usedIndices = by === 'me' && a.myAnswer?.equation === p.winning_equation ? a.myAnswer.usedIndices : null;
      const last = {
        round: n,
        by,
        equation: p.winning_equation ?? null,
        usedIndices,
        ms: p.winner_duration_ms ?? null,
      };
      const hasScores = p.challenger_score != null || p.opponent_score != null;
      return {
        ...s,
        phase: 'reveal',
        n,
        last,
        history: [...s.history, last],
        score: hasScores ? scoresFrom(s, p) : s.score,
        startsAt: ms(p.next_starts_at),
        roundOver: p.finished === true || (p.status && p.status !== 'live'),
        submitting: false,
        sent: false,
        note: null,
      };
    }
    case 'next': {
      if (s.phase !== 'reveal') return s;
      if (s.result) return { ...s, phase: 'result', board: null };
      if (s.roundOver || s.startsAt == null) return { ...s, board: null }; // wait for the finish
      return { ...s, phase: 'countdown', n: s.n + 1, board: null };
    }
    case 'finished': {
      // duel_finished broadcast / a claim or leave reply: { winner_id, end_reason, status, stars, scores }
      const p = a.payload || {};
      if (s.result && s.result.stars != null && !a.force) return s;
      const result = {
        winner: winnerSide(s, p.winner_id) ?? 'cpu',
        reason: p.end_reason ?? p.status ?? 'won',
        stars: p.stars ?? s.result?.stars ?? null,
        // This phone called leave (a later broadcast of the same finish keeps it): the card says
        // "You left the duel" rather than "gone over 30 s" (S6 review m7).
        left: Boolean(a.left || s.result?.left),
      };
      const hasScores = p.challenger_score != null || p.opponent_score != null;
      const score = hasScores ? scoresFrom(s, p) : s.score;
      // A win on points: the last round's reveal comes first (its result may still be on its way).
      if (s.phase === 'reveal' || (s.phase === 'round' && result.reason === 'won' && !a.force)) {
        return { ...s, result, score };
      }
      return { ...s, phase: 'result', result, score, board: null };
    }
    case 'stars':
      return s.result ? { ...s, result: { ...s.result, stars: a.stars } } : s;
    case 'cancelled':
      if (s.phase === 'result' || s.result) return s;
      return { ...s, phase: 'over', over: a.reason || 'cancelled' };
    case 'error':
      return { ...s, phase: 'error', note: a.note ?? 'Something went wrong.' };
    default:
      return s;
  }
}
