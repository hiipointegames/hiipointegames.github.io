import React, { useEffect, useMemo, useRef, useState } from 'react';
import { Globe, Lock } from 'lucide-react';
import { DiceLoader } from '@/dice-visuals';
import { apiClient } from '@/transport';
import { getLeaderboard } from '@/stats-aggregation';
import { hasPerfectConcept, requiresPerfectSolve } from '@/game-modes';
import { canViewerSeeToday, todayET } from '@/daily-challenge';
import { boardParticipation } from './boardParticipation';
import { isPerfectSolve } from '@/equation-engine';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';
import { formatSolveTime, playSound } from '@/ui/feedback';
import LeaderboardRow from './LeaderboardRow';
import RevealedEquation from './RevealedEquation';
import DailyPuzzleDisplay from './DailyPuzzleDisplay';
import { formatBoardDate } from './boardDate';
import { DEFAULT_DAILY_MODE, dailyModeLabel } from './dailyModeTabs';
import { dailyModeAccent } from './modeAccent';
import { splitBoardForDisplay } from './boardTop100';
import { scrollIntoOwnContainer, flashRing } from '@/shell';
import PinnedSelfRow from './PinnedSelfRow';
import { reportedFallback } from '@/observability';
import { rowDisplayName, isLinkableRow } from './guestName';

// The board's accent is the SELECTED TIER's colour, not this board's own.
//
// It used to be a module constant — Global cyan, Friends green, Equations
// magenta, National violet — so the four boards were tellable apart at a glance
// and the three Dailies were not. David reversed that on 2026-08-31 ("tier
// colours win; the per-board colour language gives way") once Challenge moved
// onto cyan and every board started wearing Challenge's colour whatever tier it
// was showing. The board's own identity is carried by its icon and heading, which
// it already had. See modeAccent.js.

// A player is linkable to their public profile when they have a real username
// (the DailyChallengeTime row denormalizes user_name; guests are "Guest…").
// One rule for every board (case-insensitive, like the server) — @/leaderboard guestName.
const isLinkable = (entry) => isLinkableRow(entry);

// Prefer the server's verdict when the row carries one.
//
// `daily-board` withholds equation/usedDiceIndices/diceColors from a viewer who
// has not played today, so deriving "perfect" client-side returns FALSE for every
// row on a locked board — silently, and indistinguishably from "nobody solved it
// perfectly". The server therefore ships `is_perfect_solve` on every row it
// serves, including locked ones: the verdict is not an answer, the working is.
// The client derivation stays as the fallback for the legacy direct read, which
// still carries the solution columns.
const perfect = (entry) =>
  typeof entry?.is_perfect_solve === 'boolean'
    ? entry.is_perfect_solve
    : isPerfectSolve(entry.equation, entry.usedDiceIndices, entry.diceColors);

// Global tab — today's daily-challenge board for EVERYONE who completed it,
// fastest first. Anti-peek: a viewer who hasn't finished today (the
// canViewerSeeToday gate) still sees names + times + the daily average, but NOT
// the dice puzzle / winning equation. Username click → that player's public
// profile. Pure read of today's leaderboard — CapGo-clean.
export default function GlobalTab({ focusUserId = null, date = todayET(), mode = DEFAULT_DAILY_MODE }) {
  // F1 — WHERE THE GOLD OUTLINE RENDERS, decided once and asked as a question
  // rather than hard-coded as a mode list. `hasPerfectConcept` is false exactly
  // where a perfect solve is ARITHMETICALLY UNREACHABLE: Easy deals no coloured
  // dice, so `correctCount === 3` can never be true and a gold ring there would
  // be a permanently-unwinnable badge. It is true for Challenge and Expert.
  //
  // Expert is all-perfect by rule, so the outline marks nothing there — that is
  // accepted, and it is why the separate Perfect Solves board was removed (F2)
  // rather than kept and made per-mode. The alternative, special-casing Expert
  // out, would mean this file carrying a mode list that SuccessModal would have
  // to carry a second copy of; the seam says both sides ask the same predicate
  // and neither enumerates modes.
  const showPerfect = hasPerfectConcept(mode);

  // WHETHER THE PERFECT-SOLVE COUNTER SAYS ANYTHING (David, 2026-09-03).
  //
  // The gold OUTLINE and the COUNTER answer different questions, which is why
  // they no longer share `showPerfect`. The outline asks "could this row have
  // been perfect?" — true on Challenge and Expert. The counter asks "how many of
  // these solves were perfect?", and that is only informative where a perfect
  // solve is possible but NOT guaranteed. Expert `requiresPerfectSolve`, so its
  // counter could only ever restate the completed count: "3 completed · 3 perfect
  // solves" is one fact printed twice.
  //
  // Asked as a predicate rather than a mode list, per this file's existing seam
  // rule — a fourth tier gets the right behaviour without editing this line.
  const perfectCountIsInformative = showPerfect && !requiresPerfectSolve(mode);
  const accent = dailyModeAccent(mode);
  // Hoisted above the early returns below: the empty state needs both, and they
  // are pure functions of props — nothing about them wants to sit after a fetch.
  const isToday = date === todayET();
  const dateLabel = formatBoardDate(date);
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [locked, setLocked] = useState(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  const [selectedId, setSelectedId] = useState(null);
  // This date+mode's attempt rows — the denominator of the completion rate.
  // Fetched alongside the board; see the participation line below.
  // null until the read lands, and null again if it fails — see
  // boardParticipation for why that is not the same as an empty array.
  const [attempts, setAttempts] = useState(null);
  // The participation line. Pure arithmetic over data already in hand — see
  // boardParticipation.js for why the two percentages use different
  // denominators, which is the part most likely to look like a bug and be
  // "fixed" into one.
  const participation = boardParticipation({ attempts, rows, viewerId: currentUserId });

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true);
      try {
        const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.global.me'));
        // No forfeit fetch here: the Global leaderboard shows ONLY solvers
        // (July-2 prompt list item 8). Forfeit/DNF data is still tracked and
        // still shown on the Friends tab; the global board just doesn't surface
        // it. The ranked rows already excluded forfeiters — this drops the DNF
        // footer that used to sit under the board.
        // The day's dice roll is no longer fetched here — DailyPuzzleDisplay
        // owns that (and its own copy of this gate) for every Daily sub-tab.
        const [board, canSee, attemptRows] = await Promise.all([
          getLeaderboard({ date, mode, enrichProfiles: true }),
          // Per mode: finishing Easy must not unlock Challenge's or Expert's
          // answers for the day.
          canViewerSeeToday(user, date, mode),
          // The participation line's denominator: everyone who STARTED this
          // Daily, finishers included (David, 2026-09-12: "all starters please
          // so the percentage makes sense visually").
          //
          // Reads `daily_challenge_attempts`, whose single RLS policy is
          // `dca_read_authenticated | SELECT` — any signed-in viewer, guests
          // included, can count the day.
          //
          // ─────────────────────────────────────────────────────────────────
          // THE ONE READ ON THIS SCREEN THAT SCALES WITH THE PLAYER BASE,
          // so it is deliberately the narrowest it can be:
          //
          //   • ONE COLUMN. `DailyAttemptParticipant` selects `user_id` alone,
          //     not the `select('*')` the general attempt client uses. A uuid
          //     per starter instead of a whole row — and it stops every board
          //     view from pulling every player's `created_at`, the referee
          //     clock the anti-cheat gate measures solves against.
          //
          //   • MODE FILTERED ON THE SERVER, not in the browser. Safe because
          //     `mode` is `not null default 'daily'` (20260824030000), so every
          //     legacy Challenge row was backfilled to exactly the value
          //     `rowModeKey` would have mapped it to — the two agree by
          //     construction. Cuts the rows ~3x AND lets the
          //     (date, user_id, mode) index serve it instead of a scan.
          //
          // Scale ceiling, stated rather than assumed: one uuid (~36 B) per
          // starter per board view. At a few hundred players a day that is
          // single-digit KB. If a Daily ever draws tens of thousands, swap this
          // for a server-side `count` or an RPC returning the distinct count —
          // do NOT reach for a `limit`, which would silently under-count and
          // print a wrong percentage, which is worse than a slow one.
          //
          // ALLOWED TO FAIL ON ITS OWN. A board that renders without its
          // participation line beats a board that does not render.
          //
          // ⚠️ ASYNC IIFE, NOT A TRAILING .catch(). A bare
          // `entities.X.filter(…).catch(…)` attaches its handler only AFTER
          // `.filter()` returns, so a SYNCHRONOUS throw — an entity that is not
          // there — escapes into Promise.all and kills the whole board. Not
          // hypothetical: it blanked every row in this file's suite the first
          // time it was written that way, while the comment above it claimed
          // the read was allowed to fail on its own.
          (async () => {
            try {
              return await apiClient.entities.DailyAttemptParticipant.filter({ date, mode });
            } catch {
              // null, NOT [] — "we could not ask" rather than "nobody started".
              // An empty array would render a fabricated 100% completion rate.
              return null;
            }
          })(),
        ]);
        if (cancelled) return;
        setCurrentUserId(user?.id ?? null);
        setRows(board);
        setAttempts(attemptRows);
        // Anti-peek applies only to TODAY; past days are always visible
        // (canViewerSeeToday gates only today — see viewerGate.js).
        setLocked(date === todayET() ? !canSee : false);
      } catch (error) {
        console.error('Failed to load global leaderboard:', error);
        if (!cancelled) { setRows([]); setAttempts(null); }
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, [date, mode]);

  // Deep-link focus (item 10): when arrived via a podium-trophy tap
  // (?tab=daily&focus=<id>), scroll that player's row into view once the board
  // has loaded and flash a brief gold ring. The scroll is scoped to the board's
  // own scroller (scrollIntoOwnContainer, @/shell) so it never scrolls the page/#root —
  // preserving the top status-bar inset. WAAPI is guarded so older webviews just
  // no-op the flash (the scroll alone still helps).
  // The row is looked up inside THIS board's root (not the whole document), so
  // a second board mounted elsewhere — e.g. a hidden screen kept under an
  // in-world stack — can never be the one that scrolls.
  const rootRef = useRef(/** @type {HTMLDivElement | null} */ (null));
  useEffect(() => {
    if (loading || !focusUserId) return;
    const el = rootRef.current?.querySelector(`[data-testid="leaderboard-row"][data-user-id="${focusUserId}"]`);
    if (!(el instanceof HTMLElement)) return;
    scrollIntoOwnContainer(el);
    flashRing(el);
  }, [loading, focusUserId]);

  // Top 100, with the viewer pinned below the window when they placed outside it
  // (David, 2026-08-24). The average and the perfect count above stay computed
  // over the WHOLE board — capping the DISPLAY must not silently cap the stats,
  // or "Global Average" would quietly become "average of the top 100".
  const { visible, pinnedSelf } = useMemo(
    () => splitBoardForDisplay(rows, currentUserId),
    [rows, currentUserId],
  );

  const { average, perfectCount } = useMemo(() => {
    if (rows.length === 0) return { average: 0, perfectCount: 0 };
    const total = rows.reduce((s, e) => s + (e.solve_time_seconds || 0), 0);
    return {
      average: total / rows.length,
      perfectCount: perfectCountIsInformative ? rows.filter(perfect).length : 0,
    };
  }, [rows, perfectCountIsInformative]);

  if (loading) {
    return (
      <div className="flex items-center justify-center py-16">
        <DiceLoader size={44} />
      </div>
    );
  }

  if (rows.length === 0) {
    return (
      <div className="space-y-3">
        <DailyPuzzleDisplay date={date} mode={mode} />
        {/* The empty state has to name WHICH Daily and WHICH day. This sentence
            was "No one has completed today's daily challenge yet" for every mode
            and every date — so an empty Expert board from three weeks ago told
            the player that nobody had done today's Challenge, and invited them to
            go and be the first at a puzzle that closed weeks ago. Both halves
            were wrong at once. */}
        <div className="text-center py-16 text-slate-400">
          <Globe className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: accent }} />
          {isToday ? (
            <>
              <p>No one has completed today&apos;s {dailyModeLabel(mode)} Daily yet.</p>
              <p className="text-xs mt-1">Be the first to set the time to beat.</p>
            </>
          ) : (
            // No "be the first" on a closed day — that board can never be joined.
            <p>No one completed the {dailyModeLabel(mode)} Daily on {dateLabel}.</p>
          )}
        </div>
      </div>
    );
  }

  const fastest = rows[0];
  const normalizedEq = fastest.equation
    ? fastest.equation.replace(/×/g, '*').replace(/−/g, '-').replace(/÷/g, '/').replace(/＋/g, '+')
    : null;
  const fastestIsPerfect = showPerfect && perfect(fastest);
  const GOLD = 'var(--u37-gold)';
  const Divider = <div className="h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" />;

  return (
    <div className="space-y-3" ref={rootRef}>
      {/* 1C-2: stats block — global average time + participation (always visible).
          The date is folded into this heading ("Global Average for Fri, 7/10");
          the old standalone "…'s Dice Roll: N dice" line was removed (C). */}
      <div className="rounded-2xl p-4 border border-white/10 bg-white/[0.04] text-center">
        <div className="text-xs font-bold uppercase tracking-wider text-slate-300 mb-1 flex items-center justify-center gap-2">
          <Globe className="w-4 h-4" style={{ color: accent }} /> Global Average for {dateLabel}
        </div>
        <div className="text-3xl font-black text-slate-100">{formatSolveTime(average)}</div>
        <div className="text-[10px] uppercase tracking-widest text-slate-500 mt-0.5">Average time</div>
        {/* THREE LINES, NOT ONE (David, 2026-09-17). These are three different
            kinds of statement — the board's facts, the gold perfect-solve count,
            and the viewer's own standing — and packed onto one line with " · "
            separators at 360px they read as mush, with the gold phrase wrapping
            mid-sentence. One line each. `text-slate-100` rather than 300: the
            ratio was already AAA on this near-black card, but 12px semibold grey
            is perceptually dim regardless of what the ratio says, and David
            reported it as hard to see on a phone. */}
        <div className="text-xs font-semibold mt-1 text-slate-100" data-testid="board-stats-line">
          <div>
            {/* On Expert the gold does not vanish with the counter — it MOVES to the
                completed count, the one number left that still says something. The
                tier accent for Expert IS gold, so this reads as the board wearing
                its tier colour rather than as a one-off. David ruled the collision
                with the perfect-streak indicators fine and intended. */}
            <span
              data-testid="completed-count"
              style={requiresPerfectSolve(mode) ? { color: GOLD } : undefined}
            >
              {rows.length} completed
            </span>
            {/* Participation (David, 2026-09-12): how many started, and what share
                of them finished. A line of text rather than a stat box — he was
                explicit that it should not become another of the big cards.

                "% completion", not "% completed" (David, 2026-09-17) — the
                neighbouring "N completed" is a COUNT OF PEOPLE, so "40% completed"
                read as a second, contradictory count of the same thing rather than
                as a rate.

                Absent when nobody has started: "0 attempted · 0 completed · 0%"
                is three ways of saying the board is empty, which the empty state
                above already says once. */}
            {participation.completionPercent !== null && (
              <span data-testid="participation-rate">
                {' · '}{participation.attempted} attempted
                {' · '}{participation.completionPercent}% completion
              </span>
            )}
          </div>
          {/* Its own line, and `whitespace-nowrap` so it never breaks between the
              number and the noun — "3 perfect" / "solves" across two lines is the
              specific thing David saw. Stays gold.

              Absent on Easy, which has no perfect-solve concept at all, and on
              Expert, where every solve is perfect by rule. */}
          {perfectCountIsInformative && (
            <div
              className="mt-0.5 whitespace-nowrap"
              style={{ color: GOLD }}
              data-testid="perfect-solve-count"
            >
              {perfectCount} perfect solve{perfectCount !== 1 ? 's' : ''}
            </div>
          )}
          {/* The viewer's own standing, among the other FINISHERS — a different
              denominator from the rate above, deliberately. Its own row so the
              board's facts and the player's fact do not read as one run-on
              sentence.

              Absent for a viewer who did not finish, and for the only finisher
              on a board ("beat 100% of nobody" says nothing). 0% for last place
              is kept on purpose — David's call. */}
          {participation.beat !== null && (
            <div className="mt-0.5" style={{ color: accent }} data-testid="viewer-standing">
              You beat {participation.beat}% of solvers
            </div>
          )}
        </div>
      </div>

      {/* 1C-3: divider */}
      {Divider}

      {/* The day's dice roll — heading + dice. This block used to live inline
          here (heading) and inside the fastest card (dice); it is now the shared
          DailyPuzzleDisplay every Daily sub-tab renders, so the puzzle looks and
          gates the same everywhere (David, 1.0.292). It carries its own
          canViewerSeeToday gate and renders NOTHING while locked, which is why
          there is no `!locked &&` here. */}
      <DailyPuzzleDisplay date={date} mode={mode} />

      {/* 1C-4: featured fastest player — gold outline when it was a perfect solve.
          Anti-peek: locked viewers see the lock note instead of the equation. */}
      {locked ? (
        <div className="rounded-2xl p-5 border border-white/10 bg-white/[0.04] text-center">
          <Lock className="w-7 h-7 mx-auto mb-2" style={{ color: accent }} />
          <div className="font-bold text-slate-200">Complete today's challenge to reveal the puzzle</div>
          <div className="text-xs text-slate-400 mt-1">
            You can still see who finished and how fast — just not the winning equation yet.
          </div>
        </div>
      ) : (
        // The featured card's tint was a hard-coded cyan — the tailwind gradient
        // AND rgba(34,211,238,0.30) — so on an Expert or Easy board the one card
        // a player looks at first was still painted in Challenge's colour. It
        // now tints from the tier like everything else. The gradient moved
        // inline because a tailwind class cannot take a runtime accent (and
        // tailwind colour names are invisible to a token grep, which is how this
        // one survived the 08-31 sweep).
        <div
          className="rounded-2xl p-4 border"
          style={fastestIsPerfect
            ? {
                borderColor: GOLD,
                boxShadow: `0 0 22px -8px ${GOLD}, inset 0 0 22px -16px ${GOLD}`,
                backgroundImage: `linear-gradient(to bottom right, color-mix(in srgb, ${accent} 10%, transparent), transparent)`,
              }
            : {
                borderColor: `color-mix(in srgb, ${accent} 30%, transparent)`,
                backgroundImage: `linear-gradient(to bottom right, color-mix(in srgb, ${accent} 10%, transparent), transparent)`,
              }}
        >
          {/* The dice row moved OUT of this card into DailyPuzzleDisplay above —
              the roll is the day's, not this player's, and every sub-tab now
              shows it in the same place. What stays here is what IS specific to
              the fastest solver: their name and their winning equation. */}
          <div className="text-xs font-semibold text-amber-300 text-center mb-2">🏆 Fastest: {fastest.user_name}</div>
          {normalizedEq && fastest.diceColors && fastest.usedDiceIndices ? (
            <div className="text-center text-lg font-bold">
              <SolvedEquation
                equation={normalizedEq}
                usedIndices={fastest.usedDiceIndices}
                colors={fastest.diceColors}
                highlightAllWhenPerfect
              />
              <span className="text-slate-200"> = </span>
              <Target37 className="font-black" />
            </div>
          ) : (
            <div className="text-center text-xs text-slate-400">Fastest time: {formatSolveTime(fastest.solve_time_seconds)}</div>
          )}
        </div>
      )}

      {/* 1C-5: legend — gold outline marks a perfect solve. F1: absent in Easy,
          where there are no Power Dice for the sentence to be about. */}
      {showPerfect && (
        <div className="flex items-center justify-center gap-2 text-xs text-slate-300">
          <span className="inline-block w-3.5 h-3.5 rounded border-2 flex-shrink-0" style={{ borderColor: GOLD, boxShadow: `0 0 6px ${GOLD}` }} />
          <span>= Perfect Solve (all 3 Power Dice used correctly)</span>
        </div>
      )}

      {/* 1C-6: divider */}
      {Divider}

      {/* 1C-7: ranked board — names + times (always visible). When unlocked, tapping a
          name reveals that player's winning equation inline; a Profile pill always
          links to their public profile. Same anti-peek gate as the dice block. */}
      <div className="space-y-2">
        {!locked && (
          <div className="text-center text-xs text-slate-400 italic">Tap a name to reveal their solution.</div>
        )}
        {visible.map((entry, i) => {
          const linkable = isLinkable(entry);
          const isSelf = entry.user_id === currentUserId;
          return (
            <LeaderboardRow
              key={entry.id}
              rank={i + 1}
              userId={entry.user_id}
              name={rowDisplayName(entry)}
              country={entry.user_country}
              puzzlePoints={entry.puzzle_points}
              battlePoints={entry.battle_points}
              value={formatSolveTime(entry.solve_time_seconds)}
              isCurrentUser={isSelf}
              perfect={showPerfect && perfect(entry)}
              warp={entry.warp === true}
              accent={accent}
              onNameClick={
                locked
                  ? undefined
                  : () => {
                      playSound('buttonTap');
                      setSelectedId((id) => (id === entry.user_id ? null : entry.user_id));
                    }
              }
              profileTo={
                !isSelf && linkable
                  ? { screen: 'profile', id: entry.user_id, returnTo: 'Leaderboard' }
                  : undefined
              }
            >
              {!locked && selectedId === entry.user_id && (
                <div className="rounded-xl bg-black/30 border border-white/10 p-3 text-center">
                  <RevealedEquation entry={entry} />
                </div>
              )}
            </LeaderboardRow>
          );
        })}

        {/* The pinned self row. Present when the viewer placed BELOW THE FOLD —
            outside the ~10 rows on screen without scrolling, NOT outside the
            rendered 100 (boardTop100.js). At production's scale that fires from
            rank 11 on a 13-player board, so this is live behaviour now rather
            than scaffolding. It shows their TRUE rank, never a manufactured one. */}
        {pinnedSelf && (
          <PinnedSelfRow>
            <LeaderboardRow
              rank={pinnedSelf.rank}
              userId={pinnedSelf.entry.user_id}
              name={rowDisplayName(pinnedSelf.entry)}
              country={pinnedSelf.entry.user_country}
              puzzlePoints={pinnedSelf.entry.puzzle_points}
              battlePoints={pinnedSelf.entry.battle_points}
              value={formatSolveTime(pinnedSelf.entry.solve_time_seconds)}
              isCurrentUser
              perfect={showPerfect && perfect(pinnedSelf.entry)}
              warp={pinnedSelf.entry.warp === true}
              accent={accent}
            />
          </PinnedSelfRow>
        )}
      </div>
    </div>
  );
}
