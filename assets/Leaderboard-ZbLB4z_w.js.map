import React, { Suspense, lazy } from 'react';
import { useLocation, useSearchParams } from 'react-router-dom';
// Imported BY PATH, not through @/info-screens: that barrel exports lazy()
// screens for in-world hosts, and the route is already lazy in pages.config.js.
import LeaderboardScreen from '@/info-screens/LeaderboardScreen';

// Sector 73's Observatory adds game tabs around this page (world lane 2026-10-22). Lazy, and only for a
// visit Sector 73 opened (route state from73), so the normal page and its bundle are unchanged.
const Sector73Leaderboards = lazy(() => import('@/sector73/boards/Sector73Leaderboards'));

// The /Leaderboard route — reads the URL and hands it to the router-free screen.
//   ?tab=<daily|pieces|battle>  starting category (e.g. ?tab=battle from the Colosseum)
//   ?focus=<userId>             podium-trophy deep link into the Daily→Global board
// Validation (unknown tab → Daily) lives in the screen, so every host gets it.
export default function Leaderboard() {
  const [searchParams] = useSearchParams();
  const location = useLocation();
  const screen = <LeaderboardScreen tab={searchParams.get('tab')} focus={searchParams.get('focus')} />;
  if (location.state?.from73 !== true) return screen;
  return (
    <Suspense fallback={screen}>
      <Sector73Leaderboards>{screen}</Sector73Leaderboards>
    </Suspense>
  );
}
