// National-average daily leaderboard read (Feature D1).
//
// "For the selected day, how did each country do?" — a per-country breakdown of
// the daily challenge: average completion time + how many players from that
// country completed it, ordered fastest-average first. Aggregate + anonymous (no
// individual rows) so it's safe to be fully public.
//
// F3 ↔ B CONTRACT — LOCKED 2026-07-26 (coordinator):
//   getNationalAverages({ date: 'YYYY-MM-DD' })
//     -> [{ countryCode: string, avgSolveTimeSeconds: number, playerCount: number }]
//        ordered fastest-avg first.
//   • countryCode — lowercase ISO 3166-1 alpha-2 (matches profiles.country + the
//     country picker in components/profile/countries.js, e.g. 'us', 'gb').
//   • avgSolveTimeSeconds — seconds (float), same unit as solve_time_seconds.
//   • playerCount — number of COMPLETIONS from that country that day (forfeits/DNF
//     excluded; getLeaderboard already excludes forfeiters). Players with NO
//     country set are EXCLUDED (unattributable) — the tab notes this coverage caveat.
//
//   Lane B's live source:
//     supabase.rpc('get_national_averages', { p_date })
//       -> rows { country_code, avg_solve_time_seconds, player_count }
//     mapped by mapNationalAverageRows() to the camelCase shape above.
//
// LIVE as of 2026-07-30: getNationalAverages now delegates to the server RPC
// (getNationalAveragesViaRpc below) — the RPC was deployed to prod + verified
// that day. The earlier CLIENT-SIDE derivation (getLeaderboard +
// aggregateNationalAverages) is retired as the default. aggregateNationalAverages
// is kept — it's exported + independently tested, and a future server path could
// reuse the exact same grouping if it ever post-processes rows client-side.

import { apiClient } from '@/transport';

// Pure aggregator: a day's leaderboard rows → per-country average + count.
// Only rows that carry a country AND a finite solve time contribute (a completion
// without a country can't be attributed; a row without a time isn't a completion).
// Exported for direct unit testing and so a future server path can reuse the exact
// same grouping if it ever post-processes rows client-side.
export function aggregateNationalAverages(rows) {
  const byCountry = new Map();
  for (const row of Array.isArray(rows) ? rows : []) {
    const raw = row?.user_country;
    const time = row?.solve_time_seconds;
    if (!raw || typeof time !== 'number' || !Number.isFinite(time)) continue;
    // Normalize to lowercase alpha-2 so 'US' and 'us' bucket together and the
    // code matches countries.js + the flagcdn URL scheme (both lowercase).
    const code = String(raw).toLowerCase();
    const acc = byCountry.get(code) || { total: 0, count: 0 };
    acc.total += time;
    acc.count += 1;
    byCountry.set(code, acc);
  }

  return [...byCountry.entries()]
    .map(([countryCode, { total, count }]) => ({
      countryCode,
      avgSolveTimeSeconds: total / count,
      playerCount: count,
    }))
    // Fastest average first; ties broken by the larger cohort (a country with
    // more solvers at the same average ranks ahead) then by code for stability.
    .sort(
      (a, b) =>
        a.avgSolveTimeSeconds - b.avgSolveTimeSeconds ||
        b.playerCount - a.playerCount ||
        a.countryCode.localeCompare(b.countryCode),
    );
}

// Maps Lane B's locked RPC rows { country_code, avg_solve_time_seconds,
// player_count } to the camelCase contract shape. The RPC already excludes
// no-country players and orders fastest-avg first, but we filter + sort
// defensively so a shape drift on B's side can't leak a bad row or ordering.
export function mapNationalAverageRows(rows) {
  return (Array.isArray(rows) ? rows : [])
    .filter((r) => r?.country_code)
    .map((r) => ({
      countryCode: String(r.country_code).toLowerCase(),
      avgSolveTimeSeconds: Number(r.avg_solve_time_seconds),
      playerCount: Number(r.player_count),
    }))
    .sort(
      (a, b) =>
        a.avgSolveTimeSeconds - b.avgSolveTimeSeconds ||
        b.playerCount - a.playerCount ||
        a.countryCode.localeCompare(b.countryCode),
    );
}

/** Challenge's Daily — the legacy wire key. Mirrors leaderboard.js. */
export const DEFAULT_DAILY_MODE = 'daily';

/**
 * PostgREST's "no function matches that name and argument list" code.
 *
 * This is how the ABSENCE of the two-argument overload reports itself, and it is
 * the one error we must not treat as a failure — it means the migration has not
 * been applied yet, not that the call was wrong. Every other error still throws.
 */
const RPC_SIGNATURE_MISSING = 'PGRST202';

const isSignatureMissing = (error) =>
  error?.code === RPC_SIGNATURE_MISSING ||
  /could not find the function/i.test(String(error?.message || ''));

/**
 * The live server-side aggregation, per mode.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * A13 — WHY THIS HAS TWO CALL SHAPES AND A FALLBACK
 * ─────────────────────────────────────────────────────────────────────────────
 * `get_national_averages` is a DATABASE function, so making it mode-aware needs
 * a migration, and migrations are David's action — a lane never runs
 * `supabase db push`. This client therefore has to work on both sides of that
 * human step, and it must not lie in between.
 *
 * The two-argument overload is tried first. If it is not there yet:
 *
 *   - Challenge's Daily falls back to the one-argument version. That is EXACTLY
 *     today's behaviour and today's data: production has one puzzle per date, so
 *     "everyone who solved on this date" and "everyone who solved Challenge's
 *     Daily on this date" are the same set. No regression, no gap.
 *
 *   - Easy and Expert do NOT fall back. The one-argument version would hand back
 *     a country average computed over whatever modes exist on that date and this
 *     function would return it under a mode's name. Serving Challenge's numbers
 *     labelled "Expert" is worse than serving nothing, and it is the precise
 *     shape of mistake this project keeps logging: a value that is *available*
 *     mistaken for the value that was *asked for*. `unavailable` is returned so
 *     the board can say why.
 *
 * Once the migration is applied the fallback simply stops being reached.
 *
 * @param {{date: string, mode?: string}} args
 * @returns {Promise<Array<{countryCode: string, avgSolveTimeSeconds: number, playerCount: number}>>}
 * @throws {Error & {code?: string}} `national_averages_mode_unavailable` when the
 *   per-mode signature is missing and the caller asked for a non-legacy mode.
 */
export async function getNationalAveragesViaRpc({ date, mode = DEFAULT_DAILY_MODE }) {
  if (!date) {
    throw new Error('getNationalAveragesViaRpc requires a date');
  }
  const { data, error } = await apiClient.supabase.rpc('get_national_averages', {
    p_date: date,
    p_mode: mode,
  });
  if (!error) return mapNationalAverageRows(data);
  if (!isSignatureMissing(error)) throw error;

  console.warn(
    '[nationalAverages] get_national_averages(date, text) is not deployed; ' +
    'falling back to the date-only signature. Apply ' +
    '20260827120000_national_averages_per_mode.sql.',
  );
  if (mode !== DEFAULT_DAILY_MODE) {
    const err = /** @type {Error & {code: string}} */ (
      new Error(`National averages are not available for ${mode} yet.`)
    );
    err.code = 'national_averages_mode_unavailable';
    throw err;
  }
  const legacy = await apiClient.supabase.rpc('get_national_averages', { p_date: date });
  if (legacy.error) throw legacy.error;
  return mapNationalAverageRows(legacy.data);
}

// Returns the national-average breakdown for a given date and mode (see the
// contract above). Delegates to the live server RPC (getNationalAveragesViaRpc),
// which validates the date and maps the rows to the locked shape.
export async function getNationalAverages({ date, mode = DEFAULT_DAILY_MODE }) {
  return getNationalAveragesViaRpc({ date, mode });
}
