// ScreenLink — the link every info screen renders instead of a raw <Link>.
//
// It renders the SAME router <Link> the screen used to render, at the same URL
// (hrefFor), with the same props. The only addition: when a host is present and
// `host.open(target)` returns true, the click is stopped (preventDefault) so the
// router does not leave the page — the host has opened the screen in place.
//
// No host (the normal app) → identical to `<Link to={hrefFor(target)} …>`.

import React from 'react';
import { Link } from 'react-router-dom';
import { hrefFor } from './hrefFor';
import { useScreenLinksHost } from './ScreenLinksContext';

//
// A plain string target is a legacy URL (e.g. an old caller still passing
// LeaderboardRow `profileTo="/OtherProfile?id=…"`): it is rendered unchanged and
// the host is NOT asked (it can only read ScreenTargets), so it navigates exactly
// as it always did. Prefer a ScreenTarget object so a host can catch it.

/**
 * @param {{ target: import('./hrefFor').ScreenTarget | string, onClick?: (e: React.MouseEvent<HTMLAnchorElement>) => void } & Omit<React.ComponentProps<typeof Link>, 'to' | 'onClick' | 'target'>} props
 */
export default function ScreenLink({ target, onClick, ...linkProps }) {
  const host = useScreenLinksHost();
  const legacyUrl = typeof target === 'string';
  const handleClick = (e) => {
    // The caller's own handler first (e.g. the tap sound), exactly as before.
    onClick?.(e);
    if (!legacyUrl && host && host.open(target)) e.preventDefault();
  };
  return <Link to={legacyUrl ? target : hrefFor(target)} onClick={handleClick} {...linkProps} />;
}
