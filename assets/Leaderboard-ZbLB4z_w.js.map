import React, { useEffect, useMemo, useState } from 'react';
import { Users, Lock } from 'lucide-react';
import { DiceLoader } from '@/dice-visuals';
import { apiClient } from '@/transport';
import { getLeaderboard } from '@/stats-aggregation';
import { hasPerfectConcept } from '@/game-modes';
import { getFriendEdges, selectFriendIds } from '@/player';
import { canViewerSeeToday, todayET } from '@/daily-challenge';
import { isPerfectSolve } from '@/equation-engine';
import { formatSolveTime, playSound } from '@/ui/feedback';
import LeaderboardRow from './LeaderboardRow';
import RevealedEquation from './RevealedEquation';
import DailyPuzzleDisplay from './DailyPuzzleDisplay';
import { formatBoardDate } from './boardDate';
import { DEFAULT_DAILY_MODE, dailyModeLabel } from './dailyModeTabs';
import { dailyModeAccent } from './modeAccent';
import { splitBoardForDisplay } from './boardTop100';
import PinnedSelfRow from './PinnedSelfRow';
import { reportedFallback } from '@/observability';
import { rowDisplayName, isLinkableRow } from './guestName';

// The board's accent is the SELECTED TIER's colour, not this board's own.
//
// It used to be a module constant — Global cyan, Friends green, Equations
// magenta, National violet — so the four boards were tellable apart at a glance
// and the three Dailies were not. David reversed that on 2026-08-31 ("tier
// colours win; the per-board colour language gives way") once Challenge moved
// onto cyan and every board started wearing Challenge's colour whatever tier it
// was showing. The board's own identity is carried by its icon and heading, which
// it already had. See modeAccent.js.

// One rule for every board (case-insensitive, like the server) — @/leaderboard guestName.
const isLinkable = (entry) => isLinkableRow(entry);

// Prefer the server's verdict when the row carries one.
//
// `daily-board` withholds equation/usedDiceIndices/diceColors from a viewer who
// has not played today, so deriving "perfect" client-side returns FALSE for every
// row on a locked board — silently, and indistinguishably from "nobody solved it
// perfectly". The server therefore ships `is_perfect_solve` on every row it
// serves, including locked ones: the verdict is not an answer, the working is.
// The client derivation stays as the fallback for the legacy direct read, which
// still carries the solution columns.
const perfect = (entry) =>
  typeof entry?.is_perfect_solve === 'boolean'
    ? entry.is_perfect_solve
    : isPerfectSolve(entry.equation, entry.usedDiceIndices, entry.diceColors);

// Friends tab — the friend-filtered view of today's daily board (friends + you),
// fastest first. Keeps the global/friends distinction. When unlocked, clicking a
// name reveals that friend's winning equation inline; a "Profile" pill always
// links to their public profile (OtherProfile). Same anti-peek lock as Global:
// locked viewers see names + times but not the equations. CapGo-clean.
export default function FriendsTab({ date = todayET(), mode = DEFAULT_DAILY_MODE }) {
  // F1 — the same question GlobalTab and SuccessModal ask, never a mode list.
  // False only where a perfect solve is arithmetically unreachable (Easy deals
  // no coloured dice, so `correctCount === 3` cannot happen).
  const showPerfect = hasPerfectConcept(mode);
  const accent = dailyModeAccent(mode);
  const isToday = date === todayET();
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [locked, setLocked] = useState(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  const [hasFriends, setHasFriends] = useState(false);
  const [selectedId, setSelectedId] = useState(null);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true);
      try {
        const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.friends.me'));
        const friendIds = user?.id
          ? selectFriendIds(await getFriendEdges(user.id), user.id)
          : [];
        const [board, canSee] = await Promise.all([
          getLeaderboard({ date, mode, enrichProfiles: true }),
          // Per mode: finishing Easy must not unlock Challenge's or Expert's
          // answers for the day.
          canViewerSeeToday(user, date, mode),
        ]);
        if (cancelled) return;
        const friendSet = new Set(friendIds);
        const filtered = board.filter(
          (e) => e.user_id === user?.id || friendSet.has(e.user_id),
        );
        setCurrentUserId(user?.id ?? null);
        setHasFriends(friendIds.length > 0);
        setRows(filtered);
        // Anti-peek applies only to TODAY; past days are always visible.
        setLocked(date === todayET() ? !canSee : false);
      } catch (error) {
        console.error('Failed to load friends leaderboard:', error);
        if (!cancelled) setRows([]);
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, [date, mode]);

  // Top 100 + pinned self (David, 2026-08-24). The average below stays over the
  // WHOLE friend board — a display cap must never quietly become a stats cap.
  const { visible, pinnedSelf } = useMemo(
    () => splitBoardForDisplay(rows, currentUserId),
    [rows, currentUserId],
  );

  const average = useMemo(() => {
    if (rows.length === 0) return 0;
    return rows.reduce((s, e) => s + (e.solve_time_seconds || 0), 0) / rows.length;
  }, [rows]);

  if (loading) {
    return (
      <div className="flex items-center justify-center py-16">
        <DiceLoader size={44} />
      </div>
    );
  }

  if (rows.length === 0) {
    return (
      <div className="space-y-3">
        <DailyPuzzleDisplay date={date} mode={mode} />
        <div className="text-center py-16 text-slate-400">
          <Users className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: accent }} />
          {/* Same defect as GlobalTab's empty state, one file over: "completed
              today" was printed for every mode and every past date. */}
          {hasFriends ? (
            <p>
              {isToday
                ? `None of your friends have completed the ${dailyModeLabel(mode)} Daily yet.`
                : `None of your friends completed the ${dailyModeLabel(mode)} Daily on ${formatBoardDate(date)}.`}
            </p>
          ) : (
            <p>Add friends to compare daily times.</p>
          )}
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-3">
      {/* The day's dice roll. This was a bare "…'s Dice Roll: 7 dice" TEXT line —
          stale copy Global had already dropped, and it told you the count while
          showing you nothing (David, 1.0.292). It is now the shared
          DailyPuzzleDisplay: the actual dice, behind the same canViewerSeeToday
          gate the line rode. The component renders NOTHING while locked, which is
          why there is no `!locked &&` here (Bryce, 1.0.287 — pre-solve the board
          must not announce a roll the viewer can't see). */}
      <DailyPuzzleDisplay date={date} mode={mode} />

      <div className="rounded-2xl p-4 border border-white/10 bg-white/[0.04] text-center">
        {/* Date-aware: said "Today" even on a historical board. Mirrors Global's
            "Global Average for {date}". */}
        <div className="text-xs font-bold uppercase tracking-wider text-slate-300 mb-1 flex items-center justify-center gap-2">
          <Users className="w-4 h-4" style={{ color: accent }} /> Friends' Average for {formatBoardDate(date)}
        </div>
        <div className="text-3xl font-black text-slate-100">{formatSolveTime(average)}</div>
        <div className="text-xs text-slate-300 mt-1">{rows.length} completed</div>
      </div>

      {/* 1C: perfect-solve legend. F1: absent in Easy, which has no Power Dice
          for the sentence to be about. */}
      {showPerfect && (
        <div className="flex items-center justify-center gap-2 text-xs text-slate-300">
          <span className="inline-block w-3.5 h-3.5 rounded border-2 flex-shrink-0" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }} />
          <span>= Perfect Solve (all 3 Power Dice used correctly)</span>
        </div>
      )}

      {locked && (
        <div className="rounded-2xl p-4 border border-white/10 bg-white/[0.04] text-center">
          <Lock className="w-6 h-6 mx-auto mb-1.5" style={{ color: accent }} />
          <div className="font-bold text-slate-200 text-sm">Complete today's challenge to reveal equations</div>
        </div>
      )}

      <div className="space-y-2">
        {!locked && (
          <div className="text-center text-xs text-slate-400 italic">Tap a name to reveal their solution.</div>
        )}
        {visible.map((entry, i) => {
          const linkable = isLinkable(entry);
          const isSelf = entry.user_id === currentUserId;
          return (
            <LeaderboardRow
              key={entry.id}
              rank={i + 1}
              userId={entry.user_id}
              name={rowDisplayName(entry)}
              country={entry.user_country}
              puzzlePoints={entry.puzzle_points}
              battlePoints={entry.battle_points}
              value={formatSolveTime(entry.solve_time_seconds)}
              isCurrentUser={isSelf}
              perfect={showPerfect && perfect(entry)}
              warp={entry.warp === true}
              accent={accent}
              onNameClick={
                locked
                  ? undefined
                  : () => {
                      playSound('buttonTap');
                      setSelectedId((id) => (id === entry.user_id ? null : entry.user_id));
                    }
              }
              profileTo={
                !isSelf && linkable
                  ? { screen: 'profile', id: entry.user_id, returnTo: 'Leaderboard' }
                  : undefined
              }
            >
              {!locked && selectedId === entry.user_id && (
                <div className="rounded-xl bg-black/30 border border-white/10 p-3 text-center">
                  <RevealedEquation entry={entry} />
                </div>
              )}
            </LeaderboardRow>
          );
        })}

        {/* Pinned when the viewer placed below the fold — outside the ~10 rows on
            screen without scrolling, not outside the rendered 100. Shows their
            TRUE rank. Live at today's scale — see boardTop100.js. */}
        {pinnedSelf && (
          <PinnedSelfRow>
            <LeaderboardRow
              rank={pinnedSelf.rank}
              userId={pinnedSelf.entry.user_id}
              name={rowDisplayName(pinnedSelf.entry)}
              country={pinnedSelf.entry.user_country}
              puzzlePoints={pinnedSelf.entry.puzzle_points}
              battlePoints={pinnedSelf.entry.battle_points}
              value={formatSolveTime(pinnedSelf.entry.solve_time_seconds)}
              isCurrentUser
              perfect={showPerfect && perfect(pinnedSelf.entry)}
              warp={pinnedSelf.entry.warp === true}
              accent={accent}
            />
          </PinnedSelfRow>
        )}
      </div>
    </div>
  );
}
