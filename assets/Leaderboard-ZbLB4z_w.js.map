import React from 'react';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';

// The shared "reveal" node for a daily-board entry's winning equation. Rendered
// inline under a leaderboard row when the viewer taps a name (and the anti-peek
// gate is unlocked). Used by every daily board — Global, Friends, Perfect Solve —
// so the reveal looks and behaves identically everywhere.
//
// Normalizes display operators back to ASCII so the engine + renderer agree.
// Falls back to a plain text equation when the per-die color/index metadata that
// SolvedEquation needs isn't recorded on the entry.
export default function RevealedEquation({ entry }) {
  if (!entry?.equation) {
    return <div className="text-xs text-slate-400">No equation recorded.</div>;
  }
  if (!entry.diceColors || !entry.usedDiceIndices) {
    const eq = entry.equation.replace(/\*/g, '×').replace(/\//g, '÷').replace(/-/g, '−');
    return <span className="text-emerald-300 text-base font-bold">{eq} = 37</span>;
  }
  const normalized = entry.equation
    .replace(/×/g, '*')
    .replace(/−/g, '-')
    .replace(/÷/g, '/')
    .replace(/＋/g, '+');
  return (
    <div className="text-base font-bold">
      <SolvedEquation
        equation={normalized}
        usedIndices={entry.usedDiceIndices}
        colors={entry.diceColors}
        highlightAllWhenPerfect
      />
      <span className="text-slate-200"> = </span>
      <Target37 className="font-black" />
    </div>
  );
}
