import React, { useEffect, useMemo, useState } from 'react';
import { Flag, Crown } from 'lucide-react';
import { DiceLoader } from '@/dice-visuals';
import { getNationalAverages } from '@/stats-aggregation/nationalAverages';
import { todayET } from '@/daily-challenge';
import { countryName } from '@/components/profile/countryName';
import { formatSolveTime, playSound } from '@/ui/feedback';
import RankBadge from '@/components/stats/RankBadge';
import { apiClient } from '@/transport';
import { isNamedAccount } from '@/auth';
import DailyPuzzleDisplay from './DailyPuzzleDisplay';
import { DEFAULT_DAILY_MODE } from './dailyModeTabs';
import { dailyModeAccent } from './modeAccent';

// The board's accent is the SELECTED TIER's colour, not this board's own.
//
// It used to be a module constant — Global cyan, Friends green, Equations
// magenta, National violet — so the four boards were tellable apart at a glance
// and the three Dailies were not. David reversed that on 2026-08-31 ("tier
// colours win; the per-board colour language gives way") once Challenge moved
// onto cyan and every board started wearing Challenge's colour whatever tier it
// was showing. The board's own identity is carried by its icon and heading, which
// it already had. See modeAccent.js.
const GOLD = 'var(--u37-gold)';



// National Average sub-tab (Feature D1). For the selected day, a per-country
// breakdown of the daily challenge: flag + country + average completion time +
// how many players completed it, ordered fastest-average first. The averages are
// aggregate + anonymous (no individual rows, no equations), so the BOARD carries
// no anti-peek lock — a viewer sees it whether or not they've solved today. The
// shared DailyPuzzleDisplay at the top is the one gated piece: it enforces
// canViewerSeeToday itself and renders nothing until the viewer has finished.
// Pure read — CapGo-clean.
//
// `date` defaults to today; the historical date navigator (D2) threads a past
// date in and the effect refetches for it.
export default function NationalAverageTab({ date = todayET(), mode = DEFAULT_DAILY_MODE }) {
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const accent = dailyModeAccent(mode);
  // A13: true when the per-mode RPC overload is not deployed yet AND this is not
  // Challenge's Daily. Distinct from "no rows" on purpose — "nobody solved it"
  // and "we cannot answer for this mode yet" are different sentences, and
  // showing the first when the second is true is how a missing migration turns
  // into a bug report about an empty board.
  const [unavailable, setUnavailable] = useState(false);

  // Who's looking? Drives the participation note below the board. The app gives
  // EVERY visitor an anonymous session, so "guest" is `!has_custom_username`
  // (isNamedAccount), NOT a null user. A failed lookup shows no note at all —
  // never break the board over an auth blip.
  const [viewer, setViewer] = useState(null);

  useEffect(() => {
    let cancelled = false;
    const load = () => apiClient.auth.me()
      .then((me) => { if (!cancelled) setViewer(me); })
      .catch(() => { if (!cancelled) setViewer(null); });
    load();
    // Creating an account from the guest CTA below fires 'userProfileUpdated'
    // (CreateAccountForm), so re-read the viewer and drop the note in place
    // instead of leaving a stale "Playing as a guest?" prompt on the board. The
    // Edit-Profile path reloads the page itself, so it needs nothing here.
    const onProfileUpdated = () => { load(); };
    window.addEventListener('userProfileUpdated', onProfileUpdated);
    return () => {
      cancelled = true;
      window.removeEventListener('userProfileUpdated', onProfileUpdated);
    };
  }, []);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true);
      setUnavailable(false);
      try {
        const data = await getNationalAverages({ date, mode });
        if (!cancelled) setRows(data);
      } catch (error) {
        console.error('Failed to load national averages:', error);
        if (!cancelled) {
          setRows([]);
          setUnavailable(error?.code === 'national_averages_mode_unavailable');
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, [date, mode]);

  const totalPlayers = useMemo(
    () => rows.reduce((s, r) => s + (r.playerCount || 0), 0),
    [rows],
  );

  // Tell a viewer who CAN'T appear on this board why, and what to do about it —
  // and TAKE THEM THERE. It used to be inert text naming a screen ("Edit
  // Profile") the player then had to go hunt for in the hamburger drawer (David,
  // 1.0.292). Three states: guest (no profile yet) -> the Save-Stats /
  // create-account flow; named account with no country -> Edit Profile; named
  // account with a country -> nothing (they're already on the board).
  //
  // Both destinations are modals owned by routing/Layout.jsx, which is mounted on
  // every routed page. A non-drawer component reaches them the way the
  // Statistics page already does: by dispatching the window event Layout listens
  // for. That's the existing pattern — no new modal plumbing.
  const participationCta = !viewer
    ? null
    : !isNamedAccount(viewer)
      ? {
          event: 'openSaveStats',
          copy: 'Playing as a guest? Create a profile to put your country on this board.',
        }
      : !viewer.country
        ? {
            event: 'openEditProfile',
            copy: "Add your home country in Edit Profile to count toward your country's average.",
          }
        : null;

  // A real tappable control, not a caption: 44px minimum touch target (this is a
  // phone-first UI), but a quiet violet outline and small type so it stays
  // subordinate to the board it sits under.
  const noteEl = participationCta && (
    <div className="px-4 flex justify-center">
      <button
        type="button"
        data-testid="national-participation-note"
        data-cta={participationCta.event}
        onClick={() => {
          playSound('buttonTap');
          window.dispatchEvent(new CustomEvent(participationCta.event));
        }}
        className="w-full max-w-sm min-h-[44px] rounded-full px-4 py-2.5 text-[11px] font-bold leading-snug text-center touch-manipulation"
        style={{
          color: 'color-mix(in srgb, var(--u37-violet) 30%, white)',
          background: 'color-mix(in srgb, var(--u37-violet) 10%, transparent)',
          border: '1.5px solid color-mix(in srgb, var(--u37-violet) 60%, transparent)',
        }}
      >
        {participationCta.copy}
      </button>
    </div>
  );

  if (loading) {
    return (
      <div className="flex items-center justify-center py-16">
        <DiceLoader size={44} />
      </div>
    );
  }

  if (rows.length === 0) {
    return (
      <div className="space-y-3">
        <DailyPuzzleDisplay date={date} mode={mode} />
        <div className="text-center py-16 text-slate-400" data-testid={unavailable ? 'national-mode-unavailable' : undefined}>
          <Flag className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: accent }} />
          {unavailable ? (
            <>
              <p>Country averages aren&apos;t split by mode yet.</p>
              <p className="text-xs mt-1">They&apos;re live for the Challenge Daily today.</p>
            </>
          ) : (
            <>
              <p>No countries on the board for this day yet.</p>
              <p className="text-xs mt-1">Averages appear once players complete the challenge.</p>
            </>
          )}
          {noteEl && <div className="mt-3">{noteEl}</div>}
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-3">
      {/* The day's dice roll — the same shared block every Daily sub-tab shows.
          It carries the anti-peek gate itself (renders nothing until the viewer
          has solved or forfeited today); the country averages below are
          aggregate and stay ungated. */}
      <DailyPuzzleDisplay date={date} mode={mode} />

      {/* Heading — what this board is + the participating cohort. */}
      <div className="rounded-2xl p-4 border border-white/10 bg-white/[0.04] text-center">
        <div className="text-xs font-bold uppercase tracking-wider text-slate-300 mb-1 flex items-center justify-center gap-2">
          <Flag className="w-4 h-4" style={{ color: accent }} /> Average by Country
        </div>
        <div className="text-xs text-slate-300 mt-0.5">
          {rows.length} countr{rows.length === 1 ? 'y' : 'ies'} · {totalPlayers} completed · fastest average first
        </div>
      </div>

      {/* Coverage caveat (locked B contract): players with no country set are
          excluded from the per-country averages, so this cohort can be smaller
          than the day's total completions. */}
      <div className="text-center text-[11px] text-slate-500 italic">
        Only players who've set a country are counted.
      </div>

      {noteEl}

      {/* Winner hero — the fastest-average country, featured with a gold podium
          treatment above the ranked list (device feedback 2). */}
      {(() => {
        const winner = rows[0];
        return (
          <div
            data-testid="national-hero"
            data-country={winner.countryCode}
            className="rounded-2xl p-4 border text-center bg-gradient-to-br from-amber-500/10 to-yellow-600/10"
            style={{ borderColor: GOLD, boxShadow: `0 0 22px -8px ${GOLD}, inset 0 0 22px -16px ${GOLD}` }}
          >
            <div className="text-[11px] font-black uppercase tracking-widest mb-2 flex items-center justify-center gap-1.5" style={{ color: GOLD }}>
              <Crown className="w-4 h-4" style={{ color: GOLD }} /> Fastest Country
            </div>
            <img
              src={`https://flagcdn.com/w80/${winner.countryCode}.png`}
              alt=""
              className="w-16 h-11 object-cover rounded-md mx-auto shadow-lg"
              style={{ boxShadow: `0 0 16px -4px ${GOLD}` }}
            />
            <div className="text-xl font-black text-slate-100 mt-2 truncate">{countryName(winner.countryCode)}</div>
            <div className="text-3xl font-black mt-0.5" style={{ color: GOLD }}>{formatSolveTime(winner.avgSolveTimeSeconds)}</div>
            <div className="text-[11px] uppercase tracking-widest text-slate-400 mt-0.5">
              average · {winner.playerCount} player{winner.playerCount !== 1 ? 's' : ''}
            </div>
          </div>
        );
      })()}

      {/* Ranked per-country rows for everyone BEHIND the winner (rank 2+). The
          #1 country lives in the hero above, so the list starts at rank 2. */}
      {rows.length > 1 && (
        <div className="space-y-2">
          {rows.slice(1).map((r, i) => (
            <div
              key={r.countryCode}
              data-testid="national-row"
              data-country={r.countryCode}
              className="rounded-2xl border bg-slate-900/40 backdrop-blur-sm"
              style={{ borderColor: 'rgba(255,255,255,0.10)' }}
            >
              <div className="flex items-center justify-between gap-3 p-3">
                <div className="flex items-center gap-3 min-w-0 flex-1">
                  <RankBadge rank={i + 2} />
                  <img
                    src={`https://flagcdn.com/w40/${r.countryCode}.png`}
                    alt=""
                    className="w-7 h-5 object-cover rounded flex-shrink-0"
                  />
                  <div className="flex flex-col min-w-0">
                    <span className="text-slate-100 font-semibold truncate">{countryName(r.countryCode)}</span>
                    <span className="text-[11px] text-slate-400">
                      {r.playerCount} player{r.playerCount !== 1 ? 's' : ''}
                    </span>
                  </div>
                </div>
                <div className="text-right font-bold text-lg flex-shrink-0" style={{ color: accent }}>
                  {formatSolveTime(r.avgSolveTimeSeconds)}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
