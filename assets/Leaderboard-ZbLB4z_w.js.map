import React from 'react';

// The viewer's own row, pinned below the scrolling board (David, 2026-08-24).
//
// It sticks to the BOTTOM OF THE BOARD'S OWN SCROLLER — the fixed-height
// `overflow-y-auto` panel in src/pages/Leaderboard.jsx — not to the viewport.
// That distinction is the reason this is a `sticky` element inside the list
// rather than a `fixed` overlay: a fixed row would float over the bottom nav bar
// and the AdMob band, both of which live outside that panel, and it would keep
// floating on every other screen the panel is not on.
//
// The gradient is not decoration. Without it the ranked rows scroll THROUGH the
// pinned row and the two become unreadable at the moment they overlap, which is
// exactly when the player is looking. It fades the list out behind the pin
// (#0f172a is the app's page background, set on html/body in index.css) and
// leaves the row itself fully opaque.
//
// `children` is a LeaderboardRow the caller builds, because each board passes
// different props to it (a time on Daily, a count on Puzzle Pieces). This owns
// the pinning and the separator and nothing else.
export default function PinnedSelfRow({ children }) {
    return (
        <div
            data-testid="pinned-self-row"
            className="sticky bottom-0 z-10 pt-4 pb-1"
            style={{
                background: 'linear-gradient(to top, #0f172a 68%, rgba(15,23,42,0))',
            }}
        >
            {/* A hairline above the pin so it reads as chrome attached to the
                board, not as row 101. */}
            <div className="h-px mb-2 bg-gradient-to-r from-transparent via-white/20 to-transparent" />
            {children}
        </div>
    );
}
