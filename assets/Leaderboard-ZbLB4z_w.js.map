// hrefFor — the ONE place that turns a ScreenTarget into today's URL.
//
// An info screen (Leaderboard, Stats, Badges, a player's profile) never builds a
// URL itself. It names WHERE it wants to go as a plain object — a ScreenTarget —
// and this module spells the address. Two readers use the same target:
//
//   - the app's router (no host): the target becomes exactly the URL the link
//     carried before the seam existed, so the app behaves identically;
//   - a host (e.g. Sector 73's in-world frame): it reads the target object and
//     opens the screen in place instead of leaving the page.
//
// Every builder below reproduces the literal string the converted call site
// wrote before (raw `${id}` interpolation, same parameter order). hrefFor.test.js
// pins each one against that old literal, so "the app is unchanged" is a test,
// not a promise.
//
// Leaf rule: this folder imports only `react`, `react-router-dom` and
// `@/routing/createPageUrl` (pinned by leafImports.test.js), so every screen tree
// can import it without creating an import cycle.

import { createPageUrl } from '@/routing/createPageUrl';

/**
 * Where a link inside an info screen wants to go.
 *
 * @typedef {(
 *   { screen: 'leaderboard', tab?: string, focus?: string } |
 *   { screen: 'stats', id?: string, email?: string, card?: string } |
 *   { screen: 'badges', id?: string, name?: string, mode?: string, badge?: string } |
 *   { screen: 'profile', id: string, returnTo?: string } |
 *   { screen: 'home' }
 * )} ScreenTarget
 */

/**
 * `key=value` pairs joined with `&`, values written raw — the way the old call
 * sites interpolated them (`?id=${id}&returnTo=…`). A key the target leaves out
 * (undefined) is omitted; any value it supplies is written as the template
 * would have written it, null included (`id=null`) — byte-identical to before.
 *
 * @param {Array<[string, unknown]>} pairs
 * @returns {string} '' or '?a=1&b=2'
 */
function rawQuery(pairs) {
  const parts = pairs
    .filter(([, v]) => v !== undefined)
    .map(([k, v]) => `${k}=${v}`);
  return parts.length ? `?${parts.join('&')}` : '';
}

/**
 * The URL a ScreenTarget points at, exactly as the app has always written it.
 *
 * @param {ScreenTarget} target
 * @returns {string}
 */
export function hrefFor(target) {
  switch (target?.screen) {
    case 'leaderboard':
      return createPageUrl('Leaderboard') + rawQuery([['tab', target.tab], ['focus', target.focus]]);
    case 'stats':
      return createPageUrl('Statistics') + rawQuery([['id', target.id], ['email', target.email], ['card', target.card]]);
    case 'badges': {
      // The Badges links were always built with URLSearchParams (badgeDeepLink.js,
      // FeaturedBadges.jsx), so names with spaces encode as before.
      const params = new URLSearchParams();
      for (const key of /** @type {const} */ (['id', 'name', 'mode', 'badge'])) {
        const v = target[key];
        if (v !== undefined && v !== null && v !== '') params.set(key, String(v));
      }
      const query = params.toString();
      return query ? `${createPageUrl('Badges')}?${query}` : createPageUrl('Badges');
    }
    case 'profile':
      // `id` is always written, as every old `?id=${…}` template did — even a
      // null/undefined id comes out as `id=null` / `id=undefined`, exactly as before.
      return `${createPageUrl('OtherProfile')}?id=${target.id}` + (target.returnTo !== undefined ? `&returnTo=${target.returnTo}` : '');
    case 'home':
      return createPageUrl('Game');
    default:
      throw new Error(`hrefFor: unknown screen target ${JSON.stringify(target)}`);
  }
}
