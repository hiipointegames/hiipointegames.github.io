// The participation line on a Daily board: how many started, how many finished,
// and where the viewer placed among the finishers.
//
// Pure. The fetches stay in GlobalTab; this is the arithmetic, so it can be
// tested without a network and so the two percentages cannot quietly acquire
// different denominators in a component's render.
//
// ─────────────────────────────────────────────────────────────────────────────
// TWO PERCENTAGES, TWO DIFFERENT DENOMINATORS, ON PURPOSE
// ─────────────────────────────────────────────────────────────────────────────
// `completionPercent` is out of everyone who STARTED. `beatPercent` is out of
// the other people who FINISHED. That looks like an inconsistency and is not:
//
//   • "60% completed" answers "how hard was today?", and a player who started
//     and gave up is exactly who that question is about.
//   • "you beat 78%" answers "how did I do?", and beating someone means being
//     FASTER than them — which you can only be against a posted time. Counting
//     the forfeiters there would conflate *finished ahead of* with *finished at
//     all*, and would inflate every player's number by the same amount, which
//     tells nobody anything.
//
// Both numbers sit on one line, so the risk of someone "fixing" the apparent
// mismatch is real. That is what `boardParticipation.test.js` is guarding.

import { getUserRank } from '@/stats-aggregation';

/**
 * How many DISTINCT players started this board's Daily.
 *
 * ⚠️ DISTINCT, not a row count, even though David's rule is one attempt per
 * player per day per mode. The rule is real but it lives in the controller's
 * logic — `daily_challenge_attempts` carries no unique constraint on
 * (user_id, date, mode); its only constraint is the primary key on `id`, and
 * both lookup indexes are plain. So a race, a retry, or a pre-`mode` historical
 * row can physically duplicate a player.
 *
 * A `Set` costs nothing and removes a silent failure: one duplicated row would
 * depress the published completion rate for everybody, and nothing on the screen
 * would hint at why.
 *
 * @param {Array<{user_id?: string}>|null|undefined} attempts already scoped to one date + mode
 * @returns {number}
 */
export function countDistinctStarters(attempts) {
  if (!Array.isArray(attempts)) return 0;
  const seen = new Set();
  for (const a of attempts) {
    if (a && a.user_id) seen.add(a.user_id);
  }
  return seen.size;
}

/**
 * The viewer's standing among the OTHER finishers, as a percentage.
 *
 * ⚠️ THE DIVISOR IS `n - 1`, NOT `n`. You cannot beat yourself, so the field is
 * the other solvers. Dividing by `n` would cap first place at 90% on a
 * ten-player board, which is wrong and reads as a bug to the person who won.
 *
 * Returns null — meaning "do not show this" — when there is nothing true to say:
 * the viewer did not finish (rank 0), or they are the only finisher, where
 * "beat 100% of nobody" is a sentence with no content.
 *
 * @param {number} rank 1-indexed; 0 when the viewer is not on the board
 * @param {number} solverCount how many finished
 * @returns {number|null} 0-100, or null when it should not be rendered
 */
export function beatPercent(rank, solverCount) {
  if (!Number.isFinite(rank) || rank < 1) return null;
  if (!Number.isFinite(solverCount) || solverCount < 2) return null;
  if (rank > solverCount) return null;
  return Math.round(((solverCount - rank) / (solverCount - 1)) * 100);
}

/**
 * Everything the participation line needs, from the data the board already has.
 *
 * @param {Object} p
 * @param {Array<{user_id?: string}>} [p.attempts] this date+mode's attempt rows
 * @param {Array<{user_id?: string}>} [p.rows] the ranked board (finishers, in order)
 * @param {string|null} [p.viewerId]
 * @returns {{
 *   attempted: number, completed: number,
 *   completionPercent: number|null, beat: number|null,
 * }}
 */
export function boardParticipation({ attempts, rows, viewerId } = {}) {
  const completed = Array.isArray(rows) ? rows.length : 0;

  // ⚠️ `null` MEANS "WE DO NOT KNOW", AND IS NOT THE SAME AS `[]`.
  //
  // An empty array is a real answer: nobody has started today. A null is the
  // read having failed, and the two must not render the same way. Conflating
  // them printed "2 attempted · 100% completed" on a board whose attempts read
  // had thrown — a number invented out of the `Math.max` repair below, stated
  // with the same confidence as a measured one. Showing nothing is the only
  // honest answer to a question we could not ask.
  if (!Array.isArray(attempts)) {
    return {
      attempted: 0,
      completed,
      completionPercent: null,
      beat: beatPercent(getUserRank(rows, viewerId), completed),
    };
  }

  const distinct = countDistinctStarters(attempts);

  // ⚠️ NEVER LET `completed` EXCEED `attempted`. They come from two different
  // tables, and a solve whose attempt row is missing (legacy data, a repaired
  // row, a mid-migration write) would otherwise print "3 attempted · 5
  // completed · 167%". Every finisher started by definition, so the larger of
  // the two IS the number of starters — that is a repair, not a fudge.
  const attempted = Math.max(distinct, completed);

  const completionPercent = attempted > 0
    ? Math.round((completed / attempted) * 100)
    : null;

  return {
    attempted,
    completed,
    completionPercent,
    beat: beatPercent(getUserRank(rows, viewerId), completed),
  };
}
