import React from 'react';

// LeaderboardLegend — the one-line "how do I earn these" legend shared by the
// Puzzle Pieces and Battle Points boards (copy-condense, David 2026-10-18).
//
// The earning rule is the visible line. The milestone badges and the "separate
// from Stats Achievements" note sit behind "How it works ▾" — written ONCE here,
// so the two boards cannot drift apart again. Native <details>: the hidden part
// stays in the DOM and is keyboard / screen-reader operable for free.
//
// Milestone markers are the real earned-badge IMAGES, not medal emoji (H,
// 2026-07-10) — the badge a player will actually see next to a name.

/** Small inline badge artwork, on the text baseline. */
const LegendBadge = ({ src }) => (
  <img src={src} alt="" className="inline-block w-4 h-4 object-contain align-middle" />
);

/**
 * @param {object} props
 * @param {React.ComponentType<{className?: string, style?: React.CSSProperties}>} props.icon lucide icon
 * @param {string} props.summary the earning rule, one line
 * @param {{BRONZE: number, SILVER: number, GOLD: number}} props.thresholds
 * @param {{bronze: string, silver: string, gold: string}} props.images
 * @param {string} props.accent CSS colour token, e.g. 'var(--u37-violet)'
 * @param {string} [props.testId]
 */
export default function LeaderboardLegend({ icon: Icon, summary, thresholds, images, accent, testId = 'leaderboard-legend' }) {
  return (
    <details
      data-testid={testId}
      className="group rounded-xl border px-3 py-1 mb-3 text-xs text-slate-300"
      style={{
        borderColor: `color-mix(in srgb, ${accent} 30%, transparent)`,
        background: `color-mix(in srgb, ${accent} 7%, transparent)`,
      }}
    >
      <summary className="min-h-[40px] flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden touch-manipulation">
        <Icon className="w-4 h-4 flex-shrink-0" style={{ color: accent }} />
        <span data-testid={`${testId}-summary`} className="flex-1 font-semibold text-slate-200">{summary}</span>
        <span className="font-bold whitespace-nowrap" style={{ color: accent }}>
          How it works <span aria-hidden="true" className="inline-block transition-transform group-open:rotate-180">▾</span>
        </span>
      </summary>
      <p data-testid={`${testId}-detail`} className="pb-2">
        Badges by your name at
        <span className="font-bold" style={{ color: '#cd7f32' }}> {thresholds.BRONZE} <LegendBadge src={images.bronze} /></span> ·
        <span className="font-bold text-slate-100"> {thresholds.SILVER} <LegendBadge src={images.silver} /></span> ·
        <span className="font-bold text-amber-300"> {thresholds.GOLD} <LegendBadge src={images.gold} /></span>.{' '}
        <span className="text-slate-400">Separate from Stats Achievements.</span>
      </p>
    </details>
  );
}
