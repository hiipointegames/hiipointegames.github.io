import React from 'react';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { playSound } from '@/ui/feedback';
import { formatBoardDateLong } from './boardDate';

// Prev/next day stepper for the daily leaderboard (D2). Presentational — the
// parent (DailyTab) owns the selected date + the bounds and passes canPrev/canNext:
// "Next" is disabled at today (no future days), "Prev" at the first-ever daily.
//
// `accent` is the SELECTED TIER's colour (David, 2026-08-31 — "tier colours
// win"), so stepping back through Expert's history reads as Expert rather than
// as Challenge. The default is Challenge's cyan, which is what this component
// hard-coded before the prop existed: it keeps a caller that forgets to pass one
// rendering exactly as it used to, rather than blanking the arrows.
export default function DateNavigator({
  date,
  isToday = false,
  canPrev = false,
  canNext = false,
  onPrev,
  onNext,
  accent = 'var(--u37-cyan)',
}) {
  const step = (enabled, fn) => () => {
    if (!enabled) return;
    playSound('buttonTap');
    fn?.();
  };

  const arrowClass =
    'w-10 h-10 rounded-xl flex items-center justify-center border transition-colors flex-shrink-0';
  const arrowStyle = (enabled) =>
    enabled
      ? { color: accent, borderColor: accent, background: `color-mix(in srgb, ${accent} 12%, transparent)` }
      : { color: 'rgba(148,163,184,0.4)', borderColor: 'rgba(255,255,255,0.08)', background: 'rgba(255,255,255,0.03)' };

  return (
    <div className="flex items-center justify-between gap-2 mb-3">
      <button
        type="button"
        onClick={step(canPrev, onPrev)}
        disabled={!canPrev}
        aria-label="Previous day"
        className={arrowClass}
        style={arrowStyle(canPrev)}
      >
        <ChevronLeft className="w-5 h-5" />
      </button>

      <div className="text-center min-w-0">
        <div className="text-sm font-bold text-slate-100 truncate">{formatBoardDateLong(date)}</div>
        <div className="text-[10px] uppercase tracking-widest" style={{ color: isToday ? accent : 'transparent' }}>
          {/* Reserve the row height so the label doesn't jump between days. */}
          {isToday ? 'Today' : ' '}
        </div>
      </div>

      <button
        type="button"
        onClick={step(canNext, onNext)}
        disabled={!canNext}
        aria-label="Next day"
        className={arrowClass}
        style={arrowStyle(canNext)}
      >
        <ChevronRight className="w-5 h-5" />
      </button>
    </div>
  );
}
