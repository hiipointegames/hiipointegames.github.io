import React, { useRef, useState } from 'react';
import { playSound } from '@/ui/feedback';
import { Target37 } from '@/dice-visuals';
import { DailyTab, PuzzlePiecesTab, BattlePointsTab } from '@/leaderboard';

// The unified Leaderboard — one entity, four top-level categories, each with its
// own Global/Friends scope (and Perfect Solve adds Today/All-Time). Top tabs are
// tappable AND horizontally swipeable. Each tab carries a Foundation neon accent.
const TABS = [
  { id: 'daily', label: 'Daily', accent: 'var(--u37-cyan)' },
  { id: 'pieces', label: 'Puzzle Pieces', accent: 'var(--u37-violet)' },
  { id: 'battle', label: 'Battle Points', accent: 'var(--u37-magenta)' },
];

// Minimum horizontal travel (px) to register a tab-changing swipe, and the guard
// that it's a horizontal (not vertical scroll) gesture.
const SWIPE_THRESHOLD = 60;

/**
 * The Leaderboard screen — router-free. It never reads the URL; the route page
 * (pages/Leaderboard.jsx) reads `?tab=` / `?focus=` and passes them in, and a
 * host (Sector 73's frame, later) passes them from a ScreenTarget. Every link
 * inside goes through the screen-links seam (src/screen-links).
 *
 * - tab:   starting category; an absent/unknown value falls back to Daily.
 * - focus: podium-trophy deep link — the Daily→Global board scrolls to this user id.
 * - frame: 'page' = the app page, byte-for-byte; 'sector73' = fills its host's box.
 *
 * @param {{ tab?: string | null, focus?: string | null, frame?: 'page' | 'sector73' }} [props]
 */
export default function LeaderboardScreen({ tab = 'daily', focus = null, frame = 'page' } = {}) {
  // Allow a deep-link to a specific category, e.g. /Leaderboard?tab=battle from
  // the Blitz Colosseum. Falls back to Daily for an absent/unknown value.
  const initialTab = TABS.some((t) => t.id === tab) ? tab : 'daily';
  const [active, setActive] = useState(initialTab);
  // Podium-trophy deep link (item 10): ?focus=<userId> scrolls the Daily→Global
  // board to that player. Read once on mount so later tab swipes don't re-focus.
  const focusUserId = focus || null;
  const inFrame = frame === 'sector73';
  const activeTab = TABS.find((t) => t.id === active) || TABS[0];
  const activeIdx = TABS.findIndex((t) => t.id === active);
  const tabRefs = useRef({});
  const touch = useRef(null);

  const goToIndex = (idx) => {
    if (idx < 0 || idx >= TABS.length) return;
    const id = TABS[idx].id;
    playSound('buttonTap');
    setActive(id);
    tabRefs.current[id]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  };

  const onTouchStart = (e) => {
    const t = e.touches[0];
    touch.current = { x: t.clientX, y: t.clientY };
  };
  const onTouchEnd = (e) => {
    if (!touch.current) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - touch.current.x;
    const dy = t.clientY - touch.current.y;
    touch.current = null;
    if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
      goToIndex(activeIdx + (dx < 0 ? 1 : -1)); // swipe left → next
    }
  };

  const renderTab = () => {
    switch (active) {
      case 'daily':
        return <DailyTab focusUserId={focusUserId} />;
      case 'pieces':
        return <PuzzlePiecesTab />;
      case 'battle':
        return <BattlePointsTab />;
      default:
        return null;
    }
  };

  return (
    // frame='page' keeps the app page's classes exactly; frame='sector73' fills
    // the host's box (no nav/ad maths — the host's box already stops above them)
    // and pads under the host's own header.
    <div className={inFrame ? 'relative h-full flex flex-col' : 'app-page-shell relative'}>
      {/* Header — top-left back button removed (item E, 2026-07-26): the bottom
          nav bar is now the primary navigation, so the Game back button was
          redundant on this nav-bar tab page. */}
      <div
        className={inFrame ? 'px-4 pb-3 flex items-center gap-3' : 'pt-[60px] px-4 pb-3 flex items-center gap-3'}
        style={inFrame ? { paddingTop: 'calc(var(--safe-top) + 56px)' } : undefined}
      >
        <h1 className="text-2xl font-black flex items-center gap-2">
          <Target37 className="font-black" />
          {/* Neon title: SOLID cyan fill (legible) + a thin dark keyline for crisp
              edges over the starfield + a soft cyan glow for the neon feel. The old
              treatment was a translucent-center + thick 1.4px hollow stroke, which
              doubled up on the letterforms and read as mush. */}
          <span
            className="font-black tracking-wide"
            style={{
              color: 'var(--u37-cyan)',
              WebkitTextStroke: '0.6px rgba(5, 3, 16, 0.55)',
              textShadow: '0 0 7px rgba(31, 240, 255, 0.6), 0 0 18px rgba(31, 240, 255, 0.32)',
            }}
          >
            Leaderboards
          </span>
        </h1>
      </div>

      {/* Top tab bar — tappable; the active pill scrolls into view on swipe */}
      <div className="px-4">
        <div
          role="tablist"
          aria-label="Leaderboard categories"
          className="flex gap-2 overflow-x-auto pb-2 -mx-1 px-1"
          style={{ scrollbarWidth: 'none' }}
        >
          {TABS.map((tab) => {
            const isActive = tab.id === active;
            return (
              <button
                key={tab.id}
                ref={(el) => { tabRefs.current[tab.id] = el; }}
                role="tab"
                aria-selected={isActive}
                onClick={() => {
                  playSound('buttonTap');
                  setActive(tab.id);
                }}
                className="whitespace-nowrap text-sm font-bold px-3.5 py-2 rounded-full border transition-all flex-shrink-0"
                style={{
                  // Active = bright neon outline + translucent accent center +
                  // glow (matches the header). Inactive = subtle translucent pill.
                  color: isActive ? tab.accent : 'var(--u37-text)',
                  background: isActive ? `color-mix(in srgb, ${tab.accent} 16%, transparent)` : 'rgba(255,255,255,0.05)',
                  borderColor: isActive ? tab.accent : 'rgba(255,255,255,0.10)',
                  boxShadow: isActive ? `0 0 14px -3px ${tab.accent}, inset 0 0 16px -9px ${tab.accent}` : undefined,
                  textShadow: isActive ? `0 0 8px color-mix(in srgb, ${tab.accent} 55%, transparent)` : undefined,
                }}
              >
                {tab.label}
              </button>
            );
          })}
        </div>
      </div>

      {/* Content — swipe left/right to move between leaderboards. Wrapped in a
          translucent colorful panel (tinted to the active tab) so info stays
          organized over the starfield. */}
      <div
        className={inFrame
          ? 'flex-1 min-h-0 overflow-y-auto px-4 pt-2 pb-10 scroll-edge-fade-bottom'
          : 'overflow-y-auto px-4 pt-2 pb-10 scroll-edge-fade-bottom'}
        style={inFrame ? undefined : { height: 'calc(100dvh - 160px - var(--safe-bottom) - var(--ad-reserved-bottom))' }}
        onTouchStart={onTouchStart}
        onTouchEnd={onTouchEnd}
      >
        <div
          className="max-w-2xl mx-auto rounded-3xl p-3 sm:p-4 border backdrop-blur-sm bg-gradient-to-br from-indigo-500/10 via-purple-600/10 to-fuchsia-600/10"
          style={{
            borderColor: 'rgba(255,255,255,0.10)',
            boxShadow: `inset 0 0 60px -30px ${activeTab.accent}`,
          }}
        >
          {renderTab()}
        </div>
      </div>
    </div>
  );
}
