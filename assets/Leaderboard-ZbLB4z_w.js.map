import React, { useEffect, useState } from 'react';
import { todayET } from '@/daily-challenge';
import { getDailyBoard } from '@/stats-aggregation/leaderboard';
import { MiniDice } from '@/puzzle-input';
import { getDiceColors } from '@/dice';
import { formatBoardDate } from './boardDate';

// The day's dice roll, shared by every Daily sub-tab (Global, Friends, Perfect
// Solves, Equations Used, National Avg). Extracted from GlobalTab, which was the
// only board that showed it — David, 1.0.292 device pass: the puzzle belongs on
// every sub-tab, not just the one you happen to land on first.
//
// ANTI-CHEAT — the whole reason this is ONE component instead of five copies.
// Today's roll must never reach a viewer who hasn't finished today. The gate USED
// to be client-side (canViewerSeeToday) with the challenge row fetched
// unconditionally and then simply not rendered — so seven dice values reached a
// locked browser and the gate only suppressed painting them. Seeing the dice IS
// starting the clock, so that was a real leak, not a cosmetic one.
//
// Now the dice come through getDailyBoard → the `daily-board` edge function,
// which returns `dice: null` to a viewer who has not completed or forfeited that
// date in that mode. A locked browser never receives them at all. The component
// still FAILS CLOSED: `locked` starts true, so a slow fetch, a thrown request, or
// a missing challenge row all render nothing rather than leaking the puzzle. Past
// boards are never locked (the server gates only today), which is why no date
// comparison is needed here any more.
//
// Self-fetching on purpose: a caller that had to thread `dice` + `locked` in
// would re-create the fetch in all five tabs, which is the duplication this
// removes. getDailyBoard de-duplicates the in-flight request it shares with the
// tab's own board fetch, so this costs no extra round trip. Pure read —
// CapGo-clean.

// Dice colors are POSITIONAL in the stored roll, and WHICH palette applies is a
// property of the MODE: indices 4/5/6 are the blue/red/green power dice in
// Challenge and Expert, and there are no power dice at all in Easy.
//
// ⚠️ C7. This read POWER_DICE_COLORS unconditionally, so Easy's Daily board —
// which deals seven white dice — would have been painted blue/red/green on the
// last three. Not a cosmetic slip: the colours ARE the rules here, and a player
// looking at a board that shows power dice on a puzzle that has none is being
// told the wrong game. getDiceColors is the ONE canonical mapping (it already
// knows Expert has power dice and Easy does not) and anything it does not
// recognise falls back to all-white, which is the safe direction.
const dieColor = (colors, i) => colors[i] ?? 'white';

/**
 * @param {{ date?: string, mode?: string }} props `date` is a 'YYYY-MM-DD' board
 *   date, defaulting to today. `mode` is the daily wire key — 'daily' (Challenge's
 *   Daily, the legacy key), 'daily_easy' or 'daily_expert'. Gated per mode
 *   server-side: solving Easy's Daily does not reveal Expert's roll.
 */
export default function DailyPuzzleDisplay({ date = todayET(), mode = 'daily' }) {
  const [dice, setDice] = useState(null);
  // Fail closed: locked until the server says otherwise.
  const [locked, setLocked] = useState(true);

  useEffect(() => {
    let cancelled = false;
    setDice(null);
    setLocked(true);
    (async () => {
      try {
        const board = await getDailyBoard({ date, mode, includeDice: true });
        if (cancelled) return;
        setDice(board.dice || null);
        setLocked(board.locked);
      } catch (error) {
        console.error("Failed to load the day's puzzle:", error);
        if (!cancelled) { setDice(null); setLocked(true); }
      }
    })();
    return () => { cancelled = true; };
  }, [date, mode]);

  // Locked (or nothing to show) renders NOTHING — no heading, no placeholder, no
  // lock card. Each board keeps its own "complete today to unlock" messaging, so
  // a lock card here would double up on the tabs that already have one.
  if (locked || !dice) return null;

  const isToday = date === todayET();
  const colors = getDiceColors(mode);

  return (
    <div data-testid="daily-puzzle-display" className="space-y-2">
      {/* Date-aware heading: a historical board must not say "Today's" over
          another day's roll (Bryce, 1.0.287 — carried over from GlobalTab). */}
      <div className="text-center text-sm font-black text-slate-100">
        {isToday ? "Today's Dice Roll" : `Dice Roll for ${formatBoardDate(date)}`}
      </div>
      <div className="flex justify-center gap-2">
        {dice.map((v, i) => (
          <MiniDice key={i} value={v} color={dieColor(colors, i)} />
        ))}
      </div>
    </div>
  );
}
