import React from 'react';
import { playSound } from '@/ui/feedback';

// A small pill toggle for a tab's sub-categories (Global/Friends, Today/Ever…).
// Shared so every leaderboard tab's sub-tabs look + behave the same. The active
// pill fills with the tab's neon accent.
//
// options: [{ id, label, icon?: LucideIcon, standalone?: boolean, accent?: string }],
//   value, onChange(id), accent (bar-level fallback).
// Layout:
//   - Non-standalone options flow together: a 2-column grid (two rows) when there
//     are 4+, else a single centered row.
//   - `standalone` options each render CENTERED on their OWN row below the group —
//     the daily board uses this so "National Avg" sits alone on its final row.
// Color: a per-option `accent` overrides the bar-level `accent`, so each sub-tab
//   can carry its own theme color (matching the board it opens).
// `grid` forces the grouped layout (true/false); the default 'auto' chooses it
// from the grouped count (2×2 grid at 4+, else a centered row).
/**
 * @param {{
 *   options: readonly Readonly<{id: string, label: string, icon?: any, standalone?: boolean, accent?: string}>[],
 *   value: string,
 *   onChange: (id: string) => void,
 *   accent?: string,
 *   ariaLabel?: string,
 *   grid?: 'auto' | boolean,
 * }} props
 */
export default function SubTabBar({ options, value, onChange, accent = 'var(--u37-violet)', ariaLabel, grid = 'auto' }) {
  const grouped = options.filter((o) => !o.standalone);
  const standalone = options.filter((o) => o.standalone);
  const useGrid = grid === 'auto' ? grouped.length > 3 : grid;

  const renderPill = (opt) => {
    const isActive = opt.id === value;
    const Icon = opt.icon;
    const a = opt.accent || accent;
    return (
      <button
        key={opt.id}
        role="tab"
        aria-selected={isActive}
        onClick={() => {
          playSound('buttonTap');
          onChange(opt.id);
        }}
        className="text-xs font-bold px-3 py-1.5 rounded-full border flex items-center justify-center gap-1.5 transition-all"
        style={{
          // EVERY pill wears its own accent fill — the tab's color is always on.
          // Active vs inactive is a matter of INTENSITY, not presence of color:
          //   Active   = bright neon outline + stronger accent center + glow
          //              + a subtle scale-up (mirrors the page header).
          //   Inactive = the same accent, dialed down — a calmer translucent
          //              fill and a muted colored border, no glow, no scale.
          // The label always paints in the tab's accent so the color reads even
          // at rest; the active pill stays dominant via fill + border + glow +
          // scale, not by being the only colored pill.
          color: a,
          background: isActive
            ? `color-mix(in srgb, ${a} 26%, transparent)`
            : `color-mix(in srgb, ${a} 10%, transparent)`,
          borderColor: isActive ? a : `color-mix(in srgb, ${a} 38%, transparent)`,
          boxShadow: isActive ? `0 0 12px -3px ${a}, inset 0 0 14px -8px ${a}` : undefined,
          textShadow: isActive ? `0 0 8px color-mix(in srgb, ${a} 55%, transparent)` : undefined,
          transform: isActive ? 'scale(1.04)' : undefined,
        }}
      >
        {Icon && <Icon className="w-3.5 h-3.5" />}
        {opt.label}
      </button>
    );
  };

  return (
    <div role="tablist" aria-label={ariaLabel} className="mb-3">
      <div className={useGrid ? 'grid grid-cols-2 gap-2' : 'flex items-center justify-center gap-2'}>
        {grouped.map(renderPill)}
      </div>
      {standalone.map((opt) => (
        <div key={opt.id} className="flex justify-center mt-2">
          {renderPill(opt)}
        </div>
      ))}
    </div>
  );
}
