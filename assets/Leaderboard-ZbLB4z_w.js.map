import moment from 'moment';

// Small date helpers for the daily leaderboard's historical navigator (D2).
//
// A daily-board date is the plain ET calendar day the challenge ran, as
// 'YYYY-MM-DD' (todayET() / the daily_challenges.date column). These format and
// step that string WITHOUT timezone conversion — it's already the canonical day,
// so we parse it as a plain calendar date and never shift it across a tz boundary.

const FMT = 'YYYY-MM-DD';

// Compact label for a board date, e.g. 'Mon, 7/20'. Matches the tabs' existing
// nowET().format('ddd, M/D') heading style.
export function formatBoardDate(date) {
  return moment(date, FMT).format('ddd, M/D');
}

// Fuller label for the navigator, e.g. 'Monday, July 20'.
export function formatBoardDateLong(date) {
  return moment(date, FMT).format('dddd, MMMM D');
}

// Step a board date by whole days, returning 'YYYY-MM-DD' (negative = earlier).
export function shiftDate(date, deltaDays) {
  return moment(date, FMT).add(deltaDays, 'days').format(FMT);
}

// Ordering helpers over 'YYYY-MM-DD' strings. The format is lexicographically
// sortable, so plain string compares are correct and cheap.
export function isBeforeDate(a, b) {
  return String(a) < String(b);
}
export function isAfterDate(a, b) {
  return String(a) > String(b);
}
