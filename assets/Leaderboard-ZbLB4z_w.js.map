// Puzzle-pieces leaderboard derivation — rank players by lifetime puzzle pieces.
//
// A "puzzle piece" is one daily challenge solved perfectly (all 3 colored power
// dice used correctly). The cached count lives in the PublicProfile.puzzle_points
// column (kept current by syncPublicProfile via countPuzzlePointsFromTimes), so
// the global ranking is a pure read of that column — no event-log scan needed.
//
// Mirrors selectBattlePointsLeaderboard's shape (head-to-head/playerBattles.js):
// map → drop zeros → sort descending. The "total puzzle pieces" champion board.

/**
 * Build the puzzle-pieces leaderboard from all PublicProfile rows: each player's
 * puzzle_points (+ battle_points for the badge), drop players with zero pieces,
 * sort by puzzle pieces descending (ties broken by username, case-insensitive,
 * for a stable order).
 *
 * @param {Array<object>} profiles - PublicProfile rows
 * @returns {Array<{
 *   id:string, username:string, country:string|null,
 *   puzzlePoints:number, battlePoints:number, has_custom_username:boolean
 * }>}
 */
export function selectPuzzlePiecesLeaderboard(profiles) {
  return (profiles || [])
    .filter((p) => p && p.id != null)
    .map((profile) => ({
      id: profile.id,
      username: profile.username,
      country: profile.country ?? null,
      puzzlePoints: profile.puzzle_points || 0,
      battlePoints: profile.battle_points || 0,
      // 🔴 `profiles` HAS NO `has_custom_username` COLUMN — verified against prod
      // 2026-09-10. It lives on `daily_challenge_times`, which is where every
      // other board reads it from. So `profile.has_custom_username` was always
      // undefined here and `?? false` turned that into a definite "no" for
      // EVERY player — which hid the profile pill on this board entirely, and
      // made the name text non-linkable too. The board looked like the one place
      // public profiles did not exist.
      //
      // Derived from the name instead, exactly as BattlePointsTab does for the
      // same profiles-shaped rows: syncPublicProfile names a guest
      // `Guest<first 10 of id>`, so anything else is a name the player chose.
      // The `??` is kept ahead of it so a real column, if one is ever added,
      // wins over the heuristic.
      // A row with NO name is not linkable either. BattlePointsTab's version of
      // this check says linkable for a nameless row — `!''.startsWith('Guest')`
      // is true — which would offer a profile link labelled with nothing.
      has_custom_username:
        profile.has_custom_username
        ?? (Boolean(profile.username) && !String(profile.username).startsWith('Guest')),
    }))
    .filter((player) => player.puzzlePoints > 0)
    .sort(
      (a, b) =>
        b.puzzlePoints - a.puzzlePoints ||
        (a.username || '').toLowerCase().localeCompare((b.username || '').toLowerCase()),
    );
}
