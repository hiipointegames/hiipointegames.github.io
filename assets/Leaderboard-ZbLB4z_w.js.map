import React, { useState, useEffect } from 'react';
import { Globe, Users, Percent, Flag, CalendarOff } from 'lucide-react';
import { apiClient } from '@/transport';
import { modeOf } from '@/game-modes';
import { canViewerSeeToday, todayET } from '@/daily-challenge';
import { getFirstDailyDate } from '@/stats-aggregation/leaderboard';
import GlobalTab from './GlobalTab';
import FriendsTab from './FriendsTab';
import EquationOverlapTab from './EquationOverlapTab';
import NationalAverageTab from './NationalAverageTab';
import SubTabBar from './SubTabBar';
import DateNavigator from './DateNavigator';
import { DAILY_MODE_TABS, dailyModeLabel, DEFAULT_DAILY_MODE } from './dailyModeTabs';
import { dailyModeAccent } from './modeAccent';
import { shiftDate, isAfterDate, isBeforeDate } from './boardDate';
import { reportedFallback } from '@/observability';

// Daily sub-tabs in ONE row: Global + Friends ARE the day's daily board (fastest
// first), and "My Equation" (1F) shows how many players solved it the same way
// you did. The old All-Time board was removed. Pure reads — CapGo-clean.
//
// ⚠️ THE SUB-TABS NO LONGER CARRY A COLOUR EACH. They used to (Global cyan,
// Friends green, Equations magenta, National violet) so the active pill previewed
// the board you were opening. David ruled that language away on 2026-08-31 —
// "tier colours win; the per-board colour language gives way" — because it was
// competing with the tier colours for the same pixels and the tier is what a
// player is choosing between. The icons stayed, and they are what tells the four
// boards apart now. See modeAccent.js for the full reasoning.
//
// ⚠️ THE PERFECT SOLVES BOARD IS GONE (F2). Not a cut for space: under three
// modes it stops meaning anything. Expert requires a perfect solve to count at
// all, so an Expert "perfect solves" board is just the Expert board with a
// different title; Easy deals no power dice, so a perfect solve there is
// arithmetically unreachable and the board is always empty. That leaves
// Challenge, where the gold outline on the ordinary board already says it. The
// outline still renders wherever `hasPerfectConcept(mode)` is true — see
// GlobalTab/FriendsTab (F1).
const BASE_SUBTABS = [
  { id: 'global', label: 'Global', icon: Globe },
  { id: 'friends', label: 'Friends', icon: Users },
];
// 1F / E: the day's equation breakdown — every equation used, ranked by share.
// Only appears once the viewer has solved OR forfeited today (anti-peek).
const OVERLAP_SUBTAB = { id: 'overlap', label: 'Equations Used', icon: Percent };
// National Average (1D): aggregate per-country breakdown of the day. Public (no
// anti-peek gate) so it's always present, and it's `standalone` so it sits
// CENTERED on its own final row beneath the grid of the other sub-tabs.
const NATIONAL_SUBTAB = { id: 'national', label: 'National Avg', icon: Flag, standalone: true };

export default function DailyTab({ focusUserId = null }) {
  const [sub, setSub] = useState('global');
  // WHICH Daily. Defaults to Challenge's — the legacy 'daily' key, the board
  // every existing player knows and the only one with history behind it.
  const [mode, setMode] = useState(DEFAULT_DAILY_MODE);
  // Which day the board shows. Defaults to today; the DateNavigator (D2) steps it
  // back through history down to the first-ever daily IN THIS MODE.
  const [date, setDate] = useState(todayET());
  const [canSeeToday, setCanSeeToday] = useState(false);
  // Three states, and all three matter:
  //   null           we do not know — still loading, OR the lookup FAILED
  //   ''             we know, and this mode has never had a puzzle
  //   'YYYY-MM-DD'   this mode's first puzzle
  //
  // A failed lookup must land on null, not ''. Folding an error into "no puzzle"
  // tells a player a mode does not exist because their network hiccuped — and it
  // is not hypothetical: a staging pass hit exactly that, every board announcing
  // "the Challenge Daily hasn't started yet" over a table full of Challenge
  // puzzles, purely because the queries had aborted. Unknown renders the ordinary
  // board with the navigator floor simply unavailable, which is what the code did
  // before the panel existed.
  const [firstDate, setFirstDate] = useState(null);

  const today = todayET();
  const isToday = date === today;
  // Everything below the mode row wears the SELECTED tier's colour — the date
  // stepper, the board sub-tabs, the empty state and each board's own accent.
  // The mode row itself shows all three colours at once (DAILY_MODE_TABS), which
  // is what teaches the mapping.
  const accent = dailyModeAccent(mode);

  useEffect(() => {
    let cancelled = false;
    setFirstDate(null);
    (async () => {
      const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.daily.me'));
      const [canSee, first] = await Promise.all([
        // Per mode: completing Easy's Daily must not unlock Challenge's or
        // Expert's answers. The gate takes the mode; passing today's date alone
        // is what made finishing the easiest puzzle a key to the other two.
        canViewerSeeToday(user, today, mode),
        // Per mode: Easy and Expert start the day they are first generated,
        // which is LATER than Challenge's first daily. An unfiltered lower bound
        // would let the navigator scroll a new mode back to a date where it has
        // no rows — an empty board that reads as a bug rather than as a mode
        // that did not exist yet (C6).
        //   resolved date -> the date · resolved null -> '' (none exist)
        //   REJECTED      -> null (unknown; NOT "none exist")
        getFirstDailyDate(mode).then((d) => d ?? '', () => null),
      ]);
      if (cancelled) return;
      setCanSeeToday(!!canSee);
      setFirstDate(first);
    })();
    return () => { cancelled = true; };
  }, [today, mode]);

  // The first day this mode is actually PLAYABLE.
  //
  // ⚠️ A first date in the FUTURE means the same thing to a player as no puzzle
  // at all, and conflating the two is a live bug I hit on staging: staging has
  // Easy puzzles banked for October, so `getFirstDailyDate('daily_easy')`
  // answered 2026-10-01, the snap below dutifully navigated the board there, and
  // both navigator arrows then went dead — Prev because it was already at the
  // floor, Next because you cannot go past today. Exactly the stranding this
  // snap exists to prevent, in the other direction. Production will hit the same
  // shape the night the three-mode cron banks ahead.
  const startDate = firstDate && !isAfterDate(firstDate, today) ? firstDate : '';

  // Switching to a mode that did not exist on the day you were looking at would
  // otherwise strand you on an empty board with the navigator refusing to move
  // forward. Snap to that mode's first PLAYABLE day instead.
  useEffect(() => {
    if (startDate && isBeforeDate(date, startDate)) setDate(startDate);
  }, [startDate, date]);

  // The "Equations Used" breakdown is anti-peek gated for TODAY (unlocks once the
  // viewer has solved/forfeited), but PAST days are always visible — so it's shown
  // whenever a past date is selected. National Avg is always last (standalone row);
  // Equations Used slots in just before it when present.
  const showOverlap = isToday ? canSeeToday : true;
  const subtabs = [
    ...BASE_SUBTABS,
    ...(showOverlap ? [OVERLAP_SUBTAB] : []),
    NATIONAL_SUBTAB,
  ];
  // If overlap is the active sub-tab but just got hidden (navigated back to a
  // locked today), fall back to Global instead of rendering a hidden board.
  const effectiveSub = sub === 'overlap' && !showOverlap ? 'global' : sub;

  // Bounds: can't go past today (no future) or before this mode's first daily.
  const canPrev = !!startDate && isAfterDate(date, startDate);
  const canNext = isBeforeDate(date, today);

  // A mode with no puzzle a player can reach yet — none ever, or none before
  // tomorrow. Production's state for Easy and Expert right now (the three-mode
  // generator is deliberately held), and staging's state too (puzzles banked for
  // October), so it is the FIRST thing a player will hit, not an edge case. Say
  // so plainly rather than showing "no one has completed today's daily challenge
  // yet", which invites them to go and be the first at a puzzle that does not
  // exist. `firstDate === null` is still LOADING and must show neither.
  const notStarted = firstDate !== null && !startDate;

  // The active board is keyed by date AND mode so switching either remounts it —
  // the child's own DiceLoader (the "37" loading indicator) shows while the new
  // board fetches, instead of the previous mode's rows sitting there stale.
  const renderActive = () => {
    const key = `${date}:${mode}`;
    switch (effectiveSub) {
      case 'friends':
        return <FriendsTab key={key} date={date} mode={mode} />;
      case 'national':
        return <NationalAverageTab key={key} date={date} mode={mode} />;
      case 'overlap':
        return <EquationOverlapTab key={key} date={date} mode={mode} />;
      case 'global':
      default:
        return <GlobalTab key={key} date={date} mode={mode} focusUserId={focusUserId} />;
    }
  };

  return (
    // `data-mode` puts the tier's own `--u37-mode-accent` in scope for the whole
    // board, so anything nested that paints from the token slot follows the
    // selection without being handed a prop. The Leaderboard page carried ZERO
    // `[data-mode]` elements before this — the colour system reached Home, the
    // game screens and the podium but stopped at this page.
    <div data-mode={modeOf(mode)}>
      {/* The MODE axis, above everything else: it selects WHICH puzzle, and the
          date, the board and the podium all hang off it. Q-D — every board
          splits by mode, not just Global. */}
      {/* No bar-level `accent`: every option carries its own tier colour, and a
          fallback here would only ever mask a mode that had lost one. */}
      <SubTabBar
        options={DAILY_MODE_TABS}
        value={mode}
        onChange={setMode}
        ariaLabel="Daily mode"
        grid={false}
      />

      {/* D2: historical date stepper — prev/next through every past daily. */}
      <DateNavigator
        date={date}
        isToday={isToday}
        canPrev={canPrev}
        canNext={canNext}
        onPrev={() => setDate((d) => shiftDate(d, -1))}
        onNext={() => setDate((d) => shiftDate(d, 1))}
        accent={accent}
      />

      {notStarted ? (
        <div className="text-center py-16 text-slate-400" data-testid="daily-mode-not-started">
          <CalendarOff className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: accent }} />
          <p>The {dailyModeLabel(mode)} Daily hasn&apos;t started yet.</p>
          <p className="text-xs mt-1">Its first puzzle isn&apos;t out — check back soon.</p>
        </div>
      ) : (
        <>
          {/* Global/Friends (+ Equations Used when unlocked) lay out as a row;
              National Avg is standalone → centered on its own row. */}
          <SubTabBar options={subtabs} value={effectiveSub} onChange={setSub} accent={accent} ariaLabel="Daily board" />

          {/* Each board owns its own layout + perfect-solve legend now (1C positions
              the legend inside the Global/Friends boards). */}
          {renderActive()}
        </>
      )}
    </div>
  );
}
