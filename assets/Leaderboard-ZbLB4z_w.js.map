import React, { useEffect, useState } from 'react';
import { Lock, Percent } from 'lucide-react';
import { DiceLoader } from '@/dice-visuals';
import { apiClient } from '@/transport';
import { getLeaderboard, normalizeEquation } from '@/stats-aggregation';
import { solveColorSignature } from '@/equation-engine';
import { canViewerSeeToday, todayET } from '@/daily-challenge';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';
import DailyPuzzleDisplay from './DailyPuzzleDisplay';
import { DEFAULT_DAILY_MODE } from './dailyModeTabs';
import { dailyModeAccent } from './modeAccent';
import { reportedFallback } from '@/observability';

// The board's accent is the SELECTED TIER's colour, not this board's own.
//
// It used to be a module constant — Global cyan, Friends green, Equations
// magenta, National violet — so the four boards were tellable apart at a glance
// and the three Dailies were not. David reversed that on 2026-08-31 ("tier
// colours win; the per-board colour language gives way") once Challenge moved
// onto cyan and every board started wearing Challenge's colour whatever tier it
// was showing. The board's own identity is carried by its icon and heading, which
// it already had. See modeAccent.js.

// rankSolveVariants — every DISTINCT SOLVE on the day's board, ranked by share.
//
// Replaces the string-only grouping this board used to do (2026-09-04, David:
// "the equations % used tab is having trouble keeping track of the power dice
// locations within the actual player solutions… It only happens when there are
// duplicate numbers on white and colored power die"). Two rows are the same
// solve only when they share BOTH the normalized equation and the colour of
// every die in equation order — see equation-engine/solveVariant.js for why the
// string alone is not enough once a value appears on a white AND a power die.
//
// The headline summary is derived from the SAME grouping rather than computed
// separately, so "X% matched your equation" can never contradict the rows under
// it. `sample` is the row the group is rendered from; the viewer's own row wins
// for their group, and every other member of the group is — by construction now
// — dice-for-dice identical to it.
//
// @returns {{ total, groups: Array<{key, equation, count, percent, isYou, sample}>,
//             viewer: null | {total, sameCount, otherCount, percent, userEquation} }}
function rankSolveVariants(board, userId) {
  const rows = Array.isArray(board) ? board.filter((r) => r && r.equation) : [];
  const total = rows.length;
  const share = (n) => (total > 0 ? Math.round((n / total) * 100) : 0);
  const map = new Map();

  for (const r of rows) {
    const key = `${normalizeEquation(r.equation)}|${solveColorSignature(r.usedDiceIndices, r.diceColors)}`;
    let group = map.get(key);
    if (!group) {
      group = { key, equation: r.equation, count: 0, isYou: false, sample: r };
      map.set(key, group);
    }
    group.count += 1;
    if (userId && r.user_id === userId) {
      group.isYou = true;
      group.sample = r; // render the viewer's group from the viewer's own row
    }
  }

  // Ties keep first-seen order (Array.prototype.sort is stable).
  const groups = [...map.values()]
    .map((g) => ({ ...g, percent: share(g.count) }))
    .sort((a, b) => b.count - a.count);

  const mine = groups.find((g) => g.isYou) || null;
  const viewer = mine
    ? { total, sameCount: mine.count, otherCount: mine.count - 1, percent: mine.percent, userEquation: mine.sample.equation }
    : null;

  return { total, groups, viewer };
}

// E — "Equations": the day's full solve breakdown. Every DISTINCT equation used
// by today's solvers, ranked by share (highest first), with the viewer's own
// solve highlighted and a slim "your overlap" summary on top. Gated behind the
// same anti-peek rule as the rest of Daily — you only see it once you've solved
// or forfeited today (DailyTab hides the whole sub-tab until then; this is the
// belt-and-braces in-component guard). Pure read of today's board — CapGo-clean.
export default function EquationOverlapTab({ date = todayET(), mode = DEFAULT_DAILY_MODE }) {
  const [loading, setLoading] = useState(true);
  const [locked, setLocked] = useState(true);
  const accent = dailyModeAccent(mode);
  const [overlap, setOverlap] = useState(null);
  const [ranked, setRanked] = useState(null);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true);
      try {
        const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.equationoverlap.me'));
        const [board, canSee] = await Promise.all([
          // C10 — this board becomes per-mode for free once the read takes one:
          // it ranks the equations on whatever board getLeaderboard returns.
          getLeaderboard({ date, mode, enrichProfiles: false }),
          canViewerSeeToday(user, date, mode),
        ]);
        if (cancelled) return;
        // Anti-peek applies only to TODAY; past days are always visible.
        setLocked(date === todayET() ? !canSee : false);
        const variants = rankSolveVariants(board, user?.id);
        setOverlap(variants.viewer);
        setRanked(variants);
      } catch (error) {
        console.error('Failed to load equation breakdown:', error);
        if (!cancelled) { setOverlap(null); setRanked(null); }
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, [date, mode]);

  if (loading) {
    return (
      <div className="flex items-center justify-center py-16">
        <DiceLoader size={44} />
      </div>
    );
  }

  if (locked) {
    return (
      <div className="rounded-2xl p-6 border border-white/10 bg-white/[0.04] text-center">
        <Lock className="w-7 h-7 mx-auto mb-2" style={{ color: accent }} />
        <div className="font-bold text-slate-200">Solve or forfeit today to unlock</div>
        <div className="text-xs text-slate-400 mt-1">Then you'll see every way today's players solved it.</div>
      </div>
    );
  }

  if (!ranked || ranked.groups.length === 0) {
    return (
      <div className="space-y-3">
        <DailyPuzzleDisplay date={date} mode={mode} />
        <div className="text-center py-14 text-slate-400">
          <Percent className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: accent }} />
          <p>No equations to show yet today.</p>
          <p className="text-xs mt-1">Come back after more players solve it.</p>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-3">
      {/* The day's dice roll — the same shared block every Daily sub-tab shows,
          carrying its own copy of the anti-peek gate. Reached only past the
          `locked` early-return above, so this is belt-and-braces. */}
      <DailyPuzzleDisplay date={date} mode={mode} />

      {/* Slim summary — the viewer's own overlap (only when they have a solve).
          A solo group used to read "100% of today's 1 solver matched your
          equation — a totally unique solve! 🦄", a percentage arguing with the
          sentence beside it, because the share COUNTS THE VIEWER. Splitting
          groups by dice identity made that the common case rather than the rare
          one, so the unique case now says so in words and drops the number. */}
      {overlap && (
        <div
          className="rounded-2xl px-4 py-3 border text-center"
          style={{ borderColor: accent, background: `color-mix(in srgb, ${accent} 8%, transparent)` }}
        >
          {overlap.otherCount === 0 ? (
            <span className="text-sm text-slate-200">
              🦄 <span className="font-black align-middle" style={{ color: accent }}>A totally unique solve</span>
              {' '}— nobody else among today's {overlap.total} solver{overlap.total !== 1 ? 's' : ''} played it your way.
            </span>
          ) : (
            <>
              <span className="text-2xl font-black align-middle" style={{ color: accent }}>{overlap.percent}%</span>
              <span className="text-sm text-slate-200"> of today's {overlap.total} solver{overlap.total !== 1 ? 's' : ''} solved it exactly your way.</span>
            </>
          )}
        </div>
      )}

      <div className="text-center text-xs font-bold uppercase tracking-wider text-slate-400">
        Today's Equations · most used first
      </div>

      {/* Full ranked breakdown — every distinct equation + its share of solvers. */}
      <div className="space-y-2">
        {ranked.groups.map((g) => {
          const eq = normalizeEquation(g.equation);
          const canRender = g.sample?.usedDiceIndices && g.sample?.diceColors;
          return (
            <div
              key={g.key}
              className="rounded-xl p-3 border flex items-center justify-between gap-3"
              style={g.isYou
                ? { borderColor: accent, background: `color-mix(in srgb, ${accent} 10%, transparent)`, boxShadow: `0 0 12px -4px ${accent}` }
                : { borderColor: 'rgba(255,255,255,0.10)', background: 'rgba(255,255,255,0.03)' }}
            >
              <div className="text-base font-bold min-w-0 text-left">
                {canRender ? (
                  <>
                    <SolvedEquation
                      equation={eq}
                      usedIndices={g.sample.usedDiceIndices}
                      colors={g.sample.diceColors}
                      highlightAllWhenPerfect
                    />
                    <span className="text-slate-200"> = </span>
                    <Target37 className="font-black" />
                  </>
                ) : (
                  <span className="font-mono text-slate-100">{eq} = 37</span>
                )}
                {g.isYou && (
                  <span className="ml-2 text-[10px] font-bold px-1.5 py-0.5 rounded bg-white/10 align-middle" style={{ color: accent }}>You</span>
                )}
              </div>
              <div className="text-right flex-shrink-0">
                <div className="text-lg font-black" style={{ color: accent }}>{g.percent}%</div>
                <div className="text-[10px] text-slate-400">{g.count} solver{g.count !== 1 ? 's' : ''}</div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}
