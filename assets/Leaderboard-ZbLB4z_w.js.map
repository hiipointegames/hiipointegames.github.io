import React, { useEffect, useMemo, useState } from 'react';
import { Puzzle, Globe, Users } from 'lucide-react';
import { DiceLoader } from '@/dice-visuals';
import { apiClient } from '@/transport';
import { getFriendEdges, selectFriendIds } from '@/player';
import { selectPuzzlePiecesLeaderboard } from '@/stats-aggregation';
import { PUZZLE_POINTS, PUZZLE_PIECE_RULE_SUMMARY } from '@/game-mechanics';
import { BADGE_IMAGES } from '@/assets/badges';
import LeaderboardRow from './LeaderboardRow';
import LeaderboardLegend from './LeaderboardLegend';
import SubTabBar from './SubTabBar';
import { splitBoardForDisplay } from './boardTop100';
import PinnedSelfRow from './PinnedSelfRow';
import { reportedFallback } from '@/observability';

const ACCENT = 'var(--u37-violet)';

const SCOPES = [
  { id: 'global', label: 'Global', icon: Globe },
  { id: 'friends', label: 'Friends', icon: Users },
];

// Puzzle Pieces tab — the "total puzzle pieces" champion board (ranked by COUNT).
// Pieces: 1 per perfect Challenge Daily, 2 per Expert Daily under 37 s. Pure read of the cached
// PublicProfile.puzzle_points column. Global/Friends scope toggle; global rank is
// preserved in the friends view. CapGo-clean.
export default function PuzzlePiecesTab() {
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  const [friendIds, setFriendIds] = useState([]);
  const [scope, setScope] = useState('global');

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true);
      try {
        const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.puzzlepieces.me'));
        const [profiles, edges] = await Promise.all([
          apiClient.entities.PublicProfile.list(),
          user?.id ? getFriendEdges(user.id) : Promise.resolve([]),
        ]);
        if (cancelled) return;
        setCurrentUserId(user?.id ?? null);
        setFriendIds(user?.id ? selectFriendIds(edges, user.id) : []);
        setRows(selectPuzzlePiecesLeaderboard(profiles));
      } catch (error) {
        console.error('Failed to load puzzle-pieces leaderboard:', error);
        if (!cancelled) setRows([]);
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, []);

  const display = useMemo(() => {
    if (scope !== 'friends') return rows;
    const set = new Set(friendIds);
    return rows.filter((p) => set.has(p.id) || p.id === currentUserId);
  }, [rows, scope, friendIds, currentUserId]);

  // Top 100 + pinned self (David, 2026-08-24). Applied to the SCOPE-FILTERED
  // list, because that is what the board renders; the ranks stay global.
  const { visible, pinnedSelf } = useMemo(
    () => splitBoardForDisplay(display, currentUserId, { idOf: (r) => r.id }),
    [display, currentUserId],
  );

  const Scope = (
    <SubTabBar options={SCOPES} value={scope} onChange={setScope} accent={ACCENT} ariaLabel="Puzzle pieces scope" />
  );
  // 1D + copy-condense (2026-10-18): the earning rule in one line, read from
  // the Puzzle Piece rule source; badges + the Achievements note behind a tap.
  // The old line 1 ("a daily challenge perfectly") read as covering every Daily,
  // including Expert, which pays for speed — fixed by reading the source.
  const Legend = (
    <LeaderboardLegend
      icon={Puzzle}
      summary={PUZZLE_PIECE_RULE_SUMMARY}
      thresholds={PUZZLE_POINTS}
      images={BADGE_IMAGES.puzzle}
      accent={ACCENT}
      testId="puzzle-pieces-legend"
    />
  );

  if (loading) {
    return (
      <div>
        {Scope}
        {Legend}
        <div className="flex items-center justify-center py-16">
          <DiceLoader size={44} />
        </div>
      </div>
    );
  }

  return (
    <div>
      {Scope}
      {Legend}
      {display.length === 0 ? (
        <div className="text-center py-12 text-slate-400">
          <Puzzle className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: ACCENT }} />
          <p>
            {scope === 'friends'
              ? 'None of your friends have collected puzzle pieces yet.'
              : 'No puzzle pieces collected yet.'}
          </p>
        </div>
      ) : (
        <div className="space-y-2">
          {visible.map((row) => {
            const rank = rows.findIndex((p) => p.id === row.id) + 1; // global rank
            const isSelf = row.id === currentUserId;
            return (
              <LeaderboardRow
                key={row.id}
                rank={rank}
                userId={row.id}
                name={row.username}
                country={row.country}
                puzzlePoints={row.puzzlePoints}
                battlePoints={row.battlePoints}
                value={row.puzzlePoints}
                valueColor="var(--u37-gold)"
                linkable={row.has_custom_username}
                isCurrentUser={isSelf}
                accent={ACCENT}
                // Profile pill — same affordance the Daily board has always had.
                // Without it this board only reached a profile via the name text,
                // which reads as non-interactive, so players thought public
                // profiles were Daily-only (Bryce, 1.0.287).
                profileTo={
                  !isSelf && row.has_custom_username
                    ? { screen: 'profile', id: row.id, returnTo: 'Leaderboard' }
                    : undefined
                }
              />
            );
          })}

          {/* The viewer's own row, pinned when they placed below the fold — the
              ~10 rows on screen without scrolling, not the rendered 100
              (boardTop100.js). Its rank is the GLOBAL rank, looked up
              exactly as every visible row's is — not pinnedSelf.rank, which
              counts within the (possibly friend-filtered) list and would
              disagree with the numbers above it. */}
          {pinnedSelf && (
            <PinnedSelfRow>
              <LeaderboardRow
                rank={rows.findIndex((p) => p.id === pinnedSelf.entry.id) + 1}
                userId={pinnedSelf.entry.id}
                name={pinnedSelf.entry.username}
                country={pinnedSelf.entry.country}
                puzzlePoints={pinnedSelf.entry.puzzlePoints}
                battlePoints={pinnedSelf.entry.battlePoints}
                value={pinnedSelf.entry.puzzlePoints}
                valueColor="var(--u37-gold)"
                isCurrentUser
                accent={ACCENT}
              />
            </PinnedSelfRow>
          )}
        </div>
      )}
    </div>
  );
}
