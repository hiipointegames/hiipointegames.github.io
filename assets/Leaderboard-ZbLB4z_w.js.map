import React from 'react';
import { ScreenLink } from '@/screen-links';
import { PlayerBadges } from '@/components/profile';
import RankBadge from '@/components/stats/RankBadge';
import { playSound } from '@/ui/feedback';

// One ranked row in the unified Leaderboard. Presentational — every tab feeds it
// the same shape so the look stays consistent across Global / Friends / Perfect
// Solve / Puzzle Pieces / Battle Points.
//
// - rank 1/2/3 get the gold/silver/bronze TROPHY (shared RankBadge, same as the
//   stats leaderboard); everyone else a neutral numbered circle.
// - name behavior: by default links to the player's public profile (OtherProfile)
//   when `linkable` and not the viewer. Pass `onNameClick` to instead make the
//   name a button (Friends tab uses this to reveal the equation) and `profileTo`
//   (a ScreenTarget, e.g. `{ screen: 'profile', id, returnTo: 'Leaderboard' }`;
//   a plain URL string still works and links exactly as before)
//   to add a small "Profile" pill that always links to OtherProfile.
// - every link goes through @/screen-links (ScreenLink), so a host can open the
//   profile in place; with no host the URL is exactly what it always was.
// - `value` is the right-aligned metric node (time, points, pieces…), tab-specific.
// - `accent` is the tab's neon CSS color; the current-user row glows with it.
// - `children` render as a full-width footer under the row (e.g. revealed equation).

export default function LeaderboardRow({
  rank,
  userId,
  name,
  country,
  puzzlePoints = 0,
  battlePoints = 0,
  value,
  valueColor = undefined,
  linkable = false,
  onNameClick = undefined,
  profileTo = undefined,
  isCurrentUser = false,
  perfect = false,
  accent = 'var(--u37-violet)',
  returnTo = 'Leaderboard',
  children = null,
  // Sector 73: this solve was a 73 that crossed the Mirror. Shimmering violet
  // row + "Warped to Sector 73" under the name (David, 2026-10-04).
  warp = false,
}) {
  // Border priority: the viewer's own row glows with the tab accent; otherwise a
  // perfect solve gets the gold ring; otherwise a neutral hairline.
  const borderColor = isCurrentUser
    ? accent
    : perfect
      ? 'var(--u37-gold)'
      : 'rgba(255,255,255,0.10)';
  // The viewer's OWN row keeps the cyan/accent ring, but a perfect solve tucks a
  // gold inner glow inside it — so "you" and "perfect" both read at once instead
  // of the accent wiping out the gold reward signal.
  const boxShadow = isCurrentUser
    ? perfect
      ? `0 0 12px -2px ${accent}, inset 0 0 13px -3px var(--u37-gold)`
      : `0 0 12px -2px ${accent}`
    : perfect
      ? '0 0 10px -3px var(--u37-gold)'
      : undefined;
  // Right-aligned metric color: defaults to the tab accent, but count-only boards
  // (Puzzle Pieces / Battle Points) pass amber gold for warm-on-cool contrast.
  const metricColor = valueColor || accent;

  const nameClasses =
    'text-slate-100 font-semibold hover:text-[var(--u37-gold)] transition-colors block truncate text-left';
  let nameNode;
  if (onNameClick) {
    nameNode = (
      <button type="button" onClick={onNameClick} className={nameClasses}>
        {name}
      </button>
    );
  } else if (linkable && userId && !isCurrentUser) {
    nameNode = (
      <ScreenLink
        target={{ screen: 'profile', id: userId, returnTo }}
        onClick={() => playSound('buttonTap')}
        className={nameClasses}
      >
        {name}
      </ScreenLink>
    );
  } else {
    nameNode = <span className="text-slate-100 font-semibold block truncate">{name}</span>;
  }

  return (
    <div
      data-testid="leaderboard-row"
      data-user-id={userId}
      data-warp={warp ? 'true' : undefined}
      className={`rounded-2xl border bg-slate-900/40 backdrop-blur-sm ${warp ? 'sector73-warp-row' : ''}`}
      style={warp ? undefined : { borderColor, boxShadow }}
    >
      <div className="flex items-center justify-between gap-3 p-3">
        <div className="flex items-center gap-3 min-w-0 flex-1">
          <RankBadge rank={rank} />
          <div className="flex flex-col gap-1 min-w-0 flex-1">
            {nameNode}
            {warp && (
              <span data-testid="warp-label" className="sector73-warp-text text-[11px] font-black uppercase tracking-wider">
                ✦ Warped to Sector 73
              </span>
            )}
            <div className="flex items-center gap-2">
              {country && (
                <img
                  src={`https://flagcdn.com/w40/${String(country).toLowerCase()}.png`}
                  alt=""
                  className="w-6 h-4 object-cover rounded flex-shrink-0"
                />
              )}
              <PlayerBadges puzzlePoints={puzzlePoints} battlePoints={battlePoints} size="xl" />
              {isCurrentUser && (
                <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-white/10 text-slate-200">You</span>
              )}
            </div>
          </div>
        </div>
        <div className="flex items-center gap-2 flex-shrink-0">
          {profileTo && (
            <ScreenLink
              target={profileTo}
              onClick={() => playSound('buttonTap')}
              className="text-[11px] font-bold px-2.5 py-1 rounded-full border transition-all whitespace-nowrap hover:brightness-125"
              style={{
                color: accent,
                borderColor: accent,
                background: `color-mix(in srgb, ${accent} 16%, transparent)`,
                boxShadow: `0 0 10px -4px ${accent}`,
              }}
            >
              Profile
            </ScreenLink>
          )}
          <div className="text-right font-bold text-lg" style={{ color: metricColor }}>
            {value}
          </div>
        </div>
      </div>
      {children && <div className="px-3 pb-3 -mt-1">{children}</div>}
    </div>
  );
}
