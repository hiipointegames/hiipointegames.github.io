import React, { useEffect, useMemo, useState } from 'react';
import { Swords, Users, Globe } from 'lucide-react';
import { DiceLoader } from '@/dice-visuals';
import { apiClient } from '@/transport';
import { getFriendEdges, selectFriendIds } from '@/player';
import { selectBattlePointsLeaderboard } from '@/head-to-head';
import { BATTLE_POINTS } from '@/game-mechanics';
import { BADGE_IMAGES } from '@/assets/badges';
import LeaderboardRow from './LeaderboardRow';
import LeaderboardLegend from './LeaderboardLegend';
import SubTabBar from './SubTabBar';
import { splitBoardForDisplay } from './boardTop100';
import PinnedSelfRow from './PinnedSelfRow';
import { reportedFallback } from '@/observability';

const ACCENT = 'var(--u37-magenta)';

const SCOPES = [
  { id: 'global', label: 'Global', icon: Globe },
  { id: 'friends', label: 'Friends', icon: Users },
];

const isLinkable = (row) => !String(row.username || '').startsWith('Guest');

// Battle Points tab — the global battle-points ranking, moved out of the Blitz
// Colosseum into the unified Leaderboard. Ranks every player by battle points
// (head-to-head wins) descending, with a Global/Friends sub-filter. Reuses the
// one battle read path (selectBattlePointsLeaderboard). Username click → public
// profile. Pure read of profiles + completed challenges — CapGo-clean.
export default function BattlePointsTab() {
  const [leaderboard, setLeaderboard] = useState([]);
  const [loading, setLoading] = useState(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  const [friendIds, setFriendIds] = useState([]);
  const [scope, setScope] = useState('global');

  useEffect(() => {
    let cancelled = false;
    (async () => {
      setLoading(true);
      try {
        const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.battlepoints.me'));
        const [profiles, challenges, edges] = await Promise.all([
          apiClient.entities.PublicProfile.list(),
          apiClient.entities.HeadToHeadChallenge.filter({ status: 'completed' }),
          user?.id ? getFriendEdges(user.id) : Promise.resolve([]),
        ]);
        if (cancelled) return;
        setCurrentUserId(user?.id ?? null);
        setFriendIds(user?.id ? selectFriendIds(edges, user.id) : []);
        setLeaderboard(selectBattlePointsLeaderboard(profiles, challenges));
      } catch (error) {
        console.error('Failed to load battle-points leaderboard:', error);
        if (!cancelled) setLeaderboard([]);
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => { cancelled = true; };
  }, []);

  const displayList = useMemo(() => {
    if (scope !== 'friends') return leaderboard;
    const set = new Set(friendIds);
    return leaderboard.filter((p) => set.has(p.id) || p.id === currentUserId);
  }, [leaderboard, scope, friendIds, currentUserId]);

  // Top 100 + pinned self (David, 2026-08-24). Applied to the SCOPE-FILTERED
  // list, because that is what the board renders; the ranks stay global.
  const { visible, pinnedSelf } = useMemo(
    () => splitBoardForDisplay(displayList, currentUserId, { idOf: (r) => r.id }),
    [displayList, currentUserId],
  );

  const Toggle = (
    <SubTabBar options={SCOPES} value={scope} onChange={setScope} accent={ACCENT} ariaLabel="Battle points scope" />
  );
  // 1D + copy-condense (2026-10-18): one visible line; badges + the
  // Achievements note behind a tap. "1 per win, any tier" is the ruling in
  // head-to-head/blitzAwards.js (battlePointAwards: wins - 1 → wins).
  const Legend = (
    <LeaderboardLegend
      icon={Swords}
      summary="Win any Blitz battle = 1 Battle Point"
      thresholds={BATTLE_POINTS}
      images={BADGE_IMAGES.battle}
      accent={ACCENT}
      testId="battle-points-legend"
    />
  );

  if (loading) {
    return (
      <div>
        {Toggle}
        {Legend}
        <div className="flex items-center justify-center py-16">
          <DiceLoader size={44} />
        </div>
      </div>
    );
  }

  if (leaderboard.length === 0) {
    return (
      <>
        {Toggle}
        {Legend}
        <div className="text-center py-12 text-slate-400">
          <Swords className="w-10 h-10 mx-auto mb-3 opacity-60" style={{ color: ACCENT }} />
          <p>No players have earned battle points yet.</p>
        </div>
      </>
    );
  }

  return (
    <div>
      {Toggle}
      {Legend}
      {displayList.length === 0 ? (
        <div className="text-center py-12 text-slate-400">
          <p>None of your friends have battle points yet.</p>
        </div>
      ) : (
        <div className="space-y-2">
          {visible.map((row) => {
            // Rank is the player's GLOBAL position, even in the friends view.
            const rank = leaderboard.findIndex((p) => p.id === row.id) + 1;
            const isSelf = row.id === currentUserId;
            return (
              <LeaderboardRow
                key={row.id}
                rank={rank}
                userId={row.id}
                name={row.username}
                country={row.country}
                puzzlePoints={row.puzzlePoints}
                battlePoints={row.battlePoints}
                value={row.battlePoints}
                valueColor="var(--u37-gold)"
                linkable={isLinkable(row)}
                isCurrentUser={isSelf}
                accent={ACCENT}
                // Profile pill — same affordance the Daily board has always had
                // (Bryce, 1.0.287: public profiles felt Daily-board-only).
                profileTo={
                  !isSelf && isLinkable(row)
                    ? { screen: 'profile', id: row.id, returnTo: 'Leaderboard' }
                    : undefined
                }
              />
            );
          })}

          {/* The viewer's own row, pinned when they placed below the fold — the
              ~10 rows on screen without scrolling, not the rendered 100
              (boardTop100.js, David 2026-08-24 + 08-27). Its rank is the
              GLOBAL rank, looked up the same way every visible row's is — NOT
              pinnedSelf.rank, which counts within the (possibly friend-filtered)
              list and would disagree with the numbers above it. */}
          {pinnedSelf && (
            <PinnedSelfRow>
              <LeaderboardRow
                rank={leaderboard.findIndex((p) => p.id === pinnedSelf.entry.id) + 1}
                userId={pinnedSelf.entry.id}
                name={pinnedSelf.entry.username}
                country={pinnedSelf.entry.country}
                puzzlePoints={pinnedSelf.entry.puzzlePoints}
                battlePoints={pinnedSelf.entry.battlePoints}
                value={pinnedSelf.entry.battlePoints}
                valueColor="var(--u37-gold)"
                isCurrentUser
                accent={ACCENT}
              />
            </PinnedSelfRow>
          )}
        </div>
      )}
    </div>
  );
}
