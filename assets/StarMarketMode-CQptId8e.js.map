import React, { useEffect, useRef, useState } from 'react';
import { spriteUrl } from '../../world/shipArt';

// The thumbnail strip under the hangar preview (audit 2026-10-18, M2): every item in the current
// tab at a glance, instead of flipping ‹ › one by one. Static pictures only (no canvases):
//   • ship skins → their image (lazy; a swatch + shape icon if it fails, e.g. offline)
//   • vector shapes, colours, trails, frames, portals, worlds → a CSS swatch from the item's data
//   • titles → a small tag icon
// The equipped item wears ON, other owned (or free) items ✓, locked ones their price. The thumb
// you're looking at gets a white outline (not amber/colour, so it can't be mistaken for an item's glow).
// Tapping a thumb selects it.

const SHAPE_ICON = { scout: '▲', arrow: '➤', saucer: '◉', stingray: '◆' };

/** The CSS background (and an optional icon) that stands for an item. Pure, for tests. */
export function swatchFor(item) {
  const d = item?.data || {};
  switch (item?.kind) {
    case 'ship_color': return { background: `linear-gradient(135deg, ${(d.hull || ['#94a3b8', '#f1f5f9', '#64748b']).join(', ')})`, ring: d.glow };
    case 'trail': {
      const c = d.colors?.length ? d.colors : ['#8b5cf6'];
      return { background: `linear-gradient(90deg, ${(c.length > 1 ? c : [c[0], c[0]]).join(', ')})`, icon: d.sparkle ? '✦' : null };
    }
    case 'ship_shape': return { background: 'radial-gradient(circle, #4c1d95, #1e1b2e)', icon: SHAPE_ICON[d.shape] || '▲' };
    case 'frame': return { background: '#1e1b2e', ring: d.ring === '#000000' ? '#a855f7' : d.ring, icon: d.accretion ? '●' : null };
    case 'portal_theme': return { background: `conic-gradient(${[...(d.disk || ['#a855f7']), (d.disk || ['#a855f7'])[0]].join(', ')})`, icon: '●' };
    case 'world_theme': return { background: `linear-gradient(135deg, ${(d.nebula || [255]).slice(0, 3).map((h) => `hsl(${h}, 70%, 35%)`).join(', ')}${(d.nebula || []).length < 2 ? ', #04030d' : ''})` };
    case 'title': return { background: '#2a2640', icon: '🏷️' };
    default: return { background: '#2a2640' };
  }
}

/** What a screen reader hears for a thumb. */
export const thumbLabel = (item, { owned, equipped }) => `${item.name}, ${equipped ? 'equipped' : owned ? 'owned' : `${item.price}★`}`;

function Thumb({ item, owned, equipped, selected, onPick }) {
  const url = item.kind === 'ship_shape' ? spriteUrl(item.data?.sprite) : null;
  const [broken, setBroken] = useState(false);
  const sw = swatchFor(item);
  const ref = useRef(null);
  // Keep the picked thumb in view as you flip with ‹ › — scrolling ONLY the strip (scrollIntoView
  // would also nudge the page's own overflow-hidden boxes).
  useEffect(() => {
    const el = ref.current; const strip = el?.parentElement;
    if (!selected || !el || !strip) return;
    const left = el.offsetLeft; // the strip is `relative`, so this is from its own edge
    const right = left + el.offsetWidth;
    if (left < strip.scrollLeft) strip.scrollLeft = left;
    else if (right > strip.scrollLeft + strip.clientWidth) strip.scrollLeft = right - strip.clientWidth;
  }, [selected]);
  const showImg = url && !broken;
  return (
    <button ref={ref} type="button" onClick={onPick} aria-pressed={selected} aria-label={thumbLabel(item, { owned, equipped })}
      data-testid={`market-thumb-${item.item_id}`} data-selected={selected || undefined} data-owned={owned || undefined} data-equipped={equipped || undefined}
      className={`relative h-12 w-12 shrink-0 overflow-hidden rounded-xl border ${selected ? 'border-white outline outline-2 outline-offset-2 outline-white' : 'border-white/15'}`}
      style={showImg ? { background: '#120e26' } : { background: sw.background, boxShadow: sw.ring ? `inset 0 0 0 3px ${sw.ring}` : undefined }}>
      {showImg
        ? <img src={url} alt="" loading="lazy" decoding="async" draggable="false" data-testid="market-thumb-img" onError={() => setBroken(true)} className="h-full w-full object-contain p-0.5" />
        : sw.icon && <span aria-hidden="true" className="text-lg leading-none text-white drop-shadow">{sw.icon}</span>}
      {equipped
        ? <span data-testid="market-thumb-on" className="absolute left-0.5 top-0.5 rounded bg-cyan-400 px-1 text-[9px] font-black leading-[13px] text-black">ON</span>
        : owned
        ? <span className="absolute right-0.5 top-0.5 rounded-full bg-emerald-500 px-1 text-[9px] font-black leading-[14px] text-white">✓</span>
        : <span className="absolute inset-x-0 bottom-0 bg-black/70 text-center text-[9px] font-black leading-[13px] text-amber-200">{item.price}★</span>}
    </button>
  );
}

/**
 * @param {{ items: any[], owned: Set<string>, equippedId: string|null|undefined, selectedId: string|null|undefined, onPick: (index: number) => void }} props
 */
export default function ThumbStrip({ items, owned, equippedId, selectedId, onPick }) {
  if (!items.length) return null;
  return (
    <div data-testid="market-thumbs" role="group" aria-label="Items" className="relative flex min-w-0 gap-1.5 overflow-x-auto overscroll-x-contain p-1" style={{ scrollbarWidth: 'none' }}>
      {items.map((c, i) => (
        <Thumb key={c.item_id} item={c} owned={c.price === 0 || owned.has(c.item_id)} equipped={c.item_id === equippedId} selected={c.item_id === selectedId} onPick={() => onPick(i)} />
      ))}
    </div>
  );
}
