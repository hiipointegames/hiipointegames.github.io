import React, { useEffect, useMemo, useRef, useState } from 'react';
import { ModeHeader, PrimaryButton } from '../ui';
import { supabase } from '@/transport/supabaseClient';
import { fetchCatalog, fetchMyItems, buyItem, equipItem, refreshStarBalance, useStarBalance } from '../stars';
import { drawShip, lookFrom, saveLook, trailColor } from '../../world/shipArt';
import EarnSheet from './EarnSheet';
import ThumbStrip from './ThumbStrip';

// The Star Market — a HANGAR (David, 2026-10-14: "look like a spaceship dock with the stars in the
// background and your ship present in the bay and it changes with the upgrades you cycle through").
// Flip through any slot and the ship in the bay wears it at once; Buy (with ★ on the account) or
// Equip. The server checks every purchase (sector73_buy / sector73_equip).

export const SLOTS = Object.freeze([
  { kind: 'ship_color', label: 'Colour' }, { kind: 'trail', label: 'Trail' }, { kind: 'ship_shape', label: 'Shape' },
  { kind: 'title', label: 'Title' }, { kind: 'frame', label: 'Frame' },
  { kind: 'portal_theme', label: 'Portal' }, { kind: 'world_theme', label: 'World' },
]);

/** The tabs in two rows: what the ship wears, and what everyone else sees (you + your world). */
export const TAB_ROWS = Object.freeze([
  { label: 'Ship', kinds: ['ship_color', 'trail', 'ship_shape'] },
  { label: 'You', kinds: ['title', 'frame', 'portal_theme', 'world_theme'] },
]);

export const RARITY_STYLE = Object.freeze({
  common: { label: 'Common', cls: 'border-slate-400/50 text-slate-200' },
  rare: { label: 'Rare', cls: 'border-sky-300/70 text-sky-200' },
  legendary: { label: 'Legendary', cls: 'border-amber-300/80 text-amber-200' },
});
const SET_NAME = { mirror: 'Mirror', supernova: 'Supernova', aurora: 'Aurora', void: 'Void' };

/** Is a limited-time item buyable now? (The server checks too.) */
export const availableNow = (item, now = Date.now()) =>
  !(item?.available_from && now < Date.parse(item.available_from)) && !(item?.available_until && now >= Date.parse(item.available_until));

/** Owned share of the catalogue (free defaults count as owned): { owned, total, pct }. */
export function collectionProgress(catalog, owned) {
  const total = (catalog || []).length;
  const have = (catalog || []).filter((c) => c.price === 0 || owned.has(c.item_id)).length;
  return { owned: have, total, pct: total ? Math.round((have / total) * 100) : 0 };
}

/** What the action button says for an item. */
export function actionFor(item, { owned, equipped, balance }) {
  if (!item) return { label: '—', can: false };
  if (equipped) return { label: 'Equipped ✓', can: false, act: null };
  if (item.price === 0 || owned) return { label: 'Equip', can: true, act: 'equip' };
  if (!availableNow(item)) return { label: 'Not available now', can: false, act: null };
  if (balance < item.price) return { label: `Need ${item.price - balance} more ★`, can: false, act: null };
  return { label: `Buy · ${item.price}★`, can: true, act: 'buy' };
}

function HangarCanvas({ look, slot }) {
  const ref = useRef(null);
  const lookRef = useRef(look);
  lookRef.current = look;
  const slotRef = useRef(slot);
  slotRef.current = slot;
  useEffect(() => {
    const canvas = ref.current;
    const g = canvas?.getContext?.('2d');
    if (!canvas || !g) return undefined;
    const dpr = Math.min(2, globalThis.devicePixelRatio || 1);
    const W = canvas.clientWidth; const H = canvas.clientHeight;
    canvas.width = W * dpr; canvas.height = H * dpr; g.scale(dpr, dpr);
    let s = 11;
    const rnd = () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
    const winH = H * 0.5;
    const stars = Array.from({ length: 140 }, () => ({ x: rnd() * W, y: rnd() * winH, z: 0.3 + rnd() * 1.2 }));
    const exhaust = [];
    let shoot = null;
    let raf = 0;
    const t0 = performance.now();
    const frame = (now) => {
      const t = (now - t0) / 1000;
      const L = lookRef.current;
      // The bay window: deep space drifting past, in the world theme's nebula colours.
      g.fillStyle = '#04030d'; g.fillRect(0, 0, W, H);
      L.nebula.slice(0, 3).forEach((hue, i) => {
        const nx = ((i * 0.37 + t * 0.004) % 1) * W; const ny = winH * (0.3 + i * 0.2);
        const grad = g.createRadialGradient(nx, ny, 0, nx, ny, W * 0.45);
        grad.addColorStop(0, `hsla(${hue}, 80%, 45%, 0.28)`); grad.addColorStop(1, 'hsla(0,0%,0%,0)');
        g.fillStyle = grad; g.fillRect(0, 0, W, winH);
      });
      for (const st of stars) {
        st.x -= st.z * 0.25; if (st.x < 0) st.x += W;
        g.fillStyle = `rgba(226, 232, 255, ${0.4 + st.z * 0.45})`; g.fillRect(st.x, st.y, st.z * 1.4, st.z * 1.4);
      }
      if (!shoot && rnd() < 0.006) shoot = { x: W * (0.2 + rnd() * 0.8), y: winH * rnd() * 0.5, age: 0 };
      if (shoot) {
        shoot.age += 1 / 60; shoot.x -= 9; shoot.y += 4;
        g.strokeStyle = `rgba(255,255,255,${1 - shoot.age})`; g.lineWidth = 2;
        g.beginPath(); g.moveTo(shoot.x, shoot.y); g.lineTo(shoot.x + 40, shoot.y - 18); g.stroke();
        if (shoot.age > 1) shoot = null;
      }
      // Portal preview in the window, on the Portal tab.
      if (slotRef.current === 'portal_theme') {
        const px = W * 0.78; const py = winH * 0.42;
        L.portal.forEach((c, i) => {
          const a = t * (1.5 + i * 0.3) + i * 1.6;
          g.strokeStyle = c; g.lineWidth = 5; g.beginPath(); g.arc(px, py, 26 + i * 4, a, a + 1.8); g.stroke();
        });
        g.fillStyle = '#000'; g.beginPath(); g.arc(px, py, 18, 0, Math.PI * 2); g.fill();
        g.strokeStyle = '#fff'; g.lineWidth = 1.5; g.stroke();
      }
      // The window frame: struts and a hazard-striped sill.
      g.fillStyle = '#1e1b2e'; g.fillRect(0, winH, W, H - winH);
      g.fillStyle = '#2a2640';
      for (let x = -20; x < W; x += W / 4) g.fillRect(x, 0, 10, winH);
      for (let x = -40; x < W + 40; x += 28) {
        g.fillStyle = (Math.round(x / 28) % 2) ? '#facc15' : '#111827';
        g.beginPath(); g.moveTo(x, winH); g.lineTo(x + 14, winH); g.lineTo(x + 28, winH + 10); g.lineTo(x + 14, winH + 10); g.closePath(); g.fill();
      }
      // The floor: a perspective grid to the bay doors.
      g.strokeStyle = 'rgba(167, 139, 250, 0.22)'; g.lineWidth = 1;
      const vx = W / 2; const floorTop = winH + 10;
      for (let i = -8; i <= 8; i++) { g.beginPath(); g.moveTo(vx + i * 10, floorTop); g.lineTo(vx + i * W * 0.22, H); g.stroke(); }
      for (let k = 1; k < 8; k++) { const y = floorTop + (H - floorTop) * (k / 8) ** 1.6; g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke(); }
      // Spotlights.
      [0.25, 0.75].forEach((fx) => {
        const cone = g.createLinearGradient(0, winH, 0, H);
        cone.addColorStop(0, 'rgba(255, 248, 220, 0.16)'); cone.addColorStop(1, 'rgba(255, 248, 220, 0)');
        g.fillStyle = cone; g.beginPath(); g.moveTo(W * fx - 6, winH + 10); g.lineTo(W / 2 - 70, H); g.lineTo(W / 2 + 70, H); g.lineTo(W * fx + 6, winH + 10); g.closePath(); g.fill();
      });
      // The landing pad and the ship, hovering.
      const cx = W / 2; const cy = H * 0.68 + Math.sin(t * 1.6) * 4;
      const pad = g.createRadialGradient(cx, H * 0.82, 0, cx, H * 0.82, 110);
      pad.addColorStop(0, `${L.glow}88`); pad.addColorStop(1, 'rgba(0,0,0,0)');
      g.fillStyle = pad; g.beginPath(); g.ellipse(cx, H * 0.82, 110, 22, 0, 0, Math.PI * 2); g.fill();
      // Exhaust in the trail's colours (sparkles for Stardust).
      exhaust.push({ x: cx + (rnd() - 0.5) * 8, y: cy + 50, v: 1 + rnd() * 1.5, age: 0, i: exhaust.length });
      for (const p of exhaust) { p.y += p.v; p.age += 1 / 60; }
      while (exhaust.length && exhaust[0].age > 0.9) exhaust.shift();
      exhaust.forEach((p, i) => {
        g.globalAlpha = Math.max(0, 1 - p.age / 0.9) * 0.8;
        g.fillStyle = trailColor(L, i, exhaust.length);
        const r = L.trail.sparkle ? 1.6 : 3.5 - p.age * 2;
        g.beginPath(); g.arc(p.x, p.y, Math.max(0.5, r), 0, Math.PI * 2); g.fill();
      });
      g.globalAlpha = 1;
      g.save(); g.translate(cx, cy);
      drawShip(g, { angle: -Math.PI / 2, thrust: 0.35 + Math.sin(t * 3) * 0.1 }, 3.4, t, L);
      g.restore();
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);
    return () => cancelAnimationFrame(raf);
  }, []);
  return <canvas ref={ref} data-testid="hangar-canvas" className="h-full w-full" aria-label="Your ship in the hangar" />;
}

/** Every item, owned or still a silhouette, slot by slot, with set progress (David: "collection book"). */
function CollectionBook({ catalog, owned, onClose, onPick }) {
  const prog = collectionProgress(catalog, owned);
  const sets = [...new Set(catalog.filter((c) => c.set_id).map((c) => c.set_id))];
  const has = (c) => c.price === 0 || owned.has(c.item_id);
  return (
    <div data-testid="collection-book" className="absolute inset-0 z-40 overflow-y-auto bg-[#07051a] px-4 pb-6" style={{ paddingTop: 'calc(env(safe-area-inset-top, 0px) + 56px)' }}>
      <div className="flex items-center justify-between">
        <div className="text-lg font-black text-white">📖 Collection · {prog.owned}/{prog.total} ({prog.pct}%)</div>
        <button type="button" onClick={onClose} className="rounded-full border border-white/20 px-3 py-1 text-sm text-white">Close</button>
      </div>
      <div className="mt-2 space-y-1">
        {sets.map((id) => {
          const pieces = catalog.filter((c) => c.set_id === id);
          const got = pieces.filter(has).length;
          return <div key={id} data-testid={`book-set-${id}`} className="text-xs text-fuchsia-200">{SET_NAME[id] || id} set · {got}/{pieces.length}{got === pieces.length ? ' ✓ — equip it all for the set aura' : ''}</div>;
        })}
      </div>
      {SLOTS.map((s) => (
        <div key={s.kind} className="mt-3">
          <div className="text-[11px] uppercase tracking-[0.3em] text-violet-300">{s.label}</div>
          <div className="mt-1 grid grid-cols-3 gap-1.5">
            {catalog.filter((c) => c.kind === s.kind).map((c) => (
              <button key={c.item_id} type="button" onClick={() => onPick(c)} data-owned={has(c) || undefined}
                className={`rounded-lg border px-1.5 py-2 text-left text-[11px] font-bold ${has(c) ? RARITY_STYLE[c.rarity || 'common'].cls : 'border-white/10 text-slate-600'}`}>
                {has(c) ? c.name : '? ? ?'}
                <div className="text-[9px] font-normal opacity-70">{RARITY_STYLE[c.rarity || 'common'].label}{has(c) ? '' : ` · ${c.price}★`}</div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  );
}

export default function StarMarketMode({ onExit, onReturnTo37 }) {
  const balance = useStarBalance();
  const [catalog, setCatalog] = useState(null);
  const [owned, setOwned] = useState(() => new Set());
  const [loadout, setLoadout] = useState({});
  const [slot, setSlot] = useState('ship_color');
  const [index, setIndex] = useState(0);
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState(null);
  const [pilot, setPilot] = useState('Pilot');
  const [book, setBook] = useState(false); // the Collection book
  const [earn, setEarn] = useState(false); // the How to earn ★ sheet

  useEffect(() => {
    let live = true;
    Promise.all([fetchCatalog(), fetchMyItems(), refreshStarBalance(), supabase.auth.getUser()])
      .then(([cat, mine, , { data }]) => {
        if (!live) return;
        setCatalog(cat); setOwned(mine.owned); setLoadout(mine.loadout);
        setPilot(data?.user?.user_metadata?.username || 'Pilot');
      })
      .catch(() => live && setMessage('The Star Market is out of reach — check your connection.'));
    return () => { live = false; };
  }, []);

  const items = useMemo(() => (catalog || []).filter((c) => c.kind === slot), [catalog, slot]);
  // Open each slot on what you have equipped.
  useEffect(() => {
    const at = items.findIndex((c) => c.item_id === loadout[slot]);
    setIndex(at >= 0 ? at : 0);
    setMessage(null);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [slot, catalog]);
  const item = items[index] || null;
  const preview = useMemo(() => lookFrom(catalog || [], { ...loadout, [slot]: item?.item_id ?? loadout[slot] }), [catalog, loadout, slot, item]);
  const equippedId = loadout[slot] ?? items.find((c) => c.price === 0)?.item_id;
  const action = actionFor(item, { owned: item ? owned.has(item.item_id) : false, equipped: item?.item_id === equippedId, balance });

  const act = async () => {
    if (!item || !action.can || busy) return;
    setBusy(true); setMessage(null);
    try {
      if (action.act === 'buy') {
        await buyItem(item.item_id);
        setOwned((o) => new Set([...o, item.item_id]));
      }
      await equipItem(slot, item.item_id);
      const next = { ...loadout, [slot]: item.item_id };
      setLoadout(next);
      const look = lookFrom(catalog, next);
      saveLook(look);
      globalThis.dispatchEvent?.(new CustomEvent('sector73:look', { detail: look }));
      setMessage(action.act === 'buy' ? `${item.name} is yours — equipped.` : `${item.name} equipped.`);
    } catch (e) {
      setMessage(/sign in/i.test(e.message) ? 'Sign in to shop with ★.' : e.message);
    } finally {
      setBusy(false);
    }
  };
  // A new item clears the last item's "… is yours" line, as a thumbnail pick already did (sweep 2026-10-20).
  const step = (d) => { if (!items.length) return; setIndex((i) => (i + d + items.length) % items.length); setMessage(null); };

  return (
    <div className="relative isolate flex h-full flex-col overflow-hidden bg-[#04030d]">
      <ModeHeader title="Star Market" subtitle="Hangar" onExit={onExit} onReturnTo37={onReturnTo37} />
      <div className="relative min-h-0 flex-1">
        <HangarCanvas look={preview} slot={slot} />
        {/* The market's top bar: the balance and, beside it, how to earn more (M1). In the ModeHeader
            row it squeezed "Star Market" to "Star M…" at 360 px. */}
        <div className="absolute right-3 top-2 flex items-center gap-1.5">
          <button type="button" data-testid="market-earn" onClick={() => setEarn(true)}
            className="min-h-[44px] whitespace-nowrap rounded-full border border-amber-300/50 bg-black/50 px-3 text-xs font-bold text-amber-100 active:scale-95">How to earn ★</button>
          <div className="rounded-full border border-amber-300/50 bg-black/50 px-3 py-1 text-sm font-black text-amber-200" data-testid="market-balance">★ {balance}</div>
        </div>
        <button type="button" data-testid="market-book" onClick={() => setBook(true)}
          className="absolute left-3 top-2 rounded-full border border-violet-300/50 bg-black/50 px-3 py-1 text-xs font-bold text-violet-100">
          📖 Collection {collectionProgress(catalog, owned).pct}%
        </button>
        {/* The nameplate previews titles and frames. */}
        <div className="absolute inset-x-0 bottom-2 flex justify-center" data-testid="market-nameplate">
          <div className="flex items-center gap-2 rounded-full bg-black/60 px-3 py-1">
            <span className="grid h-6 w-6 place-items-center rounded-full bg-violet-900 text-[11px] font-black text-white"
              style={{ boxShadow: preview.frame ? `0 0 0 2px ${preview.frame.ring}${preview.frame.glow ? `, 0 0 10px ${preview.frame.ring === '#000000' ? '#a855f7' : preview.frame.ring}` : ''}` : 'none' }}>
              {pilot.slice(0, 1).toUpperCase()}
            </span>
            <span className="text-sm font-bold text-white">{pilot}</span>
            {preview.title && <span className="text-xs font-bold text-amber-200">· {preview.title}</span>}
          </div>
        </div>
      </div>
      <div className="space-y-2 bg-[#0b0820] px-3 pb-4 pt-2">
        {/* Two labelled rows that always fit (world lane 2026-10-22): one scrolling row of 7 hid
            "World" off-screen at 360 AND 384 px, and nothing said there was more. */}
        <div className="space-y-1" role="tablist" aria-label="Item types">
          {TAB_ROWS.map((row) => (
            <div key={row.label} className="flex items-center gap-1" data-testid={`market-tab-row-${row.label.toLowerCase()}`}>
              <span className="w-9 shrink-0 text-[10px] font-black uppercase tracking-wider text-slate-400">{row.label}</span>
              {row.kinds.map((kind) => {
                const s = SLOTS.find((x) => x.kind === kind);
                return (
                  <button key={kind} type="button" role="tab" aria-selected={slot === kind} data-testid={`market-tab-${kind}`} onClick={() => setSlot(kind)}
                    className={`shrink-0 rounded-full px-3 py-1 text-xs font-bold ${slot === kind ? 'bg-violet-500 text-white' : 'border border-violet-300/30 text-violet-200'}`}>
                    {s?.label}
                  </button>
                );
              })}
            </div>
          ))}
        </div>
        <div className="flex items-center gap-2">
          <button type="button" aria-label="Previous" data-testid="market-prev" onClick={() => step(-1)} className="h-12 w-12 shrink-0 rounded-xl border border-white/15 text-2xl text-white">‹</button>
          <div className="min-w-0 flex-1 text-center">
            <div data-testid="market-item" className="truncate text-lg font-black text-white">{item ? item.name : catalog ? '—' : 'Loading…'}</div>
            <div className="flex flex-wrap items-center justify-center gap-1 text-xs text-slate-400">
              {item && <span data-testid="market-rarity" className={`rounded-full border px-1.5 text-[10px] font-black uppercase ${RARITY_STYLE[item.rarity || 'common'].cls}`}>{RARITY_STYLE[item.rarity || 'common'].label}</span>}
              {item?.set_id && <span data-testid="market-set" className="text-[10px] font-bold text-fuchsia-200">{SET_NAME[item.set_id] || item.set_id} set</span>}
              {item && <span data-testid="market-price">{item.price === 0 ? 'Free' : owned.has(item.item_id) ? 'Owned' : `${item.price}★`}</span>}
              {item?.available_until && <span data-testid="market-limited" className="text-[10px] font-bold text-rose-200">⏳ until {new Date(item.available_until).toLocaleDateString()}</span>}
            </div>
          </div>
          <button type="button" aria-label="Next" data-testid="market-next" onClick={() => step(1)} className="h-12 w-12 shrink-0 rounded-xl border border-white/15 text-2xl text-white">›</button>
        </div>
        <ThumbStrip items={items} owned={owned} equippedId={equippedId} selectedId={item?.item_id} onPick={(i) => { setIndex(i); setMessage(null); }} />
        <div className="min-h-[18px] text-center text-xs text-amber-100" aria-live="polite">{message}</div>
        <PrimaryButton tone="violet" testId="market-action" disabled={!action.can || busy} onClick={act}>{busy ? '…' : action.label}</PrimaryButton>
      </div>
      {earn && <EarnSheet onClose={() => setEarn(false)} />}
      {book && <CollectionBook catalog={catalog || []} owned={owned} onClose={() => setBook(false)} onPick={(it) => { setSlot(it.kind); setBook(false); setTimeout(() => setIndex((catalog || []).filter((c) => c.kind === it.kind).findIndex((c) => c.item_id === it.item_id)), 0); }} />}
    </div>
  );
}
