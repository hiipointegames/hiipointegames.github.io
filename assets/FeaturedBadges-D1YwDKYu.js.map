import React from 'react';
import { motion } from 'framer-motion';
import { getStreakStyles } from '@/stats-visuals';
import { STREAK_MILESTONES } from '@/game-mechanics';

// One daily-challenge streak card (the big number + tier emoji + neon frame).
//
// Extracted so BOTH the own-stats page (Statistics) and another player's profile
// (OtherProfile) render streaks from the SAME presentation source, getStreakStyles
// — the rarity/heat tierStyles bundle. OtherProfile previously rendered its own
// card off getStreakTier().config (STREAK_ICON_CONFIGS, a different palette), so
// the same streak looked different depending on whose profile you viewed (#5).
// The markup mirrors Statistics' streak card exactly; the styles come from one
// place, so the two pages can't drift in colour again.
//
// ─────────────────────────────────────────────────────────────────────────────
// D4 — THREE INDEPENDENT STREAKS, AND THE DIFFERENCE BETWEEN 0 AND UNMEASURED
// ─────────────────────────────────────────────────────────────────────────────
// Q-F rules three independent Daily streaks. Two new props carry what a trio of
// these cards needs and a single card never did:
//
//   `accent`  — the mode's colour, so three cards side by side are legible as
//               three different games rather than three copies of one number.
//
//   `tracked` — whether anything measures this streak yet. This is NOT the same
//               question as "is the streak zero", and conflating them is the
//               whole reason the prop exists: game_stats.perMode is absent on an
//               old server (seam 3.5), and Easy's and Expert's Dailies do not
//               exist in production data at all yet. Rendering that as a big
//               fat `0` tells a player they broke a streak in a mode that has
//               never had a puzzle. Untracked cards show an em-dash and say so.
//
// `sublabel` carries the longest-streak figure inside the card, so three modes
// fit in the space two cards used to take.
//
/** @type {(props: { streak?: number, label: string, sublabel?: string, accent?: string, tracked?: boolean }) => JSX.Element} */
export default function StreakCard({ streak = 0, label, sublabel, accent, tracked = true }) {
  const styles = getStreakStyles(streak);
  const reached = tracked && streak >= STREAK_MILESTONES[0];
  return (
    <motion.div
      whileHover={{ scale: 1.05, y: -5 }}
      animate={{ boxShadow: styles.glow }}
      transition={{ boxShadow: { duration: 2, repeat: Infinity, ease: 'easeInOut' } }}
      className={`relative rounded-xl sm:rounded-2xl p-4 sm:p-6 border-2 sm:border-3 overflow-hidden transition-all duration-300 ${styles.bg} ${tracked ? '' : 'opacity-70'}`}
      style={accent ? { borderColor: accent } : undefined}
    >
      {reached && (
        <>
          <motion.div
            animate={{ scale: [1, 1.1, 1] }}
            transition={{ duration: 2, repeat: Infinity }}
            className={`absolute inset-0 pointer-events-none ${styles.innerBg}`}
          />
          <div className={`absolute top-0 left-0 right-0 h-0.5 sm:h-1 bg-gradient-to-r ${styles.line}`} />
        </>
      )}

      <div className="text-center relative z-10">
        <div className="flex items-center justify-center gap-1 sm:gap-2 mb-1 sm:mb-2">
          {tracked && styles.emoji && (
            <motion.div animate={styles.animate} transition={{ duration: 3, repeat: Infinity }}>
              <span className="text-2xl sm:text-3xl">{styles.emoji}</span>
            </motion.div>
          )}
          <div
            className="text-4xl sm:text-6xl font-black"
            style={tracked ? styles.numberStyle : undefined}
          >
            {tracked ? (streak || 0) : '—'}
          </div>
        </div>
        <div
          className={`text-xs sm:text-base font-bold uppercase tracking-wider ${accent ? '' : styles.labelColor}`}
          style={accent ? { color: accent } : undefined}
        >
          {label}
        </div>
        {/* The untracked note wins over the sublabel: with nothing measured, a
            "Longest 0" line underneath would be the same lie one size smaller. */}
        {!tracked ? (
          <div className="text-[10px] text-slate-400 mt-1 leading-tight">Not tracked yet</div>
        ) : sublabel ? (
          <div className="text-[10px] text-slate-400 mt-1 leading-tight">{sublabel}</div>
        ) : null}
      </div>
    </motion.div>
  );
}
