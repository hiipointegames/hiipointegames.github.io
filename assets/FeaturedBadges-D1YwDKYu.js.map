import React, { useMemo, useState } from 'react';
import { Link } from 'react-router-dom';

import { BADGES } from '@/game-mechanics';
import { useSector73Enabled, sector73BadgeCatalog } from '@/sector73';
import { createPageUrl } from '@/routing/createPageUrl';
import BadgeCard from './BadgeCard';
import BadgeDetailModal from './BadgeDetailModal';
import { BADGE_SYSTEM_LAUNCH_DATE } from './badgeShowcaseModel';
import { formatEarnedDate } from './badgeVisuals';
import { featuredBadgeRows, FEATURED_ROW_LIMIT } from './featuredBadgesModel';

// FeaturedBadges — L1 of the badge drill-down (Badge System Redesign, Lane G).
//
// L1 is this: a ONE-SCREEN teaser. L2 is the full showcase (/Badges), L3 the
// detail modal. Two labelled rows spanning every mode — ✦ Just earned and
// ◗ So close — plus the one CTA that opens L2. It deliberately does NOT scroll:
// if the rows ever grow past a screen, lower the limit, don't add scrolling —
// scrolling is what L2 is for.
//
// PROPS-ONLY AND PLAYER-AGNOSTIC. It never reads the signed-in user, never
// fetches, and never derives badge state — the host page resolves WHO is being
// viewed and hands over `badgeState` (Lanes B/D merged with
// `buildBadgeStateIndex`). That is what lets the SAME component mount on your
// own Statistics page and on another player's profile card.
//
// WHAT CHANGES FOR ANOTHER PLAYER (`isOwnStats={false}`):
//   - "Just earned" becomes "Top badges" — you're browsing their case, not
//     being congratulated.
//   - "So close" keeps its heading (it reads as their progress, not your
//     to-do list) and the footer nudge is dropped.
//   - "View all badges" carries `?id=&name=` so L2 opens on THEM, the same
//     convention Statistics already uses.
//   - The L3 modal opened from these cards inherits the same signal, so its
//     retroactive explainer says "<name> earned this", not "You earned this".
//   - No celebration is ever fired from here — celebrations belong to the
//     current user only, and this component fires none at all.

/**
 * One row of badge cards under a labelled heading.
 * @param {Object} props
 */
function FeaturedRow({ testId, glyph, title, entries, emptyText, onSelect, showDates = false }) {
  return (
    <section data-testid={testId} className="mb-3 last:mb-0">
      <h3
        className="mb-1.5 text-[11px] font-black uppercase tracking-[0.18em]"
        style={{ color: 'var(--u37-muted)' }}
      >
        <span aria-hidden className="mr-1">{glyph}</span>
        {title}
      </h3>

      {entries.length === 0 ? (
        <p data-testid={`${testId}-empty`} className="text-[11px] py-2" style={{ color: 'var(--u37-muted)' }}>
          {emptyText}
        </p>
      ) : (
        <ul className="grid grid-cols-4 gap-2 list-none p-0 m-0">
          {entries.map((entry) => (
            <li key={entry.badge.id} className="flex flex-col">
              <BadgeCard badge={entry.badge} state={entry.state} onSelect={onSelect} />
              {/* Solo-Blitz badges and First Podium have NO earned date by
                  construction — render nothing rather than an empty line. */}
              {showDates && entry.state?.earliestDate && (
                <span
                  data-testid="featured-badge-date"
                  className="mt-1 text-center text-[9px] font-semibold leading-tight"
                  style={{ color: 'var(--u37-muted)' }}
                >
                  {formatEarnedDate(entry.state.earliestDate)}
                </span>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  );
}

/**
 * @param {Object} props
 * @param {import('@/game-mechanics/badgeRegistry').Badge[]} [props.badges] Registry catalog; defaults to the whole thing.
 * @param {Record<string, any>} [props.badgeState] Merged Lane B/D state, keyed by registry badge id.
 * @param {boolean} [props.isOwnStats] False when viewing another player.
 * @param {string} [props.playerId] The viewed player's id — forwarded to L2 as `?id=`.
 * @param {string} [props.playerName] The viewed player's name — forwarded as `?name=` and used in copy.
 * @param {boolean} [props.loading]
 * @param {number} [props.limit] Cards per row (default 4 — one screen).
 * @param {string} [props.launchDate] ISO badge-system launch date; drives the retroactive ribbon in L3.
 * @param {Record<string, {tier: number, date: string}>} [props.earnedStamps] OWN page only — the day each
 *   badge's pop-up was shown (@/game-flow readEarnedStamps). Lets dateless ladders (podiums, streaks) rank
 *   in "Just earned". Never pass another player's page this device's stamps.
 * @param {string} [props.className]
 */
export default function FeaturedBadges({
  badges: catalog = BADGES,
  badgeState = {},
  isOwnStats = true,
  playerId,
  playerName,
  loading = false,
  limit = FEATURED_ROW_LIMIT,
  launchDate = BADGE_SYSTEM_LAUNCH_DATE,
  earnedStamps,
  className = '',
}) {
  // Sector 73's badges (Looking Glass) exist only while Sector 73 is switched on: off, they are
  // not in the grid, the counts or the "x of N" total — the showcase is the 37 one.
  const s73On = useSector73Enabled();
  const badges = useMemo(() => sector73BadgeCatalog(catalog, s73On), [catalog, s73On]);
  const [selected, setSelected] = useState(
    /** @type {import('@/game-mechanics/badgeRegistry').Badge | null} */(null),
  );

  const { justEarned, soClose, earnedCount } = useMemo(
    () => featuredBadgeRows(badges, badgeState, { limit, earnedStamps: isOwnStats ? earnedStamps : undefined }),
    [badges, badgeState, limit, isOwnStats, earnedStamps],
  );

  // L2 opens on whoever L1 is showing. `?id=` is the same convention Statistics
  // uses, so the id this page already holds forwards unchanged.
  const viewAllHref = useMemo(() => {
    const base = createPageUrl('Badges');
    if (isOwnStats || !playerId) return base;
    const params = new URLSearchParams({ id: playerId });
    if (playerName) params.set('name', playerName);
    return `${base}?${params.toString()}`;
  }, [isOwnStats, playerId, playerName]);

  const who = playerName || 'This player';

  return (
    <div data-testid="featured-badges" className={className}>
      <header className="mb-2 flex items-end justify-between gap-2">
        <h2 className="text-base font-black tracking-wide" style={{ color: 'var(--u37-text)' }}>
          {isOwnStats ? 'Badges' : `${who}${who.endsWith('s') ? "'" : "'s"} Badges`}
        </h2>
        <span data-testid="featured-badges-count" className="text-[11px] font-semibold" style={{ color: 'var(--u37-muted)' }}>
          {earnedCount} of {badges.length} earned
        </span>
      </header>

      {loading ? (
        <p data-testid="featured-badges-loading" className="text-center text-sm py-6" style={{ color: 'var(--u37-muted)' }}>
          Loading badges…
        </p>
      ) : (
        <>
          <FeaturedRow
            testId="featured-just-earned"
            glyph="✦"
            title={isOwnStats ? 'Just earned' : 'Top badges'}
            entries={justEarned}
            emptyText={isOwnStats
              ? 'No badges yet — solve a puzzle to earn your first.'
              : `${who} hasn't earned any badges yet.`}
            onSelect={setSelected}
            showDates
          />

          <FeaturedRow
            testId="featured-so-close"
            glyph="◗"
            title="So close"
            entries={soClose}
            emptyText={isOwnStats
              ? 'Start a run in any mode and your next badge will show up here.'
              : 'Nothing in progress right now.'}
            onSelect={setSelected}
          />

          <Link
            data-testid="featured-badges-view-all"
            to={viewAllHref}
            className="mt-1 block w-full rounded-xl border py-2.5 text-center text-sm font-black transition-transform active:scale-[0.98]"
            style={{
              borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
              background: 'color-mix(in srgb, var(--u37-gold) 12%, transparent)',
              color: 'var(--u37-gold)',
            }}
          >
            View all badges →
          </Link>
        </>
      )}

      <BadgeDetailModal
        isOpen={Boolean(selected)}
        onClose={() => setSelected(null)}
        badge={selected ?? undefined}
        state={selected ? badgeState[selected.id] : undefined}
        launchDate={launchDate}
        isOwnStats={isOwnStats}
        playerName={playerName}
      />
    </div>
  );
}
