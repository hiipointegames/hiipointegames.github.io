import React from 'react';
import { motion } from 'framer-motion';
import { AlertTriangle, RefreshCw } from 'lucide-react';
import { Button } from '@/ui/primitives/button';

// Inline error state for the stats surfaces (Statistics page + OtherProfile).
//
// WHY THIS EXISTS: when the player-stats edge call fails (e.g. a backend
// outage like the 2026-06-22 service-role key rotation), the pages used to
// render an all-zero / stale-but-confident stats screen with no signal that
// anything was wrong — indistinguishable from "your stats were erased". This
// component makes a load failure VISIBLE and recoverable instead of silently
// showing wrong data. The happy path never renders this — it only appears when
// a load genuinely fails.
//
// Presentational only: no data dependencies, so it is trivially unit-testable.
export default function StatsLoadError({ onRetry, viewingOther = false }) {
  const subject = viewingOther ? "this player's stats" : 'your stats';

  return (
    <motion.div
      initial={{ opacity: 0, y: 8 }}
      animate={{ opacity: 1, y: 0 }}
      role="alert"
      className="max-w-md mx-auto mt-12 bg-slate-800/70 backdrop-blur-md rounded-2xl p-6
        border border-amber-500/40 text-center shadow-[0_8px_24px_rgba(0,0,0,0.4)]"
    >
      <div className="flex justify-center mb-3">
        <AlertTriangle className="w-10 h-10 text-amber-400" />
      </div>
      <h2 className="text-xl font-black text-white mb-2">Couldn&apos;t load {subject}</h2>
      <p className="text-slate-300 text-sm mb-5">
        This is a temporary problem reaching the server — your data is safe. Please try again.
      </p>
      <Button
        onClick={onRetry}
        className="bg-gradient-to-r from-indigo-600 to-purple-700 hover:from-indigo-700 hover:to-purple-800
          text-white border border-purple-500/50 min-h-[48px] px-6 touch-manipulation shadow-lg"
      >
        <RefreshCw className="w-4 h-4 mr-2" />
        Retry
      </Button>
    </motion.div>
  );
}
