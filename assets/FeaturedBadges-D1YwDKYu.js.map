// featuredBadgesModel — the pure selection layer for the L1 badge OVERVIEW
// (Badge System Redesign, Lane G, §9.2).
//
// L1 is the teaser on a stats page: two short rows that fit on ONE screen, no
// scrolling (scrolling is L2's job — the full showcase). Its whole design
// problem is CHOOSING which four badges each row shows, and that choice is pure,
// so it lives here rather than inside the component.
//
//   ✦ Just earned — the most RECENT earns, newest first.
//   ◗ So close    — the badges nearest to being earned, with a progress rail.
//
// It computes NO badge state. Input is the registry (Lane C) plus the merged
// Lane B/D state index; `tier === -1` is the shared UNEARNED sentinel and
// `earliestDate` may legitimately be null.
//
// TWO EXCLUSIONS THAT MATTER:
//   1. DATELESS earns can't be ranked by recency. Solo-Blitz badges (Solar Flare,
//      Cosmic Grind, Warp Reflex, Arena Master) and First Podium derive from
//      counters that carry no event date, so `earliestDate` is null BY
//      CONSTRUCTION. Putting them in "Just earned" would sort them arbitrarily
//      and claim a recency we don't know — so they're excluded from that row.
//      They still appear in "So close" and in the full L2 showcase.
//      EXCEPTION (2026-10-18): on the player's OWN page, a badge whose pop-up
//      this device showed carries that day as an `earnedStamps` date (see
//      @/game-flow badgeEarnedStamps) — a real recency, so it ranks. That is
//      how podium medals, streaks and speed records reach this row.
//   2. HIDDEN unearned badges never appear in "So close". A hidden badge's earn
//      pop IS its reveal (§9.4); listing it as 60% complete leaks it early.

import { badgeProgress, isBadgeEarned, pairWithState } from './badgeShowcaseModel';

/** How many cards each row shows by default — four fits one screen at L1. */
export const FEATURED_ROW_LIMIT = 4;

/**
 * @typedef {import('./badgeShowcaseModel').BadgeEntry} BadgeEntry
 */

/**
 * The most recently earned badges, newest first.
 *
 * Ranking is by the day the CURRENT tier was reached (`tierReachedDate`, falling
 * back to `earliestDate`, the day the feat was FIRST achieved) descending,
 * with registry order as the tie-break so two badges earned on the same day never
 * swap between renders. Dateless earns are excluded — see the header note.
 *
 * @param {import('@/game-mechanics/badgeRegistry').Badge[]} badges
 * @param {Record<string, any>} [stateById]
 * @param {{limit?: number, earnedStamps?: Record<string, {tier: number, date: string}>}} [opts]
 *   `earnedStamps` — own page only: the day each badge's pop-up was shown.
 * @returns {BadgeEntry[]}
 */
export function justEarnedEntries(badges = [], stateById = {}, opts = {}) {
  const limit = opts.limit ?? FEATURED_ROW_LIMIT;
  const stamps = opts.earnedStamps ?? {};

  return pairWithState(badges, stateById)
    .map((entry, index) => ({ entry, index, date: recencyDate(entry, stamps[entry.badge.id]) }))
    .filter(({ entry, date }) => isBadgeEarned(entry.state) && Boolean(date))
    .sort((a, b) => {
      const dateDiff = String(b.date).localeCompare(String(a.date));
      return dateDiff !== 0 ? dateDiff : a.index - b.index;
    })
    .slice(0, limit)
    .map(({ entry }) => entry);
}

/**
 * The later of the derived date and this device's pop-up stamp. The derived
 * date prefers `tierReachedDate` (2026-10-18): a ladder first earned in August
 * whose new tier landed today was "just earned" today, not in August. A
 * stamp counts only while the badge is still at the tier it was stamped at, so
 * it marks THAT rung's arrival and can never resurrect an older earn.
 *
 * @param {BadgeEntry} entry
 * @param {{tier: number, date: string} | undefined} stamp
 * @returns {string | null}
 */
function recencyDate(entry, stamp) {
  const day = entry.state?.tierReachedDate || entry.state?.earliestDate;
  const derived = day ? String(day) : null;
  const stamped = stamp && typeof stamp.date === 'string' && stamp.tier === entry.state?.tier ? stamp.date : null;
  if (derived && stamped) return derived > stamped ? derived : stamped;
  return derived ?? stamped;
}

/**
 * The badges closest to being earned, closest first.
 *
 * Eligibility needs a real chase: the badge must be unearned, must have a ladder
 * to climb (`badgeProgress` returns null for one-time badges and maxed ladders),
 * and must show ACTUAL movement — either a fraction above zero, or, on a
 * descending ladder, a recorded time to improve on. A badge at 0% is not "so
 * close", and saying it is would make the whole row meaningless.
 *
 * Ranking is by fraction descending. Descending ladders (fastest solve times)
 * have no honest fraction — 12s against a 10s target is not "120%" — so they
 * carry `ratio: null` and sort after the measurable ones, still ahead of nothing.
 *
 * @param {import('@/game-mechanics/badgeRegistry').Badge[]} badges
 * @param {Record<string, any>} [stateById]
 * @param {{limit?: number}} [opts]
 * @returns {Array<BadgeEntry & {progress: ReturnType<typeof badgeProgress>}>}
 */
export function soCloseEntries(badges = [], stateById = {}, opts = {}) {
  const limit = opts.limit ?? FEATURED_ROW_LIMIT;

  return pairWithState(badges, stateById)
    .map((entry, index) => ({ entry, index, progress: badgeProgress(entry.badge, entry.state) }))
    .filter(({ entry, progress }) => {
      if (isBadgeEarned(entry.state)) return false;
      if (entry.badge?.hidden) return false; // never leak a hidden badge early
      if (!progress) return false;
      return progress.ratio === null ? progress.current !== null : progress.ratio > 0;
    })
    .sort((a, b) => {
      const aRatio = a.progress.ratio ?? -1;
      const bRatio = b.progress.ratio ?? -1;
      return bRatio !== aRatio ? bRatio - aRatio : a.index - b.index;
    })
    .slice(0, limit)
    .map(({ entry, progress }) => ({ ...entry, progress }));
}

/**
 * Both rows in one call — what the component actually needs.
 * @param {import('@/game-mechanics/badgeRegistry').Badge[]} badges
 * @param {Record<string, any>} [stateById]
 * @param {{limit?: number, earnedStamps?: Record<string, {tier: number, date: string}>}} [opts]
 * @returns {{justEarned: BadgeEntry[], soClose: BadgeEntry[], earnedCount: number}}
 */
export function featuredBadgeRows(badges = [], stateById = {}, opts = {}) {
  return {
    justEarned: justEarnedEntries(badges, stateById, opts),
    soClose: soCloseEntries(badges, stateById, opts),
    earnedCount: badges.filter((badge) => isBadgeEarned(stateById?.[badge.id])).length,
  };
}
