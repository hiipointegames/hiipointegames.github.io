import { STREAK_MILESTONES, STREAK_ICON_CONFIGS } from './milestones';

/**
 * Map a daily-challenge streak length to its milestone tier.
 *
 * Single source for the streak-tier *selection* that was previously
 * reimplemented three ways: Statistics' `streak >= STREAK_MILESTONES[i]`
 * if-ladder, OtherProfile's `[...STREAK_MILESTONES].reverse().findIndex`
 * gymnastics, and MilestoneBadge's `STREAK_MILESTONES.indexOf`. The tier is
 * the highest threshold the streak has reached.
 *
 * `STREAK_MILESTONES` is strictly increasing, so for a streak that equals a
 * milestone value exactly (MilestoneBadge's case) this returns that
 * milestone's own index — i.e. the threshold and exact-lookup readings
 * coincide for real milestone inputs.
 *
 * @param {number} streak - the streak length in days.
 * @returns {{index: number, config: object} | null} the tier index (0-based,
 *   into STREAK_MILESTONES / STREAK_ICON_CONFIGS) and its visual config, or
 *   null when the streak has not reached the first milestone.
 */
export function getStreakTier(streak) {
  for (let index = STREAK_MILESTONES.length - 1; index >= 0; index--) {
    if (streak >= STREAK_MILESTONES[index]) {
      return { index, config: STREAK_ICON_CONFIGS[index] };
    }
  }
  return null;
}
