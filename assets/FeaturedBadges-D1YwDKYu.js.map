import { getStreakTier } from '@/game-mechanics';

/**
 * Presentation bundle for a daily-challenge streak card.
 *
 * @typedef {Object} StreakStyles
 * @property {string} bg - container gradient + border + shadow classes.
 * @property {string|string[]} glow - box-shadow value (animatable array for a
 *   reached tier; a static transparent string below the first milestone).
 * @property {string} innerBg - inner overlay gradient classes ('' below tier 0).
 * @property {string} line - top accent-line gradient classes ('' below tier 0).
 * @property {string|null} emoji - tier emoji, or null below the first milestone.
 * @property {string} labelColor - label text-color class.
 * @property {object} numberStyle - inline style for the streak number.
 * @property {object|null} animate - framer-motion animate config for the emoji,
 *   or null below the first milestone.
 */

// Rich per-tier presentation, indexed to align with STREAK_MILESTONES
// (0:3d 🔥, 1:7d ⭐, 2:14d ✨, 3:37d 🏆, 4:100d 💎, 5:365d 👑). The tier
// *selection* lives once in getStreakTier; these are the styles it maps to.
//
// These comments previously documented the OLD ladder [7,25,50,100,200,365];
// the real one has been [3,7,14,37,100,365] since the 2026-07-02 retune (see
// game-mechanics/milestones.js), so tier 0's orange 🔥 treatment now marks 3
// days, not a week. Only the DOCUMENTATION had drifted — the thresholds and the
// styling are the approved retune and are deliberately unchanged here.
const tierStyles = [
  { // tier 0 — 3 Days
    bg: 'bg-gradient-to-br from-orange-500/40 via-amber-500/30 to-orange-700/40 border-orange-400/80 shadow-[0_0_20px_rgba(249,115,22,0.4)]',
    glow: ['0 0 20px rgba(249, 115, 22, 0.5)', '0 0 40px rgba(249, 115, 22, 0.8)', '0 0 20px rgba(249, 115, 22, 0.5)'],
    innerBg: 'bg-gradient-to-br from-orange-600/20 via-transparent to-amber-600/20',
    line: 'from-transparent via-orange-500 to-transparent',
    emoji: '🔥',
    labelColor: 'text-orange-100',
    numberStyle: { color: '#E8D5B5' },
    animate: { scale: [1, 1.2, 1] }
  },
  { // tier 1 — 7 Days
    bg: 'bg-gradient-to-br from-purple-700/40 via-purple-800/30 to-fuchsia-800/40 border-purple-500/80 shadow-[0_0_20px_rgba(126,34,206,0.4)]',
    glow: ['0 0 20px rgba(126, 34, 206, 0.5)', '0 0 40px rgba(126, 34, 206, 0.8)', '0 0 20px rgba(126, 34, 206, 0.5)'],
    innerBg: 'bg-gradient-to-br from-purple-700/20 via-transparent to-fuchsia-800/20',
    line: 'from-transparent via-purple-500 to-transparent',
    emoji: '⭐',
    labelColor: 'text-yellow-200',
    numberStyle: { color: '#D4AF37' },
    animate: { scale: [1, 1.15, 1] }
  },
  { // tier 2 — 14 Days
    bg: 'bg-gradient-to-br from-teal-400/40 via-cyan-500/30 to-teal-600/40 border-teal-300/80 shadow-[0_0_20px_rgba(20,184,166,0.4)]',
    glow: ['0 0 20px rgba(20, 184, 166, 0.5)', '0 0 40px rgba(20, 184, 166, 0.8)', '0 0 20px rgba(20, 184, 166, 0.5)'],
    innerBg: 'bg-gradient-to-br from-teal-400/20 via-transparent to-cyan-500/20',
    line: 'from-transparent via-teal-300 to-transparent',
    emoji: '✨',
    labelColor: 'text-pink-200',
    numberStyle: { color: '#FF00FF' },
    animate: { scale: [1, 1.15, 1] }
  },
  { // tier 3 — 37 Days
    bg: 'bg-gradient-to-br from-blue-600/40 via-indigo-600/30 to-purple-800/40 border-indigo-400/80 shadow-[0_0_20px_rgba(79,70,229,0.4)]',
    glow: ['0 0 20px rgba(79, 70, 229, 0.5)', '0 0 40px rgba(79, 70, 229, 0.8)', '0 0 20px rgba(79, 70, 229, 0.5)'],
    innerBg: 'bg-gradient-to-br from-blue-500/20 via-transparent to-purple-600/20',
    line: 'from-transparent via-indigo-300 to-transparent',
    emoji: '🏆',
    labelColor: 'text-sky-200',
    numberStyle: { color: '#E2E8F0' }, // Shiny silver
    animate: { scale: [1, 1.1, 1] } // No spin
  },
  { // tier 4 — 100 Days
    bg: 'bg-gradient-to-br from-slate-200/40 via-slate-300/30 to-slate-400/40 border-slate-200/80 shadow-[0_0_20px_rgba(203,213,225,0.4)]',
    glow: ['0 0 20px rgba(203, 213, 225, 0.5)', '0 0 40px rgba(203, 213, 225, 0.8)', '0 0 20px rgba(203, 213, 225, 0.5)'],
    innerBg: 'bg-gradient-to-br from-slate-300/20 via-transparent to-slate-400/20',
    line: 'from-transparent via-slate-200 to-transparent',
    emoji: '💎',
    labelColor: 'text-emerald-200',
    numberStyle: { color: '#98FF98' }, // Shiney Mint green
    animate: { scale: [1, 1.1, 1] } // No spin
  },
  { // tier 5 — 365 Days
    bg: 'bg-gradient-to-br from-yellow-500/40 via-amber-500/30 to-yellow-600/40 border-yellow-300/80 shadow-[0_0_20px_rgba(250,204,21,0.4)]',
    glow: ['0 0 20px rgba(250, 204, 21, 0.5)', '0 0 40px rgba(250, 204, 21, 0.8)', '0 0 20px rgba(250, 204, 21, 0.5)'],
    innerBg: 'bg-gradient-to-br from-yellow-400/20 via-transparent to-amber-500/20',
    line: 'from-transparent via-yellow-300 to-transparent',
    emoji: '👑',
    labelColor: 'text-indigo-200',
    numberStyle: {
      background: 'linear-gradient(135deg, #E8F5FF 0%, #FFFFFF 20%, #B0E0FF 40%, #FFE8F8 65%, #FFFFFF 80%, #C8F5FF 100%)',
      WebkitBackgroundClip: 'text',
      WebkitTextFillColor: 'transparent',
      backgroundClip: 'text'
    },
    animate: { scale: [1, 1.2, 1], rotate: [0, 360] }
  }
];

// Below the first milestone: a calm blue card with a soft neon-blue glow (no
// accent-line/emoji, and no pulsing — the glow is a static string, not the
// 3-keyframe array the reached tiers animate). Matches the neon --u37-blue
// (#2f7bff) edge the Statistics daily-stat cards use, so an unreached streak
// still reads as on-brand neon rather than a flat box.
const baseStyles = {
  bg: 'bg-gradient-to-br from-blue-400/40 via-blue-500/30 to-blue-900/40 border-blue-400/80 shadow-[0_0_20px_rgba(59,130,246,0.4)]',
  glow: '0 0 16px rgba(47, 123, 255, 0.45)',
  innerBg: '',
  line: '',
  emoji: null,
  labelColor: 'text-blue-100',
  numberStyle: { color: '#94a3b8' },
  animate: null
};

/**
 * Map a daily-challenge streak length to its full presentation bundle.
 *
 * The tier *selection* is delegated to `getStreakTier` (the single source of
 * truth for which milestone a streak has reached); this maps that tier to its
 * rich card styling. Below the first milestone it returns the calm base styles.
 *
 * @param {number} streak - the streak length in days.
 * @returns {StreakStyles} the presentation bundle for that streak.
 */
export function getStreakStyles(streak) {
  const tier = getStreakTier(streak);
  if (tier) {
    return tierStyles[tier.index];
  }
  return baseStyles;
}
