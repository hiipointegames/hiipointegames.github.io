import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { ArrowLeft } from 'lucide-react';
import { Link, useLocation } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import moment from 'moment-timezone';
import { isPerfectSolve as isPerfectPowerDiceSolve } from '@/equation-engine';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';
import { apiClient } from '@/transport';
import { MiniDice } from '@/puzzle-input';
import { getPlayerBattleStats, blitzHasPerfectConcept, blitzRequiresPerfectSolve, blitzEnforcesPowerDice, normalizeBlitzMode, BLITZ_TIER_LABEL, BLITZ_TIER_ACCENT } from '@/head-to-head';
import BattlePointsCard from '@/head-to-head/BattlePointsCard';
import { formatSolveTime } from '@/ui/feedback';

// How a decided battle reads. `unresolved` is handled separately — it is not an
// outcome, it is the absence of one, and giving it a colour here would invite a
// caller to render "TIE" for a battle the opponent has not played.
//
// ⚠️ These are FIXED colours, not the arena accent. A result must not change hue
// with the room it is announced in.
//
// "Defeated" was `--u37-magenta`, which is also the Blitz Colosseum's own chrome
// — so a loss was announced in exactly the colour of the page framing it, and
// read as decoration. It now uses `--u37-danger`, which exists for this.
const OUTCOME = Object.freeze({
  win:  { label: 'Victory',  color: 'var(--u37-gold)' },
  loss: { label: 'Defeated', color: 'var(--u37-danger)' },
  tie:  { label: 'Draw',     color: 'var(--u37-cyan)' },
});

// The colour a recorded die is PRINTED in. Keyed by the colour name the run
// stored, never re-derived from the tier — a solve is a record of the board the
// player actually saw.
//
// Was eight Tailwind classes rebuilt inside the render loop, once per die, per
// solve, per render. Orange and pink have no token of their own, so they borrow
// the nearest one and say so rather than reaching back for a literal.
const DIE_COLOR = Object.freeze({
  blue:   'var(--u37-blue)',
  red:    'var(--u37-danger)',
  green:  'var(--u37-success)',
  orange: 'var(--u37-gold-deep)',
  yellow: 'var(--u37-gold)',
  purple: 'var(--u37-violet)',
  pink:   'var(--u37-magenta)',
  white:  'var(--u37-muted)',
});

export default function BlitzStats() {
  const location = useLocation();
  const completedBlitzResult = location.state || {};
  const [battlePoints, setBattlePoints] = useState(0);
  const [loadingPoints, setLoadingPoints] = useState(true);
  // A failed fetch must not render as a real total. "0 / 37" after a network
  // error is a confident, plausible, false statement about the player's record.
  const [pointsFailed, setPointsFailed] = useState(false);

  // Extract data from the navigation payload.
  //
  // ⚠️ There is exactly ONE producer of this object — `buildBlitzRunPayload` —
  // and `location.state` is its only delivery mechanism, so this screen can never
  // be shown historical data: a refresh or a direct URL visit arrives with `{}`
  // and renders from the defaults below.
  //
  // This used to destructure a second, parallel set of names (`solutions`,
  // `mode`, `totalTime`, `completedAt`) behind a comment calling them a
  // "LEGACY FORMAT (pre-2024)" kept "for historical data display". Both halves of
  // that claim were wrong, and the pair was removed on 2026-09-10:
  //   • it was not legacy — the current producer emitted those names on EVERY
  //     navigation, alongside the ones below, so the fallbacks never once fired;
  //   • it could not display historical data — see above.
  // Do not confuse those names with `battleRunBlob.js`, which writes a DATABASE
  // blob using the same words. That one IS live. This one was an echo.
  const {
    equationsAttempted = 0,
    solveBreakdown = [],
    endTimestamp = new Date().toISOString(),
    totalDuration = 0,
    isBattle = false,
    opponentName = null,
    // Battle outcome from the perspective of the player who just finished.
    // 'unresolved' is a REAL state, not a failure: a battle is decided only once
    // the second player finishes, so whoever gets there first legitimately does
    // not know yet. Defaulting to it means we never claim a win we cannot prove.
    outcome = 'unresolved',
    opponentScore = null,
    deckCleared = false,
  } = completedBlitzResult;

  // Blitz stats use the s-suffix style (e.g. 42.50s; 1:05.50 past a minute).
  const formatTime = (seconds) => formatSolveTime(seconds, { style: 'suffix' });

  // A run with no solves has no fastest, slowest or average — it has an absence.
  // Rendering that absence as "0.00s" states a measurement that was never taken,
  // so the empty case gets a dash. Until 2026-09-10 this screen did BOTH for the
  // same number: the Fastest Solve tile showed "0.00s" while the Session Details
  // row two cards below showed "--".
  const formatTimeOrDash = (seconds) => (seconds > 0 ? formatTime(seconds) : '--');

  /**
   * One solve's duration in seconds.
   * Guards non-finite input: `solveBreakdown` computes `solve_time * 1000`, so a
   * solve stored without a time arrives here as NaN rather than as undefined.
   */
  const solveSeconds = (solve) =>
    (Number.isFinite(solve?.timeToSolveMs) ? solve.timeToSolveMs / 1000 : 0);

  const totalSolved = equationsAttempted;
  const breakdown = solveBreakdown;
  const solveTimes = breakdown.map(solveSeconds);

  // THE MEAN OF THE ACTUAL SOLVES — not wall-clock ÷ solves.
  //
  // This read `averageSolveTimeMs`, which the producer derived as
  // `(totalTime / solved) * 1000`. On the normal clock-expiry path `totalTime` is
  // the FULL timer duration, so that number counted every second the player spent
  // reading, thinking and idling, then divided it by the solve count. It sat
  // directly beside Fastest and Slowest, which are real per-solve measurements —
  // so a player reading the obvious invariant `fastest <= avg <= slowest` was
  // reading something that could be, and routinely was, false.
  const avgSolveTimeSec = solveTimes.length > 0
    ? solveTimes.reduce((sum, s) => sum + s, 0) / solveTimes.length
    : 0;
  const fastestSolve = solveTimes.length > 0 ? Math.min(...solveTimes) : 0;
  const slowestSolve = solveTimes.length > 0 ? Math.max(...solveTimes) : 0;
  // The TIER this run was played at.
  //
  // ⚠️ `modeType` is deliberately NOT consulted here, despite looking like the
  // obvious field: for a battle it holds the literal string 'battle', which is not
  // a tier at all and would coerce straight to Easy.
  const actualGameMode = normalizeBlitzMode(completedBlitzResult.blitz_mode);
  const displayTime = totalDuration;
  const displayCompleted = endTimestamp;

  /** The dice a Blitz round deals. */
  const DICE_PER_ROUND = 7;

  // Is a perfect solve worth POINTING OUT in this tier?
  //
  // Only where it is an achievement rather than a given. Easy deals no coloured
  // dice, so the count could only ever read 0; Expert REQUIRES a perfect solve,
  // so it would always equal the solved count and every row would wear the same
  // ring. Challenge is the one tier where perfection distinguishes one solve from
  // another.
  //
  // Stated once, here, and asked four times below — three tile/row/legend gates
  // that already phrased it this way, plus the per-solve highlight that did not.
  const highlightsPerfectSolves =
    blitzHasPerfectConcept(actualGameMode) && !blitzRequiresPerfectSolve(actualGameMode);

  /** A solve's dice colours, defaulted to an all-white board when unrecorded. */
  const colorsOf = (solve) => solve.diceColors || Array(DICE_PER_ROUND).fill('white');

  /** Which dice this solve used; sequential order when the run did not record it. */
  const usedIndicesOf = (solve) =>
    solve.usedDiceIndices || (solve.diceSequence ? solve.diceSequence.map((_, i) => i) : []);

  // Counted ONCE and read twice. The Perfect Solves tile and the Session Details
  // row each inlined their own byte-identical copy of this loop, so the same
  // number was derived twice per render from the same array.
  const perfectSolveCount = breakdown.reduce(
    (count, solve) =>
      (isPerfectPowerDiceSolve(solve.equationUsed, usedIndicesOf(solve), colorsOf(solve))
        ? count + 1
        : count),
    0,
  );

  // `null` for 'unresolved' (a real state, deliberately absent from OUTCOME) and
  // for anything unrecognised. Both render the "waiting on your opponent" copy,
  // which is the honest thing to say when we cannot name the result.
  const outcomeView = OUTCOME[outcome] ?? null;

  // Battle Points, for battles only.
  //
  // This ran unconditionally, including after a solo run whose receipt does not
  // show the card — and it is not a cheap read: getPlayerBattleStats fetches the
  // player's ENTIRE completed-battle history and folds it client-side, to render
  // one integer. Solo runs no longer pay for a number they do not display.
  useEffect(() => {
    if (!isBattle) {
      setLoadingPoints(false);
      return;
    }
    const loadBattlePoints = async () => {
      try {
        const user = await apiClient.auth.me();
        const { battlePoints: calculatedBattlePoints } = await getPlayerBattleStats(user.id);
        setBattlePoints(calculatedBattlePoints);
      } catch (error) {
        console.error('Failed to load battle points:', error);
        setPointsFailed(true);
      } finally {
        setLoadingPoints(false);
      }
    };

    loadBattlePoints();
  }, [isBattle]);

  // Colorize equation helper - uses AST-based validation for correctness

  // A stat tile's frame, tinted from ONE token.
  // These were four hand-written Tailwind gradient pairs (blue/indigo,
  // purple/violet, yellow/amber, rose/red) plus four matching border classes —
  // eight colour literals describing one shape four times.
  const tileStyle = (hue) => ({
    background: `linear-gradient(135deg, color-mix(in srgb, ${hue} 18%, transparent) 0%, color-mix(in srgb, ${hue} 7%, transparent) 100%)`,
    borderColor: `color-mix(in srgb, ${hue} 30%, transparent)`,
  });

  return (
    // THE ARENA, as an inherited theme rather than a hard-coded hue.
    //
    // `tokens.css` defines two colour axes and this screen only ever used one.
    // `[data-mode="solo-blitz"]` resolves --u37-mode-accent to BLUE and
    // `[data-mode="blitz-battle"]` resolves it to MAGENTA — that is the
    // documented mechanism for "which arena am I in", and no file in this
    // subsystem set the attribute, so none of them resolved the variable. The
    // screen therefore painted battle-magenta over SOLO runs too.
    //
    // Setting it here means every descendant below can ask for
    // var(--u37-mode-accent) and get the right answer for the run that just
    // happened. The TIER accent (green/cyan/gold) is the other axis and stays on
    // the tier label, where it belongs.
    <div className="app-page-shell relative" data-mode={isBattle ? 'blitz-battle' : 'solo-blitz'}>
      {/* Decorative bottom shadow/buffer bars removed (2026-06-29, FU-1): ad
          clearance is reserved by the calc(100vh-100px) scroll region below, NOT
          by visual bars — bottom content is no longer dimmed by the fade overlay. */}
      <div className="app-page-scroll pt-[60px] scroll-edge-fade-bottom">
        <div className="max-w-2xl mx-auto px-3 sm:px-4 pb-12">
          {/* Header */}
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            className="backdrop-blur rounded-3xl p-6 border-2 mb-8"
            style={{ background: 'var(--u37-panel-bg-cosmic)', borderColor: 'color-mix(in srgb, var(--u37-mode-accent) 45%, transparent)', boxShadow: '0 0 34px -14px var(--u37-mode-accent), inset 0 1px 3px rgba(255,255,255,0.05)' }}
          >
            <div className="text-center">
              <div className="flex items-center justify-center gap-2.5 mb-4">
                <span className="text-2xl">🛡️</span>
                <h1 className="text-3xl font-black" style={{ color: 'var(--u37-mode-accent)', textShadow: '0 0 14px color-mix(in srgb, var(--u37-mode-accent) 55%, transparent)' }}>
                  Blitz Complete!
                </h1>
                <span className="text-2xl">🛡️</span>
              </div>
              {/* Tier + arena, asked rather than branched.
                  This was two nested binary ternaries hard-coding "Easy Battle"
                  and "Challenge Battle", so an EXPERT battle rendered as
                  "Challenge Battle" — the wrong tier, in the wrong colour. */}
              <div className="flex items-center justify-center gap-2">
                {blitzEnforcesPowerDice(actualGameMode) ? (
                  <>
                    <MiniDice value={5} color="red" />
                    <MiniDice value={3} color="blue" />
                    <MiniDice value={4} color="green" />
                  </>
                ) : (
                  <MiniDice value={1} color="white" />
                )}
                <span className="font-bold" style={{ color: BLITZ_TIER_ACCENT(actualGameMode) }}>
                  {BLITZ_TIER_LABEL(actualGameMode)} {isBattle ? 'Battle' : 'Mode'}
                </span>
              </div>

              {/* THE VICTOR.
                  Until now this screen never said who won on the normal
                  clock-expiry path: `opponentName` was hard-coded null in that
                  payload and no outcome was passed at all, so a player finished a
                  battle and the app simply never told them. Broken for Easy and
                  Challenge too — this is not an Expert-only fix. */}
              {isBattle && (
                <div className="mt-4">
                  {/* An unknown outcome degrades to "waiting", it does not throw.
                      `OUTCOME[outcome].color` was an unguarded lookup, and
                      `location.state` is attacker-controllable in the sense that
                      matters here: /BlitzStats is a directly addressable route, so
                      any string could arrive. The old code turned that into a
                      TypeError during render, which blanks the entire page. */}
                  {!outcomeView ? (
                    <>
                      <div className="text-xl font-black" style={{ color: 'var(--u37-text)' }}>Waiting on your opponent</div>
                      <div className="text-sm mt-1" style={{ color: 'var(--u37-muted)' }}>
                        We&apos;ll show the result once they finish their run.
                      </div>
                    </>
                  ) : (
                    <>
                      <div
                        className="text-3xl font-black"
                        style={{ color: outcomeView.color, textShadow: `0 0 16px color-mix(in srgb, ${outcomeView.color} 45%, transparent)` }}
                      >
                        {outcomeView.label}
                      </div>
                      {opponentName && (
                        <div className="text-sm mt-1" style={{ color: 'var(--u37-muted)' }}>
                          {opponentScore !== null
                            ? `${totalSolved} – ${opponentScore} vs ${opponentName}`
                            : `vs ${opponentName}`}
                        </div>
                      )}
                    </>
                  )}
                </div>
              )}

              {deckCleared && (
                <div className="mt-3 text-sm font-bold" style={{ color: 'var(--u37-gold)' }}>
                  Deck cleared — you solved every puzzle in the battle.
                </div>
              )}
            </div>
          </motion.div>

          {/* Battle Points — BATTLES ONLY.
              This was captioned "Always visible", and it was: a player who had
              just finished a SOLO run was shown a Battle Points total under the
              words "Win Blitz Battles to earn Battle Points" — a prompt about a
              mode they had not been playing, on the receipt for the one they had.
              A receipt describes the run that just happened. */}
          {isBattle && (
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.1 }}
              className="flex justify-center mb-6"
            >
              <BattlePointsCard points={battlePoints} loading={loadingPoints} failed={pointsFailed} />
            </motion.div>
          )}

          {/* Main Stats Card */}
          <motion.div
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ delay: 0.2 }}
            className="backdrop-blur rounded-2xl p-6 border-2 mb-6"
            style={{ background: 'var(--u37-panel-bg)', borderColor: 'color-mix(in srgb, var(--u37-mode-accent) 35%, transparent)', boxShadow: '0 0 30px -14px var(--u37-mode-accent)' }}
          >
            <div className="text-center mb-6">
              <div className="text-6xl font-black mb-2" style={{ color: 'var(--u37-mode-accent)', textShadow: '0 0 20px color-mix(in srgb, var(--u37-mode-accent) 50%, transparent)' }}>{totalSolved}</div>
              <div className="text-lg" style={{ color: 'var(--u37-muted)' }}>Equations Solved</div>
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div className="rounded-xl p-4 text-center border" style={tileStyle('var(--u37-blue)')}>
                <div className="text-2xl mb-2">⏱️</div>
                <div className="text-2xl font-bold" style={{ color: 'var(--u37-text)' }}>{formatTime(displayTime)}</div>
                <div className="text-xs" style={{ color: 'var(--u37-muted)' }}>Total Time</div>
              </div>

              <div className="rounded-xl p-4 text-center border" style={tileStyle('var(--u37-violet)')}>
                <div className="text-2xl mb-2">🎯</div>
                <div className="text-2xl font-bold" style={{ color: 'var(--u37-text)' }}>{formatTimeOrDash(avgSolveTimeSec)}</div>
                <div className="text-xs" style={{ color: 'var(--u37-muted)' }}>Avg Per Puzzle</div>
              </div>

              <div className="rounded-xl p-4 text-center border" style={tileStyle('var(--u37-gold)')}>
                <div className="text-2xl mb-2">⚡</div>
                <div className="text-2xl font-bold" style={{ color: 'var(--u37-text)' }}>{formatTimeOrDash(fastestSolve)}</div>
                <div className="text-xs" style={{ color: 'var(--u37-muted)' }}>Fastest Solve</div>
              </div>

              <div className="rounded-xl p-4 text-center border" style={tileStyle('var(--u37-danger)')}>
                <div className="text-2xl mb-2">🐢</div>
                <div className="text-2xl font-bold" style={{ color: 'var(--u37-text)' }}>{formatTimeOrDash(slowestSolve)}</div>
                <div className="text-xs" style={{ color: 'var(--u37-muted)' }}>Slowest Solve</div>
              </div>

              {highlightsPerfectSolves && (
                <div className="rounded-xl p-4 text-center col-span-2" style={{ background: 'var(--u37-surface)' }}>
                  <div className="w-6 h-6 mx-auto mb-2 flex items-center justify-center">
                    <div className="w-6 h-4 border-2 rounded" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }}></div>
                  </div>
                  <div className="text-2xl font-bold" style={{ color: 'var(--u37-text)' }}>{perfectSolveCount}</div>
                  <div className="text-xs" style={{ color: 'var(--u37-muted)' }}>Perfect Solves</div>
                </div>
              )}
            </div>
          </motion.div>

          {/* Session Details */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.3 }}
            className="backdrop-blur rounded-xl p-4 border mb-6"
            style={{ background: 'var(--u37-surface)', borderColor: 'var(--u37-hair)' }}
          >
            <h3 className="text-white font-semibold mb-3">Session Details</h3>
            <div className="space-y-2 text-sm">
              <div className="flex justify-between">
                <span style={{ color: 'var(--u37-muted)' }}>Date</span>
                <span style={{ color: 'var(--u37-text)' }}>
                  {moment(displayCompleted).format('MMM D, YYYY')}
                </span>
              </div>
              <div className="flex justify-between">
                <span style={{ color: 'var(--u37-muted)' }}>Time Played</span>
                <span style={{ color: 'var(--u37-text)' }}>{formatTime(displayTime)}</span>
              </div>
              <div className="flex justify-between">
                <span style={{ color: 'var(--u37-muted)' }}>Fastest Puzzle Solve</span>
                <span style={{ color: 'var(--u37-text)' }}>{formatTimeOrDash(fastestSolve)}</span>
              </div>
              {highlightsPerfectSolves && (
                <div className="flex justify-between">
                  <span style={{ color: 'var(--u37-muted)' }}>Perfect Solves (All 3 Power Dice)</span>
                  <span style={{ color: 'var(--u37-text)' }}>{perfectSolveCount} / {totalSolved}</span>
                </div>
              )}
              {isBattle && opponentScore !== null && (
                <div className="flex justify-between">
                  <span style={{ color: 'var(--u37-muted)' }}>Opponent{opponentName ? ` (${opponentName})` : ''}</span>
                  <span style={{ color: 'var(--u37-text)' }}>{opponentScore} solved</span>
                </div>
              )}
            </div>
          </motion.div>

          {/* Solutions List */}
          {breakdown.length > 0 && (
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.35 }}
              className="backdrop-blur rounded-xl p-4 border mb-6"
              style={{ background: 'var(--u37-surface)', borderColor: 'var(--u37-hair)' }}
            >
              <div className="flex flex-wrap items-center justify-center gap-4 sm:gap-6 mb-3">
                <h3 className="font-semibold" style={{ color: 'var(--u37-text)' }}>Your Solutions</h3>
                {highlightsPerfectSolves && (
                  <div className="flex items-center gap-2 text-xs" style={{ color: 'var(--u37-muted)' }}>
                    <div className="w-12 h-6 border-2 rounded" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }}></div>
                    <span>= Perfect Solve - All 3 Power Dice Correct</span>
                  </div>
                )}
              </div>
              <div className="space-y-2 max-h-64 overflow-y-auto">
                {breakdown.map((solution, idx) => {
                  const equation = solution.equationUsed;
                  const dice = solution.diceSequence;
                  const colors = solution.diceColors || Array(7).fill('white');
                  const time = solveSeconds(solution);

                  const usedIndices = usedIndicesOf(solution);

                  // Does this row get the gold ring? Asked as the RULE, exactly
                  // like the three gates above it.
                  //
                  // This was `actualGameMode === 'challenge'` — the one hard-coded
                  // tier literal left in the file, three lines below a comment
                  // saying "written as the rule, not as `=== 'challenge'`, so it
                  // stays correct if a fourth tier ever appears". Expert is that
                  // fourth tier arriving early: 'expert' is not 'challenge', so an
                  // Expert run — in which every accepted solve is perfect BY
                  // DEFINITION — never lit a single row.
                  const isPerfectSolve = highlightsPerfectSolves && equation
                    ? isPerfectPowerDiceSolve(equation, usedIndices, colors)
                    : false;

                  return (
                    <div
                      key={idx}
                      className={`rounded-lg p-3 flex justify-between items-center ${isPerfectSolve ? 'border-2' : ''}`}
                      style={{
                        background: 'var(--u37-surface)',
                        ...(isPerfectSolve
                          ? { borderColor: 'var(--u37-gold)', boxShadow: '0 0 14px -4px var(--u37-gold)' }
                          : {}),
                      }}
                    >
                      <div className="flex-1">
                        {/* No `hasColorData` ternary here any more. It tested
                            `!!(colors && usedIndices)` against two values that had
                            just been given non-null defaults immediately above —
                            and `[]` is truthy — so it was always true and its
                            plain-text branch was unreachable. SolvedEquation
                            already handles a falsy equation and a short colours
                            array itself. */}
                        <div className="font-mono text-sm font-bold" style={{ color: 'var(--u37-text)' }}>
                          <SolvedEquation equation={equation} usedIndices={usedIndices} colors={colors} /> <span className="font-black" style={{ color: 'var(--u37-muted)' }}>= </span><Target37 className="font-black" />
                        </div>
                        {dice && (
                          <div className="text-xs flex items-center gap-1 flex-wrap mt-1" style={{ color: 'var(--u37-muted)' }}>
                            <span>Dice:</span>
                            {dice.map((val, i) => {
                              const color = colors[i];
                              return (
                                <span key={i} style={{ color: DIE_COLOR[color] || DIE_COLOR.white }}>
                                  {val}{i < dice.length - 1 ? ',' : ''}
                                </span>
                              );
                            })}
                          </div>
                        )}
                      </div>
                      <div className="font-semibold text-sm ml-3" style={{ color: 'var(--u37-success)' }}>
                        {formatTime(time)}
                      </div>
                    </div>
                  );
                })}
              </div>
            </motion.div>
          )}

          {/* Action Buttons */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 0.45 }}
            className="flex gap-3 pb-8"
          >
            <Link to={createPageUrl('HeadToHead')} className="flex-1">
              <Button
                className="w-full min-h-[48px] font-black"
                style={{ background: 'var(--u37-mode-accent)', color: 'var(--u37-bg)', boxShadow: '0 0 26px -7px var(--u37-mode-accent), inset 0 1px 0 rgba(255,255,255,0.4)' }}
              >
                <ArrowLeft className="w-5 h-5 mr-2" />
                {/* "Blitz Home" was a THIRD name for a page already called the
                    Colosseum in its own copy and `HeadToHead` in the route table.
                    The place has a name; this button now uses it. */}
                Back to the Colosseum
              </Button>
            </Link>
          </motion.div>
        </div>
      </div>
    </div>
  );
}