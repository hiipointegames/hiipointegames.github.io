import { useEffect } from 'react';
import { Capacitor } from '@capacitor/core';
import { App } from '@capacitor/app';

// Android hardware-back guard for an in-progress daily attempt (screen lockdown,
// design item 3). While `active` (native AND a daily attempt is in progress), it
// intercepts the hardware Back button — which would otherwise navigate away /
// close the app and silently abandon the attempt — and instead invokes `onBack`
// (Game.jsx passes dc.openExitWarning, so the existing ExitWarningModal appears:
// confirm → forfeit + reveal today's solutions, cancel → stay in the game).
//
// Adding a `backButton` listener overrides Android's default back action, so the
// press is fully absorbed into the warning. Web / non-native: completely inert —
// no listener is registered. The listener is scoped to `active`, so hardware
// back behaves normally everywhere outside a live daily.
export function useDailyBackGuard(active, onBack) {
  useEffect(() => {
    if (!active || !Capacitor.isNativePlatform()) return undefined;

    let handle;
    let cancelled = false;
    Promise.resolve(App.addListener('backButton', () => { onBack(); })).then((h) => {
      if (cancelled) h?.remove?.();
      else handle = h;
    });

    return () => {
      cancelled = true;
      handle?.remove?.();
    };
  }, [active, onBack]);
}
