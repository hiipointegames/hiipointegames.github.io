import React from 'react';

// The one message slot under a game's equation or board (framework §B3). It always takes its
// height, so nothing jumps under a finger, and it shows ONE message, chosen by priority:
// a refusal, then the stuck tip, then the good news, then the coach line.

/** @typedef {'coach' | 'tip' | 'refusal' | 'good'} Tone */

const TONES = Object.freeze({
  coach: { cls: 'text-slate-100', icon: '' },
  tip: { cls: 'rounded-full border border-amber-600 bg-amber-950/80 px-3.5 py-1.5 text-amber-200', icon: '💡 ' },
  refusal: { cls: 'rounded-full border border-rose-700 bg-rose-950/80 px-3.5 py-1.5 text-rose-200', icon: '✕ ' },
  good: { cls: 'rounded-full border border-emerald-700 bg-emerald-950/80 px-3.5 py-1.5 text-emerald-200', icon: '✓ ' },
});

/** Highest first: what the slot shows when several are set. */
export const TONE_PRIORITY = Object.freeze(/** @type {Tone[]} */ (['refusal', 'tip', 'good', 'coach']));

/**
 * The message to show, or null.
 * @param {Partial<Record<Tone, string | null | undefined | false>>} messages
 * @returns {{ tone: Tone, text: string } | null}
 */
export function pickMessage(messages) {
  for (const tone of TONE_PRIORITY) {
    const text = messages?.[tone];
    if (text) return { tone, text };
  }
  return null;
}

/**
 * @param {{
 *   messages: Partial<Record<Tone, string | null | undefined | false>>,
 *   onDismissTip?: () => void,
 *   testId?: string,
 * }} props
 */
export default function TipSlot({ messages, onDismissTip, testId = 'tip-slot' }) {
  const shown = pickMessage(messages);
  const tone = shown ? TONES[shown.tone] : null;
  const dismissable = shown?.tone === 'tip' && onDismissTip;
  return (
    <div data-testid={testId} data-tone={shown?.tone ?? 'none'} aria-live="polite"
      className="flex min-h-[40px] items-center justify-center px-2 text-center text-sm leading-5">
      {shown && tone && (dismissable ? (
        <button type="button" onClick={onDismissTip} aria-label={`${shown.text} (tap to hide)`} className={tone.cls}>
          {tone.icon}{shown.text}
        </button>
      ) : (
        <span className={tone.cls}>{tone.icon}{shown.text}</span>
      ))}
    </div>
  );
}
