// Seeded randomness for Sector 73 (Daily runs/signals must be identical for
// every player on a date; practice uses a random seed).

/** mulberry32 — small, fast, good enough for games. Returns () => [0, 1). */
export function makeRng(seed) {
  let a = (typeof seed === 'string' ? hashString(seed) : seed) >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export function hashString(s) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

export const randInt = (rng, lo, hi) => lo + Math.floor(rng() * (hi - lo + 1));
export const pick = (rng, arr) => arr[Math.floor(rng() * arr.length)];
export const rollDie = (rng) => randInt(rng, 1, 6);

export function shuffle(rng, arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rng() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/** Today's date in US Eastern, 'YYYY-MM-DD' — the same day boundary as the Dailies. */
export function todayEastern(now = new Date()) {
  return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
}

/** The calendar day before `date` ('YYYY-MM-DD' in, same out) — for resuming yesterday's Daily. */
export const dayBefore = (date) => new Date(Date.parse(`${date}T12:00:00Z`) - 864e5).toISOString().slice(0, 10);

export const randomSeed = () => Math.floor(Math.random() * 2 ** 31);
