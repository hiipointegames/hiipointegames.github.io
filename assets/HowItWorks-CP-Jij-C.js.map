import React from 'react';

// Daily or practice, visible at a glance (framework §D3): a gold DAILY chip with the date, or a
// grey PRACTICE chip, in the same top-left spot in every Sector 73 game.

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

/**
 * "OCT 22" from an Eastern date key ("2026-10-22"). Read from the string, never through Date,
 * so a phone's own time zone can't shift the day.
 * @param {string | null | undefined} dateKey
 * @returns {string}
 */
export function chipDate(dateKey) {
  const m = /^\d{4}-(\d{2})-(\d{2})$/.exec(String(dateKey ?? ''));
  if (!m) return '';
  const month = MONTHS[Number(m[1]) - 1];
  return month ? `${month} ${Number(m[2])}` : '';
}

const BASE = 'inline-block rounded-full px-2.5 py-1 text-[11px] font-black tracking-[0.12em]';

/** @param {{ date?: string | null }} props date = the Daily's Eastern date key */
export function DailyChip({ date = null }) {
  const day = chipDate(date);
  return (
    <span data-testid="daily-chip" className={`${BASE} border border-amber-700 bg-amber-950 text-amber-300`}>
      DAILY{day ? ` · ${day}` : ''}
    </span>
  );
}

export function PracticeChip() {
  return <span data-testid="practice-chip" className={`${BASE} border border-slate-600 bg-slate-800 text-slate-200`}>PRACTICE</span>;
}
