// An ad before every Sector 73 Daily attempt — never before practice (David, 2026-10-14: "for a
// daily, and all dailies within sector 73, ads should be shown before the attempt. not on practice
// modes though for any game").
//
// It is the main game's own interstitial (@/shell showInterstitial), so it obeys the same server
// switch (app_settings.native_interstitials), shows the web placeholder on web, and FAILS OPEN: if
// the ad can't show, the attempt starts anyway. Taps while an ad is opening are ignored, so a
// double-tap on START can't start two attempts.

import { showInterstitial } from '@/shell';

let opening = false;

/** Show the Daily ad, then run `go` (exactly once). */
export async function beforeDailyAttempt(go, { show = showInterstitial } = {}) {
  if (opening) return;
  opening = true;
  let ran = false;
  const once = () => { if (ran) return; ran = true; opening = false; go(); };
  try {
    // show() returns when the ad APPEARS on a phone; `once` runs when it is closed (or fails).
    await show({ onDismissed: once });
  } catch {
    once(); // show() itself threw: never leave the player waiting
  }
}

/** Tests only. */
export const __resetDailyAdForTests = () => { opening = false; };
