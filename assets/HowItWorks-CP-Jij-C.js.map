import React, { useState } from 'react';

// The power-up tray (framework §C2): one row of buttons directly above the keypad, the same in
// every Sector 73 game. Tap a button → its card (what it does + what it costs) → USE. Two taps on
// purpose, so a power-up is never spent by accident. `oneTap` (Undo: free, reversible) skips the card.

/**
 * @typedef {{
 *   id: string,
 *   icon: string,
 *   name: string,                // ≤ 10 letters, shown under the icon
 *   what: string,                // ≤ 10 words, starts with a verb: "Reveal one star you picked."
 *   cost?: string,               // "+37 s", "1 ⛽", "free"
 *   badge?: string | number,     // corner badge on the button: uses left or cost
 *   left?: number,               // uses left, shown on the card ("2 left")
 *   active?: boolean,            // on this turn: amber ring + ON
 *   disabledReason?: string,     // set = dimmed; the card says why
 *   thisJump?: boolean,          // lasts one jump/turn: a small chip on the card
 *   oneTap?: boolean,            // USE straight from the button (free + reversible only)
 * }} PowerUp
 */

/**
 * The card for one power-up.
 * @param {{ powerUp: PowerUp, onUse: () => void, onClose: () => void }} props
 */
export function PowerUpCard({ powerUp: p, onUse, onClose }) {
  const blocked = Boolean(p.disabledReason) || p.active;
  return (
    <div className="absolute inset-0 z-[60] flex items-end justify-center bg-black/50 px-3 pb-2" data-testid="power-up-scrim"
      onPointerDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
      <div role="dialog" aria-label={p.name} data-testid={`power-up-card-${p.id}`}
        className="w-full max-w-sm rounded-2xl border border-violet-400/70 bg-[#120f2c] p-4 text-left text-white shadow-2xl">
        <div className="flex items-center gap-2.5 text-lg font-black"><span className="text-2xl" aria-hidden="true">{p.icon}</span>{p.name}</div>
        <p className="mt-1.5 text-[15px] text-slate-100">{p.what}</p>
        <div className="mt-2 flex flex-wrap gap-1.5 text-[11px] font-black tracking-wider">
          {p.cost && <span className="rounded-full border border-amber-700 bg-amber-950 px-2.5 py-0.5 text-amber-300">{p.cost}</span>}
          {typeof p.left === 'number' && <span className="rounded-full border border-slate-600 bg-slate-800 px-2.5 py-0.5 text-slate-200">{p.left} left</span>}
          {p.thisJump && <span className="rounded-full border border-violet-500 bg-violet-950 px-2.5 py-0.5 text-violet-200">this jump</span>}
        </div>
        {p.disabledReason && <p className="mt-2 text-sm text-rose-200" data-testid="power-up-why">{p.disabledReason}</p>}
        {p.active && <p className="mt-2 text-sm text-amber-200">On for this turn.</p>}
        <button type="button" data-testid="power-up-use" disabled={blocked}
          onClick={() => { if (!blocked) onUse(); }}
          className="mt-3 w-full rounded-xl bg-amber-500 py-3 text-base font-black tracking-[0.2em] text-amber-950 active:scale-95 disabled:bg-slate-700 disabled:text-slate-400">
          USE
        </button>
      </div>
    </div>
  );
}

/**
 * @param {{ powerUps: PowerUp[], onUse: (id: string) => void, testId?: string }} props
 */
export default function PowerUpTray({ powerUps, onUse, testId = 'power-up-tray' }) {
  const [openId, setOpenId] = useState(/** @type {string | null} */ (null));
  const open = powerUps.find((p) => p.id === openId) ?? null;
  if (powerUps.length === 0) return null;
  return (
    <>
      <div data-testid={testId} className="flex justify-center gap-2 py-1">
        {powerUps.map((p) => {
          const dim = Boolean(p.disabledReason);
          return (
            <button key={p.id} type="button" data-testid={`power-up-${p.id}`} data-active={p.active ? 'true' : undefined}
              aria-label={`${p.name}: ${p.what}`}
              onClick={() => { if (p.oneTap && !dim) onUse(p.id); else setOpenId(p.id); }}
              className={`relative flex h-[56px] min-w-[60px] flex-col items-center justify-center rounded-xl border px-1.5 text-xl active:scale-95 ${
                p.active ? 'border-amber-300 bg-[#1d1838] shadow-[0_0_0_2px_rgba(245,158,11,0.55)]' : 'border-violet-400/40 bg-[#151233]'} ${dim ? 'opacity-40' : ''}`}>
              <span aria-hidden="true">{p.icon}</span>
              <span className="mt-0.5 text-[10px] font-bold leading-none text-slate-200">{p.name}</span>
              {(p.active || p.badge !== undefined) && (
                <span className={`absolute -right-1.5 -top-1.5 rounded-full px-1.5 text-[10px] font-black text-white ${p.active ? 'bg-amber-700' : 'bg-violet-500'}`}>
                  {p.active ? 'ON' : p.badge}
                </span>
              )}
            </button>
          );
        })}
      </div>
      {open && <PowerUpCard powerUp={open} onClose={() => setOpenId(null)} onUse={() => { setOpenId(null); onUse(open.id); }} />}
    </>
  );
}
