import React from 'react';
import { createPortal } from 'react-dom';

// "ⓘ How it works" — the full rules behind a briefing (David, 2026-10-14: pre-game screens were
// "way too crowded"; keep the essentials on the card, everything else one tap away). Shared by the
// First Contact and Star Chart briefings; Hyperjump has its own richer sheet (hyperjump/RulesSheet).
// Portaled to <body> so it sits above everything on iPhone too (memory: ios-overlays-must-portal).

/**
 * @param {{ title: string, items: Array<string | null | false>, onClose: () => void, testId?: string }} props
 */
export default function HowItWorks({ title, items, onClose, testId = 'how-it-works' }) {
  return createPortal(
    <div className="fixed inset-0 z-[10001] flex items-end justify-center bg-black/70" data-testid={testId}
      onPointerDown={(e) => { e.stopPropagation(); if (e.target === e.currentTarget) onClose(); }}
      style={{ paddingTop: 'calc(var(--safe-top, 0px) + 12px)' }}>
      <div className="max-h-full w-full max-w-md overflow-y-auto rounded-t-3xl border border-sky-300/40 bg-[#06111f] px-4 pt-4 text-left text-white"
        style={{ paddingBottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 20px)' }}>
        <div className="flex items-center justify-between">
          <div className="text-lg font-black">ⓘ {title}</div>
          <button type="button" onClick={onClose} data-testid={`${testId}-close`} className="rounded-full border border-white/20 px-3 py-1 text-sm">Close</button>
        </div>
        <ul className="mt-3 space-y-2 text-sm text-slate-200">
          {items.filter(Boolean).map((t) => <li key={String(t)}>{t}</li>)}
        </ul>
      </div>
    </div>,
    document.body,
  );
}
