// Timelines — the beats of a signature moment (animation playbook §3), skippable.
//
// A timeline is a list of { at: ms, run } steps. Any tap can skip(): every step not yet run
// fires immediately, in order, so the screen always lands on its final state (nothing is
// ever left half-animated) — David's "1.5–3.5 s, tap to skip".

/**
 * @param {Array<{ at: number, run: () => void }>} steps
 * @param {{ onDone?: () => void, setTimer?: typeof setTimeout, clearTimer?: typeof clearTimeout }} [opts]
 * @returns {{ skip: () => void, cancel: () => void, readonly done: boolean }}
 */
export function runTimeline(steps, opts = {}) {
  const setTimer = opts.setTimer ?? setTimeout;
  const clearTimer = opts.clearTimer ?? clearTimeout;
  const ordered = [...steps].sort((a, b) => a.at - b.at);
  const ran = new Array(ordered.length).fill(false);
  const timers = [];
  let done = false;

  const finish = () => {
    if (done) return;
    done = true;
    timers.forEach(clearTimer);
    opts.onDone?.();
  };
  const fire = (i) => {
    if (ran[i] || done) return;
    ran[i] = true;
    try { ordered[i].run(); } catch { /* one broken beat must not freeze the moment */ }
    if (ran.every(Boolean)) finish();
  };

  ordered.forEach((step, i) => { timers.push(setTimer(() => fire(i), Math.max(0, step.at))); });
  if (!ordered.length) finish();

  return {
    skip() { ordered.forEach((_, i) => fire(i)); finish(); },
    cancel() { done = true; timers.forEach(clearTimer); },
    get done() { return done; },
  };
}
