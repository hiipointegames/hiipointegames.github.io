import { useCallback, useEffect, useState } from 'react';

// When to offer the ONE stuck tip (framework §B1.3): after STUCK_MS without progress, or after
// STUCK_REFUSALS refused tries in a row. Progress (a new `progressKey`) hides it and starts over.
// The game decides what "progress" means: a new burn, a star placed right, a jump cleared…

export const STUCK_MS = 30_000;
export const STUCK_REFUSALS = 2;

/**
 * @param {{
 *   progressKey: unknown,        // changes whenever the player makes progress
 *   refusals?: number,           // refused tries since the last progress (the game counts them)
 *   active?: boolean,            // false while paused, on a briefing, after the end…
 *   ms?: number,
 *   refusalLimit?: number,
 * }} opts
 * @returns {{ stuck: boolean, dismiss: () => void }}
 */
export function useStuckTimer({ progressKey, refusals = 0, active = true, ms = STUCK_MS, refusalLimit = STUCK_REFUSALS }) {
  // Both remember WHICH progress they belong to, so new progress clears them in the same render.
  const [timedOutFor, setTimedOutFor] = useState(/** @type {{ key: unknown } | null} */ (null));
  const [dismissedFor, setDismissedFor] = useState(/** @type {{ key: unknown } | null} */ (null));

  useEffect(() => {
    if (!active) return undefined;
    const t = setTimeout(() => setTimedOutFor({ key: progressKey }), ms);
    return () => clearTimeout(t);
  }, [progressKey, active, ms]);

  // A dismissal lasts until the next progress.
  const dismiss = useCallback(() => setDismissedFor({ key: progressKey }), [progressKey]);

  const timedOut = timedOutFor !== null && Object.is(timedOutFor.key, progressKey);
  const dismissed = dismissedFor !== null && Object.is(dismissedFor.key, progressKey);
  const stuck = active && !dismissed && (timedOut || refusals >= refusalLimit);
  return { stuck, dismiss };
}
