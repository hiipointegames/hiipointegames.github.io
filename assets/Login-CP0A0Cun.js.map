import React, { useState } from 'react';
import { useAuth } from '@/auth';
import { Button } from '@/ui/primitives/button';
import { Input } from '@/ui/primitives/input';
import { useNavigate } from 'react-router-dom';
import { Loader2, User, Lock, Mail, ArrowLeft, Eye, EyeOff } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import Starfield from '@/shell/Starfield';
import { Logo37 } from '@/dice-visuals';

// Login is USERNAME + PASSWORD only — email is never a login identifier.
// Password reset is email-based and only works if the user attached a recovery
// email to their account; username-only players who never added one are pointed
// at the drawer's "Add a password" entry (add an email + password) so they can self-serve
// a reset next time.
export default function Login() {
    const { login, resetPassword } = useAuth();
    const navigate = useNavigate();
    const [mode, setMode] = useState('login'); // 'login' | 'forgot'
    const [username, setUsername] = useState('');
    const [password, setPassword] = useState('');
    const [resetEmail, setResetEmail] = useState('');
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState('');
    const [message, setMessage] = useState('');
    const [showPassword, setShowPassword] = useState(false);

    const handleSubmit = async (e) => {
        e.preventDefault();
        setLoading(true);
        setError('');
        setMessage('');
        try {
            if (mode === 'login') {
                await login(username.trim(), password);
                navigate('/');
            } else {
                await resetPassword(resetEmail);
                setMessage('If that email is on an account, a reset link is on its way. Check your inbox for a "Reset your password" email.');
            }
        } catch (err) {
            setError(err.message || (mode === 'login' ? 'Failed to sign in' : 'Could not send reset link'));
        } finally {
            setLoading(false);
        }
    };

    return (
        <div className="min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
            {/* Cosmic-neon backdrop: the shared animated starfield behind a soft
                scrim. Login renders OUTSIDE the app Layout, so it mounts its own
                copy of the global starfield for the same starry surface as home. */}
            <div className="absolute inset-0 overflow-hidden" aria-hidden="true">
                <Starfield />
                <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" />
            </div>
            <AnimatePresence>
                <motion.div
                    // Opacity/translate entrance ONLY — no `scale`. The Logo37 is a
                    // filtered SVG (neon glow); animating a transform over it triggers
                    // the Android-webview compositing flicker seen on the home logo,
                    // so the panel never scales and the 37 stays static.
                    initial={{ opacity: 0, y: 16 }}
                    animate={{ opacity: 1, y: 0 }}
                    exit={{ opacity: 0, y: 16 }}
                    className="relative z-10 w-full max-w-md rounded-3xl p-6 border-2"
                    style={{
                        background: 'var(--u37-panel-bg-cosmic)',
                        borderColor: 'color-mix(in srgb, var(--u37-cyan) 55%, transparent)',
                        boxShadow: '0 0 44px -12px var(--u37-cyan), 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)',
                    }}
                >
                    <div className="text-center mb-8">
                        <div className="inline-flex items-center justify-center w-20 h-20 mb-4">
                            {/* The 37 hexagon brand mark (replaces the plain die).
                                STATIC — no scale/transform over the filtered SVG, which
                                avoids the Android-webview compositing flicker the home
                                logo hit when it was animated. */}
                            <Logo37 size={80} />
                        </div>
                        <h2 className="text-2xl font-black bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400 bg-clip-text text-transparent mb-2">
                            {mode === 'forgot' ? 'Reset Password' : 'Welcome Back!'}
                        </h2>
                        <p className="text-purple-200 text-sm">
                            {mode === 'forgot'
                                ? "Enter the email on your account and we'll send a reset link."
                                : 'Sign in with your username and password to access your stats on any device'}
                        </p>
                    </div>

                    <form onSubmit={handleSubmit} className="space-y-4">
                        {mode === 'login' ? (
                            <>
                                <div>
                                    <label className="block text-xs font-medium mb-1.5 text-slate-400 ml-1">Username</label>
                                    <div className="relative group">
                                        <div className="absolute left-4 top-3.5 text-slate-500 group-focus-within:text-cyan-300 transition-colors">
                                            <User className="w-5 h-5" />
                                        </div>
                                        <Input
                                            type="text"
                                            placeholder="Your username"
                                            value={username}
                                            onChange={(e) => setUsername(e.target.value)}
                                            required
                                            className="bg-slate-800/70 border-cyan-400/40 text-white placeholder:text-slate-500 pl-11 h-12 rounded-xl"
                                        />
                                    </div>
                                </div>
                                <div>
                                    <label className="block text-xs font-medium mb-1.5 text-slate-400 ml-1">Password</label>
                                    <div className="relative group">
                                        <div className="absolute left-4 top-3.5 text-slate-500 group-focus-within:text-cyan-300 transition-colors">
                                            <Lock className="w-5 h-5" />
                                        </div>
                                        <Input
                                            type={showPassword ? 'text' : 'password'}
                                            placeholder="••••••••"
                                            value={password}
                                            onChange={(e) => setPassword(e.target.value)}
                                            required
                                            className="bg-slate-800/70 border-cyan-400/40 text-white placeholder:text-slate-500 pl-11 pr-12 h-12 rounded-xl"
                                        />
                                        <button
                                            type="button"
                                            onClick={() => setShowPassword((v) => !v)}
                                            aria-label={showPassword ? 'Hide password' : 'Show password'}
                                            className="absolute right-3 top-2.5 p-1.5 text-slate-400 hover:text-purple-300 transition-colors touch-manipulation"
                                        >
                                            {showPassword ? <EyeOff className="w-5 h-5" /> : <Eye className="w-5 h-5" />}
                                        </button>
                                    </div>
                                </div>
                            </>
                        ) : (
                            <div>
                                <label className="block text-xs font-medium mb-1.5 text-slate-400 ml-1">Account Email</label>
                                <div className="relative group">
                                    <div className="absolute left-4 top-3.5 text-slate-500 group-focus-within:text-cyan-300 transition-colors">
                                        <Mail className="w-5 h-5" />
                                    </div>
                                    <Input
                                        type="email"
                                        placeholder="you@example.com"
                                        value={resetEmail}
                                        onChange={(e) => setResetEmail(e.target.value)}
                                        required
                                        className="bg-slate-800/70 border-cyan-400/40 text-white placeholder:text-slate-500 pl-11 h-12 rounded-xl"
                                    />
                                </div>
                                <p className="text-[11px] text-amber-300/80 mt-2 ml-1">
                                    This is the email on your account. Never added one? On the home screen, open
                                    the menu and tap{' '}
                                    <span className="font-semibold text-amber-200">Add a password</span> to add an
                                    email and password — then you can reset it yourself anytime.
                                </p>
                            </div>
                        )}

                        {error && (
                            <motion.div
                                initial={{ opacity: 0, y: -5 }}
                                animate={{ opacity: 1, y: 0 }}
                                className="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-200 text-sm flex items-center gap-2"
                            >
                                <span className="w-1.5 h-1.5 rounded-full bg-red-400" />
                                {error}
                            </motion.div>
                        )}
                        {message && (
                            <motion.div
                                initial={{ opacity: 0, y: -5 }}
                                animate={{ opacity: 1, y: 0 }}
                                className="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-200 text-sm"
                            >
                                {message}
                            </motion.div>
                        )}

                        <Button
                            type="submit"
                            className="w-full font-black py-5 text-base min-h-[48px] touch-manipulation rounded-xl mt-4 active:scale-95"
                            style={{
                                background: 'var(--u37-green)',
                                color: '#050310',
                                boxShadow: '0 0 26px -7px var(--u37-green), inset 0 1px 0 rgba(255,255,255,0.4)',
                            }}
                            disabled={loading}
                        >
                            {loading ? <Loader2 className="w-5 h-5 animate-spin" /> : (mode === 'forgot' ? 'Send Reset Link' : 'Sign In')}
                        </Button>

                        {/* Guidance covering BOTH returning-player cohorts, so neither is
                            left guessing by the "your password" copy above:
                              • secured (has a password) → use it (verify-only; never
                                overwritten, and "Forgot password?" resets it);
                              • legacy username-only (never set one) → any new password is
                                claimed on first login and their history reconnects. */}
                        {mode === 'login' && (
                            <p className="text-[11px] text-cyan-200/70 text-center mt-3 px-2 leading-relaxed">
                                Enter your <span className="font-semibold text-cyan-200">username</span> and password.
                                Set one before? Use it. <span className="font-semibold text-cyan-200">Never set a password?</span>{' '}
                                Pick a new one now and we&apos;ll reconnect your account and all your stats.
                            </p>
                        )}
                    </form>

                    <div className="mt-6 flex flex-col items-center gap-3 text-sm font-medium">
                        {mode === 'login' ? (
                            <button type="button" onClick={() => { setMode('forgot'); setError(''); setMessage(''); }} className="text-cyan-300 hover:text-white transition-colors font-semibold">
                                Forgot password?
                            </button>
                        ) : (
                            <button type="button" onClick={() => { setMode('login'); setError(''); setMessage(''); }} className="text-cyan-300 hover:text-white transition-colors font-semibold">
                                Back to Sign In
                            </button>
                        )}
                        <button
                            type="button"
                            onClick={() => navigate('/', { state: { showWelcome: true } })}
                            className="text-slate-400 hover:text-white transition-colors flex items-center gap-2"
                        >
                            <ArrowLeft className="w-4 h-4" />
                            Back to Welcome Screen
                        </button>
                    </div>
                </motion.div>
            </AnimatePresence>
        </div>
    );
}
