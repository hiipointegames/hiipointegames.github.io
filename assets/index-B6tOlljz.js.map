/** Every craft featId, in showcase order — the eight surviving families. */
export const CRAFT_FAMILY_IDS = Object.freeze(CRAFT_FAMILIES.map((f) => f.featId));

/**
 * The featIds this merge retired into rungs. Exported so the registry test can
 * assert none of them is ever a badge id again, and so the reason is greppable
 * from either side of the change.
 */
export const ABSORBED_FEAT_IDS = Object.freeze(CRAFT_FAMILIES.flatMap((f) => f.absorbs));

/**
 * One family's rung keys, low → high. The derivation resolves each key to a
 * predicate; a test pins that the two key sets match exactly, so a rung can
 * never ship without a predicate (or a predicate without a rung).
 * @param {string} featId
 * @returns {string[]}
 */
export function craftStageKeys(featId) {
  return CRAFT_FAMILIES.find((f) => f.featId === featId)?.stages.map((s) => s.key) ?? [];
}

/**
 * Expand one craft family into its Daily + Challenge entries.
 * @param {typeof CRAFT_FAMILIES[number]} family
 * @returns {BadgeDefinition[]}
 */
export function expandCraftFeat(family) {
  const base = {
    featId: family.featId,
    category: /** @type {BadgeCategory} */ ('craft'),
    hidden: family.hidden,
    art: family.art,
    icon: family.icon,
    availableFrom: CRAFT_MERGE_DATE,
  };
  // A fresh scaling object per entry: `assignBadgeIdentities` and the renderers
  // treat every badge as independent, and a shared ladder object would let one
  // entry's mutation leak into its twin.
  // TIER ICONS FOLLOW THEIR RUNG, NOT ITS INDEX.
  //
  // `family.tierIcons` is keyed by position in the FULL ladder — `{4:
  // 'vanishing-point'}` is Event Horizon's fifth rung. Every per-tier entry has
  // a different ladder (Easy prunes the power-dice rungs; Expert keeps one rung
  // and repeats it), so replaying those keys verbatim points an icon at a rung
  // that may not exist: Easy Event Horizon has four rungs, and index 4 is off
  // the end. Re-key by the rung the icon BELONGS to and drop any whose rung this
  // ladder does not have.
  /** @type {Map<string, string>} */
  const iconByKey = new Map();
  for (const [index, icon] of Object.entries(family.tierIcons ?? {})) {
    const key = family.stages[Number(index)]?.key;
    if (key) iconByKey.set(key, /** @type {string} */ (icon));
  }
  const scaling = (stages, extra = {}) => {
    /** @type {Record<number, string>} */
    const tierIcons = {};
    stages.forEach((stage, index) => {
      const icon = iconByKey.get(stage.key);
      if (icon) tierIcons[index] = icon;
    });
    return stageLadder(
      stages.map((stage) => ({ ...stage })),
      { ...(Object.keys(tierIcons).length ? { tierIcons } : {}), ...extra },
    );
  };

  const entries = [];

  // ── EASY (Daily only) ────────────────────────────────────────────────────
  // David's standing ruling: Easy gets a SMALLER, EASY-SPECIFIC SET, not the
  // shared families reused. Easy has no power dice, so `blueDivision`,
  // `exponentLast` and `perfect` can never be true and an Easy equation carries
  // no exponent — which makes The Great Divide and Rise to Power unreachable
  // ENTIRELY (6 of 8 families remain, exactly as David said) and prunes the
  // perfect rung off every survivor.
  //
  // The subset is DERIVED from `needsPowerDice` rather than hand-listed, so a
  // rung added later is classified once, at the rung, instead of in a parallel
  // list that can drift. Shipping the untruncated families here would have given
  // Easy players ~13 rungs that can never light.
  const easyStages = family.stages.filter((stage) => !stage.needsPowerDice);
  if (easyStages.length > 0) {
    entries.push({
      ...base,
      id: `${family.featId}DailyEasy`,
      mode: /** @type {BadgeMode} */ ('dailyEasy'),
      name: family.dailyName,
      scaling: scaling(easyStages),
      criteriaText: `${family.how} — in the Easy Daily.`,
      criteriaScope: 'in the Easy Daily',
      availableFrom: THREE_MODE_BADGES_DATE,
    });
  }

  // ── CHALLENGE (Daily + practice) ─────────────────────────────────────────
  // The original pair, unchanged. `daily` is Challenge's Daily — the legacy wire
  // key every existing badge id is written in terms of.
  entries.push({
    ...base,
    id: `${family.featId}Daily`,
    mode: /** @type {BadgeMode} */ ('daily'),
    name: family.dailyName,
    scaling: scaling(family.stages),
    criteriaText: `${family.how} — in the Challenge Daily.`,
    criteriaScope: 'in the Challenge Daily',
  });
  entries.push({
    ...base,
    id: `${family.featId}Challenge`,
    mode: /** @type {BadgeMode} */ ('challenge'),
    name: family.challengeName,
    scaling: scaling(family.stages),
    // STALE COPY FIXED 2026-09-04: this said "in Challenge free-play", which had
    // been narrower than the badge since the per-mode ruling. It is now narrower
    // again in the OTHER direction and correct: Expert practice has its own
    // entry below, so this really is Challenge practice alone.
    criteriaText: `${family.how} — in Challenge practice.`,
    criteriaScope: 'in Challenge practice',
  });

  // ── EXPERT (Daily + practice) — ONLY THE PERFECT RUNG ────────────────────
  // David's ruling, and it is a DEFECT FIX rather than a presentation choice.
  //
  // Expert requires a perfect solve (`requiresPerfectSolve`,
  // `requiredPowerDiceCount('daily_expert') === 3`), so `facts.perfect` is
  // ALWAYS true on an Expert row. Every family's top rung is `<shape> &&
  // perfect`, which on Expert reduces to `<shape>` — the same predicate as the
  // family's OPENING rung. Since `highestStageReached` is "highest reached, not
  // first gap", ONE Expert solve reached the top rung of 7 of the 8 families,
  // measured against the shipped derivation. The base rungs were not dead
  // weight; they made the ladder collapse to a single tap.
  //
  // So Expert shows the perfect feat and ladders on REPETITION, which is the
  // only axis with anything left to say once every solve is perfect.
  //
  // A family with NO perfect rung keeps its own ladder on Expert. Constellation
  // is the only one: its top rungs are COUNTS (Three Clusters ×10/×37/×100), not
  // a perfect variant, so nothing about it collapses when `perfect` is always
  // true — one Expert solve reaches rung 3 of 6, exactly as in Challenge. The
  // collapse is caused by perfect rungs specifically, so the pruning is too.
  const perfectStage = family.stages.find((stage) => stage.perfect);
  {
    const expertStages = perfectStage
      ? EXPERT_REPEATS.map(({ suffix, times, label }) => ({
        key: `${perfectStage.key}${suffix}`,
        label: label(perfectStage.label),
        criteria: times === 1
          ? perfectStage.criteria
          : `${perfectStage.criteria}, ${times} times`,
      }))
      : family.stages.filter((stage) => !stage.needsPowerDice || stage.key === 'exponent');
    entries.push({
      ...base,
      id: `${family.featId}DailyExpert`,
      mode: /** @type {BadgeMode} */ ('dailyExpert'),
      name: family.dailyName,
      scaling: scaling(expertStages),
      criteriaText: `${family.how} — in the Expert Daily, where every solve is perfect.`,
      criteriaScope: 'in the Expert Daily',
      availableFrom: THREE_MODE_BADGES_DATE,
    });
    entries.push({
      ...base,
      id: `${family.featId}Expert`,
      mode: /** @type {BadgeMode} */ ('expert'),
      name: family.challengeName,
      scaling: scaling(expertStages),
      criteriaText: `${family.how} — in Expert practice, where every solve is perfect.`,
      criteriaScope: 'in Expert practice',
      availableFrom: THREE_MODE_BADGES_DATE,
    });
  }

  return entries;
}

