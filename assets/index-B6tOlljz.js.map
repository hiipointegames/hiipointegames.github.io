import { useCallback, useEffect, useState } from 'react';

// Shared sound-mute preference.
//
// The single source of truth is localStorage['soundMuted'] — the same key
// playSound() reads on every call (see ./sounds.js). This module lets multiple
// mounted controls (the drawer's "Mute Sound" item AND the in-game speaker
// toggle) share that one preference and stay in sync: writing it broadcasts a
// `soundMuteChanged` event, and every useSoundMute() consumer re-reads on that
// event (plus the native cross-tab `storage` event). That's what stops the
// in-game toggle and the drawer from diverging — and why hiding the drawer
// mid-daily doesn't strand the mute control.

const KEY = 'soundMuted';
const EVENT = 'soundMuteChanged';

export function isSoundMuted() {
  try {
    return localStorage.getItem(KEY) === 'true';
  } catch {
    return false;
  }
}

export function setSoundMuted(muted) {
  try {
    localStorage.setItem(KEY, String(muted));
  } catch {
    /* storage unavailable — the in-memory consumers still update via the event */
  }
  window.dispatchEvent(new CustomEvent(EVENT, { detail: { muted } }));
}

// React binding: `{ muted, toggleMute }`. `muted` tracks the shared preference
// and updates whenever any consumer toggles it.
export function useSoundMute() {
  const [muted, setMutedState] = useState(isSoundMuted);

  useEffect(() => {
    const sync = () => setMutedState(isSoundMuted());
    window.addEventListener(EVENT, sync);
    window.addEventListener('storage', sync);
    return () => {
      window.removeEventListener(EVENT, sync);
      window.removeEventListener('storage', sync);
    };
  }, []);

  const toggleMute = useCallback(() => {
    setSoundMuted(!isSoundMuted());
  }, []);

  return { muted, toggleMute };
}
