import { useEffect } from 'react';

// celebrationChrome — how a celebration overlay gets the screen to itself.
//
// 🔴 THE DEFECT THIS FIXES. `BottomNavBar` portals to <body> at `zIndex: 140`
// (home/BottomNavBar.jsx). `AwardCelebrationSequence` and `RetroactiveBadgeMoment`
// rendered at `z-[120]`. So on every surface that shows a celebration WITHOUT
// going through Game.jsx's home-chrome gate — Statistics, and head-to-head — the
// navigation bar painted ON TOP of the celebration, and its tabs stayed tappable
// through a screen that is supposed to be modal. A player could tap "Stats" out
// of their own badge announcement.
//
// WHY HIDING THE NAV, NOT RAISING THE CELEBRATION (David, 2026-08-31 §4): a
// celebration is modal, and a nav bar behind a full-screen modal is not something
// the player should be able to tap. Raising z-indexes leaves it hittable-adjacent
// and starts a numbers race in a stack that already runs 50→200 by hand with no
// registry.
//
// The bus already exists. Layout listens for 'bottomNavChanged' and feeds
// `{ hidden }` into the nav's `suppressed` lever (routing/Layout.jsx
// handleBottomNav → home/bottomNavVisibility isBottomNavVisible). This is the
// same mechanism how-to-play/HowToOverlay uses for the same class of bug — a
// full-width CTA whose taps fell through to a nav tab underneath.
//
// ⚠️ On the GAME route the nav was already hidden during a celebration, because
// Game.jsx feeds `pendingAwardCount` into isHomeLauncherActive and broadcasts
// 'homeChromeChanged'. That is why the defect was invisible on the surface people
// test most. Fixing it HERE, in the overlays themselves, fixes it on every route
// at once and means a future caller cannot forget.

/**
 * The stacking level a celebration paints at — deliberately ABOVE the nav bar's
 * 140. This is the second belt, not the mechanism: suppression is what makes the
 * bar non-interactive, and this only guarantees that a render which lands before
 * the event is processed still isn't drawn underneath it. Mirrors the z-[150]
 * HowToOverlay already uses over the same nav bar.
 */
export const CELEBRATION_Z_INDEX = 150;

// How many celebration overlays are currently asking for the nav to be hidden.
//
// Refcounted rather than a bare boolean because the overlays are independent
// components: on Statistics a retroactive moment and an award sequence can be
// mounted in the same render pass, and whichever unmounts FIRST would otherwise
// restore the nav underneath the one still on screen. Module scope is the right
// scope — there is exactly one nav bar.
let openCelebrations = 0;

function broadcast(hidden) {
  window.dispatchEvent(new CustomEvent('bottomNavChanged', { detail: { hidden } }));
}

/**
 * Hide the bottom nav bar for as long as `active` is true, and restore it when
 * the last celebration closes or unmounts.
 *
 * Cleanup runs on unmount too, so a celebration torn down mid-animation (a route
 * change, an error boundary) can never leave the bar stuck hidden.
 *
 * @param {boolean} active is this celebration on screen right now?
 */
export function useHideNavWhileCelebrating(active) {
  useEffect(() => {
    if (!active) return undefined;
    openCelebrations += 1;
    if (openCelebrations === 1) broadcast(true);
    return () => {
      openCelebrations = Math.max(0, openCelebrations - 1);
      if (openCelebrations === 0) broadcast(false);
    };
  }, [active]);
}

/** Test seam: reset the refcount between cases. Not used by production code. */
export function __resetCelebrationChrome() {
  openCelebrations = 0;
}
