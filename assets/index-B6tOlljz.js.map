// Apply a single puzzle solve to a stats object — the ledger derivation
// that runs after a winning equation is submitted.
//
// Pure function. The caller (typically pages/Game.jsx handleSubmit) is
// responsible for orchestrating side effects: persisting `updatedStats`,
// firing the milestone modal on `newlyReachedStreakMilestone`, playing
// celebration sounds, etc. This module only derives the new stats shape.
//
// today / yesterday are passed in as 'YYYY-MM-DD' strings (the daily
// challenge's "what counts as today" rule lives in the caller — see
// docs/architecture/lexicon.md and the pending dailyTimezone helper).
//
// ─────────────────────────────────────────────────────────────────────────────
// 🔴 THE TRAP THIS FILE WAS LEFT AS, AND WHY `isDaily()` IS THE WRONG ANSWER
// ─────────────────────────────────────────────────────────────────────────────
// Slice 2 converted every call site in the codebase to the @/game-modes
// vocabulary and DELIBERATELY skipped this one. The reason is the single easiest
// mistake to make in the whole three-mode effort:
//
//     mode === 'daily'   is NOT   isDaily(mode)
//
// `'daily'` is CHALLENGE's Daily — a legacy wire key, frozen because it is live
// in real player data (see src/game-modes/modeKeys.js). `isDaily()` is true for
// ALL THREE timed rounds. So the "obvious" mechanical substitution routes Easy's
// Daily and Expert's Daily straight into CHALLENGE's counters — its streak, its
// time milestones, its solutions array, its perfect-streak milestones — the
// moment `'daily_easy'` exists. Silently, on live data, retroactively visible
// everywhere W2-STATS renders.
//
// Every Challenge-Daily field below is therefore gated on `isChallengeDaily`,
// which asks BOTH questions (is it the Daily? is it Challenge's?) and can never
// be true for the other two modes. The test file pins that solving `daily_easy`
// leaves every `daily` field byte-identical.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHERE EASY'S AND EXPERT'S DAILY STATE ACTUALLY LIVES — AND WHY NOT HERE
// ─────────────────────────────────────────────────────────────────────────────
// The three per-mode Daily counters and the three independent Daily streaks
// (David's ruling Q-F) live at `game_stats.perMode.<key>` and are DERIVED ON
// READ by `get-player-stats` from `daily_challenge_times` +
// `daily_challenge_attempts` — the event log that is the truth. They are NOT
// stored, and this function does not write them. Three reasons, in order of
// weight:
//
//   1. This project's documented disease is exactly that: stored client-
//      maintained aggregates drifting away from daily_challenge_times. Adding
//      three more stored counters here is the disease, not the cure.
//   2. A client-stored `perMode` would be silently overwritten by the derived
//      one every time `get-player-stats` answers — two writers, one name.
//   3. The lane contract freezes `perMode` as W2-BOARDS' seam. Producing it here
//      would be a second producer of someone else's contract.
//
// So a `daily_easy` solve moving nothing mode-specific in THIS blob is correct,
// not a gap. What makes that solve count is the `daily_challenge_times` row
// written with `mode = 'daily_easy'` by the referee — and the fields below stay
// meaning what every shipped build already thinks they mean.
//
// The two LEGACY streak fields are the other half of the trap. `easyDailyStreak`
// and `challengeDailyStreak` read exactly like "Easy's Daily streak" and
// "Challenge's Daily streak" and are neither: they count PRACTICE streaks, and
// they always have. Repurposing them would merge a practice streak into a Daily
// streak on live player data. Lane contract §3.6 freezes them as practice, and
// they are not renamed either — a rename is a data migration for zero gain.

import { isPerfectSolve } from '@/equation-engine';
import { isDaily, isPractice, modeOf, isKnownModeKey } from '@/game-modes';
import { STREAK_MILESTONES, PERFECT_MILESTONES } from './milestones';

const TIME_THRESHOLDS = [10, 20, 30, 60, 90, 120, 180, 240, 300, 600];

/**
 * CHALLENGE's Daily, and nothing else — the legacy `'daily'` key.
 *
 * Asks both halves of the question on purpose. `isDaily(key)` alone is the trap
 * described in this file's header; `modeOf(key) === 'challenge'` alone would also
 * match untimed Challenge PRACTICE.
 */
const isChallengeDaily = (key) => isDaily(key) && modeOf(key) === 'challenge';

/** Untimed EASY practice — the legacy `'easy'` key. */
const isEasyPractice = (key) => isPractice(key) && modeOf(key) === 'easy';

/** Untimed CHALLENGE practice — the legacy `'challenge'` key. */
const isChallengePractice = (key) => isPractice(key) && modeOf(key) === 'challenge';

export function awardDailyChallengeSolve({
  prev,
  mode,
  solveTimeSeconds,
  equation,
  usedDiceIndices,
  usedDiceIds,
  diceColors,
  dice,
  today,
  yesterday,
}) {
  // STRICT membership, not a predicate. Every predicate in @/game-modes
  // NORMALISES first, so `isPractice('nonsense')` is true — right for rendering,
  // wrong for a write gate, and the precise mistake recordPracticeSolve
  // documents having been bitten by. An unrecognised mode must record NOTHING
  // rather than be filed as Easy: this blob is persisted to the player's account
  // on the very next line of the caller.
  //
  // Loud, because the failure it replaces (silently crediting the wrong mode) is
  // invisible, and because a mode reaching here unrecognised means a caller bug.
  if (!isKnownModeKey(mode)) {
    console.warn(`awardDailyChallengeSolve ignoring unrecognised mode ${JSON.stringify(mode)} — nothing recorded`);
    return { updatedStats: prev, newlyReachedStreakMilestone: null, isPerfect: false };
  }

  const challengeDaily = isChallengeDaily(mode);

  const newCurrentStreak = prev.currentStreak + 1;
  const newBestStreak = Math.max(newCurrentStreak, prev.bestStreak);

  let newEasyDailyStreak = prev.easyDailyStreak || 0;
  let newChallengeDailyStreak = prev.challengeDailyStreak || 0;
  let newDailyChallengeStreak = prev.dailyChallengeStreak || 0;
  let newlyReachedStreakMilestone = null;
  let updatedReachedMilestones = null;

  if (isEasyPractice(mode)) {
    const lastEasyDate = prev.lastEasyDate;
    if (!lastEasyDate || lastEasyDate === today) {
      newEasyDailyStreak = prev.easyDailyStreak || 1;
    } else if (lastEasyDate === yesterday) {
      newEasyDailyStreak = (prev.easyDailyStreak || 0) + 1;
    } else {
      newEasyDailyStreak = 1;
    }
  } else if (isChallengePractice(mode)) {
    const lastChallengeDate = prev.lastChallengeDate;
    if (!lastChallengeDate || lastChallengeDate === today) {
      newChallengeDailyStreak = prev.challengeDailyStreak || 1;
    } else if (lastChallengeDate === yesterday) {
      newChallengeDailyStreak = (prev.challengeDailyStreak || 0) + 1;
    } else {
      newChallengeDailyStreak = 1;
    }
  } else if (challengeDaily) {
    const lastDailyChallengeDate = prev.lastDailyChallengeDate;
    if (!lastDailyChallengeDate || lastDailyChallengeDate === today) {
      newDailyChallengeStreak = prev.dailyChallengeStreak || 1;
    } else if (lastDailyChallengeDate === yesterday) {
      newDailyChallengeStreak = (prev.dailyChallengeStreak || 0) + 1;
    } else {
      newDailyChallengeStreak = 1;
    }

    const reachedMilestones = prev.reachedMilestones || [];
    const newMilestone = STREAK_MILESTONES.find(m =>
      newDailyChallengeStreak === m && !reachedMilestones.includes(m)
    );

    updatedReachedMilestones = [...reachedMilestones];
    if (newMilestone) {
      updatedReachedMilestones.push(newMilestone);
      newlyReachedStreakMilestone = newMilestone;
    }
  }
  // 'daily_easy', 'daily_expert' and 'expert' practice reach none of the
  // branches above, and that is the design — see this file's header. Their state
  // is derived from daily_challenge_times, not accumulated here.

  // `dailyChallengeTimes` and `dailyChallengeSolutions` are CHALLENGE-Daily
  // blobs, matching every other legacy field, and are deliberately NOT extended
  // to the other two modes: daily_challenge_times is the truth and these blobs
  // are the documented drift hazard.
  const updatedDailyTimes = challengeDaily
    ? [...(prev.dailyChallengeTimes || []).filter(t => t.date !== today), { date: today, time: solveTimeSeconds }]
        .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    : (prev.dailyChallengeTimes || []);

  const updatedSolutions = challengeDaily
    ? [...(prev.dailyChallengeSolutions || []).filter(s => s.date !== today), {
        date: today,
        equation,
        time: solveTimeSeconds,
        usedDiceIndices,
        usedDiceIds,
        diceData: dice.map(d => ({ id: d.id, value: d.value, originalIndex: d.originalIndex })),
        shuffledDice: dice.map(d => d.value),
        diceColors,
      }]
        .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    : (prev.dailyChallengeSolutions || []);

  const timeMilestones = prev.timeMilestones || { 600: 0, 300: 0, 240: 0, 180: 0, 120: 0, 90: 0, 60: 0, 30: 0 };
  const newTimeMilestones = { ...timeMilestones };
  const fastestTimeMilestones = { ...(prev.fastestTimeMilestones || {}) };

  // The speed ladder stays a CHALLENGE-Daily badge until Wave 3 says otherwise
  // (David's ruling Q-C). Firing it for Easy — a strictly easier board — would
  // hand out the whole ladder retroactively the first week.
  if (challengeDaily && solveTimeSeconds > 0) {
    TIME_THRESHOLDS.forEach(threshold => {
      if (solveTimeSeconds < threshold) {
        newTimeMilestones[threshold] = (timeMilestones[threshold] || 0) + 1;
      }
    });

    const fastestCategory = TIME_THRESHOLDS.find(s => solveTimeSeconds < s);
    if (fastestCategory) {
      fastestTimeMilestones[fastestCategory] = (fastestTimeMilestones[fastestCategory] || 0) + 1;
    }
  }

  const perfectStreakMilestones = { ...(prev.perfectStreakMilestones || {}) };
  let newPerfectStreak = prev.currentPerfectStreak || 0;
  let isPerfect = false;

  if (challengeDaily) {
    isPerfect = isPerfectSolve(equation, usedDiceIndices, diceColors);

    if (isPerfect) {
      newPerfectStreak = newPerfectStreak + 1;
      PERFECT_MILESTONES.forEach(threshold => {
        // The `threshold === 7.1` branch is vestigial — the array currently
        // contains [2, 7, 14, 21, 28, 37] with no 7.1. Preserved verbatim
        // from the inline implementation to keep behavior identical.
        const milestoneKey = threshold === 7.1 ? 7 : threshold;
        if (newPerfectStreak === milestoneKey) {
          perfectStreakMilestones[milestoneKey] = (perfectStreakMilestones[milestoneKey] || 0) + 1;
        }
      });
    } else {
      newPerfectStreak = 0;
    }
  }

  const updatedStats = {
    ...prev,
    // totalSolved / currentStreak / bestStreak are MODE-AGNOSTIC by design:
    // "puzzles you have solved" and "solves in a row" are one number across
    // every mode, and always have been. They move for all six wire keys.
    totalSolved: prev.totalSolved + 1,
    easySolved: isEasyPractice(mode) ? prev.easySolved + 1 : prev.easySolved,
    challengeSolved: isChallengePractice(mode) ? prev.challengeSolved + 1 : prev.challengeSolved,
    dailyChallengeSolved: challengeDaily ? prev.dailyChallengeSolved + 1 : prev.dailyChallengeSolved,
    currentStreak: newCurrentStreak,
    bestStreak: newBestStreak,
    easyDailyStreak: newEasyDailyStreak,
    challengeDailyStreak: newChallengeDailyStreak,
    dailyChallengeStreak: newDailyChallengeStreak,
    longestDailyChallengeStreak: challengeDaily
      ? Math.max(newDailyChallengeStreak, prev.longestDailyChallengeStreak || 0)
      : prev.longestDailyChallengeStreak,
    lastEasyDate: isEasyPractice(mode) ? today : prev.lastEasyDate,
    lastChallengeDate: isChallengePractice(mode) ? today : prev.lastChallengeDate,
    lastDailyChallengeDate: challengeDaily ? today : prev.lastDailyChallengeDate,
    dailyChallengeTimes: updatedDailyTimes,
    dailyChallengeSolutions: updatedSolutions,
    reachedMilestones: updatedReachedMilestones || prev.reachedMilestones || [],
    timeMilestones: newTimeMilestones,
    fastestTimeMilestones,
    perfectStreakMilestones,
    currentPerfectStreak: newPerfectStreak,
    podiumFinishes: prev.podiumFinishes || { first: 0, second: 0, third: 0 },
  };

  return {
    updatedStats,
    newlyReachedStreakMilestone,
    isPerfect,
  };
}
