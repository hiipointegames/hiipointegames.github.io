import { lazy } from 'react';

// ── Route-level code splitting (perf, 2026-09-03) ──────────────────────────────
//
// Every page below used to be a STATIC import (`import Badges from
// '../pages/Badges'`), so Rollup put all ten of them — and everything they reach
// — in the entry graph. Measured on origin/main @ eef86bb: index.html eagerly
// pulled 560.4 KB gz across 8 files before a single pixel of the home screen,
// including `vendor-recharts` (102.5 KB gz), a charting library reachable ONLY
// from Statistics via components/stats/WeeklyPerformanceGraph.
//
// This matters more here than in a typical web app: a CapGo OTA bundle has to
// download inside a 25-SECOND TIMEOUT (docs/capgo-ota-runbook.md), which is the
// same budget that forced the intro video to be re-encoded down to 2.2 MB so it
// could be bundled instead of streamed.
//
// `lazy()` turns each entry into a dynamic import, so Rollup emits a separate
// chunk per page and the browser fetches one only when its route is visited.
// The <Suspense> boundary that catches the wait lives in App.jsx (inside the
// Layout, so route transitions keep the app chrome and show DiceLoader rather
// than blanking to a different-looking screen).
//
// ⚠️ If you make one of these a STATIC import again — here or anywhere else that
// is reachable from the entry — that page's whole dependency graph silently
// rejoins the entry chunk and the split becomes a no-op that still LOOKS split.
// entryChunkSplit.test.js pins the invariant for recharts specifically.
const Badges = lazy(() => import('../pages/Badges'));
const BlitzStats = lazy(() => import('../pages/BlitzStats'));
const FriendList = lazy(() => import('../pages/FriendList'));
const Game = lazy(() => import('../pages/Game'));
const HeadToHead = lazy(() => import('../pages/HeadToHead'));
const Leaderboard = lazy(() => import('../pages/Leaderboard'));
const HowToPlay = lazy(() => import('../pages/HowToPlay'));
const OtherProfile = lazy(() => import('../pages/OtherProfile'));
const Statistics = lazy(() => import('../pages/Statistics'));
const ResetPassword = lazy(() => import('../pages/ResetPassword'));
// Sector 73 — the secret universe (cockpit world + its modes). Lazy like every
// page, and it stays its OWN chunk: no player downloads it until they fly in.
const Sector73 = lazy(() => import('../sector73/Sector73Page'));

// Layout stays EAGER on purpose: it is the app chrome, it wraps every routed
// page, and it hosts the <Suspense> fallback. Lazy-loading it would mean the
// first paint of every route waits on a second round-trip and the fallback would
// have nowhere to render.
import __Layout from './Layout.jsx';

// Home.jsx (an empty placeholder) and Profile.jsx (never in this map → no route,
// unreachable) were deleted in the WS3 nav sweep (2026-07-13). The Friends
// experience lives in the home launcher's Friends & Players screen, not a
// /Profile route.
const PAGES = {
    // /Badges — the full badge showcase (Badge System Redesign L2). Takes the
    // same `?id=<playerId>` convention as Statistics, so it renders any player.
    "Badges": Badges,
    "BlitzStats": BlitzStats,
    "FriendList": FriendList,
    "Game": Game,
    "HeadToHead": HeadToHead,
    "Leaderboard": Leaderboard,
    "HowToPlay": HowToPlay,
    "OtherProfile": OtherProfile,
    "ResetPassword": ResetPassword,
    "Statistics": Statistics,
    "Sector73": Sector73,
}

export const pagesConfig = {
    mainPage: "Game",
    Pages: PAGES,
    Layout: __Layout,
};
