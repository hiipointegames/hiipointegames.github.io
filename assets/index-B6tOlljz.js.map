// transport/sessionResolution — "is somebody signed in?" that survives being offline.
//
// WHY THIS EXISTS
// ───────────────
// `supabase.auth.getSession()` answers from storage while the access token is
// fresh. Once it has expired (an hour after the last refresh) it must call the
// auth server to refresh it. If that call cannot reach the server — no signal,
// a dropped link, a 502/503/504 — supabase-js returns `{ session: null, error:
// AuthRetryableFetchError }` but KEEPS the real session in storage, so it can
// refresh it later when the network comes back.
//
// Every caller used to read that `null` as "nobody is signed in" and create an
// anonymous guest. Offline, the guest sign-in failed too and the app sat on the
// loading screen. On a flaky network the guest sign-in SUCCEEDED and its session
// overwrote the member's in storage: the player was signed out for good and
// their play landed on a throwaway guest account. See docs/bugs.md (2026-10-20).
//
// `resolveSession()` tells the two cases apart:
//   • session    — a usable session (same as getSession).
//   • offline    — the server could not be reached, but a real session is still
//                  stored. `user` is that stored user. Do NOT create a guest;
//                  supabase-js keeps retrying the refresh and announces the
//                  fresh session through onAuthStateChange (TOKEN_REFRESHED).
//   • neither    — genuinely nobody signed in (or the refresh token was
//                  rejected, in which case supabase-js already removed it).
import { supabase } from './supabaseClient';

/** True for supabase-js's "could not reach the auth server" error. */
export function isNetworkAuthError(error) {
  return error?.name === 'AuthRetryableFetchError';
}

/**
 * The session supabase-js has persisted, read straight from its storage — no
 * network, no auth lock (safe inside an onAuthStateChange callback).
 * Returns null when there is none or it cannot be read.
 */
export async function readStoredSession() {
  // `storage` / `storageKey` are runtime properties of the GoTrue client that
  // its type marks protected; they are the only way to read the persisted
  // session without triggering a refresh.
  const auth = /** @type {any} */ (supabase.auth);
  const storage = auth?.storage;
  const key = auth?.storageKey;
  if (!storage || !key) return null;
  try {
    const raw = await storage.getItem(key);
    const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
    if (parsed?.refresh_token && parsed?.user?.id) return parsed;
    return null;
  } catch {
    return null;
  }
}

/**
 * @returns {Promise<{ session: any, user: any, offline: boolean, error: any }>}
 */
export async function resolveSession() {
  const { data, error } = await supabase.auth.getSession();
  const session = data?.session ?? null;
  if (session) return { session, user: session.user ?? null, offline: false, error: null };
  if (isNetworkAuthError(error)) {
    const stored = await readStoredSession();
    if (stored) return { session: null, user: stored.user, offline: true, error };
  }
  return { session: null, user: null, offline: false, error: error ?? null };
}
