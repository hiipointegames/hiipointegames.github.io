// WHAT goes on the share card, as plain data — kept apart from HOW it is drawn
// (./drawShareCard) so every rule about content is testable without a canvas.
//
// The card (approved 2026-09-29):
//   top     "37" · "CHALLENGE DAILY #159" · "@username · Sep 29, 2026"
//   dice    today's 7 dice — the 4 white ones face up, the last 3 face down "?"
//           (the three power dice; on Easy, the last three white dice)
//   result  power squares · time · PERFECT   — or —   "37 WON TODAY" on a forfeit
//   pct     "Faster than 70% of solvers today" (only on a big enough board)
//   foot    "3 POWER DICE HIDDEN" / "Reveal them in the 37 app"
//
// ⚠️ NOTHING ON THE CARD MAY LOOK TAPPABLE. A picture in a message opens
// full-screen when tapped, in every messaging app; it can never follow a link.
// So the foot is a caption, not a button — no arrow, no filled call-to-action.
// The only way in is the link in the message text.

import { getPowerDiceCorrectness } from '@/equation-engine';
import { shareTime } from './shareMessage';

export const TIER_TITLE = Object.freeze({
  easy: 'EASY DAILY',
  challenge: 'CHALLENGE DAILY',
  expert: 'EXPERT DAILY',
});

/** The "faster than" line is hidden below this many solvers: "faster than 100% of
 *  2 solvers" at 7am reads as a joke, not a boast. */
export const PCT_MIN_BOARD = 10;

const POWER = ['blue', 'red', 'green'];

/**
 * Which power dice this solve used correctly, by colour, in blue/red/green order.
 * Derived from the SAME engine that scores the solve, so the card can never show a
 * lit square the game did not award.
 * @returns {boolean[]|null} null when the working is not available
 */
export function powerSquaresFrom(equation, usedIndices, colors) {
  if (!equation || !Array.isArray(usedIndices) || !Array.isArray(colors)) return null;
  const lit = { blue: false, red: false, green: false };
  let map;
  try { map = getPowerDiceCorrectness(equation, usedIndices, colors); } catch { return null; }
  map.forEach((ok, numIdx) => {
    const color = colors[usedIndices[numIdx]];
    if (ok && color in lit) lit[color] = true;
  });
  return POWER.map((c) => lit[c]);
}

/**
 * Share of today's OTHER solvers who were slower, as a whole percent.
 * @param {Array<{solve_time_seconds?: number}>} board today's board for this mode
 * @param {number} seconds this player's time
 * @returns {number|null} null when the board is too small to be meaningful
 */
export function fasterThanPct(board, seconds) {
  const times = (Array.isArray(board) ? board : [])
    .map((r) => Number(r?.solve_time_seconds))
    .filter((t) => Number.isFinite(t) && t > 0);
  if (times.length < PCT_MIN_BOARD || !(seconds > 0)) return null;
  const slower = times.filter((t) => t > seconds).length;
  return Math.round((100 * slower) / times.length);
}

/**
 * @param {object} p
 * @param {'easy'|'challenge'|'expert'} p.tier
 * @param {'perfect'|'solved'|'forfeit'} p.result
 * @param {number|null} [p.seconds]
 * @param {number|null} p.puzzleNumber
 * @param {string} p.dateLabel e.g. "Sep 29, 2026"
 * @param {string|null} [p.username] null for a guest — the card then shows no name
 * @param {number[]|null} [p.dice] today's 7 dice in STORED order (power dice last)
 * @param {boolean[]|null} [p.squares] blue/red/green used correctly
 * @param {number|null} [p.pct]
 */
export function buildCardModel({
  tier, result, seconds = null, puzzleNumber, dateLabel, username = null,
  dice = null, squares = null, pct = null,
}) {
  const power = tier !== 'easy';
  const lost = result === 'forfeit';
  const colors = power ? ['white', 'white', 'white', 'white', ...POWER] : Array(7).fill('white');
  const values = Array.isArray(dice) && dice.length === 7 ? dice : Array(7).fill(null);

  let resultSquares = null;
  if (power) {
    if (lost) resultSquares = [false, false, false];
    else if (result === 'perfect') resultSquares = [true, true, true];
    else if (Array.isArray(squares) && squares.length === 3) resultSquares = squares.map(Boolean);
    // A solved-but-not-perfect Challenge with no working available shows no
    // squares rather than guessing which dice were right.
  }

  return {
    title: `${TIER_TITLE[tier] || TIER_TITLE.challenge}${puzzleNumber ? ` #${puzzleNumber}` : ''}`,
    username: username ? `@${username}` : null,
    dateLabel,
    // Positions 4..6 are hidden: the power dice (stored last on every Daily,
    // verified on prod) or, on Easy, the last three white dice. Every player's
    // card for a day therefore reveals the SAME four dice — two cards together can
    // never show more of the puzzle than one.
    dice: values.map((value, i) => ({ value: i < 4 ? value : null, color: colors[i], hidden: i >= 4 || value == null })),
    squares: resultSquares,
    time: lost ? null : shareTime(seconds),
    badge: lost ? '37 WON TODAY' : (power && result === 'perfect' ? 'PERFECT' : null),
    lost,
    pctLine: !lost && pct != null ? `Faster than ${pct}% of solvers today` : null,
    footTop: power ? '3 POWER DICE HIDDEN' : '3 DICE HIDDEN',
    footBottom: 'Reveal them in the 37 app',
  };
}
