import React, { useState } from 'react';
import { createPortal } from 'react-dom';

import {
  PUZZLE_POINTS, BATTLE_POINTS, PIECES_PER_PERFECT_CHALLENGE, PIECES_PER_FAST_EXPERT, EXPERT_PIECE_SECONDS,
} from '@/game-mechanics';
// The original tiered badge artwork (puzzle piece / Spartan helmet, in bronze/
// silver/gold), now bundled INTO the app — no external URL. See src/assets/badges.
import { BADGE_IMAGES } from '@/assets/badges';

// 8A: tap-to-learn content. The popup names the badge, explains how it's earned,
// and reads out the holder's actual tier standing (so a Gold holder sees Gold
// info, a Bronze holder sees Bronze). Thresholds come from the live milestone
// config so copy can never drift from the real rules.
const BADGE_INFO = {
  puzzle: {
    name: 'Puzzle Piece Badge',
    how: `Earned from Dailies: a perfect Challenge Daily = ${PIECES_PER_PERFECT_CHALLENGE} piece; an Expert Daily under ${EXPERT_PIECE_SECONDS} seconds = ${PIECES_PER_FAST_EXPERT}.`,
    thresholds: { bronze: PUZZLE_POINTS.BRONZE, silver: PUZZLE_POINTS.SILVER, gold: PUZZLE_POINTS.GOLD },
    unit: 'puzzle pieces',
  },
  battle: {
    name: 'Battle Points Badge',
    how: 'Earned by winning Blitz head-to-head battles in the Colosseum. The more you win, the higher your tier.',
    thresholds: { bronze: BATTLE_POINTS.BRONZE, silver: BATTLE_POINTS.SILVER, gold: BATTLE_POINTS.GOLD },
    unit: 'battle points',
  },
};

const TIER_ORDER = ['bronze', 'silver', 'gold'];
const TIER_LABEL = { bronze: 'Bronze', silver: 'Silver', gold: 'Gold' };
const TIER_COLOR = { bronze: '#cd7f32', silver: '#cbd5e1', gold: '#fbbf24' };

export function getBadgeForPoints(puzzlePoints = 0, battlePoints = 0) {
  const badges = [];

  // Puzzle Point Badge
  if (puzzlePoints >= PUZZLE_POINTS.GOLD) {
    badges.push({ type: 'puzzle', tier: 'gold', image: BADGE_IMAGES.puzzle.gold });
  } else if (puzzlePoints >= PUZZLE_POINTS.SILVER) {
    badges.push({ type: 'puzzle', tier: 'silver', image: BADGE_IMAGES.puzzle.silver });
  } else if (puzzlePoints >= PUZZLE_POINTS.BRONZE) {
    badges.push({ type: 'puzzle', tier: 'bronze', image: BADGE_IMAGES.puzzle.bronze });
  }

  // Battle Point Badge
  if (battlePoints >= BATTLE_POINTS.GOLD) {
    badges.push({ type: 'battle', tier: 'gold', image: BADGE_IMAGES.battle.gold });
  } else if (battlePoints >= BATTLE_POINTS.SILVER) {
    badges.push({ type: 'battle', tier: 'silver', image: BADGE_IMAGES.battle.silver });
  } else if (battlePoints >= BATTLE_POINTS.BRONZE) {
    badges.push({ type: 'battle', tier: 'bronze', image: BADGE_IMAGES.battle.bronze });
  }

  return badges;
}

// The tap-to-learn popup for a single badge, tailored to its tier.
function BadgeInfoPopup({ badge, onClose }) {
  const info = BADGE_INFO[badge.type];
  const tierIdx = TIER_ORDER.indexOf(badge.tier);
  const nextTier = TIER_ORDER[tierIdx + 1] || null;
  // Render through a portal to <body>. The popup uses `position: fixed` to cover
  // the viewport, but a leaderboard row sits inside `backdrop-blur` panels, and a
  // backdrop-filter ancestor becomes the containing block for fixed descendants —
  // which trapped this overlay mid-list (wedged between rows, backdrop not
  // covering the screen). Portaling to body escapes that ancestor so it centers
  // over the whole viewport as intended.
  return createPortal(
    <div
      className="fixed inset-0 z-[120] flex items-center justify-center bg-black/70 backdrop-blur-sm p-4 u37-ad-safe-pb"
      onClick={(e) => { e.stopPropagation(); onClose(); }}
      role="dialog"
      aria-modal="true"
    >
      <div
        className="w-full max-w-xs rounded-2xl border-2 bg-gradient-to-b from-slate-900 to-slate-950 p-5 text-center shadow-2xl"
        style={{ borderColor: TIER_COLOR[badge.tier], boxShadow: `0 0 30px -10px ${TIER_COLOR[badge.tier]}` }}
        onClick={(e) => e.stopPropagation()}
      >
        <img src={badge.image} alt={`${badge.tier} ${badge.type} badge`} className="w-16 h-16 object-contain mx-auto mb-3" />
        <h3 className="text-lg font-black text-white">
          <span style={{ color: TIER_COLOR[badge.tier] }}>{TIER_LABEL[badge.tier]}</span> {info.name}
        </h3>
        <p className="text-sm text-slate-300 mt-2">{info.how}</p>
        <div className="mt-3 rounded-xl border border-white/10 bg-white/[0.04] p-2.5 text-xs text-slate-200">
          This badge means they've reached <span className="font-bold" style={{ color: TIER_COLOR[badge.tier] }}>{TIER_LABEL[badge.tier]}</span> — {info.thresholds[badge.tier]}+ {info.unit}.
          {nextTier && (
            <span className="block text-slate-400 mt-1">Next: {TIER_LABEL[nextTier]} at {info.thresholds[nextTier]} {info.unit}.</span>
          )}
        </div>
        <p className="text-[10px] text-slate-500 mt-3">Leaderboard badge — separate from the Achievements on the Stats page.</p>
        <button
          onClick={(e) => { e.stopPropagation(); onClose(); }}
          className="mt-3 w-full rounded-xl py-2 text-sm font-bold text-white bg-white/10 hover:bg-white/15 transition-colors"
        >
          Got it
        </button>
      </div>
    </div>,
    document.body,
  );
}

export default function PlayerBadges({ puzzlePoints = 0, battlePoints = 0, size = 'sm' }) {
  const badges = getBadgeForPoints(puzzlePoints, battlePoints);
  const [selected, setSelected] = useState(null);

  if (badges.length === 0) return null;

  const sizeClasses = {
    xs: 'w-4 h-4',
    sm: 'w-5 h-5',
    md: 'w-6 h-6',
    lg: 'w-8 h-8',
    xl: 'w-10 h-10'
  };

  return (
    <div className="flex gap-1 items-center justify-center">
      {badges.map((badge, index) => (
        <button
          key={`${badge.type}-${badge.tier}-${index}`}
          type="button"
          // 8A: tap a badge to learn what it is and how it was earned. stopPropagation
          // so tapping the badge inside a clickable leaderboard row doesn't also
          // trigger the row's navigation.
          onClick={(e) => { e.stopPropagation(); setSelected(badge); }}
          className="relative touch-manipulation"
          aria-label={`${badge.tier} ${badge.type} badge — tap to learn more`}
        >
          <img
            src={badge.image}
            alt={`${badge.tier} ${badge.type} badge`}
            className={`${sizeClasses[size]} object-contain`}
          />
        </button>
      ))}
      {selected && <BadgeInfoPopup badge={selected} onClose={() => setSelected(null)} />}
    </div>
  );
}
