// Tiered badge artwork — the original puzzle-piece and Spartan-helmet badges,
// bundled INTO the app (imported, not fetched). These were previously hotlinked
// from an external base44 storage URL; they're now optimized (256px, ~15KB each)
// and vendored here so the app never depends on an external host at runtime.
//
// Vite fingerprints + emits these; the imports resolve to app-served asset paths
// (bundled in the native build), so there is no external network dependency.

import puzzleBronze from './puzzle-bronze.png';
import puzzleSilver from './puzzle-silver.png';
import puzzleGold from './puzzle-gold.png';
import battleBronze from './battle-bronze.png';
import battleSilver from './battle-silver.png';
import battleGold from './battle-gold.png';

export const BADGE_IMAGES = {
  puzzle: { bronze: puzzleBronze, silver: puzzleSilver, gold: puzzleGold },
  battle: { bronze: battleBronze, silver: battleSilver, gold: battleGold },
};
