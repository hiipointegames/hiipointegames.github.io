import { useEffect, useState } from 'react';

import { apiClient } from '@/transport';

import { contestToday, contestWeekStart } from './contestEntries';
import { hasConfirmedContestEligibility, meetsContestAccountRequirement } from './contest';

// The week's finished Dailies, for the "x of 21 entries" count on the home chip.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS IS A FETCH AND NOT A DERIVATION
// ─────────────────────────────────────────────────────────────────────────────
// `contestEntryState` can already produce the number; it just needs the week's
// rows. The home launcher had no source for them, and the tempting one —
// `game_stats.dailyChallengeTimes` — covers **Challenge's Daily only**. Counting
// from it would silently understate every player who also finished Easy or
// Expert, in a number attached to a $37 prize that players can check against the
// published rules. A confidently wrong count is worse than an honest smaller one,
// so the module returned null and the chip showed today's progress instead.
//
// This supplies the real rows, so the chip can say what it was always meant to.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY ADDING A QUERY TO THE HOTTEST SCREEN IS ACCEPTABLE HERE
// ─────────────────────────────────────────────────────────────────────────────
// Home is a zero-scroll screen that everyone lands on, so a new read needs a
// reason. Three things keep this cheap:
//
//   1. IT RUNS FOR ALMOST NOBODY. It is skipped entirely unless the player is
//      already eligible — a saved account, a real email, AND the 18+ affirmation.
//      Measured on prod 2026-09-05: 1,540 of 1,576 accounts were anonymous
//      guests. A guest, an account with no email, and an account that has not
//      ticked the box all skip it, and the chip already has something correct to
//      say to each of them.
//   2. It reads at most 21 rows, two indexed columns, for one user.
//   3. It runs once per mount, not per render, and not on a timer.
//
// ⚠️ IT FAILS SOFT, AND THAT IS THE POINT. On any error it returns null, which
// puts the chip back to "N of 3 Dailies done today" — the exact behaviour before
// this hook existed. A failed read must never be able to show a WRONG entry
// count; the whole reason the number was withheld in the first place was that a
// wrong one is worse than a missing one.

/**
 * @param {Record<string, any> | null | undefined} user
 * @returns {{date: string, mode: string, created_at?: string}[] | null} the week's rows, or null for
 *   "not known" — never an empty array standing in for a failed read
 */
export function useContestWeekEntries(user) {
  const [rows, setRows] = useState(/** @type {{date: string, mode: string, created_at?: string}[] | null} */ (null));

  // Only these two decide whether the query is worth running, and the id is what
  // makes it re-run for a different player. Depending on the whole `user` object
  // would refetch on every unrelated metadata write.
  const userId = user?.id ?? null;
  const eligible = meetsContestAccountRequirement(user) && hasConfirmedContestEligibility(user);

  useEffect(() => {
    if (!userId || !eligible) { setRows(null); return undefined; }

    let cancelled = false;
    (async () => {
      try {
        const today = contestToday();
        const { data, error } = await apiClient.supabase
          .from('daily_challenge_times')
          .select(/** @type {'*'} */ ('date, mode, created_at'))
          .eq('user_id', userId)
          .gte('date', contestWeekStart(today))
          .lte('date', today);
        if (error) throw error;
        if (!cancelled) setRows(Array.isArray(data) ? data : null);
      } catch {
        // Deliberately silent and deliberately null. See the note above: the
        // fallback is a correct smaller statement, not a broken screen, so
        // there is nothing here worth interrupting the player about.
        if (!cancelled) setRows(null);
      }
    })();

    return () => { cancelled = true; };
  }, [userId, eligible]);

  return rows;
}
