// Add an email to an account the guided signup has ALREADY created — the
// "Add email" tap on the Welcome screen (David, 2026-10-20).
//
// ⚠️ NOT submitSignup AGAIN. By the Welcome screen the account exists and has a
// password; re-running the claim would be re-claiming a claimed account (see
// the edit-path warning in CreateAccountForm). An existing member adds an email
// the same way the member form does it: `updateUser({ email })`, then a
// READ-BACK — resolving does not mean the address is live. Under Supabase's
// "Confirm email change" the change is staged until the player clicks a link,
// and a staged address is not contactable, so it must not be reported as
// "entered" (same rule as CreateAccountForm's emailPending).

import { supabase, apiClient } from '@/transport';
import { captureError, reportedFallback } from '@/observability';

export const EMAIL_SAVE_FAILED = 'We couldn’t save your email just now. Check your connection and try again.';
export const EMAIL_TAKEN = 'That email is already used by another account.';

/**
 * @typedef {{ ok: true, status: 'saved' | 'pending', user: any } | { ok: false, message: string }} AddEmailResult
 */

/**
 * @param {string} email — already trimmed and format-checked by the caller
 * @param {{ updateUser?: Function, getUser?: Function, me?: Function }} [deps]
 * @returns {Promise<AddEmailResult>}
 */
export async function addEmailAfterSignup(email, deps = {}) {
  const callUpdate = deps.updateUser || ((attrs) => supabase.auth.updateUser(attrs));
  const callGetUser = deps.getUser || (() => supabase.auth.getUser());
  const callMe = deps.me || (() => apiClient.auth.me());

  try {
    const { error } = (await callUpdate({ email })) || {};
    if (error) {
      const code = error.code || '';
      if (code === 'email_exists' || /already (been )?registered/i.test(error.message || '')) {
        return { ok: false, message: EMAIL_TAKEN };
      }
      captureError(new Error(`signup add-email failed: ${code || 'unknown'}`), { where: 'signup.addEmail', code, detail: String(error.message || '') });
      return { ok: false, message: EMAIL_SAVE_FAILED };
    }
    const { data } = (await callGetUser()) || {};
    const live = String(data?.user?.email || '').toLowerCase() === email.toLowerCase();
    const user = await Promise.resolve(callMe()).catch(reportedFallback('signup.addEmail.me', null));
    return { ok: true, status: live ? 'saved' : 'pending', user };
  } catch (err) {
    captureError(err, { where: 'signup.addEmail' });
    return { ok: false, message: EMAIL_SAVE_FAILED };
  }
}
