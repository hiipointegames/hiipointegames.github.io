// Particles — a pooled engine for bursts, rings, dust and 37-confetti (animation playbook §2.5).
//
// Pure simulation (emit / step) is separate from drawing so it is testable. The pool is a fixed
// size: effects can never pile up memory, and emitting into a full pool recycles the oldest.
// Drawing uses one pre-rendered glow sprite per colour with additive blending ('lighter'),
// never canvas shadowBlur, which is slow on Android WebView.

export const MAX_PARTICLES = 360;

/**
 * @typedef {{ count: number, speed: number[], life: number[], size: number[], gravity: number,
 *   drag: number, kind: string, grow?: number, spreadY?: number }} Preset
 */

/**
 * Preset shapes: how many, how fast, how long, how big, how they fall.
 * @type {Readonly<Record<'burst'|'ring'|'dust'|'confetti37', Preset>>}
 */
export const PRESETS = Object.freeze({
  burst: { count: 26, speed: [140, 420], life: [0.45, 0.9], size: [5, 12], gravity: 0, drag: 2.2, kind: 'spark' },
  ring: { count: 1, speed: [0, 0], life: [0.55, 0.55], size: [10, 10], gravity: 0, drag: 0, kind: 'ring', grow: 420 },
  dust: { count: 22, speed: [80, 260], life: [0.6, 1.1], size: [6, 14], gravity: 220, drag: 2.6, kind: 'spark', spreadY: 0.35 },
  confetti37: { count: 28, speed: [160, 460], life: [1.2, 1.9], size: [12, 18], gravity: 380, drag: 0.9, kind: 'glyph' },
});

const lerp = (a, b, t) => a + (b - a) * t;

export function createParticles(max = MAX_PARTICLES, rng = Math.random) {
  /** @type {Array<any>} */
  const pool = [];
  let cursor = 0;

  return {
    get alive() { return pool.filter((p) => p.life > 0).length; },
    get size() { return pool.length; },
    /**
     * Emit a preset at (x, y). `heat` (0..1) scales count and speed — streak escalation.
     * @param {string} name  a PRESETS key
     * @param {number} x
     * @param {number} y
     * @param {{ color?: string, heat?: number, count?: number }} [opts]
     */
    emit(name, x, y, { color = '#a78bfa', heat = 0, count = undefined } = {}) {
      const pr = PRESETS[name];
      if (!pr) return 0;
      const n = Math.round((count ?? pr.count) * (1 + heat * 0.8));
      for (let i = 0; i < n; i++) {
        const angle = pr.spreadY != null ? (rng() < 0.5 ? Math.PI : 0) + (rng() - 0.5) * pr.spreadY * Math.PI : rng() * Math.PI * 2;
        const speed = lerp(pr.speed[0], pr.speed[1], rng()) * (1 + heat * 0.4);
        const life = lerp(pr.life[0], pr.life[1], rng());
        const p = {
          x, y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - (pr.kind === 'glyph' ? 260 : 0),
          life, maxLife: life,
          size: lerp(pr.size[0], pr.size[1], rng()),
          gravity: pr.gravity, drag: pr.drag, kind: pr.kind, grow: pr.grow || 0,
          color, glyph: rng() < 0.5 ? '3' : '7', spin: (rng() - 0.5) * 8, rot: 0,
        };
        if (pool.length < max) pool.push(p);
        else { pool[cursor] = p; cursor = (cursor + 1) % max; } // full: recycle the oldest slot
      }
      return n;
    },
    /** Advance the simulation by dt seconds. Returns how many are still alive. */
    step(dt) {
      let alive = 0;
      for (const p of pool) {
        if (p.life <= 0) continue;
        p.life -= dt;
        if (p.life <= 0) continue;
        const k = Math.max(0, 1 - p.drag * dt);
        p.vx *= k;
        p.vy = p.vy * k + p.gravity * dt;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.size += p.grow * dt;
        p.rot += p.spin * dt;
        alive++;
      }
      return alive;
    },
    /** Everything currently alive (for drawing). */
    living() { return pool.filter((p) => p.life > 0); },
    clear() { pool.length = 0; cursor = 0; },
  };
}

/** One soft glow sprite per colour, drawn once and reused (no shadowBlur at runtime). */
const spriteCache = new Map();
export function glowSprite(color, doc = globalThis.document) {
  if (spriteCache.has(color)) return spriteCache.get(color);
  const c = doc?.createElement?.('canvas');
  const g = c?.getContext?.('2d');
  if (!c || !g) return null;
  c.width = 64; c.height = 64;
  const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
  grad.addColorStop(0, '#ffffff');
  grad.addColorStop(0.25, color);
  grad.addColorStop(1, 'rgba(0,0,0,0)');
  g.fillStyle = grad;
  g.fillRect(0, 0, 64, 64);
  spriteCache.set(color, c);
  return c;
}

/** Draw the living particles onto a 2D context (already scaled for DPR). */
export function drawParticles(g, particles) {
  g.save();
  g.globalCompositeOperation = 'lighter';
  for (const p of particles) {
    const a = Math.max(0, Math.min(1, p.life / p.maxLife));
    g.globalAlpha = a;
    if (p.kind === 'ring') {
      g.strokeStyle = p.color;
      g.lineWidth = 3 * a + 1;
      g.beginPath();
      g.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      g.stroke();
    } else if (p.kind === 'glyph') {
      g.save();
      g.translate(p.x, p.y);
      g.rotate(p.rot);
      g.fillStyle = p.color;
      g.font = `900 ${Math.round(p.size)}px system-ui, sans-serif`;
      g.textAlign = 'center';
      g.textBaseline = 'middle';
      g.fillText(p.glyph, 0, 0);
      g.restore();
    } else {
      const s = glowSprite(p.color);
      const d = p.size * 2;
      if (s) g.drawImage(s, p.x - d / 2, p.y - d / 2, d, d);
    }
  }
  g.restore();
}
