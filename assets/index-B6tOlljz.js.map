/**
 * Format a solve time (in seconds) for display.
 *
 * This is the single source of truth for solve-time formatting. It previously
 * existed as ~11 hand-rolled copies scattered across pages and components, which
 * had drifted into divergent output (a stray trailing space, an inconsistent
 * null guard, a separate `s`-suffix style). Each real variant is now a flag.
 *
 * @param {number} seconds - elapsed seconds (may include a fractional part).
 * @param {object} [opts]
 * @param {'hundredths'|'suffix'} [opts.style='hundredths']
 *   - 'hundredths': `M:SS.HH` (e.g. `1:05.42`). Hundredths are truncated, not rounded.
 *   - 'suffix': sub-minute renders as `SS.SSs` (e.g. `42.50s`); a minute or more
 *     renders as `M:SS.SS` with zero-padded seconds. Uses rounding (toFixed).
 * @param {boolean} [opts.nullGuard=false] - when true, a falsy `seconds`
 *   (null/undefined/0) returns `'00:00.00'` instead of formatting NaN/zero.
 * @returns {string}
 */
export function formatSolveTime(seconds, opts = {}) {
  const { style = 'hundredths', nullGuard = false } = opts;

  if (nullGuard && !seconds) {
    return '00:00.00';
  }

  if (style === 'suffix') {
    if (seconds > 59.99) {
      const mins = Math.floor(seconds / 60);
      const secs = (seconds % 60).toFixed(2);
      return `${mins}:${secs.padStart(5, '0')}`;
    }
    return `${seconds.toFixed(2)}s`;
  }

  // 🔴 FLOAT NOISE, NOT ROUNDING POLICY (fixed 2026-09-10).
  //
  // This was `Math.floor((seconds % 1) * 100)`, and `seconds % 1` carries the
  // binary-float error of the whole number: 36.43 % 1 is 0.4299999999999997, so
  // × 100 floors to 42 and a 36.43s solve rendered as 0:36.42.
  //
  // 46% of every hundredth-precision time in 0–60s was one hundredth low —
  // measured by enumerating all 6,000 of them. It was not occasional, and it
  // always under-reported, so a profile and a leaderboard disagreed about the
  // same solve, with the profile flattering it.
  //
  // Truncation is still the documented behaviour and is preserved: what
  // changes is that the value is snapped to a whole number of hundredths
  // FIRST, so truncation acts on the time rather than on its representation.
  // `toFixed(6)` is the snap — well inside double precision for any solve
  // length, and stored times carry at most millisecond resolution anyway.
  const totalHundredths = Math.floor(Number((seconds * 100).toFixed(6)));
  const mins = Math.floor(totalHundredths / 6000);
  const secs = Math.floor((totalHundredths % 6000) / 100);
  const hundredths = totalHundredths % 100;
  return `${mins}:${secs.toString().padStart(2, '0')}.${hundredths.toString().padStart(2, '0')}`;
}
