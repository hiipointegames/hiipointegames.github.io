// The player-action trail: what someone did in the minutes before an error.
//
// WHY (2026-10-04): Sentry 37-THE-MATH-PUZZLE-2V arrived as a single snapshot.
// The code recorded no steps, so there was no way to tell whether the player had
// just finished a Daily, opened the home card, or tapped Share twice. Each
// track() call adds one breadcrumb. Sentry keeps the most recent ones and sends
// them with the next error event.
//
// PRIVACY: an event name plus a few allow-listed, non-identifying fields (mode,
// outcome, step, screen...). Never usernames, emails, equations or free text.
// Anything not on the allow-list is dropped, and string values are capped, so a
// careless caller can't leak something by passing it.

import { addBreadcrumb } from './sentry';

// 'day' (2026-10-05): which of a player's 3 pop-up days, a small number.
// 'tip' (2026-10-20): a first-week tip's registry id ('share_result'), never free text.
const SAFE_KEYS = new Set(['mode', 'outcome', 'step', 'screen', 'reason', 'method', 'platform', 'route', 'code', 'day', 'tip']);
const MAX_VALUE = 48;

/** Keep only allow-listed keys with short primitive values. */
export function safeData(data) {
  const out = {};
  if (!data || typeof data !== 'object') return out;
  for (const [k, v] of Object.entries(data)) {
    if (!SAFE_KEYS.has(k)) continue;
    if (typeof v === 'string') out[k] = v.slice(0, MAX_VALUE);
    else if (typeof v === 'number' || typeof v === 'boolean' || v === null) out[k] = v;
  }
  return out;
}

/**
 * Record one player action on the trail.
 * @param {string} event dotted name, e.g. 'daily.start', 'share', 'auth.login'
 * @param {object} [data] allow-listed fields only (see SAFE_KEYS)
 * @param {object} [deps] test seam: add
 */
export function track(event, data, deps = {}) {
  try {
    (deps.add || addBreadcrumb)({ category: 'player', message: String(event).slice(0, 64), data: safeData(data), level: 'info' });
  } catch {
    // Telemetry must never break the game.
  }
}

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

/**
 * A route path with ids replaced, so the trail says WHICH screen without saying
 * WHOSE ('/profile/2b7e…' → '/profile/:id').
 * @param {string} pathname
 */
export function screenName(pathname) {
  return String(pathname || '/')
    .split('/')
    .map((seg) => (UUID.test(seg) || /^\d+$/.test(seg) || seg.length > 24 ? ':id' : seg))
    .join('/') || '/';
}
