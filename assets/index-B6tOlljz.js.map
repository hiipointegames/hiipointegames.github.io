// Blitz Colosseum badge FACTS — pure derivation from head_to_head_challenges rows.
//
// Badge System Redesign, Lane D (see .workshop/badge-system-redesign-proposal-
// 2026-07-30.md §4). This module answers "what happened in this battle, from my
// side?" — tie-breaks, margins, shutouts, lead flips, win streaks. It knows the
// ROW SHAPE and nothing about badge thresholds; the tier/earned mapping lives in
// stats-aggregation/blitzBadgeDerivation.js against Lane C's registry.
//
// WHY derive from rows rather than the stored mirrors: `game_stats.blitzStats`
// and `profiles.battle_points` are client-maintained aggregates that drift from
// the truth (see docs/bugs.md — the derived-not-stored family), and the in-flight
// M3 server-authoritative finalize may drop them entirely. `head_to_head_challenges`
// is the event log; every Blitz badge below is a pure read of it, so no badge can
// be lost to a mirror migration and none of them needs a new stored counter.
//
// Zero writes, zero gameplay coupling: nothing here runs during a battle.
//
// Row shape (per side): `challenger_result` / `opponent_result` blobs carrying
// `{ total_solved, total_time_seconds, fastest_solve_time, solutions[], run_status,
//   completed, completed_date, early_exit }`, plus row-level `winner_id`,
// `blitz_mode`, `time_limit_seconds`, `created_date`.

import { perspectiveOf } from './challengeView';
import { DEFAULT_BATTLE_SECONDS } from './battleConfig';
import { normalizeBlitzMode } from './blitzMode';

/** Finite-number guard — anything else (null, undefined, NaN, Infinity, '3') is absent. */
const num = (v) => (typeof v === 'number' && Number.isFinite(v) ? v : null);

/**
 * Normalize a stored date to one lexicographically-comparable form.
 *
 * Two formats coexist on a row: `completed_date` is ET wall-clock
 * (`YYYY-MM-DD HH:mm:ss`, written by HeadToHeadGame via nowET()) and
 * `created_date` is an ISO instant. Both share the `YYYY-MM-DDTHH:mm:ss` layout,
 * so trimming to 19 chars on a normalized separator makes them sortable against
 * each other. They are NOT in the same zone, so a created-vs-completed comparison
 * can be off by the ET offset — we only fall back to `created_date` when a row
 * carries no completion at all, which keeps the skew off the common path.
 *
 * @param {unknown} value
 * @returns {string} '' when unusable
 */
function normalizeTimestamp(value) {
  if (typeof value !== 'string' || value === '') return '';
  return value.replace('T', ' ').slice(0, 19);
}

/**
 * When a battle finished, as a comparable key: the LATER of the two sides'
 * completions (a battle resolves when the second player finishes), falling back
 * to row creation for a row with no completion timestamps.
 *
 * @param {object} battle
 * @returns {string}
 */
export function battleOrderKey(battle) {
  const completions = [
    normalizeTimestamp(battle?.challenger_result?.completed_date),
    normalizeTimestamp(battle?.opponent_result?.completed_date),
  ].filter(Boolean);
  if (completions.length > 0) return completions.sort()[completions.length - 1];
  // `created_date` does not exist on the table — the column is `created_at`
  // (verified 2026-08-01 against information_schema on staging AND prod; the
  // transport rewrites created_date→created_at only for SORT arguments, not on
  // the returned row). On its own that made the fallback a guaranteed '', which
  // no test caught because a completion date is nearly always present. It becomes
  // load-bearing the moment a row lacks one, so read the real column too.
  return normalizeTimestamp(battle?.created_date) || normalizeTimestamp(battle?.created_at);
}

/**
 * The YYYY-MM-DD a battle belongs to — the `earliestDate` a badge reports.
 * @param {object} battle
 * @returns {string|null}
 */
export function battleDate(battle) {
  const key = battleOrderKey(battle);
  return key ? key.slice(0, 10) : null;
}

/**
 * A battle's clock length. Rows created before the M3 duration picker carry no
 * `time_limit_seconds` and were always 10-minute races.
 * @param {object} battle
 * @returns {number}
 */
export function battleDurationSeconds(battle) {
  return num(battle?.time_limit_seconds) ?? DEFAULT_BATTLE_SECONDS;
}

/**
 * Which TIER a battle belongs to.
 *
 * Delegates to `normalizeBlitzMode` rather than re-deriving the rule. Four
 * separate functions used to hand-roll `=== 'easy' ? 'easy' : 'challenge'`, which
 * is exactly why the axis stayed two-valued while the vocabulary already knew
 * about three — and why an Expert battle filed under Challenge.
 *
 * ⚠️ ONE BEHAVIOUR CHANGE: an UNRECOGNISED mode used to bucket as 'challenge'
 * (it was "not easy, therefore challenge"); it now buckets as 'easy', which is
 * `normalizeBlitzMode`'s documented safe fallback. No production row moves —
 * `blitz_mode` has only ever held 'easy' and 'challenge' across 71 battles
 * (verified 2026-09-04) — but the two disagree on garbage, so it is pinned.
 *
 * @param {object} battle
 * @returns {'easy'|'challenge'|'expert'}
 */
export function battleMode(battle) {
  // The cast is the seam between a shared helper documented as returning a plain
  // string and this module's narrower tier union. normalizeBlitzMode only ever
  // returns a member of BLITZ_MODES, which IS that union.
  return /** @type {'easy'|'challenge'|'expert'} */ (normalizeBlitzMode(battle?.blitz_mode));
}

/** Oldest first. Stable for rows sharing a key (Array.prototype.sort is stable). */
export function sortBattlesChronologically(battles) {
  if (!Array.isArray(battles)) return [];
  return [...battles].sort((a, b) => {
    const ka = battleOrderKey(a);
    const kb = battleOrderKey(b);
    return ka < kb ? -1 : ka > kb ? 1 : 0;
  });
}

/**
 * A side's fastest single solve, in seconds. Prefers the stored
 * `fastest_solve_time` and falls back to the minimum over `solutions[]` — the
 * same fallback resolveBattleWinner uses, because a JSON round-trip turns the
 * "no solves" sentinel (Infinity) into null. A stored 0 counts as absent
 * (matching resolveBattleWinner's `!oppFastest` treatment).
 *
 * @param {object|null|undefined} result - one side's result blob
 * @returns {number|null}
 */
export function fastestSolveOf(result) {
  const stored = num(result?.fastest_solve_time);
  if (stored !== null && stored > 0) return stored;
  if (!Array.isArray(result?.solutions)) return null;
  const times = result.solutions.map((s) => num(s?.solve_time)).filter((t) => t !== null && t > 0);
  return times.length > 0 ? Math.min(...times) : null;
}

/**
 * Cumulative completion times for one side's run: entry `i` is when that player's
 * (i+1)-th puzzle went in, reconstructed by summing per-solve durations.
 * Returns null for an unusable/malformed array so callers can decline to guess.
 *
 * @param {unknown} solutions
 * @returns {number[]|null}
 */
function solveTimeline(solutions) {
  if (!Array.isArray(solutions)) return null;
  const out = [];
  let elapsed = 0;
  for (const solution of solutions) {
    const t = num(solution?.solve_time);
    if (t === null || t < 0) return null; // a corrupt entry poisons every later time
    elapsed += t;
    out.push(elapsed);
  }
  return out;
}

/**
 * Phoenix Rising's condition: was I ever BEHIND on the scoreboard mid-battle?
 *
 * Post-hoc reconstruction from both sides' `solutions[]` — a pure read of a
 * finished row, so no gameplay/finalize code is touched and the badge works
 * retroactively on every battle already played. Per-solve durations are summed
 * into completion times, then the two streams are merged in time order and the
 * running counts compared.
 *
 * Deliberately conservative: on a timestamp tie MY solve is counted first (so a
 * simultaneous exchange never manufactures a deficit), and an unreadable
 * timeline on either side returns false rather than guessing. Reconstruction
 * ignores dead time between solves, which shifts both streams the same way — it
 * can under-report a brief deficit, never invent one.
 *
 * @param {unknown} mySolutions
 * @param {unknown} opponentSolutions
 * @returns {boolean}
 */
export function wasBehindDuringBattle(mySolutions, opponentSolutions) {
  const mine = solveTimeline(mySolutions);
  const theirs = solveTimeline(opponentSolutions);
  if (!mine || !theirs || theirs.length === 0) return false;

  let i = 0;
  let j = 0;
  let myCount = 0;
  let opponentCount = 0;
  while (i < mine.length || j < theirs.length) {
    const mineNext = i < mine.length && (j >= theirs.length || mine[i] <= theirs[j]);
    if (mineNext) {
      myCount += 1;
      i += 1;
    } else {
      opponentCount += 1;
      j += 1;
    }
    if (opponentCount > myCount) return true;
  }
  return false;
}

/**
 * @typedef {Object} BattleBadgeFacts
 * @property {string|null} date            YYYY-MM-DD the battle finished.
 * @property {'easy'|'challenge'|'expert'} mode
 * @property {number} durationSeconds
 * @property {boolean} isWin
 * @property {boolean} isTie
 * @property {string|undefined} opponentId
 * @property {number} mySolved
 * @property {number} opponentSolved
 * @property {number} margin              Win margin in puzzles; 0 unless I won.
 * @property {number|null} myFastestSolve
 * @property {boolean} photoFinish        Won level on points, on the tiebreaker.
 * @property {boolean} totalEclipse       Won a full-clock shutout.
 * @property {boolean} longGameWin        Won a full 10-minute battle.
 * @property {boolean} leadFlipWin        Won after trailing mid-battle.
 */

/**
 * Everything the Blitz badges need to know about ONE battle, from a player's
 * side. Returns null for a row the player isn't in, or for junk input.
 *
 * @param {object} battle - a head_to_head_challenges row
 * @param {string} userId
 * @returns {BattleBadgeFacts|null}
 */
export function summarizeBattleForBadges(battle, userId) {
  if (!battle || !userId) return null;
  if (battle.challenger_id !== userId && battle.opponent_id !== userId) return null;

  const { myResult, opponentResult, opponentId } = perspectiveOf(battle, userId);
  const mySolved = num(myResult?.total_solved) ?? 0;
  const opponentSolved = num(opponentResult?.total_solved) ?? 0;
  const myFastestSolve = fastestSolveOf(myResult);
  const opponentFastestSolve = fastestSolveOf(opponentResult);

  const isWin = !!userId && battle.winner_id === userId;
  const isTie = battle.winner_id === null;

  // Photo Finish: level on points and decided by the fastest-solve tiebreaker —
  // exactly the branch resolveBattleWinner takes for a non-zero drawn score.
  const photoFinish =
    isWin &&
    mySolved > 0 &&
    mySolved === opponentSolved &&
    myFastestSolve !== null &&
    opponentFastestSolve !== null &&
    myFastestSolve < opponentFastestSolve;

  // Total Eclipse: a shutout across the FULL clock. An opponent who bailed early
  // (early_exit) or forfeited didn't face the whole battle, so that isn't one —
  // the registry copy is "solves nothing at all across the full clock".
  const totalEclipse =
    isWin &&
    mySolved > 0 &&
    !!opponentResult &&
    opponentSolved === 0 &&
    !opponentResult.early_exit &&
    opponentResult.run_status !== 'forfeited';

  const durationSeconds = battleDurationSeconds(battle);

  return {
    date: battleDate(battle),
    mode: battleMode(battle),
    durationSeconds,
    isWin,
    isTie,
    opponentId,
    mySolved,
    opponentSolved,
    margin: isWin ? Math.max(0, mySolved - opponentSolved) : 0,
    myFastestSolve,
    photoFinish,
    totalEclipse,
    longGameWin: isWin && durationSeconds >= DEFAULT_BATTLE_SECONDS,
    leadFlipWin: isWin && wasBehindDuringBattle(myResult?.solutions, opponentResult?.solutions),
  };
}

/** Track a best value and the date it was set. `better` decides the direction. */
function bestTracker(better) {
  return {
    value: null,
    date: /** @type {string|null} */ (null),
    offer(value, date) {
      if (value === null || value === undefined) return;
      if (this.value === null || better(value, this.value)) {
        this.value = value;
        this.date = date ?? null;
      }
    },
  };
}

/** Count occurrences + remember the first one's date. */
function occurrenceTracker() {
  return {
    count: 0,
    earliestDate: /** @type {string|null} */ (null),
    add(date) {
      this.count += 1;
      if (this.earliestDate === null) this.earliestDate = date ?? null;
    },
  };
}

/**
 * @typedef {Object} BattleBadgeSummary
 * @property {BattleBadgeFacts[]} battles   Chronological, oldest first.
 * @property {number} totalBattles
 * @property {number} wins
 * @property {string|null} firstBattleDate
 * @property {{count:number, earliestDate:string|null}} photoFinish
 * @property {{count:number, earliestDate:string|null}} totalEclipse
 * @property {{count:number, earliestDate:string|null}} longGame
 * @property {{count:number, earliestDate:string|null}} leadFlip
 * @property {{value:number, date:string|null}} longestWinStreak
 * @property {{value:number|null, date:string|null}} bestMargin
 * @property {{value:number|null, date:string|null}} bestFastestSolve
 * @property {{count:number, opponentId:string|null, earliestDate:string|null}} nemesis
 * @property {{easy:boolean, challenge:boolean, expert:boolean}} modesPlayed
 */

/**
 * Roll a player's battles up into the facts every Blitz Colosseum badge needs.
 * Registry-agnostic: counts and best values only, no thresholds and no tiers.
 *
 * Caller pre-filters to the battles that should count (completed-only — see
 * playerBattles.js); rows the player isn't in are dropped defensively.
 *
 * Streak semantics: only a win extends a streak — a loss AND a tie both reset it
 * ("3 wins in a row" is literal). The reported streak date is the battle at
 * which the longest run reached its length.
 *
 * @param {Array<object>} challenges
 * @param {string} userId
 * @returns {BattleBadgeSummary}
 */
export function summarizePlayerBattleBadges(challenges, userId) {
  const facts = sortBattlesChronologically(challenges)
    .map((battle) => summarizeBattleForBadges(battle, userId))
    .filter((f) => f !== null);

  const photoFinish = occurrenceTracker();
  const totalEclipse = occurrenceTracker();
  const longGame = occurrenceTracker();
  const leadFlip = occurrenceTracker();
  const bestMargin = bestTracker((a, b) => a > b);
  const bestFastestSolve = bestTracker((a, b) => a < b); // lower is better
  const modesPlayed = { easy: false, challenge: false, expert: false };

  /** @type {Map<string, {count:number, earliestDate:string|null}>} */
  const winsByOpponent = new Map();
  let wins = 0;
  let streak = 0;
  let longestStreak = 0;
  /** @type {string|null} */
  let longestStreakDate = null;

  for (const f of facts) {
    modesPlayed[f.mode] = true;
    if (f.photoFinish) photoFinish.add(f.date);
    if (f.totalEclipse) totalEclipse.add(f.date);
    if (f.longGameWin) longGame.add(f.date);
    if (f.leadFlipWin) leadFlip.add(f.date);
    if (f.myFastestSolve !== null) bestFastestSolve.offer(f.myFastestSolve, f.date);

    if (f.isWin) {
      wins += 1;
      streak += 1;
      if (streak > longestStreak) {
        longestStreak = streak;
        longestStreakDate = f.date;
      }
      bestMargin.offer(f.margin, f.date);
      if (f.opponentId) {
        const entry = winsByOpponent.get(f.opponentId) || { count: 0, earliestDate: null };
        entry.count += 1;
        if (entry.earliestDate === null) entry.earliestDate = f.date;
        winsByOpponent.set(f.opponentId, entry);
      }
    } else {
      streak = 0;
    }
  }

  // Nemesis = the opponent I've beaten most. Ties on count keep the first-seen
  // opponent (Map preserves insertion order), so the result is deterministic.
  let nemesis = { count: 0, opponentId: /** @type {string|null} */ (null), earliestDate: /** @type {string|null} */ (null) };
  for (const [opponentId, entry] of winsByOpponent) {
    if (entry.count > nemesis.count) {
      nemesis = { count: entry.count, opponentId, earliestDate: entry.earliestDate };
    }
  }

  return {
    battles: facts,
    totalBattles: facts.length,
    wins,
    firstBattleDate: facts.length > 0 ? facts[0].date : null,
    photoFinish: { count: photoFinish.count, earliestDate: photoFinish.earliestDate },
    totalEclipse: { count: totalEclipse.count, earliestDate: totalEclipse.earliestDate },
    longGame: { count: longGame.count, earliestDate: longGame.earliestDate },
    leadFlip: { count: leadFlip.count, earliestDate: leadFlip.earliestDate },
    longestWinStreak: { value: longestStreak, date: longestStreakDate },
    bestMargin: { value: bestMargin.value, date: bestMargin.date },
    bestFastestSolve: { value: bestFastestSolve.value, date: bestFastestSolve.date },
    nemesis,
    modesPlayed,
  };
}
