// Canonical player-stats fetch across the Supabase edge-call seam.
//
// The `getPlayerStats` edge function (supabase/functions/get-player-stats)
// is the authoritative source for a player's game_stats, profile fields,
// points, and lifetime aggregates. Before extraction both Statistics.jsx
// and OtherProfile.jsx independently called `edgeCall('getPlayerStats', …)`
// and read the envelope fields inline — two copies of the boundary
// contract. This centralizes that contract (per ADR-0001) so the function
// name, payload, and the shape of what comes back live in one place.
//
// Page-specific post-processing stays in the pages: Statistics layers on a
// DailyChallengeTime fetch + mode-counter math, and OtherProfile keeps its
// fallback to the static PublicProfile.stats column (a *different* data
// source, not part of this envelope).

import { edgeCall } from '@/transport';

/**
 * Fetch a player's canonical stats via the getPlayerStats edge function.
 *
 * @param {string} playerId - the target player's id.
 * @returns {Promise<
 *   | { success: true, data: {
 *       id: string, email: string, username: string, country: string,
 *       has_custom_username: boolean,
 *       game_stats: object | null,
 *       lifetimeAvgTime: number, lifetimeCompletedCount: number,
 *       totalAttempts: number,
 *       puzzle_points: number, battle_points: number,
 *     } }
 *   | { success: false, error: { code: string, message: string } }
 * >} a tagged result; numeric fields are defaulted so callers don't repeat
 *   the `|| 0` guards. `game_stats` is whatever the edge function returns
 *   (already camelCase) or null.
 */
export async function getPlayerStats(playerId) {
  if (!playerId) {
    throw new Error('getPlayerStats requires a playerId');
  }

  const result = await edgeCall('getPlayerStats', { playerId });

  if (!result.success || !result.data) {
    return {
      success: false,
      error: result.error ?? { code: 'no_data', message: 'getPlayerStats returned no data.' },
    };
  }

  const d = result.data;
  return {
    success: true,
    data: {
      id: d.id,
      email: d.email,
      username: d.username,
      country: d.country,
      has_custom_username: d.has_custom_username,
      game_stats: d.game_stats ?? null,
      lifetimeAvgTime: d.lifetimeAvgTime || 0,
      lifetimeCompletedCount: d.lifetimeCompletedCount || 0,
      totalAttempts: d.totalAttempts || 0,
      puzzle_points: d.puzzle_points || 0,
      battle_points: d.battle_points || 0,
    },
  };
}
