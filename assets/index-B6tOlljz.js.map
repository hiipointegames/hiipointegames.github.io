// badgeShowcaseModel — the pure arrangement layer for the L2 full badge showcase
// (Lane F, §9.2 of .workshop/badge-system-redesign-proposal-2026-07-30.md).
//
// The showcase's job is arrangement, not derivation: it takes the registry
// (Lane C) plus already-derived badge state (Lanes B/D) and decides WHICH tab a
// badge lives on, WHICH sub-section inside it, WHAT ORDER the cards go in, and
// HOW FAR along an unearned badge is. All of that is pure, so it lives here
// rather than inside a component — the JSX leaves stay dumb and this stays
// cheap to test.
//
// It computes NO badge state. `tier === -1` means unearned (the canonical
// sentinel Lanes B and D share) and `earliestDate` may legitimately be null
// (solo-Blitz badges have no event log to date). Every function below must
// render safely against a badge with NO state entry at all — new detectors land
// over time and must light up previously-unearned cards with zero change here.

import { badgeTiers, badgeTierCount } from '@/game-mechanics';
import { tierLabel, modeAccentVar } from './badgeVisuals';

/**
 * @typedef {import('@/game-mechanics/badgeRegistry').Badge} Badge
 *
 * Lane E's visual-layer BadgeState plus the ladder fields the DERIVATION lanes
 * also ship (`value`, `progressValue`, `nextTarget`, `badgeId`). Declared here
 * rather than widened in badgeVisuals.js because those fields are progress
 * inputs, not visual ones — the L3 detail components legitimately don't read
 * them. Every added field is optional, so a plain Lane E BadgeState still fits.
 * @typedef {import('./badgeVisuals').BadgeState & {
 *   badgeId?: string,
 *   featId?: string,
 *   value?: number|null,
 *   progressValue?: number,
 *   nextTarget?: number|null,
 * }} BadgeState
 *
 * @typedef {Object} BadgeEntry
 * @property {Badge} badge
 * @property {BadgeState|null} state
 *
 * @typedef {Object} ShowcaseSection
 * @property {string} id
 * @property {string} title
 * @property {BadgeEntry[]} entries
 * @property {string} [theme] Present only on a ROW of a row-grouped section
 *   (Practice, Colosseum) — the `[data-mode]` theme that row paints in.
 */

// The date the badge system went live. Everything earned BEFORE it was derived
// retroactively from the player's history, which is what stamps the "Earned
// Retroactively" ribbon in the L3 detail modal (Lane E).
//
// PINNED 2026-09-05 (David). Chosen for the failure asymmetry rather than for
// tidiness: a date set too LATE silently swallows genuinely new earns into the
// retroactive summary and the player never sees the pop, while a date set too
// early merely re-celebrates something old. So the value must never overshoot
// the date badges actually reach players — the OTA promotion, still ahead of us.
// Today's date is the largest value that is safely below it, and it sits after
// every historical solve, so neither failure can fire.
//
// It binds less than it looks: a player's FIRST run marks everything retroactive
// regardless of date, and every badge added later carries its own `availableFrom`
// (the three-mode set is '2026-09-04'). This constant governs only the ORIGINAL
// catalog — the badges with no `availableFrom` of their own.
export const BADGE_SYSTEM_LAUNCH_DATE = '2026-09-05';

/**
 * THE FIVE SECTIONS (David's rulings R1-R3, 2026-09-04):
 *
 *     Easy Daily · Challenge Daily · Expert Daily · Practice · Colosseum
 *
 * WHY THIS SHAPE. The old five chips were Daily · Challenge · Easy · Solo Blitz
 * · Blitz Battle, which flattened three different axes into one list: `daily`
 * meant CHALLENGE's Daily, `challenge` meant Challenge PRACTICE, `easy` meant
 * Easy PRACTICE — and there was no Expert anything. A player reading that list
 * could not tell that "Daily" and "Challenge" were the same difficulty in two
 * round types, which is a large part of why "the way the badges are nested and
 * collected makes no sense".
 *
 * The axis is now explicit: the three Dailies are three sections because they
 * are three separate competitions with three leaderboards; the three practice
 * tiers are ONE section with three labelled rows because practice is unlimited
 * and untimed; the Colosseum is its own thing.
 *
 * `modes` lists the REGISTRY modes a section absorbs, so every badge in the
 * catalog has exactly one home. `rows` optionally splits a section into labelled
 * sub-groups — see `sectionsForMode`, which renders rows INSTEAD of category
 * headings for a section that declares them.
 *
 * `theme` is the `[data-mode]` value from ui/theme/tokens.css. Note that
 * Challenge Daily wears the CHALLENGE theme, not the `daily` one: `[data-mode=
 * "daily"]` is violet — the accident David called out, inherited when the
 * tier-colour sweep swapped Challenge and Daily (see commit 0555490) — and with
 * one section per Daily tier there is no single "Daily" arena left for it to
 * paint. The rule itself stays in tokens.css because the game screen's slides
 * still emit `data-mode="daily"`; it simply has no badge left reading it.
 */
export const SHOWCASE_MODES = [
  {
    id: 'easyDaily', label: 'Easy Daily', modes: ['dailyEasy'], theme: 'easy',
  },
  {
    id: 'challengeDaily', label: 'Challenge Daily', modes: ['daily'], theme: 'challenge',
  },
  {
    id: 'expertDaily', label: 'Expert Daily', modes: ['dailyExpert'], theme: 'expert',
  },
  {
    // ONE Practice section, THREE labelled rows (David, R3 2026-09-04). Not
    // three sections — practice is unlimited and untimed, so three parallel
    // ladders would read as noise — and not one flat merged pool either: a
    // player must still be able to see which tier a badge came from, which is a
    // direct requirement of the legibility problem, not a nicety.
    id: 'practice',
    label: 'Practice',
    modes: ['easy', 'challenge', 'expert'],
    theme: 'challenge',
    accentMode: 'challenge',
    rows: [
      { id: 'easy', label: 'Easy', modes: ['easy'], theme: 'easy' },
      { id: 'challenge', label: 'Challenge', modes: ['challenge'], theme: 'challenge' },
      { id: 'expert', label: 'Expert', modes: ['expert'], theme: 'expert' },
    ],
  },
  {
    // THE FIFTH SECTION (David, R1 2026-09-04). The four-section ruling covers
    // the puzzle half; these 16 badges needed a home of their own rather than
    // being folded into Practice, which they are not.
    //
    // ⚠️ BUILT TO TAKE A THIRD ROW. An Expert Blitz session is live as this
    // lands: Expert battles and solos are coming. They slot in as another `rows`
    // entry with its own registry mode — no re-cut of this section, and no
    // change to anything that reads it.
    id: 'colosseum',
    label: 'Colosseum',
    modes: ['soloBlitz', 'blitzBattle', 'crossArena'],
    theme: 'blitz-battle',
    accentMode: 'blitzBattle',
    rows: [
      { id: 'solo', label: 'Solo', modes: ['soloBlitz'], theme: 'solo-blitz' },
      { id: 'battle', label: 'Battle', modes: ['blitzBattle', 'crossArena'], theme: 'blitz-battle' },
    ],
  },
];

export const DEFAULT_SHOWCASE_MODE_ID = 'challengeDaily';

/**
 * The category sub-sections inside a mode tab, in order.
 *
 * ROUND 2 § D4 re-cut these. The Daily used to render FIVE headings over ten
 * cards — Craft(3) · Streaks & Records(2) · Speed(1) · Milestones(1) ·
 * Arena(3) — three of them holding a single card, which reads as a stack of
 * labels rather than a structure. Two changes fix it:
 *
 *   1. **Streaks & Records + Speed merge into `Consistency`.** Both answer
 *      "how reliably do you solve the Daily?", and the Speed ladder alone was a
 *      one-card heading. `mastery` (the Puzzle Piece points medal) joins Craft,
 *      which is what it measures — perfect solves.
 *   2. **Podium splits OUT of Arena.** `arena` and `competition` used to share
 *      one heading titled "Arena", which is why the Daily — a mode with no
 *      arena badges at all — rendered an "Arena" heading over its podium cards.
 *      "Arena" belongs to the Colosseum. `competition` is now the Daily podium
 *      alone (the Colosseum points medal moved to `arena` in the registry), so
 *      the split leaves the Blitz Battle tab reading exactly as it did: one
 *      Arena heading over every Colosseum badge.
 *
 * Net: Daily renders three sections (Craft · Consistency · Podium) under its
 * feats hero, and no other tab's headings change.
 */
export const SHOWCASE_SECTIONS = [
  { id: 'craft', title: 'Craft', categories: ['craft', 'mastery'] },
  { id: 'consistency', title: 'Consistency', categories: ['streaks', 'speed'] },
  { id: 'podium', title: 'Podium', categories: ['competition'] },
  { id: 'milestones', title: 'Milestones', categories: ['dojo', 'onRamp'] },
  { id: 'arena', title: 'Arena', categories: ['arena'] },
];

// THE FLAT "LOCKED" GRID WAS REMOVED 2026-09-04 (David: "I cant tell what i
// have accomplished").
//
// It existed on the theory that category sub-headings only help you navigate
// things you HAVE, so every unearned badge in a mode collapsed into one
// unlabelled grid. Measured against the live screen, that theory cost more than
// it bought: FOUR OF FIVE TABS rendered exactly one heading — `Locked` — over
// 3 to 13 cards (Challenge 10, Solo Blitz 3, Blitz Battle 13). The catalog was
// least navigable exactly when a player most needs it, because "what can I go
// get?" is at least as real a question as "where's my speed badge?", and it had
// no structure at all to answer with.
//
// Unearned badges now stay in their own category section, ordered after the
// earned ones (`sortEarnedFirst`), and the section counter reads `earned/total`
// so the heading itself reports progress. `LOCKED_SECTION_ID` and the `locked`
// flag on ShowcaseSection are gone with it; nothing branches on "is this the
// locked grid" any more because there is no longer such a grid.

/**
 * A mode chip by id, or null.
 * @param {string} [modeId]
 * @returns {typeof SHOWCASE_MODES[number] | null}
 */
export function showcaseMode(modeId) {
  return SHOWCASE_MODES.find((m) => m.id === modeId) ?? null;
}

/**
 * Flatten any number of derivation outputs into ONE lookup keyed by REGISTRY
 * badge id — the key a card renders against.
 *
 * Absorbs every shape the derivation lanes return without the caller adapting:
 *   - Lane B (craft): `{ daily, challenge, byBadgeId }` → the `byBadgeId` map is used.
 *   - Lane D (Blitz): `{ [featId]: state }` → re-keyed by each state's own `badgeId`.
 *   - Slice 1 (existing systems): `{ [badgeId]: state }` → already registry-keyed,
 *     and each state carries its own `badgeId`, so it merges with no adapter. This
 *     is the third source, supplying the nine folded-in legacy families (streaks,
 *     speed, podiums, points medals, Colosseum wins) that rendered permanently dark
 *     while only craft + Blitz state existed.
 * Later sources win on a collision. Junk entries are skipped, never thrown on:
 * one malformed state must not blank a player's whole showcase.
 *
 * @param {...unknown} sources
 * @returns {Record<string, BadgeState>}
 */
export function buildBadgeStateIndex(...sources) {
  /** @type {Record<string, BadgeState>} */
  const index = {};
  for (const source of sources) {
    if (!source || typeof source !== 'object') continue;
    const raw = /** @type {Record<string, any>} */ (source);
    const entries = raw.byBadgeId && typeof raw.byBadgeId === 'object' ? raw.byBadgeId : raw;
    for (const [key, state] of Object.entries(entries)) {
      if (!state || typeof state !== 'object') continue;
      const id = typeof state.badgeId === 'string' && state.badgeId ? state.badgeId : key;
      index[id] = state;
    }
  }
  return index;
}

/**
 * Is this badge earned? `earned` is the derivation lanes' explicit flag; the
 * `tier >= 0` fallback covers a state object that carries only the tier.
 * @param {BadgeState | null | undefined} state
 * @returns {boolean}
 */
export function isBadgeEarned(state) {
  if (!state) return false;
  if (typeof state.earned === 'boolean') return state.earned;
  return Number.isFinite(state.tier) && /** @type {number} */ (state.tier) >= 0;
}

// `badgeTreatment()` was REMOVED in Round 2 (David, 2026-08-01). It answered
// "is this the Daily half or the Challenge half of a craft twin?", which drove a
// gold DAILY ribbon on one and a muted PRACTICE tag on the other. Since Badges
// Phase 2 the twins live on separate mode TABS, so both labels only restated the
// tab the player was already looking at — and the gold they used collides with
// `--u37-tier-6`, the top RARITY stop. Removing the rule frees gold to mean one
// thing (top rarity) instead of two. The mode outline now carries the family
// read on its own; see BadgeCard's colour header.

/**
 * How far along an unearned (or partly-climbed) badge is, so a locked card
 * doubles as a GOAL rather than a blank.
 *
 * Reads the ladder from the registry rather than trusting one derivation lane's
 * fields, because the lanes differ: Lane B ships `progressValue`/`nextTarget`,
 * Lane D ships only `count`/`value`. Both land on the same answer here.
 *
 * `ratio` is null — no filled bar, just a "Next: …" line — when a fraction would
 * lie: descending ladders (a 12s best is not "120% of the way" to a 10s target),
 * STAGE ladders (whose tiers are rung ordinals, not a measure), and any badge
 * with no recorded value yet.
 *
 * @param {Badge | null | undefined} badge
 * @param {BadgeState | null | undefined} state
 * @returns {{current:number|null, target:number, ratio:number|null, nextLabel:string, descending:boolean} | null}
 *   null when there is nothing to chase: one-time badges, and ladders already maxed out.
 */
export function badgeProgress(badge, state) {
  if (!badge || badge.scaling?.type === 'oneTime') return null;

  const tiers = badgeTiers(badge, state?.durationSeconds);
  if (tiers.length === 0) return null;

  const reached = Number.isFinite(state?.tier) ? Math.max(/** @type {number} */ (state?.tier), -1) : -1;
  const nextIndex = reached + 1;
  if (nextIndex >= tiers.length) return null; // top of the ladder — nothing left to chase

  const target = tiers[nextIndex];
  const descending = badge.scaling?.direction === 'descending';
  const isCount = badge.scaling?.type === 'countLadder';

  /** @type {number|null} */
  let current;
  if (badge.scaling?.type === 'stageLadder') {
    // A stage ladder's tiers are ORDINALS, so `3 / 4` would be a fraction of an
    // index — the same kind of lie a descending ladder's ratio would be. The
    // rung NAME is the real answer to "what's next", so the card shows
    // "Next: Big Bang" and no bar. (2026-09-03 craft merge.)
    current = null;
  } else if (descending) {
    // 0 means "never recorded" for a time, not "instant" — it must not read as a
    // world record, so an unrecorded best has no current value at all.
    current = Number.isFinite(state?.value) && /** @type {number} */ (state?.value) > 0
      ? /** @type {number} */ (state?.value)
      : null;
  } else if (Number.isFinite(state?.progressValue)) {
    current = /** @type {number} */ (state?.progressValue);
  } else if (isCount) {
    current = Number.isFinite(state?.count) ? /** @type {number} */ (state?.count) : 0;
  } else {
    current = Number.isFinite(state?.value) ? /** @type {number} */ (state?.value) : 0;
  }

  const ratio = descending || current === null || !(target > 0)
    ? null
    : Math.max(0, Math.min(1, current / target));

  return { current, target, ratio, nextLabel: tierLabel(badge, nextIndex, state?.durationSeconds), descending };
}

/**
 * Where a player is standing on a badge's ladder — the answer to David's
 * "how far in am I?" (2026-09-04).
 *
 * Separate from `badgeProgress` because the two answer different questions and
 * one of them used to be unanswerable. `badgeProgress` describes the NEXT rung
 * and returns null once there isn't one; this describes the rung you are ON,
 * which is exactly the fact an earned card needs and never had. Keeping them
 * apart is what lets a maxed-out ladder say "7 of 7" instead of falling back to
 * the blank that made an earned badge less informative than a locked one.
 *
 * `position` is 1-based for display and is 0 for a badge not yet on the ladder.
 * One-time badges report `laddered: false` and a total of 1 — they have a state
 * (earned or not) but no rung, and callers must not caption them "1 of 1".
 *
 * @param {Badge | null | undefined} badge
 * @param {BadgeState | null | undefined} state
 * @returns {{laddered: boolean, position: number, total: number, maxed: boolean}}
 */
export function badgeRungSummary(badge, state) {
  const total = badgeTierCount(badge);
  const laddered = badge?.scaling?.type !== 'oneTime' && total > 1;
  if (!laddered) return { laddered: false, position: 0, total: Math.max(total, 1), maxed: false };

  const reached = Number.isFinite(state?.tier) ? /** @type {number} */ (state?.tier) : -1;
  const position = Math.min(Math.max(reached + 1, 0), total);
  return { laddered: true, position, total, maxed: position >= total };
}

/**
 * Earned cards above unearned, registry order preserved inside each group.
 * Stable by construction (a partition, not a comparator) so two badges with the
 * same earned-ness never swap between renders.
 * @param {BadgeEntry[]} entries
 * @returns {BadgeEntry[]}
 */
export function sortEarnedFirst(entries) {
  const earned = entries.filter((e) => isBadgeEarned(e.state));
  const unearned = entries.filter((e) => !isBadgeEarned(e.state));
  return [...earned, ...unearned];
}

/**
 * Pair every badge in a list with its state — including badges with NO state
 * entry, which render UNEARNED. That is the robustness contract: as more
 * detectors land they simply populate previously-empty ids, with no change here.
 * @param {Badge[]} badges
 * @param {Record<string, BadgeState>} [stateById]
 * @returns {BadgeEntry[]}
 */
export function pairWithState(badges, stateById = {}) {
  return badges.map((badge) => ({ badge, state: stateById[badge.id] ?? null }));
}

/**
 * Every badge that belongs on one mode chip.
 * @param {Badge[]} badges
 * @param {string} modeId
 * @returns {Badge[]}
 */
export function badgesForMode(badges, modeId) {
  const mode = showcaseMode(modeId);
  if (!mode) return [];
  return badges.filter((b) => mode.modes.includes(b.mode));
}

/**
 * The full section list for one mode tab.
 *
 * SYMMETRIC SINCE 2026-09-04. Earned and unearned badges share one section per
 * category, earned first, so a category heading is a stable address for a badge
 * whether or not you hold it. Empty sections are dropped, so a mode still never
 * renders a hollow heading. See the note above `SHOWCASE_SECTIONS` for what the
 * old asymmetric split cost on the live screen.
 *
 * `skipSections` removes those categories from BOTH halves — a skipped category
 * is one the CALLER is drawing itself — and `skipBadgeIds` does the same for
 * INDIVIDUAL badges. The Daily needs the finer grain since Round 2 § D4: its
 * hero draws the marquee craft feats, but the Craft SECTION still has to render
 * the rest of the Daily craft set (Comeback Kid and First Perfect — the two
 * Daily-only craft badges left after the 2026-09-03 family merge folded the
 * perfect variants into rungs), so "skip the whole Craft category" would blank a
 * section David asked for. Skipping the hero's ids exactly leaves the section
 * holding precisely what the hero doesn't.
 *
 * @param {Badge[]} badges           The registry catalog (Lane C).
 * @param {string} modeId            A `SHOWCASE_MODES` id.
 * @param {Record<string, BadgeState>} [stateById] Merged derivation state.
 * @param {{skipSections?: string[], skipBadgeIds?: Iterable<string>}} [opts]
 *   Sections / individual badges the caller renders itself.
 * @returns {ShowcaseSection[]}
 */
export function sectionsForMode(badges, modeId, stateById = {}, opts = {}) {
  const skip = new Set(opts.skipSections ?? []);
  const skipIds = new Set(opts.skipBadgeIds ?? []);
  const mode = showcaseMode(modeId);
  const inMode = badgesForMode(badges, modeId).filter((b) => !skipIds.has(b.id));
  const visible = SHOWCASE_SECTIONS.filter((section) => !skip.has(section.id));

  // A SECTION WITH `rows` GROUPS BY TIER, NOT BY CATEGORY.
  //
  // Practice and the Colosseum both declare rows. Inside them the useful question
  // is "which tier / which arena is this badge from?" — David's R3 requirement
  // that a player can still see which tier a badge came from — and nesting
  // category headings underneath a tier heading would be two levels of grouping
  // over a handful of cards. The three Daily sections have no rows and keep
  // their category headings, where the tier is already the section.
  if (mode?.rows?.length) {
    return mode.rows
      .map((row) => ({
        id: row.id,
        title: row.label,
        theme: row.theme,
        entries: sortEarnedFirst(
          pairWithState(inMode.filter((b) => row.modes.includes(b.mode)), stateById),
        ),
      }))
      .filter((row) => row.entries.length > 0);
  }

  return visible
    .map((section) => ({
      id: section.id,
      title: section.title,
      entries: sortEarnedFirst(
        pairWithState(inMode.filter((b) => section.categories.includes(b.category)), stateById),
      ),
    }))
    .filter((section) => section.entries.length > 0);
}

/**
 * The frame accent one mode CHIP paints in — the badge-mode colour of the first
 * registry mode the chip absorbs (so the Blitz Battle chip, which absorbs
 * `blitzBattle` and `crossArena`, gets the Colosseum blue).
 *
 * The showcase pushes this onto `--u37-mode-accent` for its subtree, which is why
 * the chips and section headings repaint with the cards instead of staying on the
 * GAME-screen palette (where Daily is cyan, not gold).
 * @param {string} [modeId]
 * @returns {string} A `var(--u37-*)` string.
 */
export function showcaseModeAccent(modeId) {
  const mode = showcaseMode(modeId);
  if (!mode) return 'var(--u37-mode-accent)';
  // `accentMode` where the first absorbed mode is not the one the section is
  // NAMED for: Practice lists Easy first but reads as a Challenge-tier section,
  // and the Colosseum lists Solo first but wears the battle magenta. Without it
  // the section heading and its `[data-mode]` theme paint different colours, and
  // `badgeModeTokens.test.js` pins that they must not.
  return modeAccentVar(mode.accentMode ?? mode.modes[0]);
}

/**
 * Is this the Daily half of a craft feat that also has a Challenge twin?
 *
 * That pairing is what makes a badge one of the MARQUEE feats: the power-dice
 * catalog is deliberately expanded into a Daily entry (aspirational name) and a
 * Challenge practice entry, so "has a twin" identifies the catalog exactly —
 * without a parallel hand-maintained id list that could drift as R2-E/R2-F add
 * badges. Derived from the passed catalog, so a filtered `badges` list stays
 * self-consistent.
 *
 * THE `perfectOf` GUARD IS KEPT DELIBERATELY, though no badge carries the field
 * since the 2026-09-03 merge folded every perfect variant into a rung of the
 * family it shadowed. It was added on 2026-08-02 to stop the variants — which
 * had just acquired Challenge twins — from being promoted into the hero by the
 * "has a twin" proxy, where their `???` silhouettes would have advertised the
 * very badges the reveal exists to keep secret. That failure mode returns the
 * moment anyone adds a twinned prestige shadow again, and the guard costs one
 * line, so it stays as the standing statement of the rule.
 *
 * @param {Badge} badge
 * @param {Badge[]} badges The catalog the badge came from.
 * @returns {boolean}
 */
function isMarqueeDailyFeat(badge, badges, dailyMode = 'daily') {
  if (badge.mode !== dailyMode || badge.category !== 'craft') return false;
  if (badge.perfectOf) return false;
  // "Has a practice twin" is what identifies the power-dice catalog exactly,
  // without a parallel hand-maintained id list that could drift. Each Daily tier
  // pairs with its OWN practice tier — Easy's craft feats have no practice twin
  // (Easy practice is the On-Ramp track), which is why Easy passes its tier's
  // practice mode explicitly rather than inheriting Challenge's.
  const practiceMode = DAILY_PRACTICE_TWIN[dailyMode];
  return badges.some((other) => other.featId === badge.featId && other.mode === practiceMode);
}

/**
 * Which mode a Daily tier's craft feats must have a twin in to count as MARQUEE.
 *
 * The twin lookup is doing real work only for Challenge: it is what keeps the
 * two Daily-ONLY craft badges — Comeback Kid and First Perfect — out of the hero
 * and in the Craft section below it, which is what § D4 asked for. Expert twins
 * with Expert practice the same way.
 *
 * `dailyEasy` maps to ITSELF deliberately, and the self-match is the point:
 * Easy practice is the On-Ramp track, so Easy's craft feats have no practice
 * twin at all, and every one of them IS part of that tab's marquee set. Mapping
 * it to `easy` would empty the Easy hero; mapping it to itself says "all of
 * them" in the same expression the other two tiers use.
 */
const DAILY_PRACTICE_TWIN = {
  dailyEasy: 'dailyEasy',
  daily: 'challenge',
  dailyExpert: 'expert',
};

/**
 * The Daily tab's hero set — the eight marquee craft families, earned first (ten
 * before the 2026-09-03 merge). These are
 * the aspirational collectibles (gold foil + DAILY ribbon); their Challenge
 * practice twins live under the Challenge tab.
 *
 * ROUND 2 § D4 narrowed this from "every Daily craft badge" to "every Daily
 * craft badge WITH a Challenge twin". The Daily-only craft badges — Comeback Kid
 * and First Perfect, since the 2026-09-03 merge retired Supernova and Resonance
 * into rungs — are not part of the twinned marquee catalog and render in the
 * Daily's own Craft section instead. Nothing is lost from the tab: the hero and
 * the section partition the Daily craft set between them.
 *
 * @param {Badge[]} badges
 * @param {Record<string, BadgeState>} [stateById]
 * @returns {BadgeEntry[]}
 */
export function dailyFeatEntries(badges, stateById = {}, dailyMode = 'daily') {
  return sortEarnedFirst(
    pairWithState(badges.filter((b) => isMarqueeDailyFeat(b, badges, dailyMode)), stateById),
  );
}

/**
 * The registry mode a showcase section maps to when it is one of the three
 * Dailies, or null when it is not (Practice, Colosseum).
 * @param {string} modeId
 * @returns {string|null}
 */
export function dailyModeFor(modeId) {
  const mode = showcaseMode(modeId);
  if (!mode || mode.rows) return null;
  return mode.modes[0] ?? null;
}

/**
 * The registry category the Podium block owns, and the section id it stands in
 * for. `competition` is the Daily podium alone since Round 2 § D4 (the Colosseum
 * points medal moved to `arena`).
 */
export const PODIUM_CATEGORY = 'competition';
export const PODIUM_SECTION_ID = 'podium';

/**
 * The badges the merged Podium BLOCK draws itself (Round 2 § D5).
 *
 * D5's defect was that one concept rendered twice on the Daily tab in two
 * visual languages: a `PODIUM FINISHES` medal panel near the top, and a plain
 * `PODIUM` badge section two sections further down. PodiumMedalPanel is now
 * both, so it needs the podium badges — and `sectionsForMode` must stop
 * emitting them, which the caller does by feeding these ids to `skipBadgeIds`.
 *
 * WHY THIS AND NOT `skipSections: ['podium']`. A skipped SECTION is removed
 * from the earned half only in spirit — `sectionsForMode` also drops its
 * categories out of the flat Locked grid, so an unearned podium badge would
 * vanish from the tab entirely. Returning the ids (earned AND unearned) and
 * skipping exactly those keeps every podium badge on screen, inside the one
 * block that is now the whole podium story. The `podium` entry stays in
 * `SHOWCASE_SECTIONS` so a future non-Daily competition badge still has a home.
 *
 * Ordered earned-first, like every other section.
 *
 * @param {Badge[]} badges
 * @param {string} modeId
 * @param {Record<string, BadgeState>} [stateById]
 * @returns {BadgeEntry[]}
 */
export function podiumSectionEntries(badges, modeId, stateById = {}) {
  return sortEarnedFirst(
    pairWithState(badgesForMode(badges, modeId).filter((b) => b.category === PODIUM_CATEGORY), stateById),
  );
}

/**
 * Earned / total for one mode chip — the "12/37" counter under a tab.
 * @param {Badge[]} badges
 * @param {string} modeId
 * @param {Record<string, BadgeState>} [stateById]
 * @returns {{earned:number, total:number}}
 */
export function modeBadgeCounts(badges, modeId, stateById = {}) {
  const inMode = badgesForMode(badges, modeId);
  return {
    earned: inMode.filter((b) => isBadgeEarned(stateById[b.id])).length,
    total: inMode.length,
  };
}

/**
 * `1,000` — thousands separators for the progress numerals, matching
 * badgeVisuals' tier labels without exporting its private helper.
 * @param {number|null} value
 * @returns {string}
 */
export function formatProgressValue(value) {
  if (value === null || !Number.isFinite(value)) return '—';
  const rounded = Math.round(value * 100) / 100;
  return String(rounded).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}
