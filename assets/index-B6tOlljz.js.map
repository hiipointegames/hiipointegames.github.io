// Award detection + celebration sequencing (pure).
//
// After a solve (daily) or a battle (Blitz), we want ONE consistent celebration
// path for every newly-earned badge — streak, puzzle-piece, battle-point, perfect
// and time milestones — instead of the old streak-only MilestoneModal. These two
// pure functions decide (a) WHICH badges were just earned by diffing the before/
// after stats, and (b) HOW to sequence the celebrations (cap N individual, then a
// combined "and N more" summary). The React sequence component consumes the plan.

import {
  STREAK_MILESTONES,
  PERFECT_MILESTONES,
  PUZZLE_POINTS,
  BATTLE_POINTS,
  TIME_MILESTONES,
  STREAK_ICON_CONFIGS,
  PERFECT_ICON_CONFIGS,
  TIME_ICON_CONFIGS,
  badgeRarityVar,
  tierIndex,
  BADGES,
  getBadge,
  badgeTierCount,
  rarityVar,
} from '@/game-mechanics';
// The SAME resolver every badge-rendering surface uses (BadgeFrame → the card,
// the carousel, the L3 modal). Importing it — rather than reading `badge.icon`
// here — is what makes "the celebration shows what the card shows" true by
// construction, including the default-medal fallback for a badge that declares
// no icon. It is a pure key lookup; no component is pulled into the plan.
import { badgeIconKey } from '@/components/stats/badgeIcons';
import { modeTierLabel } from '@/game-modes';

const POINT_TIERS = ['bronze', 'silver', 'gold'];

// Cumulative-points badges (puzzle / battle) are earned when the running total
// crosses a tier threshold. Returns the tier names newly reached this update.
function pointsTiersCrossed(prevPoints, points, thresholds) {
  const before = prevPoints || 0;
  const after = points || 0;
  const crossed = [];
  thresholds.forEach((t, i) => {
    if (before < t && after >= t) crossed.push(POINT_TIERS[i]);
  });
  return crossed;
}

/**
 * Diff before/after stats (and optional cumulative point totals) and return the
 * list of badges newly earned by this solve/battle, ordered by celebration
 * priority: streak → puzzle → battle → perfect → time.
 *
 * @param {object}  args
 * @param {object}  [args.prev]     - stats BEFORE the solve
 * @param {object}  [args.updated]  - stats AFTER the solve (awardDailyChallengeSolve output)
 * @param {object}  [args.points] - { prevPuzzle, puzzle, prevBattle, battle } cumulative
 *   totals (server-derived; supplied by the caller since they live outside the
 *   local solve stats). Omit for flows that don't move points.
 * @param {{prev?:object, next?:object}|null} [args.badges] - Badge System Redesign
 *   state maps keyed by REGISTRY BADGE ID (Lanes B/D, merged with
 *   `buildBadgeStateIndex`). Supplied together with the stat diff so a solve that
 *   earns BOTH a streak milestone and two craft badges produces ONE ordered list
 *   that `planAwardCelebrations` sequences — the celebrations queue, they never
 *   collide. Omit for flows with no badge state to hand.
 * @returns {Array<{kind:string, value:(number|string)}>}
 */
export function detectNewAwards({ prev = {}, updated = {}, points = {}, badges = null } = {}) {
  const awards = [];

  // 1) Streak milestones — a new entry in reachedMilestones.
  const prevStreak = prev.reachedMilestones || [];
  const updStreak = updated.reachedMilestones || [];
  updStreak
    .filter((m) => !prevStreak.includes(m))
    .forEach((m) => awards.push({ kind: 'streak', value: m }));

  // 1b) FIRST-EVER Puzzle Piece / Battle Point (David, 2026-10-18): a one-time
  // explainer card. Only on a KNOWN 0 → ≥1 move — an unknown "before" (null)
  // must never read as zero, or every veteran would be told about their "first"
  // piece. It can never repeat: the total never goes back to 0, and the
  // announced-record holds `pieceIntro:1` / `battlePointIntro:1` besides.
  if (points.prevPuzzle === 0 && (points.puzzle || 0) >= 1) awards.push({ kind: 'pieceIntro', value: 1 });
  if (points.prevBattle === 0 && (points.battle || 0) >= 1) awards.push({ kind: 'battlePointIntro', value: 1 });

  // 2) Puzzle-piece tier (cumulative perfect-solve points).
  pointsTiersCrossed(points.prevPuzzle, points.puzzle, [
    PUZZLE_POINTS.BRONZE, PUZZLE_POINTS.SILVER, PUZZLE_POINTS.GOLD,
  ]).forEach((tier) => awards.push({ kind: 'puzzle', value: tier }));

  // 3) Battle-point tier (cumulative Colosseum wins).
  pointsTiersCrossed(points.prevBattle, points.battle, [
    BATTLE_POINTS.BRONZE, BATTLE_POINTS.SILVER, BATTLE_POINTS.GOLD,
  ]).forEach((tier) => awards.push({ kind: 'battle', value: tier }));

  // 4) Perfect-solve streak milestones — count for a milestone ticked up.
  // `count` rides along because this family is the ONE that repeats: a broken
  // and rebuilt perfect streak reaches the same milestone again, and
  // `perfectStreakMilestones[m]` is a counter rather than a set membership. The
  // announced-record ranks this family by that count, so without it a second
  // genuine 7-day perfect streak would be indistinguishable from a replay of the
  // first and would be suppressed. Every other family is once-ever and ranks 0.
  const prevPerfect = prev.perfectStreakMilestones || {};
  const updPerfect = updated.perfectStreakMilestones || {};
  PERFECT_MILESTONES.forEach((m) => {
    const count = updPerfect[m] || 0;
    if (count > (prevPerfect[m] || 0)) awards.push({ kind: 'perfect', value: m, count });
  });

  // 5) Time milestones — first solve ever under a threshold.
  //
  // ONLY THE FASTEST THRESHOLD CROSSED (David, 2026-09-03). There are TEN rungs
  // (600s down to 10s), and a solve crosses EVERY rung it beats — so a first
  // four-minute solve crossed 600 and 300 and played two full screens back to
  // back, "under 10 minutes" then "under 5 minutes". David saw exactly that and
  // ruled it out: a fast solve is ONE achievement, and the slower rungs it swept
  // past on the way say nothing the fastest one does not already say.
  //
  // Crossing a rung for the first time IS a personal best by construction — you
  // have never been that fast before — so taking the minimum is the whole rule.
  const prevTime = prev.timeMilestones || {};
  const updTime = updated.timeMilestones || {};
  const crossed = TIME_MILESTONES.filter(
    (t) => (prevTime[t] || 0) === 0 && (updTime[t] || 0) > 0,
  );
  if (crossed.length > 0) awards.push({ kind: 'time', value: Math.min(...crossed) });

  // 6) Registry badges (Badge System Redesign) — diffed from derived badge state
  //    rather than the stats blob, because that is where craft/Blitz badges live.
  if (badges) {
    awards.push(...detectNewBadgeAwards({ prev: badges.prev, next: badges.next }));
  }

  return awards;
}

// ---------------------------------------------------------------------------
// Registry badges (Badge System Redesign) — the SIXTH award family.
//
// The five families above diff a stats BLOB. Craft badges (Lane B) and Blitz
// badges (Lane D) aren't in that blob: they're derived from the solve/battle
// logs into a state map keyed by registry badge id. So they get their own diff,
// and then join the same `planAwardCelebrations` queue as everything else — one
// celebration path, exactly as the redesign requires.
// ---------------------------------------------------------------------------

// Registry order, so a multi-badge solve always celebrates in the same order
// regardless of object-key iteration.
const BADGE_ORDER = new Map(BADGES.map((b, i) => [b.id, i]));

/**
 * Is a derivation-lane state entry earned? `tier === -1` is the canonical
 * UNEARNED sentinel Lanes B and D share, so a bare tier is enough when the
 * explicit flag is absent.
 * @param {any} state
 * @returns {boolean}
 */
function stateEarned(state) {
  if (!state || typeof state !== 'object') return false;
  if (typeof state.earned === 'boolean') return state.earned;
  return Number.isFinite(state.tier) && state.tier >= 0;
}

/** Highest tier reached, with -1 for "no tier recorded" (and for unearned). */
function stateTier(state) {
  if (!stateEarned(state)) return -1;
  return Number.isFinite(state?.tier) ? Math.max(/** @type {number} */ (state.tier), 0) : 0;
}

/**
 * Diff two badge-state maps and return the badges that deserve a celebration.
 *
 * Two — and only two — things pop:
 *   1. A FIRST earn (unearned → earned). For a hidden badge (Echo of 37,
 *      Resonance, Total Eclipse) this pop IS the reveal: the award carries the
 *      badge's real name and art, never the silhouette.
 *   2. A LADDER CROSSING (tier went up: 1st → 10th → 37th…). Repeating a feat at
 *      a tier you already hold does NOT pop — the ×N count on the card ticks up
 *      silently. That falls out of comparing tiers, not counts.
 *
 * `prev` is whatever the caller last SAW, not necessarily the pre-solve state:
 * on the stats page it's the persisted announced-snapshot, at solve time it's the
 * pre-solve derivation. Both work because this is a pure two-map diff.
 *
 * @param {{prev?:object, next?:object}} [args]
 * @returns {Array<{kind:'badge', value:string, badgeId:string, featId:(string|undefined), tier:number, previousTier:number, state:any}>}
 */
export function detectNewBadgeAwards({ prev = {}, next = {} } = {}) {
  if (!next || typeof next !== 'object') return [];
  const before = prev && typeof prev === 'object' ? prev : {};

  const awards = [];
  for (const [badgeId, state] of Object.entries(next)) {
    if (!stateEarned(state)) continue;

    const previousTier = stateTier(before[badgeId]);
    const tier = stateTier(state);

    // Earned before AND no higher rung reached → nothing new to celebrate.
    if (previousTier >= 0 && tier <= previousTier) continue;

    awards.push({
      kind: /** @type {'badge'} */ ('badge'),
      value: badgeId,
      badgeId,
      featId: state?.featId,
      tier,
      previousTier,
      state,
    });
  }

  return awards.sort(
    (a, b) => (BADGE_ORDER.get(a.badgeId) ?? Number.MAX_SAFE_INTEGER) - (BADGE_ORDER.get(b.badgeId) ?? Number.MAX_SAFE_INTEGER),
  );
}

// Puzzle/battle point tiers mapped onto the neon rarity wheel so they read as
// part of the same colour language as the streak/perfect/time badges.
const TIER_RARITY = { bronze: 'var(--u37-tier-2)', silver: 'var(--u37-tier-4)', gold: 'var(--u37-tier-6)' };
const TIER_LABEL = { bronze: 'Bronze', silver: 'Silver', gold: 'Gold' };

// A podium placement wears the metal it won, not a rarity tier — 1st is gold
// however common a gold is for this player.
const PLACE_ORDINAL = ['1st', '2nd', '3rd'];
const PLACE_MEDAL = ['🥇', '🥈', '🥉'];
const PLACE_HUE = [TIER_RARITY.gold, TIER_RARITY.silver, TIER_RARITY.bronze];
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

/**
 * 'Sunday' for an ISO date, or the date itself if it will not parse.
 *
 * Computed in UTC from the calendar parts rather than through a local `Date`
 * or `toLocaleDateString`: a local-midnight parse shifts the day for anyone west
 * of Greenwich, and a locale-driven name would make this function's output
 * depend on the machine it runs on. A weekday is unambiguous inside the
 * seven-day window this is used for.
 *
 * @param {string} date 'YYYY-MM-DD'
 * @returns {string}
 */
export function weekdayName(date) {
  const [y, m, d] = String(date || '').split('-').map(Number);
  if (!y || !m || !d) return String(date || '');
  const day = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
  return WEEKDAYS[day] ?? String(date);
}

function formatUnder(seconds) {
  const mins = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return mins > 0 ? `${mins}:${String(secs).padStart(2, '0')}` : `0:${String(secs).padStart(2, '0')}`;
}

/**
 * Pure presentation descriptor for an award: the glyph, title, subtitle and neon
 * hue (a CSS var) the celebration UI renders. Keeps the components declarative and
 * the mapping unit-testable.
 *
 * TWO GLYPH CHANNELS, and a registry badge uses exactly one of them. The five
 * legacy stat families (streak · perfect · time · puzzle · battle) still describe
 * themselves with an `emoji` — their artwork is the emoji configs and the
 * puzzle/battle PNGs, not the badge icon set. A `kind:'badge'` award instead
 * carries `iconKey`, a key into the vendored SVG set, and carries NO `emoji` at
 * all: it used to hand back `badge.art` and the celebration popped a text emoji
 * over the very card that had just drawn the badge as an SVG. Dropping the field
 * rather than merely ignoring it is what stops a future consumer re-introducing
 * the mismatch. (`Badge.art` itself stays in the registry as a documented
 * fallback — no consumer reads it today.)
 *
 * @returns {{emoji?:string, iconKey?:string, eyebrow?:string, title:string, subtitle:string, lines?:string[], hue:string}}
 */
export function describeAward(award = {}) {
  const { kind, value } = award;
  if (kind === 'streak') {
    const idx = Math.max(0, tierIndex('streak', value));
    return {
      emoji: STREAK_ICON_CONFIGS[idx]?.emoji || '🔥',
      title: `${value}-Day Streak`,
      subtitle: 'Daily Challenge milestone',
      hue: badgeRarityVar('streak', value),
    };
  }
  if (kind === 'perfect') {
    const idx = Math.max(0, tierIndex('perfect', value));
    return {
      emoji: PERFECT_ICON_CONFIGS[idx]?.emoji || '🎯',
      title: `${value}-Day Perfect Streak`,
      subtitle: 'Flawless power-dice solves',
      hue: badgeRarityVar('perfect', value),
    };
  }
  if (kind === 'time') {
    return {
      emoji: TIME_ICON_CONFIGS[value]?.emoji || '⚡',
      title: `Under ${formatUnder(value)}`,
      subtitle: 'Speed badge unlocked',
      hue: badgeRarityVar('time', value),
    };
  }
  // One-time explainers (David, 2026-10-18 — copy approved verbatim). `lines`
  // render as a short list under the title; the numbers come from the same
  // constants the server is pinned to (PUZZLE_POINTS / BATTLE_POINTS).
  if (kind === 'pieceIntro') {
    return {
      emoji: '🧩',
      eyebrow: 'New!',
      title: 'Your first Puzzle Piece!',
      subtitle: '',
      lines: [
        'Earn Pieces on the Daily: Perfect Challenge solve = 1, Expert in under 37 seconds = 2.',
        `Collect ${PUZZLE_POINTS.BRONZE} · ${PUZZLE_POINTS.SILVER} · ${PUZZLE_POINTS.GOLD} for Bronze, Silver and Gold badges by your name.`,
        'Leaderboards → Puzzle Pieces shows who has the most.',
      ],
      hue: 'var(--u37-gold)',
    };
  }
  if (kind === 'battlePointIntro') {
    return {
      emoji: '⚔️',
      eyebrow: 'New!',
      title: 'Your first Battle Point!',
      subtitle: '',
      lines: [
        'Win a head-to-head Blitz battle = 1 Battle Point.',
        `Collect ${BATTLE_POINTS.BRONZE} · ${BATTLE_POINTS.SILVER} · ${BATTLE_POINTS.GOLD} for Bronze, Silver and Gold badges by your name.`,
        'Leaderboards → Battle Points shows who has the most.',
      ],
      hue: 'var(--u37-magenta)',
    };
  }
  if (kind === 'puzzle') {
    return {
      emoji: '🧩',
      title: `${TIER_LABEL[value] || value} Puzzle Badge`,
      subtitle: 'Puzzle Pieces milestone',
      hue: TIER_RARITY[value] || 'var(--u37-tier-2)',
    };
  }
  if (kind === 'battle') {
    return {
      emoji: '⚔️',
      title: `${TIER_LABEL[value] || value} Battle Badge`,
      subtitle: 'Blitz Colosseum wins',
      hue: TIER_RARITY[value] || 'var(--u37-tier-2)',
    };
  }
  // A PLACEMENT, not a ladder rung: "you placed 2nd in Expert on Sunday". It
  // names the mode because three Dailies means three separate races on one date,
  // and it names the day because it is always news about a day that has closed —
  // never about today, which is still being run. See podiumCatchUp.
  if (kind === 'podium') {
    const rank = Number(award.rank);
    const i = Number.isFinite(rank) ? rank - 1 : -1;
    return {
      emoji: PLACE_MEDAL[i] || '🏅',
      title: `${PLACE_ORDINAL[i] || `${rank}th`} Place`,
      subtitle: `${modeTierLabel(award.mode)} Daily · ${weekdayName(award.date)}`,
      hue: PLACE_HUE[i] || 'var(--u37-tier-2)',
    };
  }
  if (kind === 'badge') {
    // Registry-driven, so a badge added to the catalog celebrates correctly with
    // no change here. A HIDDEN badge's pop is its reveal — real name, real art.
    const badge = getBadge(String(value));
    const total = badgeTierCount(badge);
    const tier = Number.isFinite(award.tier) ? Math.max(/** @type {number} */ (award.tier), 0) : 0;
    const laddered = total > 1;
    const firstEarn = !Number.isFinite(award.previousTier) || /** @type {number} */ (award.previousTier) < 0;
    return {
      // `badgeIconKey` already falls back to the default medal for an unknown or
      // unmapped badge, so there is no id this can leave without a drawing.
      iconKey: badgeIconKey(badge),
      title: badge?.name || 'New Badge',
      subtitle: badge?.hidden && firstEarn
        ? 'Hidden badge revealed'
        : laddered && !firstEarn
          ? `Tier ${tier + 1} of ${total}`
          : 'Badge unlocked',
      hue: rarityVar(tier, total),
    };
  }
  return { emoji: '⭐', title: 'Achievement', subtitle: '', hue: 'var(--u37-tier-1)' };
}

// Show at most this many awards on their own dedicated celebration screen before
// collapsing the rest into a single summary.
//
// RAISED 2 -> 3 (David, 2026-09-03) because badges no longer compete for these
// slots — they always collapse (see BIG_KINDS). What is left are the rare things,
// and the realistic worst case is a medal + a streak milestone + a speed record
// from one solve. Capping that at 2 would drop a genuinely big moment on the floor.
export const INDIVIDUAL_CAP = 3;

/**
 * The award families that still earn a full screen of their own.
 *
 * David, 2026-09-03: "Make it for only the big stuff that has its own screen.
 * Otherwise, if badges are earned, show it, but just show the you earned N many
 * badges - go to the stats page to see!"
 *
 * So: puzzle and battle MEDALS (bronze/silver/gold, drawn with real artwork),
 * streak and perfect-streak MILESTONES (3/7/14/37/100/365 — rare by design), and
 * a SPEED record (already reduced to the single fastest rung crossed, see
 * detectNewAwards). Registry badges are deliberately absent: there are ~52 of
 * them and climbing, they arrive several at a time, and a screen each is what
 * turned a win into a slideshow.
 *
 * `podium` joins them (2026-09-05): placing on a day's board is unambiguously
 * "the big stuff", it is rare, and it can only ever arrive as catch-up for a day
 * that has already closed. INDIVIDUAL_CAP still bounds the worst case — a player
 * away for a week who placed on all three boards every day gets three screens
 * and a summary, not twenty-one screens.
 */
export const BIG_KINDS = Object.freeze(['pieceIntro', 'battlePointIntro', 'puzzle', 'battle', 'streak', 'perfect', 'time', 'podium']);

/** Whether an award is big enough to interrupt the player with its own screen. */
export const isBigAward = (award) => BIG_KINDS.includes(award?.kind);

/**
 * Turn a list of awards into an ordered list of celebration STEPS: up to
 * INDIVIDUAL_CAP individual award screens, then (only if there are extras) one
 * summary step carrying the remainder.
 *
 * `summaryOnly` collapses ANY number of awards into that single summary step with
 * no individual screens at all. That is the RETROACTIVE launch path: a player who
 * qualified for 23 badges from their history gets ONE "you've unlocked 23 badges"
 * moment, never 23 sequential pops. Only badges earned AFTER launch take the
 * normal per-earn path above.
 *
 * @param {Array} [awards]
 * @param {{summaryOnly?: boolean}} [opts]
 * @returns {{ steps: Array, total: number }}
 *   step = { type:'award', award } | { type:'summary', awards, moreCount, allAwards }
 */
export function planAwardCelebrations(awards = [], opts = {}) {
  if (!Array.isArray(awards) || awards.length === 0) return { steps: [], total: 0 };

  if (opts.summaryOnly) {
    return {
      steps: [{ type: 'summary', awards, moreCount: awards.length, allAwards: awards, retroactive: true }],
      total: awards.length,
    };
  }

  // Split first: the big families earn a screen, registry badges never do.
  const big = awards.filter(isBigAward);
  const collapsed = awards.filter((a) => !isBigAward(a));

  // Overflow past the cap joins the collapsed group rather than being dropped.
  const individual = big.slice(0, INDIVIDUAL_CAP).map((award) => ({ type: 'award', award }));
  const rest = [...big.slice(INDIVIDUAL_CAP), ...collapsed];

  // Annotated because tsc otherwise infers the array's element type from the
  // FIRST entry ({type:'award', award}) and then rejects the summary step, whose
  // shape is deliberately different. The two step shapes are a union, not a
  // mistake; AwardCelebrationSequence branches on `type` to tell them apart.
  /** @type {Array<{type: string, award?: any, awards?: any[], moreCount?: number, allAwards?: any[], badgesOnly?: boolean, retroactive?: boolean}>} */
  const steps = [...individual];
  if (rest.length > 0) {
    steps.push({
      type: 'summary',
      awards: rest,
      moreCount: rest.length,
      allAwards: awards,
      // True when the card is purely badges, which is the ordinary case and the
      // one David wrote the copy for. A mixed card (big-award overflow swept in
      // alongside) must not claim they were all badges.
      badgesOnly: rest.every((a) => a.kind === 'badge'),
    });
  }

  return { steps, total: awards.length };
}
