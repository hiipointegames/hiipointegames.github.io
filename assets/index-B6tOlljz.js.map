// The Daily's puzzle number: "#159", printed on every share card.
//
// ONE number for all three modes, following the Challenge Daily (David,
// 2026-09-29). Easy and Expert arrived in September, but a group chat comparing
// "#159" should not have to know that — the same day is the same number whatever
// tier you played.
//
// The rule is calendar-based: days since the first Challenge Daily, plus one.
// Verified on prod 2026-09-29: the Challenge Daily ('daily') starts 2026-04-24 and
// has a row for every one of the 159 days through 2026-09-29, so counting days and
// counting stored puzzles give the same answer (#159). Counting days is used
// because it can never skip or repeat, whatever the nightly cron does.

export const FIRST_DAILY_DATE = '2026-04-24';

const MS_PER_DAY = 86400000;

// 'YYYY-MM-DD' → a UTC day index. Parsing as UTC keeps daylight-saving changes
// from ever turning a day into 23 or 25 hours.
function dayIndex(isoDate) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(isoDate || ''));
  if (!m) return NaN;
  return Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])) / MS_PER_DAY;
}

/**
 * The puzzle number for a Daily date (an ET calendar date, 'YYYY-MM-DD').
 * Returns null for a malformed date or one before the first Daily.
 * @param {string} isoDate
 * @returns {number|null}
 */
export function dailyPuzzleNumber(isoDate) {
  const n = dayIndex(isoDate) - dayIndex(FIRST_DAILY_DATE) + 1;
  return Number.isFinite(n) && n >= 1 ? n : null;
}
