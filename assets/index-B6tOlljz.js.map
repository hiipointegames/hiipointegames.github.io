// Blitz badge DERIVATION — battle facts + solo counters → earned-badge state.
//
// Badge System Redesign, Lane D. The counterpart to Lane B's craft derivation:
// same output contract (`{ earned, count, tier, earliestDate, … }` keyed by
// featId), different source. Lane B replays solve rows; this replays
// `head_to_head_challenges` rows plus the `game_stats.soloBlitz` counters.
//
// Layering:
//   row facts (tie-breaks, margins, shutouts, lead flips, streaks)
//                                       → @/head-to-head blitzBattleBadges.js
//   thresholds / tier names / hidden flags → @/game-mechanics badgeRegistry.js
//   the join (this file)                → earned-badge state for the showcase
//
// Nothing here knows a number: every threshold comes from the registry, so a
// ladder retune is a one-line registry edit and can't leave a derivation behind
// (the 2026-07-02 achievement-ladder retune that shipped without a migration is
// exactly the failure this layering prevents — see docs/bugs.md).
//
// PLAYER-PARAMETERIZED. The showcase renders for any player — your own stats
// page and another player's (`Statistics?id=` / the OtherProfile card) — so
// every function here takes the target player explicitly and NOTHING reads the
// signed-in user. (The one own-only piece of the Blitz badge set is the
// `bestSolveTime` write in foldSoloBlitzRun, which is a write, not a read.)
//
// Battle badges derive from ROWS, never from `game_stats.blitzStats` or
// `profiles.battle_points`: those client-maintained mirrors drift, and the
// in-flight M3 finalize migration may drop them. Solo badges have no event log
// to replay, so they read the counters `foldSoloBlitzRun` maintains.

import { apiClient } from '@/transport';
import { getBadgeForFeat, badgeTierIndex } from '@/game-mechanics';
import { summarizePlayerBattleBadges, getPlayerBattles } from '@/head-to-head';
import { getPlayerStats } from './playerStats';

/**
 * @typedef {Object} BadgeState
 * @property {string} featId
 * @property {string} badgeId    Registry entry id (differs from featId only for
 *                               the mode-split craft badges — never here).
 * @property {boolean} earned
 * @property {number} count      How many times the feat has been achieved. For a
 *                               threshold badge with no per-occurrence notion
 *                               (a personal best, a streak) this is 1 once earned.
 * @property {number} tier       Highest 0-based ladder tier reached; -1 = unearned.
 * @property {string|null} earliestDate  YYYY-MM-DD the feat was first achieved.
 * @property {number|null} value The ladder value behind `tier` (streak length,
 *                               margin, seconds, puzzles) — null for count ladders.
 */

/**
 * Build one badge's state against its registry entry.
 *
 * A `countLadder` badge is judged on `count`; every other ladder on `value`.
 * `durationSeconds` resolves Meteor Shower's battle-length-scaled tier row.
 *
 * @param {string} featId
 * @param {'blitzBattle'|'soloBlitz'|'crossArena'|'any'} mode
 * @param {{count?:number, value?:number|null, earliestDate?:string|null,
 *          tier?:number|null, durationSeconds?:number}} facts
 * @returns {BadgeState}
 */
function badgeState(featId, mode, facts) {
  const { count = 0, value = null, earliestDate = null, tier = null, durationSeconds } = facts;
  const badge = getBadgeForFeat(featId, mode);
  const isCountLadder = badge?.scaling?.type === 'countLadder';
  const ladderInput = isCountLadder ? count : value;
  const resolvedTier =
    tier !== null && tier !== undefined
      ? tier
      : badgeTierIndex(badge, ladderInput === null || ladderInput === undefined ? NaN : ladderInput, durationSeconds);

  return {
    featId,
    badgeId: badge?.id ?? featId,
    earned: resolvedTier >= 0,
    // A threshold badge that IS earned always reports at least one achievement,
    // so consumers can render "×N" uniformly without branching on scaling type.
    count: !isCountLadder && resolvedTier >= 0 ? Math.max(count, 1) : count,
    tier: resolvedTier,
    earliestDate,
    value: isCountLadder ? null : (value ?? null),
  };
}

/**
 * Count the battles that reached a badge's FIRST tier, and the date of the
 * earliest one. Lets a threshold badge (Shockwave, Light Speed) still report a
 * meaningful `×N` and first-earned date.
 *
 * @param {import('@/head-to-head/blitzBattleBadges').BattleBadgeFacts[]} battles
 * @param {string} featId
 * @param {(f:any) => number|null} pick - the ladder value for one battle
 * @returns {{count:number, earliestDate:string|null}}
 */
function countQualifyingBattles(battles, featId, pick) {
  const badge = getBadgeForFeat(featId, 'blitzBattle');
  let count = 0;
  let earliestDate = null;
  for (const battle of battles) {
    const value = pick(battle);
    if (value === null || value === undefined) continue;
    if (badgeTierIndex(badge, value, battle.durationSeconds) < 0) continue;
    count += 1;
    if (earliestDate === null) earliestDate = battle.date;
  }
  return { count, earliestDate };
}

/**
 * Meteor Shower is the one badge whose ladder MOVES between battles — a 3-minute
 * race and a 10-minute race are judged on different rows (registry
 * `scaling.perDuration`). So its tier is the best tier reached across battles,
 * not the best raw puzzle count.
 *
 * @param {import('@/head-to-head/blitzBattleBadges').BattleBadgeFacts[]} battles
 * @returns {BadgeState}
 */
function deriveMeteorShower(battles) {
  const badge = getBadgeForFeat('meteorShower', 'blitzBattle');
  let bestTier = -1;
  let bestValue = null;
  let count = 0;
  let earliestDate = null;

  for (const battle of battles) {
    const tier = badgeTierIndex(badge, battle.mySolved, battle.durationSeconds);
    if (tier < 0) continue;
    count += 1;
    if (earliestDate === null) earliestDate = battle.date;
    if (tier > bestTier) {
      bestTier = tier;
      bestValue = battle.mySolved;
    }
  }

  return badgeState('meteorShower', 'blitzBattle', { count, value: bestValue, earliestDate, tier: bestTier });
}

/**
 * Every Blitz Colosseum BATTLE badge, derived from a player's battle rows.
 *
 * @param {Array<object>} challenges - the player's battles (completed-only;
 *   caller pre-filters, e.g. getPlayerBattles)
 * @param {string} userId
 * @returns {Record<string, BadgeState>}
 */
export function deriveBattleBadgeState(challenges, userId) {
  return battleBadgesFromSummary(summarizePlayerBattleBadges(challenges, userId));
}

/**
 * The battle-badge join, off an already-computed summary — so the full
 * derivation walks a player's rows exactly once.
 *
 * @param {ReturnType<typeof summarizePlayerBattleBadges>} summary
 * @returns {Record<string, BadgeState>}
 */
function battleBadgesFromSummary(summary) {
  const { battles } = summary;

  const shockwave = countQualifyingBattles(battles, 'shockwave', (b) => (b.isWin ? b.margin : null));
  const lightSpeed = countQualifyingBattles(battles, 'lightSpeed', (b) => b.myFastestSolve);

  return {
    photoFinish: badgeState('photoFinish', 'blitzBattle', {
      count: summary.photoFinish.count,
      earliestDate: summary.photoFinish.earliestDate,
    }),
    warpath: badgeState('warpath', 'blitzBattle', {
      value: summary.longestWinStreak.value,
      earliestDate: summary.longestWinStreak.date,
    }),
    shockwave: badgeState('shockwave', 'blitzBattle', {
      count: shockwave.count,
      value: summary.bestMargin.value,
      earliestDate: shockwave.earliestDate,
    }),
    totalEclipse: badgeState('totalEclipse', 'blitzBattle', {
      count: summary.totalEclipse.count,
      earliestDate: summary.totalEclipse.earliestDate,
    }),
    lightSpeed: badgeState('lightSpeed', 'blitzBattle', {
      count: lightSpeed.count,
      value: summary.bestFastestSolve.value,
      earliestDate: lightSpeed.earliestDate,
    }),
    gladiator: badgeState('gladiator', 'blitzBattle', {
      count: summary.totalBattles,
      earliestDate: summary.firstBattleDate,
    }),
    nemesis: badgeState('nemesis', 'blitzBattle', {
      count: summary.nemesis.count,
      earliestDate: summary.nemesis.earliestDate,
    }),
    theLongGame: badgeState('theLongGame', 'blitzBattle', {
      count: summary.longGame.count,
      earliestDate: summary.longGame.earliestDate,
    }),
    meteorShower: deriveMeteorShower(battles),
    phoenixRising: badgeState('phoenixRising', 'blitzBattle', {
      count: summary.leadFlip.count,
      earliestDate: summary.leadFlip.earliestDate,
    }),
  };
}

// `firstBlitzWin` was RETIRED in Round 2 § DEDUPE, and its derivation went with
// it. The shield fired on "won at least one battle"; `blitzWinLadder` tier 0 is
// one win and is literally NAMED "First Win". Both were computed from the same
// `summarizePlayerBattleBadges` scan of the same `head_to_head_challenges` rows
// — this file found the first `isWin` row, existingBadgeDerivation counts them —
// so the two could never disagree and the ladder keeps every earned state lit.
// The badge's first-win DATE is not lost either: `deriveBlitzWinCount` in
// existingBadgeDerivation.js already hands the ladder that same `firstWinDate`.

/** One solo-blitz mode bucket, defensively read. */
function soloBucket(gameStats, modeKey) {
  const bucket = gameStats?.soloBlitz?.[modeKey];
  const read = (key) => {
    const v = bucket?.[key];
    return typeof v === 'number' && Number.isFinite(v) ? v : 0;
  };
  return {
    totalRuns: read('totalRuns'),
    totalPuzzlesSolved: read('totalPuzzlesSolved'),
    bestRun: read('bestRun'),
    // 0 means "never recorded" for a time, so it must not win a min().
    bestSolveTime: read('bestSolveTime') > 0 ? read('bestSolveTime') : null,
  };
}

/**
 * The solo Blitz badges, derived from `game_stats.soloBlitz`.
 *
 * Solo runs persist counters only (no per-run event log), so these read the
 * aggregate `foldSoloBlitzRun` maintains and cannot report an earned date —
 * `earliestDate` is null by construction, not by omission.
 *
 * Across-mode semantics: Solar Flare is a single-RUN record so it takes the
 * better of the two modes; Cosmic Grind is a lifetime volume ladder so it sums
 * them; Warp Reflex is a single-SOLVE record so it takes the faster.
 *
 * @param {object|null|undefined} gameStats
 * @returns {Record<string, BadgeState>}
 */
export function deriveSoloBlitzBadgeState(gameStats) {
  const easy = soloBucket(gameStats, 'easy');
  const challenge = soloBucket(gameStats, 'challenge');

  const bestRun = Math.max(easy.bestRun, challenge.bestRun);
  const lifetimeSolved = easy.totalPuzzlesSolved + challenge.totalPuzzlesSolved;
  const bestTimes = [easy.bestSolveTime, challenge.bestSolveTime].filter((t) => t !== null);
  const bestSolveTime = bestTimes.length > 0 ? Math.min(...bestTimes) : null;

  return {
    solarFlare: badgeState('solarFlare', 'soloBlitz', { value: bestRun }),
    cosmicGrind: badgeState('cosmicGrind', 'soloBlitz', { value: lifetimeSolved }),
    warpReflex: badgeState('warpReflex', 'soloBlitz', { value: bestSolveTime }),
  };
}

/**
 * Arena Master — the cross-arena capstone: played all four Blitz categories
 * (solo Easy, solo Challenge, battle Easy, battle Challenge).
 *
 * @param {{easy:boolean, challenge:boolean}} battleModesPlayed
 * @param {object|null|undefined} gameStats
 * @returns {BadgeState & {categories: Record<string, boolean>}}
 */
export function deriveArenaMaster(battleModesPlayed, gameStats) {
  // ⚠️ STAYS AT FOUR CATEGORIES even though the mode axis is now three-valued.
  //
  // Adding soloExpert and battleExpert would make this a SIX-category badge, and
  // `done === 4` would stop being reachable — so every player who already holds
  // Arena Master would silently LOSE it the moment Expert shipped. Badges in this
  // codebase only ever move up; un-earning one is the failure the retroactive
  // announcement machinery exists to avoid, and it would be caused here by a
  // change that looks like bookkeeping.
  //
  // Whether Arena Master should eventually demand all three tiers is a PRODUCT
  // call, not a consequence of widening a stats axis. Left for David.
  const categories = {
    soloEasy: soloBucket(gameStats, 'easy').totalRuns > 0,
    soloChallenge: soloBucket(gameStats, 'challenge').totalRuns > 0,
    battleEasy: !!battleModesPlayed?.easy,
    battleChallenge: !!battleModesPlayed?.challenge,
  };
  const done = Object.values(categories).filter(Boolean).length;
  return {
    ...badgeState('arenaMaster', 'crossArena', { value: done === 4 ? 1 : 0, count: done === 4 ? 1 : 0 }),
    categories,
  };
}

/**
 * Every Blitz badge — battle, solo and the cross-arena capstone — in one keyed
 * map. (`firstBlitzWin` used to ride along here; § DEDUPE retired it, see the
 * note above `soloBucket`.)
 *
 * @param {{challenges?:Array<object>, userId:string, gameStats?:object|null}} input
 * @returns {Record<string, BadgeState>}
 */
export function deriveBlitzBadgeState({ challenges = [], userId, gameStats = null }) {
  const summary = summarizePlayerBattleBadges(challenges, userId);
  return {
    ...battleBadgesFromSummary(summary),
    ...deriveSoloBlitzBadgeState(gameStats),
    arenaMaster: deriveArenaMaster(summary.modesPlayed, gameStats),
  };
}

/**
 * Fetch + derive ANY player's Blitz badge state. Thin async wrapper over the
 * pure derivation, mirroring the fetch/derive split the rest of
 * stats-aggregation uses.
 *
 * Cross-player by construction — the showcase renders on your own Statistics
 * page AND on another player's (`Statistics?id=` / the OtherProfile card), so
 * nothing below assumes the viewer. Both sources are already readable for any
 * player: `head_to_head_challenges` is world-readable, and `game_stats.soloBlitz`
 * comes back from the same `get-player-stats` edge call OtherProfile/Statistics
 * already make. `userId` defaults to the signed-in user purely as a convenience.
 *
 * Pass `gameStats` when the caller already holds the player's stats blob (both
 * pages do) to skip the redundant edge call.
 *
 * @param {string} [userId] - target player; defaults to the current user
 * @param {{gameStats?: object|null}} [opts]
 * @returns {Promise<Record<string, BadgeState>>}
 */
export async function getBlitzBadgeState(userId, { gameStats } = {}) {
  const targetId = userId || (await apiClient.auth.me())?.id;
  if (!targetId) return deriveBlitzBadgeState({ challenges: [], userId: '', gameStats: null });

  const [challenges, stats] = await Promise.all([
    getPlayerBattles(targetId),
    gameStats !== undefined ? Promise.resolve(gameStats) : fetchGameStats(targetId),
  ]);
  return deriveBlitzBadgeState({ challenges, userId: targetId, gameStats: stats });
}

/** The viewed player's game_stats blob; null when the edge call can't serve it. */
async function fetchGameStats(playerId) {
  const result = await getPlayerStats(playerId);
  return result.success ? result.data.game_stats : null;
}
