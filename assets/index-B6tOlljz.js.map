// StoreBadges — the NATIVE-BUILD STUB.
//
// vite.config.js aliases '@/shell/StoreBadges' to this file whenever the build
// is not positively identified as the web build (see scripts/webBuildFlag.mjs).
// Importing this instead of the real module is what keeps the store badges out
// of the app: the real StoreBadges.jsx, its stylesheet and both storefront URLs
// never enter the native/OTA bundle at all.
//
// WHY A STUB AND NOT JUST THE RUNTIME GUARD. StoreBadges.jsx already returns
// null on native, so nothing ever RENDERED in the app. But the code still got
// bundled — verified by building and grepping the output, which found the
// Google Play URL sitting in the native bundle unused. "Not rendered" is not
// "not shipped", and the instruction was that these must never go to the app.
//
// It deliberately contains NO href, NO markup and NO stylesheet import. There is
// nothing here to leak. Keep it that way: anything added to the real module's
// public surface needs a matching inert export here, or the native build breaks
// at import time.

/** Same name as the real module's export, so the native build's import resolves.
 *  Empty because a native bundle has no business carrying storefront URLs. */
export const STORE_LINKS = [];

/** Renders nothing. Matches the real component's native behaviour exactly, so
 *  swapping the module changes what is BUNDLED, never what is displayed. */
export function StoreBadgeRow() {
  return null;
}
