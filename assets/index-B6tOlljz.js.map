import React, { useEffect, useMemo, useRef, useState } from 'react';
import { createPortal } from 'react-dom';
import { Check, ChevronLeft, Eye, EyeOff, Loader2, Search, Shield, Shuffle } from 'lucide-react';

import { MIN_PASSWORD_LEN } from '@/transport';
import { countries } from '@/components/profile/countries';
import { CONTEST_AGE_REASSURANCE } from '@/contest';
import { REFERRAL_COPY, REFERRAL_MESSAGES, referralSavedMessage, useReferralsOn } from '@/referrals';

import { checkUsername, AVAILABILITY_DEBOUNCE_MS } from './usernameAvailability';
import { shuffleAvailableName } from './funNames';
import { submitSignup } from './submitSignup';
import { addEmailAfterSignup } from './addEmailAfterSignup';
import { STEP_ACCENT, neonSurface, neonText, neonField } from './neon';
import SignupGiveawayBox from './SignupGiveawayBox';

// The guided signup — one question per screen (David, 2026-10-10; approved
// mockup https://claude.ai/artifact/9B1RUbmcMW18FLKcj6m358):
//
//   username → password → 18+/US (required) → email (optional) → country
//   (optional) → done.
//
// Nothing is saved while the player moves through the steps; submitSignup
// writes everything at the end, in a safe order, and sends them back to the
// step a failure belongs to.
//
// With the `referrals` switch on, an optional "Did a friend invite you?" step
// follows email; submitSignup claims it after the account exists.
//
// Rendered through a portal into <body>, at z-[200]: on iPhone, #root's
// `-webkit-overflow-scrolling` makes it a stacking context, so anything inside
// it — however high its z-index — is drawn under the bottom nav (the three-
// Dailies pop-up hit exactly this; fixed 40a906f).

const ORDER = ['username', 'password', 'age', 'email', 'country'];
// While the `referrals` switch is on, an optional "Did a friend invite you?"
// step follows Email (launch Sun 25 Oct 2026).
const ORDER_WITH_REFERRAL = ['username', 'password', 'age', 'email', 'referral', 'country'];
const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

/**
 * @param {{
 *   onDone: (user: any, answers: { eligible: boolean, email: string }) => void,
 *   onCancel: () => void,
 *   onLogin?: () => void,
 *   initialUsername?: string | null,
 *   excludeUserId?: string | null,
 *   deps?: { check?: Function, submit?: Function, shuffle?: Function, addEmail?: Function, referralsOn?: boolean, giveaway?: object },
 * }} props
 *   initialUsername — a legacy named guest's existing name, pre-filled
 *   excludeUserId   — the player's own id, so their own name is not "taken"
 *   deps            — test seams
 */
export default function GuidedSignup({ onDone, onCancel, onLogin, initialUsername = null, excludeUserId = null, deps = {} }) {
  const check = deps.check || ((name) => checkUsername(name, { excludeUserId }));
  const submit = deps.submit || submitSignup;
  const shuffle = deps.shuffle || ((c) => shuffleAvailableName(c));
  const addEmail = deps.addEmail || addEmailAfterSignup;

  const [step, setStep] = useState('username');
  const [username, setUsername] = useState(initialUsername || '');
  const [nameState, setNameState] = useState(/** @type {{status: string, message?: string, name?: string}} */ ({ status: 'idle' }));
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [eligible, setEligible] = useState(/** @type {boolean | null} */ (null));
  const [email, setEmail] = useState('');
  const [country, setCountry] = useState('');
  const [countryQuery, setCountryQuery] = useState('');
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState(/** @type {{ step: string, message: string } | null} */ (null));
  const [createdUser, setCreatedUser] = useState(null);
  // "Did a friend invite you?" — only while the `referrals` switch is on.
  const referralsOn = useReferralsOn({ override: deps.referralsOn });
  const order = referralsOn ? ORDER_WITH_REFERRAL : ORDER;
  const [referrer, setReferrer] = useState('');
  const [referralResult, setReferralResult] = useState(/** @type {any} */ (null));
  // After the account exists, `email` is only a draft: the Welcome screen reads
  // `savedEmail` (what the server actually has). `addingEmail` is the "Add
  // email" detour from Welcome back to the email step — Next there SAVES the
  // address to the existing account and returns to Welcome; it never re-runs
  // the signup, and never walks on to the country step.
  const [savedEmail, setSavedEmail] = useState('');
  const [addingEmail, setAddingEmail] = useState(false);
  const [emailPending, setEmailPending] = useState(false);
  const inputRef = useRef(/** @type {HTMLInputElement | null} */ (null));

  // Live, debounced availability check.
  useEffect(() => {
    if (!username.trim()) { setNameState({ status: 'idle' }); return undefined; }
    setNameState({ status: 'checking' });
    let live = true;
    const t = setTimeout(async () => {
      const r = await check(username);
      if (live) setNameState(r);
    }, AVAILABILITY_DEBOUNCE_MS);
    return () => { live = false; clearTimeout(t); };
  }, [username]);

  // Focus each step's field when it opens (keyboard + screen readers).
  useEffect(() => { inputRef.current?.focus?.(); }, [step]);

  const accent = STEP_ACCENT[step];
  const index = order.indexOf(step);
  const stepOf = () => `STEP ${index + 1} OF ${order.length}`;
  const afterEmail = referralsOn ? 'referral' : 'country';
  const errorHere = error && error.step === step ? error.message : '';

  const usernameOk = nameState.status === 'available' || nameState.status === 'unknown';
  const passwordOk = password.length >= MIN_PASSWORD_LEN;
  const emailOk = !email.trim() || EMAIL_RE.test(email.trim());

  const go = (next) => { setError(null); setStep(next); };
  const leaveAddEmail = () => { setEmail(savedEmail); setAddingEmail(false); go('done'); };
  const startAddEmail = () => { setEmail(''); setAddingEmail(true); go('email'); };
  const back = () => {
    if (addingEmail) leaveAddEmail();
    else if (index <= 0) onCancel();
    else go(order[index - 1]);
  };

  const onShuffle = async () => {
    const name = await shuffle(check);
    if (name) setUsername(name);
  };

  const create = async () => {
    setSubmitting(true);
    setError(null);
    const answers = {
      username: username.trim(), password, email: email.trim(), country, eligible: eligible === true,
      // Claimed by submitSignup AFTER the account exists; never fails signup.
      referrer: referralsOn ? referrer.trim() : '',
    };
    const r = await submit(answers);
    setSubmitting(false);
    if (!r.ok) {
      const target = r.step === 'final' ? 'country' : r.step;
      setError({ step: target, message: r.message });
      setStep(target);
      return;
    }
    window.dispatchEvent(new CustomEvent('userProfileUpdated', { detail: r.user }));
    setCreatedUser(r.user);
    setReferralResult(r.referral || null);
    setSavedEmail(answers.email);
    setStep('done');
  };

  const saveEmail = async () => {
    const trimmed = email.trim();
    if (!trimmed || !EMAIL_RE.test(trimmed)) return;
    setSubmitting(true);
    setError(null);
    const r = await addEmail(trimmed);
    setSubmitting(false);
    if (!r.ok) { setError({ step: 'email', message: r.message }); return; }
    if (r.user) {
      window.dispatchEvent(new CustomEvent('userProfileUpdated', { detail: r.user }));
      setCreatedUser(r.user);
    }
    if (r.status === 'saved') setSavedEmail(trimmed);
    else setEmailPending(true);
    setAddingEmail(false);
    go('done');
  };
  const emailNext = () => (addingEmail ? saveEmail() : go(afterEmail));

  const filteredCountries = useMemo(() => {
    const q = countryQuery.trim().toLowerCase();
    const list = q ? countries.filter((c) => c.name.toLowerCase().includes(q)) : countries;
    return list.slice(0, 6);
  }, [countryQuery]);

  const primary = (label, onClick, disabled = false, testId = 'signup-next') => (
    <button
      type="button"
      data-testid={testId}
      onClick={onClick}
      disabled={disabled || submitting}
      className="w-full min-h-[58px] rounded-[18px] font-black text-lg flex items-center justify-center gap-2 touch-manipulation active:scale-95 disabled:opacity-50"
      style={{ ...neonSurface(accent, 32), ...neonText(accent) }}
    >
      {submitting ? <Loader2 className="w-5 h-5 animate-spin" /> : label}
    </button>
  );

  const skip = (label, onClick, testId) => (
    <button
      type="button"
      data-testid={testId}
      onClick={onClick}
      disabled={submitting}
      className="w-full min-h-[44px] mt-2 font-extrabold text-[15px] text-purple-100/80"
    >
      {label}
    </button>
  );

  const header = step !== 'done' && (
    <div className="flex items-center justify-between">
      <button
        type="button"
        aria-label="Back"
        data-testid="signup-back"
        onClick={back}
        className="w-11 h-11 rounded-[14px] border-2 border-white/20 flex items-center justify-center text-white"
      >
        <ChevronLeft className="w-5 h-5" />
      </button>
      <div className="flex gap-2" aria-label={`Step ${index + 1} of ${order.length}`} data-testid="signup-progress">
        {order.map((s, i) => (
          <span
            key={s}
            className="h-2 rounded"
            style={{
              width: i === index ? 26 : 8,
              background: i <= index ? STEP_ACCENT[s] : 'rgba(255,255,255,0.18)',
              boxShadow: i === index ? `0 0 10px ${STEP_ACCENT[s]}` : 'none',
            }}
          />
        ))}
      </div>
      {step === 'email' || step === 'referral' || step === 'country' ? (
        <button
          type="button"
          data-testid="signup-skip-top"
          onClick={() => {
            if (step === 'country') create();
            else if (addingEmail) leaveAddEmail();
            else if (step === 'email') go(afterEmail);
            else if (step === 'referral') { setReferrer(''); go('country'); }
            else go('country');
          }}
          className="min-w-[44px] min-h-[44px] text-right font-extrabold text-[15px] text-purple-100/80"
        >
          Skip
        </button>
      ) : <div className="w-11" />}
    </div>
  );

  const eyebrow = (text) => (
    <div className="mt-10 text-[13px] font-extrabold tracking-[0.2em]" style={{ color: accent }}>{text}</div>
  );

  let body;
  if (step === 'username') {
    body = (
      <>
        {eyebrow(stepOf())}
        <h1 className="mt-2 text-[30px] font-black leading-tight">Pick a username</h1>
        <p className="mt-2 text-[15px] leading-snug text-purple-100/80">It’s how you’ll show up on the podium and leaderboards — and how you log in.</p>
        <label htmlFor="signup-username" className="mt-7 block text-[13px] font-extrabold text-purple-200/70">Username</label>
        <div className="mt-2 flex items-center gap-2 min-h-[58px] px-4 rounded-2xl" style={neonField(accent)}>
          <input
            id="signup-username"
            ref={inputRef}
            data-testid="signup-username"
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            onKeyDown={(e) => { if (e.key === 'Enter' && usernameOk) go('password'); }}
            autoComplete="username"
            autoCapitalize="none"
            spellCheck={false}
            className="flex-1 min-w-0 bg-transparent outline-none text-white text-[19px] font-extrabold"
          />
          {nameState.status === 'checking' && <Loader2 className="w-5 h-5 animate-spin text-purple-200" />}
          {nameState.status === 'available' && <Check className="w-5 h-5" style={{ color: accent }} />}
        </div>
        <div className="mt-2 text-[13px] font-bold min-h-[18px]" data-testid="signup-username-status">
          {nameState.status === 'available' && <span style={{ color: accent }}>{nameState.name} is available</span>}
          {nameState.status === 'taken' && (
            <span className="text-red-300">
              That name is taken.{' '}
              {onLogin && <button type="button" onClick={onLogin} className="underline text-cyan-200">It’s mine — log in</button>}
            </span>
          )}
          {nameState.status === 'invalid' && <span className="text-red-300">{nameState.message}</span>}
          {errorHere && <span className="text-red-300" role="alert">{errorHere}</span>}
        </div>
        <div className="mt-1 text-xs text-purple-200/60">3–20 letters, numbers, - or _</div>
        <button
          type="button"
          data-testid="signup-shuffle"
          onClick={onShuffle}
          className="mt-5 self-start min-h-[44px] px-4 rounded-[14px] border-2 font-extrabold text-[15px] flex items-center gap-2"
          style={{ borderColor: 'color-mix(in srgb, var(--u37-violet) 60%, transparent)', background: 'color-mix(in srgb, var(--u37-violet) 12%, transparent)', color: '#e3c9ff' }}
        >
          <Shuffle className="w-4 h-4" /> Shuffle a fun name
        </button>
        <div className="flex-1" />
        {primary('Next', () => go('password'), !usernameOk)}
      </>
    );
  } else if (step === 'password') {
    body = (
      <>
        {eyebrow(stepOf())}
        <h1 className="mt-2 text-[30px] font-black leading-tight">Choose a password</h1>
        <p className="mt-2 text-[15px] leading-snug text-purple-100/80">
          You’ll use <span className="font-extrabold text-white">{username.trim()}</span> and this password to log in on any device.
        </p>
        <label htmlFor="signup-password" className="mt-7 block text-[13px] font-extrabold text-purple-200/70">Password</label>
        <div className="mt-2 flex items-center gap-2 min-h-[58px] pl-4 pr-2 rounded-2xl" style={neonField(accent)}>
          {/* A hidden username field so password managers save the pair. */}
          <input type="text" autoComplete="username" value={username.trim()} readOnly hidden aria-hidden="true" />
          <input
            id="signup-password"
            ref={inputRef}
            data-testid="signup-password"
            type={showPassword ? 'text' : 'password'}
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            onKeyDown={(e) => { if (e.key === 'Enter' && passwordOk) go('age'); }}
            autoComplete="new-password"
            className="flex-1 min-w-0 bg-transparent outline-none text-white text-[19px] font-extrabold"
          />
          <button
            type="button"
            data-testid="signup-password-eye"
            aria-label={showPassword ? 'Hide password' : 'Show password'}
            onClick={() => setShowPassword((v) => !v)}
            className="w-11 h-11 rounded-xl flex items-center justify-center"
            style={{ color: accent, background: 'color-mix(in srgb, var(--u37-cyan) 12%, transparent)' }}
          >
            {showPassword ? <EyeOff className="w-5 h-5" /> : <Eye className="w-5 h-5" />}
          </button>
        </div>
        <div className="mt-2 flex items-center gap-2 text-[13px] font-bold" style={{ color: passwordOk ? 'var(--u37-green)' : 'rgb(196 181 253 / 0.7)' }}>
          <Check className="w-4 h-4" /> At least {MIN_PASSWORD_LEN} characters
        </div>
        {errorHere && <div className="mt-2 text-[13px] font-bold text-red-300" role="alert">{errorHere}</div>}
        <p className="mt-3 text-[13px] text-purple-200/60">Tap the eye to check what you typed — no need to type it twice.</p>
        <div className="flex-1" />
        {primary('Next', () => go('age'), !passwordOk)}
      </>
    );
  } else if (step === 'age') {
    const answer = (value) => { setEligible(value); go('email'); };
    body = (
      <>
        {eyebrow(`${stepOf()} · ONE QUICK QUESTION`)}
        <h1 className="mt-2 text-[28px] font-black leading-tight">Are you 18 or older and living in the United States?</h1>
        <div className="mt-5 p-4 rounded-2xl border-2" style={{ borderColor: 'color-mix(in srgb, var(--u37-green) 55%, transparent)', background: 'color-mix(in srgb, var(--u37-green) 7%, transparent)' }}>
          <div className="flex items-center gap-2 font-black text-base" style={{ color: 'var(--u37-green)' }}>
            <Shield className="w-5 h-5" /> {CONTEST_AGE_REASSURANCE.head}
          </div>
          <p className="mt-2 text-sm leading-relaxed text-emerald-50/90">
            {CONTEST_AGE_REASSURANCE.body}
          </p>
        </div>
        {/* Equal buttons, neither preselected: there is no "right" answer to
            steer toward (FTC guidance on age screens; design research). */}
        <div className="mt-6 grid grid-cols-2 gap-3">
          <button type="button" data-testid="signup-age-yes" aria-pressed={eligible === true} onClick={() => answer(true)}
            className="min-h-[64px] rounded-[18px] border-[3px] border-white/55 bg-[#0e1230] text-white text-xl font-black">Yes</button>
          <button type="button" data-testid="signup-age-no" aria-pressed={eligible === false} onClick={() => answer(false)}
            className="min-h-[64px] rounded-[18px] border-[3px] border-white/55 bg-[#0e1230] text-white text-xl font-black">No</button>
        </div>
        <p className="mt-3 text-center text-[13px] text-purple-200/70">{CONTEST_AGE_REASSURANCE.foot}</p>
        <div className="flex-1" />
      </>
    );
  } else if (step === 'email') {
    body = (
      <>
        {eyebrow(addingEmail ? 'YOUR ACCOUNT IS SAVED' : `${stepOf()} · OPTIONAL`)}
        <h1 className="mt-2 text-[30px] font-black leading-tight">Add your email</h1>
        {eligible ? (
          <div className="mt-3 px-4 py-3 rounded-2xl border-2 text-sm leading-relaxed" style={{ borderColor: 'color-mix(in srgb, var(--u37-gold) 60%, transparent)', background: 'color-mix(in srgb, var(--u37-gold) 8%, transparent)', color: '#fff2c8' }} data-testid="signup-email-why">
            {/* Was "This is how we'd pay you." — wrong: prizes are paid by Venmo/Zelle
                (CONTEST_PAYMENT); email is how a winner is CONTACTED. Fixed 2026-10-18. */}
            <span className="font-black" style={{ color: 'var(--u37-gold)' }}>Winners are contacted by email</span> — you need one to be entered.
          </div>
        ) : (
          <p className="mt-3 text-[15px] leading-snug text-purple-100/80" data-testid="signup-email-why">So you can reset your password if you ever forget it.</p>
        )}
        {eligible && <p className="mt-3 text-sm text-purple-100/80">Also resets your password.</p>}
        <label htmlFor="signup-email" className="mt-6 block text-[13px] font-extrabold text-purple-200/70">Email</label>
        <div className="mt-2 flex items-center min-h-[58px] px-4 rounded-2xl" style={neonField(accent)}>
          <input
            id="signup-email"
            ref={inputRef}
            data-testid="signup-email"
            type="email"
            inputMode="email"
            value={email}
            placeholder="you@example.com"
            onChange={(e) => setEmail(e.target.value)}
            onKeyDown={(e) => { if (e.key === 'Enter' && emailOk) emailNext(); }}
            autoComplete="email"
            autoCapitalize="none"
            className="flex-1 min-w-0 bg-transparent outline-none text-white text-lg font-bold placeholder:text-purple-200/40"
          />
        </div>
        {!emailOk && <div className="mt-2 text-[13px] font-bold text-red-300">That email address looks invalid.</div>}
        {errorHere && <div className="mt-2 text-[13px] font-bold text-red-300" role="alert">{errorHere}</div>}
        <div className="flex-1" />
        {addingEmail
          ? primary('Save email', saveEmail, !email.trim() || !emailOk, 'signup-save-email')
          : primary('Next', () => go(afterEmail), !emailOk)}
        {addingEmail
          ? skip('Not now', leaveAddEmail, 'signup-skip')
          : skip('Skip for now', () => { setEmail(''); go(afterEmail); }, 'signup-skip')}
      </>
    );
  } else if (step === 'referral') {
    body = (
      <>
        {eyebrow(`${stepOf()} · OPTIONAL`)}
        <h1 className="mt-2 text-[30px] font-black leading-tight">{REFERRAL_COPY.stepTitle}</h1>
        <p className="mt-2 text-[15px] leading-snug text-purple-100/80">{REFERRAL_COPY.stepBody}</p>
        <label htmlFor="signup-referrer" className="mt-6 block text-[13px] font-extrabold text-purple-200/70">{REFERRAL_COPY.stepLabel}</label>
        <div className="mt-2 flex items-center min-h-[58px] px-4 rounded-2xl" style={neonField(accent)}>
          <span className="text-lg font-black text-purple-200/60" aria-hidden="true">@</span>
          <input
            id="signup-referrer"
            ref={inputRef}
            data-testid="signup-referrer"
            value={referrer}
            placeholder={REFERRAL_COPY.stepPlaceholder}
            onChange={(e) => setReferrer(e.target.value)}
            onKeyDown={(e) => { if (e.key === 'Enter') go('country'); }}
            autoComplete="off"
            autoCapitalize="none"
            spellCheck={false}
            className="flex-1 min-w-0 bg-transparent outline-none text-white text-lg font-bold placeholder:text-purple-200/40"
          />
        </div>
        <div className="flex-1" />
        {primary('Next', () => go('country'))}
        {skip('Skip', () => { setReferrer(''); go('country'); }, 'signup-skip')}
      </>
    );
  } else if (step === 'country') {
    body = (
      <>
        {eyebrow(`${stepOf()} · OPTIONAL`)}
        <h1 className="mt-2 text-[30px] font-black leading-tight">Where are you playing from?</h1>
        <p className="mt-2 text-[15px] leading-snug text-purple-100/80">Puts your flag next to your name and adds you to your country’s National Average.</p>
        <label htmlFor="signup-country" className="mt-6 block text-[13px] font-extrabold text-purple-200/70">Country</label>
        <div className="mt-2 flex items-center gap-2 min-h-[58px] px-4 rounded-2xl" style={neonField(accent)}>
          <Search className="w-5 h-5 text-pink-300" />
          <input
            id="signup-country"
            ref={inputRef}
            data-testid="signup-country-search"
            value={countryQuery}
            placeholder="Search countries"
            onChange={(e) => setCountryQuery(e.target.value)}
            autoComplete="country-name"
            className="flex-1 min-w-0 bg-transparent outline-none text-white text-lg font-bold placeholder:text-purple-200/40"
          />
        </div>
        <div className="mt-3 flex flex-col gap-2 overflow-y-auto" role="listbox" aria-label="Countries">
          {filteredCountries.map((c) => (
            <button
              key={c.code}
              type="button"
              role="option"
              aria-selected={country === c.code}
              data-testid={`signup-country-${c.code}`}
              onClick={() => setCountry(country === c.code ? '' : c.code)}
              className="min-h-[52px] px-4 rounded-[14px] border-2 text-left font-bold"
              style={country === c.code
                ? { borderColor: accent, background: 'color-mix(in srgb, var(--u37-magenta) 12%, transparent)', color: 'white' }
                : { borderColor: 'rgba(255,255,255,0.14)', background: 'var(--u37-panel-bg-cosmic)', color: 'rgb(231 226 255)' }}
            >
              {c.name}
            </button>
          ))}
        </div>
        {errorHere && <div className="mt-2 text-[13px] font-bold text-red-300" role="alert">{errorHere}</div>}
        <div className="flex-1" />
        {primary('Create my account', create, false, 'signup-create')}
        {skip('Skip and create account', () => { setCountry(''); create(); }, 'signup-skip')}
      </>
    );
  } else {
    const entered = eligible && savedEmail.trim();
    // The gold giveaway box. Only a Yes to 18+/US ever sees it (a No hides all
    // contest UI). Missing email is the one fixable gap, so only then is the box
    // a button — back to the email step (David, 2026-10-20). A new email the
    // server says is not verified yet makes it a "Verify now" button instead
    // (SignupGiveawayBox, 2026-10-22).
    const canAddEmail = eligible && !entered && !emailPending;
    body = (
      <div className="flex flex-col items-center text-center flex-1 pt-6" data-testid="signup-done">
        <div className="w-[104px] h-[104px] rounded-full flex items-center justify-center" style={neonSurface('var(--u37-green)', 25)}>
          <Check className="w-12 h-12 text-white" />
        </div>
        <h1 className="mt-6 text-[30px] font-black">Welcome, {username.trim()}!</h1>
        <p className="mt-2 text-[15px] text-purple-100/80">Your account is saved. Everything is unlocked:</p>
        <div className="mt-5 w-full grid grid-cols-2 gap-2 text-left text-sm font-extrabold">
          {[
            ['Today’s podium', 'var(--u37-green)'],
            ['Streaks & stats', 'var(--u37-cyan)'],
            ['Blitz battles', 'var(--u37-magenta)'],
            ['Friends & badges', 'var(--u37-violet)'],
          ].map(([label, c]) => (
            <div key={label} className="p-3.5 rounded-2xl border-2" style={{ borderColor: `color-mix(in srgb, ${c} 50%, transparent)`, background: `color-mix(in srgb, ${c} 7%, transparent)` }}>{label}</div>
          ))}
        </div>
        {eligible && (
          <SignupGiveawayBox
            user={createdUser}
            entered={Boolean(entered)}
            emailPending={emailPending}
            canAddEmail={Boolean(canAddEmail)}
            onAddEmail={startAddEmail}
            deps={deps.giveaway}
          />
        )}
        {referralResult && (
          <p
            data-testid="signup-done-referral"
            data-ok={String(referralResult.ok === true)}
            className={`mt-3 w-full text-left text-[13px] font-bold ${referralResult.ok ? 'text-emerald-200' : 'text-amber-200'}`}
          >
            {referralResult.ok
              ? referralSavedMessage(referralResult.username)
              : `${REFERRAL_MESSAGES[referralResult.reason] || REFERRAL_MESSAGES.network} ${REFERRAL_COPY.fixInProfile}`}
          </p>
        )}
        <div className="flex-1" />
        <button
          type="button"
          data-testid="signup-play"
          onClick={() => onDone(createdUser, { eligible: eligible === true, email: savedEmail.trim() })}
          className="w-full min-h-[58px] rounded-[18px] font-black text-lg"
          style={{ ...neonSurface('var(--u37-green)', 32), ...neonText('var(--u37-green)') }}
        >
          Let’s play
        </button>
      </div>
    );
  }

  const screen = (
    <div
      role="dialog"
      aria-modal="true"
      aria-label="Create your free account"
      data-testid="guided-signup"
      className="fixed inset-0 z-[200] text-white overflow-y-auto"
      style={{ background: 'radial-gradient(120% 70% at 50% 0%, #1b1150 0%, #0a0a1f 55%, #050311 100%)' }}
    >
      <div
        className="min-h-full w-full max-w-md mx-auto px-6 flex flex-col"
        style={{ paddingTop: 'calc(var(--safe-top) + 1.5rem)', paddingBottom: 'calc(var(--safe-bottom) + var(--ad-reserved-bottom) + 1.5rem)' }}
      >
        {header}
        {body}
      </div>
    </div>
  );

  return typeof document !== 'undefined' ? createPortal(screen, document.body) : screen;
}
