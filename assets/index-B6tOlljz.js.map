import { useMemo } from 'react';
import './Starfield.css';

// Animated starfield background (Foundation slice F1). Pure CSS + DOM, behind all
// content. FIXED TIERS: fewer stars on small screens; honors prefers-reduced-motion
// (renders a calm static field). No canvas, no images, no native — CapGo-shippable.

// Desktop vs mobile star budgets (the "fixed tiers" decision).
const TIERS = {
  desktop: { far: 360, mid: 220, near: 88 },
  mobile: { far: 140, mid: 90, near: 36 },
};

function mql(query) {
  if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') return false;
  return window.matchMedia(query).matches;
}

function makeStars(count) {
  const stars = new Array(count);
  for (let i = 0; i < count; i++) {
    stars[i] = {
      left: (Math.random() * 100).toFixed(3) + '%',
      top: (Math.random() * 100).toFixed(3) + '%',
      tw: (3 + Math.random() * 4).toFixed(1) + 's',
      delay: (Math.random() * 5).toFixed(1) + 's',
    };
  }
  return stars;
}

function StarLayer({ cls, stars }) {
  return (
    <div className={`stars ${cls}`}>
      {stars.map((s, i) => (
        <span
          key={i}
          className="star"
          style={{ left: s.left, top: s.top, animationDuration: s.tw, animationDelay: s.delay }}
        />
      ))}
    </div>
  );
}

export default function Starfield() {
  // Resolve the tier + motion preference once, at mount.
  const { layers, reduced } = useMemo(() => {
    const tier = mql('(max-width: 768px)') ? TIERS.mobile : TIERS.desktop;
    return {
      reduced: mql('(prefers-reduced-motion: reduce)'),
      layers: {
        far: makeStars(tier.far),
        mid: makeStars(tier.mid),
        near: makeStars(tier.near),
      },
    };
  }, []);

  return (
    <div className={`starfield${reduced ? ' starfield--still' : ''}`} aria-hidden="true">
      <div className="cosmos" />
      <div className="galaxy" />
      <StarLayer cls="stars-far" stars={layers.far} />
      <StarLayer cls="stars-mid" stars={layers.mid} />
      <StarLayer cls="stars-near" stars={layers.near} />
    </div>
  );
}
