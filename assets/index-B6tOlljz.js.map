import { MODE_TIER_LABELS, modeOf } from '@/game-modes';

// The guest "you would have placed #N" nudge (David, 2026-10-20).
//
// WHO: a guest (no saved account) on any day AFTER their first day of play.
// WHEN: right after they close the results of their FIRST finished Daily of
//   that day — "whatever daily they do first should have the pop up for that
//   day". At most once per day.
// WHAT: that Daily's live rank on today's board, in David's words, and a
//   "Create free account" button (the app-wide `openSaveStats` flow).
//
// Day one is left alone on purpose: a brand-new guest already sees the locked
// "See where you placed" card on the result screen. This is the follow-up for
// someone who came BACK.

/** Per-device record of the last ET day the nudge showed, keyed by guest id. */
export const NUDGE_STORAGE_PREFIX = 'guestPlacementNudge.v1:';

/**
 * Should the nudge be looked up at all? (The rank read comes after this.)
 *
 * @param {{
 *   isGuest: boolean,
 *   firstToday: boolean,     // this close is the day's first finished Daily
 *   playedBeforeToday: boolean,
 *   lastShownDay: string | null,
 *   today: string,
 * }} p
 * @returns {boolean}
 */
export function shouldNudgeGuest({ isGuest, firstToday, playedBeforeToday, lastShownDay, today }) {
  if (!isGuest || !firstToday || !playedBeforeToday) return false;
  if (!today) return false;
  return lastShownDay !== today;
}

/** "Easy" / "Challenge" / "Expert" for a Daily wire key. */
export function dailyLabel(mode) {
  return MODE_TIER_LABELS[modeOf(mode)] || 'Daily';
}

/** 1 → "1st", 2 → "2nd", 11 → "11th", 23 → "23rd". */
export function ordinal(n) {
  const v = Math.abs(Math.trunc(n));
  const t = v % 100;
  if (t >= 11 && t <= 13) return `${v}th`;
  return `${v}${({ 1: 'st', 2: 'nd', 3: 'rd' })[v % 10] || 'th'}`;
}

/**
 * The nudge's words — David's copy, near-verbatim (2026-10-20).
 *
 * @param {{ guestName: string, rank: number, mode: string }} p
 * @returns {{ title: string, body: string, cta: string, dismiss: string }}
 */
export function guestNudgeCopy({ guestName, rank, mode }) {
  return {
    title: `Look, ${guestName}!`,
    body: `You would have placed ${ordinal(rank)} on today's ${dailyLabel(mode)} Daily leaderboard. `
      + 'Create a free username and password to see your stats daily, get friend requests, '
      + 'battle your friends in the Colosseum and so much more.',
    cta: 'Create free account',
    dismiss: 'Not now',
  };
}

/** The last ET day the nudge showed for this guest, or null. Never throws. */
export function readLastShownDay(userId, storage = globalThis.localStorage) {
  if (!userId) return null;
  try {
    return storage?.getItem(NUDGE_STORAGE_PREFIX + userId) || null;
  } catch {
    return null;
  }
}

/** Remember that the nudge showed today. Never throws. */
export function markShownDay(userId, day, storage = globalThis.localStorage) {
  if (!userId || !day) return;
  try {
    storage?.setItem(NUDGE_STORAGE_PREFIX + userId, day);
  } catch {
    // storage unavailable — at worst it shows again on the next first Daily today
  }
}
