// One read path for a player's head-to-head battles and their derived record.
//
// Before this module, ~8 sites independently ran
//   HeadToHeadChallenge.filter/list  →  filter by challenger_id||opponent_id
//   →  tally wins/losses/ties (and/or calculateBattlePoints)
// and had silently DIVERGED: HeadToHeadStats counted 'forfeited' (expired /
// abandoned) battles in its record, every other site counted only 'completed'.
// calculateBattlePoints itself only ever counts 'completed', so battle points
// were already consistent — the divergence inflated HeadToHeadStats's
// total-battles / win-rate with expired battles no other screen showed.
// See docs/bugs.md (the forfeited-divergence entry).
//
// The canonical record is COMPLETED ONLY. The includeForfeited option on the
// raw-list reads exists for callers that genuinely want the expired battles
// too (it defaults off); the derived record never counts them.
//
// Pure functions own the derivation (the test surface); the thin async
// wrappers own the fetch — mirroring resolveBattle.js's split.

import { apiClient } from '@/transport';
import { calculateBattlePoints } from '@/game-mechanics';
import { normalizeBlitzMode } from './blitzMode';

const COMPLETED_ONLY = ['completed'];
const COMPLETED_OR_FORFEITED = ['completed', 'forfeited'];

/**
 * Select the battles a given player took part in, by status.
 *
 * @param {Array<object>} challenges - raw HeadToHeadChallenge rows
 * @param {string} playerId
 * @param {{includeForfeited?: boolean}} [opts] - include 'forfeited' (expired)
 *   battles too; defaults to completed-only
 * @returns {Array<object>}
 */
export function selectPlayerBattles(challenges, playerId, { includeForfeited = false } = {}) {
  if (!playerId || !Array.isArray(challenges)) return [];
  const allowed = includeForfeited ? COMPLETED_OR_FORFEITED : COMPLETED_ONLY;
  return challenges.filter(
    (c) =>
      (c.challenger_id === playerId || c.opponent_id === playerId) &&
      allowed.includes(c.status)
  );
}

function emptyModeStats() {
  return { totalBattles: 0, wins: 0, losses: 0, ties: 0, totalPuzzlesSolved: 0, bestRun: 0 };
}

/**
 * Derive a player's battle record from raw challenge rows. Completed-only —
 * forfeited/expired battles never count toward the record (see module note).
 *
 * A battle counts as a win when winner_id === playerId, a loss when winner_id is
 * any other truthy id, and a tie when winner_id === null. A battle with an absent
 * (undefined) winner_id still counts toward totalBattles but lands in none of
 * w/l/t.
 *
 * ⚠️ THE TIE BUCKET IS ALL BUT UNREACHABLE, by design — do not read it as a
 * normal third outcome. `resolveBattleWinner` settles equal scores on the faster
 * single solve, and only returns null for a 0-0 game (the `myScore > 0` guard) or
 * when neither side has a usable fastest time. Verified against production on
 * 2026-09-10: of 60 completed battles, 60 have a winner and none has a null one.
 * The counter is kept because a 0-0 draw IS possible, not because it is expected.
 *
 * Mode bucketing is THREE-way, via `normalizeBlitzMode`: 'easy', 'challenge' and
 * 'expert' each get their own bucket, and anything unrecognised normalises to
 * 'easy'. (This JSDoc previously described the pre-blitzMode behaviour — a
 * two-way "easy vs everything-else" split that sent an unknown mode to
 * 'challenge'. The code has not done that since normalizeBlitzMode landed.)
 *
 * @param {Array<object>} challenges - raw rows (filtered internally)
 * @param {string} playerId
 * @returns {{
 *   totalBattles:number, wins:number, losses:number, ties:number,
 *   battlePoints:number,
 *   byMode:{ easy:object, challenge:object, expert:object }
 * }}
 */
export function derivePlayerBattleStats(challenges, playerId) {
  const battles = selectPlayerBattles(challenges, playerId, { includeForfeited: false });
  const byMode = { easy: emptyModeStats(), challenge: emptyModeStats(), expert: emptyModeStats() };

  for (const battle of battles) {
    const mode = normalizeBlitzMode(battle.blitz_mode);
    const isChallenger = battle.challenger_id === playerId;
    const myResult = isChallenger ? battle.challenger_result : battle.opponent_result;
    const puzzlesSolved = myResult?.total_solved || 0;

    const bucket = byMode[mode];
    bucket.totalBattles += 1;
    bucket.totalPuzzlesSolved += puzzlesSolved;
    bucket.bestRun = Math.max(bucket.bestRun, puzzlesSolved);

    if (battle.winner_id === playerId) {
      bucket.wins += 1;
    } else if (battle.winner_id === null) {
      bucket.ties += 1;
    } else if (battle.winner_id) {
      bucket.losses += 1;
    }
  }

  return {
    totalBattles: byMode.easy.totalBattles + byMode.challenge.totalBattles + byMode.expert.totalBattles,
    wins: byMode.easy.wins + byMode.challenge.wins + byMode.expert.wins,
    losses: byMode.easy.losses + byMode.challenge.losses + byMode.expert.losses,
    ties: byMode.easy.ties + byMode.challenge.ties + byMode.expert.ties,
    battlePoints: calculateBattlePoints(playerId, battles),
    byMode,
  };
}

/**
 * Build the battle-points leaderboard from all profiles + all challenges: each
 * player's battlePoints (off the one derive path) + puzzlePoints, drop players
 * with zero battle points, sort by battlePoints descending. Mirrors the inline
 * map/filter/sort BattlePointsLeaderboard used. Friend-only filtering is a
 * caller display concern and stays in the component. Intra-module (its only
 * consumer imports it via './playerBattles') — not barrel-exported, mirroring
 * derivePlayerBattleStats.
 *
 * @param {Array<object>} profiles - PublicProfile rows
 * @param {Array<object>} challenges - all completed HeadToHeadChallenge rows
 * @returns {Array<{id:string, username:string, country:string, battlePoints:number, puzzlePoints:number}>}
 */
export function selectBattlePointsLeaderboard(profiles, challenges) {
  return (profiles || [])
    .map((profile) => ({
      id: profile.id,
      username: profile.username,
      country: profile.country,
      battlePoints: derivePlayerBattleStats(challenges, profile.id).battlePoints,
      puzzlePoints: profile.puzzle_points || 0,
    }))
    .filter((player) => player.battlePoints > 0)
    .sort((a, b) => b.battlePoints - a.battlePoints);
}

/**
 * Fetch a player's battles. Completed-only fetches server-side (eq filter,
 * matching the legacy call sites); includeForfeited falls back to a full list
 * + client-side status filter because the entity client only supports equality.
 *
 * @param {string} playerId
 * @param {{includeForfeited?: boolean}} [opts]
 * @returns {Promise<Array<object>>}
 */
export async function getPlayerBattles(playerId, { includeForfeited = false } = {}) {
  if (!playerId) return [];
  if (includeForfeited) {
    const all = await apiClient.entities.HeadToHeadChallenge.list('-created_date');
    return selectPlayerBattles(all, playerId, { includeForfeited: true });
  }
  const completed = await apiClient.entities.HeadToHeadChallenge.filter({ status: 'completed' });
  return selectPlayerBattles(completed, playerId, { includeForfeited: false });
}

/**
 * Fetch + derive a player's completed-only battle record.
 *
 * @param {string} playerId
 * @returns {Promise<ReturnType<typeof derivePlayerBattleStats>>}
 */
export async function getPlayerBattleStats(playerId) {
  if (!playerId) return derivePlayerBattleStats([], playerId);
  const completed = await apiClient.entities.HeadToHeadChallenge.filter({ status: 'completed' });
  return derivePlayerBattleStats(completed, playerId);
}
