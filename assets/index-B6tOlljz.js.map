import React from 'react'
import ReactDOM from 'react-dom/client'
import { App } from '@/routing'
import { initSentry, AppErrorBoundary, track } from '@/observability'
import { notifyLiveUpdateReady, armSplashWatchdog } from '@/shell'
import { registerServiceWorker } from '@/web-deploy/registerServiceWorker'
import '@/index.css'
import '@/ui/theme/tokens.css'

// Boot telemetry: ms from webview navigation start until this entry module's
// body executes = JS bundle download + parse time (independent of React mount).
// Pairs with the "notifyAppReady invoked at …" log in shell/liveUpdate.js so a
// real device's boot profile reads as: parse cost, then total time-to-ready.
// This is the cheapest way to see, per device + via Sentry breadcrumbs, how much
// of the Capgo rollback window the bundle parse alone is eating.
if (typeof performance !== 'undefined' && performance.now) {
  console.log(`[capgo] main.jsx body eval at ${Math.round(performance.now())}ms since nav start`);
}

// Initialize crash reporting before anything renders so early errors are caught.
// No-op unless VITE_SENTRY_DSN is set.
initSentry()
track('app.open')

// Tell Capgo the OTA bundle booted, AS EARLY AS POSSIBLE — at the JS entry
// point, before React mounts and before any network/auth call. Capgo rolls a
// freshly-applied bundle back to the previous one if notifyAppReady() isn't
// called within appReadyTimeout (a hard 30s floor on a bundle's first boot).
// Previously this fired deep in AuthenticatedApp's mount useEffect, so the whole
// provider tree (AuthProvider → QueryClient → Router) had to mount first; on
// slow devices that exceeded the window and HEALTHY bundles were rolled back.
// Firing here removes React mount time from the critical path entirely. A bundle
// that fails to parse/eval still never reaches this line, so a truly broken
// bundle still self-heals. Fire-and-forget: no-op on web, errors swallowed.
notifyLiveUpdateReady()

// Arm the dead-launch-screen watchdog BEFORE React mounts. `launchAutoHide` is
// false, so the native splash is dismissed only by an explicit hide() — and
// every hide() call site is downstream of a successful React render. If the
// tree throws on its first render the error fallback renders UNDERNEATH the
// splash and the user sees a static image that ignores every tap. App Review
// rejected 1.0.314 for exactly that. Arming here, at the entry point, is the
// only place that survives a failure anywhere in React.
armSplashWatchdog()

// Register the PWA service worker (web + production only; no-op on native and in
// dev — see web-deploy/registerServiceWorker.js). Makes the web build
// installable and gives it a network-first offline fallback.
registerServiceWorker()

ReactDOM.createRoot(document.getElementById('root')).render(
  // <React.StrictMode>
  <AppErrorBoundary>
    <App />
  </AppErrorBoundary>
  // </React.StrictMode>,
)

if (import.meta.hot) {
  import.meta.hot.on('vite:beforeUpdate', () => {
    window.parent?.postMessage({ type: 'sandbox:beforeUpdate' }, '*');
  });
  import.meta.hot.on('vite:afterUpdate', () => {
    window.parent?.postMessage({ type: 'sandbox:afterUpdate' }, '*');
  });
}



