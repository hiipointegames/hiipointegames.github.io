// The `.catch()` for App's automatic guest sign-in on `/`.
//
// That call is fire-and-forget, so before this existed a failure became an
// UNHANDLED promise rejection crash report (Sentry 37-THE-MATH-PUZZLE-1R). Most
// failures are just the player being offline: supabase-js turns a fetch that
// never reached the server into AuthRetryableFetchError with status 0. That is
// not a bug and the effect retries on the next visit to `/`, so it stays out of
// Sentry. Anything else (a 5xx, anonymous sign-ups switched off, a rate limit)
// is a real reason nobody can play, so it IS reported.
import { captureError } from '@/observability';

/** True when the request never reached Supabase (offline, DNS, dropped link). */
export function isOfflineAuthError(error) {
  return error?.name === 'AuthRetryableFetchError' && error?.status === 0;
}

export function handleGuestSignInFailure(error) {
  if (isOfflineAuthError(error)) return;
  captureError(error, { where: 'auth.guest' });
}
