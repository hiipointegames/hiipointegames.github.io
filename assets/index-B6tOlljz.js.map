import React, { useState, useEffect } from 'react';
import { Button } from '@/ui/primitives/button';
import { Input } from '@/ui/primitives/input';
import { Globe, Loader2, Lock, User, Eye, EyeOff, Mail } from 'lucide-react';
// Aliased: this component already has a `setUsername` state setter for the
// username input, and the two are entirely different things.
import { apiClient, resolveUsernameLogin, setUsername as setUsernameOnServer, supabase } from '@/transport';
import { validateUsername } from '@/components/utils/usernameValidation';
import { validatePassword } from '@/components/utils/passwordValidation';
import { isUsernameTaken } from '@/player';
import { isCredentialedAccount, hasContactableEmail, isEmailConfirmed } from '@/auth';
import { countries } from '@/components/profile/countries';
import { reportedFallback } from '@/observability';
import { ReferralProfileField } from '@/referrals';
import {
  CONTEST,
  CONTEST_AGE_QUESTION,
  CONTEST_AGE_YES,
  CONTEST_AGE_NO,
  CONTEST_AGE_REASSURANCE,
  CONTEST_ELIGIBILITY_META_KEY,
  contestAttestationPatch,
} from '@/contest';

// Shared account-creation form: username + password (+ confirm) + country.
//
// This is the ONE place a real account is born. Used by InitialWelcomeModal
// ("Create Account") and SaveStatsModal (a guest creating an account). Every
// account created here gets a username + password from the start. Email is
// OPTIONAL — when provided it becomes the account's recovery address so the
// user can reset their password (it is NOT a login identifier; login is always
// username + password). Omitted → a synthetic internal email and no self-service
// reset. The account is created by claiming the user's current anonymous account
// in place via resolve-username-login, preserving the user id.
//
// RECOVER FLOW (bug #1): if the chosen username already belongs to a DIFFERENT
// account — typically the player's own legacy account returning under a fresh
// anonymous id — we don't force a rename (which orphaned their history). We offer
// an explicit "recover it" confirm that claims/signs into the OWNING account:
//   • unsecured legacy account  → set the password, restore history in place;
//   • already-protected account → require the owner to sign in (never overwrite).

export default function CreateAccountForm({ onSuccess, submitLabel = 'Create Account & Start Playing' }) {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [email, setEmail] = useState('');
  const [country, setCountry] = useState('');
  const [showCountrySelector, setShowCountrySelector] = useState(false);
  // The giveaway eligibility ANSWER. null = not answered yet. OPTIONAL since
  // 2026-09-17 (see "NO GATE HERE" in handleCreate) — a skip saves nothing.
  //
  // ⚠️ IT WAS AN OPTIONAL TICK BOX UNTIL 2026-09-17, and the change is David's.
  // A tick can only ever record a yes, so "said no" and "never noticed it" were
  // the same absence — which meant a player who had decided not to enter got
  // nagged after every single Daily, for ever, because nothing recorded the
  // decision. Asking as a required question is what makes a no possible.
  //
  // Required, but NOT required-to-be-yes: either answer completes the form. See
  // CONTEST_AGE_REASSURANCE for why that has to be visible on screen.
  const [eligibleAnswer, setEligibleAnswer] = useState(/** @type {boolean|null} */ (null));
  const [showPassword, setShowPassword] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  // Set only for a CONTENT rejection, which may be wrong about a real name.
  // A format rejection is the player's to fix and needs no appeal.
  const [appealHref, setAppealHref] = useState(null);
  // Recover-an-existing-account flow (bug #1 fix). When the chosen username is
  // already owned by ANOTHER account — almost always the player's OWN legacy
  // account returning under a fresh anonymous id (reinstall / cleared storage) —
  // we no longer dead-end with "pick another" (which forced a rename and
  // ORPHANED their history). Instead we offer to recover that account.
  //   takenUsername  → the owned name; non-null puts the form in recover mode.
  //   securedLocked  → that account already has a password; the one we tried
  //                    didn't match, so the real owner must sign in (we never
  //                    overwrite a protected account's password).
  const [takenUsername, setTakenUsername] = useState(null);
  const [securedLocked, setSecuredLocked] = useState(false);

  // ⚠️ ONE SCREEN, TWO JOBS (David, 2026-09-17): "that is the only page that
  // should be seen when editing or creating or adding info to an account, no
  // matter how it is accessed."
  //
  // `editing` is true when the account is ALREADY secured — it has a password,
  // so there is nothing to claim. It changes three things and nothing else: the
  // password stops being required, the submit takes the edit path below, and
  // the button stops saying "Create".
  const [editing, setEditing] = useState(false);

  // ⚠️ CARRIED OVER FROM AddEmailPrompt, WHICH THIS SCREEN REPLACES.
  // `updateUser({ email })` RESOLVING DOES NOT MEAN THE ADDRESS IS LIVE: under a
  // confirmation flow the change is staged until the player clicks a link, and
  // `user.email` still holds the old value. That distinction is not cosmetic
  // here — a pending address is not contactable, so the player is NOT eligible
  // for the giveaway, and telling them it saved would be the exact false
  // reassurance the eligibility panel exists to prevent.
  const [emailPending, setEmailPending] = useState(false);

  // Whether the address ALREADY on the account has been proven to be theirs.
  // Status only — it never affects whether the form submits, and never affects
  // eligibility. See isEmailConfirmed for why that restraint is deliberate.
  const [emailUnconfirmed, setEmailUnconfirmed] = useState(false);
  const [resendState, setResendState] = useState('idle');

  // Pre-fill from the current account so a legacy named user securing an
  // EXISTING account doesn't have to retype their username or re-pick their
  // country — the only field they need to add is a password. A fresh guest has
  // neither, so nothing pre-fills and the form behaves exactly as before.
  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const me = await apiClient.auth.me();
        if (cancelled || !me) return;
        // Read from user_metadata (the canonical home; me() also promotes these
        // to top level, but user_metadata is the typed index-signature source).
        const meta = me.user_metadata || {};
        if (meta.has_custom_username && meta.username) setUsername(meta.username);
        if (meta.country) setCountry(meta.country);
        // A REAL email only. Accounts claimed without one carry a synthetic
        // internal address, and pre-filling that would show the player an
        // address they never chose and invite them to "keep" it.
        if (hasContactableEmail(me)) setEmail(me.email);
        // Their existing answer, so the form states where they actually stand
        // rather than presenting an answered question as unanswered.
        const recorded = (meta[CONTEST_ELIGIBILITY_META_KEY] || {}).confirmed_18_us;
        if (typeof recorded === 'boolean') setEligibleAnswer(recorded);
        setEditing(isCredentialedAccount(me));
        setEmailUnconfirmed(hasContactableEmail(me) && !isEmailConfirmed(me));
      } catch { /* non-fatal — the form still works empty */ }
    })();
    return () => { cancelled = true; };
  }, []);

  const handleCreate = async () => {
    setError('');

    setAppealHref(null);
    const validation = validateUsername(username);
    if (!validation.valid) {
      setError(validation.error);
      setAppealHref(validation.appealHref ?? null);
      return;
    }
    // ⚠️ BLANK MEANS "LEAVE IT ALONE" WHEN EDITING, and only when editing.
    // Forcing someone to retype a password to add an email is the friction that
    // split this into three forms in the first place. A guest still must set
    // one — there is no account without it.
    if (!editing || password) {
      const pwCheck = validatePassword(password);
      if (!pwCheck.valid) { setError(pwCheck.error); return; }
      if (password !== confirmPassword) { setError('Passwords do not match'); return; }
    }
    const trimmedEmail = email.trim();
    if (trimmedEmail && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(trimmedEmail)) {
      setError('That email address looks invalid (or leave it blank).');
      return;
    }
    // ⚠️ NO GATE HERE, DELIBERATELY (David, 2026-09-17, on beta 1.0.311).
    //
    // This used to refuse the form when `eligibleAnswer === null`. He hit it
    // creating an account with no email, no country and no answer, and ruled it
    // optional. Three reasons it is the right call, beyond the friction:
    //
    //  1. IT WAS THE ONLY REQUIRED FIELD ON AN OTHERWISE OPTIONAL FORM. Email is
    //     optional, country is optional — and then a giveaway question blocked
    //     the account. That ordering says the giveaway matters more than the
    //     player, which is backwards.
    //
    //  2. THE TRI-STATE ALREADY HANDLES "NEVER ANSWERED". contestEntryState
    //     returns kind 'confirm' for it and the chip says "Tap to turn on your
    //     entries". The unanswered case was designed for and then made
    //     unreachable from this form.
    //
    //  3. ⚠️ IT STRENGTHENS THE COPPA POSITION. The comment on the question
    //     below insists this is NOT an age screen. A REQUIRED age question
    //     standing between a player and their account looks a great deal more
    //     like an age gate than an optional one does — the app is rated 13+ and
    //     has no age gate anywhere, and that is the posture we want to keep.
    //
    // Leaving it unanswered simply means no entries until they answer, which is
    // the same place a declined player is, and it is reversible.

    setLoading(true);
    try {
      const currentUser = await apiClient.auth.me();
      const finalUsername = validation.formatted;

      if (await isUsernameTaken(finalUsername, currentUser?.id)) {
        // The name belongs to a DIFFERENT account. Rather than force a rename
        // (which secured a new empty account and orphaned the player's history —
        // bug #1), divert into the explicit recover flow. No pre-write to the
        // current anonymous account has happened yet, so nothing to unwind.
        setTakenUsername(finalUsername);
        setLoading(false);
        return;
      }

      // 1) Mark the welcome modal seen. This is the ONLY thing still written
      //    from the client on this path — the username and country moved to
      //    set-username below.
      await apiClient.auth.updateMe({
        game_stats: {
          ...(currentUser?.user_metadata?.game_stats || {}),
          hasSeenInitialWelcomeModal: true,
        },
        // The giveaway affirmation rides along on the write that is already
        // happening here rather than getting its own call. It has to be on
        // THIS one specifically: steps 2 and 3 below hand the account to the
        // server to be named and claimed, and this metadata write is the
        // established pattern that survives that (hasSeenInitialWelcomeModal
        // has been making the same trip since before the contest existed).
        //
        // Written only when ANSWERED and CHANGED (2026-10-05, two bugs — see
        // @/contest attestationPatch): a skip used to be saved as a "No", and
        // every save re-stamped an unchanged "Yes" with a later confirmed_at,
        // which drops that day's earlier entries (not retroactive). A real No
        // is still recorded, so other surfaces stop asking a player who said it.
        ...contestAttestationPatch(eligibleAnswer, currentUser),
      });

      // ⚠️ THE EDIT PATH STOPS BEFORE STEP 3, AND THAT IS THE WHOLE POINT.
      // Step 3 CLAIMS AN ANONYMOUS ACCOUNT — it sets the email and password on
      // an unclaimed one and hands back a session. Running it against an account
      // that is already secured is not "updating a profile"; it is re-claiming a
      // claimed account, and it is the one call in this file that could cost
      // somebody their login. So an already-secured account never reaches it:
      // name and country through the same server call as everyone else, then
      // email and password individually, and only when they actually changed.
      if (editing) {
        const named = await setUsernameOnServer(finalUsername, country);
        if (!named.success) {
          throw new Error(named.error?.message || 'Could not save your name.');
        }
        // Only when it actually changed — an unchanged address would otherwise
        // trigger Supabase's confirmation mail every time they saved anything.
        if (trimmedEmail && trimmedEmail !== (currentUser?.email || '')) {
          const { error: emailErr } = await supabase.auth.updateUser({ email: trimmedEmail });
          if (emailErr) throw emailErr;
          // THE READ-BACK. See emailPending above for why resolving is not proof.
          //
          // ⚠️ THE TEST IS "DID IT BECOME THE ONE THEY TYPED", NOT "IS THERE A
          // REAL EMAIL NOW". I wrote it the second way first and a test caught
          // it: hasContactableEmail only asks whether the address is
          // non-synthetic, which stays TRUE the whole time someone is CHANGING
          // one real address to another — so a pending change would have
          // reported as saved. It only worked for the add-an-email case, which
          // is the only case the modal this replaced ever had to handle.
          const { data: after } = await supabase.auth.getUser();
          if (after?.user?.email !== trimmedEmail) {
            setEmailPending(true);
            setLoading(false);
            // Deliberately NOT closing: this is the one outcome the player has
            // to act on, and it is invisible everywhere else until they do.
            window.dispatchEvent(new CustomEvent('userProfileUpdated', {
              detail: await apiClient.auth.me().catch(reportedFallback('account.me')),
            }));
            return;
          }
        }
        if (password) {
          const { error: pwErr } = await supabase.auth.updateUser({ password });
          if (pwErr) throw pwErr;
        }
        setLoading(false);
        const refreshed = await apiClient.auth.me().catch(reportedFallback('account.me'));
        window.dispatchEvent(new CustomEvent('userProfileUpdated', { detail: refreshed }));
        onSuccess?.(refreshed);
        return;
      }

      // 2) Set the name SERVER-SIDE. This writes auth metadata, the public
      //    profile row (which step 3 needs in order to resolve the username),
      //    and cascades onto historical leaderboard rows — one call replacing
      //    what used to be `updateMe` + `syncPublicProfile` here.
      //
      //    It also re-runs the format and moderation rules. The client check
      //    above is for immediate feedback; this is the authority. Before
      //    2026-09-06 there was no authority at all: `authenticated` holds
      //    UPDATE on `profiles.username`, so the only content check in the
      //    project could be skipped by not being a browser.
      const named = await setUsernameOnServer(finalUsername, country);
      if (!named.success) {
        throw new Error(named.error?.message || 'Could not save your name.');
      }

      // 3) Claim this same anonymous account with the chosen password (server
      //    sets the email — the provided recovery email, or a synthetic internal
      //    one — plus password, and returns a session).
      const result = await resolveUsernameLogin(finalUsername, password, trimmedEmail);
      if (!result.success) {
        throw new Error(result.error?.message || 'Could not secure your account.');
      }
      await finishSession(result.data.session, await apiClient.auth.me().catch(reportedFallback('account.me')));
    } catch (err) {
      console.error('Create account failed:', err);
      setError(err.message || 'Failed to create account. Please try again.');
      setLoading(false);
    }
  };

  // Establish the returned session and hand control back. Shared by the normal
  // claim path and the recover paths — whichever account we ended up on, this
  // is how we log the user into it.
  const finishSession = async (session, userForSuccess) => {
    const { data, error: setErr } = await supabase.auth.setSession({
      access_token: session.access_token,
      refresh_token: session.refresh_token,
    });
    if (setErr) throw setErr;
    setLoading(false);
    const resolvedUser = userForSuccess ?? data?.user ?? null;
    window.dispatchEvent(new CustomEvent('userProfileUpdated', { detail: resolvedUser }));
    onSuccess?.(resolvedUser);
  };

  // Recover the account that OWNS the taken username. For an unsecured legacy
  // account this SETS the (already strength-validated) password on it and returns
  // its session — the player's whole history comes back in place, on the original
  // user id. We deliberately do NOT write the username onto the current anonymous
  // account first (that would collide on the unique index) — resolve-username-login
  // resolves straight to the owning account.
  const handleRecover = async () => {
    setError('');
    setLoading(true);
    try {
      const result = await resolveUsernameLogin(takenUsername, password, email.trim());
      if (!result.success) {
        if (result.error?.code === 'invalid_credentials') {
          // The account already has a (different) password → it's protected. We
          // never overwrite it; the owner must prove ownership by signing in.
          setSecuredLocked(true);
          setLoading(false);
          return;
        }
        throw new Error(result.error?.message || 'Could not recover your account.');
      }
      await finishSession(result.data.session);
    } catch (err) {
      console.error('Recover account failed:', err);
      setError(err.message || 'Could not recover your account. Please try again.');
      setLoading(false);
    }
  };

  // Verify-only sign-in for an already-protected account. Sends whatever password
  // the owner types with NO strength gate — legacy passwords may predate the
  // strength rules, and resolve-username-login only verifies here (never
  // overwrites), so gating would lock real owners out of their own accounts.
  const handleSecuredSignIn = async () => {
    setError('');
    setLoading(true);
    try {
      const result = await resolveUsernameLogin(takenUsername, password);
      if (!result.success) {
        throw new Error("That password doesn't match. Try again, reset it by email from the Log In screen, or contact HiiPointe Games.");
      }
      await finishSession(result.data.session);
    } catch (err) {
      setError(err.message || 'Could not sign in. Please try again.');
      setLoading(false);
    }
  };

  // Abandon the recover flow and go back to picking a fresh (unused) name.
  const useDifferentName = () => {
    setTakenUsername(null);
    setSecuredLocked(false);
    setError('');
    setUsername('');
  };

  // ── Recover flow: the chosen username already belongs to an account ──────────
  // Already-protected account, wrong password → prove ownership by signing in.
  if (takenUsername && securedLocked) {
    return (
      <div className="space-y-4">
        <div className="rounded-xl p-4 bg-amber-500/10 border border-amber-400/30">
          <h3 className="text-white font-bold text-base mb-1 flex items-center gap-2">
            <Lock className="w-4 h-4 text-amber-300" /> This account is already protected
          </h3>
          <p className="text-sm text-purple-100/90">
            <span className="font-semibold text-white">{takenUsername}</span> already has a
            password. Enter it to sign in and bring your history back.
          </p>
        </div>

        <div>
          <label className="text-white text-sm mb-1.5 block font-semibold ml-1">Your password</label>
          <div className="relative">
            <div className="absolute left-3 top-3 text-slate-500"><Lock className="w-5 h-5" /></div>
            <Input
              type={showPassword ? 'text' : 'password'}
              value={password}
              onChange={(e) => { setPassword(e.target.value); setError(''); }}
              placeholder="Your existing password"
              className="bg-slate-800/70 border-purple-400/50 text-white placeholder:text-slate-500 rounded-xl h-11 pl-10 pr-11"
            />
            <button
              type="button"
              onClick={() => setShowPassword((v) => !v)}
              aria-label={showPassword ? 'Hide password' : 'Show password'}
              className="absolute right-3 top-2.5 p-1 text-slate-400 hover:text-purple-300"
            >
              {showPassword ? <EyeOff className="w-5 h-5" /> : <Eye className="w-5 h-5" />}
            </button>
          </div>
        </div>

        {error && <p className="text-red-300 text-sm ml-1 p-2 rounded-lg bg-red-500/10 border border-red-500/20">{error}</p>}

        <Button
          onClick={handleSecuredSignIn}
          disabled={loading}
          className="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold py-6 text-base shadow-xl min-h-[52px] touch-manipulation rounded-xl"
        >
          {loading ? <Loader2 className="w-5 h-5 animate-spin" /> : 'Sign In & Recover History'}
        </Button>

        <p className="text-xs text-slate-400 text-center px-2">
          Forgot it? Reset by email from the <span className="text-slate-200">Log In</span> screen, or{' '}
          <a href={`mailto:contactus@hiipointegames.com?subject=${encodeURIComponent(`Password reset for ${takenUsername}`)}`} className="text-cyan-300 underline">
            message HiiPointe Games
          </a>{' '}
          with your username and we'll reset it.
        </p>

        <button
          type="button"
          onClick={useDifferentName}
          className="w-full text-slate-400 hover:text-white font-medium text-sm transition-colors py-2"
        >
          Use a different name instead
        </button>
      </div>
    );
  }

  // Taken name → offer to recover it (explicit confirm, per product decision).
  if (takenUsername) {
    return (
      <div className="space-y-4">
        <div className="rounded-xl p-4 bg-purple-500/10 border border-purple-400/30">
          <h3 className="text-white font-bold text-base mb-1 flex items-center gap-2">
            <User className="w-4 h-4 text-purple-300" /> Is this your account?
          </h3>
          <p className="text-sm text-purple-100/90">
            The username <span className="font-semibold text-white">{takenUsername}</span> already
            exists. If it's your old account, recover it and{' '}
            <span className="font-semibold text-white">all your history comes back</span> — we'll
            secure it with the password you just entered.
          </p>
        </div>

        {error && <p className="text-red-300 text-sm ml-1 p-2 rounded-lg bg-red-500/10 border border-red-500/20">{error}</p>}

        <Button
          onClick={handleRecover}
          disabled={loading}
          className="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold py-6 text-base shadow-xl min-h-[52px] touch-manipulation rounded-xl"
        >
          {loading ? <Loader2 className="w-5 h-5 animate-spin" /> : `Recover ${takenUsername}`}
        </Button>

        <button
          type="button"
          onClick={useDifferentName}
          className="w-full text-slate-400 hover:text-white font-medium text-sm transition-colors py-2"
        >
          Not mine — use a different name
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-4">
      {/* Username */}
      <div>
        <label className="text-white text-sm mb-1.5 block font-semibold ml-1">Username</label>
        <div className="relative">
          <div className="absolute left-3 top-3 text-slate-500"><User className="w-5 h-5" /></div>
          <Input
            value={username}
            onChange={(e) => { setUsername(e.target.value); setError(''); setAppealHref(null); }}
            placeholder="Choose a username"
            className="bg-slate-800/70 border-purple-400/50 text-white placeholder:text-slate-500 rounded-xl h-11 pl-10"
          />
        </div>
        <p className="text-xs text-slate-400 mt-1 ml-1">3–20 letters, numbers, - or _</p>
      </div>

      {/* Password */}
      <div>
        <label className="text-white text-sm mb-1.5 block font-semibold ml-1">
          Password{editing && <span className="font-normal text-slate-400"> (optional)</span>}
        </label>
        {/* Said plainly, because a blank password box on an account that HAS a
            password is otherwise alarming — it reads as though the password was
            lost. */}
        {editing && (
          <p data-testid="password-optional-hint" className="text-xs text-slate-400 mb-1.5 ml-1">
            Leave blank to keep your current password.
          </p>
        )}
        <div className="relative">
          <div className="absolute left-3 top-3 text-slate-500"><Lock className="w-5 h-5" /></div>
          <Input
            type={showPassword ? 'text' : 'password'}
            value={password}
            onChange={(e) => { setPassword(e.target.value); setError(''); }}
            placeholder="Password"
            className="bg-slate-800/70 border-purple-400/50 text-white placeholder:text-slate-500 rounded-xl h-11 pl-10 pr-11"
          />
          <button
            type="button"
            onClick={() => setShowPassword((v) => !v)}
            aria-label={showPassword ? 'Hide password' : 'Show password'}
            className="absolute right-3 top-2.5 p-1 text-slate-400 hover:text-purple-300"
          >
            {showPassword ? <EyeOff className="w-5 h-5" /> : <Eye className="w-5 h-5" />}
          </button>
        </div>
        <p className="text-xs text-slate-400 mt-1 ml-1">At least 6 characters.</p>
      </div>

      {/* Confirm password */}
      <div>
        <label className="text-white text-sm mb-1.5 block font-semibold ml-1">Confirm Password</label>
        <div className="relative">
          <div className="absolute left-3 top-3 text-slate-500"><Lock className="w-5 h-5" /></div>
          <Input
            type={showPassword ? 'text' : 'password'}
            value={confirmPassword}
            onChange={(e) => { setConfirmPassword(e.target.value); setError(''); }}
            placeholder="Re-enter password"
            className="bg-slate-800/70 border-purple-400/50 text-white placeholder:text-slate-500 rounded-xl h-11 pl-10"
          />
        </div>
      </div>

      {/* Email — OPTIONAL TO SIGN UP, REQUIRED TO BE PAID.
          The official rules (quoted in @/contest contest.js) require "a custom
          username, a password, and an email address attached to the account, so
          that we can contact you for payment information". Before 2026-09-12 this
          field said "(optional)" with helper text about password resets and
          nothing else — so a player could sign up with no email, win the weekly
          giveaway, and be unpayable, having never been told. It stays optional
          (an account genuinely does not need one) and now says what it costs. */}
      <div>
        <label className="text-white text-sm mb-1.5 block font-semibold ml-1">
          Email <span className="text-slate-400 font-normal">(optional · needed to win the {CONTEST.prize} giveaway)</span>
        </label>
        <div className="relative">
          <div className="absolute left-3 top-3 text-slate-500"><Mail className="w-5 h-5" /></div>
          <Input
            type="email"
            value={email}
            onChange={(e) => { setEmail(e.target.value); setError(''); }}
            placeholder="you@example.com"
            className="bg-slate-800/70 border-purple-400/50 text-white placeholder:text-slate-500 rounded-xl h-11 pl-10"
          />
        </div>
        {/* Copy-condense 2026-10-18: the separate 🎁 "need an email to be paid"
            line repeated the label above; the "occasional updates" disclosure is
            KEPT on purpose. */}
        <p data-testid="email-helper" className="text-xs text-amber-300/80 mt-1 ml-1">
          For password resets (otherwise, contact us) and occasional updates.
        </p>
      </div>

      {/* Country */}
      <div>
        <label className="text-white text-sm mb-1.5 block font-semibold ml-1">
          Home Country <span className="text-slate-400 font-normal">(optional)</span>
        </label>
        <Button
          type="button"
          onClick={() => setShowCountrySelector(!showCountrySelector)}
          className="w-full bg-slate-800/70 hover:bg-slate-700/70 text-white border border-purple-400/50 rounded-xl h-11 justify-between px-4"
        >
          <span className="flex items-center">
            <Globe className="w-4 h-4 mr-2 text-slate-400" />
            {country ? countries.find((c) => c.code === country)?.name : 'Select Country'}
          </span>
          <span className="text-slate-500">▼</span>
        </Button>
        {showCountrySelector && (
          <div className="mt-2 grid grid-cols-3 gap-2 max-h-44 overflow-y-auto p-2 bg-slate-800/90 rounded-xl border border-purple-400/30">
            {countries.map((c) => (
              <button
                key={c.code}
                type="button"
                onClick={() => { setCountry(c.code); setShowCountrySelector(false); }}
                className={`p-2 rounded-lg border transition-all flex flex-col items-center justify-center gap-1 ${country === c.code ? 'bg-purple-500/30 border-purple-400' : 'bg-slate-700/30 border-slate-600/50 hover:bg-slate-600/60'}`}
              >
                <img src={`https://flagcdn.com/w80/${c.code}.png`} alt={c.name} className="w-8 h-5 object-cover rounded shadow-sm" />
                <div className="text-[10px] text-slate-300 truncate w-full text-center leading-tight">{c.name}</div>
              </button>
            ))}
          </div>
        )}
        <p className="text-xs text-slate-400 mt-1 ml-1">
          Shows your flag and adds you to your country&apos;s National Average.
        </p>
        {country && (
          <button
            type="button"
            onClick={() => { setCountry(''); setShowCountrySelector(false); }}
            className="text-slate-400 hover:text-white font-medium text-xs transition-colors mt-1 ml-1"
          >
            Skip for now
          </button>
        )}
      </div>

      {/* THE GIVEAWAY ELIGIBILITY QUESTION — required, either answer.

          Last field on the form on purpose. It is a question ABOUT the answers
          above it (you live in the US; you are old enough), so it reads as the
          closing statement rather than as another thing to fill in.

          ⚠️ NOT A COPPA AGE SCREEN, and the wording is what keeps it from
          becoming one. A COPPA screen must be NEUTRAL; this one deliberately
          is not, because it tells the player what answering yes gets them.
          That is correct for a sweepstakes eligibility question and wrong for
          an age gate — so it asks about ELIGIBILITY, never about age alone.
          The under-13 question is untouched by this. */}
      <div>
        <p className="text-white text-sm mb-1.5 font-semibold ml-1">
          {CONTEST_AGE_QUESTION}
          {/* ⚠️ BOTH HALVES, AND THE ORDER MATTERS (David, beta 1.0.312: "we
              should probably put in some text about it being an optional but
              required for contest").
              The question stopped blocking the form earlier tonight, so it now
              LOOKS skippable — and it is. But a player who skips it silently
              earns nothing from the giveaway, which is the one consequence they
              cannot discover by looking. Saying "optional" alone would produce
              exactly the state this whole change exists to prevent. */}
          <span className="font-normal text-slate-400"> (optional)</span>
        </p>
        <div className="flex gap-2" role="group" aria-label={CONTEST_AGE_QUESTION}>
          {[[true, CONTEST_AGE_YES], [false, CONTEST_AGE_NO]].map(([value, label]) => {
            const chosen = eligibleAnswer === value;
            return (
              <button
                key={String(value)}
                type="button"
                data-testid={`contest-age-${value ? 'yes' : 'no'}`}
                aria-pressed={chosen}
                onClick={() => { setEligibleAnswer(/** @type {boolean} */ (value)); setError(''); }}
                className="flex-1 min-h-[44px] touch-manipulation rounded-xl border font-black text-sm transition-all"
                style={{
                  borderColor: chosen
                    ? 'var(--u37-gold)'
                    : 'color-mix(in srgb, var(--u37-gold) 30%, transparent)',
                  background: chosen
                    ? 'color-mix(in srgb, var(--u37-gold) 22%, transparent)'
                    : 'rgba(255,255,255,0.04)',
                  color: chosen ? 'var(--u37-gold)' : 'rgb(203 213 225)',
                  WebkitTapHighlightColor: 'transparent',
                }}
              >
                {label}
              </button>
            );
          })}
        </div>
        {/* The line that makes "No" safe to press. Without it a mandatory
            question with no stated consequence invites a defensive lie, and a
            lie is worth less than no answer at all. */}
        <div data-testid="age-reassurance" className="mt-1.5 ml-1 text-xs leading-snug">
          <p className="text-slate-400">
            <span className="font-black" style={{ color: 'var(--u37-green)' }}>{CONTEST_AGE_REASSURANCE.head}</span>{' '}
            {CONTEST_AGE_REASSURANCE.body}
          </p>
          <p className="text-[11px] text-slate-500 mt-0.5">{CONTEST_AGE_REASSURANCE.foot}</p>
        </div>
        <p className="text-xs mt-1 ml-1 font-semibold" style={{ color: 'var(--u37-gold)' }}>
          🎁 Answer yes and add an email to be entered.
        </p>
      </div>

      {/* ⚠️ A NUDGE, NOT A GATE. Their entries count either way — see
          isEmailConfirmed. What this buys is the chance to fix a typo BEFORE it
          costs somebody the prize: the rules give a winner two emails and four
          weeks, and an address nobody can reach burns all of it silently. */}
      {emailUnconfirmed && !emailPending && (
        <div
          data-testid="email-unconfirmed-notice"
          className="text-amber-200 text-sm ml-1 p-2 rounded-lg bg-amber-500/10 border border-amber-500/20"
        >
          <p className="font-semibold">Email not confirmed yet</p>
          <p className="text-xs mt-0.5 leading-snug">
            Your entries still count. But if you win, this is how we reach you —
            so it is worth confirming.
          </p>
          <button
            type="button"
            data-testid="resend-confirmation"
            disabled={resendState === 'sending' || resendState === 'sent'}
            onClick={async () => {
              setResendState('sending');
              try {
                const { error: resendErr } = await supabase.auth.resend({
                  type: 'email_change',
                  email: email.trim(),
                });
                if (resendErr) throw resendErr;
                setResendState('sent');
              } catch {
                // Never silent: a player who taps resend and is told nothing
                // will wait for a mail that is not coming.
                setResendState('failed');
              }
            }}
            className="mt-1.5 min-h-[32px] touch-manipulation text-xs font-black underline decoration-dotted underline-offset-4 disabled:no-underline disabled:opacity-70"
          >
            {resendState === 'sending' ? 'Sending…'
              : resendState === 'sent' ? 'Sent — check your inbox'
                : resendState === 'failed' ? 'Could not send — tap to retry'
                  : 'Resend the confirmation email'}
          </button>
        </div>
      )}

      {/* "Invited by a friend?" — editing only; renders nothing unless the
          referrals switch is on AND the server says there is something to show. */}
      {editing && <ReferralProfileField />}

      {emailPending && (
        <div
          data-testid="email-pending-notice"
          className="text-amber-200 text-sm ml-1 p-2 rounded-lg bg-amber-500/10 border border-amber-500/20"
        >
          <p className="font-semibold">Check your inbox</p>
          <p className="text-xs mt-0.5 leading-snug">
            We sent a confirmation link to that address. Your email — and your
            giveaway entries — start once you click it. Everything else you
            changed has been saved.
          </p>
        </div>
      )}

      {error && (
        <div className="text-red-300 text-sm ml-1 p-2 rounded-lg bg-red-500/10 border border-red-500/20">
          <p>{error}</p>
          {appealHref && (
            <a href={appealHref} className="underline text-red-200 mt-1 inline-block">
              Tell us it is your real name
            </a>
          )}
        </div>
      )}

      <Button
        onClick={handleCreate}
        disabled={loading}
        className="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold py-6 text-base shadow-xl min-h-[52px] touch-manipulation rounded-xl mt-1"
      >
        {/* ⚠️ THE FORM OVERRIDES ITS OWN PROP HERE, deliberately. Every caller
            passes a "Create…" label because none of them knows whether the
            account is already secured — that is decided inside this component,
            after `auth.me()` resolves. Telling a signed-in player editing their
            country to "Create Account & Save Stats" would be the loudest thing
            on the screen and wrong. */}
        {loading
          ? <Loader2 className="w-5 h-5 animate-spin" />
          : (editing ? 'Save Changes' : submitLabel)}
      </Button>
    </div>
  );
}
