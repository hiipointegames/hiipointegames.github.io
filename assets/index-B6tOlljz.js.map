import React from 'react';
import { createPortal } from 'react-dom';
import { Lock } from 'lucide-react';

import { unlockTitle } from './softWall';

// The unlock sheet (approved mockup screen 9): what the guest was reaching for,
// what an account gets them, "Create free account" and "Not now".
//
// Design research (2026-10-10): explain the VALUE before asking; dismissible
// prompts are not wasted — a hard wall works far worse without them. A legacy
// named guest is addressed by their username ("add a password to keep @name"),
// so they are not asked to pick a name they already have.
//
// Portaled to <body> at z-[200] (the iPhone stacking rule, 40a906f).

const PERKS = [
  ['Your name on today’s podium and leaderboards', 'var(--u37-green)'],
  ['Streaks, stats and badges that follow you', 'var(--u37-cyan)'],
  ['Blitz battles and friends', 'var(--u37-magenta)'],
  ['A shot at $37 every week (18+, US)', 'var(--u37-gold)'],
];

/**
 * @param {{
 *   feature: string,
 *   username?: string | null,
 *   showContestPerk?: boolean,
 *   onCreate: () => void,
 *   onClose: () => void,
 * }} props
 *   username        — a legacy named guest's existing name (accountTier guestUsername)
 *   showContestPerk — false hides the $37 line (kept true for guests by design)
 */
export default function UnlockSheet({ feature, username = null, showContestPerk = true, onCreate, onClose }) {
  const perks = showContestPerk ? PERKS : PERKS.slice(0, 3);
  const node = (
    <div className="fixed inset-0 z-[200] flex flex-col justify-end" data-testid="unlock-sheet">
      <button
        type="button"
        aria-label="Close"
        data-testid="unlock-backdrop"
        onClick={onClose}
        className="absolute inset-0 w-full h-full cursor-default"
        style={{ background: 'linear-gradient(180deg, rgba(5,3,17,0.55), rgba(5,3,17,0.85))' }}
      />
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="unlock-title"
        className="relative w-full max-w-md mx-auto rounded-t-[28px] px-6 pt-3.5 text-white"
        style={{
          paddingBottom: 'calc(var(--safe-bottom) + var(--ad-reserved-bottom) + 1.75rem)',
          borderTop: '3px solid var(--u37-cyan)',
          background: 'linear-gradient(180deg, #121641 0%, #0a0c24 100%)',
          boxShadow: '0 -18px 50px -10px color-mix(in srgb, var(--u37-cyan) 35%, transparent)',
        }}
      >
        <div className="mx-auto w-11 h-1.5 rounded-full bg-white/25" aria-hidden="true" />
        <div className="mt-5 w-14 h-14 rounded-[18px] border-2 flex items-center justify-center" style={{ borderColor: 'var(--u37-cyan)', background: 'color-mix(in srgb, var(--u37-cyan) 10%, transparent)' }}>
          <Lock className="w-7 h-7" style={{ color: 'var(--u37-cyan)' }} aria-hidden="true" />
        </div>
        <h2 id="unlock-title" className="mt-4 text-[25px] font-black leading-tight" data-testid="unlock-title">
          {username ? `Add a password to keep @${username}` : unlockTitle(feature)}
        </h2>
        <p className="mt-2 text-[15px] leading-snug text-purple-100/80">
          {username ? 'Your name is already yours — one step and everything unlocks:' : 'It’s free and takes under a minute. You’ll get:'}
        </p>
        <ul className="mt-3.5 flex flex-col gap-2.5">
          {perks.map(([label, c]) => (
            <li key={label} className="flex items-center gap-3 text-[15px] font-extrabold">
              <span className="w-2.5 h-2.5 rounded-full flex-shrink-0" style={{ background: c, boxShadow: `0 0 8px ${c}` }} aria-hidden="true" />
              {label}
            </li>
          ))}
        </ul>
        <p className="mt-3.5 text-[13px] text-purple-200/70">Your Dailies so far come with you.</p>
        <button
          type="button"
          data-testid="unlock-create"
          onClick={onCreate}
          className="mt-5 w-full min-h-[58px] rounded-[18px] font-black text-lg touch-manipulation active:scale-95"
          style={{
            color: 'white',
            textShadow: '0 0 10px var(--u37-green)',
            background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-green) 32%, transparent), transparent 70%), var(--u37-panel-bg-cosmic)',
            border: '3px solid var(--u37-green)',
            boxShadow: '0 0 26px -6px var(--u37-green), inset 0 1px 5px rgba(255,255,255,0.28)',
          }}
        >
          {username ? 'Add a password' : 'Create free account'}
        </button>
        <button
          type="button"
          data-testid="unlock-not-now"
          onClick={onClose}
          className="mt-2 w-full min-h-[48px] font-extrabold text-[15px] text-purple-100/80"
        >
          Not now
        </button>
      </div>
    </div>
  );
  return typeof document !== 'undefined' ? createPortal(node, document.body) : node;
}
