import React, { useEffect, useState } from 'react';
import { createPortal } from 'react-dom';
import { X } from 'lucide-react';

import { hasContactableEmail } from '@/auth';
import { recordOutcome } from '@/observability';

import {
  EMAIL_CODE_ERRORS,
  confirmGiveawayEmailCode,
  normalizeEmailCode,
  sendGiveawayEmailCode,
} from './emailCode';
import { EMAIL_CODE_COPY, EMAIL_CODE_COOLDOWN_SECONDS } from './emailCodeCopy';
import { setGiveawayEmailVerified } from './useGiveawayEmailVerified';

// "Verify your email" — the bottom sheet that proves a player reads the inbox
// on their account, by a 6-digit code (from 25 Oct 2026 a giveaway entry
// needs it; see emailCode.js for how the server knows the code was typed).
//
//   send → code → done
//
// Portaled to <body> (z-[210], above the giveaway sheet at z-[200]): inside
// #root, iOS traps z-index under the body-portaled nav (40a906f).
//
// Analytics: `email_code` events, outcome sent | verified | failed, detail
// { step, reason } on failure. NEVER the address.

/** @typedef {'send'|'code'|'done'} Step */

/** Seconds left on the resend cooldown. */
function secondsLeft(until, now) {
  return Math.max(0, Math.ceil((until - now) / 1000));
}

/**
 * @param {{
 *   user: any,
 *   onClose: () => void,
 *   onVerified?: () => void,
 *   onLeave?: () => void,
 *   deps?: { send?: Function, confirm?: Function, record?: Function },
 * }} props
 */
export default function EmailCodeSheet({ user, onClose, onVerified, onLeave, deps = {} }) {
  const send = deps.send || sendGiveawayEmailCode;
  const confirm = deps.confirm || confirmGiveawayEmailCode;
  const record = deps.record || recordOutcome;

  const email = hasContactableEmail(user) ? String(user.email) : null;
  const [step, setStep] = useState(/** @type {Step} */ ('send'));
  const [code, setCode] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const [cooldownUntil, setCooldownUntil] = useState(0);
  const [now, setNow] = useState(() => Date.now());

  const wait = secondsLeft(cooldownUntil, now);
  useEffect(() => {
    if (!wait) return undefined;
    const t = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(t);
  }, [wait > 0]);

  const startCooldown = () => {
    const at = Date.now();
    setNow(at);
    setCooldownUntil(at + EMAIL_CODE_COOLDOWN_SECONDS * 1000);
  };

  // The account form lives at Layout level and opens by event. The host sheet
  // (onLeave) closes too, so the player lands ON the form, not behind it.
  const leaveFor = (eventName) => {
    onClose();
    onLeave?.();
    window.dispatchEvent(new Event(eventName));
  };

  const doSend = async () => {
    if (busy || wait) return;
    setBusy(true);
    setError('');
    const r = await send(email);
    setBusy(false);
    if (r?.ok) {
      record('email_code', 'sent', { step: 'send' });
      startCooldown();
      setCode('');
      setStep('code');
      return;
    }
    const reason = r?.reason in EMAIL_CODE_ERRORS ? r.reason : 'network';
    record('email_code', 'failed', { step: 'send', reason });
    if (reason === 'rate_limited') startCooldown();
    setError(EMAIL_CODE_ERRORS[reason]);
  };

  const doVerify = async () => {
    if (busy) return;
    setBusy(true);
    setError('');
    const r = await confirm(email, code);
    setBusy(false);
    if (r?.ok) {
      record('email_code', 'verified', { step: 'verify' });
      setGiveawayEmailVerified(user, true);
      setStep('done');
      onVerified?.();
      return;
    }
    const reason = r?.reason in EMAIL_CODE_ERRORS ? r.reason : 'bad_code';
    record('email_code', 'failed', { step: 'verify', reason });
    setError(EMAIL_CODE_ERRORS[reason]);
  };

  const link = (label, onClick, testId, disabled = false) => (
    <button
      type="button"
      data-testid={testId}
      onClick={onClick}
      disabled={disabled}
      className="min-h-[40px] touch-manipulation text-[12px] font-bold underline decoration-dotted underline-offset-4 text-slate-300 disabled:opacity-50 disabled:no-underline"
      style={{ WebkitTapHighlightColor: 'transparent' }}
    >
      {label}
    </button>
  );

  const primary = (label, onClick, testId, disabled = false) => (
    <button
      type="button"
      data-testid={testId}
      onClick={onClick}
      disabled={disabled || busy}
      className="mt-3 w-full min-h-[48px] rounded-xl font-black text-[15px] touch-manipulation active:scale-[0.98] disabled:opacity-50"
      style={{
        color: '#1a1200',
        background: 'var(--u37-gold)',
        WebkitTapHighlightColor: 'transparent',
      }}
    >
      {label}
    </button>
  );

  const address = <span className="font-black text-white break-all" data-testid="email-code-address">{email}</span>;

  let body;
  if (!email) {
    body = (
      <>
        <p className="text-[13px] leading-snug text-slate-200" data-testid="email-code-no-email">{EMAIL_CODE_COPY.noEmail}</p>
        {primary(EMAIL_CODE_COPY.addEmail, () => leaveFor('openAddEmail'), 'email-code-add-email')}
      </>
    );
  } else if (step === 'send') {
    body = (
      <>
        <p className="text-[13px] leading-snug text-slate-200">{EMAIL_CODE_COPY.sendLead} {address}.</p>
        {primary(busy ? EMAIL_CODE_COPY.sending : EMAIL_CODE_COPY.sendButton, doSend, 'email-code-send', wait > 0)}
        {wait > 0 && <p className="mt-1 text-[11px] text-slate-400" data-testid="email-code-wait">{EMAIL_CODE_COPY.resendIn(wait)}</p>}
        <div className="mt-1">{link(EMAIL_CODE_COPY.changeEmail, () => leaveFor('openEditProfile'), 'email-code-change')}</div>
      </>
    );
  } else if (step === 'code') {
    body = (
      <>
        <p className="text-[13px] leading-snug text-slate-200">{EMAIL_CODE_COPY.codeLead} {address}.</p>
        <label htmlFor="email-code-input" className="sr-only">{EMAIL_CODE_COPY.codeLabel}</label>
        <input
          id="email-code-input"
          data-testid="email-code-input"
          value={code}
          onChange={(e) => { setCode(e.target.value); setError(''); }}
          onKeyDown={(e) => { if (e.key === 'Enter' && normalizeEmailCode(code)) doVerify(); }}
          inputMode="numeric"
          autoComplete="one-time-code"
          maxLength={9}
          placeholder="123 456"
          autoFocus
          className="mt-3 w-full min-h-[56px] rounded-xl border-2 bg-slate-900/70 text-center text-[26px] font-black tracking-[0.35em] text-white outline-none"
          style={{ borderColor: 'color-mix(in srgb, var(--u37-gold) 55%, transparent)' }}
        />
        {primary(busy ? EMAIL_CODE_COPY.verifying : EMAIL_CODE_COPY.verifyButton, doVerify, 'email-code-verify', !normalizeEmailCode(code))}
        <div className="mt-1 flex flex-wrap items-center justify-between gap-x-3">
          {link(wait > 0 ? EMAIL_CODE_COPY.resendIn(wait) : EMAIL_CODE_COPY.resend, doSend, 'email-code-resend', wait > 0 || busy)}
          {link(EMAIL_CODE_COPY.changeEmail, () => leaveFor('openEditProfile'), 'email-code-change')}
        </div>
      </>
    );
  } else {
    body = (
      <>
        <p className="text-[14px] font-bold leading-snug" style={{ color: 'var(--u37-green)' }} data-testid="email-code-success">
          {EMAIL_CODE_COPY.success}
        </p>
        {primary(EMAIL_CODE_COPY.done, onClose, 'email-code-done')}
      </>
    );
  }

  const node = (
    <div className="fixed inset-0 z-[210] flex flex-col justify-end" data-testid="email-code-sheet" data-step={email ? step : 'no_email'}>
      <button
        type="button"
        aria-label="Close"
        data-testid="email-code-backdrop"
        onClick={onClose}
        className="absolute inset-0 w-full h-full cursor-default"
        style={{ background: 'linear-gradient(180deg, rgba(5,3,17,0.55), rgba(5,3,17,0.85))' }}
      />
      <div
        role="dialog"
        aria-modal="true"
        aria-label={EMAIL_CODE_COPY.title}
        className="relative w-full max-w-md mx-auto px-3"
        style={{ paddingBottom: 'calc(var(--safe-bottom) + var(--ad-reserved-bottom) + 0.75rem)' }}
      >
        <div
          className="rounded-2xl border p-4"
          style={{
            background: 'var(--u37-panel-bg)',
            borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
          }}
        >
          <div className="flex items-center justify-between">
            <span className="text-sm font-black" style={{ color: 'var(--u37-gold)' }}>✉️ {EMAIL_CODE_COPY.title}</span>
            <button
              type="button"
              aria-label="Close"
              data-testid="email-code-close"
              onClick={onClose}
              className="min-w-[44px] min-h-[44px] -mr-2 flex items-center justify-center text-slate-400"
            >
              <X className="w-5 h-5" />
            </button>
          </div>
          {body}
          {error && <p role="alert" data-testid="email-code-error" className="mt-2 text-[12px] font-semibold text-red-300">{error}</p>}
        </div>
      </div>
    </div>
  );
  return typeof document !== 'undefined' ? createPortal(node, document.body) : node;
}
