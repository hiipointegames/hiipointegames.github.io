import React, { useState, useEffect } from 'react';
import { ChevronDown, ChevronUp, UserPlus, Users } from 'lucide-react';
import { apiClient } from '@/transport';
import { Link } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { sendFriendRequest, getFriendEdges, partitionPendingRequests, derivePlayerSimilarity } from '@/player';
import { playSound } from '@/ui/feedback';

export default function RecommendedPlayers({ currentUserId, currentUserFriendIds, onUpdate }) {
  const [isExpanded, setIsExpanded] = useState(false);
  const [recommendations, setRecommendations] = useState([]);
  const [loading, setLoading] = useState(true);
  const [pendingRequests, setPendingRequests] = useState(new Set());

  useEffect(() => {
    if (!currentUserId) {
      setLoading(false);
      return;
    }

    const loadRecommendations = async () => {
      try {
        const currentUser = await apiClient.auth.me();
        const allProfiles = await apiClient.entities.PublicProfile.list();
        const allChallenges = await apiClient.entities.HeadToHeadChallenge.filter({
          status: 'completed'
        });

        // Pending requests I've sent (outgoing) — from the friend-edge read path
        const myEdges = await getFriendEdges(currentUser.id);
        const pendingIds = new Set(partitionPendingRequests(myEdges, currentUser.id).outgoing);
        setPendingRequests(pendingIds);

        // Accepted connections drive the mutual-friends affinity in the score.
        const allConnections = await apiClient.entities.FriendConnection.filter({
          status: 'accepted'
        });

        setRecommendations(
          derivePlayerSimilarity(allProfiles, allChallenges, {
            userId: currentUserId,
            friendIds: currentUserFriendIds,
            connections: allConnections,
          })
        );
      } catch (error) {
        console.error('Failed to load recommendations:', error);
      } finally {
        setLoading(false);
      }
    };

    if (currentUserId) {
      loadRecommendations();
    } else {
      setLoading(false);
    }
  }, [currentUserId, currentUserFriendIds]);

  const handleSendRequest = async (targetId) => {
    try {
      await sendFriendRequest(currentUserId, targetId);
      setPendingRequests(prev => new Set([...prev, targetId]));
      onUpdate();
    } catch (error) {
      console.error('Failed to send friend request:', error);
      if (!error.message?.includes('already sent')) {
        alert(error.message || 'Failed to send friend request');
      }
    }
  };

  if (loading) {
    return (
      <div className="bg-gradient-to-br from-indigo-900/40 to-purple-900/30 backdrop-blur rounded-2xl p-6 border-2 border-indigo-400/40 shadow-lg shadow-indigo-500/20">
        <div className="text-center text-indigo-300 py-4 font-semibold">Loading recommendations...</div>
      </div>
    );
  }

  return (
    <div className="bg-gradient-to-br from-blue-400/40 via-blue-500/30 to-blue-900/40 backdrop-blur rounded-2xl p-6 border-2 border-blue-400/80 shadow-xl shadow-blue-500/20">
      <button
        onClick={() => { playSound('buttonTap'); setIsExpanded(!isExpanded); }}
        className="w-full flex items-center justify-between mb-4 hover:opacity-90 transition-opacity"
      >
        <h3 className="text-xl font-bold bg-gradient-to-r from-blue-300 to-cyan-300 bg-clip-text text-transparent flex items-center gap-2">
          <span className="text-lg">✨</span>
          Recommended Players
        </h3>
        {isExpanded ? (
          <ChevronUp className="w-5 h-5 text-blue-300" />
        ) : (
          <ChevronDown className="w-5 h-5 text-blue-300" />
        )}
      </button>

      <AnimatePresence>
        {isExpanded && (
          <motion.div
            initial={{ height: 0, opacity: 0 }}
            animate={{ height: 'auto', opacity: 1 }}
            exit={{ height: 0, opacity: 0 }}
            transition={{ duration: 0.2 }}
            className="overflow-hidden"
          >
            {recommendations.length > 0 ? (
              <div className="space-y-2">
                {recommendations.map((player) => (
                  <div
                    key={player.id}
                    className="flex items-center justify-between p-3 bg-gradient-to-r from-indigo-700/30 to-purple-700/20 rounded-lg border border-indigo-500/30 hover:border-indigo-400/60 hover:bg-gradient-to-r hover:from-indigo-700/40 hover:to-purple-700/30 transition-all"
                  >
                    <Link
                      to={`${createPageUrl('OtherProfile')}?id=${player.id}`}
                      className="flex items-center gap-3 flex-1 hover:opacity-90 transition-opacity"
                    >
                      {player.country && (
                        <img
                          src={`https://flagcdn.com/w40/${player.country?.toLowerCase()}.png`}
                          alt="Flag"
                          className="w-6 h-4 object-cover rounded shadow-sm"
                        />
                      )}
                      <div className="flex-1">
                        <div className="text-indigo-100 font-bold">{player.username}</div>
                        {player.mutualFriends > 0 && (
                          <div className="flex items-center gap-1 text-xs text-green-400">
                            <Users className="w-3.5 h-3.5" />
                            {player.mutualFriends} mutual friend{player.mutualFriends !== 1 ? 's' : ''}
                          </div>
                        )}
                      </div>
                    </Link>
                    {pendingRequests.has(player.id) ? (
                      <Button
                        disabled
                        className="bg-gradient-to-r from-pink-600 to-purple-700 text-white shadow-lg cursor-not-allowed font-semibold opacity-70"
                      >
                        Pending
                      </Button>
                    ) : (
                      <Button
                        onClick={(e) => {
                          e.preventDefault();
                          e.stopPropagation();
                          handleSendRequest(player.id);
                        }}
                        className="bg-gradient-to-r from-indigo-600 to-purple-700 hover:from-indigo-700 hover:to-purple-800 text-white shadow-lg shadow-indigo-500/30 transition-all font-semibold"
                      >
                        <UserPlus className="w-4 h-4" />
                      </Button>
                    )}
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-center text-blue-300 py-6 text-sm font-medium">
                No recommendations
              </div>
            )}
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}