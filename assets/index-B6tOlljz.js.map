// Sector 73 — "the Mirror" (client half).
//
// Any Daily accepts a solve that uses all seven dice and equals 73. Power-dice
// rules do not apply. It counts as a real Daily solve and unlocks Sector 73 —
// once. Server mirror + the full account of the rule: supabase/functions/_shared/
// sector73.ts (mirror.test.js asserts the two agree).
//
// "Unlocked" is DERIVED, never stored: a player has crossed the Mirror iff one of
// their own `daily_challenge_times` rows holds an equation that evaluates to 73.
// The local cache below only makes the home-screen wormhole appear instantly; the
// rows are the truth and a fresh read always overwrites the cache.

import { evaluateEquation } from '@/equation-engine';
import { apiClient } from '@/transport';

/** 37, seen in a mirror. */
export const MIRROR_TARGET = 73;

/** The Mirror opens from any Daily — and once per player across all three. */
export const DAILY_MODES = ['daily_easy', 'daily', 'daily_expert'];

/** Does this equation evaluate to exactly 73? */
export const isWarpEquation = (equation) => {
  if (typeof equation !== 'string' || equation.length === 0) return false;
  const { valid, result } = evaluateEquation(equation);
  return valid && result === MIRROR_TARGET;
};

/**
 * Is the in-progress Daily board a submittable 73? Same shape as the 37 gate
 * (`isSubmittableSolution`) minus the power-dice rule, which a 73 skips.
 */
export const isWarpSubmittable = ({ valid, result, usedDiceIndices, draftErrors }) =>
  Boolean(
    valid &&
    result === MIRROR_TARGET &&
    Array.isArray(usedDiceIndices) && usedDiceIndices.length === 7 &&
    Array.isArray(draftErrors) && draftErrors.length === 0,
  );

/** True if any of these rows is a 73 warp. */
export const hasWarpRow = (rows) =>
  Array.isArray(rows) && rows.some((row) => isWarpEquation(row?.equation));

// The unlock cache is PER ACCOUNT (sweep review 2026-10-05): a single device-wide flag let a
// second account on the same phone see the wormhole and fly in, and it blocked that account's
// own first 73 from being submitted.
const CACHE_PREFIX = 'sector73.unlocked.';
const cacheKey = (userId) => `${CACHE_PREFIX}${userId}`;

/** Last known unlock state for this account on this device (instant, may be stale). */
export const readCachedUnlock = (userId) => {
  if (!userId) return false;
  try {
    return globalThis.localStorage?.getItem(cacheKey(userId)) === '1';
  } catch {
    return false;
  }
};

export const writeCachedUnlock = (userId, unlocked) => {
  if (!userId) return;
  try {
    if (unlocked) globalThis.localStorage?.setItem(cacheKey(userId), '1');
    else globalThis.localStorage?.removeItem(cacheKey(userId));
  } catch {
    // Storage blocked (private window): the server read still decides.
  }
};

/** Forget every account's cached unlock + welcome flag on this device (DEV panel / tests). */
export const clearCachedUnlocks = () => {
  try {
    const ls = globalThis.localStorage;
    if (!ls) return;
    const keys = [];
    for (let i = 0; i < ls.length; i++) keys.push(ls.key(i));
    keys.filter((k) => k && (k.startsWith('sector73.unlocked') || k.startsWith('sector73.welcomeSeen')))
      .forEach((k) => ls.removeItem(k));
  } catch { /* nothing cached */ }
};

/** "Welcome, Pilot" shown once per account. */
export const welcomeSeenKey = (userId) => `sector73.welcomeSeen.${userId || 'guest'}`;

/**
 * Ask the database whether this player has crossed the Mirror.
 * Throws on a read error — "could not check" is not "not unlocked".
 *
 * @param {string | null | undefined} userId
 * @returns {Promise<boolean>}
 */
export function fetchSector73Unlocked(userId) {
  if (!userId) return Promise.resolve(false);
  // The home (Layout) and the Game page ask at the same moment: share one read per account.
  const pending = unlockReads.get(userId);
  if (pending) return pending;
  const read = readUnlock(userId).finally(() => unlockReads.delete(userId));
  unlockReads.set(userId, read);
  return read;
}

/** @type {Map<string, Promise<boolean>>} */
const unlockReads = new Map();

/** @param {string} userId @returns {Promise<boolean>} */
async function readUnlock(userId) {
  const { data, error } = await apiClient.supabase
    .from('daily_challenge_times')
    .select(/** @type {'*'} */ ('equation'))
    .eq('user_id', userId)
    .in('mode', DAILY_MODES);
  if (error) throw error;
  const unlocked = hasWarpRow(data);
  writeCachedUnlock(userId, unlocked);
  return unlocked;
}
