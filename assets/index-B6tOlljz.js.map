import { ErrorBoundary as SentryErrorBoundary } from '@sentry/react';
import { useEffect } from 'react';
import { Capacitor } from '@capacitor/core';
import { SplashScreen } from '@capacitor/splash-screen';

// App-wide React error boundary. Catches render/lifecycle errors that would
// otherwise blank the screen, reports them to Sentry (when enabled), and shows
// a recoverable fallback instead of a white screen. The fallback's "Reload"
// reloads the webview, which is the most reliable recovery on a native shell.
function Fallback({ resetError }) {
  // Dismiss the native splash before showing this. `launchAutoHide` is false, so
  // a crash during the FIRST render used to leave the splash parked on top of
  // this fallback: the user could not see the message, could not reach Reload,
  // and the app looked simply dead. App Review rejected 1.0.314 under 2.1(a) for
  // "launched on an unresponsive screen". shell/splashWatchdog covers the case
  // where React never renders at all; this covers the case where it renders
  // exactly this.
  useEffect(() => {
    if (!Capacitor.isNativePlatform()) return;
    // Deliberately ignored: we're already showing the error screen; a failed
    // hide() has no better fallback.
    SplashScreen.hide().catch(() => {});
  }, []);

  return (
    <div className="fixed inset-0 flex flex-col items-center justify-center gap-4 bg-slate-900 px-6 text-center">
      <h1 className="text-xl font-semibold text-slate-100">Something went wrong</h1>
      <p className="max-w-xs text-sm text-slate-400">
        The app hit an unexpected error. Reloading usually fixes it.
      </p>
      <button
        type="button"
        onClick={() => {
          resetError();
          window.location.reload();
        }}
        className="rounded-lg bg-slate-100 px-5 py-2 text-sm font-medium text-slate-900"
      >
        Reload
      </button>
    </div>
  );
}

export function AppErrorBoundary({ children }) {
  return (
    <SentryErrorBoundary fallback={(props) => <Fallback {...props} />}>
      {children}
    </SentryErrorBoundary>
  );
}
