// shell/nativeInit — one-time Capacitor plugin initialization.
//
// Configures StatusBar and initializes AdMob on app boot. Idempotent: safe
// to call multiple times (Capacitor plugins guard against double-init).
// No-op on web (where Capacitor.isNativePlatform() returns false).
//
// See:
//   docs/architecture/subsystems.md  (#13 — shell)
//
// Callers: src/routing/App.jsx invokes this once from a top-level useEffect.

import { Capacitor } from '@capacitor/core';
import { StatusBar, Style } from '@capacitor/status-bar';
import { AdMob } from '@capacitor-community/admob';
import { adIsTesting, getTestDeviceIds } from './adConfig';
import { requestConsent } from './consent';
import { setAdsAllowed } from './adGate';

async function configStatusBar(isNative) {
  // @capacitor/status-bar ships no web implementation — a browser tab has no
  // native status bar to style. Calling it off-native only REJECTS and logged a
  // `console.warn` on every web boot (the rejection was swallowed by the catch
  // below, so it "worked" but spammed the console). Skip entirely on web; the
  // page background/notch color is handled by the theme-color meta + CSS.
  // See docs/bugs.md (2026-06-20 StatusBar-on-web entry).
  if (!isNative) return;
  try {
    await StatusBar.setStyle({ style: Style.Dark });
    await StatusBar.setOverlaysWebView({ overlay: true });
    await StatusBar.setBackgroundColor({ color: '#00000000' });
  } catch (e) {
    console.warn('StatusBar plugin error:', e);
  }
}

async function initAdMob(isNative) {
  if (!isNative) return;
  try {
    // 1. Gather GDPR/UMP consent BEFORE initializing the ads SDK, so the
    //    consent string is in place for the first ad request. Fail-open.
    const { canRequestAds } = await requestConsent();

    // 2. Open (or close) the ad gate that the banner manager + interstitial
    //    hook await before loading any ad. If the user denied consent in a
    //    region where it's required, canRequestAds is false and no ad loads
    //    this session — Google requires gating requests on this; the SDK does
    //    not suppress them for us.
    setAdsAllowed(canRequestAds);

    // 3. Initialize. ATT permission is requested natively in AppDelegate.swift
    //    before the web view loads, so we don't request it here (avoids a
    //    duplicate iOS dialog). testingDevices + initializeForTesting register
    //    our own devices for test ads so they don't generate invalid traffic.
    await AdMob.initialize({
      initializeForTesting: adIsTesting(),
      testingDevices: getTestDeviceIds(),
    });
  } catch (e) {
    console.error('AdMob init error:', e);
  }
}

/**
 * Initialize all Capacitor-side concerns the app needs at boot.
 * Returns a Promise that resolves when StatusBar + AdMob settle.
 *
 * NOTE: the Capgo notifyAppReady() signal is intentionally NOT here. It must
 * fire as early as possible (before this deep, mount-triggered init) or Capgo
 * rolls a freshly-applied OTA bundle back on slow devices. It now lives at the
 * top of main.jsx — see notifyLiveUpdateReady() in src/shell/liveUpdate.js.
 */
export async function initNativeShell() {
  const isNative = Capacitor.isNativePlatform();
  await Promise.all([
    configStatusBar(isNative),
    initAdMob(isNative),
  ]);
}
