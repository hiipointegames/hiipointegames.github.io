import React, { useEffect, useRef } from 'react';

// CelebrationGuard — a battle's award celebration must never strand the player.
//
// When a battle ends on awards, HeadToHeadGame parks the results and leaves only
// when the celebration drains. If the celebration throws while rendering, or is
// still up after `timeoutMs`, the guard calls `onGiveUp` (HeadToHeadGame passes
// its once-only `finish`), so the player always reaches the result. The normal
// drain then finds finish already spent and does nothing.

class Boundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { failed: false };
  }

  static getDerivedStateFromError() {
    return { failed: true };
  }

  componentDidCatch(error) {
    console.error('Battle award celebration failed; leaving for the results:', error);
    this.props.onError();
  }

  render() {
    return this.state.failed ? null : this.props.children;
  }
}

/**
 * @param {{ active: boolean, onGiveUp: () => void, timeoutMs?: number, children: React.ReactNode }} props
 */
export default function CelebrationGuard({ active, onGiveUp, timeoutMs = 20000, children }) {
  const giveUpRef = useRef(onGiveUp);
  giveUpRef.current = onGiveUp;

  useEffect(() => {
    if (!active) return undefined;
    const id = setTimeout(() => giveUpRef.current(), timeoutMs);
    return () => clearTimeout(id);
  }, [active, timeoutMs]);

  return <Boundary onError={() => giveUpRef.current()}>{children}</Boundary>;
}
