// The FACE of the giveaway details sheet — the five lines a player sees before
// tapping "Full rules ▾" (copy-condense, approved by David 2026-10-18).
//
// The detail lives in the expander, built from the labelled constants in
// contest.js / contestLegal.js. The expander is rendered IN THE DOM (a native
// <details>), never conditionally mounted, so every rule is still "presented in
// the app" (Apple guideline 5.3.2) and a text search of the sheet still finds it.
//
// The numbers that can drift — eligibility, run dates, drawing count, entries
// per day — are built from CONTEST / MAX_ENTRIES_PER_DAY, never retyped.

import { CONTEST } from './contest';
import { MAX_ENTRIES_PER_DAY } from './contestEntries';

/** "20 September 2026" → "20 Sep 2026". */
export function shortContestDate(date) {
  return String(date).replace(/\b([A-Z][a-z]{2})[a-z]+\b/, '$1');
}

/** The face lines, in render order. */
export const CONTEST_SHEET_FACE = Object.freeze([
  `Finish any Daily = 1 entry. Up to ${MAX_ENTRIES_PER_DAY} a day. Speed doesn't matter.`,
  `No purchase necessary. ${CONTEST.eligibility}.`,
  'Sun–Sat weeks · winner drawn Sundays 9pm ET.',
  `Runs ${shortContestDate(CONTEST.startsOn)} – ${shortContestDate(CONTEST.endsOn)} · ${CONTEST.drawings} drawings.`,
  'Winner? Reply to our email within 4 weeks — check spam.',
]);

/** The expander's label. */
export const CONTEST_FULL_RULES_LABEL = 'Full rules';
