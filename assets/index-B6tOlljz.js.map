// Pure player-recommendation scoring — the similarity engine RecommendedPlayers
// used to inline inside a fetch effect: a full-table profile scan, a
// win-rate/avg-time fold duplicated once for the viewer and once per candidate,
// and a mutual-friends count off raw connection rows. The component keeps the
// fetches (auth, profiles, challenges, connections); this owns the derivation,
// on one tested path.
//
// "Similarity" is play-alikeness: closeness in win rate (weight 0.5) and average
// solve time (0.3), minus a mutual-friends affinity bonus (0.2). LOWER score =
// better match. Aggregation uses the head-to-head battle read path
// (selectPlayerBattles is completed-only; perspectiveOf picks my result column).
//
// Lives in player/ — recommending players is a player-domain concern, and
// player already depends on head-to-head (syncPublicProfile), so this adds no
// new module edge (stats-aggregation, which has no head-to-head dependency,
// would). Imports the two helpers via the @/head-to-head barrel.

import { selectPlayerBattles, perspectiveOf } from '@/head-to-head';

/**
 * A player's win rate + average solve time over their completed battles.
 * Shared by the viewer and every candidate (the fold was duplicated inline).
 * Truthy-guarded accumulation and >0-guarded ratios mirror the original tally.
 *
 * @param {Array<object>} challenges - all completed challenges (filtered by player here)
 * @param {string} playerId
 * @returns {{ totalBattles: number, winRate: number, avgTime: number }}
 */
function aggregateBattleStats(challenges, playerId) {
  const battles = selectPlayerBattles(challenges, playerId);
  let wins = 0;
  let totalBattles = 0;
  let totalTime = 0;
  let totalSolved = 0;

  for (const challenge of battles) {
    if (challenge.winner_id === playerId) wins += 1;
    totalBattles += 1;
    const { myResult } = perspectiveOf(challenge, playerId);
    if (myResult?.total_time_seconds) totalTime += myResult.total_time_seconds;
    if (myResult?.total_solved) totalSolved += myResult.total_solved;
  }

  return {
    totalBattles,
    winRate: totalBattles > 0 ? wins / totalBattles : 0,
    avgTime: totalSolved > 0 ? totalTime / totalSolved : 0,
  };
}

/**
 * Count, per other player, how many of the viewer's friends they're connected
 * to. A connection contributes a mutual only when exactly one endpoint is the
 * viewer's friend and the other is neither the viewer nor already a friend. The
 * two independent guards prevent counting the viewer or a friend-of-both.
 *
 * @param {Array<object>} connections - accepted FriendConnection rows
 * @param {Set<string>} friendSet - the viewer's friend ids
 * @param {string} userId - the viewer
 * @returns {Object<string, number>} player id → mutual-friend count
 */
function buildMutualFriendsMap(connections, friendSet, userId) {
  /** @type {Object<string, number>} */
  const map = {};
  for (const conn of (connections || [])) {
    const a = conn.user_id;
    const b = conn.friend_id;
    if (friendSet.has(a) && !friendSet.has(b) && b !== userId) {
      map[b] = (map[b] || 0) + 1;
    }
    if (friendSet.has(b) && !friendSet.has(a) && a !== userId) {
      map[a] = (map[a] || 0) + 1;
    }
  }
  return map;
}

/**
 * Score every eligible other player by similarity to the viewer; return the top
 * 5 (lowest score = best match). Eligible = not the viewer, not already a
 * friend, has a non-Guest username, and has at least one completed battle.
 * Pure: does not mutate its inputs.
 *
 * @param {Array<object>} profiles - all public profiles
 * @param {Array<object>} challenges - all completed head-to-head challenges
 * @param {object} ctx
 * @param {string} ctx.userId - the viewer
 * @param {string[]} [ctx.friendIds] - the viewer's accepted-friend ids
 * @param {Array<object>} [ctx.connections] - accepted FriendConnection rows (for mutuals)
 * @returns {Array<object>} ≤5 profiles enriched with
 *   { winRate, avgTime, totalBattles, mutualFriends, score }, sorted by score asc
 */
export function derivePlayerSimilarity(profiles, challenges, { userId, friendIds, connections } = /** @type {{ userId: string, friendIds?: string[], connections?: any[] }} */ ({})) {
  const friendSet = new Set(friendIds || []);
  const me = aggregateBattleStats(challenges, userId);
  const mutualFriendsMap = buildMutualFriendsMap(connections, friendSet, userId);

  return (profiles || [])
    .filter((p) =>
      p.id !== userId &&
      !friendSet.has(p.id) &&
      p.username && !p.username.startsWith('Guest')
    )
    .map((profile) => {
      const stats = aggregateBattleStats(challenges, profile.id);
      const winRateDiff = Math.abs(stats.winRate - me.winRate);
      const timeDiff = me.avgTime > 0 && stats.avgTime > 0
        ? Math.abs(stats.avgTime - me.avgTime) / me.avgTime
        : 1;
      // Weights: 50% win rate, 30% time; mutual-friends affinity discounts the score.
      const similarityScore = (winRateDiff * 0.5) + (timeDiff * 0.3);
      const mutualFriends = mutualFriendsMap[profile.id] || 0;
      const mutualFriendsBonus = mutualFriends * 0.2;

      return {
        ...profile,
        winRate: stats.winRate,
        avgTime: stats.avgTime,
        totalBattles: stats.totalBattles,
        mutualFriends,
        score: similarityScore - mutualFriendsBonus,
      };
    })
    .filter((p) => p.totalBattles > 0)
    .sort((a, b) => a.score - b.score)
    .slice(0, 5);
}
