import React, { useRef } from 'react';
import { motion } from 'framer-motion';
import { Bell } from 'lucide-react';
import { playSound } from '@/ui/feedback';
import { usePendingActions } from './usePendingActions';
import { openInbox } from './inboxStore';

// The HYPER-VISIBLE, impossible-to-miss entry to the Notifications inbox. It
// appears ONLY when there's something waiting (home stays clean at zero) and
// opens the shared inbox. Rendered as a compact (~48px) round bell FILLED with
// the magenta battle gradient, a continuously "ringing" wiggle, a strong
// breathing glow, and a bold white count badge — designed so players never miss
// it (it stands in for the old friends-page bell). Compact enough to clear the
// gold "37" wordmark on any phone width (the old wide "🔔 Notifications N" pill
// overlapped it — David, 2026-07-11). `scope="colosseum"` counts battle items
// only (currently only 'home' is used — Notifications are home-only).

const MAGENTA = 'var(--u37-magenta)';
const animatedScopes = new Set();
// test-only reset so the entrance-once assertion starts clean.
export function __resetNotificationsButtonEntrance() { animatedScopes.clear(); }

export default function NotificationsButton({ scope = 'home' }) {
  const { friendRequests, battleInvites, yourMoveBattles } = usePendingActions();
  const showFriends = scope === 'home';
  const count = (showFriends ? friendRequests.length : 0) + battleInvites.length + yourMoveBattles.length;

  const willAnimateRef = useRef(!animatedScopes.has(scope));
  if (count > 0 && !animatedScopes.has(scope)) animatedScopes.add(scope);
  if (count === 0) return null;
  const willAnimate = willAnimateRef.current;

  return (
    <motion.button
      data-testid="notifications-button"
      data-scope={scope}
      aria-label={`Notifications (${count})`}
      onClick={() => { playSound('buttonTap'); openInbox(scope); }}
      initial={willAnimate ? { opacity: 0, y: -12, scale: 0.7 } : false}
      animate={{
        opacity: 1,
        y: 0,
        scale: 1,
        // Strong breathing NEON glow so the eye is pulled to it.
        boxShadow: [
          `0 0 16px -2px ${MAGENTA}, 0 0 6px -1px ${MAGENTA}`,
          `0 0 32px 1px ${MAGENTA}, 0 0 13px 0px ${MAGENTA}`,
          `0 0 16px -2px ${MAGENTA}, 0 0 6px -1px ${MAGENTA}`,
        ],
      }}
      transition={{
        default: willAnimate ? { type: 'spring', damping: 12, stiffness: 240 } : { duration: 0 },
        boxShadow: { duration: 1.8, repeat: Infinity, ease: 'easeInOut' },
      }}
      whileTap={{ scale: 0.9 }}
      // Compact round bell FILLED with the magenta battle gradient + a bright
      // rim — bold and on-theme (magenta = battles/notifications).
      className="relative flex items-center justify-center rounded-full w-12 h-12 touch-manipulation"
      style={{
        background: 'var(--u37-grad-blitz-battle)',
        border: '2px solid color-mix(in srgb, var(--u37-magenta) 35%, white)',
      }}
    >
      {/* Ringing wiggle — periodically rocks the bell to alert the eye. */}
      <motion.span
        animate={{ rotate: [0, -14, 12, -10, 8, -4, 0] }}
        transition={{ duration: 1.1, repeat: Infinity, repeatDelay: 1.4, ease: 'easeInOut' }}
        style={{ transformOrigin: '50% 22%', display: 'inline-flex' }}
      >
        <Bell className="w-6 h-6 text-white" fill="rgba(255,255,255,0.3)" style={{ filter: 'drop-shadow(0 0 4px rgba(255,255,255,0.75))' }} />
      </motion.span>
      {/* Bold white count badge with a gentle pulse + magenta glow. */}
      <motion.span
        data-testid="notifications-button-count"
        animate={{ scale: [1, 1.14, 1] }}
        transition={{ duration: 1.8, repeat: Infinity, ease: 'easeInOut' }}
        className="absolute -top-1.5 -right-1.5 min-w-[22px] h-[22px] px-1 rounded-full text-[12px] font-black flex items-center justify-center leading-none"
        style={{ background: '#fff', color: 'var(--u37-magenta-deep)', border: `1.5px solid ${MAGENTA}`, boxShadow: `0 0 11px -1px ${MAGENTA}` }}
      >
        {count}
      </motion.span>
    </motion.button>
  );
}
