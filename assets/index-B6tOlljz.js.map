import React, { createContext, useContext, useState, useCallback } from 'react';
import { AnimatePresence } from 'framer-motion';
import FriendNotificationToast from './FriendNotificationToast';

const NotificationContext = createContext(
  /** @type {{ addNotification: (n: any) => void, dismissNotification: (id: any) => void } | null} */ (null)
);

export function useNotifications() {
  const context = useContext(NotificationContext);
  if (!context) {
    throw new Error('useNotifications must be used within NotificationProvider');
  }
  return context;
}

export function NotificationProvider({ children }) {
  const [notifications, setNotifications] = useState([]);

  const addNotification = useCallback((notification) => {
    const id = Date.now() + Math.random();
    setNotifications(prev => [...prev, { ...notification, id }]);
  }, []);

  const dismissNotification = useCallback((id) => {
    setNotifications(prev => prev.filter(n => n.id !== id));
  }, []);

  return (
    <NotificationContext.Provider value={{ addNotification, dismissNotification }}>
      {children}
      {/* ⚠️ z-[160], NOT z-[100] (David, 2026-09-17, beta 1.0.311): "Request
          gets sent, but no notification shows like it does when the request is
          sent from the other profile page."

          The notification fired correctly both times. It was PAINTED UNDERNEATH
          the full-screen Friends overlay, which sits at z-[130] — so the same
          call was visible from OtherProfile (no overlay) and invisible from the
          Friends tab. A stacking bug reads exactly like a missing feature.

          160 is chosen, not arbitrary: above every overlay in the app
          (FriendsScreen 130, BadgeDetailModal 140, the 150 tier) and deliberately
          BELOW the z-[200] blocking modals — an exit-confirm or sign-out warning
          should not be covered by a friend-request toast. */}
      <div className="fixed top-4 right-4 z-[160] space-y-2 pointer-events-none">
        <div className="pointer-events-auto">
          <AnimatePresence>
            {notifications.map(notification => (
              <FriendNotificationToast
                key={notification.id}
                notification={notification}
                onDismiss={dismissNotification}
              />
            ))}
          </AnimatePresence>
        </div>
      </div>
    </NotificationContext.Provider>
  );
}