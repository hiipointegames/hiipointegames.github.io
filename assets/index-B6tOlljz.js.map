// Power-dice rule cards (teaching order green→blue→red). Symbols are display.
export const POWER_DICE_RULES = [
  { color: 'green', label: 'Green', operators: '+  or  −', note: 'Add or subtract with it.' },
  { color: 'blue', label: 'Blue', operators: '×  or  ÷', note: 'Multiply or divide with it.' },
  { color: 'red', label: 'Red', operators: '^', note: 'Use it as a base or a power.' },
];
export const POWER_DICE_RULE_HEADLINE = 'Use at least 2 of the 3 correctly for a Valid Solve.';
// The perfect-solve REWARD line, read from the Puzzle Piece rule source of truth
// (copy-condense 2026-10-18). The Daily pays; practice rounds never do, so the
// practice line names where the Piece is actually earned instead of promising one.
export const POWER_DICE_RULE_PERFECT = `All 3 correct = ${PUZZLE_PIECE_RULE_SHORT('daily')} 🧩`;
export const POWER_DICE_RULE_PERFECT_PRACTICE = 'All 3 correct = a Perfect Solve (Pieces: Challenge Daily only)';

// Verified winning examples. `dice` is the board array; `colors` is positional;
// `usedIndices` maps equation-order numbers → board index (ADR-0002). Every one
// is asserted =37 (and to the stated power-dice count) in data.test.js.
// A WIDELY VARIED bank of winning examples — exponents, single parentheses,
// multiple parenthesis groups, parenthetical exponents, division, and exactly
// ONE divide-by-itself "(n÷n)=1" trick (Daily D2). 3 Easy / 4 Challenge /
// 4 Daily. All engine-verified in data.test.js (=37, 7 dice, stated power count).
// Ordered to MATCH the rules card: Valid Solves first (the 2-of-3 baseline),
// Perfect Solves last (all 3) — L1-4. The cursor-animation demo picks the first
// PERFECT example (see HowToPlayPage's demoExample), so this order is display-only.
const BASE_EXAMPLES = {
  easy: [
    {
      label: 'Plain and simple — ×, +, −',
      equation: '6*6+1+1-1-1+1',
      dice: [6, 6, 1, 1, 1, 1, 1],
      usedIndices: [0, 1, 2, 3, 4, 5, 6],
      colors: EASY_DICE_COLORS,
      powerCorrect: 0,
    },
    {
      label: 'Nested parentheses + division',
      equation: '((6*3)+4+5)+5*4/2',
      dice: [6, 3, 4, 5, 5, 4, 2],
      usedIndices: [0, 1, 2, 3, 4, 5, 6],
      colors: EASY_DICE_COLORS,
      powerCorrect: 0,
    },
    {
      // 3B: an exponent example so Easy players see that style of equation.
      // 2⁵ = 32, then a tidy 5+4−3−2+1 run (=+5) → 37. Mixes + and − across
      // five different faces instead of five identical +1s. No power dice in Easy.
      label: 'An exponent — 2⁵',
      equation: '2^5+5+4-3-2+1',
      dice: [2, 5, 5, 4, 3, 2, 1],
      usedIndices: [0, 1, 2, 3, 4, 5, 6],
      colors: EASY_DICE_COLORS,
      powerCorrect: 0,
    },
  ],
  challenge: [
    {
      label: 'Two parenthesis groups',
      tag: 'VALID',
      equation: '(6+1)*5+(6-4)+1-1',
      dice: [1, 6, 4, 1, 5, 1, 6],
      usedIndices: [6, 0, 4, 1, 2, 3, 5],
      colors: POWER_DICE_COLORS,
      powerCorrect: 2,
    },
    {
      // 3D: second Valid Solve — blue ×, green +, red used as a plain term (not
      // as a power) → 2 of 3 power dice correct. board=[6,1,1,1,blue6,red2,green6].
      label: 'Two of three power dice',
      tag: 'VALID',
      equation: '6*6+6-2-1-1-1',
      dice: [6, 1, 1, 1, 6, 2, 6],
      usedIndices: [4, 0, 6, 5, 1, 2, 3],
      colors: POWER_DICE_COLORS,
      powerCorrect: 2,
    },
    {
      label: 'Exponent power — 6²',
      tag: 'PERFECT',
      equation: '6^2+3*1+1-2-1',
      dice: [6, 1, 1, 2, 3, 2, 1],
      usedIndices: [0, 5, 4, 1, 6, 3, 2],
      colors: POWER_DICE_COLORS,
      powerCorrect: 3,
    },
    {
      label: 'Parenthetical exponent — (6−1)²',
      tag: 'PERFECT',
      equation: '(6-1)^2+6*2+1-1',
      dice: [6, 1, 2, 1, 6, 2, 1],
      usedIndices: [0, 1, 5, 4, 2, 6, 3],
      colors: POWER_DICE_COLORS,
      powerCorrect: 3,
    },
  ],
  daily: [
    {
      label: 'Two parenthesis groups',
      tag: 'VALID',
      equation: '(5+1)*6+(4-3)+1-1',
      dice: [1, 4, 3, 1, 6, 1, 5],
      usedIndices: [6, 0, 4, 1, 2, 3, 5],
      colors: POWER_DICE_COLORS,
      powerCorrect: 2,
    },
    {
      // 3D: second Valid Solve — blue ×, green +, red added as a plain term (not
      // as a power) → 2 of 3 power dice correct. board=[6,1,1,2,blue5,red3,green6].
      label: 'Two of three power dice',
      tag: 'VALID',
      equation: '5*6+6+3+1-1-2',
      dice: [6, 1, 1, 2, 5, 3, 6],
      usedIndices: [4, 0, 6, 5, 1, 2, 3],
      colors: POWER_DICE_COLORS,
      powerCorrect: 2,
    },
    {
      label: 'Exponent + a parenthesis',
      tag: 'PERFECT',
      equation: '6^2+(6-5)*1+1-1',
      dice: [6, 6, 5, 1, 1, 2, 1],
      usedIndices: [0, 5, 1, 2, 4, 6, 3],
      colors: POWER_DICE_COLORS,
      powerCorrect: 3,
    },
    {
      label: 'The (3÷3)=1 trick',
      tag: 'PERFECT',
      equation: '6^2+(3/3)*1+1-1',
      dice: [6, 3, 1, 1, 3, 2, 1],
      usedIndices: [0, 5, 4, 1, 2, 6, 3],
      colors: POWER_DICE_COLORS,
      powerCorrect: 3,
    },
  ],
};

// Expert's bank is PERFECT-ONLY, because in Expert nothing else is a solve.
//
// It is DERIVED from the four all-three-correct examples already in the Challenge
// and Daily banks rather than hand-written, and that is deliberate: a hand-written
// "perfect" Expert example is exactly where a 2-of-3 would slip in and teach the
// wrong rule to the one mode whose entire premise is the perfect solve. Deriving
// it means every Expert example is checked by the same engine loop in
// data.test.js that already guards the others, and a filter cannot drift the way a
// copy can.
const EXPERT_EXAMPLES = [...BASE_EXAMPLES.challenge, ...BASE_EXAMPLES.daily]
  .filter((ex) => ex.powerCorrect === 3);

// Per-WIRE-KEY example banks. The three new keys reuse an existing bank rather
// than inventing one, because the BOARD is what an example teaches and the board
// is identical:
//   daily_easy   — the same seven white dice as Easy practice.
//   expert /
//   daily_expert — the same power-dice board as Challenge, judged more strictly.
export const WINNING_EXAMPLES = {
  ...BASE_EXAMPLES,
  expert: EXPERT_EXAMPLES,
  daily_easy: BASE_EXAMPLES.easy,
  daily_expert: EXPERT_EXAMPLES,
};

/**
 * The power-dice rule card, stated PER MODE — the rule genuinely differs and a
 * single constant was actively wrong for Expert.
 *
 * Challenge accepts any valid equation reaching 37 and merely DECORATES a perfect
 * one, so "at least 2 of the 3" is the honest bar. Expert only counts a perfect
 * solve, so "at least 2 of 3" would teach the opposite of the mode's whole point.
 *
 * `perfect` is null where there is no separate perfect REWARD to promise: in
 * Expert practice every solve is perfect by definition and practice rounds award
 * nothing. Where it is non-null the Piece wording comes from
 * `PUZZLE_PIECE_RULE_SHORT` (game-mechanics), the single source of the rule:
 * 1 Piece for a perfect Challenge Daily, 2 for an Expert Daily under 37 s.
 * Practice Challenge names the Daily instead of promising a Piece it never pays.
 *
 * @param {string} modeId a wire key from the game-modes vocabulary
 * @returns {{headline: string, perfect: string|null}}
 */
export const powerDiceRuleFor = (modeId) => {
  if (requiresPerfectSolve(modeId)) {
    return {
      headline: 'All 3 must be used correctly — in Expert, only a Perfect Solve counts.',
      perfect: modeId === 'daily_expert'
        ? `Every Expert Daily solve is Perfect. ${PUZZLE_PIECE_RULE_SHORT('daily_expert')} 🧩`
        : null,
    };
  }
  return {
    headline: POWER_DICE_RULE_HEADLINE,
    perfect: PUZZLE_PIECE_RULE_SHORT(modeId) ? POWER_DICE_RULE_PERFECT : POWER_DICE_RULE_PERFECT_PRACTICE,
  };
};

export const examplesForMode = (modeId) =>
  WINNING_EXAMPLES[modeId] || WINNING_EXAMPLES.daily;
