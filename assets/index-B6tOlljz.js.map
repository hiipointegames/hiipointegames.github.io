  // was indistinguishable from `trending-up` (Over the Top) at card size — two
  // badges wearing the same drawing. A fork plus fat stars reads as a star
  // figure; a chart line never forks.
  constellation: (
    <>
      <path d="M3.8 9.2 9.8 4.4 14.6 11.2 20.2 7.4" />
      <path d="M14.6 11.2 11.6 19.4" />
