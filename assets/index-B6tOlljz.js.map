// The rotating closing line: the dare just above the link in every share.
//
// Every candidate line is in rotation (David, 2026-09-29) and one is picked at
// random for EACH share. The chosen id travels with the share's personal link
// (share_links.closing_line), so the share_line_report view can compare lines by
// how many friends they bring in, and the best one becomes the default.
//
// ⚠️ IDs ARE DATA. Once shares exist, an id's meaning is fixed: rewording W3 after
// launch silently mixes two different lines' results under one id. Retire an id
// and add a new one instead. The id format is pinned by a CHECK constraint in
// supabase/migrations/20260929200000_share_links.sql (^[WL][0-9]{1,2}$).
//
// Every line ends in 👇 because it sits directly above the link it points at —
// the prize line goes ABOVE the closing line for exactly that reason.

/** @typedef {{ text: string, only?: 'easy'|'challenge'|'expert' }} ClosingLine */

/** Lines for a solved Daily. @type {Readonly<Record<string, ClosingLine>>} */
export const WIN_LINES = Object.freeze({
  W1: { text: '3 dice are hidden. Beat my time 👇' },
  W2: { text: 'Here are 4 of the 7 dice. Your move 👇' },
  W3: { text: 'Resets at midnight. Go 👇' },
  W4: { text: "Bet you can't beat it 👇" },
  W5: { text: 'Get the full puzzle in the app 👇' },
  W6: { text: '7 dice. Hit 37. Beat my time 👇' },
  W7: { text: 'Your move 👇' },
  // Was "Your clock starts when you tap" — untrue, the link opens a page, not a
  // timer. The Daily's clock starts when the friend chooses to start it.
  W8: { text: 'The clock starts when you do 👇' },
  W9: { text: 'Only a Perfect counts on Expert. You in? 👇', only: 'expert' },
});

/** Lines for a forfeited Daily. @type {Readonly<Record<string, ClosingLine>>} */
export const LOSS_LINES = Object.freeze({
  L1: { text: 'Bet it beats you too 👇' },
  L2: { text: 'Think you can finish it? 👇' },
  L3: { text: 'Your turn. Good luck 👇' },
  L4: { text: "Here's 4 of the dice. Bet it beats you too 👇" },
  L5: { text: 'Only a Perfect solve counts. Can you crack the code? 👇', only: 'expert' },
});

/**
 * The lines that may be used for this result and tier.
 * @param {'perfect'|'solved'|'forfeit'} result
 * @param {'easy'|'challenge'|'expert'} tier
 * @returns {string[]} ids, in declaration order
 */
export function eligibleLineIds(result, tier) {
  const pool = result === 'forfeit' ? LOSS_LINES : WIN_LINES;
  return Object.keys(pool).filter((id) => !pool[id].only || pool[id].only === tier);
}

/**
 * Pick one line at random. `rng` is injectable so tests are deterministic.
 * @param {'perfect'|'solved'|'forfeit'} result
 * @param {'easy'|'challenge'|'expert'} tier
 * @param {() => number} [rng] returns [0, 1)
 * @returns {string} a line id
 */
export function pickClosingLine(result, tier, rng = Math.random) {
  const ids = eligibleLineIds(result, tier);
  const r = rng();
  const i = Math.min(ids.length - 1, Math.max(0, Math.floor((Number.isFinite(r) ? r : 0) * ids.length)));
  return ids[i];
}

/**
 * The text for a line id, falling back to the pool's first line for an unknown id.
 * @param {string} id
 * @param {'perfect'|'solved'|'forfeit'} result
 * @returns {string}
 */
export function closingLineText(id, result) {
  const pool = result === 'forfeit' ? LOSS_LINES : WIN_LINES;
  return (pool[id] || pool[result === 'forfeit' ? 'L1' : 'W1']).text;
}
