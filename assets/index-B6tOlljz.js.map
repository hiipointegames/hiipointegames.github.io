// Shared operator input controller for ALL game modes
// Prevents race conditions, stale closures, and mobile tap issues

class OperatorInputController {
  constructor() {
    this.locked = false;
    this.insertFn = null;
    this.lastEventType = null;
  }

  /**
   * Called by the active EquationBuilder to register insertion handler
   * Safe to re-register (e.g., when Daily Challenge remounts)
   */
  registerInsertHandler(fn) {
    this.insertFn = fn;
  }

  /**
   * Single entry point for ALL operator button presses
   * Prevents multi-tap, race conditions, and stale state
   * Handles desktop (mouse) vs mobile (touch) differently
   */
  handleOperatorPress(operator, eventType = 'mouse') {
    if (this.locked) return;
    if (!this.insertFn) return;

    this.locked = true;
    this.lastEventType = eventType;

    // Atomic commit - timer ticks cannot interrupt this
    this.insertFn(operator);

    // 50ms buffer to prevent double-clicks while minimizing latency
    setTimeout(() => {
      this.locked = false;
    }, 50);
  }

  /**
   * Defensive reset (used when game forcibly ends or unmounts)
   */
  reset() {
    this.locked = false;
    this.insertFn = null;
    this.lastEventType = null;
  }
}

// Singleton instance shared across all game modes
export const operatorInputController = new OperatorInputController();