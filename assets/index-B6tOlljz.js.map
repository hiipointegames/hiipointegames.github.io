import React, { useEffect, useState } from 'react';

import { recordOutcome } from '@/observability';

import { claimReferral, fetchMyReferral } from './claimReferral';
import { REFERRAL_COPY, REFERRAL_MESSAGES, formatClaimUntil, referralSavedMessage } from './referralCopy';
import { useReferralsOn } from './useReferrals';

// "Invited by a friend?" on the profile (Edit Profile) — for the first 7 days of
// a new account (claims open to accounts created from 25 Oct 2026; the server
// decides, my_referral says).
//
//   switch off, unknown, or nothing to show → renders NOTHING
//   inviter recorded                         → "Invited by @name" (read-only)
//   can still claim                          → field + Save + "until <date>"
//
// Its own Save, separate from the form's "Save Changes": a claim is a server
// call with its own answer, and the form's save must never fail because of it.

/**
 * @param {{ deps?: { referralsOn?: boolean, fetchMine?: () => Promise<any>, claim?: (name: string) => Promise<any>, record?: Function, locale?: string } }} props
 */
export default function ReferralProfileField({ deps = {} }) {
  const on = useReferralsOn({ override: deps.referralsOn });
  const fetchMine = deps.fetchMine || fetchMyReferral;
  const claim = deps.claim || claimReferral;
  const record = deps.record || recordOutcome;

  const [mine, setMine] = useState(/** @type {{inviter: string|null, canClaim: boolean, claimUntil: string|null} | null} */ (null));
  const [name, setName] = useState('');
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState(/** @type {{ ok: boolean, text: string } | null} */ (null));

  useEffect(() => {
    if (!on) { setMine(null); return undefined; }
    let live = true;
    Promise.resolve().then(fetchMine).then((r) => { if (live) setMine(r || null); }, () => {});
    return () => { live = false; };
  }, [on, fetchMine]);

  if (!on || !mine) return null;

  if (mine.inviter) {
    return (
      <div data-testid="referral-profile" data-state="claimed" className="ml-1">
        <p className="text-white text-sm font-semibold">{REFERRAL_COPY.profileTitle}</p>
        <p data-testid="referral-invited-by" className="text-sm text-slate-300 mt-0.5">{REFERRAL_COPY.invitedBy(mine.inviter)}</p>
        {message?.ok && <p data-testid="referral-message" className="text-xs text-emerald-300 mt-1">{message.text}</p>}
      </div>
    );
  }
  if (!mine.canClaim) return null;

  const until = formatClaimUntil(mine.claimUntil, deps.locale);

  const save = async () => {
    if (busy || !name.trim()) return;
    setBusy(true);
    setMessage(null);
    const r = await claim(name);
    setBusy(false);
    if (r?.ok) {
      record('referral', 'ok', { step: 'profile' });
      setMessage({ ok: true, text: referralSavedMessage(r.username) });
      setMine({ ...mine, inviter: r.username, canClaim: false });
      return;
    }
    const reason = r?.reason in REFERRAL_MESSAGES ? r.reason : 'network';
    record('referral', reason, { step: 'profile' });
    setMessage({ ok: false, text: REFERRAL_MESSAGES[reason] });
  };

  return (
    <div data-testid="referral-profile" data-state="open">
      <label htmlFor="referral-profile-input" className="text-white text-sm mb-1.5 block font-semibold ml-1">
        {REFERRAL_COPY.profileTitle}{' '}
        <span className="text-slate-400 font-normal">{REFERRAL_COPY.profileLead}</span>
      </label>
      <div className="flex gap-2">
        <input
          id="referral-profile-input"
          data-testid="referral-profile-input"
          value={name}
          onChange={(e) => { setName(e.target.value); setMessage(null); }}
          placeholder={REFERRAL_COPY.stepPlaceholder}
          autoCapitalize="none"
          autoComplete="off"
          spellCheck={false}
          className="flex-1 min-w-0 bg-slate-800/70 border border-purple-400/50 text-white placeholder:text-slate-500 rounded-xl h-11 px-3"
        />
        <button
          type="button"
          data-testid="referral-profile-save"
          onClick={save}
          disabled={busy || !name.trim()}
          className="min-w-[72px] h-11 rounded-xl px-3 font-bold text-white bg-purple-600/80 disabled:opacity-50 touch-manipulation"
        >
          {busy ? REFERRAL_COPY.profileSaving : REFERRAL_COPY.profileSave}
        </button>
      </div>
      {until && <p data-testid="referral-until" className="text-xs text-slate-400 mt-1 ml-1">{REFERRAL_COPY.profileUntil(until)}</p>}
      {message && (
        <p data-testid="referral-message" role={message.ok ? undefined : 'alert'} className={`text-xs mt-1 ml-1 ${message.ok ? 'text-emerald-300' : 'text-red-300'}`}>
          {message.text}
        </p>
      )}
    </div>
  );
}
