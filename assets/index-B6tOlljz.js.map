// ScreenLinksContext — lets a HOST catch an info screen's links.
//
// With no provider (the normal app), there is no host: every link is a plain
// router link and `go()` / `back()` do what the old code did. A host — Sector
// 73's in-world frame, later — wraps the screens in <ScreenLinksProvider host>
// and gets first say on every target:
//
//   host.open(target) → true   the host opened it in place; the link does not navigate
//   host.open(target) → false  the host declined; the link navigates as usual
//   host.back()                one step back inside the host
//
// Leaf rule: imports only react / react-router-dom / @/routing/createPageUrl.

import React, { createContext, useCallback, useContext, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { hrefFor } from './hrefFor';

/**
 * @typedef {import('./hrefFor').ScreenTarget} ScreenTarget
 * @typedef {{ open: (target: ScreenTarget) => boolean, back: () => void }} ScreenLinksHost
 */

const ScreenLinksContext = createContext(/** @type {ScreenLinksHost | null} */ (null));

/**
 * Give every ScreenLink / useScreenLinks below this point a host.
 *
 * @param {{ host: ScreenLinksHost, children?: React.ReactNode }} props
 */
export function ScreenLinksProvider({ host, children }) {
  return <ScreenLinksContext.Provider value={host}>{children}</ScreenLinksContext.Provider>;
}

/** The host above this component, or null in the normal app. */
export function useScreenLinksHost() {
  return useContext(ScreenLinksContext);
}

/**
 * Programmatic navigation for info screens — replaces their `navigate()` calls.
 *
 * `go(target)`: the host opens it, or (no host / host declined) the router goes
 * to `hrefFor(target)` — the same URL the old `navigate()` call used.
 *
 * `back(fallback)`: the host steps back; with no host, `fallback()` runs — the
 * caller passes what it did before (e.g. ProfileBackButton's navigate), so the
 * app is unchanged.
 *
 * @returns {{ go: (target: ScreenTarget) => void, back: (fallback?: () => void) => void }}
 */
export function useScreenLinks() {
  const host = useContext(ScreenLinksContext);
  const navigate = useNavigate();
  const go = useCallback(
    (target) => {
      if (host && host.open(target)) return;
      navigate(hrefFor(target));
    },
    [host, navigate],
  );
  const back = useCallback(
    (fallback) => {
      if (host) {
        host.back();
        return;
      }
      fallback?.();
    },
    [host],
  );
  return useMemo(() => ({ go, back }), [go, back]);
}
