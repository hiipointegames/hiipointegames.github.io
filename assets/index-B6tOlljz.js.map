// Craft badge DERIVATION — replay a player's solve logs into earned-badge state.
//
// Badge System Redesign, Lane B. The counterpart to Lane D's Blitz derivation:
// same output contract (`{ earned, count, tier, earliestDate, … }`), different
// source. Lane D replays `head_to_head_challenges`; this replays the two SOLVE
// logs — `daily_challenge_times` (Daily) and `practice_solves` (Challenge).
//
// Layering (nothing here knows a threshold OR a rule):
//   "what shape was this solve?"      → @/equation-engine  craftPredicates.js (Lane A)
//   "what ladder does that feat use?" → @/game-mechanics   badgeRegistry.js   (Lane C)
//   the replay + the join (this file) → earned-badge state for the showcase
//
// RETROACTIVE BY CONSTRUCTION. Every badge below is derived from rows that
// already exist, so a player who has been solving since launch opens the
// showcase already decorated. `earliestDate` is the date of their earliest
// qualifying solve — the UI compares it to the feature's launch date to stamp
// a badge "Earned Retroactively".
//
// PLAYER-PARAMETERIZED, like Lane D. The showcase renders on your own
// Statistics page AND on another player's (`Statistics?id=` / the OtherProfile
// card), so the pure core takes rows and NOTHING here reads the signed-in user
// except as the fetcher's default argument.
//
// MODE SPLIT. A craft feat earned on the Daily and the same feat earned in
// Challenge free-play are SEPARATE collectibles (David, 2026-07-30) — the Daily
// wears the marquee name, Challenge the practice name. Same detection, two
// results, so this module derives each mode independently and never merges them.
// Easy has no power dice, so no CRAFT feat is reachable there.
//
// BEYOND CRAFT. The same replay also derives the three tracks that read the same
// logs but aren't power-dice feats — the Easy On-Ramp, the Challenge Dojo volume
// ladders, and the mode-agnostic Firsts. They emit the identical state shape, so
// the showcase renders every card from one map. The Firsts are down to two
// (`firstSolve`, `firstPerfect`) since Round 2 § DEDUPE retired `firstPodium`
// here and `firstBlitzWin` in the Blitz lane as duplicates of a ladder's first
// rung — see deriveFirstTimeBadges for which survived and why.
//
// The rows are already-SUBMITTED solves, i.e. the engine validated them at write
// time. So nothing here re-gates on validity — it only asks "what shape was it?".
// Malformed rows (missing equation, junk dice arrays) are skipped, never thrown
// on: one bad historical row must not blank a player's whole showcase.

import { apiClient } from '@/transport';
import { isWarpEquation, hasWarpRow, isSector73Enabled } from '@/sector73';
import { getBadgeForFeat, badgeTierIndex, nextTierTarget, CRAFT_FAMILIES } from '@/game-mechanics';
import {
  isPerfectSolve,
  parenGroupCount,
  maxParenDepth,
  usesAllFourOps,
  usesExponent,
  maxIntermediateMagnitude,
} from '@/equation-engine';
// The craft RUNG table. Split out with the 2026-09-03 family merge — see the
// header of ./craftStages.js for why it is not in this file.
import { solveFacts, highestStageReached, qualifiesForFamily, stagesForMode } from './craftStages';
import { countTierReachedDate, thresholdTierReachedDate } from './tierReachedDate';
import {
  selectPracticeSolves, selectPracticeTier, selectChallengeSolves,
  selectEasySolves, selectChallengeDailyRows, selectDailyRows,
} from './craftRowSelectors';

// Re-exported so the row selectors stay on THIS module's public surface: they
// were part of it before the 2026-09-04 extraction and several callers and
// tests import them from here.
export {
  selectPracticeSolves, selectPracticeTier, selectChallengeSolves,
  selectEasySolves, selectChallengeDailyRows, selectDailyRows,
};

/**
 * The registry modes this module derives against. `easy` is the On-Ramp track and
 * `any` the mode-agnostic Firsts; both key their registry entry by bare featId.
 * @typedef {import('@/game-mechanics/badgeRegistry').BadgeMode} BadgeSourceMode
 */

/**
 * @typedef {Object} CraftBadgeState
 * @property {string} featId       Canonical detection key (shared with Lanes A/C/D).
 * @property {string} badgeId      Registry ENTRY id — `<featId>Daily` / `<featId>Challenge`
 *                                 for the mode-split craft feats, `featId` otherwise.
 * @property {BadgeSourceMode} mode
 * @property {boolean} earned
 * @property {number} count        Qualifying solves. Includes the perfect ones —
 *                                 a perfect qualifying solve advances BOTH the base
 *                                 badge and its Perfect variant.
 * @property {number} perfectCount How many of those `count` solves were also perfect.
 * @property {number} tier         Highest 0-based ladder tier reached; -1 = unearned
 *                                 (the same sentinel Lane D uses).
 * @property {string|null} earliestDate  YYYY-MM-DD of the earliest qualifying solve.
 * @property {string|null} tierReachedDate YYYY-MM-DD the CURRENT tier was reached (the
 *                                 Nth qualifying solve for a count ladder, the first
 *                                 solve to meet the rung for a threshold/stage ladder);
 *                                 null when unearned or a needed day is missing.
 *                                 Announcement + "Just earned" judge recency by this.
 * @property {number|null} value   The ladder value behind `tier` for a thresholdLadder
 *                                 badge (magnitude, echo multiple); null for count ladders.
 * @property {number} progressValue The number judged against the ladder — `count` for a
 *                                 countLadder, `value` for a thresholdLadder. Pairs with
 *                                 `nextTarget` to render the "So close" row (120 / 125)
 *                                 without the UI recomputing anything.
 * @property {number|null} nextTarget The next rung to chase, or null when maxed out.
 */

/**
 * @typedef {Object} SolveRow
 * @property {string} [user_id]
 * @property {string} [date]
 * @property {string} [equation]
 * @property {number[]} [usedDiceIndices]
 * @property {string[]} [diceColors]
 * @property {number[]} [shuffledDice]
 * @property {number} [solve_time_seconds]
 * @property {string} [mode]
 */

/**
 * Every base craft featId this module derives, in showcase order. Eight families
 * since the 2026-09-03 merge — see ./craftStages.js and game-mechanics/craftFeats.js
 * for what the other nine were folded into. (No leading path alias in this
 * docblock on purpose: tsc reads a bare `@` in JSDoc as the start of a tag and
 * fails to parse the slash after it.)
 */
export const CRAFT_FEAT_IDS = Object.freeze(CRAFT_FAMILIES.map((f) => f.featId));

/**
 * Feats that genuinely exist on the Daily track ONLY.
 *
 * The perfect variants used to be listed here, then were removed 2026-08-02 when
 * they followed the perfect-solve mechanic into Challenge. The merge retired
 * them outright: each is now the top RUNG of the family it shadowed. A broken
 * streak is still a Daily concept, so Comeback Kid remains genuinely single-mode
 * — and the flattened-index contract below reads this list to assert
 * `badgeId === featId`, which only holds for a genuinely single-mode feat.
 */
export const DAILY_ONLY_FEAT_IDS = Object.freeze(['comebackKid']);

// ---------------------------------------------------------------------------
// Row hygiene
// ---------------------------------------------------------------------------

/** A recorded (non-zero, finite) solve time. 0 = never recorded, not instant. */
const isRecordedTime = (seconds) =>
  typeof seconds === 'number' && Number.isFinite(seconds) && seconds > 0;

/**
 * The YYYY-MM-DD day a row belongs to, or null if it has no usable date.
 * Accepts a bare date or a timestamp prefix — both shapes exist in the logs.
 *
 * @param {unknown} value
 * @returns {string|null}
 */
export function solveDayKey(value) {
  if (typeof value !== 'string') return null;
  const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(value);
  return match ? `${match[1]}-${match[2]}-${match[3]}` : null;
}

/**
 * The calendar day before a YYYY-MM-DD key. Pure string→string arithmetic done
 * in UTC so it can never slide a day under a local timezone.
 *
 * @param {string} dayKey
 * @returns {string|null}
 */
export function previousDayKey(dayKey) {
  if (typeof dayKey !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(dayKey)) return null;
  const [year, month, day] = dayKey.split('-').map(Number);
  const stamp = Date.UTC(year, month - 1, day) - 86400000;
  const prior = new Date(stamp);
  const pad = (n) => String(n).padStart(2, '0');
  return `${prior.getUTCFullYear()}-${pad(prior.getUTCMonth() + 1)}-${pad(prior.getUTCDate())}`;
}

/**
 * Keep only rows this module can actually read: a non-empty equation string.
 * Everything else (missing dice arrays, junk types) the Lane A predicates already
 * degrade on safely, so it does not need a guard here.
 *
 * @param {unknown} rows
 * @returns {SolveRow[]}
 */
function usableRows(rows) {
  if (!Array.isArray(rows)) return [];
  return rows.filter(
    (row) => !!row && typeof row === 'object' && typeof row.equation === 'string' && row.equation.length > 0,
  );
}

// ---------------------------------------------------------------------------
// The join: accumulated facts + registry ladder → one badge's state
// ---------------------------------------------------------------------------

/**
 * @param {string} featId
 * @param {BadgeSourceMode} mode
 * @param {CraftFacts} facts
 * @returns {CraftBadgeState}
 */
function badgeState(featId, mode, facts) {
  const { count, perfectCount, bestValue, earliestDate } = facts;
  const badge = getBadgeForFeat(featId, mode);
  // Three ladder models, two ways of being judged. A countLadder asks "how many
  // times"; a thresholdLadder asks "how big"; a stageLadder asks "how high up the
  // rungs" and reports that as its value, which is why it shares the value arm.
  const type = badge?.scaling?.type;
  const judgedOnValue = type === 'thresholdLadder' || type === 'stageLadder';
  const ladderInput = judgedOnValue ? bestValue : count;
  const judged = ladderInput === null || ladderInput === undefined ? NaN : ladderInput;
  const tier = badgeTierIndex(badge, judged);

  return {
    featId,
    badgeId: badge?.id ?? featId,
    mode,
    earned: tier >= 0,
    count,
    perfectCount,
    tier,
    earliestDate,
    tierReachedDate: tierReachedDay(badge, type, tier, facts),
    // `value` is the MEASURE behind the tier, so only a threshold ladder has one.
    // A stage ladder's `bestValue` is a rung ordinal — an index, not a magnitude
    // — and surfacing it as `value` would let the UI render "Best: 4".
    value: type === 'thresholdLadder' ? (bestValue ?? null) : null,
    progressValue: Number.isFinite(judged) ? /** @type {number} */ (judged) : 0,
    nextTarget: Number.isFinite(judged) ? nextTierTarget(badge, /** @type {number} */ (judged)) : firstTier(badge),
  };
}

/** The opening rung of a ladder — what an unearned badge is chasing. */
function firstTier(badge) {
  const tiers = badge?.scaling?.tiers;
  return Array.isArray(tiers) && tiers.length > 0 ? tiers[0] : null;
}

/**
 * The day the CURRENT tier was reached — see ./tierReachedDate. A one-time badge
 * is reached by its first event, so its answer is `earliestDate`.
 *
 * @param {any} badge
 * @param {string|undefined} type
 * @param {number} tier
 * @param {CraftFacts} facts
 * @returns {string|null}
 */
function tierReachedDay(badge, type, tier, facts) {
  if (tier < 0) return null;
  if (type === 'stageLadder') return facts.stageReachedDate ?? null;
  if (type === 'countLadder') {
    return countTierReachedDate(facts.events.map((e) => e.day), badge?.scaling?.tiers?.[tier]);
  }
  if (type === 'thresholdLadder') {
    return thresholdTierReachedDate(facts.events, (value) => badgeTierIndex(badge, value) >= tier);
  }
  return facts.earliestDate;
}

/**
 * One feat's accumulator. `events` keeps every qualifying solve's day (and
 * value) so the tier-reached day can be found; `stageReachedDate` is filled in
 * by the stage-ladder replay, which alone knows which rung each solve hit.
 *
 * @typedef {{count:number, perfectCount:number, bestValue:number|null, earliestDate:string|null,
 *   events: Array<{day:string|null, value:number|null}>, stageReachedDate?: string|null}} CraftFacts
 */

/** A fresh accumulator for one feat. @returns {CraftFacts} */
const emptyFacts = () => ({ count: 0, perfectCount: 0, bestValue: null, earliestDate: null, events: [] });

/**
 * Fold one qualifying solve into a feat's accumulator. `earliestDate` tracks the
 * minimum day key rather than the first row seen, because neither log is
 * guaranteed to come back sorted.
 *
 * @param {CraftFacts} facts
 * @param {{day:string|null, perfect:boolean, value?:number|null}} solve
 */
function foldQualifying(facts, { day, perfect, value = null }) {
  facts.count += 1;
  facts.events.push({ day: day || null, value });
  if (perfect) facts.perfectCount += 1;
  if (value !== null && (facts.bestValue === null || value > facts.bestValue)) facts.bestValue = value;
  if (day && (facts.earliestDate === null || day < facts.earliestDate)) facts.earliestDate = day;
}

// ---------------------------------------------------------------------------
// The replay
// ---------------------------------------------------------------------------

/**
 * Replay ONE mode's solve rows into that mode's craft badges.
 *
 * This is the literal Lane B contract: rows in, `{ [featId]: CraftBadgeState }`
 * out. Daily additionally gets Comeback Kid — a broken Daily streak is a Daily
 * concept — via {@link deriveCraftBadgeState}; call this directly for the shared
 * craft catalog alone.
 *
 * SINCE THE 2026-09-03 MERGE this walks eight FAMILIES rather than seventeen
 * feats, and each family's ladder is a list of RUNGS instead of one number. The
 * shape of the answer is unchanged — the same `CraftBadgeState` per featId — but
 * `progressValue` is now a rung ordinal for these badges, which is exactly what
 * their registry `stageLadder` tiers are numbered in. See ./craftStages.js.
 *
 * @param {SolveRow[]} rows - one mode's already-valid solve rows
 * @param {BadgeSourceMode} mode - `dailyEasy` / `daily` / `dailyExpert` / `challenge` / `expert`
 * @returns {Record<string, CraftBadgeState>}
 */
export function deriveModeCraftBadges(rows, mode) {
  // Every shape question answered ONCE per row rather than once per rung: a
  // merged family asks five or six of them, and eight families over the same
  // rows would otherwise re-parse each equation forty times.
  const solves = usableRows(rows).map((row) => ({ day: solveDayKey(row.date), facts: solveFacts(row) }));

  /** @type {Record<string, CraftBadgeState>} */
  const state = {};
  for (const family of CRAFT_FAMILIES) {
    // PER-MODE RUNGS (2026-09-04). Easy prunes the power-dice rungs; Expert
    // shows only the perfect rung laddered by repetition. An empty list means
    // the family has no badge in this mode at all — The Great Divide and Rise to
    // Power are unreachable in Easy — so it is skipped rather than derived
    // against rungs no card will ever show.
    const stages = stagesForMode(family.featId, mode);
    if (stages.length === 0) continue;
    const accumulated = emptyFacts();
    const qualifying = [];
    const qualifyingDays = [];
    for (const { day, facts } of solves) {
      if (!qualifiesForFamily(facts, stages)) continue;
      qualifying.push(facts);
      qualifyingDays.push(day);
      foldQualifying(accumulated, { day, perfect: facts.perfect });
    }
    // The ladder input for a stage ladder is the highest rung reached, 1-based.
    // 0 means "not on the ladder", which `badgeTierIndex` reads as tier -1
    // against the ordinal tiers `[1..n]` — the same unearned sentinel as before.
    accumulated.bestValue = highestStageReached(qualifying, stages);
    // …and that rung was reached on the day of its `atLeast`-th hit.
    const top = stages[accumulated.bestValue - 1];
    accumulated.stageReachedDate = top
      ? countTierReachedDate(qualifyingDays.filter((_, i) => top.test(qualifying[i])), top.atLeast ?? 1)
      : null;
    state[family.featId] = badgeState(family.featId, mode, accumulated);
  }
  return state;
}

/**
 * Comeback Kid — solve the Daily the day after a broken streak.
 *
 * A streak breaks by MISSING a day, so the comeback is any Daily solve whose
 * immediately-preceding calendar day has no solve AND which has an earlier solve
 * behind it. The very first solve of a player's life is therefore never a
 * comeback (there was no streak to break), and the size of the gap does not
 * matter — missing one day and missing thirty both break the same streak.
 *
 * Works off DISTINCT days: the Daily is one puzzle per date, so a duplicate row
 * must not mint a second badge.
 *
 * @param {SolveRow[]} rows - daily_challenge_times rows for one player
 * @returns {CraftBadgeState}
 */
export function deriveComebackKid(rows) {
  const days = [...new Set(usableRows(rows).map((r) => solveDayKey(r.date)).filter(Boolean))].sort();
  const solved = new Set(days);

  const facts = emptyFacts();
  // Skip index 0: the earliest solve has no prior streak to have broken.
  for (let i = 1; i < days.length; i++) {
    const day = days[i];
    if (solved.has(previousDayKey(day))) continue;
    foldQualifying(facts, { day, perfect: false });
  }
  return badgeState('comebackKid', 'daily', facts);
}

// ---------------------------------------------------------------------------
// On-Ramp (Easy), Dojo (Challenge volume) and Firsts
//
// Not craft feats — Easy has no power dice, the Dojo ladders pure volume, and the
// Firsts are mode-agnostic — but they read the SAME logs and hand back the SAME
// `CraftBadgeState` shape, so the showcase renders every card from one map with
// no special-casing. They live here rather than in a fourth module because they
// share this file's row hygiene, its accumulator and its registry join.
// ---------------------------------------------------------------------------

// "Genius" is the sub-minute Daily solve. Same number as LIGHTNING_SECONDS and
// deliberately a separate constant: one is a speed badge on the Daily, the other
// a clause of Lightning Divide, and retuning either must not move the other.
const GENIUS_SECONDS = 60;

// Deep Nest — a bracket INSIDE a bracket. Deliberately its own constant and NOT
// shared with craft's Event Horizon (depth 3): the two are one ladder climbing
// across the tabs, and retuning the Easy rung must not move the Daily one.
const DEEP_NEST_DEPTH = 2;

/** One row's perfect verdict — all three power dice used correctly. */
const rowIsPerfect = (row) => isPerfectSolve(row.equation, row.usedDiceIndices, row.diceColors) === true;

/** A Daily solve under the minute. 0 = time never recorded, so it can't qualify. */
const rowIsGenius = (row) =>
  isRecordedTime(row.solve_time_seconds) && row.solve_time_seconds < GENIUS_SECONDS;

/**
 * Accumulate one badge's facts over already-hygienic rows.
 *
 * @param {SolveRow[]} rows
 * @param {(row: SolveRow) => boolean} [test] which rows qualify (default: all)
 * @param {(row: SolveRow) => boolean} [perfectTest] which qualifying rows were
 *   also perfect. Defaults to "none" — right for every badge here whose
 *   qualification ignores the power dice entirely.
 */
function countFacts(rows, test = () => true, perfectTest = () => false) {
  const facts = emptyFacts();
  for (const row of rows) {
    if (!test(row)) continue;
    foldQualifying(facts, { day: solveDayKey(row.date), perfect: perfectTest(row) });
  }
  return facts;
}

/**
 * One THRESHOLD badge's state — judged on a measured VALUE rather than on
 * qualifying at all. Mirrors the threshold arm of `deriveModeCraftBadges`:
 * measure per row, drop anything below the registry's opening rung, fold the
 * value so `foldQualifying` keeps the maximum. Factored out because the On-Ramp
 * needs it too (Round Trip) and must not re-derive the tier-0 rule by hand.
 *
 * @param {string} featId
 * @param {BadgeSourceMode} mode
 * @param {SolveRow[]} rows
 * @param {(row: SolveRow) => number} measure
 * @returns {CraftBadgeState}
 */
function thresholdBadgeState(featId, mode, rows, measure) {
  const badge = getBadgeForFeat(featId, mode);
  const facts = emptyFacts();
  for (const row of rows) {
    const value = measure(row);
    if (!Number.isFinite(value)) continue;
    if (badgeTierIndex(badge, value) < 0) continue;
    foldQualifying(facts, { day: solveDayKey(row.date), perfect: false, value });
  }
  return badgeState(featId, mode, facts);
}

/**
 * Best-single-DAY volume → facts, for Marathon. A high-water mark, so it is a
 * THRESHOLD ladder and `badgeState` judges it on `bestValue`.
 *
 * It needs its OWN accumulator rather than `thresholdBadgeState` because the two
 * fields want different day sets, and one gate is wrong for one of them:
 *   - `bestValue` folds EVERY day. The Locked grid renders "4 / 15" off this and
 *     exists to show how close you are; gating it on tier 0 (as the shared
 *     helper does) made an unearned Marathon read "0 / 15" for a player who had
 *     already solved four times that day — the blank the grid exists to avoid.
 *   - `earliestDate`/`count` fold only QUALIFYING days: the date stamps the
 *     "Earned Retroactively" ribbon, and the first day someone opened Easy is
 *     not the day they earned a 15-solve badge.
 *
 * Derived, never stored — read off the `date` column every row already carries.
 * No session counter, no mirror to drift from the log (docs/bugs.md).
 *
 * @param {SolveRow[]} rows
 */
function bestDayFacts(rows) {
  /** @type {Map<string, number>} */
  const perDay = new Map();
  for (const row of rows) {
    const day = solveDayKey(row.date);
    if (!day) continue; // an undated row belongs to no day, so it counts toward none
    perDay.set(day, (perDay.get(day) ?? 0) + 1);
  }

  const badge = getBadgeForFeat('marathon', 'easy');
  const facts = emptyFacts();
  for (const [day, solves] of perDay) {
    if (facts.bestValue === null || solves > facts.bestValue) facts.bestValue = solves;
    if (badgeTierIndex(badge, solves) < 0) continue;
    facts.count += 1;
    facts.events.push({ day, value: solves });
    if (facts.earliestDate === null || day < facts.earliestDate) facts.earliestDate = day;
  }
  return facts;
}

/**
 * Read `{first, second, third}` podium counts off whatever the caller has —
 * a `game_stats` blob (camelCase or snake_case) or the counts map itself.
 * Junk, negatives and non-numbers all normalize to 0.
 *
 * Its consumer is now `deriveExistingBadgeState` (the three podium LADDERS), not
 * anything in this file: § DEDUPE retired `firstPodium`, which was the local
 * caller. Left here rather than moved so the podium ladders' one normalizer
 * keeps its id and its tests; moving it is a separate refactor.
 *
 * @param {unknown} source
 * @returns {{first:number, second:number, third:number}}
 */
export function normalizePodiumFinishes(source) {
  const blob = /** @type {Record<string, any> | null | undefined} */ (source);
  const raw = blob?.podiumFinishes ?? blob?.podium_finishes ?? blob;
  const read = (key) => {
    const value = Number(raw?.[key]);
    return Number.isFinite(value) && value > 0 ? value : 0;
  };
  return { first: read('first'), second: read('second'), third: read('third') };
}

/**
 * The Easy On-Ramp track — volume, first-times, and the bridge up to Challenge.
 *
 * `levelingUp` is derived from CHALLENGE rows but belongs to the Easy map: it is
 * the "you're ready for the next mode" badge, so it sits where the player is
 * standing when it motivates them (registry mode `easy`, Lane C).
 *
 * @param {SolveRow[]} [easyRows]
 * @param {SolveRow[]} [challengeRows]
 * @returns {Record<string, CraftBadgeState>}
 */
export function deriveOnRampBadges(easyRows = [], challengeRows = []) {
  const easy = usableRows(easyRows);
  const challenge = usableRows(challengeRows);
  const volume = countFacts(easy);

  // `firstSteps` was CUT in Round 2 § D3 — "your first Easy solve" and
  // `firstSolve`'s "your very first solve, in any mode" were one feat wearing
  // two cards, and `firstSolve` (derived below, from every mode's rows) is the
  // strict superset that keeps every earned shield lit.
  //
  // Round 2 § D7 added the four below. All read the SAME stored equation string
  // (or date) the four above already read, so all are retroactive. Their
  // predicates are colour-blind by construction — none looks at `diceColors`,
  // which is why they work unchanged on an all-white Easy row.
  return {
    gettingTheHangOfIt: badgeState('gettingTheHangOfIt', 'easy', volume),
    bracketRookie: badgeState('bracketRookie', 'easy', countFacts(easy, (r) => parenGroupCount(r.equation) > 0)),
    everyWhichWay: badgeState('everyWhichWay', 'easy', countFacts(easy, (r) => usesAllFourOps(r.equation))),
    tower: badgeState('tower', 'easy', countFacts(easy, (r) => usesExponent(r.equation))),
    deepNest: badgeState('deepNest', 'easy', countFacts(easy, (r) => maxParenDepth(r.equation) >= DEEP_NEST_DEPTH)),
    roundTrip: thresholdBadgeState('roundTrip', 'easy', easy, (r) => maxIntermediateMagnitude(r.equation)),
    marathon: badgeState('marathon', 'easy', bestDayFacts(easy)),
    levelingUp: badgeState('levelingUp', 'easy', countFacts(challenge)),
  };
}

/**
 * The Challenge Dojo — free-play volume ladders, sitting alongside (not instead
 * of) the craft catalog's Challenge entries.
 *
 * @param {SolveRow[]} [challengeRows]
 * @returns {Record<string, CraftBadgeState>}
 */
export function deriveDojoBadges(challengeRows = []) {
  const challenge = usableRows(challengeRows);
  return {
    cadetPilotCommander: badgeState('cadetPilotCommander', 'challenge', countFacts(challenge)),
    freePlayPerfectionist: badgeState(
      'freePlayPerfectionist', 'challenge',
      countFacts(challenge, rowIsPerfect, () => true),
    ),
  };
}

/**
 * The first-time shields — one-time badges whose DERIVATION reads across modes
 * even though each one now DISPLAYS on a single mode tab.
 *
 * Round 2 § D3 deleted the `firsts` category and the Firsts tab; the badges
 * moved to the mode they are earned in, which is the `mode` stamped on each
 * state below (it must match the registry entry, and a test pins that):
 *   - `firstSolve`   → `easy`   (the On-Ramp's entry rung; still derived from
 *                                EVERY mode's rows, exactly as its criteria say)
 *   - `firstPerfect` → `daily`  (Daily + Challenge logs only — Easy has no
 *                                power dice, so an Easy row is never perfect)
 *
 * Both SURVIVE § DEDUPE, and `firstPerfect` deliberately so: it fires on ONE
 * perfect solve, where the nearest ladder rung (`puzzlePieceBadge` Bronze) is
 * 37 puzzle points. Retiring it would strip the card from every player sitting
 * on 1–36 perfect solves — the retro-UNSAFE direction. It is not the shape the
 * two retired shields were.
 *
 * `firstGenius` is GONE (§ D2/D3): "your first solve under 60 seconds", derived
 * from the Daily log, was precisely the 1:00 rung of the Daily-only Speed
 * ladder. It is now that rung's NAME (Genius) rather than a second card.
 *
 * `firstPodium` is GONE (§ DEDUPE): it fired on the OR of the three podium
 * ladders at tier 0, off the very counts this module handed them. Every holder
 * still has whichever place they finished, on the ladder card that counts it.
 * With it went this function's `podiumFinishes` input — the last reason the
 * craft derivation read `get-player-stats` at all.
 *
 * `firstBlitzWin` is NOT derived here — it belonged to the Blitz lane, and
 * § DEDUPE retired it there for the same reason (see blitzBadgeDerivation.js).
 *
 * @param {{dailyRows?: SolveRow[], challengeRows?: SolveRow[], easyRows?: SolveRow[]}} [input]
 * @returns {Record<string, CraftBadgeState>}
 */
export function deriveFirstTimeBadges({ dailyRows = [], challengeRows = [], easyRows = [] } = {}) {
  const daily = usableRows(dailyRows);
  const challenge = usableRows(challengeRows);
  const easy = usableRows(easyRows);
  const withPowerDice = [...daily, ...challenge];

  return {
    firstSolve: badgeState('firstSolve', 'easy', countFacts([...withPowerDice, ...easy])),
    firstPerfect: badgeState('firstPerfect', 'daily', countFacts(withPowerDice, rowIsPerfect, () => true)),
  };
}

/**
 * The whole craft badge set for one player — both modes, kept separate.
 *
 * Returned several ways because the showcase needs both keyings and neither is a
 * superset of the other:
 *   `daily` / `challenge` / `easy` — `{ [featId]: state }`, the canonical Lane B
 *                           contract, one map per registry MODE (featIds collide
 *                           across modes by design). `challenge` carries the craft
 *                           entries AND the Dojo ladders; `easy` is the On-Ramp.
 *   `firstTimes`          — the cross-mode one-time shields. Kept as its own map
 *                           because it is a SOURCE grouping (these read every
 *                           mode's rows at once), not a display grouping — the
 *                           `firsts` CATEGORY it used to mirror is gone (§ D3).
 *   `byBadgeId`           — every entry flattened under its REGISTRY id
 *                           (`greatDivideDaily`, `greatDivideChallenge`, `supernova`,
 *                           `firstSolve`…), which is what a card grid renders against.
 *
 * @param {{dailyRows?: SolveRow[], challengeRows?: SolveRow[], easyRows?: SolveRow[],
 *          dailyEasyRows?: SolveRow[], dailyExpertRows?: SolveRow[], expertRows?: SolveRow[],
 *          sector73?: boolean}} [input] `sector73`: is Sector 73 switched on? Off (the default)
 *          derives no Looking Glass at all, so it can never be shown, counted or celebrated.
 * @returns {{dailyEasy: Record<string, CraftBadgeState>,
 *            dailyExpert: Record<string, CraftBadgeState>,
 *            expert: Record<string, CraftBadgeState>,
 *            daily: Record<string, CraftBadgeState>,
 *            challenge: Record<string, CraftBadgeState>,
 *            easy: Record<string, CraftBadgeState>,
 *            firstTimes: Record<string, CraftBadgeState>,
 *            byBadgeId: Record<string, CraftBadgeState>}}
 */
export function deriveCraftBadgeState({
  dailyRows = [], challengeRows = [], easyRows = [],
  dailyEasyRows = [], dailyExpertRows = [], expertRows = [], sector73 = false,
} = {}) {
  // FIVE craft cells now, not two (2026-09-04). Each Daily tier and each
  // power-dice practice tier is judged against its OWN rungs — see
  // `stagesForMode`. Comeback Kid stays Challenge-Daily-only: it is about a
  // broken streak, and the Challenge Daily is where the streak prestige lives.
  const dailyEasy = deriveModeCraftBadges(dailyEasyRows, 'dailyEasy');
  const daily = deriveModeCraftBadges(dailyRows, 'daily');
  daily.comebackKid = deriveComebackKid(dailyRows);
  // Looking Glass — Sector 73's Mirror, crossed from ANY tier's Daily. Only while Sector 73 is on.
  if (sector73) daily.lookingGlass = badgeState('lookingGlass', 'daily', countFacts(
    [...dailyEasyRows, ...dailyRows, ...dailyExpertRows],
    (r) => isWarpEquation(r.equation),
  ));
  const dailyExpert = deriveModeCraftBadges(dailyExpertRows, 'dailyExpert');
  const challenge = { ...deriveModeCraftBadges(challengeRows, 'challenge'), ...deriveDojoBadges(challengeRows) };
  const expert = deriveModeCraftBadges(expertRows, 'expert');

  // TWO BADGES ARE DELIBERATELY CROSS-TIER and must keep seeing every
  // power-dice practice row, Expert included:
  //   `levelingUp`  — "you stepped off Easy". Stepping up to Expert is stepping
  //                   off Easy at least as much as stepping up to Challenge is.
  //   `firstPerfect`— "your first perfect solve, in any mode". Expert solves are
  //                   ALL perfect, so excluding them would be perverse.
  // Splitting Challenge and Expert into their own craft cells nearly took these
  // two down with them; the pooled list is passed explicitly so the intent is
  // visible rather than implied by an argument's name.
  const powerPracticeRows = [...challengeRows, ...expertRows];
  const easy = deriveOnRampBadges(easyRows, powerPracticeRows);
  const firstTimes = deriveFirstTimeBadges({ dailyRows, challengeRows: powerPracticeRows, easyRows });

  /** @type {Record<string, CraftBadgeState>} */
  const byBadgeId = {};
  for (const state of [
    ...Object.values(dailyEasy), ...Object.values(daily), ...Object.values(dailyExpert),
    ...Object.values(challenge), ...Object.values(expert),
    ...Object.values(easy), ...Object.values(firstTimes),
  ]) {
    byBadgeId[state.badgeId] = state;
  }
  return { dailyEasy, daily, dailyExpert, challenge, expert, easy, firstTimes, byBadgeId };
}

// ---------------------------------------------------------------------------
// Fetch (thin) — the same fetch/derive split the rest of stats-aggregation uses
// ---------------------------------------------------------------------------


/**
 * Fetch + derive ANY player's craft badge state.
 *
 * Cross-player by construction — the showcase renders on your own Statistics
 * page and on another player's (`Statistics?id=` / the OtherProfile card), so
 * `userId` is an explicit argument and the signed-in user is only the default.
 * Both sources are readable for any authenticated viewer (`daily_challenge_times`
 * is the world-readable leaderboard log; `practice_solves` read policy is
 * `using(true)`), so this needs no backend change.
 *
 * A full client-side log scan per player, like fastestPerfect.js — correct today,
 * and the same candidate for an aggregation edge function as the logs grow.
 *
 * A failed read degrades that ONE source to empty rather than throwing: a broken
 * practice-solves read must not blank the Daily half of a player's showcase.
 *
 * @param {string} [userId] - target player; defaults to the signed-in user
 * @returns {Promise<ReturnType<typeof deriveCraftBadgeState>>}
 */
export async function getCraftBadgeState(userId) {
  const targetId = userId || (await apiClient.auth.me())?.id;
  if (!targetId) return deriveCraftBadgeState();

  // TWO reads, not three. The third was `get-player-stats`, fetched purely for
  // `firstPodium`'s podium counts; § DEDUPE retired that badge, so the whole
  // edge call went with it. The podium LADDERS still read those counts — they
  // always did so through `getExistingBadgeState`, which the pages call
  // alongside this one, so nothing lost a source.
  const [dailyRows, practiceRows] = await Promise.all([
    readRows(() => apiClient.entities.DailyChallengeTime.filter({ user_id: targetId }), 'daily_challenge_times'),
    readRows(() => apiClient.entities.PracticeSolve.filter({ user_id: targetId }), 'practice_solves'),
  ]);

  // The switch is read only when it could matter — a 73 row — so a player without one
  // (everyone, while prod refuses a 73) costs no extra request.
  const sector73 = hasWarpRow(dailyRows) && await isSector73Enabled();

  return deriveCraftBadgeState({
    sector73,
    // Each tier ROUTED to its own badges rather than one tier being kept and the
    // other two dropped. See selectDailyRows / selectPracticeTier.
    dailyEasyRows: selectDailyRows(dailyRows, 'daily_easy'),
    dailyRows: selectDailyRows(dailyRows, 'daily'),
    dailyExpertRows: selectDailyRows(dailyRows, 'daily_expert'),
    challengeRows: selectPracticeTier(practiceRows, 'challenge'),
    expertRows: selectPracticeTier(practiceRows, 'expert'),
    easyRows: selectEasySolves(practiceRows),
  });
}

/** One log read, degraded to `[]` (with a warning) rather than thrown. */
async function readRows(read, label) {
  try {
    return (await read()) || [];
  } catch (error) {
    console.warn(`Craft badges: failed to read ${label}, treating as empty:`, error);
    return [];
  }
}
