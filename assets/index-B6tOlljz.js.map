// Country code -> the name a player reads. One implementation, because there
// were three (David, 2026-09-17: "go with United States. spell out country
// names").
//
// WHAT WAS WRONG. Three surfaces each answered this question their own way:
//
//   OtherProfile.jsx      a ~50-entry array inlined in the JSX, matched with
//                         `.find(c => c.code === user.country)` — CASE-SENSITIVE
//                         against lowercase codes
//   NationalAverageTab    a Map built from countries.js, keyed lowercase
//   UserSearch.jsx        Intl.DisplayNames
//
// The first one is the bug David hit. `profiles.country` holds BOTH cases in
// production — seen live on staging, where one account rendered "United States"
// and another rendered "US" on the same page in the same field, because one row
// stores 'us' and the other 'US'. The strict === missed the uppercase row and
// fell through to `.toUpperCase()`, printing the raw code.
//
// Note the flags were never affected: every `flagcdn` URL in the app already
// lowercases the code. Only the NAME lookup was strict, which is why this read
// as a cosmetic oddity rather than a broken field.
//
// WHY countries.js IS THE PRIMARY SOURCE and Intl is only the fallback: that
// array is the picker a player actually chose from, so its wording is the
// wording they were shown. Intl would answer "United States" for 'us' too, but
// it also drifts by ICU version and locale data, and for the 50 codes we offer
// we should say exactly what the dropdown said. Intl then covers anything
// OUTSIDE those 50 — legacy rows, or a code that arrived from somewhere else —
// which the old map could only render as a bare code.

import { countries } from './countries';

/**
 * The ISO 3166-1 user-assigned range — codes that will never be a country, but
 * which CLDR still answers for. Excluded before Intl is consulted.
 */
const USER_ASSIGNED = /^(aa|zz|q[m-z]|x[a-z])$/;

/** Lowercase alpha-2 -> the picker's own wording. */
const NAME_BY_CODE = new Map(countries.map((c) => [String(c.code).toLowerCase(), c.name]));

/**
 * The readable name for a country code, whatever case it arrives in.
 *
 * @param {string|null|undefined} code alpha-2, any case ('us', 'US', ' gb ')
 * @returns {string} the country name, or the upper-cased code if unknown, or ''
 */
export function countryName(code) {
  if (!code) return '';
  const key = String(code).trim().toLowerCase();
  if (!key) return '';

  const fromPicker = NAME_BY_CODE.get(key);
  if (fromPicker) return fromPicker;

  // Outside the picker's 50. Two guards, both measured rather than assumed —
  // I probed Intl directly instead of reasoning about it, and both surprises
  // below are things I had guessed wrong first.
  //
  // ⚠️ 1. THE ISO 3166-1 USER-ASSIGNED BLOCK IS NOT COUNTRIES, BUT CLDR NAMES
  // SOME OF IT ANYWAY. 'ZZ' returns "Unknown Region" and 'XA' returns
  // "Pseudo-Accents" — under a player's name those read as places. Neither is
  // caught by `fallback: 'none'`, because CLDR genuinely has those names. So
  // the block is excluded before Intl is asked at all: AA, QM–QZ, XA–XZ, ZZ.
  //
  // ⚠️ 2. `fallback: 'none'` IS STILL LOAD-BEARING for everything else. The
  // default is 'code', which hands back the input ('QQ' -> "QQ") and would make
  // "unknown" indistinguishable from "resolved to itself". With 'none' those
  // return undefined and we fall through deliberately.
  //
  // The try/catch is a third, separate case: Intl THROWS on a malformed code
  // ('!!') rather than returning undefined, and one junk value in one row must
  // not take a whole leaderboard down with it.
  if (!USER_ASSIGNED.test(key)) {
    try {
      const resolved = new Intl.DisplayNames(['en'], { type: 'region', fallback: 'none' })
        .of(key.toUpperCase());
      if (resolved) return resolved;
    } catch {
      // fall through to the code
    }
  }
  return key.toUpperCase();
}
