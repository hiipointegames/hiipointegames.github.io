import { apiClient } from '@/transport';

// The four (now five) friend-edge MUTATIONS — the write complement of
// friendEdges.js's read path. A FriendConnection row is a directional edge
// { user_id (sender), friend_id (recipient), status }; friendship is
// undirected, so writes that target one orientation are spelled out per
// direction. These are the entity-write layer, so they THROW on failure (per
// the project's result-union convention, which shrinks the throwing surface TO
// entity writes, not away from them); every caller is built around catching
// the thrown error and surfacing error.message.

/**
 * Find the pending directional edge fromId → toId. The entity client only
 * supports equality filters; accept/reject look up the incoming
 * (requester → me) edge, cancel looks up the outgoing (me → recipient) edge.
 * @returns {Promise<Array<object>>} matching pending connection rows
 */
function findPendingEdge(fromId, toId) {
  return apiClient.entities.FriendConnection.filter({
    user_id: fromId,
    friend_id: toId,
    status: 'pending',
  });
}

// Validate and send a friend request with duplicate prevention.
export async function sendFriendRequest(currentUserId, targetUserId) {
  try {
    // 1. Prevent self-request
    if (currentUserId === targetUserId) {
      throw new Error('You cannot send a friend request to yourself');
    }

    // 2. Check for existing requests (both directions, any status)
    const existingRequests = await apiClient.entities.FriendConnection.filter({
      user_id: currentUserId,
      friend_id: targetUserId,
    });
    const reverseRequests = await apiClient.entities.FriendConnection.filter({
      user_id: targetUserId,
      friend_id: currentUserId,
    });

    if (existingRequests.length > 0) {
      const status = existingRequests[0].status;
      // NOTE: this exact 'already sent' substring is a caller contract —
      // RecommendedPlayers swallows it via error.message.includes('already sent').
      // friends.test.js freezes the literal; don't reword without updating both.
      if (status === 'pending') {
        throw new Error('Friend request already sent');
      } else if (status === 'accepted') {
        throw new Error('You are already friends with this user');
      }
    }

    if (reverseRequests.length > 0 && reverseRequests[0].status === 'pending') {
      throw new Error('This user has already sent you a friend request. Check your pending requests!');
    }

    // 3. Create the pending connection using IDs
    await apiClient.entities.FriendConnection.create({
      user_id: currentUserId,
      friend_id: targetUserId,
      status: 'pending',
      requested_by_id: currentUserId,
    });

    return { success: true };
  } catch (error) {
    console.error('[SEND FRIEND REQUEST ERROR]', error);
    throw error;
  }
}

// Accept an incoming pending request (flip requester → me to accepted).
export async function acceptFriendRequest(requesterId) {
  try {
    const currentUser = await apiClient.auth.me();
    const connections = await findPendingEdge(requesterId, currentUser.id);

    if (connections.length === 0) {
      throw new Error('Friend request not found');
    }

    await apiClient.entities.FriendConnection.update(connections[0].id, {
      status: 'accepted',
    });

    return { success: true };
  } catch (error) {
    console.error('[ACCEPT ERROR]', error);
    throw error;
  }
}

// Reject an incoming pending request (delete the requester → me edge).
export async function rejectFriendRequest(requesterId) {
  try {
    const currentUser = await apiClient.auth.me();
    const connections = await findPendingEdge(requesterId, currentUser.id);

    if (connections.length > 0) {
      await apiClient.entities.FriendConnection.delete(connections[0].id);
    }

    return { success: true };
  } catch (error) {
    console.error('[REJECT ERROR]', error);
    throw error;
  }
}

// Cancel a pending request I sent (delete the outgoing me → recipient edge).
// Folded in from FriendRequests.handleCancelSent so friends.js owns every
// friend-edge write rather than leaving one orientation hand-rolled in the UI.
export async function cancelSentRequest(recipientId) {
  try {
    const currentUser = await apiClient.auth.me();
    const connections = await findPendingEdge(currentUser.id, recipientId);

    for (const conn of connections) {
      await apiClient.entities.FriendConnection.delete(conn.id);
    }

    return { success: true };
  } catch (error) {
    console.error('[CANCEL SENT REQUEST ERROR]', error);
    throw error;
  }
}

// Remove an accepted friendship (delete the accepted edge in both directions).
export async function removeFriend(friendId) {
  try {
    const currentUser = await apiClient.auth.me();

    const connections1 = await apiClient.entities.FriendConnection.filter({
      user_id: currentUser.id,
      friend_id: friendId,
      status: 'accepted',
    });
    const connections2 = await apiClient.entities.FriendConnection.filter({
      user_id: friendId,
      friend_id: currentUser.id,
      status: 'accepted',
    });

    for (const conn of [...connections1, ...connections2]) {
      await apiClient.entities.FriendConnection.delete(conn.id);
    }

    return { success: true };
  } catch (error) {
    console.error('[REMOVE FRIEND ERROR]', error);
    throw error;
  }
}
