import { apiClient } from '@/transport';
import { buildPublicProfileStats } from './profileSnapshot';

export const syncPublicProfile = async (user) => {
  if (!user) return;

  // Guests store nothing. A pure guest (anonymous, no account) has no custom
  // username — we do not create a public profile row or sync any stats for
  // them. Cloud presence (leaderboard, friends, synced stats) begins only when
  // they create an account (CreateAccountForm sets has_custom_username=true,
  // then calls this). Accepts both the merged-user shape (has_custom_username
  // at top level, from apiClient.auth.me/updateMe) and the raw auth user.
  const hasAccount = user.has_custom_username || user.user_metadata?.has_custom_username;
  if (!hasAccount) return;

  try {
    // Use user ID for lookup (works for both anonymous and registered users)
    const userId = user.id;

    // Check if profile already exists by ID
    let existingProfile = null;
    try {
      existingProfile = await apiClient.entities.PublicProfile.get(userId);
    } catch (error) {
      existingProfile = null;
    }

    const gameStats = user.game_stats || {};

    // ─────────────────────────────────────────────────────────────────────────
    // THIS FUNCTION NO LONGER WRITES puzzle_points, AND THAT IS THE FIX.
    // ─────────────────────────────────────────────────────────────────────────
    // It used to derive the balance with countPuzzlePointsFromTimes and write it
    // ABSOLUTELY, into the same profiles column daily-challenge-controller
    // writes. Two absolute writers of one ledger, and this one is the CLIENT.
    //
    // Game.jsx awaits syncPublicProfile on mount AND again after every solve, so
    // this ran on every app open — meaning it did not merely race the server, it
    // reliably had the LAST word. Under David ruling Q-A (balances are
    // grandfathered, new Pieces accrue by a sub-30s Expert Daily) that is fatal:
    // fixing only the server leaves a grandfathered balance alive until the
    // player next opens the app, which is FASTER than the failure the ruling was
    // written to prevent and has no visible cause. Inventory A8.
    //
    // Teaching this file the new rule would have been the wrong repair. It is a
    // PROFILE SYNC, not a ledger, and the derivation it used cannot see the new
    // rule inputs anyway. One writer, server-side, where the referee already
    // lives. Omitting the key leaves the stored column untouched on update; on
    // create the column takes its own default, which is right for a new account
    // that has earned nothing.
    //
    // A balance that is stale-LOW is not stranded: the controller writes
    // max(stored, derived) on the next perfect solve, so the server repairs it.
    // See supabase/functions/_shared/puzzlePointsLedger.ts.

    // ─────────────────────────────────────────────────────────────────────────
    // THIS FUNCTION NO LONGER WRITES battle_points EITHER — SAME REASON, AND
    // IT WAS THE LAST FORGEABLE PROFILE COLUMN THE CLIENT STILL WROTE.
    // ─────────────────────────────────────────────────────────────────────────
    // It used to derive the balance with getPlayerBattleStats (count of completed
    // head-to-head wins) and write it ABSOLUTELY into profiles.battle_points — the
    // same column the leaderboard, profile badge tiers and get-player-stats read.
    // A client-written column is a forgeable one: `authenticated` held UPDATE on
    // it, so a player could set their own battle_points from the console (audit
    // finding B2). And a client-maintained mirror drifts from the truth in
    // head_to_head_challenges (proven on staging: stored 0, derived 1).
    //
    // battle_points is now SERVER-OWNED: a database trigger on
    // head_to_head_challenges recomputes both participants' win counts on every
    // battle change (migration 20260905020000_battle_points_server_owned), and the
    // client's UPDATE grant on the column is revoked once this change reaches
    // devices (migration 20260905030000_battle_points_lock — OTA-gated, because
    // pre-OTA clients still send battle_points here and a revoke would fail their
    // whole profile UPDATE). Omitting the key leaves the stored column untouched on
    // update; on create the column takes its own default (0), correct for a new
    // account that has won nothing.

    // Prepare stats JSON object matching the existing table format
    const statsJson = buildPublicProfileStats(gameStats);

    // USERNAME IS CREATE-ONLY (2026-09-10). `set-username` owns this column
    // now: it is the only writer that runs the format and moderation rules,
    // and the only one that cascades a rename onto historical leaderboard rows.
    //
    // Keeping it on the UPDATE payload is what blocks
    // `20260906020000_lock_username_column.sql`. While this function writes the
    // column, revoking the grant would make every sync fail — silently, because
    // the whole body is wrapped in a catch that only console.errors — and take
    // `country` and `stats` down with it. So the lock waits on this change
    // reaching players, not merely on 'an OTA'.
    //
    // It stays on CREATE. A brand-new row with a null username is worse than
    // the bug being fixed: the unique index is on `lower(username)`, the
    // leaderboard reads the column to decide whether a player is linkable, and
    // set-username has not necessarily run yet for a fresh guest.
    //
    // Same shape as puzzle_points above, and for the same reason: on UPDATE a
    // key that is PRESENT overwrites the stored value, and a key that is
    // ABSENT leaves the column exactly as it is.
    const profileData = {
      country: user.country || null,
      stats: statsJson,
      // username, puzzle_points and battle_points are deliberately ABSENT —
      // all three are server-owned on update. See the notes above.
    };

    if (existingProfile) {
      await apiClient.entities.PublicProfile.update(userId, profileData);
    } else {
      // Try to create, but catch duplicate errors if race condition
      try {
        await apiClient.entities.PublicProfile.create({
          id: userId,
          // CREATE only — see the note on profileData.
          username: user.username || `Guest${userId.substring(0, 10)}`,
          ...profileData
        });
      } catch (createError) {
        // If creation fails (likely duplicate), try update as fallback
        if (createError && (createError.message?.includes('duplicate') || createError.status === 409)) {
          await apiClient.entities.PublicProfile.update(userId, profileData);
        } else {
          // Log other errors but don't crash the app
          console.warn('Failed to create public profile, skipping:', createError);
        }
      }
    }

    console.log('Public profile synced (puzzle_points and battle_points are server-owned)');
  } catch (error) {
    console.error('Failed to sync public profile:', error);
  }
};