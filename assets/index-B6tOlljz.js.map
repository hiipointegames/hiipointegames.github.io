import React, { useState } from 'react';
import { ChevronRight } from 'lucide-react';

import { EMAIL_CODE_COPY, EmailCodeSheet, useGiveawayEmailVerified } from '@/contest';

import { neonSurface, neonText } from './neon';

// The gold giveaway box on the guided signup's Done screen. Only a Yes to
// 18+/US ever sees it (the parent hides it for a No).
//
//   no email yet            — a button back to the email step ("Add email ›")
//   email waiting on inbox  — "Check your inbox…" (plain text)
//   entered, email verified
//     or not known          — "You’re entered in the weekly $37 giveaway"
//   entered, server says NOT verified (false or 'grace')
//                           — "One more step: verify your email…", a button
//                             ("Verify now ›") that opens the 6-digit-code
//                             sheet right here; on success, back to "entered".
//
// The verified answer comes from useGiveawayEmailVerified, the same read the
// home chip and the giveaway sheet use. With the `giveaway_email_code` switch
// missing or off it answers null and makes no status request, so the box is
// exactly what it was before the email check existed. Null (unknown) never
// asks the player to verify: we don't guess.

const BOX_CLASS = 'mt-3 w-full text-left px-4 py-3.5 rounded-2xl';

/**
 * @param {{
 *   user: any,
 *   entered: boolean,
 *   emailPending: boolean,
 *   canAddEmail: boolean,
 *   onAddEmail: () => void,
 *   deps?: { fetcher?: () => Promise<boolean|'grace'|null>, sheet?: object },
 * }} props
 *   user  — the account just created (createdUser)
 *   deps  — test seams: the verified read, and the sheet's own seams
 */
export default function SignupGiveawayBox({ user, entered, emailPending, canAddEmail, onAddEmail, deps = {} }) {
  const verified = useGiveawayEmailVerified(user, { fetcher: deps.fetcher });
  const [sheetOpen, setSheetOpen] = useState(false);
  const [justVerified, setJustVerified] = useState(false);

  const needsVerify = Boolean(entered) && verified !== null && verified !== true && !justVerified;
  const title = entered
    ? (needsVerify ? EMAIL_CODE_COPY.signupVerifyTitle : 'You’re entered in the weekly $37 giveaway')
    : emailPending
      ? 'Check your inbox to confirm your email — then you’re entered'
      : 'Add an email to be entered in the $37 giveaway';
  const action = canAddEmail ? 'Add email' : needsVerify ? EMAIL_CODE_COPY.noticeCta : null;
  const onTap = canAddEmail ? onAddEmail : needsVerify ? () => setSheetOpen(true) : null;

  const inner = (
    <>
      <div className="flex items-start justify-between gap-3">
        <div className="font-black" style={neonText('var(--u37-gold)')}>{title}</div>
        {action && (
          <span className="shrink-0 flex items-center text-[13px] font-black whitespace-nowrap" style={{ color: 'var(--u37-gold)' }} aria-hidden="true">
            {action} <ChevronRight className="w-4 h-4" />
          </span>
        )}
      </div>
      <div className="mt-1 text-[13px]" style={{ color: '#fff2c8' }}>Every Daily you finish is one entry — up to 3 a day.</div>
    </>
  );
  const style = neonSurface('var(--u37-gold)', 22);

  return (
    <>
      {onTap ? (
        <button
          type="button"
          onClick={onTap}
          className={`${BOX_CLASS} touch-manipulation active:scale-[0.98]`}
          style={style}
          data-testid="signup-done-contest"
        >
          {inner}
        </button>
      ) : (
        <div className={BOX_CLASS} style={style} data-testid="signup-done-contest">
          {inner}
        </div>
      )}
      {sheetOpen && (
        <EmailCodeSheet
          user={user}
          onClose={() => setSheetOpen(false)}
          onVerified={() => setJustVerified(true)}
          deps={deps.sheet}
        />
      )}
    </>
  );
}
