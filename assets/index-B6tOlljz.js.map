// shell/consent — Google UMP (User Messaging Platform) consent gathering.
//
// Why this exists: the app previously initialized AdMob with NO consent flow.
// Google requires a UMP consent message for users in the EEA / UK (GDPR) and
// certain US states before serving personalized ads. Without it, ad serving is
// restricted in those regions ("ads don't work well"), and it's a policy
// violation. This runs the standard UMP flow before AdMob initializes.
//
// Flow (per Google's reference):
//   1. requestConsentInfo  — refresh the user's consent status.
//   2. if a form is available and consent is REQUIRED → showConsentForm.
//   3. report canRequestAds so the caller can decide whether to load ads.
//
// Fail-open: any error returns canRequestAds=true so a UMP hiccup never bricks
// a region where ads are allowed. No-op on web.

import { Capacitor } from '@capacitor/core';
import { AdMob, AdmobConsentStatus } from '@capacitor-community/admob';
import { adIsTesting, getTestDeviceIds } from './adConfig';

/**
 * Gather user consent via UMP. Returns { canRequestAds } — true when ads may be
 * loaded (consent obtained, not required, or an error we fail open on).
 *
 * In test mode, debugGeography forces the EEA experience so the consent form can
 * be exercised on a registered test device regardless of physical location.
 */
export async function requestConsent() {
  if (!Capacitor.isNativePlatform()) return { canRequestAds: false };

  try {
    const options = {};
    const testDevices = getTestDeviceIds();
    if (testDevices.length > 0) options.testDeviceIdentifiers = testDevices;
    if (adIsTesting() && testDevices.length > 0) {
      // 1 === AdmobConsentDebugGeography.EEA. Only meaningful for registered
      // test devices, so gate it behind having at least one.
      options.debugGeography = 1;
    }

    let info = await AdMob.requestConsentInfo(options);

    if (
      info.isConsentFormAvailable &&
      info.status === AdmobConsentStatus.REQUIRED
    ) {
      info = await AdMob.showConsentForm();
    }

    // canRequestAds is the authoritative signal (since plugin 7.0.3). Fall back
    // to "not REQUIRED" for safety if the field is ever absent.
    const canRequestAds =
      typeof info.canRequestAds === 'boolean'
        ? info.canRequestAds
        : info.status !== AdmobConsentStatus.REQUIRED;

    return { canRequestAds };
  } catch (e) {
    console.error('UMP consent flow error:', e);
    // Fail open — don't block ads in regions where they're allowed.
    return { canRequestAds: true };
  }
}
