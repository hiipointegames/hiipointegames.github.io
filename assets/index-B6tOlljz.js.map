import { edgeCall } from './edgeCallPort';

// Client port for the resolve-username-login edge function (claim-on-first-login).
//
// Returns the standard EdgeCallResult. On success, `data.outcome` is 'claimed'
// (a credential-less account just had this password set) or 'authenticated' (an
// existing credential was verified), and `data.session` carries the
// {access_token, refresh_token} the caller hands to supabase.auth.setSession.
// The internal login email is never returned — it stays server-side.

export const MIN_PASSWORD_LEN = 6; // mirror the edge function (NIST length-first)

/**
 * Resolve a username + password login. Light client-side validation gives fast
 * feedback before the round trip; the edge function re-validates authoritatively.
 *
 * @param {string} username
 * @param {string} password
 * @param {string} [email] - optional recovery/newsletter email. Only meaningful
 *   when creating/claiming an account: it becomes the account's real email so
 *   password reset works. Ignored for an already-credentialed account.
 * @returns {Promise<import('./edgeCallPort').EdgeCallResult>}
 */
export async function resolveUsernameLogin(username, password, email) {
  const handle = (username || '').trim();
  if (!handle) {
    return { success: false, error: { code: 'invalid_input', message: 'Username is required.' } };
  }
  if ((password || '').length < MIN_PASSWORD_LEN) {
    return {
      success: false,
      error: { code: 'weak_password', message: `Password must be at least ${MIN_PASSWORD_LEN} characters.` },
    };
  }
  const payload = { username: handle, password };
  const trimmedEmail = (email || '').trim();
  if (trimmedEmail) payload.email = trimmedEmail;
  return edgeCall('resolve-username-login', payload);
}
