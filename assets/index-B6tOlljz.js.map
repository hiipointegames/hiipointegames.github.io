import React, { useEffect } from 'react';
import { motion } from 'framer-motion';
import { UserPlus, Check, X } from 'lucide-react';

export default function FriendNotificationToast({ notification, onDismiss }) {
  useEffect(() => {
    const timer = setTimeout(() => {
      onDismiss(notification.id);
    }, 5000);

    return () => clearTimeout(timer);
  }, [notification.id, onDismiss]);

  const icons = {
    request: UserPlus,
    accepted: Check,
  };

  const Icon = icons[notification.type] || UserPlus;

  return (
    <motion.div
      initial={{ opacity: 0, x: 300 }}
      animate={{ opacity: 1, x: 0 }}
      exit={{ opacity: 0, x: 300 }}
      className="bg-slate-800 border border-amber-500/50 rounded-lg p-4 shadow-lg flex items-start gap-3 min-w-[300px]"
    >
      <div className={`p-2 rounded-full ${
        notification.type === 'accepted' ? 'bg-emerald-500/20' : 'bg-amber-500/20'
      }`}>
        <Icon className={`w-5 h-5 ${
          notification.type === 'accepted' ? 'text-emerald-400' : 'text-amber-400'
        }`} />
      </div>
      <div className="flex-1">
        <p className="text-white font-semibold">{notification.title}</p>
        <p className="text-slate-300 text-sm">{notification.message}</p>
      </div>
      <button
        onClick={() => onDismiss(notification.id)}
        className="text-slate-400 hover:text-white"
      >
        <X className="w-4 h-4" />
      </button>
    </motion.div>
  );
}