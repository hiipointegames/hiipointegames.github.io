// Pure view-model derivations for a head-to-head challenge row.
//
// A HeadToHeadChallenge is symmetric: each player is either the `challenger`
// or the `opponent`, with parallel `challenger_result` / `opponent_result`
// columns and a `winner_id`. Reading it from "my" perspective — which result
// is mine, who's the opponent, which column to write on submit, what tab the
// battle belongs in — was hand-rolled across ChallengeList, ChallengeResults,
// TopBattleOpponents, NotificationBadges, HeadToHeadGame, RecommendedPlayers,
// and Game. This module owns that pure derivation (the read/derive complement
// resolveBattle.js + playerBattles.js stopped short of); the .jsx files keep
// only fetch, state, and rendering.
//
// HeadToHeadGame.jsx (the live-match WRITE path) also routes through
// perspectiveOf: every "which side am I" read AND the `{ [myResultKey]: result }`
// write-column selection use the same picker. `myResultKey`/`opponentResultKey`
// exist precisely so the write site need not re-derive the column. The atomic
// two-mutation/no-rollback submit *protocol* is unchanged — only the column
// picker is shared (the server-side atomic rework remains deferred; see
// index.js "Pass 4.2-bis").

import moment from 'moment';
import 'moment-timezone';
import { todayET, DAILY_CHALLENGE_TZ } from '@/daily-challenge';
import { BLITZ_MODES, normalizeBlitzMode } from './blitzMode';

/**
 * Resolve a challenge from one player's perspective.
 *
 * @param {object} challenge - a HeadToHeadChallenge row
 * @param {string} userId
 * @returns {{
 *   isChallenger: boolean,
 *   myResult: object|undefined,
 *   opponentResult: object|undefined,
 *   opponentId: string,
 *   myResultKey: 'challenger_result'|'opponent_result',
 *   opponentResultKey: 'challenger_result'|'opponent_result',
 *   stableDate: string|undefined,
 * }}
 */
export function perspectiveOf(challenge, userId) {
  const isChallenger = challenge.challenger_id === userId;
  const myResultKey = isChallenger ? 'challenger_result' : 'opponent_result';
  const opponentResultKey = isChallenger ? 'opponent_result' : 'challenger_result';
  const myResult = challenge[myResultKey];
  const opponentResult = challenge[opponentResultKey];
  const opponentId = isChallenger ? challenge.opponent_id : challenge.challenger_id;
  // Stable display/sort date: my completion, else opponent's, else creation —
  // so a late forfeit-finalization doesn't roll the card to "today".
  //
  // `created_date` is a DEAD read: the column is `created_at` on both staging and
  // prod (verified 2026-08-01 against information_schema), and the transport only
  // rewrites created_date→created_at for SORT arguments, never on the returned row.
  // It stayed invisible because a completion date is almost always present. Kept
  // ahead of created_at in case an older caller ever hands us a mapped row.
  const stableDate =
    myResult?.completed_date ||
    opponentResult?.completed_date ||
    challenge.created_date ||
    challenge.created_at;
  return { isChallenger, myResult, opponentResult, opponentId, myResultKey, opponentResultKey, stableDate };
}

/**
 * Whether a player is either side of a challenge.
 * @param {object} challenge
 * @param {string} userId
 * @returns {boolean}
 */
export function involvesPlayer(challenge, userId) {
  return challenge.challenger_id === userId || challenge.opponent_id === userId;
}

/**
 * Classify a challenge into the battle-list tab bucket it belongs to, from a
 * player's perspective. Mirrors ChallengeList's inline predicate exactly:
 *
 *   'open'            — not finalized/forfeited/self-completed, and a pending
 *                       invite or an active accepted battle
 *   'pending'         — I completed but the opponent hasn't and it isn't
 *                       finalized yet (the "completed > pending" sub-tab)
 *   'victories'       — finalized/forfeited and I won
 *   'defeats'         — finalized/forfeited and I lost (winner set, not me)
 *   'completed-other' — finalized/forfeited/self-completed but none of the
 *                       above (e.g. a finalized tie, winner_id === null)
 *   null              — in neither list (e.g. an unrecognized non-completed status)
 *
 * @param {object} challenge
 * @param {string} userId
 * @returns {'open'|'pending'|'victories'|'defeats'|'completed-other'|null}
 */
export function bucketChallenge(challenge, userId) {
  const { myResult, opponentResult } = perspectiveOf(challenge, userId);
  const runStatus = myResult?.run_status || 'not_started';
  const opponentRunStatus = opponentResult?.run_status || 'not_started';
  const isBattleFinalized = challenge.status === 'completed' || challenge.status === 'forfeited';
  const anyoneForfeited = runStatus === 'forfeited' || opponentRunStatus === 'forfeited';
  const iCompleted = runStatus === 'completed' || myResult?.completed;
  const isWinner = challenge.winner_id === userId;
  const isPending = iCompleted && !opponentResult?.completed && challenge.status === 'accepted';

  const inCompleted = isBattleFinalized || anyoneForfeited || iCompleted;
  if (!inCompleted) {
    if (
      challenge.status === 'pending' ||
      (challenge.status === 'accepted' && !iCompleted && !anyoneForfeited)
    ) {
      return 'open';
    }
    return null;
  }

  if (isPending) return 'pending';
  if ((isBattleFinalized || anyoneForfeited) && isWinner) return 'victories';
  if ((isBattleFinalized || anyoneForfeited) && !isWinner && challenge.winner_id !== null) return 'defeats';
  return 'completed-other';
}

/**
 * Classify a challenge as an ACTIONABLE notification from a player's
 * perspective — the two battle states the player is expected to act on:
 *
 *   'invite'    — a pending battle invitation addressed to me (I accept/decline)
 *   'your-move' — an accepted, NOT-YET-EXPIRED battle where the opponent has
 *                 finished and I have not (it's my turn to play)
 *   null        — nothing to act on (a battle I'm not in, an outgoing invite,
 *                 both-still-open, a battle I've already finished, an EXPIRED
 *                 accepted battle, or a finalized battle)
 *
 * Built on `perspectiveOf` so it shares the one canonical result-column picker
 * with `bucketChallenge` rather than hand-rolling a divergent predicate.
 *
 * Involvement guard: `perspectiveOf` is deliberately total — handed a battle
 * between two OTHER players it still answers, reporting `isChallenger:false` and
 * therefore silently treating the row's `opponent_result` as "mine". That is
 * correct for the Colosseum (which pre-filters with `involvesPlayer`) and wrong
 * for anyone who doesn't. The notification hook didn't, and the read policy
 * hands every client every row, so two strangers' unfinished battle showed up as
 * "your move" for EVERY player in the app (confirmed against production
 * 2026-08-02; see docs/bugs.md). Returning a non-null action for a battle the
 * player isn't in is wrong as a function contract, so the guard lives HERE
 * rather than only at the call site — it protects every present and future
 * caller (`derivePendingActions`, `resolveChallengeTarget`, and the next one).
 *
 * Expiry guard: an accepted battle whose `expiry_date` is before today (ET) is
 * effectively dead — `ChallengeList`'s sweep forfeits exactly these rows the
 * next time the Colosseum loads (see `ChallengeList.jsx` "Check expired
 * challenges"). Until that sweep runs the row still carries `status:'accepted'`,
 * so the raw predicate would keep surfacing it as a "your move" forever. We
 * exclude it here so a stale, already-lost battle never shows as an actionable
 * notification. `today` is injectable for deterministic tests.
 *
 * @param {object} challenge - a HeadToHeadChallenge row
 * @param {string} userId
 * @param {string} [today] - YYYY-MM-DD ET date (defaults to todayET())
 * @returns {'invite'|'your-move'|null}
 */
export function pendingActionKind(challenge, userId, today = todayET()) {
  if (!challenge || !userId) return null;
  // Not my battle → nothing to act on, whatever the row says.
  if (!involvesPlayer(challenge, userId)) return null;
  // Incoming invite: still pending and I'm the one who was challenged.
  if (challenge.status === 'pending' && challenge.opponent_id === userId) return 'invite';
  // Your move: accepted, not expired, opponent completed their run, I haven't.
  if (challenge.status === 'accepted') {
    if (challenge.expiry_date && challenge.expiry_date < today) return null; // expired → dead
    const { myResult, opponentResult } = perspectiveOf(challenge, userId);
    if (opponentResult?.completed && !myResult?.completed) return 'your-move';
  }
  return null;
}

/**
 * Whether a battle is one the player can PLAY right now (Sector 73 battles,
 * design-v2 B2 "your invite was accepted / it's your move"):
 *
 *   - the player is in it (same involvement guard as `pendingActionKind`),
 *   - `status === 'accepted'` (a pending invite is not playable yet; a
 *     completed/forfeited battle is over),
 *   - not expired: `expiry_date` is absent or `>= today` (ET) — the SAME rule
 *     `pendingActionKind` and ChallengeList's sweep use, so a battle expires at
 *     the end of its expiry day, ET,
 *   - my run isn't finished (`completed` flag or `run_status` 'completed') and
 *     I haven't forfeited — an `in_progress` run still counts, because
 *     HeadToHeadGame resumes it,
 *   - the opponent hasn't forfeited (the battle is decided; the sweep will
 *     finalize it).
 *
 * Whether the opponent has played is irrelevant, so this is a SUPERSET of
 * `pendingActionKind(...) === 'your-move'`.
 *
 * @param {object} challenge
 * @param {string} userId
 * @param {string} [today] - YYYY-MM-DD ET date (defaults to todayET())
 * @returns {boolean}
 */
export function isReadyBattle(challenge, userId, today = todayET()) {
  if (!challenge || !userId) return false;
  if (!involvesPlayer(challenge, userId)) return false;
  if (challenge.status !== 'accepted') return false;
  if (challenge.expiry_date && challenge.expiry_date < today) return false;
  const { myResult, opponentResult } = perspectiveOf(challenge, userId);
  if (myResult?.completed || myResult?.run_status === 'completed') return false;
  if (myResult?.run_status === 'forfeited') return false;
  if (opponentResult?.run_status === 'forfeited') return false;
  return true;
}

/**
 * Whether MY run in a battle has already used up its clock: my result is
 * `in_progress` with a `start_time`, and `start_time + time_limit_seconds`
 * (600 when the column is absent — the same fallback HeadToHeadGame uses) is
 * at or before `nowMs`. Such a battle still counts as `isReadyBattle` (the
 * opponent may need my finished result to decide it), but it is NOT playable:
 * opening it can only end the run. Sector 73 labels it "time's up — finish"
 * instead of "ready — play" (followups F1), and its battle overlay ends the run
 * without showing the pre-battle warning.
 *
 * Same arithmetic as HeadToHeadGame's resume path (`remaining <= 0`).
 *
 * @param {object} challenge
 * @param {string} userId
 * @param {number} [nowMs] - epoch ms (defaults to Date.now())
 * @returns {boolean}
 */
export function runClockExpired(challenge, userId, nowMs = Date.now()) {
  if (!challenge || !userId || !involvesPlayer(challenge, userId)) return false;
  const { myResult } = perspectiveOf(challenge, userId);
  if (myResult?.run_status !== 'in_progress' || !myResult?.start_time) return false;
  const startedMs = new Date(myResult.start_time).getTime();
  if (!Number.isFinite(startedMs)) return false;
  const limitSeconds = challenge.time_limit_seconds ?? 600;
  return nowMs - startedMs >= limitSeconds * 1000;
}

/** How long a finished battle stays a "recent result" (design-v2 B2: 24 h). */
export const RECENT_RESULT_WINDOW_MS = 24 * 60 * 60 * 1000;

/** A finish stamp further ahead of this device's clock than this is not trusted. */
const FUTURE_FINISH_TOLERANCE_MS = 10 * 60 * 1000;

// An explicit zone ('Z' or ±HH[:MM]) at the end of a timestamp that HAS a time
// part. Anchored after HH:mm so a date-only `YYYY-MM-DD` is not misread as
// zoned (its `-18` would otherwise match `[+-]\d{2}`).
const HAS_ZONE = /T?\d{2}:\d{2}(:\d{2}(\.\d+)?)?(Z|[+-]\d{2}(:?\d{2})?)$/;

/**
 * Parse one stored battle timestamp to epoch ms. Two formats coexist (see
 * battleRunBlob.js / blitzBattleBadges.js): result-blob `completed_date` is ET
 * wall-clock `YYYY-MM-DD HH:mm:ss` with no zone, while `finalized_date` comes
 * back from Postgres as an instant with a zone. A zoned string is an instant; a
 * zone-less one is read as ET wall-clock.
 *
 * @param {unknown} value
 * @returns {number|null}
 */
function parseBattleTimestamp(value) {
  if (typeof value !== 'string' || value === '') return null;
  const ms = HAS_ZONE.test(value)
    ? Date.parse(value)
    : moment.tz(value.replace('T', ' ').slice(0, 19), 'YYYY-MM-DD HH:mm:ss', DAILY_CHALLENGE_TZ).valueOf();
  return Number.isFinite(ms) ? ms : null;
}

/**
 * When a finished battle's result became known, as epoch ms — the LATEST of:
 *   - each side's `completed_date` (the in-game finalize writes no
 *     `finalized_date`; the second finisher's completion IS the finish),
 *   - `finalized_date`. `recordForfeit` stamps now. ChallengeList's orphan
 *     sweep reaches for `created_date`, which is not a column (the table has
 *     `created_at`), so it always falls through to now. The expiry sweep stamps
 *     the finisher's `completed_date` (possibly days old) or now when nobody
 *     finished.
 *   - for `status 'forfeited'` with an `expiry_date`: the start of the ET day
 *     AFTER expiry. The expiry sweep only forfeits once `expiry_date < today`,
 *     so this is the earliest the result can have become known. Without it, an
 *     expiry forfeit where one side finished would look days old.
 * `null` when the row carries none of these (it can't be placed in time).
 *
 * With `nowMs`, any single stamp more than FUTURE_FINISH_TOLERANCE_MS ahead of
 * that clock (a fast device clock) is IGNORED; the remaining stamps decide. If
 * none remain the result is `null` (the row is left out). Without `nowMs` every
 * parsed stamp counts.
 *
 * @param {object} challenge
 * @param {number} [nowMs] - epoch ms; omit for the raw stamp
 * @returns {number|null}
 */
export function battleFinishedAtMs(challenge, nowMs) {
  if (!challenge) return null;
  const stamps = [
    parseBattleTimestamp(challenge.challenger_result?.completed_date),
    parseBattleTimestamp(challenge.opponent_result?.completed_date),
    parseBattleTimestamp(challenge.finalized_date),
  ];
  if (challenge.status === 'forfeited' && typeof challenge.expiry_date === 'string' && challenge.expiry_date) {
    const dayAfter = moment.tz(challenge.expiry_date.slice(0, 10), 'YYYY-MM-DD', DAILY_CHALLENGE_TZ).add(1, 'day');
    stamps.push(dayAfter.isValid() ? dayAfter.valueOf() : null);
  }
  const trusted = stamps.filter(
    (ms) => ms !== null && !(typeof nowMs === 'number' && ms - nowMs > FUTURE_FINISH_TOLERANCE_MS),
  );
  return trusted.length > 0 ? Math.max(...trusted) : null;
}

/**
 * Whether a battle is a RECENT RESULT for the player (design-v2 B2: "finished
 * in the last 24 h"): the player is in it, `status` is 'completed' or
 * 'forfeited', and `now - battleFinishedAtMs(challenge) <= 24 h`. A finish
 * stamp up to 10 min in the FUTURE (writer's clock slightly ahead) is used as
 * is; one further ahead is ignored, so a fast clock cannot keep a row "recent".
 * A row with no usable (trusted) finish stamp is excluded rather than guessed.
 *
 * @param {object} challenge
 * @param {string} userId
 * @param {number} [nowMs] - epoch ms (defaults to Date.now())
 * @returns {boolean}
 */
export function isRecentResult(challenge, userId, nowMs = Date.now()) {
  if (!challenge || !userId) return false;
  if (!involvesPlayer(challenge, userId)) return false;
  if (challenge.status !== 'completed' && challenge.status !== 'forfeited') return false;
  const finishedAt = battleFinishedAtMs(challenge, nowMs);
  if (finishedAt === null) return false;
  return nowMs - finishedAt <= RECENT_RESULT_WINDOW_MS;
}

function emptyModeBreakdown() {
  return { wins: 0, losses: 0, puzzlesSolved: 0, opponentPuzzlesSolved: 0 };
}

/**
 * Aggregate a player's battles into a per-opponent, per-mode win/loss/puzzle
 * breakdown, sorted by total battles (descending). Mirrors TopBattleOpponents'
 * inline reducer. A tie (winner_id neither me nor the opponent) counts toward
 * totalBattles but neither wins nor losses. Caller slices/enriches.
 *
 * @param {Array<object>} challenges - this player's battles (caller pre-filters)
 * @param {string} userId
 * 🔴 THE BUCKET USED TO BE TWO-WAY AND EXPERT LANDED IN CHALLENGE'S.
 * It read `blitz_mode === 'easy' ? entry.easyMode : entry.challengeMode`, so
 * every Expert battle was counted as a Challenge battle in this breakdown —
 * silently inflating one tier's record and leaving Expert with none. Found
 * 2026-09-11 sweeping after David reported the display half of the same
 * two-branch mistake (BlitzModeBadge).
 *
 * ⚠️ NOTE THIS IS A DIFFERENT FUNCTION FROM `derivePlayerBattleStats`, which
 * HAS bucketed three ways for a while. "The stats are fine" was true of that one
 * and false of this one — which is exactly why the guard is now a sweep over
 * every surface rather than a spot check.
 *
 * Shape is `byMode` keyed by tier so a fourth tier is a list entry, not another
 * named field plus another branch.
 *
 * @returns {Array<{odId:string, totalBattles:number, byMode:Record<string,object>}>}
 */
export function deriveOpponentBreakdown(challenges, userId) {
  if (!Array.isArray(challenges)) return [];
  const byOpponent = {};

  for (const challenge of challenges) {
    const { opponentId, myResult, opponentResult } = perspectiveOf(challenge, userId);
    if (!byOpponent[opponentId]) {
      byOpponent[opponentId] = {
        odId: opponentId,
        totalBattles: 0,
        byMode: Object.fromEntries(BLITZ_MODES.map((m) => [m, emptyModeBreakdown()])),
      };
    }
    const entry = byOpponent[opponentId];
    entry.totalBattles += 1;

    const bucket = entry.byMode[normalizeBlitzMode(challenge.blitz_mode)];
    if (challenge.winner_id === userId) bucket.wins += 1;
    else if (challenge.winner_id === opponentId) bucket.losses += 1;
    bucket.puzzlesSolved += myResult?.total_solved || 0;
    bucket.opponentPuzzlesSolved += opponentResult?.total_solved || 0;
  }

  return Object.values(byOpponent).sort((a, b) => b.totalBattles - a.totalBattles);
}
