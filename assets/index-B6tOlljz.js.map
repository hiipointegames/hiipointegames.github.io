// onRampBadges — the EASY track's slice of the badge catalog.
//
// Split out of badgeRegistry.js in Round 2 § D7, when this track went from 5
// badges to 9 and pushed the registry past the 800-line structural cap
// (scripts/arch-ratchet.mjs). The registry had ~28 lines of headroom, so the
// split is the honest fix rather than raising the floor: the Easy track is a
// self-contained block that no other lane edits, so lifting it out both pays
// down the blob AND shrinks the surface two concurrent sessions can collide on
// inside badgeRegistry.js.
//
// PURE METADATA, exactly like the registry it feeds — no detection logic, no
// React. Detection for these badges lives in
// src/stats-aggregation/craftBadgeDerivation.js (`deriveOnRampBadges`).

import { oneTime, countLadder, thresholdLadder } from './badgeScaling';

/**
 * @typedef {import('./badgeRegistry').BadgeDefinition} BadgeDefinition
 * @typedef {import('./badgeRegistry').BadgeCategory} BadgeCategory
 */

// ---------------------------------------------------------------------------
// EASY — On-Ramp track. No power dice in Easy, so the craft catalog can't apply;
// this track rewards volume, first-times, the OPERATORS themselves, and the
// bridge up to Challenge. Round 2 § D7 took it from 5 badges to 9 — it was the
// thinnest tab in the catalog while the Daily carried 22, and the on-ramp is
// where a player decides whether badges are worth caring about at all.
//
// Two verified facts govern what can live here. Both are easy to get wrong:
//   1. EVERY OPERATOR WORKS IN EASY. `+ − × ÷ ^ ( )` all render on the pad in
//      every mode (`OperatorPad` takes a `mode` prop and never reads it). "No
//      power dice" limits SCORING, not the toolkit — which is the only reason
//      Tower, Deep Nest and Round Trip are reachable here.
//   2. EVERY SOLVE USES ALL SEVEN DICE, in every mode (`isSubmittableSolution`
//      gates on `usedDiceIndices.length === 7`). So a badge for "use all seven"
//      is universal and one for "reach 37 with three" is unearnable. Two § D7
//      candidates died on this; see CUT_BADGES in badgeRegistry.test.js for the
//      full list and reasons.
//
// Everything here is DERIVED at read time from the stored equation string or the
// stored date (stats-aggregation/craftBadgeDerivation.js) — no stored counter, so
// all four additions are retroactive on existing history.
// ---------------------------------------------------------------------------

/** @type {BadgeDefinition[]} */
export const ON_RAMP_BADGES = [
  {
    // Round 2 § D3 — was `firsts`/`any`, and it ABSORBED the old `firstSteps`
    // ("Complete your first Easy solve"), which was cut. The two were one feat
    // wearing two cards: every player who held First Steps also held First
    // Solve, because an Easy solve IS a solve. Keeping First Solve rather than
    // First Steps is the strictly retro-SAFE direction — `firstSteps ⊂
    // firstSolve`, so no player loses an earned badge, whereas cutting
    // firstSolve would have stripped the shield from every Daily-first player
    // who never opened Easy.
    //
    // A cross-mode badge living on the Easy track is the ESTABLISHED pattern
    // here, not an exception: `levelingUp` below is derived from CHALLENGE rows
    // and sits on Easy for the same reason — the on-ramp is where the player is
    // standing when it motivates them.
    id: 'firstSolve', featId: 'firstSolve', mode: 'easy', category: 'onRamp',
    name: 'First Solve', hidden: false, scaling: oneTime(),
    criteriaText: 'Complete your very first solve, in any mode.', art: '🥇', icon: 'flag',
  },
  {
    id: 'gettingTheHangOfIt', featId: 'gettingTheHangOfIt', mode: 'easy', category: 'onRamp',
    name: 'Getting the Hang of It', hidden: false, scaling: countLadder([10, 37, 100]),
    criteriaText: 'Complete 10, then 37, then 100 Easy solves.',
    criteriaTemplate: 'Complete {value} Easy solves.', art: '🎈', icon: 'growth',
  },
  {
    id: 'bracketRookie', featId: 'bracketRookie', mode: 'easy', category: 'onRamp',
    name: 'Bracket Rookie', hidden: false, scaling: oneTime(),
    criteriaText: 'Use parentheses in an Easy solve for the first time.', art: '🔰', icon: 'parentheses',
  },
  {
    id: 'everyWhichWay', featId: 'everyWhichWay', mode: 'easy', category: 'onRamp',
    name: 'Every Which Way', hidden: false, scaling: oneTime(),
    criteriaText: 'Use all four operations (+ − × ÷) in a single Easy solve.', art: '🧭', icon: 'compass',
  },
  {
    // Round 2 § D7. `everyWhichWay` covers + − × ÷ as a SET and `bracketRookie`
    // covers parentheses, which leaves `^` as the one operator the on-ramp never
    // points at — and nothing told a new player it works in Easy at all. (Same
    // reasoning cut the candidate "Long Division": singling out one of the four
    // ops `everyWhichWay` already covers privileges ÷ over × for no reason.)
    id: 'tower', featId: 'tower', mode: 'easy', category: 'onRamp',
    name: 'Tower', hidden: false, scaling: oneTime(),
    criteriaText: 'Use an exponent (^) in an Easy solve — every operator on the pad works in Easy too.',
    art: '🗼', icon: 'tower',
  },
  {
    // Round 2 § D7. The rung above `bracketRookie` (any parenthesis at all).
    // Depth 2 deliberately: craft's Event Horizon is depth 3, so the two read as
    // one paren ladder climbing across the tabs, not two unrelated badges.
    id: 'deepNest', featId: 'deepNest', mode: 'easy', category: 'onRamp',
    name: 'Deep Nest', hidden: false, scaling: oneTime(),
    criteriaText: 'Nest parentheses two levels deep in an Easy solve — a bracket inside a bracket.',
    art: '🪆', icon: 'nested-parens',
  },
  {
    // Round 2 § D7. A THRESHOLD ladder, not a count: the feat is the magnitude
    // reached (`maxIntermediateMagnitude`). Teaches the beginner block that you
    // may overshoot 37 and come back — the Easy sibling of craft's Over the Top
    // (100 → 100,000), stopped at 1,000 since the on-ramp is not where you grind.
    id: 'roundTrip', featId: 'roundTrip', mode: 'easy', category: 'onRamp',
    name: 'Round Trip', hidden: false,
    scaling: thresholdLadder([100, 1000], { unit: 'intermediate value' }),
    criteriaText: 'Push an intermediate value past 100, then 1,000, on the way to 37 in an Easy solve.',
    criteriaTemplate: 'Push an intermediate value past {value} on the way to 37 in an Easy solve.',
    art: '🔄', icon: 'round-trip',
  },
  {
    // Round 2 § D7, RECUT. D7 specced Marathon as an ALL-TIME ladder (25/100/500)
    // — the very same fact `gettingTheHangOfIt` already counts, wearing a second
    // card. A SINGLE-DAY ladder is a genuinely different measure, and it also
    // absorbs the cut candidate "One Sitting": "didn't leave" is not a fact any
    // row records, whereas "most solves on one date" is read off `date`.
    // THRESHOLD, not count — the feat is a best-day high-water mark, which is
    // what `badgeState` judges a threshold badge on. Opens at 15 rather than 10
    // so its first rung can't fire on the same solve as Getting the Hang of It's.
    id: 'marathon', featId: 'marathon', mode: 'easy', category: 'onRamp',
    name: 'Marathon', hidden: false,
    scaling: thresholdLadder([15, 37, 75], { unit: 'solves in one day' }),
    criteriaText: 'Complete 15, then 37, then 75 Easy solves in a single day.',
    criteriaTemplate: 'Complete {value} Easy solves in a single day.',
    art: '🏃', icon: 'marathon',
  },
  {
    // The deliberate Easy → power-dice bridge. Lives on the Easy track because
    // that is where the player is standing when it motivates them. Since the
    // 2026-09-03 per-mode ruling it fires on Challenge OR Expert practice —
    // both are "the step up from Easy", and gating on Challenge alone would
    // leave a player who jumped straight to Expert standing on a dark card.
    // ⚠️ The sentence below has not caught up; it is pinned copy. See the note
    // on the Dojo block in ./badgeRegistry.js.
    id: 'levelingUp', featId: 'levelingUp', mode: 'easy', category: 'onRamp',
    name: 'Leveling Up', hidden: false, scaling: oneTime(),
    criteriaText: 'Complete your first Challenge-mode solve — the step up from Easy.', art: '🪜', icon: 'stairs',
  },
];

