import React, { useEffect, useRef } from 'react';
import { useLocation } from 'react-router-dom';
import { Capacitor } from '@capacitor/core';
import { AdMob, BannerAdPosition, BannerAdSize, BannerAdPluginEvents } from '@capacitor-community/admob';
import { Keyboard } from '@capacitor/keyboard';
import { getBannerAdId, adIsTesting } from './adConfig';
import { whenAdsAllowed } from './adGate';

// Paths that explicitly shouldn't have ads. NATIVE ONLY — this is the blocklist
// the AdMob banner below uses. It was once shared with the web banner to keep
// web↔native placement in parity; web now uses WEB_AD_ELIGIBLE_PATHS instead
// (see below). Do not change this list as part of web work: it is a native
// regression surface.
export const NO_AD_PATHS = ['/login', '/signup', '/intro'];

// Web-only ad eligibility — an ALLOWLIST, deliberately not the mirror image of
// NO_AD_PATHS.
//
// AdSense policy forbids Google-served ads on screens "without content or ...
// used for alerts, navigation or other behavioral purposes", and that describes
// most of this app: the home launcher, the leaderboard, the stats tabs and the
// 404 screen each render 100–250 characters of button and tab labels and nothing
// else. Under the old blocklist every one of those was ad-eligible by default,
// and every route added later inherited that default silently. That is the shape
// AdSense flagged as "Google-served ads on screens without publisher-content"
// (violation #1 of the 2026-08-23 review failure).
//
// So on web a route must EARN an ad by carrying real publisher content. Today
// that is only the How-To-Play page (~1.9k characters of explanatory prose).
// This list is the extension point for the daily-puzzle archive and the
// evergreen explainer pages (AdSense Phase 2) — add each content route here as
// it ships, and every other route stays ad-free with no further work.
//
// Paths are CASE-SENSITIVE and capitalised: routes come from the PAGES keys in
// routing/pages.config.js, so it is '/HowToPlay', not '/how-to-play'.
//
// AdMob's in-app policy is different and the native banner placement is
// unchanged — native keeps using NO_AD_PATHS. Do NOT switch native to this list.
export const WEB_AD_ELIGIBLE_PATHS = ['/HowToPlay'];

export default function GlobalAdManager() {
  const location = useLocation();
  const bannerInitializedRef = useRef(false);
  const currentVisibilityRef = useRef(false); // track native banner shown/hidden state
  const onAdPathRef = useRef(false); // is the current route ad-eligible?
  const hiddenByKeyboardRef = useRef(false); // did WE hide it for the keyboard?

  // Show/hide the banner as the route changes.
  useEffect(() => {
    if (!Capacitor.isNativePlatform()) return;

    const shouldShowAd = !NO_AD_PATHS.includes(location.pathname);
    onAdPathRef.current = shouldShowAd;

    const manageBanner = async () => {
      try {
        if (shouldShowAd) {
          if (!bannerInitializedRef.current) {
            // Respect UMP consent: wait for the gate, and bail (never init the
            // banner) if consent was denied. Leaving bannerInitializedRef false
            // means the resume/hide branches below stay inert too.
            if (!(await whenAdsAllowed())) return;

            const platform = Capacitor.getPlatform();
            const bannerMargin = platform === 'ios' ? 0 : 55;

            // Setup listeners once
            AdMob.addListener(BannerAdPluginEvents.Loaded, () => console.log('Global Banner Loaded'));
            AdMob.addListener(BannerAdPluginEvents.FailedToLoad, (err) => console.error('Global Banner Error', err));
            // Reserve bottom space equal to the banner's reported height + its
            // margin, exposed as a CSS var (--ad-reserved-bottom). #root's
            // padding-bottom (calc(--safe-bottom + --ad-reserved-bottom)) and the
            // shared page utilities (.app-page-shell / .app-page-scroll, which
            // subtract the same var from their height) consume it — so
            // content/buttons never sit under the ad. SizeChanged reports the
            // adaptive banner's actual height, so we never guess. (0 clears the
            // reserve.) [There is no `.safe-pb` utility — that was a stale claim.]
            AdMob.addListener(BannerAdPluginEvents.SizeChanged, (info) => {
              const h = (info && Number(info.height)) || 0;
              const reserved = h > 0 ? h + bannerMargin : 0;
              document.documentElement.style.setProperty('--ad-reserved-bottom', `${reserved}px`);
            });

            const options = {
              adId: getBannerAdId(),
              // ADAPTIVE_BANNER spans the full screen width, so it reads as
              // centered. The fixed-size BANNER (320dp) was left-anchored on
              // wider screens, leaving a gap on the right. Adaptive is also
              // Google's recommended anchored-banner format.
              adSize: BannerAdSize.ADAPTIVE_BANNER,
              position: BannerAdPosition.BOTTOM_CENTER,
              margin: bannerMargin,
              isTesting: adIsTesting()
            };

            await AdMob.showBanner(options);
            bannerInitializedRef.current = true;
            currentVisibilityRef.current = true;
          } else if (!currentVisibilityRef.current && !hiddenByKeyboardRef.current) {
            // Initialized but hidden by a previous navigation — bring it back.
            // (If it's hidden because the keyboard is open, leave it; the
            // keyboardDidHide handler will resume it.)
            await AdMob.resumeBanner();
            currentVisibilityRef.current = true;
          }
        } else {
          // Hide it natively without destroying the view constraints
          if (bannerInitializedRef.current && currentVisibilityRef.current) {
            await AdMob.hideBanner();
            currentVisibilityRef.current = false;
            // No banner on this route → release the reserved bottom space.
            document.documentElement.style.setProperty('--ad-reserved-bottom', '0px');
          }
          // Navigating away cancels any keyboard-hold so we don't auto-resume
          // on a no-ad route when the keyboard closes.
          hiddenByKeyboardRef.current = false;
        }
      } catch (e) {
        console.error('GlobalAdManager Error:', e);
      }
    };

    manageBanner();
  }, [location.pathname]);

  // Keep the banner pinned to the screen bottom by hiding it while the soft
  // keyboard is open. Without this the native banner (anchored to the bottom of
  // the window) jumps up to sit above the keyboard — landing mid-screen — when
  // a text field is focused (e.g. the username field on the welcome screen).
  // Registered once; resumes the banner only after the keyboard is fully gone.
  useEffect(() => {
    if (!Capacitor.isNativePlatform()) return;

    let showHandle;
    let hideHandle;

    const onKeyboardShow = async () => {
      try {
        if (bannerInitializedRef.current && currentVisibilityRef.current) {
          await AdMob.hideBanner();
          currentVisibilityRef.current = false;
          hiddenByKeyboardRef.current = true;
        }
      } catch (e) {
        console.error('GlobalAdManager keyboard-hide error:', e);
      }
    };

    const onKeyboardHide = async () => {
      try {
        if (hiddenByKeyboardRef.current && onAdPathRef.current && bannerInitializedRef.current) {
          await AdMob.resumeBanner();
          currentVisibilityRef.current = true;
        }
        hiddenByKeyboardRef.current = false;
      } catch (e) {
        console.error('GlobalAdManager keyboard-resume error:', e);
      }
    };

    showHandle = Keyboard.addListener('keyboardWillShow', onKeyboardShow);
    hideHandle = Keyboard.addListener('keyboardDidHide', onKeyboardHide);

    return () => {
      // addListener resolves to a handle; remove on unmount.
      Promise.resolve(showHandle).then((h) => h?.remove?.());
      Promise.resolve(hideHandle).then((h) => h?.remove?.());
    };
  }, []);

  return null; // Invisible sentinel component
}
