import { useEffect, useState } from 'react';

import { appSwitchEnabled } from '@/shell';
import { isMember } from '@/auth';
import { fetchMyWeekBonus } from './weekBonus';

// The `referrals` server switch (app_settings, off/beta/on; DEV override
// localStorage['37.switch.referrals']), and the week's bonus count.
//
// WHILE THE SWITCH IS OFF, NOTHING REFERRAL-RELATED RENDERS: every surface asks
// this hook first, and it answers false until the server says otherwise (a
// failed or slow read is 'off' — see @/shell adSwitch).

export const REFERRALS_SWITCH = 'referrals';

/** Is the referrals feature on for this device? Same reader as the ad switch. */
export function referralsEnabled() {
  return appSwitchEnabled(REFERRALS_SWITCH).catch(() => false);
}

/**
 * @param {{ override?: boolean, read?: () => Promise<boolean> }} [opts]
 *   override — a test seam (and lets a caller that already knows skip the read)
 * @returns {boolean} false until known
 */
export function useReferralsOn({ override, read = referralsEnabled } = {}) {
  const [on, setOn] = useState(false);
  const known = typeof override === 'boolean';
  useEffect(() => {
    if (known) return undefined;
    let live = true;
    Promise.resolve().then(read).then((v) => { if (live) setOn(v === true); }, () => {});
    return () => { live = false; };
  }, [known, read]);
  return known ? /** @type {boolean} */ (override) : on;
}

/**
 * This week's "+N from friends", for a saved player while referrals are on.
 * @param {any} user
 * @param {boolean} on the switch
 * @param {{ fetch?: () => Promise<number> }} [deps]
 * @returns {number} 0 = show nothing
 */
export function useMyWeekBonus(user, on, deps = {}) {
  const [bonus, setBonus] = useState(0);
  const userId = user?.id ?? null;
  const member = isMember(user);
  const fetchBonus = deps.fetch || fetchMyWeekBonus;
  useEffect(() => {
    if (!on || !userId || !member) { setBonus(0); return undefined; }
    let live = true;
    Promise.resolve().then(fetchBonus).then(
      (n) => { if (live) setBonus(Number.isInteger(n) && n > 0 ? n : 0); },
      () => { if (live) setBonus(0); },
    );
    return () => { live = false; };
  }, [on, userId, member, fetchBonus]);
  return bonus;
}
