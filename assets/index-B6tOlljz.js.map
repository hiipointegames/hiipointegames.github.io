// Pure player search — normalize + dedup-by-id + exclude-self + substring-match
// over an already-fetched profiles list. Extracted from UserSearch's inline
// pipeline (which also carried a dozen debug console.logs). The component keeps
// the fetch, the 300ms debounce, and the result state; this owns the matching.
//
// `player/index.js` named this a deferred extraction; the read path
// (profileReads) and recommendation engine (recommendations) preceded it.
// NOTE: no Guest / has_custom_username gate — the original only LOGGED that
// field, it never filtered on it. Preserve that (don't add a Guest filter).

// Zero-width characters (ZWSP..ZWJ and the BOM) — stripped during normalize.
// Built via new RegExp with escaped codepoints so the source stays readable
// (a regex literal would embed invisible characters).
const ZERO_WIDTH = new RegExp('[\\u200B-\\u200D\\uFEFF]', 'g');

/**
 * Normalize free text for case/whitespace-insensitive matching: trim, lower,
 * collapse internal whitespace, strip zero-width characters. Exported because
 * UserSearch's pre-fetch "is the query effectively blank?" guard must use the
 * exact same normalization (a zero-width-only query is blank).
 *
 * @param {string} text
 * @returns {string}
 */
export function normalizeText(text) {
  if (!text) return '';
  return text
    .trim()
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .replace(ZERO_WIDTH, '');
}

/**
 * Find players whose username substring-matches the query. Dedups the profiles
 * by id, excludes the searcher, and matches normalized-username against the
 * normalized query. A blank/whitespace/zero-width-only query returns [].
 *
 * @param {Array<object>} profiles - PublicProfile rows (already fetched)
 * @param {string} query
 * @param {{excludeId?: string}} [opts]
 * @returns {Array<object>} matching profile rows
 */
export function searchPlayers(profiles, query, { excludeId } = {}) {
  const normalizedQuery = normalizeText(query);
  if (!normalizedQuery) return [];

  const deduped = (profiles || []).reduce((acc, user) => {
    if (!acc.find((u) => u.id === user.id)) acc.push(user);
    return acc;
  }, []);

  return deduped.filter((u) => {
    if (u.id === excludeId) return false;
    return normalizeText(u.username || '').includes(normalizedQuery);
  });
}
