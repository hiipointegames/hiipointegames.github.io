import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { apiClient } from '@/transport';
import { todayET } from '@/daily-challenge';
import { appSwitchEnabled } from '@/shell';
import { recordOutcome, reportedFallback } from '@/observability';
import { onDailyResultsClosed, requestDailyShareMenu } from '@/game-flow';
import { createPageUrl } from '@/routing/createPageUrl';
import { WEEK_ONE_TIPS, WHATS_NEW } from './tips';
import {
  isTipAudience, playDayPatch, pickTip, shownPatch, answeredPatch, applyPatch,
} from './tipRules';

// useFeatureTips — Layout's half of the first-week tips. Layout hosts it for the
// same reason it hosts the catch-up (useHomeCatchUp's header): it already owns
// `user` and knows when the bare Home launcher is the live surface.
//
// What it does:
//   1. Records today as a play-day for a saved account (once per ET day).
//   2. Holds "the first finished Daily of today just closed its results"
//      (RoundStage's 'dailyResultsClosed') until Home is free, for card 1.
//   3. When `active` (Home idle, and the caller's pop-up chain is clear) has held
//      for SETTLE_MS, picks at most one tip (tipRules.pickTip) and opens it.
//   4. Writes what happened under our OWN top-level keys only.
//
// The settle delay is the "never on top of another pop-up" rule's other half.
// The chain's members flip their own flags a render or two after Home goes idle
// (the catch-up pass sets `busy` inside an effect), so a tip deciding in the very
// first idle render could beat them to the screen. Any flag that flips during
// the delay cancels it.
//
// Kill switch: `app_settings.feature_tips` (off/beta/on, read via @/shell). While
// it is off nothing is recorded or written at all, not even play-days.

/** How long Home must stay idle before a tip may open. */
export const SETTLE_MS = 900;

export const FEATURE_TIPS_SWITCH = 'feature_tips';
export const REFERRALS_SWITCH = 'referrals';

// Production defaults, hoisted so their identity is STABLE across renders: an
// inline arrow in the destructuring below would be a new function every render,
// re-running every effect that lists it (and restarting the settle timer).
const defaultUpdateMe = (patch) => apiClient.auth.updateMe(patch);
const defaultSwitchOn = (key) => appSwitchEnabled(key);
const NO_DEPS = {};

function appVersion() {
  return typeof __APP_VERSION__ === 'string' ? __APP_VERSION__ : null;
}

/**
 * The action keys the registry names, resolved to what the app does.
 * @param {{ navigate: (to: string) => void, openFriends: () => void }} host
 * @returns {Record<string, () => void>}
 */
export function tipActions({ navigate, openFriends }) {
  return {
    share_result: () => requestDailyShareMenu(),
    friends: () => openFriends(),
    blitz: () => navigate(createPageUrl('HeadToHead')),
    stats: () => navigate(createPageUrl('Statistics')),
    badges: () => navigate(createPageUrl('Badges')),
    leaderboards: () => navigate(createPageUrl('Leaderboard')),
  };
}

/**
 * @param {Object} args
 * @param {Record<string, any> | null} args.user Layout's player (merged me() shape)
 * @param {boolean} args.active Home is idle AND no other pop-up is open or pending
 * @param {(to: string) => void} args.navigate
 * @param {() => void} args.openFriends
 * @param {Object} [deps] test seams
 */
export function useFeatureTips({ user, active, navigate, openFriends }, deps = NO_DEPS) {
  const {
    updateMe = defaultUpdateMe,
    today = todayET,
    switchOn = defaultSwitchOn,
    record = recordOutcome,
    version = appVersion(),
    tips = WEEK_ONE_TIPS,
    whatsNew = WHATS_NEW,
    settleMs = SETTLE_MS,
  } = deps;

  const userId = user?.id ?? null;
  const audience = isTipAudience(user);

  // Our own writes, merged over Layout's (possibly stale) copy of the player.
  // Reset when the account changes: one player's writes are not another's.
  const [written, setWritten] = useState(/** @type {Record<string, any>} */ ({}));
  const writtenFor = useRef(userId);
  if (writtenFor.current !== userId) {
    writtenFor.current = userId;
    if (Object.keys(written).length) setWritten({});
  }
  const player = useMemo(() => applyPatch(user, written), [user, written]);
  const playerRef = useRef(player);
  playerRef.current = player;

  const write = useCallback((patch) => {
    if (!patch) return;
    setWritten((w) => ({ ...w, ...patch }));
    // Soft on purpose, like the three-dailies intro: a failed write costs a
    // repeat tip some other day, never the screen. Reported, not swallowed.
    Promise.resolve().then(() => updateMe(patch)).catch(reportedFallback('featureTips.write'));
  }, [updateMe]);

  // ── Switches ────────────────────────────────────────────────────────────────
  const [enabled, setEnabled] = useState(false);
  const [referralsOn, setReferralsOn] = useState(false);
  useEffect(() => {
    if (!userId || !audience) { setEnabled(false); return undefined; }
    let gone = false;
    Promise.all([switchOn(FEATURE_TIPS_SWITCH), switchOn(REFERRALS_SWITCH)])
      .then(([tipsOn, refsOn]) => {
        if (gone) return;
        setEnabled(Boolean(tipsOn));
        setReferralsOn(Boolean(refsOn));
      })
      .catch(() => { if (!gone) setEnabled(false); });
    return () => { gone = true; };
    // Re-read on each return to Home: the reader caches, so a flip lands within
    // its cache window without a request per render.
  }, [userId, audience, active, switchOn]);

  // ── 1. Play-days ────────────────────────────────────────────────────────────
  useEffect(() => {
    if (!enabled || !userId) return;
    write(playDayPatch(playerRef.current, today(), version));
  }, [enabled, userId, active, today, version, write]);

  // ── 2. Card 1's trigger ─────────────────────────────────────────────────────
  const [resultsDay, setResultsDay] = useState(/** @type {string | null} */ (null));
  useEffect(() => onDailyResultsClosed((detail) => {
    if (detail.firstToday) setResultsDay(today());
  }), [today]);

  // ── 3. Pick + open ──────────────────────────────────────────────────────────
  const [current, setCurrent] = useState(/** @type {{ kind: 'week_one'|'whats_new', tip: any } | null} */ (null));
  useEffect(() => {
    if (!active || !enabled || current) return undefined;
    const timer = setTimeout(() => {
      const day = today();
      const base = { user: playerRef.current, today: day, enabled, tips, whatsNew, currentVersion: version };
      const fromResults = resultsDay === day ? pickTip({ ...base, trigger: 'results' }) : null;
      if (resultsDay) setResultsDay(null); // consumed (or stale from another day)
      const picked = fromResults || pickTip({ ...base, trigger: 'home' });
      if (!picked) return;
      setCurrent(picked);
      write(shownPatch(playerRef.current, day));
      record('feature_tip', 'shown', { tip: picked.tip.id });
    }, settleMs);
    return () => clearTimeout(timer);
  }, [active, enabled, current, resultsDay, today, tips, whatsNew, version, settleMs, write, record]);

  // A tip belongs to the account it was picked for.
  useEffect(() => { setCurrent(null); }, [userId]);

  // ── 4. Answers ──────────────────────────────────────────────────────────────
  const actions = useMemo(() => tipActions({ navigate, openFriends }), [navigate, openFriends]);

  const answer = useCallback((how, go) => {
    if (!current) return;
    write(answeredPatch(playerRef.current, current, today(), version));
    record('feature_tip', how, { tip: current.tip.id });
    setCurrent(null);
    if (how === 'go' && go) actions[go]?.();
  }, [current, write, today, version, record, actions]);

  const tip = current?.tip ?? null;
  return {
    // Shown only while Home is still free: a tip under a newly opened modal waits.
    open: Boolean(tip) && active,
    tip,
    extraLine: tip?.id === 'share_result' && referralsOn ? tip.referralLine ?? null : null,
    onGo: (go) => answer('go', go),
    onDismiss: () => answer('dismiss'),
  };
}
