import { useEffect, useRef } from 'react';
import { toast } from '@/ui/primitives/use-toast';
import { todayET } from './dailyTimezone';
import { loadTimedOutAttempts, markAnnounced, timeoutMessage } from './staleDailyNotice';

// useStaleDailyNotice — say it on the next launch, whenever that is.
//
// Mounted app-wide (routing/App.jsx) rather than in Game.jsx, for two reasons.
// It is a cross-mode notice — the abandoned attempt may be Easy while the player
// opens onto Challenge — and Game.jsx is a grandfathered blob the arch ratchet
// holds at a fixed size, so anything that can live elsewhere should.
//
// Fires ONCE per app session, guarded by a ref rather than by the effect's
// dependency list: `user` is a fresh object on every auth refresh, so a
// dependency on it would re-run this on each one and re-toast a notice the
// player has already dismissed within the same session.
//
// Everything it needs is decided in staleDailyNotice — see that file for why a
// completed day looks identical to an abandoned one in the attempts table, and
// why this tells rather than writes.

/**
 * @param {{id?: string}|null} user
 * @param {{load?: Function, notify?: Function, mark?: Function, storage?: Storage}} [deps]
 *   injected by tests; production passes nothing
 */
export function useStaleDailyNotice(user, deps = {}) {
  const announcedFor = useRef(null);

  useEffect(() => {
    const userId = user?.id;
    if (!userId) return;
    // One sweep per player per session. A second render, or a refreshed auth
    // object, must not produce a second round of toasts.
    if (announcedFor.current === userId) return;
    announcedFor.current = userId;

    const {
      load = loadTimedOutAttempts,
      notify = toast,
      mark = markAnnounced,
      storage = typeof localStorage === 'undefined' ? undefined : localStorage,
    } = deps;

    const today = todayET();
    let cancelled = false;

    (async () => {
      const stale = await load({ userId, today, storage });
      if (cancelled || !stale.length) return;

      // Only the most recent. A player back after a fortnight has several, and
      // three stacked toasts saying the same thing about different days is
      // noise, not information — the point is that they learn the rule.
      const [newest] = stale;
      notify({ ...timeoutMessage(newest, today), variant: 'destructive' });

      // Every one found is marked, not just the one shown. Otherwise the second
      // one surfaces tomorrow as though it had just happened.
      for (const item of stale) mark(userId, item, storage);
    })();

    return () => { cancelled = true; };
    // Keyed on the ID ALONE, deliberately. `user` is a fresh object on every
    // auth refresh, and `deps` is a fresh literal on every render, so depending
    // on either would re-run this sweep constantly.
  }, [user?.id]);
}
