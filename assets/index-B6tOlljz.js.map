// How a leaderboard row is NAMED — one rule for every board.
//
// David, 2026-10-10: a guest's Daily time still counts and shows to players with
// an account, as "Guest ####" — never as a real-looking name, and never "Anonymous"
// over and over. The four digits come from the row's user id, so one guest is the
// same "Guest 4821" on every board, every day, and two guests on one podium are
// told apart.
//
// Why one helper: the boards each named rows themselves (GlobalTab, FriendsTab,
// PodiumBanner, LeaderboardView, FastestEverList, Battle Points…) and disagreed —
// the server flags "guest…" names case-insensitively while the client checked
// `startsWith('Guest')` case-sensitively (research 2026-10-10, Q1/Q7). Data is NOT
// rewritten: stored rows keep `user_name: 'Anonymous'`, and signing up renames
// them through the existing set-username cascade.

/** Names that mean "no chosen username": exactly "Anonymous" (what the server
 *  writes for a guest) or anything starting with "guest" — the server's own
 *  rule (`/^guest/i`, submit-daily-time). Only consulted when a row carries no
 *  `has_custom_username` flag. */
const PLACEHOLDER_NAME = /^(anonymous$|guest)/i;

/**
 * Did this row's player choose their own username?
 *
 * Trusts the stored flag when present; otherwise falls back to the name itself,
 * case-insensitively (the server's own rule).
 *
 * @param {{ has_custom_username?: boolean, user_name?: string, username?: string } | null | undefined} row
 * @returns {boolean}
 */
export function isCustomRow(row) {
  if (!row) return false;
  if (typeof row.has_custom_username === 'boolean') return row.has_custom_username;
  const name = String(row.user_name ?? row.username ?? '').trim();
  return name.length > 0 && !PLACEHOLDER_NAME.test(name);
}

/**
 * Four stable digits for a user id ("0000"–"9999"). FNV-1a over the string —
 * not a secret and not unique (10,000 buckets), just stable and well spread.
 *
 * @param {string} id
 * @returns {string}
 */
export function guestDigits(id) {
  let h = 0x811c9dc5;
  for (let i = 0; i < id.length; i += 1) {
    h ^= id.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return String(h % 10000).padStart(4, '0');
}

/**
 * The name to render for a row.
 *
 * @param {{ user_id?: string, has_custom_username?: boolean, user_name?: string, username?: string } | null | undefined} row
 * @returns {string}
 */
export function rowDisplayName(row) {
  if (isCustomRow(row)) return String(row.user_name ?? row.username).trim();
  return row?.user_id ? `Guest ${guestDigits(String(row.user_id))}` : 'Guest';
}

/** A guest row never links to a profile (there is none, and profiles are locked anyway). */
export function isLinkableRow(row) {
  return isCustomRow(row);
}
