// bottomNavVisibility — the pure rules deciding (a) whether the persistent bottom
// nav bar shows for the current surface and (b) which tab is active. Kept
// separate from the presentational BottomNavBar (and mirroring the pure
// homeChromeVisibility helper) so the gating is unit-testable without a DOM.

// The bar is PRESENT BY DEFAULT; surfaces opt OUT (David, 2026-08-01).
//
// This was an allowlist of the five routes that carried the bar, which made
// "no bar" the default for every route added afterwards — so each new page
// silently lost it. /Badges shipped that way (the badge lanes added the route
// long after the list was written), and BlitzStats was already in the same hole.
// A denylist fails the safe way: a new route keeps the bar unless someone
// deliberately excludes it. Keep it that way — do not re-introduce an allowlist.
//
// Each opt-out, with a reason a reader can check:
//   • ResetPassword — an auth flow. Unlike /login and the welcome screen, which
//     render OUTSIDE the Layout (routing/App.jsx) and therefore CANNOT mount the
//     bar at all, ResetPassword IS wrapped by the Layout, so it needs an entry.
//   • HowToPlay — a full-screen reading experience with its own back affordance.
//     It is also the only routed page with no nav-reserving class, so the bar
//     would sit over its content. (The how-to OVERLAY is separate: it hides the
//     bar through `suppressed` — see how-to-play/HowToOverlay.jsx.)
//   • Sector73 — the cockpit is immersive (its own HUD sits where the bar would).
//     It used to hide the bar only by dispatching 'bottomNavChanged' from the page,
//     but /Sector73 remounts Layout (its route element is wrapped in
//     Sector73RouteGate, routing/App.jsx), and on a re-entry the page's layout
//     effect fired before the fresh Layout's listener existed, so the bar showed
//     over the HUD and hid the Star Market's Buy button (David, S21, 2026-10-20).
//     The route name cannot be missed. With the Sector 73 switch OFF the route
//     renders PageNotFound outside the Layout, so this entry is never consulted.
// The Game route opts out CONDITIONALLY (on homeChromeVisible, below) rather
// than being listed here.
//
// FriendList is deliberately NOT listed: it is a dead route — a pure <Navigate>
// redirect to HeadToHead (pages/FriendList.jsx) — so it never renders and cannot
// show a bar. An entry would imply a decision that isn't there.
export const BOTTOM_NAV_EXCLUDED_ROUTES = ['ResetPassword', 'HowToPlay', 'Sector73'];

/**
 * Whether the bottom nav bar should be shown right now. Defaults to TRUE — an
 * unrecognised route gets the bar (see BOTTOM_NAV_EXCLUDED_ROUTES above).
 *
 * `currentPageName` is Layout's routed page name; `homeChromeVisible` is whether
 * the bare Game launcher is unobstructed; `suppressed` lets an in-page drill-down
 * (a live battle, a single leaderboard day, the how-to overlay) hide the bar via
 * 'bottomNavChanged'; `drawerOpen` hides it while the hamburger menu / app drawer
 * is open (the bar sits behind the drawer and, apart from Home, its tabs aren't
 * operable there).
 *
 * @param {{ currentPageName: string, homeChromeVisible: boolean, suppressed?: boolean, drawerOpen?: boolean }} state
 * @returns {boolean}
 */
export function isBottomNavVisible({ currentPageName, homeChromeVisible, suppressed = false, drawerOpen = false }) {
  if (suppressed) return false;
  if (drawerOpen) return false;
  if (BOTTOM_NAV_EXCLUDED_ROUTES.includes(currentPageName)) return false;
  // On the Game route the bar rides the SAME gate as the top chrome: it shows
  // only when the bare launcher is unobstructed (hidden during gameplay, the
  // results/celebration modal, and the pre-game modals), reusing the
  // homeChromeVisible signal Game.jsx already broadcasts via 'homeChromeChanged'.
  if (currentPageName === 'Game') return homeChromeVisible;
  return true;
}

/**
 * Which tab id is active for the current surface. The Friends overlay wins when
 * open (it can be opened from any top-level route); otherwise the active tab
 * follows the route. A route with no sensible tab returns null (no highlight),
 * which is fine — the bar still shows.
 *
 * @param {{ currentPageName: string, friendsOpen?: boolean }} state
 * @returns {string|null} a NAV_TABS id, or null when nothing maps
 */
export function activeNavId({ currentPageName, friendsOpen = false }) {
  if (friendsOpen) return 'friends';
  switch (currentPageName) {
    case 'Game': return 'home';
    case 'HeadToHead': return 'blitz';
    case 'Leaderboard': return 'board';
    case 'Statistics': return 'stats';
    // Badges is a drill-down FROM Statistics, so it keeps the Stats tab lit —
    // the highlight shows where you are in the hierarchy, not just which tab you
    // last tapped (David, 2026-08-01). OtherProfile stays null: it is reachable
    // from several places, so no one tab is truthful there.
    case 'Badges': return 'stats';
    default: return null;
  }
}
