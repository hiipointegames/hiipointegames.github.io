import { supabase } from './supabaseClient';
import { resolveSession } from './sessionResolution';
import * as Entities from './entities';

// Compatibility wrapper around the Supabase client. Exposes auth, entities,
// functions, and integrations surfaces used across the codebase as the
// canonical client object — single import site for all backend access.
//
// Edge function calls go through `edgeCall` from `./edgeCallPort` directly —
// the historic `apiClient.functions.invoke` shim was removed once every
// caller migrated (see ADR-0001).
export const apiClient = {
  // Direct access to supabase client for complex queries
  supabase,

  auth: {
    me: async () => {
      // getUser() performs a NETWORK request to the auth server. On a flaky or
      // slow connection it can resolve with a null user even when a valid
      // session is persisted locally. That false "no user" made a user who had
      // just logged in look like a guest, so the welcome-gate bounced them back
      // to the onboarding screen on slow devices (they had to sign in twice).
      // Fall back to the locally-stored session (getSession is local, no
      // network) so identity survives a transient network blip.
      //
      // getUser() can also REJECT rather than resolve null: it serializes
      // through @supabase/auth-js's internal lock, and when that lock's
      // acquire times out the library aborts its AbortController without a
      // reason, so the pending call rejects with a generic
      // "AbortError: signal is aborted without reason" (Sentry
      // 37-THE-MATH-PUZZLE-2H) instead of resolving null. Treat a throw the
      // same as a null user so a transient lock timeout doesn't make a
      // logged-in player look signed out.
      let resolved = null;
      try {
        const { data: { user } } = await supabase.auth.getUser();
        resolved = user;
      } catch {
        resolved = null;
      }
      if (!resolved) {
        // resolveSession also covers an expired token that could not be
        // refreshed offline: the stored member, not null.
        ({ user: resolved } = await resolveSession());
      }
      if (!resolved) return null;

      // Merge user_metadata into user object for easier access
      // This allows code to access user.has_custom_username instead of user.user_metadata.has_custom_username
      return {
        ...resolved,
        ...resolved.user_metadata
      };
    },
    updateMe: async (attributes) => {
      const { data: { user }, error } = await supabase.auth.updateUser({
        data: attributes
      });
      if (error) throw error;

      // Return merged user for consistency with me()
      return {
        ...user,
        ...user.user_metadata
      };
    },
    logout: async () => supabase.auth.signOut(),
    redirectToLogin: () => { window.location.href = '/login'; }
  },

  // Map the exported entities so legacy code like apiClient.entities.DailyChallenge works
  entities: Entities,

  integrations: {
    Core: {
      InvokeLLM: async () => { console.warn('InvokeLLM not implemented'); },
      SendEmail: async () => { console.warn('SendEmail not implemented'); },
      SendSMS: async () => { console.warn('SendSMS not implemented'); },
      UploadFile: async () => { console.warn('UploadFile not implemented'); },
      GenerateImage: async () => { console.warn('GenerateImage not implemented'); },
      ExtractDataFromUploadedFile: async () => { console.warn('ExtractData not implemented'); }
    }
  }
};
