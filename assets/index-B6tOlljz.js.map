// Arbitrary-dice solver (5B): given a day's 7 dice + their colors, find a VALID
// solve (exactly 2 of 3 power dice used correctly) and a PERFECT solve (all 3),
// each using every die once and evaluating to 37. Used by the daily fail screen
// to SHOW a player what was possible on that day's dice. Pure — CapGo-clean.
//
// Approach: a bounded "combine two at a time" search (the classic countdown/24
// solver) building integer expressions, then classify each =37 expression with
// the REAL engine's power-dice correctness. Integer-only (division must divide
// evenly; exponents bounded) — keeps the search finite and sidesteps
// float-equality issues. Early-exits as soon as both a valid and a perfect are
// found; a hard iteration cap guarantees termination.
//
// It runs in TWO passes because one uniform pass starves perfect solves. A
// perfect needs all 3 power dice used correctly, which is rare; the uniform
// search kept spending its whole budget on the plentiful valid branches and
// surfaced no perfect on ~5 of every 40 days even though one existed. So the
// perfect gets its own pass FIRST, one that prunes every branch which misuses a
// power die (see POWER_DIE_OPS) and explores power-die-consuming branches
// first — same budget, but it found a perfect on 40 of 40 probe days.

import { getPowerDiceCorrectness, countPowerDiceCorrect, evaluateEquation } from './equationUtils';

const OPS = ['+', '-', '*', '/', '^'];
const VALUE_CAP = 100000; // prune runaway intermediates (esp. exponents)

// Integer-safe binary op. Returns null when the op would produce a non-integer
// or an out-of-range value.
function applyOp(op, a, b) {
  switch (op) {
    case '+': return a + b;
    case '-': return a - b;
    case '*': return a * b;
    case '/': return b !== 0 && a % b === 0 ? a / b : null;
    case '^': {
      if (b < 0 || b > 6) return null;
      const r = a ** b;
      return Number.isFinite(r) && Math.abs(r) <= VALUE_CAP ? r : null;
    }
    default: return null;
  }
}

// Operator precedence (higher binds tighter). Matches the app's evaluator + PEMDAS.
const PREC = { '+': 1, '-': 1, '*': 2, '/': 2, '^': 3 };

// Which operators each power-die color may sit under. This mirrors the engine's
// verdict in `getPowerDiceCorrectness`: a colored die is "used correctly" purely
// by the operator of its IMMEDIATE PARENT in the expression tree — green wants
// +/−, blue wants ×/÷, red wants to be an operand of ^. Nothing further up the
// tree can change that verdict.
//
// That locality is what makes the perfect pass below possible: in a "combine two
// at a time" search, the moment a colored die's LEAF is consumed by an operator,
// its correctness is decided forever. So a branch that consumes a green die with
// `*` can never become a perfect solve, and can be pruned on the spot.
//
// (The engine re-derives its verdict from the serialized string, whose parse can
// re-group same-precedence chains — `a+(b−c)` renders as `a+b−c`. That only ever
// swaps an operator for another at the SAME precedence level, and the three
// classes above are exactly the precedence levels, so the verdict is unchanged.
// Every candidate is still re-verified against the real engine before it counts.)
const POWER_DIE_OPS = { green: ['+', '-'], blue: ['*', '/'], red: ['^'] };

/** May a die of this color sit directly under `op`? White/unknown → unconstrained. */
const powerOpAllowed = (color, op) => {
  const allowed = POWER_DIE_OPS[color];
  return !allowed || allowed.includes(op);
};

/**
 * Serialize an expression AST (`{n}` leaves / `{op,l,r}` nodes) with the MINIMUM
 * parentheses that preserve its meaning under standard precedence + associativity.
 *
 * This replaces the old fully-parenthesized rendering — the daily forfeit screen
 * complained the shown solves were "too complicated with heavy and unnecessary
 * parentheses." A child is wrapped ONLY when precedence/associativity would
 * otherwise re-group it:
 *   - lower-precedence child under a higher-precedence parent  → wrap (e.g. (a+b)*c)
 *   - equal-precedence RIGHT child of a non-associative op (− ÷) → wrap (a−(b−c))
 *   - equal-precedence LEFT child of the right-associative ^     → wrap ((a^b)^c)
 * Everything else renders bare, so `((a+b)+c)` becomes `a+b+c` and `(a*b)+c`
 * becomes `a*b+c`. Exported for direct unit testing.
 */
export function serializeMinimal(ast) {
  const walk = (node) => {
    if (node.op === undefined) return { str: String(node.n), prec: Infinity };
    const p = PREC[node.op];
    const L = walk(node.l);
    const R = walk(node.r);
    const leftNeeds = L.prec < p || (L.prec === p && node.op === '^');
    let rightNeeds;
    if (R.prec < p) rightNeeds = true;
    else if (R.prec === p) rightNeeds = node.op === '-' || node.op === '/';
    else rightNeeds = false;
    const ls = leftNeeds ? `(${L.str})` : L.str;
    const rs = rightNeeds ? `(${R.str})` : R.str;
    return { str: `${ls}${node.op}${rs}`, prec: p };
  };
  return walk(ast).str;
}

/** Count the parenthesis groups in a serialized equation (used for simplicity ranking). */
export function parenGroupCount(equation) {
  let n = 0;
  for (const ch of equation) if (ch === '(') n++;
  return n;
}

// Rank two solve candidates: fewer parens first, then the shorter equation.
const simplerFirst = (a, b) =>
  (a.parens - b.parens) || (a.equation.length - b.equation.length) || (a.equation < b.equation ? -1 : 1);

/**
 * From pools of engine-verified VALID (2/3 power dice) and PERFECT (3/3) solves,
 * choose the pair to show on the forfeit screen (item 6). Goal: both SIMPLE, and
 * exactly ONE of the two carries a single necessary parenthesis group (models
 * correct paren use — David's spec), the other flat (zero parens). Falls back to
 * the two simplest if a given day's dice can't produce that split. Deterministic
 * (ties broken by string) so the same dice always yield the same solves. Exported
 * for direct testing.
 */
export function pickSolvePair(validPool, perfectPool) {
  const prep = (pool) => {
    const seen = new Set();
    return pool
      .filter((c) => (seen.has(c.equation) ? false : seen.add(c.equation)))
      .sort(simplerFirst);
  };
  const vs = prep(validPool);
  const ps = prep(perfectPool);
  const first = (pool, k) => pool.find((c) => c.parens === k) || null;

  const vFlat = first(vs, 0), vOne = first(vs, 1);
  const pFlat = first(ps, 0), pOne = first(ps, 1);

  // Prefer a "one flat + one single-paren" split. Try the paren on the perfect
  // (option A) or on the valid (option B); if both exist, take the shorter combo.
  const optA = vFlat && pOne ? { valid: vFlat, perfect: pOne } : null;
  const optB = vOne && pFlat ? { valid: vOne, perfect: pFlat } : null;
  const len = (o) => o.valid.equation.length + o.perfect.equation.length;
  let chosen = optA && optB ? (len(optA) <= len(optB) ? optA : optB) : (optA || optB);

  // Fallback: no clean split for this day — show the two simplest available.
  if (!chosen) chosen = { valid: vs[0] || null, perfect: ps[0] || null };
  return chosen;
}

// Search budget. Raised from the old 600k after a probe showed 600k MISSES an
// existing perfect on ~43% of days (it burns the budget on valid-heavy branches
// before reaching a perfect). A few million recovers nearly all of them. Safe to
// raise now that the UI drives the search OFF the paint path in time-slices
// (createDailySolver) — a big budget no longer freezes the forfeit screen.
export const DEFAULT_MAX_OPS = 4_000_000;
// Per-slice op budget when driven cooperatively (~4ms of work at ~100ms/1M ops),
// so each slice yields to the event loop and never blocks a frame.
export const DEFAULT_SLICE_OPS = 40_000;
// Share of the total budget the PERFECT pass may spend before it hands the rest
// to the valid pass. The pruned pass finds a perfect in ~340k ops on a typical
// day (40-day probe), so 75% is generous headroom while still leaving the valid
// pass roughly today's whole budget on all but pathological days. The two passes
// share ONE op counter, so the overall ceiling is still `maxOps` — this change
// does not make the search cost more than it did before.
const PERFECT_OPS_SHARE = 0.75;

/**
 * Incremental, PAUSABLE daily solver. Runs the same bounded "combine two at a
 * time" search as {@link solveDaily}, but iteratively (explicit stack instead of
 * native recursion) so it can be spread across animation frames: call
 * `step(sliceOps)` repeatedly until it returns `{ done: true }`, then read
 * `getResult()`. This lets the forfeit screen paint instantly and compute the
 * "what was possible today" solves without ever blocking a single paint.
 *
 * @param {number[]} dice - 7 dice values (board order)
 * @param {readonly string[]} colors - positional colors (e.g. POWER_DICE_COLORS)
 * @param {{ target?: number, maxOps?: number }} [opts]
 */
export function createDailySolver(dice, colors, { target = 37, maxOps = DEFAULT_MAX_OPS } = {}) {
  const invalid = !Array.isArray(dice) || dice.length !== 7;

  // How many power dice this board actually carries. Challenge's and Expert's
  // Dailies deal three; EASY'S DAILY DEALS NONE (all seven are white).
  //
  // Everything below used to hard-code "3 = perfect, 2 = valid". On an all-white
  // board `countPowerDiceCorrect` is necessarily 0, so EVERY candidate fell
  // through to `return` and the solver reported no solution for ANY all-white
  // board — regardless of the dice. That is the client-side twin of the server
  // bug fixed in generate-daily-challenge v48, where checkAllPowerDiceCorrect
  // demanded exactly three coloured dice and made every Easy puzzle score 0.
  //
  // Its one consumer is SuccessModal's forfeit screen ("here is what was
  // possible today"), so an Easy player who forfeited saw a permanently empty
  // solutions panel.
  const powerDiceTotal = (colors || []).filter((c) => c && c !== 'white').length;

  let ops = 0;

  // Collect candidate solves (deduped/ranked later by pickSolvePair) rather than
  // grabbing the first found, so we can prefer SIMPLE equations with exactly one
  // necessary paren. Capped so scarce-perfect days don't run to maxOps needlessly.
  const POOL_CAP = 40;
  const validPool = [];
  const perfectPool = [];
  // Early-exit as soon as a "flat + single-paren" split is achievable across the
  // pools — that's all pickSolvePair needs for the ideal result.
  let idealReady = false;

  const store = (node, perfectOnly = false) => {
    if (node.value !== target) return;
    // Render with minimal parentheses (was fully-parenthesized) so the daily
    // forfeit screen shows clean, human-readable solves. Operand order is
    // unchanged, so node.indices still lines up with the equation left-to-right.
    const equation = serializeMinimal(node.ast);
    // Verify with the real engine (value + power-dice count) before accepting.
    const evalRes = evaluateEquation(equation);
    if (!evalRes.valid || evalRes.result !== target) return;
    const count = countPowerDiceCorrect(getPowerDiceCorrectness(equation, node.indices, colors));
    const cand = { equation, usedIndices: node.indices, powerCorrect: count, parens: parenGroupCount(equation) };
    if (powerDiceTotal === 0) {
      // hasPerfectConcept === hasPowerDice, so Easy's Daily has NO perfect
      // concept. Such a solve is VALID and must never enter perfectPool —
      // treating it as perfect would award perfect-solve points and badges in a
      // mode with no power dice to get right.
      if (!perfectOnly && validPool.length < POOL_CAP) validPool.push(cand);
      else return;
    }
    else if (count === 3 && perfectPool.length < POOL_CAP) perfectPool.push(cand);
    // The perfect pass only ever completes power-die-correct branches, so a 2/3
    // there means the engine disagreed with the prune — drop it rather than
    // quietly feeding a surprise into the valid pool.
    else if (!perfectOnly && count === 2 && validPool.length < POOL_CAP) validPool.push(cand);
    else return;
    if (!idealReady && (cand.parens === 0 || cand.parens === 1)) {
      const v0 = validPool.some((c) => c.parens === 0), v1 = validPool.some((c) => c.parens === 1);
      const p0 = perfectPool.some((c) => c.parens === 0), p1 = perfectPool.some((c) => c.parens === 1);
      idealReady = (v0 && p1) || (v1 && p0);
    }
  };

  const poolsFull = () => validPool.length >= POOL_CAP && perfectPool.length >= POOL_CAP;

  // Explicit LIFO stacks of partial states (each a `nodes` array). Seeding with
  // the 7 singleton leaves and popping the most-recently-pushed reproduces the
  // recursive DFS iteratively, so the search can pause/resume between slices.
  // A node's `ast` is a leaf `{n}` OR a combine `{op,l,r}`, hence `ast: any`;
  // `leaf` is the die position for an un-combined leaf (undefined once combined),
  // which is what lets the perfect pass know a die's color at combine time.
  /** @typedef {{ value: number, indices: number[], ast: any, leaf?: number }} SolveNode */
  const seed = () => dice.map((v, i) => ({ value: v, indices: [i], ast: { n: v }, leaf: i }));

  // Are there any power dice at all? Without them no expression can ever be a
  // perfect solve (the engine's correctness map comes back empty), so the
  // perfect pass has nothing to search — and that absence is itself conclusive.
  const hasPowerDice = Array.isArray(colors) && colors.length >= 7
    && colors.some((c) => c && c !== 'white');
  const powerColorOf = (node) => (node.leaf === undefined ? null : (colors?.[node.leaf] || null));

  /** @type {SolveNode[][]} */
  const perfectStack = invalid || !hasPowerDice ? [] : [seed()];
  /** @type {SolveNode[][]} */
  const validStack = invalid ? [] : [seed()];

  // Pass 1's ceiling. Both passes bill the SAME `ops` counter, so pass 2 simply
  // inherits whatever pass 1 left of `maxOps`.
  const perfectCap = Math.floor(maxOps * PERFECT_OPS_SHARE);
  // A board with no power dice cannot have a perfect solve, so the pruned pass
  // would burn its 75% op share proving a foregone conclusion — the same wasted
  // budget the server hit before v48. Skip it and give Easy the whole budget for
  // the search that can actually succeed.
  const perfectPassActive = () =>
    powerDiceTotal > 0 && perfectStack.length > 0 && ops < perfectCap && perfectPool.length < POOL_CAP;
  // Latched when pass 1 empties its stack inside budget — see isExhaustive.
  let perfectExhausted = false;

  const isDone = () => invalid || (!perfectPassActive()
    && (idealReady || poolsFull() || ops >= maxOps || validStack.length === 0));

  /**
   * Expand one partial state into its children and push them onto `stack`.
   *
   * Children are generated in the SAME order the recursive solver visited them,
   * then pushed REVERSED so `stack.pop()` yields them forward again. Order is
   * load-bearing: OPS lists '^' last on purpose, so additive/multiplicative
   * branches are explored before exponent dead-ends — exploring '^' first would
   * burn the whole budget on pruned high powers.
   *
   * When `constrained` (the perfect pass) two extra rules apply:
   *  - PRUNE any combine that misuses a power die's leaf (see POWER_DIE_OPS).
   *    Exact, not heuristic — such a branch can never be a perfect solve.
   *  - Explore power-die-consuming children FIRST, so those hard constraints
   *    bite early instead of after the budget has gone on all-white branches.
   */
  const expandInto = (nodes, stack, constrained) => {
    const n = nodes.length;
    const kids = [];
    const hot = []; // children that consume a power die — explored first
    for (let i = 0; i < n; i++) {
      for (let j = 0; j < n; j++) {
        if (i === j) continue;
        const a = nodes[i];
        const b = nodes[j];
        const ca = constrained ? powerColorOf(a) : null;
        const cb = constrained ? powerColorOf(b) : null;
        const consumesPower = !!((ca && ca !== 'white') || (cb && cb !== 'white'));
        for (const op of OPS) {
          // + and * are commutative → only visit each unordered pair once.
          if ((op === '+' || op === '*') && i > j) continue;
          if (ca && !powerOpAllowed(ca, op)) continue;
          if (cb && !powerOpAllowed(cb, op)) continue;
          ops++;
          const val = applyOp(op, a.value, b.value);
          if (val === null || Math.abs(val) > VALUE_CAP) continue;
          const rest = [];
          for (let k = 0; k < n; k++) if (k !== i && k !== j) rest.push(nodes[k]);
          (consumesPower ? hot : kids).push([
            { value: val, indices: a.indices.concat(b.indices), ast: { op, l: a.ast, r: b.ast } },
            ...rest,
          ]);
        }
      }
    }
    // Cold first, then hot — pop() then yields the hot ones first. In the
    // unconstrained pass `hot` is always empty, so this is the original order.
    for (let c = kids.length - 1; c >= 0; c--) stack.push(kids[c]);
    for (let c = hot.length - 1; c >= 0; c--) stack.push(hot[c]);
  };

  /**
   * Run up to ~`sliceOps` operations, then yield. The op check is between
   * whole node-expansions (each expansion is ≤ n²·5 ops, tiny), so a slice may
   * overshoot by one small expansion — negligible for smoothness.
   *
   * Two passes, in order:
   *  1. PERFECT — the power-die-pruned search. On a 40-day probe this found a
   *     perfect on every day within ~340k ops; the old single uniform pass
   *     missed one on 5 of those 40 days after spending its full 4M.
   *  2. VALID — the original unconstrained search, unchanged, for the 2/3 pool.
   * The split is deterministic (it depends only on op counts, never on how the
   * caller sliced), so a stepped run and a one-shot run agree exactly.
   * @returns {{ done: boolean }}
   */
  const step = (sliceOps = DEFAULT_SLICE_OPS) => {
    if (invalid) return { done: true };
    const sliceEnd = ops + sliceOps;

    while (perfectPassActive()) {
      if (ops >= sliceEnd) return { done: false };
      const nodes = perfectStack.pop();
      if (nodes.length === 1) store(nodes[0], true);
      else expandInto(nodes, perfectStack, true);
    }
    if (perfectStack.length === 0 && ops < perfectCap) perfectExhausted = true;

    while (validStack.length) {
      if (idealReady || poolsFull() || ops >= maxOps) break;
      if (ops >= sliceEnd) return { done: false };
      const nodes = validStack.pop();
      if (nodes.length === 1) store(nodes[0]);
      else expandInto(nodes, validStack, false);
    }
    return { done: true };
  };

  /**
   * Did the search walk the whole space a perfect solve could HIDE in, or did
   * it stop at the op budget?
   *
   * This is the difference between "today's dice genuinely have no perfect
   * solve" and "we ran out of search budget before finding one" — and the
   * forfeit screen must not claim the former when it only knows the latter
   * (Bryce, 1.0.287: a forfeit showed a Valid Solve and silently no Perfect,
   * leaving no way to tell which case it was).
   *
   * It reads pass 1, the perfect pass, because that pass IS the perfect space:
   * its pruning only ever drops branches that can't be perfect, so emptying its
   * stack inside budget is a proof that no perfect exists. The verdict is
   * latched when that pass ends — pass 2 then spends the rest of the budget on
   * valid solves, which can't unmake the proof.
   *
   * A stop is inconclusive if the op budget cut pass 1 short, or if it stopped
   * early on a full perfect pool — and a full pool means a perfect is already in
   * hand, so the flag isn't consulted then anyway.
   *
   * Caveat kept honest in the UI wording: "whole space" means the space this
   * search walks, which prunes intermediates beyond VALUE_CAP.
   * @returns {boolean}
   */
  const isExhaustive = () => !invalid && perfectExhausted;

  return {
    step,
    isDone,
    isExhaustive,
    getResult: () => (invalid
      ? { valid: null, perfect: null, exhaustive: false }
      : { ...pickSolvePair(validPool, perfectPool), exhaustive: isExhaustive() }),
  };
}

/**
 * Synchronous convenience wrapper — runs {@link createDailySolver} to completion
 * in one pass.
 *
 * KEPT DELIBERATELY, with ZERO production callers. Verified 2026-09-03: the only
 * live solver path is `createDailySolver`, which SuccessModal drives across
 * frames so a multi-million-op search never blocks a paint. Nothing in the app
 * calls this function, and a dead-export sweep will surface it again.
 *
 * It stays because it is the differential ORACLE for that stepper. The stepper's
 * whole risk is that slicing a search across frames changes its answer — pausing
 * mid-walk, resuming with the wrong stack, latching `exhaustive` at the wrong
 * moment. This wrapper walks the identical space in one uninterrupted pass, so
 * "stepped result === one-shot result" is an independent check on the slicing
 * itself rather than the stepper agreeing with a recording of its own output.
 * solveDaily.test.js compares them across a spread of boards; delete this and
 * that check has nothing left to compare against.
 *
 * It is also what `src/transport/submitDailyTime.integration.test.js` uses to
 * produce a genuinely engine-valid solve to submit to staging.
 *
 * So: not dead, test-only. If you are pruning exports, prune something else.
 *
 * @param {number[]} dice - 7 dice values (board order)
 * @param {readonly string[]} colors - positional colors (e.g. POWER_DICE_COLORS)
 * @param {{ target?: number, maxOps?: number }} [opts]
 * @returns {{ valid: {equation:string,usedIndices:number[],powerCorrect:number}|null,
 *             perfect: {equation:string,usedIndices:number[],powerCorrect:number}|null }}
 */
export function solveDaily(dice, colors, opts = {}) {
  const solver = createDailySolver(dice, colors, opts);
  solver.step(Infinity); // Infinite slice → run straight through to completion.
  return solver.getResult();
}
