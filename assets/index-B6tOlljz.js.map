// feature-tips/tipRules — WHEN a first-week tip shows. Pure: no React, no network.
//
// Product rules (David, 2026-10-20 — final):
//   * Saved (non-anonymous) accounts only. Guests never see a tip.
//   * A PLAY-DAY is a distinct America/New_York calendar day on which the saved
//     account opens the app. Recorded once per day under its OWN top-level
//     user_metadata key `play_days` (docs/architecture/patterns.md "Own top-level
//     user_metadata key per feature"); only the first 7 days are kept, which is
//     all the cards need.
//   * Four week-one cards, due on play-days 1, 3, 5 and 7. A card is DUE when the
//     player's play-day count has reached its day and it is not seen yet.
//   * CATCH-UP: at most ONE tip per ET day, and the lowest-numbered due card
//     first — so a player who skips days, or who was a guest for a while, still
//     sees all four, one a day, in order.
//   * Each card has a trigger. Card 1 fires when the results of the first
//     finished Daily of the day close; cards 2–4 fire on Home idle. A trigger
//     only ever offers its OWN cards: otherwise a player who never finishes a
//     Daily would sit on an unseen card 1 and never get cards 2–4.
//   * WHAT'S NEW: once per account, the newest registry note whose version is
//     ≤ this build and > the last one this account saw. Never on a day a tip
//     already showed. A new account starts at the current version (the first
//     play-day write sets it), so it never sees old notes.
//
// State lives under the top-level key `feature_tips`:
//   { seen: { [tipId]: 'YYYY-MM-DD' }, last_tip_day?: 'YYYY-MM-DD', whats_new?: '<version>' }
// Patches here return ONLY our own keys — `updateUser({ data })` merges top-level
// keys, so writing `{ feature_tips }` alone can never revert anyone else's key.

import { isMember } from '@/auth';

export const PLAY_DAYS_META_KEY = 'play_days';
export const FEATURE_TIPS_META_KEY = 'feature_tips';
/** Play-days kept: enough to know play-days 1..7. */
export const MAX_PLAY_DAYS = 7;

const DAY_RE = /^\d{4}-\d{2}-\d{2}$/;

/** Read a top-level metadata key from either the merged me() shape or the raw user. */
function metaValue(user, key) {
  return user?.user_metadata?.[key] ?? user?.[key];
}

/** Only saved accounts see tips. */
export function isTipAudience(user) {
  return Boolean(user) && isMember(user);
}

/**
 * The player's recorded play-days, oldest first, distinct, valid only.
 * @param {Record<string, any> | null | undefined} user
 * @returns {string[]}
 */
export function readPlayDays(user) {
  const raw = metaValue(user, PLAY_DAYS_META_KEY);
  if (!Array.isArray(raw)) return [];
  return [...new Set(raw.filter((d) => typeof d === 'string' && DAY_RE.test(d)))].slice(0, MAX_PLAY_DAYS);
}

/**
 * The tips state, normalised. Anything malformed reads as "nothing seen".
 * @param {Record<string, any> | null | undefined} user
 * @returns {{ seen: Record<string, string>, last_tip_day?: string, whats_new?: string }}
 */
export function readTipState(user) {
  const raw = metaValue(user, FEATURE_TIPS_META_KEY);
  const state = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
  const seen = state.seen && typeof state.seen === 'object' && !Array.isArray(state.seen) ? state.seen : {};
  const out = { seen: { ...seen } };
  if (typeof state.last_tip_day === 'string') out.last_tip_day = state.last_tip_day;
  if (typeof state.whats_new === 'string') out.whats_new = state.whats_new;
  return out;
}

/**
 * Compare two dotted versions numerically ('1.0.10' > '1.0.9').
 * @returns {number} <0, 0 or >0
 */
export function compareVersions(a, b) {
  const pa = String(a ?? '').split('.').map((n) => parseInt(n, 10) || 0);
  const pb = String(b ?? '').split('.').map((n) => parseInt(n, 10) || 0);
  for (let i = 0; i < Math.max(pa.length, pb.length); i += 1) {
    const d = (pa[i] ?? 0) - (pb[i] ?? 0);
    if (d !== 0) return d;
  }
  return 0;
}

/**
 * The metadata patch that records today as a play-day, or null when there is
 * nothing to write (already recorded, 7 days already kept, not a saved account).
 *
 * The FIRST play-day also starts What's-new at the current version, so a new
 * account never sees notes from before it joined. Both are our own top-level
 * keys; nothing else is sent.
 *
 * @param {Record<string, any> | null | undefined} user
 * @param {string} today 'YYYY-MM-DD' ET
 * @param {string | null} [currentVersion] __APP_VERSION__
 * @returns {Record<string, any> | null}
 */
export function playDayPatch(user, today, currentVersion = null) {
  if (!isTipAudience(user) || !DAY_RE.test(String(today))) return null;
  const days = readPlayDays(user);
  if (days.includes(today) || days.length >= MAX_PLAY_DAYS) return null;
  const patch = { [PLAY_DAYS_META_KEY]: [...days, today] };
  const state = readTipState(user);
  if (!state.whats_new && currentVersion) {
    patch[FEATURE_TIPS_META_KEY] = { ...state, whats_new: currentVersion };
  }
  return patch;
}

/**
 * The week-one card due for this trigger right now, or null.
 *
 * @param {{ tips: ReadonlyArray<any>, playDays: string[], state: ReturnType<typeof readTipState>,
 *           today: string, trigger: 'results'|'home' }} args
 * @returns {any | null}
 */
export function dueWeekOneTip({ tips, playDays, state, today, trigger }) {
  if (state.last_tip_day === today) return null;
  const count = playDays.filter((d) => d <= today).length;
  const due = tips
    .filter((t) => t.trigger === trigger && t.day <= count && !state.seen[t.id])
    .sort((a, b) => a.day - b.day);
  return due[0] ?? null;
}

/**
 * The What's-new note due right now, or null. Newest qualifying note wins.
 *
 * @param {{ entries: ReadonlyArray<any>, state: ReturnType<typeof readTipState>,
 *           today: string, currentVersion: string | null }} args
 */
export function dueWhatsNew({ entries, state, today, currentVersion }) {
  if (!currentVersion || !state.whats_new) return null;
  if (state.last_tip_day === today) return null;
  const due = entries
    .filter((e) => compareVersions(e.version, currentVersion) <= 0 && compareVersions(e.version, state.whats_new) > 0)
    .sort((a, b) => compareVersions(b.version, a.version));
  return due[0] ?? null;
}

/**
 * Pick the ONE tip to show for a trigger, or null. The single entry point the
 * hook calls; everything above is its parts.
 *
 * @param {{ user: any, today: string, trigger: 'results'|'home', enabled: boolean,
 *           tips: ReadonlyArray<any>, whatsNew: ReadonlyArray<any>, currentVersion: string | null }} args
 * @returns {{ kind: 'week_one' | 'whats_new', tip: any } | null}
 */
export function pickTip({ user, today, trigger, enabled, tips, whatsNew, currentVersion }) {
  if (!enabled || !isTipAudience(user)) return null;
  const playDays = readPlayDays(user);
  const state = readTipState(user);
  const card = dueWeekOneTip({ tips, playDays, state, today, trigger });
  if (card) return { kind: 'week_one', tip: card };
  if (trigger !== 'home') return null;
  const note = dueWhatsNew({ entries: whatsNew, state, today, currentVersion });
  return note ? { kind: 'whats_new', tip: note } : null;
}

/** Patch: a tip went on screen today (uses up the day's one tip). */
export function shownPatch(user, today) {
  return { [FEATURE_TIPS_META_KEY]: { ...readTipState(user), last_tip_day: today } };
}

/**
 * Patch: the player answered a tip (either button). A week-one card is marked
 * seen; a What's-new note moves `whats_new` to the current version.
 *
 * @param {Record<string, any> | null | undefined} user
 * @param {{ kind: 'week_one' | 'whats_new', tip: any }} picked
 * @param {string} today
 * @param {string | null} currentVersion
 */
export function answeredPatch(user, picked, today, currentVersion) {
  const state = readTipState(user);
  if (picked.kind === 'whats_new') {
    return { [FEATURE_TIPS_META_KEY]: { ...state, whats_new: currentVersion || picked.tip.version } };
  }
  return { [FEATURE_TIPS_META_KEY]: { ...state, seen: { ...state.seen, [picked.tip.id]: today } } };
}

/**
 * Apply a metadata patch to a local user copy (both shapes), so the hook's view
 * matches what it just wrote without a re-read.
 */
export function applyPatch(user, patch) {
  if (!user || !patch) return user;
  return { ...user, ...patch, user_metadata: { ...(user.user_metadata || {}), ...patch } };
}
