import React, { useState, useEffect, useRef } from 'react';
import { Input } from '@/ui/primitives/input';
import { Button } from '@/ui/primitives/button';
import { Search, User, UserPlus, Check, Clock } from 'lucide-react';
import { apiClient } from '@/transport';
import { Link } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import { useNotifications } from '@/notifications';
import { countryName } from './countryName';
import {
  searchPlayers,
  normalizeText,
  getFriendEdges,
  deriveFriendStatus,
  sendFriendRequest,
  acceptFriendRequest,
} from '@/player';

// Add-friend affordance per search result. Before this existed, a search result
// offered ONLY "View Profile", so the sole way to befriend someone you looked up
// was to open their profile and add them there — which is exactly what players
// reported as "the friend request on the friends page doesn't work" (David,
// 2026-09-17). The button was never broken; it was never built.
//
// Status comes from the shared friend-edge read port (getFriendEdges +
// deriveFriendStatus) rather than a hand-rolled row scan, so this surface agrees
// with OtherProfile about what 'pending'/'friends'/'incoming' mean.
/**
 * The cosmic-neon treatment for one control in a search-result row.
 *
 * David, 2026-09-17: "the colors and theme need to match the cosmic neon more."
 * The row shipped with flat Tailwind fills — an emerald-to-green gradient on the
 * search and Add buttons, solid amber on View Profile — which read as stock
 * Bootstrap beside the neon surfaces around them.
 *
 * This is the SAME idiom the podium ladder arrows use: tinted fill, accent
 * border, an outer glow and a soft inner one. Reused rather than reinvented so
 * the surfaces cannot drift apart, and expressed as one builder so the four
 * controls here cannot drift from each other either.
 *
 * Three tokens, because they are three different KINDS of control and a single
 * colour would flatten that: cyan runs the search, green is the positive action
 * on a player, violet merely navigates.
 *
 * @param {string} token a `var(--u37-…)` reference
 */
const neon = (token) => ({
  color: token,
  background: `color-mix(in srgb, ${token} 16%, transparent)`,
  border: `1px solid color-mix(in srgb, ${token} 60%, transparent)`,
  boxShadow: `0 0 16px -6px ${token}, inset 0 0 14px -10px ${token}`,
});


export default function UserSearch({ currentUserId }) {
  const [searchQuery, setSearchQuery] = useState('');
  const [searchResults, setSearchResults] = useState([]);
  const [searching, setSearching] = useState(false);
  const [hasSearched, setHasSearched] = useState(false);
  const debounceTimer = useRef(null);
  // My friend-edge list, loaded once per user — drives each result's button
  // state. Kept as edges (not a derived map) so deriveFriendStatus stays the one
  // place that knows the directional-edge rules.
  const [friendEdges, setFriendEdges] = useState([]);
  // Ids mutated locally since the edges were fetched, so the button flips
  // immediately without a refetch round-trip.
  const [justRequested, setJustRequested] = useState(new Set());
  const [justAccepted, setJustAccepted] = useState(new Set());
  const [busyId, setBusyId] = useState(null);
  const { addNotification } = useNotifications();

  /** The username for a result id, for the confirmation copy. */
  const nameFor = (id) => searchResults.find((u) => u.id === id)?.username || 'that player';

  /**
   * Acknowledge a sent request, in the same words OtherProfile uses.
   *
   * ⚠️ Deliberately NOT a toast. Toasts in this app are the solve-failure
   * channel (destructive red, one caller), and a successful friend request is
   * neither a failure nor solve-path. The notification inbox is where the other
   * half of this same feature already reports itself.
   */
  const notify = (targetId) => {
    addNotification({
      type: 'request',
      title: 'Friend Request Sent!',
      message: `Request sent to ${nameFor(targetId)}`,
    });
  };

  useEffect(() => {
    let cancelled = false;
    if (!currentUserId) {
      setFriendEdges([]);
      return undefined;
    }
    getFriendEdges(currentUserId)
      .then((edges) => { if (!cancelled) setFriendEdges(edges || []); })
      .catch((error) => { console.error('[SEARCH] friend edges failed:', error); });
    return () => { cancelled = true; };
  }, [currentUserId]);

  // 'none' | 'pending' | 'incoming' | 'friends', with the optimistic local
  // overlay applied on top of the fetched edges.
  const statusFor = (targetId) => {
    if (justAccepted.has(targetId)) return 'friends';
    if (justRequested.has(targetId)) return 'pending';
    return deriveFriendStatus(friendEdges, currentUserId, targetId);
  };

  const handleAdd = async (targetId) => {
    setBusyId(targetId);
    try {
      await sendFriendRequest(currentUserId, targetId);
      setJustRequested((prev) => new Set([...prev, targetId]));
      // David, 2026-09-17: "i think add friends works here, but no message
      // popped up like it usually does." It did work — the row flipped to
      // Pending — but OtherProfile raises a notification for the same action
      // and this surface did not, so the two disagreed about whether sending a
      // request is worth acknowledging. Same call, same shape, same words.
      notify(targetId);
    } catch (error) {
      console.error('[SEARCH] send friend request failed:', error);
      // 'already sent' is a no-op race (double tap, or an edge added since the
      // fetch) — reflect the truthful end state instead of alarming the player.
      if (error.message?.includes('already sent')) {
        setJustRequested((prev) => new Set([...prev, targetId]));
      } else {
        alert(error.message || 'Failed to send friend request');
      }
    } finally {
      setBusyId(null);
    }
  };

  const handleAccept = async (requesterId) => {
    setBusyId(requesterId);
    try {
      await acceptFriendRequest(requesterId);
      setJustAccepted((prev) => new Set([...prev, requesterId]));
      addNotification({
        type: 'request',
        title: 'Friend Added!',
        message: `You and ${nameFor(requesterId)} are now friends`,
      });
    } catch (error) {
      console.error('[SEARCH] accept friend request failed:', error);
      alert(error.message || 'Failed to accept friend request');
    } finally {
      setBusyId(null);
    }
  };

  const performSearch = async (query) => {
    // Skip the fetch entirely for an effectively-blank query (the normalize
    // guard catches whitespace- and zero-width-only queries too).
    if (!normalizeText(query)) {
      setSearchResults([]);
      setHasSearched(false);
      return;
    }

    setSearching(true);
    setHasSearched(true);

    try {
      const allUsers = await apiClient.entities.PublicProfile.list();
      setSearchResults(searchPlayers(allUsers, query, { excludeId: currentUserId }));
    } catch (error) {
      console.error('[SEARCH] Error:', error);
      setSearchResults([]);
    } finally {
      setSearching(false);
    }
  };

  const handleInputChange = (e) => {
    const value = e.target.value;
    setSearchQuery(value);

    if (debounceTimer.current) {
      clearTimeout(debounceTimer.current);
    }

    debounceTimer.current = setTimeout(() => {
      performSearch(value);
    }, 300);
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (debounceTimer.current) {
      clearTimeout(debounceTimer.current);
    }
    performSearch(searchQuery);
  };

  useEffect(() => {
    return () => {
      if (debounceTimer.current) {
        clearTimeout(debounceTimer.current);
      }
    };
  }, []);

  return (
    <div className="bg-slate-800/60 backdrop-blur rounded-2xl p-6 border border-slate-700/50">
      <h3 className="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <Search className="w-5 h-5 text-emerald-400" />
        Find Players
      </h3>

      <form onSubmit={handleSubmit} className="flex gap-2 mb-4">
        <Input
          type="search"
          inputMode="search"
          enterKeyHint="search"
          value={searchQuery}
          onChange={handleInputChange}
          placeholder="Search by username..."
          className="bg-slate-700/50 border-slate-600 text-white"
          autoComplete="off"
          autoCorrect="off"
          autoCapitalize="off"
          spellCheck="false"
        />
        <Button
          type="submit"
          disabled={searching}
          data-testid="search-submit"
          style={neon('var(--u37-cyan)')}
          className="bg-transparent hover:brightness-125 min-w-[56px] min-h-[56px] touch-manipulation"
        >
          <Search className="w-5 h-5" />
        </Button>
      </form>

      {searchResults.length > 0 && (
        <div className="space-y-2 max-h-96 overflow-y-auto">
          {searchResults.map(user => (
            <div
              key={user.id}
              className="flex items-center justify-between gap-3 p-3 bg-slate-700/50 rounded-lg"
            >
              <div className="flex items-center gap-3 flex-1 min-w-0">
                <div className="w-10 h-10 rounded-full bg-slate-700/50 flex items-center justify-center border border-slate-600 overflow-hidden flex-shrink-0">
                  {user.country ? (
                    <img
                      src={`https://flagcdn.com/w80/${user.country?.toLowerCase()}.png`}
                      alt="Country flag"
                      className="w-full h-full object-cover"
                    />
                  ) : (
                    <span className="text-xl">❓</span>
                  )}
                </div>
                <div className="min-w-0 flex-1">
                  <div className="flex items-center gap-2">
                    {user.country && (
                      <img
                        src={`https://flagcdn.com/w40/${user.country?.toLowerCase()}.png`}
                        alt="Flag"
                        className="w-6 h-4 object-cover rounded flex-shrink-0"
                      />
                    )}
                    <div className="text-white font-semibold truncate">{user.username}</div>
                  </div>
                  {/* It said the literal string "Country Selected" — a placeholder that
                      shipped. The flag beside it already tells you a country was
                      chosen, so the line carried no information at all.

                      Shared `countryName` — see countryName.js for why the case
                      matters and why the picker's wording beats Intl's. */}
                  {user.country && (
                    <div className="text-xs text-slate-300">{countryName(user.country)}</div>
                  )}
                </div>
              </div>
              <div className="flex items-center gap-2 flex-shrink-0">
                {/* Friend action — the whole point of this row. Labels collapse to
                    icon-only under `sm` so two buttons still fit a phone width. */}
                <FriendActionButton
                  status={statusFor(user.id)}
                  busy={busyId === user.id}
                  onAdd={() => handleAdd(user.id)}
                  onAccept={() => handleAccept(user.id)}
                  testId={`friend-action-${user.id}`}
                />
                <Link to={`${createPageUrl('OtherProfile')}?id=${user.id}`}>
                  <Button
                    data-testid={`view-profile-${user.id}`}
                    style={neon('var(--u37-violet)')}
                    className="bg-transparent hover:brightness-125 text-sm py-2 px-3 min-h-[44px] min-w-[44px] touch-manipulation whitespace-nowrap"
                  >
                    <User className="w-4 h-4 sm:mr-1" />
                    <span className="hidden sm:inline">View Profile</span>
                  </Button>
                </Link>
              </div>
            </div>
          ))}
        </div>
      )}

      {searching && (
        <div className="text-center text-slate-400 py-4">Searching...</div>
      )}

      {!searching && searchResults.length === 0 && hasSearched && (
        <div className="text-center text-slate-400 py-4">
          <p className="mb-2">No players found</p>
          <p className="text-xs text-slate-500">Try searching for an exact username or part of it</p>
        </div>
      )}
    </div>
  );
}

/**
 * The per-result friend button. Presentational: it maps a friend-edge status to
 * a label/icon/handler and nothing else, so the four states are trivially
 * testable without a search round-trip.
 *
 * @param {{status: 'none'|'pending'|'incoming'|'friends', busy: boolean,
 *          onAdd: () => void, onAccept: () => void, testId: string}} props
 */
function FriendActionButton({ status, busy, onAdd, onAccept, testId }) {
  if (status === 'friends') {
    return (
      <Button
        disabled
        data-testid={testId}
        aria-label="Already friends"
        className="bg-slate-700 text-emerald-300 text-sm py-2 px-3 min-h-[44px] min-w-[44px] touch-manipulation whitespace-nowrap opacity-80 cursor-not-allowed"
      >
        <Check className="w-4 h-4 sm:mr-1" />
        <span className="hidden sm:inline">Friends</span>
      </Button>
    );
  }

  if (status === 'pending') {
    return (
      <Button
        disabled
        data-testid={testId}
        aria-label="Friend request pending"
        // Deliberately NOT neon: this one is disabled, and giving it the glow of
        // the live actions would advertise a button that does nothing.
        className="bg-white/5 border border-white/10 text-slate-300 text-sm py-2 px-3 min-h-[44px] min-w-[44px] touch-manipulation whitespace-nowrap opacity-80 cursor-not-allowed"
      >
        <Clock className="w-4 h-4 sm:mr-1" />
        <span className="hidden sm:inline">Pending</span>
      </Button>
    );
  }

  if (status === 'incoming') {
    // They already asked us. Offering "Add" here would throw the "this user has
    // already sent you a friend request" error, so offer the accept instead.
    return (
      <Button
        onClick={onAccept}
        disabled={busy}
        data-testid={testId}
        aria-label="Accept friend request"
        style={neon('var(--u37-green)')}
        className="bg-transparent hover:brightness-125 text-sm py-2 px-3 min-h-[44px] min-w-[44px] touch-manipulation whitespace-nowrap"
      >
        <Check className="w-4 h-4 sm:mr-1" />
        <span className="hidden sm:inline">Accept</span>
      </Button>
    );
  }

  return (
    <Button
      onClick={onAdd}
      disabled={busy}
      data-testid={testId}
      aria-label="Add friend"
      style={neon('var(--u37-green)')}
      className="bg-transparent hover:brightness-125 text-sm py-2 px-3 min-h-[44px] min-w-[44px] touch-manipulation whitespace-nowrap"
    >
      <UserPlus className="w-4 h-4 sm:mr-1" />
      <span className="hidden sm:inline">Add</span>
    </Button>
  );
}
