// Shared visual tokens — the SINGLE source of truth for the look that must match
// across the How-To-Play page and the live gameplay screen. Both surfaces import
// from here so they can't drift apart again (the exact problem this module fixes).
//
// Tailwind keeps these class strings only because they're written out in full
// (no runtime string-building of color names) — keep them literal.

// Power-die faces are DARK (so the gold "used-correctly" ring reads against them);
// colored dice therefore use LIGHT pips. White dice stay bone-white with dark pips.
export const POWER_DIE_FACE = Object.freeze({
  white: { bg: 'from-slate-50 to-slate-300', pip: 'fill-slate-800', ring: '' },
  blue: { bg: 'from-sky-600 to-blue-800', pip: 'fill-sky-50', ring: 'ring-1 ring-sky-400/40' },
  red: { bg: 'from-rose-600 to-red-800', pip: 'fill-rose-50', ring: 'ring-1 ring-rose-400/40' },
  green: { bg: 'from-emerald-600 to-green-800', pip: 'fill-emerald-50', ring: 'ring-1 ring-emerald-400/40' },
});

// Equation-readout NUMBER colors (numerals, not dice faces). Lighter than the
// faces so they read on the dark builder background.
export const NUM_COLOR = Object.freeze({
  white: 'text-slate-100',
  blue: 'text-sky-300',
  red: 'text-rose-300',
  green: 'text-emerald-300',
});

// Operator-button palette — the gameplay OperatorPad spectrum is the canonical
// source (per the unified-look decision). The How-To-Play operator pad adopts it.
export const OPERATOR_COLORS = Object.freeze({
  '+': 'from-blue-600 to-blue-700',
  '-': 'from-indigo-600 to-indigo-700',
  '*': 'from-violet-600 to-violet-700',
  '/': 'from-purple-600 to-purple-700',
  '^': 'from-fuchsia-600 to-fuchsia-700',
  '(': 'from-pink-600 to-pink-700',
  ')': 'from-pink-600 to-pink-700',
});

// Operator display glyphs (internal symbol → what the player sees).
export const GLYPH = Object.freeze({
  '+': '+', '-': '−', '*': '×', '/': '÷', '^': '^', '(': '(', ')': ')',
});

// Exponent digits render small + raised. Used identically on both screens so a
// power (e.g. 6²) looks the same in the How-To-Play demo and the live builder.
export const EXPONENT_CLASS = 'text-[0.62em] align-super';
