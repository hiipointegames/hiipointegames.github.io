// Every player-facing word of the giveaway email check, in one place.
//
// Source: .workshop/copy-tips-referrals-2026-10.md section 1 (David's draft,
// 2026-10-20). Edit the wording HERE, nowhere else. The server's error copy
// lives beside the calls that produce it (EMAIL_CODE_ERRORS in emailCode.js).

export const EMAIL_CODE_COPY = Object.freeze({
  // The heads-up on the giveaway sheet. It shows before 25 Oct AND during each
  // player's 7-day grace after it, so it carries no date (approved 2026-10-22).
  noticeBody: 'Verify your email to keep earning giveaway entries. It takes 30 seconds.',
  noticeCta: 'Verify now',

  // From 25 Oct: the gap in the "quick fixes" list.
  gapReason: "Email not verified: we couldn't be sure a win reaches you.",
  gapCta: 'Verify email',

  // From 25 Oct: the home chip's second line.
  chipLine: 'Verify your email to enter',

  // The guided signup's Done screen, for a new email the server says is not
  // verified yet: the gold giveaway box becomes a button (approved 2026-10-22).
  signupVerifyTitle: 'One more step: verify your email so your giveaway entries keep counting.',

  // The sheet.
  title: 'Verify your email',
  sendLead: "We'll email a 6-digit code to",
  sendButton: 'Send code',
  sending: 'Sending…',
  changeEmail: 'Wrong email? Change it',
  codeLead: 'Type the code we sent to',
  codeLabel: '6-digit code',
  verifyButton: 'Verify',
  verifying: 'Checking…',
  resend: 'Send a new code',
  resendIn: (seconds) => `Send a new code in ${seconds}s`,
  success: '✓ Verified. Your Dailies earn giveaway entries again.',
  done: 'Done',

  // No real email on the account: there is nothing to send a code to.
  noEmail: 'Add a real email to your account first.',
  addEmail: 'Add your email',
});

/** Supabase refuses a second code inside this window. */
export const EMAIL_CODE_COOLDOWN_SECONDS = 60;
