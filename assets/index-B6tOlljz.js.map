import React from 'react';
import { createPortal } from 'react-dom';
import { useNavigate } from 'react-router-dom';

// "← Back to Sector 73" (world lane 2026-10-22, D1-A). The five places on the map that open a 37 page
// (Observatory → Leaderboards, Flight Log → Stats, Trophy Nebula → Badges, Colosseum / Proving
// Grounds → Blitz) used to drop the pilot onto the normal page with the 37 bottom nav and only the
// system Back to return. When Sector 73 opens one, it passes `from73: true` in the route state, and
// Layout mounts this bar: one big way back, and the 37 nav hidden while it shows.
//
// It is ONLY mounted for that state, so the normal 37 pages (opened from the app, or with the Sector
// 73 switch OFF, when /Sector73 itself is a 404) are untouched: Layout.from73.test.jsx pins that.
// Back = history Back: the page was pushed by the cockpit, so Back lands in the cockpit, which
// resumes docked where the ship was (Sector73Page's resume point).

/** Is this a page Sector 73 opened? */
export const openedFromSector73 = (state) => Boolean(state && typeof state === 'object' && state.from73 === true);

export default function Sector73ReturnBar() {
  const navigate = useNavigate();
  // The 37 nav is hidden by Layout itself for the same state (not by an event from here: this child's
  // effect would run before Layout subscribes, and the event would be lost).
  return createPortal(
    <div className="pointer-events-none fixed inset-x-0 z-[150] flex justify-center px-3"
      style={{ bottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 12px)' }}>
      <button type="button" data-testid="back-to-sector73" onClick={() => navigate(-1)}
        className="pointer-events-auto w-full max-w-md rounded-2xl py-3.5 text-base font-black tracking-wide text-white active:scale-95"
        style={{ background: 'linear-gradient(180deg, #7c3aed, #5b21b6)', boxShadow: '0 0 24px -6px #a855f7' }}>
        ← Back to Sector 73
      </button>
    </div>,
    document.body,
  );
}
