import moment from 'moment';
import 'moment-timezone';

import { DAILY_MODE_KEYS } from '@/game-modes';
import { hasConfirmedContestEligibility,
  hasDeclinedContestEligibility, meetsContestAccountRequirement } from './contest';
import { emailVerificationRequired } from './emailVerifiedFrom';
import { EMAIL_CODE_COPY } from './emailCodeCopy';

// How many entries this player has actually earned, and what to say about it.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS EXISTS
// ─────────────────────────────────────────────────────────────────────────────
// Since the 2026-09-17 rule change, FINISHING a Daily earns an entry — speed no
// longer decides. That makes the ceiling reachable by anyone who shows up, which
// is only motivating if the player can SEE their count. Nothing in the app
// computed it before this module.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE RULES, AS THE OFFICIAL RULES STATE THEM
// ─────────────────────────────────────────────────────────────────────────────
//   * one entry per Daily FINISHED — a forfeit earns nothing
//   * at most 3 a day, one each for Easy, Challenge and Expert
//   * at most 21 in a week, which is the same 3 x 7 ceiling, PER PLAYER
//   * the week runs Sunday → Saturday in ET, and does not carry over
//   * it is NOT retroactive: only Dailies finished on or after the day the
//     player ticked the eligibility box count
//
// ⚠️ EVERY NUMBER HERE IS A CLAIM MADE TO A PLAYER ABOUT A PRIZE. That is why
// this is a pure module with its own tests rather than a few lines inlined in a
// component: it must be checkable against the rules text without rendering
// anything, and it must be wrong in the safe direction. Where an input is
// missing or partial the answer is `null` — "we do not know" — and the caller
// shows no number at all. Showing a confidently wrong entry count is worse than
// showing none, because a player will compare it against the published rules.

/** The most entries one player can earn in a day — one per Daily. */
export const MAX_ENTRIES_PER_DAY = DAILY_MODE_KEYS.length;

/** The most one player can hold in a Sunday–Saturday week. */
export const MAX_ENTRIES_PER_WEEK = MAX_ENTRIES_PER_DAY * 7;

const ET = 'America/New_York';

/**
 * The Sunday that opens the entry week containing `date`.
 *
 * moment's `day()` is already Sunday-indexed (0 = Sunday), which happens to be
 * exactly the boundary the official rules use, so no offset arithmetic is
 * needed — and none should be added, because an off-by-one here silently moves
 * a player's entries into the wrong drawing.
 *
 * @param {string|Date} [date] a 'YYYY-MM-DD' or Date; defaults to now in ET
 * @returns {string} 'YYYY-MM-DD' of that week's Sunday, in ET
 */
export function contestWeekStart(date) {
  const m = date ? moment.tz(date, ET) : moment.tz(ET);
  return m.startOf('day').subtract(m.day(), 'days').format('YYYY-MM-DD');
}

/** Today in ET, as the rules reckon a day. */
export function contestToday() {
  return moment.tz(ET).format('YYYY-MM-DD');
}

/**
 * Count the entries a set of finished Dailies is worth.
 *
 * @param {{
 *   rows?: Array<{date?: string, mode?: string, created_at?: string | null}> | null,
 *   confirmedAt?: string | null,
 *   today?: string,
 * }} args
 *   rows        — FINISHED Daily rows (daily_challenge_times). A forfeit must
 *                 never appear here; this module cannot tell one from the other,
 *                 so filtering is the caller's job and is documented at the call
 *                 site.
 *   confirmedAt — ISO timestamp the player ticked the eligibility box. Entries
 *                 are not retroactive. A row that carries `created_at` counts
 *                 only if it was saved at or after that INSTANT — the same test
 *                 the nightly save applies (contest_entries_for_day). A row
 *                 without it (the solve that just happened, added by the caller)
 *                 falls back to the day. Absent confirmedAt → zero.
 * @returns {{week: number, today: number}}
 */
export function countContestEntries({ rows, confirmedAt, today = contestToday() }) {
  if (!Array.isArray(rows) || !confirmedAt) return { week: 0, today: 0 };

  const weekStart = contestWeekStart(today);
  // ⚠️ INSTANTS, NOT DAYS, since 2026-10-20 (bug log). This used to compare
  // days, on the reasoning that a 9pm tick and a 9:05pm Daily plainly earn an
  // entry — which instants agree with. What days got WRONG was the other order:
  // a Daily finished at 3pm and a tick at 4pm the same day showed "+1 entry"
  // here while the nightly save, which compares instants, rejected it. The chip
  // promised an entry the drawing never held. The server is the one that
  // counts, so this mirrors it. Both times are server-stamped (row created_at
  // by the database; confirmed_at by the server from slice 2 of the referrals
  // work), so the device clock does not enter into it.
  const confirmedMs = Date.parse(confirmedAt);
  if (Number.isNaN(confirmedMs)) return { week: 0, today: 0 };
  const confirmedDay = moment.tz(confirmedAt, ET).format('YYYY-MM-DD');
  const from = confirmedDay > weekStart ? confirmedDay : weekStart;

  // Deduped by (date, mode): one Daily per mode per day is one entry, however
  // many rows the log happens to carry for it.
  const seen = new Set();
  for (const row of rows) {
    const date = row?.date;
    if (typeof date !== 'string') continue;
    if (date < from || date > today) continue;
    if (row?.created_at) {
      const savedMs = Date.parse(row.created_at);
      if (Number.isNaN(savedMs) || savedMs < confirmedMs) continue;
    }
    const mode = DAILY_MODE_KEYS.includes(row?.mode) ? row.mode : 'daily';
    seen.add(`${date}:${mode}`);
  }

  // Per-day cap applied before the weekly one, so a malformed log carrying four
  // modes for one date cannot inflate the week.
  const perDay = new Map();
  for (const key of seen) {
    const [date] = key.split(':');
    perDay.set(date, Math.min((perDay.get(date) || 0) + 1, MAX_ENTRIES_PER_DAY));
  }

  let week = 0;
  for (const count of perDay.values()) week += count;

  return {
    week: Math.min(week, MAX_ENTRIES_PER_WEEK),
    today: Math.min(perDay.get(today) || 0, MAX_ENTRIES_PER_DAY),
  };
}

/**
 * How many of today's three Dailies this player has FINISHED, read from the live
 * per-mode status the launcher already holds.
 *
 * This is deliberately a separate input from `rows`. Today's status is known
 * exactly and for all three modes; the week's history is not always available on
 * the home screen (see contestEntryState). A forfeit is explicitly not a finish.
 *
 * @param {Record<string, string>|null|undefined} statusByMode
 * @returns {number|null} null when nothing is known yet
 */
export function finishedTodayCount(statusByMode) {
  if (!statusByMode) return null;
  let known = 0;
  let done = 0;
  for (const key of DAILY_MODE_KEYS) {
    const status = statusByMode[key];
    if (!status || status === 'loading') continue;
    known += 1;
    if (status === 'completed') done += 1;
  }
  return known === 0 ? null : done;
}

/**
 * What the promo chip should say about this player's entries.
 *
 * A discriminated state rather than a formatted string, so the copy lives with
 * the component and the DECISION is testable on its own.
 *
 *   'account'  — no saved account or no email: nothing to enter with
 *   'confirm'  — has the account, has not ticked the eligibility box
 *   'verify'   — from 25 Oct 2026: everything else is in place, but the server
 *                says the email is NOT verified, so Dailies earn nothing yet.
 *                Only on an explicit `emailVerified: false`; unknown never.
 *   'entries'  — eligible; `week` may be null when the week's history is not
 *                available to us, in which case only `today` is trustworthy
 *
 * 'declined' is a real, recorded state since 2026-09-17: the form saves an
 * explicit No as `confirmed_18_us: false`. Since 2026-10-05 a SKIPPED question
 * saves nothing (see attestationPatch.js), so "never answered" stays distinct
 * from "said no" and keeps getting the neutral 'confirm' invitation.
 *
 * @param {{
 *   user?: Record<string, any> | null,
 *   rows?: Array<{date?: string, mode?: string}> | null,
 *   statusByMode?: Record<string, string> | null,
 *   today?: string,
 *   emailVerified?: boolean|'grace'|null,
 * }} args
 * @returns {{kind: 'account'|'confirm'|'declined'|'verify'|'entries', week: number|null, today: number|null}}
 */
export function contestEntryState({ user, rows, statusByMode, today = contestToday(), emailVerified = null }) {
  if (!meetsContestAccountRequirement(user)) {
    return { kind: 'account', week: null, today: null };
  }
  // A player who answered NO is not shown an entry line at all. They made a
  // decision; repeating "tap to turn on your entries" on every home screen
  // visit is the nagging the three states exist to end. contestChipLine returns
  // null for this kind, which leaves the ordinary schedule line in place.
  if (hasDeclinedContestEligibility(user)) {
    return { kind: 'declined', week: null, today: null };
  }
  if (!hasConfirmedContestEligibility(user)) {
    return { kind: 'confirm', week: null, today: null };
  }
  if (emailVerified === false && emailVerificationRequired(today)) {
    return { kind: 'verify', week: null, today: null };
  }

  const confirmedAt = (user?.contest_eligibility ?? user?.user_metadata?.contest_eligibility)?.confirmed_at
    ?? null;

  // `rows` is the week's FINISHED Dailies across all three modes. When the
  // caller cannot supply that — the home launcher's game_stats blob covers
  // Challenge's Daily ONLY, so counting from it would quietly understate a
  // player who also finished Easy and Expert — week stays null and the chip
  // shows today's progress instead of a number it cannot stand behind.
  const counted = rows ? countContestEntries({ rows, confirmedAt, today }) : null;
  const todayFromStatus = finishedTodayCount(statusByMode);

  return {
    kind: 'entries',
    week: counted ? counted.week : null,
    today: counted ? counted.today : todayFromStatus,
  };
}

/**
 * The one line the home chip shows under the headline.
 *
 * Returns `null` when we have nothing trustworthy to say, and the chip keeps its
 * existing "entries reset weekly / winner drawn Sunday" line. That fallback is
 * the reason this can be aggressive about refusing to guess.
 *
 * The line does double duty on purpose. David's ask was both "make players aware
 * there are three Dailies" and "show x of 21 entries this week", and the home
 * launcher has no spare vertical space for two rows — it is a zero-scroll
 * screen. Folding both into the chip's EXISTING second line costs no height at
 * all, and the two facts reinforce each other: the reason to play all three is
 * that each one is an entry.
 *
 * @param {{kind: 'account'|'confirm'|'declined'|'verify'|'entries', week: number|null, today: number|null}} state
 * @returns {string|null}
 */
export function contestChipLine(state) {
  if (!state) return null;
  if (state.kind === 'verify') return EMAIL_CODE_COPY.chipLine;
  if (state.kind === 'account') return 'Save your account to enter';
  if (state.kind === 'confirm') return 'Tap to turn on your entries';
  if (state.kind === 'declined') return null;

  const { week, today } = state;
  if (week != null && today != null) {
    return `${week} of ${MAX_ENTRIES_PER_WEEK} entries · ${today}/${MAX_ENTRIES_PER_DAY} today`;
  }
  if (week != null) return `${week} of ${MAX_ENTRIES_PER_WEEK} entries this week`;
  // The week is unknown — say only what is certain, and still carry the "there
  // are three of them" fact, which is the half that changes what a player does
  // in the next minute.
  if (today != null) return `${today} of ${MAX_ENTRIES_PER_DAY} Dailies done today`;
  return null;
}
