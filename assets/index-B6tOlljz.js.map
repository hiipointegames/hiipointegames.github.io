// blitzMode — the ONE place the Blitz Colosseum answers "which mode is this?".
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS EXISTS
// ─────────────────────────────────────────────────────────────────────────────
// `HeadToHeadGame.jsx` decided mode with SIX independent copies of the same
// ternary — `mode === 'challenge' ? POWER_DICE_COLORS : EASY_DICE_COLORS` — plus
// a seventh chain for whether the power-dice rule applies. Six copies of one
// boolean is six places for a third value to be forgotten, and `'expert'` is a
// third value: every one of those ternaries would have handed Expert WHITE dice
// and skipped the power-dice rule entirely.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE TRAP THIS MODULE EXISTS TO CONTAIN: blitz_mode is a TIER, not a mode key.
// ─────────────────────────────────────────────────────────────────────────────
// `head_to_head_challenges.blitz_mode` holds 'easy' | 'challenge' | 'expert'.
// Those strings collide with three of `@/game-modes`' PRACTICE keys by
// coincidence — the wire vocabulary was frozen for the Dailies, and battles were
// never part of it. The collision means the TIER predicates answer correctly:
//
//     hasPowerDice('expert')        -> true     (coloured dice)
//     hasPerfectConcept('expert')   -> true     (a perfect solve is meaningful)
//     requiresPerfectSolve('expert')-> true     (and it is REQUIRED)
//
// ...but the ROUND predicates are WRONG here, and wrong in the most inviting
// direction:
//
//     isTimed('challenge')     -> FALSE   ...yet a battle is the most timed
//                                            thing in the app.
//     isPractice('challenge')  -> TRUE    ...yet a battle is competitive.
//
// A reader who reaches for `isTimed` because "a battle obviously has a clock"
// ships a silent inversion. So this module exports the tier questions the Blitz
// surface is allowed to ask, and deliberately does NOT re-export the round ones.
// If you need to know whether a clock is running, ask the clock.
import { getDiceColors } from '@/dice';
import { hasPowerDice, hasPerfectConcept, requiresPerfectSolve, isKnownModeKey } from '@/game-modes';

/**
 * The battle/solo difficulty tiers, in play order.
 *
 * The Blitz mirror of DAILY_MODE_KEYS. Kept here rather than in `@/game-modes`
 * because these are TIER strings for one surface, not additions to the frozen
 * wire vocabulary — see the header.
 * @type {readonly string[]}
 */
export const BLITZ_MODES = Object.freeze(['easy', 'challenge', 'expert']);

// The tier a battle or solo run falls back to when `blitz_mode` is absent,
// unrecognised, or null.
//
// 'easy' is the SAFE failure and the one production already uses: it deals no
// power dice, so it cannot demand a rule the player was never shown. Coercing an
// unknown value to 'challenge' (which several call sites used to do) would hand a
// player a power-dice requirement on an all-white board.
//
// ⚠️ This is a DELIBERATE unification. Before this module the surface disagreed
// with itself: HeadToHeadGame/ChallengeList/ChallengeFriend and the SERVER all
// defaulted unknown -> Easy, while blitzBattleBadges/playerBattles/soloBlitzStats/
// challengeView/BattleDurationPicker defaulted unknown -> Challenge. Nothing broke
// only because nothing was ever unknown. Adding a third value is exactly the event
// that would have made the disagreement visible, in badges and stats first.
export const DEFAULT_BLITZ_MODE = 'easy';

/**
 * Coerce anything into a known Blitz tier.
 *
 * Use this for RENDERING, where a sane fallback beats a crash. For a WRITE gate
 * use `isKnownBlitzMode` instead — this function cannot tell you that its input
 * was garbage, because answering safely is its whole job.
 *
 * @param {unknown} mode
 * @returns {string} a member of BLITZ_MODES
 */
export const normalizeBlitzMode = (mode) =>
  (typeof mode === 'string' && BLITZ_MODES.includes(mode)) ? mode : DEFAULT_BLITZ_MODE;

/**
 * STRICT membership — is this exactly a Blitz tier, with no coercion?
 *
 * Use on every write gate and on anything arriving from the database or a client
 * payload. `blitz_mode` is an unconstrained `text` column with no CHECK
 * constraint, so the database will store literally any string; it is untrusted
 * input even though we are the only writer.
 *
 * @param {unknown} mode
 * @returns {boolean}
 */
export const isKnownBlitzMode = (mode) =>
  typeof mode === 'string' && BLITZ_MODES.includes(mode) && isKnownModeKey(mode);

/**
 * The tier for the round currently being played, battle or solo.
 *
 * One resolver for both, because every call site previously re-derived it with
 * its own inline `isSoloMode ? soloMode : (challenge?.blitz_mode || 'easy')`.
 *
 * @param {{ soloMode?: string|null, challenge?: {blitz_mode?: string}|null }} args
 * @returns {string} a member of BLITZ_MODES
 */
export const resolveBlitzMode = ({ soloMode = null, challenge = null } = {}) =>
  normalizeBlitzMode(soloMode ?? challenge?.blitz_mode);

/**
 * The dice colour array for a Blitz tier.
 *
 * Delegates to `getDiceColors`, the same resolver the Daily uses, whose
 * POWER_DICE_MODES set already contains 'expert'. The Blitz surface had never
 * called it — it hand-rolled the same ternary six times instead.
 *
 * @param {string} mode
 * @returns {readonly string[]}
 */
export const blitzDiceColors = (mode) => getDiceColors(normalizeBlitzMode(mode));

/**
 * Does a solve in this tier have to satisfy the power-dice rule at all?
 *
 * Easy deals seven white dice, so there is nothing to get right and the rule is
 * skipped. Challenge and Expert both colour their dice, so it applies — at
 * DIFFERENT thresholds, which is `requiredPowerDiceCount`'s job, not this one's.
 *
 * @param {string} mode
 * @returns {boolean}
 */
export const blitzEnforcesPowerDice = (mode) => hasPowerDice(normalizeBlitzMode(mode));

/**
 * Must a solve in this tier be PERFECT — all three power dice used correctly?
 *
 * Expert only. Challenge accepts a two-of-three solve and merely decorates a
 * perfect one; Easy has no perfect concept at all.
 *
 * @param {string} mode
 * @returns {boolean}
 */
export const blitzRequiresPerfectSolve = (mode) => requiresPerfectSolve(normalizeBlitzMode(mode));

// Display name for a tier. Kept beside the predicates so a surface renders a
// third tier by asking, rather than by extending a two-branch ternary — which is
// exactly how "Expert Battle" would otherwise have rendered as "Challenge
// Battle" on the results screen.
const TIER_LABEL = Object.freeze({ easy: 'Easy', challenge: 'Challenge', expert: 'Expert' });

// The tier accent, as a CSS custom property reference.
//
// ⚠️ These are TIER colours (David, 2026-08-27 / 08-31: colour follows the tier
// and applies to "stats, boards, badges AND battles"). They are NOT the ARENA
// themes — `[data-mode="solo-blitz"]` is blue and `[data-mode="blitz-battle"]` is
// magenta, and those identify the Colosseum as a place. Magenta was explicitly
// withdrawn as Expert's colour because an Expert board wearing it would be
// visually identical to the Colosseum chrome around it
// (src/components/stats/dailyModeStats.js).
const TIER_ACCENT = Object.freeze({
  easy: 'var(--u37-green)',
  challenge: 'var(--u37-cyan)',
  expert: 'var(--u37-gold)',
});

/**
 * Human-readable name for a Blitz tier.
 * @param {string} mode
 * @returns {string}
 */
export const BLITZ_TIER_LABEL = (mode) => TIER_LABEL[normalizeBlitzMode(mode)];

/**
 * The `var(--u37-*)` accent for a Blitz tier.
 * @param {string} mode
 * @returns {string}
 */
export const BLITZ_TIER_ACCENT = (mode) => TIER_ACCENT[normalizeBlitzMode(mode)];

/**
 * Is a perfect solve even a meaningful idea in this tier?
 *
 * False for Easy, where `correctCount` can never leave zero, so a perfect-solve
 * counter on an Easy board can only ever read 0. Stats surfaces use this to
 * decide whether to render the tile at all.
 *
 * @param {string} mode
 * @returns {boolean}
 */
export const blitzHasPerfectConcept = (mode) => hasPerfectConcept(normalizeBlitzMode(mode));

/**
 * Is a round in this tier TIMED?
 *
 * Easy battles are untimed rounds; Challenge and Expert are timed races, which
 * is why only those two label their average "per round". That distinction is
 * REAL and correct for three tiers — unlike the two-branch tier ternaries this
 * module exists to replace.
 *
 * It is a named predicate rather than an inline `tier === 'easy' ? … : …`
 * purely so the difference is legible: a reader (and the battle-surface sweep
 * in `battleModeIdentity.test.js`) can tell "Easy is genuinely different here"
 * apart from "somebody forgot Expert exists". Those two look identical in a
 * ternary and are opposite in meaning.
 *
 * @param {string} mode
 * @returns {boolean}
 */
export const blitzIsTimedRound = (mode) => normalizeBlitzMode(mode) !== 'easy';
