import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { ShieldCheck, AlertTriangle } from 'lucide-react';

// Proactive "secure your account" prompt shown on entry to a NAMED but still
// unsecured account (a legacy username-only player: isGuest && isNamedAccount).
// Plain, positive framing — NOT a "your password was breached" scare (the app
// has never been breached). Copy-condense 2026-10-18 (David, open question 4):
// the "we're strengthening account security" opener was dropped — it explained
// our motive rather than the player's benefit, and the title + one line say it. Primary action opens the Save-Stats flow;
// "Maybe later" first reveals the honest risk (their stats live only on this
// device) before it can be dismissed.
//
// Presentational: isOpen + onSecure + onSkip. Two-step skip lives in local state.
export default function SecureAccountPrompt({ isOpen, onSecure, onSkip }) {
  const [showWarning, setShowWarning] = useState(false);
  if (!isOpen) return null;

  const handleMaybeLater = () => {
    if (!showWarning) { setShowWarning(true); return; } // first tap reveals the risk
    onSkip?.();                                          // second tap dismisses
  };

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 u37-ad-safe-pb"
      >
        <motion.div
          initial={{ scale: 0.9, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          exit={{ scale: 0.9, opacity: 0 }}
          className="w-full max-w-md rounded-3xl p-6 border-2 shadow-2xl relative overflow-y-auto"
          style={{
            // Cosmic-neon panel (2026-09-17). Keeps its CYAN accent — this one
            // is the security prompt and reads differently from its siblings on
            // purpose.
            background: 'var(--u37-panel-bg-cosmic)',
            borderColor: 'color-mix(in srgb, var(--u37-cyan) 55%, transparent)',
            boxShadow: '0 0 44px -14px var(--u37-cyan), 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)',
            maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
          }}
        >
          <div className="text-center mb-5">
            <div className="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-2xl mb-3 shadow-lg">
              <ShieldCheck className="w-8 h-8 text-white" />
            </div>
            <h2 className="text-2xl font-black bg-gradient-to-r from-cyan-300 via-cyan-400 to-blue-400 bg-clip-text text-transparent mb-2">
              Secure your account
            </h2>
            <p className="text-purple-100 text-sm">
              Set a password so your stats are safe and you can sign in anywhere.
            </p>
          </div>

          {showWarning && (
            <motion.div
              initial={{ opacity: 0, y: 6 }}
              animate={{ opacity: 1, y: 0 }}
              className="bg-amber-500/10 border border-amber-400/40 rounded-xl p-3 mb-4 flex items-start gap-2"
              role="alert"
            >
              <AlertTriangle className="w-5 h-5 text-amber-300 shrink-0 mt-0.5" />
              <p className="text-amber-100 text-xs">
                Your stats live only on <span className="font-bold">this device</span>. Change
                phones, reinstall or clear the app and they&apos;re gone.
              </p>
            </motion.div>
          )}

          <Button
            onClick={onSecure}
            className="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500
              text-white font-bold py-6 text-base shadow-xl min-h-[52px] touch-manipulation rounded-xl"
          >
            Secure my account
          </Button>

          <Button
            type="button"
            onClick={handleMaybeLater}
            variant="ghost"
            className="w-full text-slate-300 hover:text-white hover:bg-slate-700/50 py-3 rounded-xl font-semibold mt-2"
          >
            {showWarning ? 'Play without securing' : 'Maybe later'}
          </Button>
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}
