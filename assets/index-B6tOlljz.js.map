// badgeAnnouncements — the LAUNCH-vs-POST-LAUNCH split for badge celebrations
// (Badge System Redesign, Lane G, §9.4 "celebrations").
//
// The problem this exists to solve: badges are DERIVED from a player's whole
// history, so the moment the feature ships, a long-time player instantly
// qualifies for dozens of them. Running those through the normal per-earn
// celebration would open the app into a wall of sequential pop-ups. So:
//
//   - RETROACTIVE (history-qualified) badges are announced ONCE, as a single
//     summary moment — "You've unlocked 23 badges!" — and the cards themselves
//     carry Lane E's "Earned Retroactively" ribbon.
//   - Only badges earned AFTER launch get the per-earn AwardCelebrationSequence
//     pop, with hidden badges revealed by their pop and ladder crossings firing
//     on the crossing only.
//
// WHAT COUNTS AS SEEN. We persist a snapshot of the highest tier ANNOUNCED per
// badge id. Diffing live state against that snapshot (rather than against a
// pre-solve state) means the announcement is idempotent across reloads: nothing
// pops twice, and a badge earned while the app was closed still gets its moment
// the next time the player opens their stats.
//
// The launch date is NOT redefined here. It is the ONE shared marker the L2
// showcase already stamps its retroactive ribbon with — the two must agree or a
// badge could be ribboned "retroactive" while popping as a fresh earn.

import { BADGE_SYSTEM_LAUNCH_DATE } from '@/components/stats/badgeShowcaseModel';
import { getBadge } from '@/game-mechanics';
import { detectNewBadgeAwards } from './awards';

export { BADGE_SYSTEM_LAUNCH_DATE };

/** localStorage key holding the announced-tier snapshot. */
export const ANNOUNCED_BADGES_KEY = 'announcedBadges';

/**
 * The persisted snapshot, or `null` when there has never been one. `null` and
 * `{}` mean different things: `null` is FIRST RUN (announce retroactively),
 * `{}` is "we ran before and the player had nothing".
 * @returns {Record<string, number> | null}
 */
export function readAnnouncedBadges() {
  try {
    const raw = localStorage.getItem(ANNOUNCED_BADGES_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    return parsed && typeof parsed === 'object' ? parsed : null;
  } catch (error) {
    // A private-mode / quota failure must never block the page: treat it as
    // "already announced" (the safe direction — a missed moment beats a storm).
    console.warn('Badge announcements: could not read the announced snapshot:', error);
    return null;
  }
}

/**
 * Persist the snapshot.
 *
 * ⚠️ NO PRODUCTION CALLER SINCE THE UNIFICATION (slice 6). Every surface now
 * writes the one `announcedAwards.v1` record instead, and the legacy key is
 * READ-ONLY: it is absorbed on first read and then left exactly as it is, so
 * that a CapGo rollback finds a stale-but-valid record rather than nothing at
 * all — which would be a first-run badge storm. Do not reintroduce a writer.
 * Kept as the legacy store's other half, and as a fixture setter for the tests
 * that pin the migration.
 *
 * Best-effort: a write failure only means a moment may replay next session,
 * which is far better than throwing on a stats page.
 * @param {Record<string, number>} snapshot
 */
export function writeAnnouncedBadges(snapshot) {
  try {
    localStorage.setItem(ANNOUNCED_BADGES_KEY, JSON.stringify(snapshot || {}));
  } catch (error) {
    console.warn('Badge announcements: could not save the announced snapshot:', error);
  }
}

/**
 * Collapse a live state map down to the `{ badgeId: tier }` snapshot we persist.
 * Only EARNED badges are recorded — an unearned badge has nothing to announce.
 * @param {Record<string, any>} [stateById]
 * @returns {Record<string, number>}
 */
export function snapshotFromState(stateById = {}) {
  /** @type {Record<string, number>} */
  const snapshot = {};
  for (const [badgeId, state] of Object.entries(stateById || {})) {
    if (!state || typeof state !== 'object') continue;
    const earned = typeof state.earned === 'boolean'
      ? state.earned
      : Number.isFinite(state.tier) && state.tier >= 0;
    if (!earned) continue;
    snapshot[badgeId] = Number.isFinite(state.tier) ? Math.max(state.tier, 0) : 0;
  }
  return snapshot;
}

/** The snapshot re-expressed as state entries, so it can be diffed as one. */
function snapshotAsState(snapshot) {
  /** @type {Record<string, any>} */
  const asState = {};
  for (const [badgeId, tier] of Object.entries(snapshot || {})) {
    asState[badgeId] = { earned: true, tier: Number.isFinite(tier) ? tier : 0 };
  }
  return asState;
}

/**
 * Was this badge earned from history rather than in play since launch?
 *
 * `earliestDate` is null for solo-Blitz badges and First Podium (their sources
 * carry no date), so a date test alone can't classify them — which is exactly
 * why FIRST RUN is decided by the missing snapshot, not by dates. Post-first-run
 * a dateless badge is genuinely new (it wasn't in the previous snapshot) and
 * takes the live path.
 *
 * 🔴 JUDGED BY THE DAY THE CURRENT TIER WAS REACHED (2026-10-18). `earliestDate`
 * dates the FIRST qualifying event, so a count ladder whose first Easy solve
 * predates launch but whose 10th landed today was filed as history and never
 * popped (docs/bugs.md). `tierReachedDate`, when the derivation can supply it,
 * is the right date; `earliestDate` remains the fallback.
 *
 * @param {any} state
 * @param {string} launchDate
 * @returns {boolean}
 */
export function isRetroactiveEarn(state, launchDate, badge) {
  if (state && typeof state === 'object' && typeof state.retroactive === 'boolean') return state.retroactive;
  const earliest = state?.tierReachedDate || state?.earliestDate;
  const cutoff = retroactiveCutoff(badge, launchDate);
  if (!earliest || !cutoff) return false;
  return String(earliest) < String(cutoff);
}

/**
 * The date before which an earn counts as "from history" FOR THIS BADGE.
 *
 * The system launch date is not enough on its own. Badges are DERIVED from a
 * player's whole history, so a badge added to the catalog later is instantly
 * earned by past solves — and a solve made AFTER the system launched but BEFORE
 * that badge existed would otherwise be classified as a live earn and pop.
 * Adding twelve badges at once would then fire up to twelve pops for solves the
 * player made before any of those badges were in the game.
 *
 * A badge cannot be earned live before it exists, so the cutoff is the LATER of
 * the system launch and the badge's own `availableFrom`.
 *
 * @param {{availableFrom?: string} | null | undefined} badge
 * @param {string} launchDate
 * @returns {string}
 */
export function retroactiveCutoff(badge, launchDate = BADGE_SYSTEM_LAUNCH_DATE) {
  const added = badge?.availableFrom;
  if (!added) return launchDate;
  if (!launchDate) return added;
  return String(added) > String(launchDate) ? String(added) : String(launchDate);
}

/**
 * Decide what to celebrate right now.
 *
 * @param {Object} [args]
 * @param {Record<string, any>} [args.stateById]  Merged Lane B/D state, keyed by registry badge id.
 * @param {Record<string, number>|null} [args.announced] The persisted snapshot; `null`/absent = first run.
 * @param {string} [args.launchDate] ISO launch date; defaults to the SHARED showcase marker.
 * @returns {{live: Array, retroactive: Array, nextSnapshot: Record<string, number>, isFirstRun: boolean}}
 *   `live` → per-earn pops (AwardCelebrationSequence).
 *   `retroactive` → ONE summary moment (RetroactiveBadgeMoment).
 *   `nextSnapshot` → persist this once the moment has been shown.
 */
export function planBadgeAnnouncement({ stateById = {}, announced = null, launchDate = BADGE_SYSTEM_LAUNCH_DATE } = {}) {
  const isFirstRun = announced === null || announced === undefined;
  const nextSnapshot = snapshotFromState(stateById);

  const awards = detectNewBadgeAwards({
    prev: isFirstRun ? {} : snapshotAsState(announced),
    next: stateById,
  });

  // FIRST RUN after the feature ships: everything the player already holds came
  // from their history by definition, dates or no dates. One moment, not N pops.
  if (isFirstRun) {
    return { live: [], retroactive: awards, nextSnapshot, isFirstRun };
  }

  // THIRD CASE: A CATALOG RE-CUT.
  //
  // The two branches below assume a tier only moves because the PLAYER moved. A
  // re-cut breaks that: when 17 craft feats merged into 8 families (2026-09-03),
  // every existing holder was lifted onto a higher rung without doing anything.
  // Those are `previousTier >= 0`, so they are not first earns, so they were all
  // classified LIVE — and a long-time player would have opened the app to a burst
  // of pops for badges earned months ago. That is precisely the failure the
  // retroactive summary exists to prevent.
  //
  // Detected from the SNAPSHOT rather than a date or a flag: after a re-cut the
  // stored snapshot still names badges the catalog no longer has. That is true on
  // the first run after the re-cut and never again, because `nextSnapshot` is
  // rebuilt from live state — so this exemption switches itself off permanently
  // without anything to remember or migrate.
  //
  // It is deliberately ANDed with the same historical test as a first earn below,
  // so a rung the player genuinely climbed today still pops.
  const isCatalogRecut = !isFirstRun
    && Object.keys(announced || {}).some((badgeId) => !getBadge(badgeId));

  const live = [];
  const retroactive = [];
  for (const award of awards) {
    // Only a FIRST earn can be retroactive. `earliestDate` dates the first-ever
    // qualifying solve (and `tierReachedDate` is absent for some ladders), so a
    // LADDER CROSSING on a badge first earned years ago
    // still carries a pre-launch date — classifying by date alone would bury a
    // rung the player just climbed today in a "retroactive" summary instead of
    // popping it. A crossing measured against a snapshot we already hold is, by
    // definition, new activity since we last looked.
    const firstEarn = award.previousTier < 0;
    // The badge is resolved so its own `availableFrom` can move the cutoff: a
    // badge added after launch must not pop for solves that predate it.
    const badge = getBadge(award.badgeId);
    // `firstEarn || isCatalogRecut` — a crossing caused by the ladder changing
    // under the player is as historical as a first earn, and belongs in the same
    // one summary rather than as N pops.
    const historical = isRetroactiveEarn(award.state, launchDate, badge);
    ((firstEarn || isCatalogRecut) && historical ? retroactive : live).push(award);
  }

  return { live, retroactive, nextSnapshot, isFirstRun };
}

/**
 * Record ONLY the badges that were actually announced.
 *
 * `planBadgeAnnouncement` hands back `nextSnapshot` — everything the player
 * currently holds — which is the right thing to persist on a surface that shows
 * BOTH the live pops and the retroactive summary. A surface that shows only the
 * live pops (the post-solve celebration on the Game page) must not write it: the
 * retroactive set would be marked announced without ever having been shown, and
 * the one "you've unlocked N badges" moment would be silently lost.
 *
 * So this merges just the awards that were queued into the record we already
 * held. Tiers only ever move UP, so a lower rung arriving late can never
 * un-announce a higher one.
 *
 * @param {Record<string, number>|null} [announced] the record before this moment
 * @param {Array<{badgeId?: string, tier?: number}>} [awards] what was shown
 * @returns {Record<string, number>}
 */
export function mergeAnnounced(announced, awards = []) {
  /** @type {Record<string, number>} */
  const next = { ...(announced || {}) };
  for (const award of awards || []) {
    const badgeId = award?.badgeId;
    if (!badgeId) continue;
    const tier = Number.isFinite(award?.tier) ? Math.max(/** @type {number} */ (award.tier), 0) : 0;
    const held = Number.isFinite(next[badgeId]) ? next[badgeId] : -1;
    next[badgeId] = Math.max(held, tier);
  }
  return next;
}
