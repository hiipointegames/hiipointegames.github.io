import React, { useEffect } from 'react';
import { createPortal } from 'react-dom';
import { motion } from 'framer-motion';
import { Users } from 'lucide-react';
import { FriendsSection } from '@/components/profile';
import Starfield from '@/shell/Starfield';

// Full-screen "Friends & Players" screen that opens ABOVE the home launcher
// (David 2026-07-13) — replaces the old inline collapsible so the social surface
// (search, invite, friends list, recommended players) gets a whole screen
// instead of cramming into the zero-scroll launcher. Owns its own scroll region
// (app-page-scroll reserves the ad band) + a Back button; hosts the shared
// FriendsSection `embedded`, so THIS screen supplies the single title. Body
// scroll is locked while open. Rendered high (z-[100]) so it covers the home
// chrome; unmounts on close (no exit animation — keeps it snappy + testable).
//
// Beta-2 refinement (2026-07-26): the screen used to paint a FLAT cosmic panel
// gradient, which read as a bare modal next to the rest of the app's starry
// space background. It now mounts the SAME shared <Starfield> the routed pages
// show through (the app-wide one lives at z-0 in Layout, but this overlay portals
// to <body> at z-130 and covered it) — so Friends reads as a real neon page. The
// starfield sits behind the content (its own z-0 within this overlay's stacking
// context); the scroll region is lifted to z-[1] above it, exactly like the
// Layout content wrapper sits above the app starfield.
//
// Closing (item E, 2026-07-26): the redundant top-left Back button was removed —
// the app-wide bottom nav bar sits ABOVE this overlay (z-140 > z-130) and stays
// tappable, so tapping any tab closes Friends and navigates. For web/desktop and
// keyboard users (who no longer have a visible close affordance) the Escape key
// also closes it via `onClose`. There is no in-screen close control anymore.
export default function FriendsScreen({ isOpen, onClose }) {
  useEffect(() => {
    if (!isOpen) return undefined;
    document.body.style.overflow = 'hidden';
    // Escape closes the overlay (web/desktop + keyboard a11y) now that the
    // in-screen Back button is gone; the bottom nav bar is the touch way out.
    const onKeyDown = (e) => { if (e.key === 'Escape') onClose?.(); };
    window.addEventListener('keydown', onKeyDown);
    return () => {
      document.body.style.overflow = '';
      window.removeEventListener('keydown', onKeyDown);
    };
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  // Portal to <body>: the home page content lives inside Layout's
  // `relative z-[1]` stacking context, which would trap this screen BELOW the
  // body-portaled home chrome (bell/hamburger, z-50). Rendering at the body root
  // with z-[130] lets it cover the chrome (and the z-120 inbox) cleanly — same
  // reason the chrome itself is portaled (see Layout.jsx). (David, 2026-07-13)
  return createPortal((
    <motion.div
      data-testid="friends-screen"
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      className="fixed inset-0 z-[130] overflow-hidden"
      // Fallback base tint under the starfield (which is itself opaque) so there's
      // never a flash of transparency before the field paints.
      style={{ background: 'var(--u37-panel-bg-cosmic)' }}
    >
      {/* Starry space background — the shared animated field, same as every routed
          page. Scoped inside this overlay (its .starfield is fixed z-0, behind the
          z-[1] scroll region below). */}
      <Starfield />
      <div className="relative z-[1] app-page-scroll pt-[60px] pb-6 scroll-edge-fade-bottom">
        <div className="max-w-2xl mx-auto px-4 pb-10">
          {/* Header — centered title (green = the Friends identity). The
              top-left Back button was REMOVED (item E, 2026-07-26): the app-wide
              bottom nav bar sits ABOVE this overlay (z-140 > z-130) and stays
              tappable from within Friends, so tapping any tab closes Friends and
              navigates — the in-screen Back button was redundant. */}
          <div className="flex items-center justify-center gap-2.5 mb-6">
            <Users className="w-6 h-6" style={{ color: 'var(--u37-green)' }} />
            <h1
              className="text-2xl font-black"
              style={{ color: 'var(--u37-green)', textShadow: '0 0 14px color-mix(in srgb, var(--u37-green) 55%, transparent)' }}
            >
              Friends &amp; Players
            </h1>
          </div>

          <FriendsSection embedded />
        </div>
      </div>
    </motion.div>
  ), document.body);
}
