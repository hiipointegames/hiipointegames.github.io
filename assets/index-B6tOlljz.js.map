// The guest soft wall — which screens are locked, and how to ask for the unlock sheet.
//
// David, 2026-10-10: guests can play the Daily and Practice (and share); the
// identity features are locked behind a short "unlock" sheet that leads into
// signup. Enforced in the APP only (design D2) — it is an incentive, not access
// control. Who is a guest is @/auth accountTier, never a local test.

/** Pages a guest cannot open → the feature key the unlock sheet speaks about. */
export const LOCKED_PAGES = Object.freeze({
  Leaderboard: 'leaderboards',
  Statistics: 'stats',
  HeadToHead: 'blitz',
  Badges: 'badges',
  OtherProfile: 'profiles',
  FriendList: 'friends',
  // David, 2026-10-19: "You have to be a player with a username and password to
  // get into Sector 73." A deep link, a stale cached unlock or Back lands a guest
  // on Home with the unlock sheet, like every other locked page.
  Sector73: 'sector73',
});

/** Bottom-nav tabs a guest cannot open (Home stays open). */
export const LOCKED_NAV_TABS = Object.freeze({
  blitz: 'blitz',
  board: 'leaderboards',
  stats: 'stats',
  friends: 'friends',
});

/** @param {string | null | undefined} pageName */
export function lockedFeatureForPage(pageName) {
  return (pageName && LOCKED_PAGES[pageName]) || null;
}

/** @param {string | null | undefined} tabId */
export function lockedFeatureForTab(tabId) {
  return (tabId && LOCKED_NAV_TABS[tabId]) || null;
}

/** The window event Layout listens for. */
export const UNLOCK_EVENT = 'openUnlockSheet';

/** Ask Layout to show the unlock sheet for `feature`. */
export function openUnlockSheet(feature) {
  window.dispatchEvent(new CustomEvent(UNLOCK_EVENT, { detail: { feature } }));
}

/** The sheet's headline per feature (approved mockup screen 9). */
export const UNLOCK_TITLE = Object.freeze({
  leaderboards: 'Leaderboards are for players with an account',
  podium: 'See today’s podium with a free account',
  stats: 'Your stats are waiting for an account',
  streaks: 'Keep your streaks with a free account',
  badges: 'Badges are for players with an account',
  blitz: 'Blitz battles need a free account',
  friends: 'Friends need a free account',
  profiles: 'Player profiles are for players with an account',
  sector73: 'This one needs a free account',
});

/** @param {string | null | undefined} feature */
export function unlockTitle(feature) {
  return UNLOCK_TITLE[feature] || 'This needs a free account';
}
