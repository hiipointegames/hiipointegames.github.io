import React from 'react';
import { useSector73Switch } from '@/sector73/sector73Switch'; // the switch alone, not the Mirror barrel
import PageNotFound from './PageNotFound';

/**
 * The /Sector73 route behind the master switch (app_settings.sector73).
 *
 * OFF → the app's unknown-route page, exactly what /Sector73 showed before Sector 73
 * was merged (it had no route then), for members and guests alike. The cockpit's lazy
 * chunk is never requested and none of its server calls (sector73_* RPCs and tables,
 * rooms) can fire. While the switch is still being read → `pending` (a loader), never
 * a flash of the cockpit. ON → the route as built (Layout still walls guests).
 *
 * @param {{ children: React.ReactNode, pending?: React.ReactNode }} props
 */
export default function Sector73RouteGate({ children, pending = null }) {
  const { enabled, resolved } = useSector73Switch();
  if (!resolved) return pending;
  if (!enabled) return <PageNotFound />;
  return children;
}
