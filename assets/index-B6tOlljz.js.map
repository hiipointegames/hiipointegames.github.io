// Put the card online so the /play/<code> link previews as the player's card.
//
// David (2026-10-04): one picture per share. The message no longer attaches the
// card as a photo; instead the website names `share-cards/<code>.jpg` as the
// link's preview image (website-com api/play.js), but only when has_share_card
// confirms the uploader saved that link (migration 20261004100000).
//
// Runs while the result screen is up, BEFORE the Share tap, and nothing waits
// on it: a share must never wait on the network. If the upload is slow or fails,
// the link simply previews as the generic "Play 37" card.
//
// JPEG, not PNG: the bucket takes JPEG only, and WhatsApp drops preview images
// over ~300 KB. Quality steps down until the card fits.

export const SHARE_CARD_BUCKET = 'share-cards';
export const MAX_CARD_BYTES = 300 * 1024;
const QUALITIES = [0.85, 0.7, 0.55];

function toJpeg(canvas, quality) {
  return new Promise((resolve) => {
    try {
      canvas.toBlob((b) => resolve(b || null), 'image/jpeg', quality);
    } catch {
      resolve(null);
    }
  });
}

/**
 * @param {object} p
 * @param {{ storage?: any }|null} p.client supabase client
 * @param {string|null} p.code the share code the message carries
 * @param {HTMLCanvasElement|null} p.canvas the rendered card
 * @returns {Promise<boolean>} true when the card is online. Never throws.
 */
export async function uploadShareCard({ client, code, canvas }) {
  if (!code || !canvas?.toBlob || !client?.storage?.from) return false;
  try {
    for (const quality of QUALITIES) {
      const blob = await toJpeg(canvas, quality);
      if (!blob) return false;
      if (blob.size > MAX_CARD_BYTES) continue;
      const { error } = await client.storage.from(SHARE_CARD_BUCKET).upload(`${code}.jpg`, blob, {
        contentType: 'image/jpeg',
        upsert: false,
        cacheControl: '31536000',
      });
      return !error;
    }
    return false;
  } catch {
    return false;
  }
}
