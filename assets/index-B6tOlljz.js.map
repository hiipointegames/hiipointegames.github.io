// Reduced motion — one source of truth for every Sector 73 effect.
//
// When the player's phone asks for less motion (Android "Remove animations", iOS "Reduce
// Motion"), every fx function becomes a no-op or a gentle fade, so modes never branch on it
// themselves (animation playbook §4, sweep 2026-10-05).

import { useEffect, useState } from 'react';

const QUERY = '(prefers-reduced-motion: reduce)';

/** @param {{ matchMedia?: (q: string) => { matches: boolean } }} [env] */
export function prefersReducedMotion(env = globalThis) {
  try {
    return env.matchMedia?.(QUERY).matches === true;
  } catch {
    return false;
  }
}

/** Live version: re-renders if the setting changes while the app is open. */
export function usePrefersReducedMotion() {
  const [reduced, setReduced] = useState(() => prefersReducedMotion());
  useEffect(() => {
    const mq = globalThis.matchMedia?.(QUERY);
    if (!mq?.addEventListener) return undefined;
    const onChange = () => setReduced(mq.matches);
    mq.addEventListener('change', onChange);
    return () => mq.removeEventListener('change', onChange);
  }, []);
  return reduced;
}
