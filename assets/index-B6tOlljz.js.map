// AdSenseUnit — renders a single Google AdSense display unit.
//
// Only ever mounted when VITE_ADSENSE_CLIENT is set (callers gate on
// isAdSenseEnabled()), so this file holds the real-ad path. Until AdSense is
// approved it never renders in production — the placeholders do. Kept tiny and
// isolated so the ad SDK touches nothing else.
//
// Loads the AdSense loader script once per page, then renders the <ins> element
// AdSense fills. Failures are swallowed — a broken ad must never break the game.

import React, { useEffect, useRef } from 'react';

const LOADER_SRC = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js';

function ensureLoaderScript(client) {
  if (typeof document === 'undefined') return;
  // Dedup by src (AdSense supports one publisher per page). Don't add a custom
  // data-* attribute — AdSense inspects the loader tag and warns on attributes
  // it doesn't recognize.
  if (document.querySelector('script[src*="adsbygoogle.js"]')) return;
  const s = document.createElement('script');
  s.async = true;
  s.src = `${LOADER_SRC}?client=${encodeURIComponent(client)}`;
  s.crossOrigin = 'anonymous';
  document.head.appendChild(s);
}

/**
 * @param {{ client: any, slot: any, format?: string, style?: any, className?: string }} props
 */
export default function AdSenseUnit({ client, slot, format = 'auto', style, className }) {
  const insRef = useRef(null);

  useEffect(() => {
    // Both guards mirror the render guards below — no client or no slot means no
    // <ins> is rendered, so the loader script must not be injected either.
    // Injecting it anyway is what put the page-level `adsbygoogle.js?client=…`
    // tag (and the Google-controlled anchor unit it auto-injects) on every
    // screen. Nothing to fill → nothing to load.
    if (!client || !slot) return;
    ensureLoaderScript(client);

    const ins = insRef.current;
    if (!ins) return;

    const doPush = () => {
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {
        console.warn('AdSense push failed:', e);
      }
    };

    // AdSense throws asynchronously when pushed into a 0-width container —
    // bypassing the try/catch — which reaches Sentry. Wait for positive width.
    if (ins.offsetWidth > 0) {
      doPush();
      return;
    }

    const ro = new ResizeObserver((entries) => {
      for (const entry of entries) {
        if (entry.contentRect.width > 0) {
          ro.disconnect();
          doPush();
          return;
        }
      }
    });
    ro.observe(ins);
    return () => ro.disconnect();
  }, [client, slot]);

  if (!client) return null;
  // A manual AdSense unit with no data-ad-slot is malformed: AdSense treats it
  // as page-level inventory rather than the placement we asked for. Until
  // VITE_ADSENSE_BANNER_SLOT holds a real ad-unit id (which requires an approved
  // account), render nothing at all rather than a slot-less <ins>.
  if (!slot) return null;

  return (
    <ins
      ref={insRef}
      className={`adsbygoogle ${className || ''}`.trim()}
      style={style || { display: 'block', width: '100%', height: '100%' }}
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    />
  );
}
