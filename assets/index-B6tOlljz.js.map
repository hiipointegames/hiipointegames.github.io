import React from 'react';
import { createPortal } from 'react-dom';
import { AnimatePresence, motion } from 'framer-motion';
import { Trophy, X } from 'lucide-react';

// The guest "you would have placed #N" nudge (rules + copy: ./guestNudgeRules).
//
// Portaled to <body> (inside #root, iOS traps z-index under the body-portaled
// nav — the iPhone stacking rule). The CTA closes FIRST and then dispatches the
// app-wide `openSaveStats` event, the same flow every other guest nudge opens,
// so the player lands on the sign-up form, not on it behind this card.

/**
 * @param {{
 *   open: boolean,
 *   copy: { title: string, body: string, cta: string, dismiss: string } | null,
 *   onClose: () => void,
 * }} props
 */
export default function GuestPlacementNudge({ open, copy, onClose }) {
  if (typeof document === 'undefined') return null;

  const createAccount = () => {
    onClose?.();
    window.dispatchEvent(new Event('openSaveStats'));
  };

  return createPortal(
    <AnimatePresence>
      {open && copy && (
        <motion.div
          data-testid="guest-placement-nudge-overlay"
          className="fixed inset-0 z-[60] flex items-center justify-center p-4"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
        >
          <button
            type="button"
            aria-label="Close"
            onClick={onClose}
            className="absolute inset-0 bg-black/80 backdrop-blur-sm"
          />
          <div
            data-testid="guest-placement-nudge"
            role="dialog"
            aria-modal="true"
            aria-labelledby="guest-placement-nudge-title"
            className="relative w-full max-w-sm mx-auto rounded-2xl border p-5 text-center overflow-y-auto"
            style={{
              background: 'var(--u37-panel-bg)',
              borderColor: 'color-mix(in srgb, var(--u37-gold) 50%, transparent)',
              boxShadow: '0 18px 60px rgba(0,0,0,0.5), 0 0 34px -18px var(--u37-gold)',
              maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
            }}
          >
            <div className="flex justify-end -mt-2 -mr-2">
              <button
                type="button"
                onClick={onClose}
                aria-label="Close"
                className="min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-400"
              >
                <X className="w-5 h-5" aria-hidden="true" />
              </button>
            </div>
            <div className="flex justify-center mb-3">
              <Trophy className="w-10 h-10" style={{ color: 'var(--u37-gold)' }} aria-hidden="true" />
            </div>
            <h2 id="guest-placement-nudge-title" className="text-xl font-black mb-2" style={{ color: 'var(--u37-gold)' }}>
              {copy.title}
            </h2>
            <p className="text-slate-200 text-sm mb-5 leading-snug">{copy.body}</p>
            <button
              type="button"
              data-testid="guest-placement-nudge-create"
              onClick={createAccount}
              className="w-full min-h-[50px] rounded-xl font-black text-base text-slate-900 touch-manipulation active:scale-[0.98]"
              style={{ background: 'var(--u37-gold)' }}
            >
              {copy.cta}
            </button>
            <button
              type="button"
              data-testid="guest-placement-nudge-dismiss"
              onClick={onClose}
              className="w-full min-h-[44px] mt-2 text-sm font-bold text-slate-400"
            >
              {copy.dismiss}
            </button>
          </div>
        </motion.div>
      )}
    </AnimatePresence>,
    document.body,
  );
}
