import React, { useId } from 'react';

// Logo37 — the 37 brand mark (David 2026-07-13, "Option B"): a beveled
// metallic-gold "37" framed by a delicate cyan neon hexagon. Self-contained,
// dependency-free SVG that scales crisp from app-icon (48px) to hero. Gold
// gradient + a dark extrude for depth + a fine cyan rim/glow on the numerals;
// the hex is a thin cyan outline (1.6 @ 200-viewBox) hugging the numerals
// (scale 0.84). STATIC — wrap it (e.g. WinMedallion) if you want motion.
// Gradient/filter ids are namespaced per instance (useId) so multiple logos on
// one page don't collide.
/**
 * @param {{ size?: number, className?: string, title?: string }} props
 */
export function Logo37({ size = 64, className = '', title = '37' }) {
  const uid = useId().replace(/:/g, '');
  const gid = `l37g-${uid}`;
  const cf = `l37c-${uid}`;
  const hf = `l37h-${uid}`;

  const s = 0.84; // hex scale — Option B tightness
  const pts = [[0, -84], [70, -43], [70, 43], [0, 84], [-70, 43], [-70, -43]]
    .map(([x, y]) => `${(100 + x * s).toFixed(1)},${(100 + y * s).toFixed(1)}`)
    .join(' ');

  return (
    <svg
      viewBox="0 0 200 200"
      width={size}
      height={size}
      className={className}
      role="img"
      aria-label={title}
      data-testid="logo37"
    >
      <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor="#FFE873" />
          <stop offset="26%" stopColor="#FFD21F" />
          <stop offset="44%" stopColor="#F7B916" />
          <stop offset="50%" stopColor="#FFF9CE" />
          <stop offset="56%" stopColor="#F7B916" />
          <stop offset="78%" stopColor="#E7A012" />
          <stop offset="100%" stopColor="#FFDB4D" />
        </linearGradient>
        <filter id={cf} x="-60%" y="-60%" width="220%" height="220%">
          <feDropShadow dx="0" dy="0" stdDeviation="2.4" floodColor="#1ff0ff" floodOpacity="0.95" />
        </filter>
        {/* Brighter hex glow (David, 2026-09-12: "make the cyan outline a little
            brighter"). Raised opacity + a slightly wider spread. This is a STATIC
            filter — the mark carries no transform anywhere, so it rasterizes once
            rather than per frame, which is the distinction that matters on the
            Android WebView (docs/bugs.md 2026-07-13). */}
        <filter id={hf} x="-55%" y="-55%" width="210%" height="210%">
          <feDropShadow dx="0" dy="0" stdDeviation="3.1" floodColor="#1ff0ff" floodOpacity="1" />
        </filter>
      </defs>

      {/* delicate cyan neon hex frame hugging the numerals */}
      <polygon points={pts} fill="#0a0f1e" stroke="#1ff0ff" strokeWidth="2.1" filter={`url(#${hf})`} />

      {/* bevel/extrude shadow for depth (decorative). Vertically centered on the
          hex center (100,100) via dominant-baseline so the black margin is even
          top/bottom; a small +x/+y offset keeps the 3D bevel. */}
      <text x="101.5" y="101.5" textAnchor="middle" dominantBaseline="central" fontSize="80" fontWeight="900"
        fontFamily="Arial Black, Arial, sans-serif" fill="#3a2706" aria-hidden="true">37</text>
      {/* metallic-gold face with a fine cyan rim + glow (decorative) */}
      <text x="100" y="100" textAnchor="middle" dominantBaseline="central" fontSize="80" fontWeight="900"
        fontFamily="Arial Black, Arial, sans-serif" fill={`url(#${gid})`} stroke="#1ff0ff"
        strokeWidth="1.2" paintOrder="stroke" filter={`url(#${cf})`} aria-hidden="true">37</text>
    </svg>
  );
}
