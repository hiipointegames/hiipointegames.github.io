// ONE rule for "does this player have an account?" — and what a guest may not open.
//
// David, 2026-10-10: an account is a USERNAME + PASSWORD. Everyone else is a
// guest, who can play the Daily and Practice (and share) but cannot see
// leaderboards, the podium, stats, streaks, badges, battles, friends, other
// players' profiles or Sector 73. The locks live in the app only (design D2):
// they are an incentive, not access control — the server stays guest-blind.
//
// Why a new function rather than reusing isGuest/isCredentialedAccount at each
// call site: research (2026-10-10 CRISPY, synthesis Q1) found SIX different
// guest tests in the app that disagree with each other. Every new gate uses
// this one, so the soft wall can never be open on one screen and shut on the
// next for the same player.
//
// Legacy NAMED guests (picked a username years ago, never set a password — 229
// accounts) are guests here too. `guestUsername` lets their unlock copy say
// "add a password to keep @name" instead of asking them to pick a name again.

import { isCredentialedAccount } from './accountStatus';

/**
 * @param {Record<string, any> | null | undefined} user raw auth user OR the merged me() shape
 * @returns {'guest' | 'member'}
 */
export function accountTier(user) {
  return isCredentialedAccount(user) ? 'member' : 'guest';
}

/** @param {Record<string, any> | null | undefined} user */
export function isMember(user) {
  return accountTier(user) === 'member';
}

/**
 * Everything a guest cannot open. The keys are what UnlockSheet and the gates
 * pass around, so the sheet can say WHAT the player was reaching for.
 */
export const GUEST_LOCKED = Object.freeze([
  'leaderboards',
  'podium',
  'stats',
  'streaks',
  'badges',
  'blitz',
  'friends',
  'profiles',
  'sector73',
]);

/**
 * @param {Record<string, any> | null | undefined} user
 * @param {string} feature one of GUEST_LOCKED
 * @returns {boolean} true when this player must create an account first
 */
export function isLockedForGuest(user, feature) {
  return accountTier(user) === 'guest' && GUEST_LOCKED.includes(feature);
}

/**
 * A legacy named guest's username, so copy can address them by it. Null for an
 * unnamed guest and for members (who don't need it).
 *
 * Reads both shapes — `isNamedAccount` reads only the top level, so it is
 * always false on the raw auth user that `useAuth()` hands out (research Q1).
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {string | null}
 */
export function guestUsername(user) {
  if (!user || accountTier(user) !== 'guest') return null;
  const meta = user.user_metadata || {};
  const custom = user.has_custom_username ?? meta.has_custom_username;
  const name = user.username ?? meta.username;
  return custom && typeof name === 'string' && name.trim() ? name.trim() : null;
}
