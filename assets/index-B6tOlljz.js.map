// Craft RUNG predicates — the detection half of the eight merged craft families.
//
// Split out of ./craftBadgeDerivation.js on 2026-09-03 with the family merge
// (design-per-mode-2026-08-31 § 2). Two reasons, both load-bearing:
//
//   1. craftBadgeDerivation.js sits at the 800-line structural cap with one line
//      spare and is NOT grandfathered in arch-ratchet.baseline.json, so a merged
//      ladder's rung table could not be appended to it. Extracting is the honest
//      fix; growing the blob is not available.
//   2. The rung table is the one part of the merge that will keep growing — the
//      per-mode extension (step 2) adds cells, and every cell reuses these
//      predicates. It deserves its own module and its own test.
//
// LAYERING is unchanged from the pre-merge design: nothing here knows a badge, a
// tier or a threshold-in-the-registry sense of the word.
//
//   "what shape was this solve?"   → @/equation-engine   (pure, per equation)
//   "which rungs does that reach?" → HERE                (pure, per player)
//   "what is that rung worth?"     → @/game-mechanics    badgeRegistry
//
// The registry declares each family's rungs as `{ key, label }` and NOTHING
// else — it is pure metadata and may not import a predicate. This module
// declares the predicate for each key. `craftStages.test.js` pins that the two
// key sets are identical, so a rung can never ship without a predicate, and a
// predicate can never linger after its rung is cut.

import { CRAFT_FAMILIES, getBadgeForFeat } from '@/game-mechanics';
import {
  isPerfectSolve,
  finishesOnBlueDivision,
  finishesOnExponent,
  parenClusterCount,
  maxParenDepth,
  usesAllFourOps,
  usesAllFourOpsWithExponent,
  usesExponent,
  maxIntermediateMagnitude,
  highestEchoMultiple,
} from '@/equation-engine';

/**
 * @typedef {import('./craftBadgeDerivation').SolveRow} SolveRow
 *
 * @typedef {Object} SolveFacts
 * @property {boolean} perfect        All three power dice used correctly.
 * @property {number} depth           Deepest parenthesis nesting.
 * @property {number} groups          Separate parenthesis CLUSTERS — top-level
 *   groups, not opening brackets. `((1+2)*3)+4` is ONE cluster two deep, not two.
 *   Until 2026-09-03 this read `parenGroupCount`, which counts opening parens, so
 *   a depth-3 solve necessarily scored three "clusters" and Event Horizon's Three
 *   Deep rung could not light without Constellation's Three Clusters rung lighting
 *   too. See equation-engine/craftPredicates.js `parenClusterCount`.
 * @property {boolean} exponent       An exponent appears anywhere.
 * @property {boolean} fourOps        All four operations appear.
 * @property {boolean} works          All four operations AND an exponent.
 * @property {number} magnitude       Largest intermediate value reached.
 * @property {number} echo            Highest exact multiple of 37 passed through.
 * @property {boolean} blueDivision   Finished with a division by the blue die.
 * @property {boolean} exponentLast   Finished with the red exponent die placed last.
 * @property {number} seconds         Recorded solve time; 0 means NEVER RECORDED.
 */

/**
 * A solve counts as "lightning" under a minute. `solve_time_seconds` is 0 on
 * practice rows written before the timer was threaded through, and 0 means
 * "not recorded", NOT "instant" — so an unrecorded time can never mint the rung.
 * Kept here rather than shared with the Daily Speed ladder's GENIUS_SECONDS: one
 * is a rung of The Great Divide, the other a badge in its own right, and
 * retuning either must not move the other.
 */
export const LIGHTNING_SECONDS = 60;

/** A recorded (non-zero, finite) solve time. 0 = never recorded, not instant. */
const isRecordedTime = (seconds) =>
  typeof seconds === 'number' && Number.isFinite(seconds) && seconds > 0;

/**
 * Every shape question asked of one solve, answered ONCE.
 *
 * The pre-merge replay called each predicate per feat; a merged family asks
 * several of them per rung, so the same equation would be parsed five or six
 * times per row. Computing the facts once per row and letting every rung read
 * them keeps the replay linear in rows, not in rows × rungs.
 *
 * @param {SolveRow} row
 * @returns {SolveFacts}
 */
export function solveFacts(row) {
  const { equation, usedDiceIndices, diceColors } = row;
  const magnitude = maxIntermediateMagnitude(equation, usedDiceIndices, diceColors);
  const echo = highestEchoMultiple(equation, usedDiceIndices, diceColors);
  return {
    perfect: isPerfectSolve(equation, usedDiceIndices, diceColors) === true,
    depth: maxParenDepth(equation),
    groups: parenClusterCount(equation),
    exponent: usesExponent(equation) === true,
    fourOps: usesAllFourOps(equation) === true,
    works: usesAllFourOpsWithExponent(equation) === true,
    magnitude: Number.isFinite(magnitude) ? magnitude : 0,
    echo: Number.isFinite(echo) ? echo : 0,
    blueDivision: finishesOnBlueDivision(equation, usedDiceIndices, diceColors) === true,
    exponentLast: finishesOnExponent(equation, usedDiceIndices, diceColors) === true,
    seconds: isRecordedTime(row.solve_time_seconds) ? /** @type {number} */ (row.solve_time_seconds) : 0,
  };
}

/**
 * One rung.
 *   `test`    — does THIS solve satisfy the rung's shape?
 *   `atLeast` — how many solves must satisfy it. Absent means one, which is the
 *               "did you ever" rung every family opens on and every prestige
 *               rung tops out on.
 *
 * A rung is reached when `atLeast` solves pass `test`. That single rule covers
 * both halves of a merged ladder: the qualitative rungs the subsumption pairs
 * became (`atLeast` 1, a stricter `test`) and the repeat rungs the pre-merge
 * count ladders contributed (`atLeast` 10/37/100, the family's base `test`).
 *
 * @typedef {Object} CraftStage
 * @property {string} key
 * @property {(facts: SolveFacts) => boolean} test
 * @property {number} [atLeast]
 */

/** Build the "did the base feat N times" rungs a pre-merge count ladder became. */
const repeats = (prefix, test, counts) =>
  counts.map((atLeast) => ({ key: `${prefix}${atLeast}`, test, atLeast }));

const isDivide = (f) => f.blueDivision;
const isPower = (f) => f.exponentLast;
const isThreeGroups = (f) => f.groups >= 3;
const isThreeDeep = (f) => f.depth >= 3;
const isClean = (f) => f.groups === 0;
const isFourOps = (f) => f.fourOps;

/**
 * The rungs of every craft family, keyed by featId, low → high.
 *
 * Ordering matters and is the registry's, not this file's: `CRAFT_STAGES[featId]`
 * must list the same keys in the same order as the family's `stages`. The test
 * pins it both ways.
 *
 * @type {Record<string, CraftStage[]>}
 */
export const CRAFT_STAGES = {
  greatDivide: [
    { key: 'divide', test: isDivide },
    ...repeats('divideX', isDivide, [10, 37, 100]),
    // The absorbed `lightningDivide`: the same feat, under the minute.
    { key: 'divideFast', test: (f) => f.blueDivision && f.seconds > 0 && f.seconds < LIGHTNING_SECONDS },
    // The absorbed `fission`.
    { key: 'dividePerfect', test: (f) => f.blueDivision && f.perfect },
  ],
  riseToPower: [
    { key: 'power', test: isPower },
    ...repeats('powerX', isPower, [10, 37, 100]),
    // The absorbed `criticalMass`.
    { key: 'powerPerfect', test: (f) => f.exponentLast && f.perfect },
  ],
  constellation: [
    { key: 'group1', test: (f) => f.groups >= 1 },
    { key: 'group2', test: (f) => f.groups >= 2 },
    { key: 'group3', test: isThreeGroups },
    ...repeats('group3X', isThreeGroups, [10, 37, 100]),
  ],
  eventHorizon: [
    { key: 'depth2', test: (f) => f.depth >= 2 },
    { key: 'depth3', test: isThreeDeep },
    ...repeats('depth3X', isThreeDeep, [5, 37]),
    // The absorbed `vanishingPoint`.
    { key: 'depth3Perfect', test: (f) => f.depth >= 3 && f.perfect },
  ],
  straightLine: [
    { key: 'clean', test: isClean },
    ...repeats('cleanX', isClean, [10, 37]),
    // The absorbed `photon`.
    { key: 'cleanPerfect', test: (f) => f.groups === 0 && f.perfect },
  ],
  fullSpectrum: [
    { key: 'exponent', test: (f) => f.exponent },
    { key: 'fourOps', test: isFourOps },
    ...repeats('fourOpsX', isFourOps, [10, 37, 100]),
    // The absorbed `bigBang` and, above it, `supernova`.
    { key: 'works', test: (f) => f.works },
    { key: 'worksPerfect', test: (f) => f.works && f.perfect },
  ],
  overTheTop: [
    { key: 'past100', test: (f) => f.magnitude >= 100 },
    { key: 'past1k', test: (f) => f.magnitude >= 1000 },
    { key: 'past10k', test: (f) => f.magnitude >= 10000 },
    { key: 'past100k', test: (f) => f.magnitude >= 100000 },
    // The absorbed `escapeVelocity`.
    { key: 'pastPerfect', test: (f) => f.magnitude >= 100 && f.perfect },
  ],
  echoOf37: [
    { key: 'echo74', test: (f) => f.echo >= 74 },
    { key: 'echo111', test: (f) => f.echo >= 111 },
    { key: 'echo148', test: (f) => f.echo >= 148 },
    { key: 'echo185', test: (f) => f.echo >= 185 },
    { key: 'echo222', test: (f) => f.echo >= 222 },
    // The absorbed `resonance`.
    { key: 'echoPerfect', test: (f) => f.echo >= 74 && f.perfect },
  ],
};

/** Every craft featId this module can judge, in registry order. */
export const CRAFT_STAGE_FEAT_IDS = Object.freeze(CRAFT_FAMILIES.map((f) => f.featId));

/**
 * How far up ONE family a set of solves climbs.
 *
 * Returns the highest rung REACHED, 1-based, or 0 for "not on the ladder at
 * all" — the shape `badgeState` wants, since a stage ladder's registry tiers are
 * the ordinals `[1..n]` and `badgeTierIndex(badge, ordinal)` then lands on the
 * right 0-based tier with no special case anywhere downstream.
 *
 * HIGHEST REACHED, not "first gap". The rungs of a merged family are mostly but
 * not perfectly nested — a player can hold Full Spectrum's "Big Bang" rung
 * without ever having done ten plain four-op solves — and burying the rarer
 * achievement because an easier one is missing would be exactly the demotion the
 * merge promised never to cause.
 *
 * @param {SolveFacts[]} facts
 * @param {CraftStage[]} stages
 * @returns {number}
 */
export function highestStageReached(facts, stages) {
  let reached = 0;
  for (let i = 0; i < stages.length; i++) {
    const stage = stages[i];
    const needed = stage.atLeast ?? 1;
    let hits = 0;
    for (const fact of facts) {
      if (!stage.test(fact)) continue;
      hits += 1;
      if (hits >= needed) break;
    }
    if (hits >= needed) reached = i + 1;
  }
  return reached;
}

/**
 * Does this solve qualify for the family at all — i.e. does it satisfy ANY rung?
 *
 * This is what `count`, `perfectCount` and `earliestDate` are folded over. It is
 * deliberately the union rather than rung 0's predicate: after the merge a family
 * has several entry shapes (Full Spectrum opens on an exponent OR on four
 * operations), and a card reading "×0" for a player who plainly earned it would
 * be the same blank the Locked grid exists to avoid.
 *
 * @param {SolveFacts} facts
 * @param {CraftStage[]} stages
 * @returns {boolean}
 */
export function qualifiesForFamily(facts, stages) {
  return stages.some((stage) => stage.test(facts));
}


// ---------------------------------------------------------------------------
// PER-MODE RUNG SETS (2026-09-04)
// ---------------------------------------------------------------------------
// Until the three-mode split every mode judged a family against the SAME rungs,
// so `CRAFT_STAGES[featId]` was the whole answer. It no longer is:
//
//   Easy Daily    — the power-dice rungs are pruned (no blue die, no red
//                   exponent die, `perfect` unreachable), so a family shows
//                   fewer rungs and two families do not appear at all.
//   Expert        — only the PERFECT rung, laddered by repetition, because
//                   Expert guarantees `perfect` and every family's top rung is
//                   `<shape> && perfect`. Leaving the base rungs in place let ONE
//                   Expert solve reach the top rung of 7 of the 8 families.
//
// The REGISTRY owns which rungs a (family, mode) pair has — it is the one place
// that already had to know, because it renders them. This module owns what each
// rung KEY means. So the lookup is by key, and the order comes from the badge.
// `craftStages.test.js` pins that every rung key in the catalog resolves here,
// so a rung can still never ship without a predicate.

/** Every base rung, flattened to `key -> stage`. */
const STAGE_BY_KEY = new Map(
  Object.values(CRAFT_STAGES).flat().map((stage) => [stage.key, stage]),
);

// The Expert repetition rungs. `dividePerfect` on Expert is the same predicate
// as `dividePerfect` anywhere else — what changes is that Expert ALSO offers
// "…ten times" and "…thirty-seven times" above it, since once every solve is
// perfect the only axis left is how often. Generated from the perfect rungs
// rather than hand-listed so a new family inherits them.
for (const stage of [...STAGE_BY_KEY.values()]) {
  if (!/Perfect$/.test(stage.key)) continue;
  for (const times of [10, 37]) {
    STAGE_BY_KEY.set(`${stage.key}X${times}`, {
      key: `${stage.key}X${times}`,
      test: stage.test,
      atLeast: times,
    });
  }
}

/**
 * The ordered rungs a family is judged against IN ONE MODE — resolved from the
 * registry entry's own rung list, so the derivation can never disagree with the
 * card about which rungs exist.
 *
 * Returns `[]` when the family has no entry in that mode (The Great Divide and
 * Rise to Power have no Easy Daily badge — neither is reachable without power
 * dice), which the caller reads as "this family does not apply here".
 *
 * @param {string} featId
 * @param {import('@/game-mechanics/badgeRegistry').BadgeMode} mode
 * @returns {CraftStage[]}
 */
export function stagesForMode(featId, mode) {
  const badge = getBadgeForFeat(featId, mode);
  const keys = badge?.scaling?.stages?.map((stage) => stage.key) ?? [];
  const resolved = [];
  for (const key of keys) {
    const stage = STAGE_BY_KEY.get(key);
    // A missing predicate is a catalog bug, not a runtime one — the test pins
    // against it. Skipping keeps a player's other badges rendering either way.
    if (stage) resolved.push(stage);
  }
  return resolved;
}

/** Every rung key this module can resolve — the test's half of the pin. */
export const KNOWN_STAGE_KEYS = Object.freeze([...STAGE_BY_KEY.keys()]);
