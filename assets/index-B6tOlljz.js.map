// Named questions about a mode key, so call sites stop comparing raw strings.
//
// Every predicate coerces through normalizeModeKey, so an absent or unrecognised
// value answers safely rather than throwing or silently behaving like the timed
// daily. See DEFAULT_MODE_KEY in ./modeKeys.js for why that default is 'easy'.
import { KEY_TO_TUPLE, normalizeModeKey, MODE_SHARE_LABELS, MODE_TIER_LABELS } from './modeKeys.js';

const tupleOf = (key) => KEY_TO_TUPLE[normalizeModeKey(key)];

/** The difficulty tier: 'easy' | 'challenge' | 'expert'. */
export const modeOf = (key) => tupleOf(key).mode;

/** The round type: 'daily' | 'practice'. */
export const roundOf = (key) => tupleOf(key).round;

/** True for THE DAILY of any mode — the timed, once-per-day, ranked round. */
export const isDaily = (key) => roundOf(key) === 'daily';

/** True for the untimed, unlimited practice round of any mode. */
export const isPractice = (key) => roundOf(key) === 'practice';

// Timing and "is this the daily" are the same question today: every Daily is
// timed and no practice round is. Kept as a separate name because call sites ask
// it for a different reason (starting a clock vs. writing a leaderboard row), and
// because a future untimed daily would change one without the other.
export const isTimed = (key) => isDaily(key);

/**
 * True if this mode deals power dice (blue/red/green).
 * Easy is all-white by definition; Challenge and Expert both use power dice.
 * Mirrors getDiceColors in src/dice/dice.js — see the drift guard test.
 */
export const hasPowerDice = (key) => modeOf(key) !== 'easy';

/**
 * True if "perfect solve" is even a meaningful idea in this mode.
 *
 * A perfect solve means all three power dice used correctly — the scorer's
 * predicate is literally `correctCount === 3` over coloured dice. Easy deals no
 * coloured dice, so correctCount can never exceed zero and a perfect solve is not
 * merely disallowed, it is ARITHMETICALLY UNREACHABLE.
 *
 * Consequences that depend on this: the gold perfect-solve outline must never
 * render on an Easy board, and the generator's acceptance predicate for Easy must
 * be `raw_solutions_count > 0` — using `valid_solutions_count > 0` would reject
 * every possible Easy puzzle, which is exactly the bug that made Easy
 * ungeneratable.
 */
export const hasPerfectConcept = (key) => hasPowerDice(key);

/**
 * True if a solve in this mode is REQUIRED to be perfect to count at all.
 * Expert only. Challenge accepts any valid solve to 37 and merely decorates a
 * perfect one; Easy has no perfect concept.
 */
export const requiresPerfectSolve = (key) => modeOf(key) === 'expert';

/**
 * The player-facing word for a mode key, of either round.
 *
 * `modeOf` coerces anything unrecognised to 'easy', which is the safe direction
 * for a LABEL — a screen never crashes over a stale mode string, it just shows
 * the gentlest tier.
 *
 * @param {string} key any wire key ('daily_expert', 'expert', …)
 * @returns {string}
 */
export const modeTierLabel = (key) => MODE_TIER_LABELS[modeOf(key)];

/**
 * The tier badge for shared text, icon included — see MODE_SHARE_LABELS.
 *
 * Normalizes through modeOf, so an unknown key lands on the default tier
 * rather than producing `undefined` in the middle of a message a player is
 * about to post somewhere public.
 *
 * @param {string} key a wire key from the game-modes vocabulary
 * @returns {string}
 */
export const modeShareLabel = (key) => MODE_SHARE_LABELS[modeOf(key)];
