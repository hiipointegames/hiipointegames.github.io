// One Daily share, end to end: pick the closing line, save the personal link,
// write the message, draw the card, open the share sheet.
//
// Callers (game-flow) gather the facts — which Daily, the result, the time, the
// day's dice, the board — and this does the rest. It returns what happened so the
// caller can fall back to a text-only share when no picture route exists.

import { modeOf } from '@/game-modes';
import { pickClosingLine } from './closingLines';
import { dailyPuzzleNumber } from './puzzleNumber';
import { createShareLink, generateShareCode } from './shareLink';
import { buildShareMessage } from './shareMessage';
import { buildCardModel, fasterThanPct } from './cardModel';
import { renderShareCard } from './drawShareCard';
import { dispatchShare, dispatchTextShare, cardFile } from './dispatchShare';
import { uploadShareCard } from './shareCardUpload';

/**
 * Does a share ATTACH the card as a photo, per platform?
 *
 * All false since 2026-10-04 (David): the card travels as the LINK PREVIEW
 * (shareCardUpload.js + the website's /play/<code> page), so the message is
 * text + link and the friend sees one picture, not the photo AND a generic
 * "Play 37" preview. Accepted trade-off: an app that doesn't auto-load previews
 * (iOS shows "Tap to Load Preview" for an RCS message from Android, and most
 * email apps show none) shows no picture until tapped.
 *
 * Flip a platform back to true to attach the photo there again. Its card is then
 * NOT uploaded, so its link falls back to the generic preview and the picture
 * never appears twice.
 */
export const ATTACH_CARD_PHOTO = Object.freeze({ ios: false, android: false, web: false });

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

/** 'YYYY-MM-DD' → 'Sep 29, 2026'. Pure string work, so no timezone can shift it. */
export function shortDateLabel(isoDate) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(isoDate || ''));
  return m ? `${MONTHS[Number(m[2]) - 1]} ${Number(m[3])}, ${m[1]}` : '';
}

/**
 * @param {object} p
 * @param {string} p.mode wire key of the Daily ('daily' | 'daily_easy' | 'daily_expert')
 * @param {'perfect'|'solved'|'forfeit'} p.result
 * @param {number|null} [p.seconds]
 * @param {string} p.date ET date 'YYYY-MM-DD'
 * @param {number[]|null} [p.dice] the day's 7 dice in stored order
 * @param {boolean[]|null} [p.squares] blue/red/green used correctly
 * @param {string|null} [p.username] null for a guest
 * @param {string|null} [p.inviteLine] referral line for the message (caller decides)
 * @param {Array<object>} [p.board] today's board for this mode (for the percentile)
 * @param {'ios'|'android'|'web'} p.platform
 * @param {{ rpc: Function }|null} p.client supabase client for the personal link
 * @param {object} [deps] test seams: rng, render, dispatch, makeCode, file
 * @returns {Promise<{ outcome: string, text: string, code: string|null, closingLine: string }>}
 */
export async function shareDailyResult(params, deps = {}) {
  return sendPreparedResult(await prepareDailyResult(params, deps), deps);
}

/**
 * Everything slow, done BEFORE the tap: the closing line, the message, the card,
 * and the card as a File.
 *
 * WHY THIS IS SPLIT FROM THE SEND (2026-10-03). A browser — and iOS's WKWebView
 * in an app shell without the native Share plugin — only opens a share sheet
 * while the tap's user activation is live. The old one-shot flow awaited the
 * link save (a database round trip) and toBlob before navigator.share, so on
 * those shells the share was refused, then the text share, then the clipboard:
 * the tap did nothing. Bryce hit it on an iPhone running the 1.0.318 OTA.
 *
 * The /play code is therefore made HERE, on the device, so the message can carry
 * it before the link is saved. The save happens in sendPreparedResult, without
 * the share waiting on it. If it fails, the code is just unknown to the /play
 * page, which then shows its generic copy (website-com play/index.html).
 */
export async function prepareDailyResult({
  mode, result, seconds = null, date, dice = null, squares = null, username = null, inviteLine = null,
  board = [], platform, client,
}, deps = {}) {
  const tier = modeOf(mode);
  const closingLine = pickClosingLine(result, tier, deps.rng);
  const puzzleNumber = dailyPuzzleNumber(date);
  const code = puzzleNumber && client?.rpc ? (deps.makeCode || generateShareCode)() : null;

  const { text } = buildShareMessage({ tier, result, seconds, closingLine, code, promo: deps.promo, inviteLine });

  const model = buildCardModel({
    tier, result, seconds, puzzleNumber, dateLabel: shortDateLabel(date), username, dice, squares,
    pct: result === 'forfeit' ? null : fasterThanPct(board, seconds),
  });

  let canvas = null;
  // Deliberately not reported here (share-card stays Sentry-free): no canvas
  // means a text share, which the share outcome counts record ('unsupported').
  try { canvas = (deps.render || renderShareCard)(model); } catch { canvas = null; }
  const attachPhoto = (deps.attachPhoto || ATTACH_CARD_PHOTO)[platform] === true;

  let file = null;
  if (attachPhoto) {
    try { file = await (deps.file || cardFile)(canvas); } catch { file = null; }
  } else {
    // Started now and never awaited: the upload must be done before the friend's
    // app fetches the preview, and a share must never wait on the network. A
    // late or failed upload just means the generic preview for this one share.
    Promise.resolve()
      .then(() => (deps.upload || uploadShareCard)({ client, code, canvas }))
      .catch(() => false);
  }

  const saveLink = () => (code
    ? createShareLink({
      client, tier, result, seconds, puzzleNumber, closingLine, platform, makeCode: () => code,
    })
    : Promise.resolve(null));

  return { text, code, closingLine, canvas, file, attachPhoto, saveLink };
}

/**
 * The tap: start saving the link, then open the share sheet with nothing awaited
 * in between. Never let the save's outcome reach the share.
 */
export async function sendPreparedResult(prepared, deps = {}) {
  const { text, code, closingLine, canvas, file, attachPhoto, saveLink } = prepared;
  Promise.resolve().then(saveLink).catch(() => {});
  const outcome = attachPhoto
    ? await (deps.dispatch || dispatchShare)({ canvas, text, file }, { onFailure: deps.onFailure })
    : await (deps.dispatchText || dispatchTextShare)({ text }, { onFailure: deps.onFailure });
  return { outcome, text, code, closingLine };
}
