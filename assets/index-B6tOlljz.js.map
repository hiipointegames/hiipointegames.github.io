// Password strength validation — enforced BEFORE a password is set (account
// creation, save-stats claim, password reset).
//
// Rule: at least 6 characters. Nothing else.
//
// Relaxed from "8 characters including a letter and a number" (David,
// 2026-09-17). The game stores no payment details and no personal information
// beyond a username and an email, so composition rules were buying us almost no
// security while costing real signups — every rejected password is a player who
// might not come back. Length-first with no composition rules is also what NIST
// SP 800-63B recommends, so this is the better rule on the merits, not merely
// the looser one.
//
// 6 is not arbitrary: it matches Supabase's own server-side minimum and the
// MIN_PASSWORD_LEN in transport/usernameLogin.js (which mirrors the edge
// function). Before this change the UI demanded 8 while the transport layer
// demanded 6 — three different minimums across one codebase. They now agree, so
// a password accepted by the form cannot be rejected for length by the server.
//
// NOTE: this is for NEW passwords only. It is intentionally NOT applied to the
// login/verify path (existing accounts may have shorter legacy passwords and must
// still be able to sign in).

export const MIN_PASSWORD_LEN = 6;

/**
 * @param {string} password
 * @returns {{ valid: boolean, error: string|null }}
 */
export function validatePassword(password) {
  const pw = String(password ?? '');
  if (pw.length < MIN_PASSWORD_LEN) {
    return { valid: false, error: `Password must be at least ${MIN_PASSWORD_LEN} characters` };
  }
  return { valid: true, error: null };
}
