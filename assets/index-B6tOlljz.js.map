import React, { useState, useEffect } from 'react';
import { createPortal } from 'react-dom';
import { motion } from 'framer-motion';
import { useNavigate, useLocation } from 'react-router-dom';
import { apiClient } from '@/transport';
import { createPageUrl } from '@/routing/createPageUrl';
import { playSound } from '@/ui/feedback';
import { SaveStatsModal, SecureAccountPrompt, AwardCelebrationSequence, useHomeCatchUp, badgesUrlForAwards, GuestPlacementNudge, useGuestPlacementNudge } from '@/game-flow';
import VersionChecker from '@/components/VersionChecker';
import { NotificationProvider } from '@/notifications';
import { isGuest, isNamedAccount, accountTier, guestUsername } from '@/auth';
import { UnlockSheet, UNLOCK_EVENT, lockedFeatureForPage, lockedFeatureForTab, openUnlockSheet } from '@/soft-wall';
import { setHomeLauncherIdle, useIntroSettled, AskOnceQuestion, needsContestReask } from '@/contest';
import AppDrawer from '@/components/layout/AppDrawer';
import Starfield from '@/shell/Starfield';
import { NotificationsInbox, NotificationsButton } from '@/action-center';
import { BottomNavBar, FriendsScreen, isBottomNavVisible, isHomeChromeVisible, activeNavId } from '@/home';
import { useFeatureTips, FeatureTipCard } from '@/feature-tips';
import SiteFooter, { isSiteFooterVisible } from './SiteFooter';
// Deep import, not the @/sector73 barrel: the barrel carries the Mirror overlays, which the
// entry chunk does not need (this file reaches only the switch + the unlock read).
import { useSector73PortalVisible } from '@/sector73/useSector73PortalVisible';
// By path, not the @/sector73 barrel: a tiny component, mounted only for a page Sector 73 opened.
import Sector73ReturnBar, { openedFromSector73 } from '@/sector73/boards/ReturnBar';

// sessionStorage key so the guided secure-account prompt fires at most once per
// app session (re-appears on the next launch until the account is secured).
const SECURE_PROMPT_SESSION_KEY = 'u37_secure_prompt_seen';

export default function Layout({ children, currentPageName }) {
  const [user, setUser] = useState(null);
  const [showSaveStatsModal, setShowSaveStatsModal] = useState(false);
  // The soft wall's unlock sheet: which feature the guest reached for, or null.
  const [unlockFeature, setUnlockFeature] = useState(/** @type {string | null} */ (null));
  // Guided on-entry "secure your account" prompt for a NAMED but still-unsecured
  // account (legacy username-only players). Shown once per session at the home
  // launcher; skippable (with a device-loss warning). sessionStorage guards it.
  const [showSecurePrompt, setShowSecurePrompt] = useState(false);
  // Whether the home launcher is the bare, unobstructed surface right now
  // (broadcast by the Game page). The home chrome — hamburger drawer +
  // Save-Stats — shows ONLY then: it's hidden during any gameplay overlay, the
  // solve results / celebration modal, and the pre-game modal, so it never sits
  // over a game or a modal (and the only way out of a live daily stays the
  // in-game "Forfeit & See Solves" button). Defaults visible until told otherwise.
  const [homeChromeVisible, setHomeChromeVisible] = useState(true);
  // The app-wide bottom nav bar's own state, kept HERE (parent of the bar):
  //  - friendsOpen — the Friends tab has no route; it opens the existing
  //    FriendsScreen overlay, whose open-state the bar triggers (mirroring how
  //    the top chrome triggers the Save-Stats modal via 'openSaveStats').
  //  - navSuppressed — an in-page drill-down (a live battle, a single
  //    leaderboard day owned by another lane) can force-hide the bar by
  //    dispatching a 'bottomNavChanged' { hidden: true } event, without needing
  //    to touch this file. Defaults to shown.
  const [friendsOpen, setFriendsOpen] = useState(false);
  const [navSuppressed, setNavSuppressed] = useState(false);
  // Whether the hamburger menu / app drawer is open. While it is, the bottom nav
  // bar is hidden (it sits behind the drawer and, apart from Home, its tabs aren't
  // operable there). AppDrawer reports its open state up via onOpenChange.
  const [drawerOpen, setDrawerOpen] = useState(false);
  const navigate = useNavigate();
  const location = useLocation();

  // ⚠️ THE FRIENDS OVERLAY MUST CLOSE WHEN THE APP NAVIGATES, AND THIS IS THE
  // ONLY PLACE THAT CAN GUARANTEE IT.
  //
  // David, 2026-09-17: "the view profile button definitely does not work. routes
  // nowhere currently."
  //
  // It routed perfectly. Driving it against staging showed the URL changing to
  // /OtherProfile?id=… and the profile rendering underneath — correct username,
  // country, stats, badges, all of it — while this overlay stayed open on top of
  // it. Nothing appeared to happen because nothing was visible.
  //
  // `friendsOpen` is plain state with no route of its own (the Friends tab is
  // deliberately routeless), and the ONLY thing that closed it was
  // handleNavSelect below — i.e. a tap on the bottom nav. Every other way of
  // navigating missed it: a <Link> inside the panel, a programmatic navigate(),
  // the browser back button. The close was attached to one BUTTON rather than to
  // navigation, so it worked for the one path anybody tested.
  //
  // Keying off pathname covers all of them at once. On mount this is a no-op —
  // the state already starts false — and opening the overlay does not change the
  // pathname, so it cannot close itself the moment it opens.
  useEffect(() => {
    setFriendsOpen(false);
  }, [location.pathname]);

  useEffect(() => {
    const loadUser = async () => {
      try {
        const currentUser = await apiClient.auth.me();
        setUser(currentUser);
      } catch (error) {
        console.error('Failed to load user:', error);
      }
    };
    loadUser();

    // Listen for profile updates from other components (e.g., InitialWelcomeModal)
    const handleProfileUpdate = (event) => {
      if (event.detail) {
        setUser(event.detail);
      }
    };
    window.addEventListener('userProfileUpdated', handleProfileUpdate);

    // Show/hide the home chrome as the Game page reports whether its bare
    // launcher is the active surface (hidden during gameplay / results / pre-game).
    const handleHomeChrome = (event) => {
      setHomeChromeVisible(Boolean(event.detail?.visible));
    };
    window.addEventListener('homeChromeChanged', handleHomeChrome);

    // Let any page open the Save-Stats modal (e.g. the Statistics-page banner
    // shown to a named-but-unsecured account). The modal lives here at the
    // Layout level, so pages request it via this event rather than owning it.
    const handleOpenSaveStats = () => setShowSaveStatsModal(true);
    window.addEventListener('openSaveStats', handleOpenSaveStats);

    // ⚠️ ONE ACCOUNT SCREEN, WHATEVER THE DOOR (David, 2026-09-17): "that is
    // the only page that should be seen when editing or creating or adding info
    // to an account, no matter how it is accessed."
    //
    // There were THREE forms. Edit Profile opened UsernamePrompt (username +
    // country), "Add your email" opened AddEmailPrompt (email only), and Save
    // Stats opened the real thing. So a player told "add your email" could not
    // answer the eligibility question on the screen they were sent to, and a
    // player editing their profile could not add the email — each door led to a
    // form missing the field the other one needed.
    //
    // All three now open SaveStatsModal, which hosts CreateAccountForm; that
    // form detects an already-secured account and switches to an edit mode
    // (prefilled, password optional) rather than a claim.
    //
    // Same deal for Edit Profile. It used to be
    // reachable ONLY from the hamburger drawer, which meant a screen that wanted
    // to send a player there could only NAME it — the National Average board's
    // "Add your home country in Edit Profile" note was inert text for exactly
    // that reason (David, 1.0.292). Symmetric with 'openSaveStats'.
    const handleOpenEditProfile = () => setShowSaveStatsModal(true);
    window.addEventListener('openEditProfile', handleOpenEditProfile);

    // And for adding an email to an account that has none. Same pattern again:
    // the contest banner and the Statistics page can both send a player here
    // without either of them owning the modal.
    const handleOpenAddEmail = () => setShowSaveStatsModal(true);
    window.addEventListener('openAddEmail', handleOpenAddEmail);

    // Let an in-page drill-down (a live battle, a single leaderboard day) hide
    // the bottom nav bar for an immersive surface, mirroring the homeChrome
    // signal. `{ hidden: true }` hides it; `{ hidden: false }` (or absent)
    // restores it. Inert until some page dispatches it.
    const handleBottomNav = (event) => setNavSuppressed(Boolean(event.detail?.hidden));
    window.addEventListener('bottomNavChanged', handleBottomNav);

    return () => {
      window.removeEventListener('userProfileUpdated', handleProfileUpdate);
      window.removeEventListener('homeChromeChanged', handleHomeChrome);
      window.removeEventListener('openSaveStats', handleOpenSaveStats);
      window.removeEventListener('openEditProfile', handleOpenEditProfile);
      // ⚠️ This one was MISSING — 'openAddEmail' was added with a listener and
      // no matching cleanup, so it leaked a handler on every Layout unmount.
      // Pre-existing; noticed while routing it.
      window.removeEventListener('openAddEmail', handleOpenAddEmail);
      window.removeEventListener('bottomNavChanged', handleBottomNav);
    };
  }, []);

  // Modals THIS component owns and renders over the page. Game.jsx can't see
  // them, so `homeChromeVisible` stays true underneath — without this the top
  // chrome, the bottom nav and the footer all paint on top of the open modal
  // (David, 1.0.292: a Save-Stats button and a hamburger sitting on the "Save
  // Your Stats" screen). They ride the levers that already exist: `overlayOpen`
  // for the top chrome, the nav bar's own `suppressed` for the bar and footer.
  const layoutOverlayOpen = showSaveStatsModal || showSecurePrompt || Boolean(unlockFeature);

  // ── The guest soft wall (David, 2026-10-10) ─────────────────────────────────
  // Only once the user is known: a not-yet-loaded user must not flash locks at
  // a member. Who is a guest is @/auth accountTier (username + password).
  const isGuestTier = user != null && accountTier(user) === 'guest';
  // A guest on a locked page (an old link, a deep link): render nothing there
  // and send them home with the unlock sheet — never a flash of the page.
  const guardedFeature = isGuestTier ? lockedFeatureForPage(currentPageName) : null;

  // The home chrome (hamburger + Save-Stats) shows only on the Game home screen
  // AND only when its bare launcher is unobstructed (not gameplay, not a modal).
  const showHomeChrome = isHomeChromeVisible({
    currentPageName,
    homeChromeVisible,
    overlayOpen: layoutOverlayOpen,
  });

  // App-wide bottom nav bar (home redesign "Option A"). Shown on EVERY routed
  // surface by default — only a named few opt out (ResetPassword, HowToPlay),
  // plus Game while gameplay is up (riding the same homeChromeVisible gate as
  // the top chrome), the open drawer, and in-page drill-downs that suppress it.
  // Active tab follows the route, or Friends when its overlay is open.
  // See @/home bottomNavVisibility for the full rule and its rationale.
  // A Layout-owned modal suppresses the bar the same way an in-page drill-down
  // does: BottomNavBar portals to <body> at z-index 140, far above the modals'
  // z-50, so without this it floats over an open "Save Your Stats" screen.
  // THE BELL SWAP (David, 2026-10-20): the "To Sector 73" portal holds the home's top-left
  // corner, where the bell sat over it. While the portal shows, the bell leaves the corner
  // and the ☰ carries the count (AppDrawer `menuBadge`); its menu already has Notifications.
  // Same rule as the portal itself (@/sector73 useSector73PortalVisible). Asked only on the
  // Game page, so other routes make no Sector 73 read; leaving Game (e.g. into /Sector73
  // after the warp) and coming back re-reads the unlock, so a fresh unlock moves the bell.
  // Switch OFF, a guest, or a locked member: false, and the chrome is exactly as before.
  const portalVisible = useSector73PortalVisible(currentPageName === 'Game' ? user : null);
  // A page Sector 73 opened shows its own "Back to Sector 73" bar instead of the nav (world lane
  // 2026-10-22). Decided here, not by an event from the bar: a child's effect runs before this
  // component subscribes, so the event would be lost (the same trap as Layout.sector73Nav.test).
  const from73 = openedFromSector73(location.state);
  const navVisible = isBottomNavVisible({ currentPageName, homeChromeVisible, suppressed: navSuppressed || layoutOverlayOpen || from73, drawerOpen });
  const navActiveId = activeNavId({ currentPageName, friendsOpen });

  // R1 — catch up on Home. `showHomeChrome` is already the exact condition the
  // ruling names: the Game page's bare launcher, with nothing over it, INCLUDING
  // the modals Layout owns and Game.jsx cannot see. Recomputing that here would
  // be a second copy of a seven-input negation that has been wrong once already
  // (David, 2026-07-11), and hosting it here rather than in Game.jsx is what
  // keeps that page at its arch-ratchet baseline — it has zero headroom.
  //
  // The three-dailies pop-up goes FIRST (David, 2026-10-05). Layout reports the
  // bare launcher to it, and the catch-up and secure prompt below wait until it
  // has decided or been closed — otherwise all three could stack at app open.
  // `showHomeChrome` itself is untouched: the chrome must not flicker off for
  // the few hundred ms the pop-up spends deciding, on every launch, for ever.
  useEffect(() => { setHomeLauncherIdle(showHomeChrome); }, [showHomeChrome]);
  useEffect(() => () => setHomeLauncherIdle(false), []);
  const introSettled = useIntroSettled(showHomeChrome);
  const homeIdle = showHomeChrome && introSettled;
  // The one-time 18+/US question for existing members (David, 2026-10-10):
  // after the pop-up, before the catch-up and the secure prompt, so nothing
  // stacks. Answering writes a fresh confirmed_at, which ends needsContestReask
  // for good; the local flag just closes it instantly.
  const [askOnceAnswered, setAskOnceAnswered] = useState(false);
  const askOnceOpen = Boolean(user) && !askOnceAnswered && homeIdle && needsContestReask(user);
  const catchUp = useHomeCatchUp({ user, active: homeIdle && !askOnceOpen });

  // Web-only site footer (see SiteFooter.jsx). Rides the same signals as the nav
  // bar so the two never disagree about whether a surface is "gameplay".
  const footerVisible = isSiteFooterVisible({ currentPageName, homeChromeVisible, suppressed: navSuppressed || layoutOverlayOpen, drawerOpen });

  const handleNavSelect = (tab) => {
    playSound('buttonTap');
    // Locked tabs open the unlock sheet for a guest instead of navigating.
    const lockedFeature = isGuestTier ? lockedFeatureForTab(tab.id) : null;
    if (lockedFeature) {
      setFriendsOpen(false);
      openUnlockSheet(lockedFeature);
      return;
    }
    if (tab.page === null) {
      // Friends has no route — open the existing FriendsScreen overlay instead.
      setFriendsOpen(true);
      return;
    }
    // Kept even though the pathname effect above now also closes it: this fires
    // synchronously with the tap, so the panel does not linger for a frame while
    // the route resolves. Belt and braces, not duplication.
    setFriendsOpen(false);
    navigate(createPageUrl(tab.page));
  };

  // Guided secure-account prompt: fire once per session, only at the bare home
  // launcher, and only for a NAMED but unsecured account (a legacy username-only
  // player with stats to protect — not a fresh guest, not a secured user).
  useEffect(() => {
    if (!user || !homeIdle || askOnceOpen) return;
    if (isGuest(user) && isNamedAccount(user) && !sessionStorage.getItem(SECURE_PROMPT_SESSION_KEY)) {
      setShowSecurePrompt(true);
      sessionStorage.setItem(SECURE_PROMPT_SESSION_KEY, '1');
    }
  }, [user, homeIdle, askOnceOpen]);

  // First-week tips (2026-10-20) — LAST in the Home chain: only once the pop-up,
  // AskOnce, the catch-up (open OR still reading) and the secure prompt are all
  // clear. Saved accounts only, behind the `feature_tips` switch (@/feature-tips).
  const openFriends = React.useCallback(() => setFriendsOpen(true), []);
  const tips = useFeatureTips({
    user,
    active: homeIdle && !askOnceOpen && !catchUp.isOpen && !catchUp.busy && !showSecurePrompt,
    navigate,
    openFriends,
  });

  // A returning guest's "you would have placed #N" nudge, after their first
  // Daily of the day closes (rules: @/game-flow guestNudgeRules).
  // Waits for Home to be free so it never stacks on the intro (days 1–3), the
  // 18+ question, the catch-up, the secure prompt or a tip.
  const guestNudge = useGuestPlacementNudge(
    user,
    homeIdle && !askOnceOpen && !catchUp.isOpen && !catchUp.busy && !showSecurePrompt && !tips.open,
  );

  // Anyone can ask for the unlock sheet (podium card, locked links…).
  useEffect(() => {
    const onUnlock = (e) => setUnlockFeature(e?.detail?.feature || 'leaderboards');
    window.addEventListener(UNLOCK_EVENT, onUnlock);
    return () => window.removeEventListener(UNLOCK_EVENT, onUnlock);
  }, []);

  // A guest who lands on a locked page goes home, with the sheet explaining why.
  useEffect(() => {
    if (!guardedFeature) return;
    navigate(createPageUrl('Game'), { replace: true });
    setUnlockFeature(guardedFeature);
  }, [guardedFeature, navigate]);

  return (
    <NotificationProvider>
      <div className="relative app-min-h-shell w-full m-0 p-0">
        {/* App-wide animated starfield — one mount for every routed page (each
            page renders transparent-rooted so it shows through). Fixed, z-0,
            pointer-events:none; the content wrapper below sits at z-[1]. The
            game page used to mount its own copy — now deduped here. */}
        <Starfield />
        <VersionChecker />
        {/* Top Buttons — home-only, and hidden during an in-progress daily.
            PORTALED TO document.body: the clusters are `position: fixed`, but
            `#root` (their normal ancestor) is a momentum-scroll container
            (`overflow-y:auto` + `-webkit-overflow-scrolling:touch`, index.css).
            On Android WebView / iOS the touch-scroll layer PAINTS fixed
            descendants into the scrolling surface, so they rode the page down
            even though they pin correctly on desktop (David, 2026-07-13 — the
            `absolute→fixed` fix in c8b1485 cured web but not device). Rendering
            them as children of <body> — OUTSIDE that scroll container — pins them
            to the true viewport on device. The `showHomeChrome` gate is
            unchanged, so they still mount ONLY on the bare Game launcher and
            never bleed onto other screens / over overlays. */}
        {showHomeChrome && createPortal(
          <>
            {/* Top-left corner: just the notifications bell now. The blue Save
                Stats pill that sat above it was REMOVED (David, 2026-10-10) — the
                guided signup made it redundant: guests reach signup from the
                Welcome screen, locked tabs / the unlock sheet, the teaser chip,
                the results card and the menu's "Create free account". */}
            <div
              data-testid="home-chrome-left"
              className="fixed left-4 sm:left-6 z-50 flex flex-col items-start gap-2"
              style={{ top: '60px' }}
            >
              {/* Notifications (David, 2026-07-11): a compact but
                  HYPER-VISIBLE magenta neon bell — filled gradient, ringing wiggle,
                  strong breathing glow, bold count badge — so players never miss it
                  (it replaces the old friends-page bell). Compact enough to clear
                  the gold "37". Renders nothing when there's nothing pending. */}
              {!portalVisible && <NotificationsButton scope="home" />}
            </div>

            {/* Right Side Button */}
            <div
              data-testid="home-chrome-right"
              className="fixed right-4 sm:right-6 z-50"
              style={{ top: '60px' }}
            >
              <AppDrawer
                onEditProfileClick={() => setShowSaveStatsModal(true)}
                onSaveStatsClick={() => setShowSaveStatsModal(true)}
                onOpenChange={setDrawerOpen}
                menuBadge={portalVisible}
              />
            </div>
          </>,
          document.body,
        )}

        {/* Page Content — sits above the starfield (z-[1]). Pages render with
            transparent roots so the global starfield shows through. */}
        <div className="relative z-[1]">{guardedFeature ? null : children}</div>

        {/* Web-only footer, in normal flow at the end of the content column (NOT
            fixed — it must never stack against the fixed bottom nav bar). It
            carries the crawlable links to the standalone how-to/privacy/terms
            pages, which the rendered DOM otherwise never links to. Hidden on
            gameplay surfaces. No-op on native. */}
        {footerVisible && <SiteFooter />}

        {/* App-wide bottom nav bar (home redesign "Option A"). Portals itself to
            <body> and hides during gameplay; the four route tabs navigate, and
            the Friends tab opens the overlay below. */}
        {/* A 37 page opened from Sector 73 (Observatory, Flight Log…): one big way back, and the nav
            hidden while it shows. Only for that route state, so every other visit is unchanged. */}
        {from73 && <Sector73ReturnBar />}

        {navVisible && (
          <BottomNavBar
            activeId={navActiveId}
            onSelect={handleNavSelect}
            lockedIds={isGuestTier ? ['blitz', 'board', 'stats', 'friends'] : []}
          />
        )}

        {/* Friends & Players overlay — owned here (not in the home body) so the
            bottom-bar Friends tab can trigger it from any top-level surface.
            Reuses the existing FriendsScreen as-is; mounts its heavy
            FriendsSection only while open. */}
        <FriendsScreen isOpen={friendsOpen} onClose={() => setFriendsOpen(false)} />

        {/* Notifications inbox — one shared modal, opened from the Home bell or
            the hamburger "Notifications" item (Notifications are home-only; not
            surfaced inside the Blitz Colosseum). */}
        <NotificationsInbox />

        {/* Username Prompt */}

        {/* Guided secure-account prompt (legacy named accounts). Securing routes
            into the same Save-Stats flow; skipping requires acknowledging the
            device-loss warning first. */}
        <SecureAccountPrompt
          isOpen={showSecurePrompt}
          onSecure={() => { setShowSecurePrompt(false); setShowSaveStatsModal(true); }}
          onSkip={() => setShowSecurePrompt(false)}
        />

        {/* Add Email — for a credentialed account with no reachable address.
            Re-reads the user on close because the email may have just changed,
            and the contest prompt keys off exactly that. */}

        {/* Anything earned but never announced, shown the next time the player
            lands on Home (R1). It renders through the SAME sequence as every
            other celebration — and therefore hides the bottom nav while it is
            up, via celebrationChrome — so a caught-up moment is indistinguishable
            from one that fired on the spot. `summaryOnly` is the first-run case:
            one screen for a backlog, never a slideshow. */}
        <AwardCelebrationSequence
          awards={catchUp.awards}
          isOpen={catchUp.isOpen}
          summaryOnly={catchUp.summaryOnly}
          onComplete={catchUp.onComplete}
          // Leaving early drains the WHOLE queue (records it), then deep-links
          // to the step's badges. A guest is turned into the unlock sheet by the
          // page guard below, like any other link to a locked page.
          onSeeBadges={(stepAwards) => { catchUp.onComplete(); navigate(badgesUrlForAwards(stepAwards)); }}
        />

        {/* Returning guest's placement nudge — portals itself to <body>. */}
        <GuestPlacementNudge open={guestNudge.open} copy={guestNudge.copy} onClose={guestNudge.close} />

        {/* First-week tip / What's new — portals itself to <body>. */}
        {tips.open && (
          <FeatureTipCard tip={tips.tip} extraLine={tips.extraLine} onGo={tips.onGo} onDismiss={tips.onDismiss} />
        )}

        {askOnceOpen && (
          <AskOnceQuestion
            username={user?.username ?? user?.user_metadata?.username ?? null}
            onAnswered={() => setAskOnceAnswered(true)}
          />
        )}

        {unlockFeature && (
          <UnlockSheet
            feature={unlockFeature}
            username={guestUsername(user)}
            onClose={() => setUnlockFeature(null)}
            onCreate={() => { setUnlockFeature(null); setShowSaveStatsModal(true); }}
          />
        )}

        {/* Save Stats Modal */}
        <SaveStatsModal
          isOpen={showSaveStatsModal}
          onClose={(saved) => {
            setShowSaveStatsModal(false);
            // The three-dailies pop-up listens: when it handed a player to this
            // form, it re-reads them and, if now entered, shows "You're in".
            // It re-reads rather than trusting `saved` — the X button passes
            // its click event here, which is truthy.
            window.dispatchEvent(new CustomEvent('saveStatsClosed'));
            if (saved) {
              // Reload user to update state
              apiClient.auth.me().then(setUser).catch(console.error);
            }
          }}
          // The guided signup's "That name is taken — it's mine, log in".
          onLogin={() => {
            setShowSaveStatsModal(false);
            navigate('/login', { state: { allowLogin: true } });
          }}
        />
      </div>
    </NotificationProvider>
  );
}