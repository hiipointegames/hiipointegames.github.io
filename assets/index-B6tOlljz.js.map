// podiumCatchUp — "you placed 2nd in Expert on Sunday".
//
// ─────────────────────────────────────────────────────────────────────────────
// IT IS A READ. IT WILL STAY A READ.
// ─────────────────────────────────────────────────────────────────────────────
// 🔴 There used to be a write path for podiums and it was a disaster. The
// deleted `award-daily-podiums` endpoint was UNAUTHENTICATED, non-idempotent and
// `CORS: *`, and its cron was dead. Worse, the client-side backfill beside it
// scanned the 5 most recent "unawarded" dates but only marked a date awarded on
// a WIN — so a non-winning day jammed the 5-slot window forever and older wins
// were never reached. The more you played, the more you lost: the heaviest
// player was short 31 medals. Measured on prod, players had EARNED 238 medals,
// the UI showed 182, and the cron's store held 12.
//
// Deriving on read fixed all of it in one move and restored every missing medal
// with no backfill (2026-07-17, supabase/functions/_shared/podiumFinishes.ts).
// A celebration is a read concern. Do not add a table, a cron, or an endpoint
// here — this file exists partly to say so where someone would look.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT CAN ONLY EVER BE A CATCH-UP
// ─────────────────────────────────────────────────────────────────────────────
// A day's podium is not decided until that day ends at midnight Eastern. An 8am
// solve can be the fastest time in the world until someone beats it at 3pm, so
// celebrating at solve time would show a medal and then silently take it away —
// worse than showing nothing. `computePodiumFinishes` already refuses to count
// today for exactly this reason. So the earliest honest moment to celebrate a
// placement on date D is D+1, which means there is no post-solve moment to
// attach to and this rides the Home catch-up path or nothing.
//
// ⚠️ Three Dailies means THREE podiums a day, so one date can produce up to
// three events and every identity is keyed by (date, mode).

import { getOwnDailyCompletions, getLeaderboard, comparePodiumOrder, DEFAULT_DAILY_MODE } from '@/stats-aggregation';

/** How many CLOSED days back a Home visit looks. David's ruling, 2026-09-05. */
export const PODIUM_WINDOW_DAYS = 7;

/**
 * The window to search, as `[since, before)`.
 *
 * `before` is today's ET date and the bound is EXCLUSIVE, which is the game rule
 * rather than a preference — see this file's header, and the docblock on
 * `computePodiumFinishes`, which spells out the same guard server-side.
 *
 * Dates are ISO `YYYY-MM-DD`, so the arithmetic is done in UTC on the calendar
 * parts and never through a local `Date` — a local-midnight parse shifts the day
 * for anyone west of Greenwich, which is most of this game's players.
 *
 * @param {string} today ET date, 'YYYY-MM-DD'
 * @param {number} [days]
 * @returns {{since: string, before: string}}
 */
export function podiumWindow(today, days = PODIUM_WINDOW_DAYS) {
  const [y, m, d] = String(today || '').split('-').map(Number);
  if (!y || !m || !d) return { since: '', before: '' };
  const start = new Date(Date.UTC(y, m - 1, d - Math.max(1, days)));
  return { since: start.toISOString().slice(0, 10), before: today };
}

/**
 * Rank one (date, mode) board and return the top three distinct user ids.
 *
 * ⚠️ A DELIBERATE CLIENT MIRROR of `rankDate` in
 * supabase/functions/_shared/podiumFinishes.ts, not an import of it — that file
 * is Deno and this is browser ESM, the same reason `modeKeys.js` mirrors
 * `dailyCoverage.ts` rather than importing it. The two are pinned function-for-
 * function by podiumCatchUp.drift.test.js, which DOES import the Deno source.
 *
 * The ORDER comes from `comparePodiumOrder` (@/stats-aggregation), the same
 * comparator `getLeaderboard` now sorts with — the tie-break rule must exist
 * exactly once or the medal and the rank on screen drift apart, which is the bug
 * documented in podiumOrder.js. What this adds on top is the podium's own three
 * rules: a non-completion is not a race run, a player occupies only their best
 * slot, and only the top three place.
 *
 * @param {Array<{user_id?: string, solve_time_seconds?: number|null, created_at?: string|null}>} rows
 * @returns {string[]} up to three user ids, best first
 */
export function rankDailyBoard(rows) {
  const completions = (rows || []).filter(
    (r) => r && typeof r.solve_time_seconds === 'number' && r.solve_time_seconds > 0,
  );

  completions.sort(comparePodiumOrder);

  const top = [];
  const seen = new Set();
  for (const row of completions) {
    if (!row.user_id || seen.has(row.user_id)) continue;
    seen.add(row.user_id);
    top.push(row.user_id);
    if (top.length >= 3) break;
  }
  return top;
}

/**
 * The distinct (date, mode) races this player finished, newest first.
 * @param {Array<{date?: string, mode?: string|null}>} completions
 * @returns {Array<{date: string, mode: string}>}
 */
export function racesEntered(completions) {
  const byBucket = new Map();
  for (const row of completions || []) {
    if (!row?.date) continue;
    const mode = row.mode || DEFAULT_DAILY_MODE;
    byBucket.set(`${row.date}\t${mode}`, { date: row.date, mode });
  }
  // Newest first: three individual screens is the cap, and the most recent
  // placements are the ones that still read as news rather than as history.
  return [...byBucket.values()].sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
}

/**
 * Every podium placement in the window, as award objects.
 *
 * @param {Object} args
 * @param {string} args.userId
 * @param {string} args.today ET date
 * @param {number} [args.windowDays]
 * @param {Object} [deps] injected for tests; production callers pass nothing
 * @returns {Promise<{awards: Array<{kind: 'podium', date: string, mode: string, rank: number}>, complete: boolean}>}
 *   `complete` is false when ANY read failed. The caller must not seal a first
 *   run on an incomplete answer — sealing a placement that was never checked
 *   marks it announced forever, and sealing nothing when there was something
 *   means the next visit announces a week of placements at once.
 */
export async function collectPodiumAwards({ userId, today, windowDays = PODIUM_WINDOW_DAYS }, deps = {}) {
  const {
    readCompletions = getOwnDailyCompletions,
    readBoard = ({ date, mode }) => getLeaderboard({ date, mode }),
  } = deps;

  if (!userId || !today) return { awards: [], complete: false };
  const { since, before } = podiumWindow(today, windowDays);
  if (!since) return { awards: [], complete: false };

  let races;
  try {
    races = racesEntered(await readCompletions({ userId, since, before }));
  } catch {
    return { awards: [], complete: false };
  }

  const awards = [];
  let complete = true;
  for (const race of races) {
    try {
      // Sequential, not parallel: a typical window holds one to three races and
      // this runs on a screen that should feel instant. Three concurrent
      // full-board reads is a worse spike than three cheap ones in a row.
      const placing = rankDailyBoard(await readBoard(race)).indexOf(userId);
      if (placing >= 0) awards.push({ kind: /** @type {'podium'} */ ('podium'), ...race, rank: placing + 1 });
    } catch {
      // One dead board must not cost the player the other days' placements —
      // but it does mean we cannot honestly claim to have checked everything.
      complete = false;
    }
  }

  return { awards, complete };
}
