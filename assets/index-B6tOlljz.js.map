// Every player-facing word of "Did a friend invite you?", in one place.
//
// Source: .workshop/copy-tips-referrals-2026-10.md sections 2–4 (David's draft,
// 2026-10-20). Edit the wording HERE, nowhere else.

/** Copy for every reason the server can give (claim_referral). */
export const REFERRAL_MESSAGES = {
  not_found: 'No player with that username. Check the spelling.',
  self: "That's your own username.",
  already: "You've already named the friend who invited you.",
  too_late: 'Invites can only be added in your first 7 days.',
  guest: 'Save your account first, then add who invited you.',
  cannot_earn: "That player can't earn bonus entries.",
  not_signed_in: 'Sign in first.',
  network: "Couldn't reach the server. Check your connection and try again.",
};

/** What a successful claim says. */
export const referralSavedMessage = (username) =>
  `Thanks! @${username} gets 2 bonus entries once you finish a Daily that earns an entry.`;

export const REFERRAL_COPY = Object.freeze({
  // Guided signup — the optional step after Email.
  stepTitle: 'Did a friend invite you?',
  stepBody: 'Type their 37 username and they get 2 bonus entries when you play your first Daily.',
  stepLabel: 'Their username',
  stepPlaceholder: 'username',
  // Shown on the Done screen when the claim did not go through.
  fixInProfile: 'You can add it in your profile.',

  // Profile (Edit Profile), for the first 7 days of an account.
  profileTitle: 'Invited by a friend?',
  profileLead: 'Add their username:',
  profileSave: 'Save',
  profileSaving: 'Saving…',
  /** @param {string} date already formatted for the player's locale */
  profileUntil: (date) => `You can do this until ${date}.`,
  /** @param {string} name */
  invitedBy: (name) => `Invited by @${name}`,
});

/** The line added to the Daily share text while referrals are on. */
export const referralShareLine = (username) =>
  `New to 37? Enter my username @${username} when you sign up.`;

/** The tail on the entries line when friends earned bonus entries this week. */
export const referralBonusSuffix = (n) => (n > 0 ? ` · +${n} from friends` : '');

/**
 * "Oct 31" in the player's own locale, from the server's claim_until.
 * @param {string|null} iso
 * @param {string|string[]} [locale] defaults to the device's
 * @returns {string|null}
 */
export function formatClaimUntil(iso, locale) {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString(locale, { month: 'short', day: 'numeric' });
}
