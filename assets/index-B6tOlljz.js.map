import React, { useEffect, useState } from 'react';
import { createPortal } from 'react-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { Bell, Swords, UserPlus, Zap, ChevronRight, X } from 'lucide-react';
import { useNavigate } from 'react-router-dom';
import { useQueryClient } from '@tanstack/react-query';
import { createPageUrl } from '@/routing/createPageUrl';
import { playSound } from '@/ui/feedback';
import { getProfilesByIds, acceptFriendRequest, rejectFriendRequest } from '@/player';
import {
  acceptBattleInvite, declineBattleInvite, perspectiveOf,
  BLITZ_TIER_LABEL, normalizeBlitzMode,
} from '@/head-to-head';

/**
 * The name of the tier a battle row is in: "Easy" / "Challenge" / "Expert".
 *
 * 🔴 THIS EXISTS BECAUSE OF A BUG DAVID PHOTOGRAPHED (2026-09-11). Three places
 * in this file wrote `blitz_mode === 'challenge' ? 'Challenge' : 'Easy'`, which
 * has two branches for a column with three values — so the Expert battle he had
 * just played was announced as "Easy battle · they solved 3".
 *
 * `normalizeBlitzMode` is not decoration: these rows come from the database,
 * where `blitz_mode` may be null on a legacy battle or a value a newer build
 * wrote. Normalising makes an unknown tier read as Easy — the documented
 * default — rather than as "undefined battle".
 *
 * @param {string|null|undefined} blitzMode
 * @returns {string}
 */
const battleTierLabel = (blitzMode) => BLITZ_TIER_LABEL(normalizeBlitzMode(blitzMode));
import { usePendingActions, PENDING_ACTIONS_QUERY_KEY } from './usePendingActions';
import { useInboxState, closeInbox } from './inboxStore';

// The Notifications inbox — one shared modal (mounted once at the Layout root)
// that lists every actionable item with WHO it involves. Opened by the Home
// button, the Colosseum button, and the hamburger item via the inboxStore.
// `scope==='colosseum'` shows battle items only.
//
// Slice 3: friend requests + battle invites are resolved INLINE (Accept /
// Decline right in the inbox, reusing the same @/player + @/head-to-head write
// paths as the Friends panel + Colosseum list). After each mutation we
// invalidate PENDING_ACTIONS_QUERY_KEY so the resolved row disappears. The
// your-move row still routes out (to the Colosseum today; to N's Blitz Battles
// swipeable tab once N exists).

const MAGENTA = 'var(--u37-magenta)';
const GREEN = 'var(--u37-green)';

// A route-out row (your-move): the whole row is a single tap target.
function Row({ accent, icon, title, subtitle, onClick, testId }) {
  return (
    <button
      onClick={onClick}
      data-testid={testId}
      className="w-full flex items-center gap-3 rounded-xl border px-3 py-3 text-left transition-all touch-manipulation active:scale-[0.99] min-h-[52px]"
      style={{
        borderColor: `color-mix(in srgb, ${accent} 45%, transparent)`,
        background: `color-mix(in srgb, ${accent} 10%, transparent)`,
      }}
    >
      <span style={{ color: accent }}>{icon}</span>
      <span className="flex-1 min-w-0">
        <span className="block text-sm font-black truncate" style={{ color: accent }}>{title}</span>
        {subtitle && <span className="block text-xs text-slate-300 truncate">{subtitle}</span>}
      </span>
      <ChevronRight className="w-4 h-4 flex-shrink-0" style={{ color: accent }} />
    </button>
  );
}

// An inline-resolve row (friend request / battle invite): title + subtitle on
// top, Accept / Decline buttons below. Not a <button> wrapper — nested buttons
// are invalid — so the container is a <div>.
function ActionRow({ accent, icon, title, subtitle, onAccept, onDecline, busy, testId }) {
  return (
    <div
      data-testid={testId}
      className="w-full rounded-xl border px-3 py-3 transition-all"
      style={{
        borderColor: `color-mix(in srgb, ${accent} 45%, transparent)`,
        background: `color-mix(in srgb, ${accent} 10%, transparent)`,
      }}
    >
      <div className="flex items-center gap-3">
        <span style={{ color: accent }}>{icon}</span>
        <span className="flex-1 min-w-0">
          <span className="block text-sm font-black truncate" style={{ color: accent }}>{title}</span>
          {subtitle && <span className="block text-xs text-slate-300 truncate">{subtitle}</span>}
        </span>
      </div>
      <div className="flex gap-2 mt-2.5">
        <button
          onClick={onAccept}
          disabled={busy}
          data-testid={`${testId}-accept`}
          className="flex-1 rounded-lg py-2 text-xs font-black uppercase tracking-wide transition-all touch-manipulation active:scale-[0.98] min-h-[40px] disabled:opacity-50"
          style={{
            color: GREEN,
            border: `1px solid color-mix(in srgb, ${GREEN} 55%, transparent)`,
            background: `color-mix(in srgb, ${GREEN} 16%, transparent)`,
          }}
        >
          Accept
        </button>
        <button
          onClick={onDecline}
          disabled={busy}
          data-testid={`${testId}-decline`}
          className="flex-1 rounded-lg py-2 text-xs font-bold uppercase tracking-wide text-slate-300 border border-white/15 bg-white/[0.04] transition-all touch-manipulation active:scale-[0.98] min-h-[40px] hover:bg-white/[0.08] disabled:opacity-50"
        >
          Decline
        </button>
      </div>
    </div>
  );
}

export default function NotificationsInbox() {
  const { open, scope } = useInboxState();
  const { friendRequests, battleInvites, yourMoveBattles, userId } = usePendingActions();
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [names, setNames] = useState({});
  const [busy, setBusy] = useState({});
  // After accepting a battle invite, offer to jump straight into it rather than
  // dead-ending in the inbox (Bryce, 1.0.251: "accepted the battle but wasn't
  // taken to the battle screen"). Holds the accepted invite's summary while the
  // "Go to Battle / Stay" prompt is shown; null = no prompt.
  const [accepted, setAccepted] = useState(null);

  const showFriends = scope === 'home';
  const friends = showFriends ? friendRequests : [];

  // Resolve usernames for everyone involved (best-effort; a missing profile falls
  // back to "a player"). Runs when the inbox opens or its item set changes.
  useEffect(() => {
    if (!open) return undefined;
    let cancelled = false;
    const ids = new Set(friends);
    for (const c of [...battleInvites, ...yourMoveBattles]) {
      ids.add(c.challenger_id); ids.add(c.opponent_id);
    }
    ids.delete(undefined); ids.delete(null);
    if (ids.size === 0) { setNames({}); return undefined; }
    getProfilesByIds([...ids])
      .then((map) => {
        if (cancelled) return;
        const next = {};
        for (const id of ids) next[id] = map.get(id)?.username || 'a player';
        setNames(next);
      })
      .catch(() => { if (!cancelled) setNames({}); });
    return () => { cancelled = true; };
    // item identity is captured by the joined id string
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [open, friends.join(','), battleInvites.map(c => c.id).join(','), yourMoveBattles.map(c => c.id).join(',')]);

  const nameOf = (id) => names[id] || 'a player';
  const total = friends.length + battleInvites.length + yourMoveBattles.length;

  // Your-move: deep-link to that battle's PRE-BATTLE screen (never a running
  // game) via ?challenge=<id>&from=<origin>. The origin decides where "Not Now"
  // returns — the Home inbox (scope 'home') → back Home; the Colosseum inbox →
  // the Colosseum Battles tab.
  const goYourMove = (challengeId) => {
    playSound('buttonTap');
    closeInbox();
    const from = scope === 'colosseum' ? 'colosseum' : 'home';
    navigate(`${createPageUrl('HeadToHead')}?challenge=${encodeURIComponent(challengeId)}&from=${from}`);
  };

  // Run an inline Accept/Decline write, then invalidate the shared pending-actions
  // query so the resolved row drops out. `key` is per-item so a double-tap on one
  // row can't fire twice, while a different row stays interactive. Failures are
  // swallowed (logged) — the row simply stays until the next refetch.
  const runMutation = async (key, fn) => {
    if (busy[key]) return;
    playSound('buttonTap');
    setBusy((b) => ({ ...b, [key]: true }));
    try {
      await fn();
      await queryClient.invalidateQueries({ queryKey: PENDING_ACTIONS_QUERY_KEY });
    } catch (e) {
      console.error('[NotificationsInbox] action failed', e);
    } finally {
      setBusy((b) => { const next = { ...b }; delete next[key]; return next; });
    }
  };

  // Accept a battle invite, then surface the "Go to Battle / Stay" prompt so the
  // player can start the battle they just accepted (Decline needs no prompt — it
  // just resolves the row and keeps them in the inbox via runMutation alone).
  const acceptInvite = (c) =>
    runMutation(`inv-${c.id}`, async () => {
      await acceptBattleInvite(c.id);
      setAccepted({ name: nameOf(c.challenger_id), mode: c.blitz_mode });
    });

  // "Go to Battle": leave the inbox for the Colosseum Battles tab (the carousel's
  // default slide), where the just-accepted battle is waiting to be started.
  const goToAcceptedBattle = () => {
    playSound('buttonTap');
    setAccepted(null);
    closeInbox();
    navigate(createPageUrl('HeadToHead'));
  };

  // Portal to <body>: this inbox is rendered inline at the Layout root, inside
  // the `relative z-[1]` content stacking context — which TRAPS its z-[120] below
  // the home chrome (bell/hamburger) that Layout portals to <body> at z-50, so the
  // hamburger floated OVER the open inbox (#6). Rendering at the body root lets the
  // z-[120] sit above the z-50 chrome (same fix FriendsScreen uses at z-[130]).
  return createPortal((
    <AnimatePresence>
      {open && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={closeInbox}
          data-testid="notifications-inbox"
          className="fixed inset-0 z-[120] flex items-start justify-center p-4 pt-[10vh] u37-ad-safe-pb bg-black/70 backdrop-blur-sm"
        >
          <motion.div
            initial={{ scale: 0.92, opacity: 0, y: -20 }}
            animate={{ scale: 1, opacity: 1, y: 0 }}
            exit={{ scale: 0.92, opacity: 0, y: -20 }}
            transition={{ type: 'spring', damping: 22, stiffness: 280 }}
            onClick={(e) => e.stopPropagation()}
            className="relative w-full max-w-md rounded-3xl border-2 p-5 overflow-y-auto"
            style={{
              maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 4rem)',
              background: 'var(--u37-panel-bg)',
              borderColor: `color-mix(in srgb, ${MAGENTA} 50%, transparent)`,
              boxShadow: `0 0 44px -14px ${MAGENTA}, 0 20px 70px rgba(0,0,0,0.6)`,
            }}
          >
            <button
              onClick={closeInbox}
              aria-label="Close notifications"
              data-testid="notifications-inbox-close"
              className="absolute top-3 right-3 p-1.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-white/[0.06] transition-colors touch-manipulation"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="flex items-center justify-center gap-2 mb-4">
              <Bell className="w-5 h-5" style={{ color: MAGENTA }} />
              <h2 className="text-lg font-black uppercase tracking-[0.15em]" style={{ color: MAGENTA }}>
                Notifications
              </h2>
            </div>

            {accepted ? (
              // Post-accept prompt: don't dead-end — offer to jump into the battle.
              <div data-testid="battle-accepted-prompt" className="text-center py-4">
                <Swords className="w-10 h-10 mx-auto mb-2" style={{ color: MAGENTA }} />
                <h3 className="text-lg font-black" style={{ color: MAGENTA }}>Battle accepted!</h3>
                <p className="text-sm text-slate-300 mt-1 mb-5">
                  You accepted {accepted.name}&apos;s {battleTierLabel(accepted.mode)} battle. Head to the Colosseum to play it now?
                </p>
                <button
                  onClick={goToAcceptedBattle}
                  data-testid="battle-accepted-go"
                  className="w-full rounded-xl py-3 font-black text-[#04121a] touch-manipulation active:scale-[0.98]"
                  style={{ background: MAGENTA, boxShadow: `0 0 22px -7px ${MAGENTA}` }}
                >
                  Go to Battle
                </button>
                <button
                  onClick={() => setAccepted(null)}
                  data-testid="battle-accepted-stay"
                  className="w-full rounded-xl py-2.5 mt-2 text-sm font-bold text-slate-300 border border-white/15 bg-white/[0.04] hover:bg-white/[0.08] transition-colors touch-manipulation active:scale-[0.98]"
                >
                  Stay in Notifications
                </button>
              </div>
            ) : total === 0 ? (
              <p className="text-center text-sm text-slate-400 py-6">You&apos;re all caught up. 🎉</p>
            ) : (
              <div className="space-y-2">
                {battleInvites.map((c) => (
                  <ActionRow
                    key={`inv-${c.id}`}
                    testId="inbox-battle-invite"
                    accent={MAGENTA}
                    icon={<Swords className="w-5 h-5" />}
                    title={`${nameOf(c.challenger_id)} challenged you`}
                    subtitle={`${battleTierLabel(c.blitz_mode)} battle`}
                    busy={!!busy[`inv-${c.id}`]}
                    onAccept={() => acceptInvite(c)}
                    onDecline={() => runMutation(`inv-${c.id}`, () => declineBattleInvite(c.id))}
                  />
                ))}
                {yourMoveBattles.map((c) => {
                  // Enrich the your-move row with WHICH battle this is and the
                  // score the opponent set — so "your move vs Chandler" says what
                  // kind of battle and what you're chasing, not just "your
                  // opponent finished" (David, 2026-07-13).
                  //
                  // 🔴 THIS LINE IS THE ONE DAVID PHOTOGRAPHED. It read
                  // `=== 'challenge' ? 'Challenge' : 'Easy'`, so the Expert
                  // battle he had just played was announced as "Easy battle ·
                  // they solved 3". `blitz_mode` has three values; this had two
                  // branches. See BlitzModeBadge for the other five sites.
                  const { opponentId, opponentResult } = perspectiveOf(c, userId);
                  const typeLabel = battleTierLabel(c.blitz_mode);
                  const oppScore = opponentResult?.total_solved;
                  const scorePart = typeof oppScore === 'number' ? ` · they solved ${oppScore}` : '';
                  return (
                    <Row
                      key={`ym-${c.id}`}
                      testId="inbox-your-move"
                      accent={MAGENTA}
                      icon={<Zap className="w-5 h-5" />}
                      title={`Your move vs ${nameOf(opponentId)}`}
                      subtitle={`${typeLabel} battle${scorePart} · tap to play`}
                      onClick={() => goYourMove(c.id)}
                    />
                  );
                })}
                {friends.map((senderId) => (
                  <ActionRow
                    key={`fr-${senderId}`}
                    testId="inbox-friend-request"
                    accent={GREEN}
                    icon={<UserPlus className="w-5 h-5" />}
                    title={`${nameOf(senderId)} wants to be friends`}
                    subtitle="Friend request"
                    busy={!!busy[`fr-${senderId}`]}
                    onAccept={() => runMutation(`fr-${senderId}`, () => acceptFriendRequest(senderId))}
                    onDecline={() => runMutation(`fr-${senderId}`, () => rejectFriendRequest(senderId))}
                  />
                ))}
              </div>
            )}
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  ), document.body);
}
