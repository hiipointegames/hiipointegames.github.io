import { useEffect, useState } from 'react';

import { reportedFallback } from '@/observability';
import { appSwitchEnabled } from '@/shell';
import { fetchGiveawayEmailVerified } from './emailCode';
import { hasDeclinedContestEligibility, meetsContestAccountRequirement } from './contest';

// Is this player's giveaway email verified? true | false | null (unknown).
//
// One read per player AND address, shared by every surface that asks (the home
// chip, the results line, the giveaway sheet): they all mount around the same
// time, and three identical RPCs for one boolean would be waste. A new address
// is a new question (a verification belongs to one address), so the key
// carries the email too.
//
// FAILS SOFT: a failed read is `null`, and every caller treats null as "say
// nothing new". It is never cached, so the next mount asks again.

/** key → true|false (only real answers are kept) */
// ⚠️ SWITCH-GATED (store build 2026-10-20 ships this OFF). Until the server
// switch `giveaway_email_code` is on, this hook makes NO request — the RPC it
// reads (contest_email_status) only exists once its migration is applied — and
// answers null ("unknown"), which every caller already treats as "show nothing
// new". So with the switch absent the app behaves exactly as before.
export const EMAIL_CODE_SWITCH = 'giveaway_email_code';
/** @type {boolean|null} null = not read yet */
let switchOn = null;
let switchRead = null;

function readSwitch() {
  if (switchOn !== null || switchRead) return;
  switchRead = Promise.resolve()
    .then(() => appSwitchEnabled(EMAIL_CODE_SWITCH))
    .catch(() => false)
    .then((on) => { switchOn = on === true; switchRead = null; notify(); });
}

/** Test seam: force the switch (true/false) or reset to unread (null). */
export function __setEmailCodeSwitchForTests(value) {
  switchOn = value;
  switchRead = null;
}

/** Is the email check switched on (false while unread)? */
export function giveawayEmailCodeOn() {
  return switchOn === true;
}

const answers = new Map();
/** key → in-flight read */
const pending = new Map();
/** every mounted hook, told when an answer changes */
const listeners = new Set();

function keyFor(user) {
  if (!user?.id) return null;
  // Guests, synthetic addresses and players who said No have nothing to verify.
  if (!meetsContestAccountRequirement(user) || hasDeclinedContestEligibility(user)) return null;
  return `${user.id}|${String(user.email).toLowerCase()}`;
}

function notify() {
  for (const fn of listeners) fn();
}

function load(key, fetcher) {
  if (answers.has(key)) return;
  if (pending.has(key)) return;
  const read = Promise.resolve()
    .then(fetcher)
    .catch(reportedFallback('contest.emailVerified', null))
    .then((value) => {
      pending.delete(key);
      if (value === true || value === false || value === 'grace') answers.set(key, value);
      notify();
    });
  pending.set(key, read);
}

/**
 * Read the answer again for this player (after a successful verify, say), and
 * update every surface showing it.
 * @param {any} user
 * @param {{ fetcher?: () => Promise<boolean|'grace'|null> }} [deps]
 */
export async function refreshGiveawayEmailVerified(user, deps = {}) {
  const key = keyFor(user);
  if (!key || switchOn !== true) return;
  answers.delete(key);
  pending.delete(key);
  load(key, deps.fetcher || fetchGiveawayEmailVerified);
  await pending.get(key);
}

/**
 * Record a known answer without a read (the server just said "verified").
 * @param {any} user
 * @param {boolean} value
 */
export function setGiveawayEmailVerified(user, value) {
  const key = keyFor(user);
  if (!key) return;
  answers.set(key, value);
  notify();
}

/** Test seam: forget everything. */
export function __resetGiveawayEmailVerifiedForTests() {
  answers.clear();
  pending.clear();
}

/**
 * @param {any} user the useAuth player
 * @param {{ fetcher?: () => Promise<boolean|'grace'|null> }} [deps] test seam
 * @returns {boolean|'grace'|null}
 */
export function useGiveawayEmailVerified(user, deps = {}) {
  const key = keyFor(user);
  const fetcher = deps.fetcher || fetchGiveawayEmailVerified;
  const [, setTick] = useState(0);

  useEffect(() => {
    const listener = () => setTick((n) => n + 1);
    listeners.add(listener);
    return () => { listeners.delete(listener); };
  }, []);

  useEffect(() => { readSwitch(); }, []);

  const on = switchOn === true;
  useEffect(() => {
    if (key && on) load(key, fetcher);
    // The fetcher is a test seam; the key and the switch alone decide when to
    // read (re-running on every render would retry a failed read in a loop).
  }, [key, on]);

  if (!key || !on) return null;
  return answers.has(key) ? /** @type {boolean} */ (answers.get(key)) : null;
}
