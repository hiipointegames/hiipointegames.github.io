import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { X, CloudUpload } from 'lucide-react';
import { apiClient } from '@/transport';
import { accountTier, guestUsername } from '@/auth';
import CreateAccountForm from './CreateAccountForm';
import GuidedSignup from './guided-signup/GuidedSignup';

// Every "save your account" nudge in the app opens this (Layout's
// openSaveStats / openEditProfile / openAddEmail events).
//
// Since 2026-10-10 it routes by account type (@/auth accountTier):
//   guest  → the guided, one-question-per-screen signup (GuidedSignup), with a
//            legacy named guest's existing username pre-filled
//   member → the existing single form, for EDITING (David kept editing as-is)
/**
 * @param {{ isOpen: boolean, onClose: (saved?: any) => void, onLogin?: () => void }} props
 */
export default function SaveStatsModal({ isOpen, onClose, onLogin }) {
  const [success, setSuccess] = useState(false);
  // Who is opening it — read fresh on every open. null = not known yet.
  const [viewer, setViewer] = useState(/** @type {any} */ (null));

  // ⚠️ THE SUCCESS SCREEN HAS TO BE CLEARED ON OPEN, NOT ON CLOSE.
  //
  // David, beta 1.0.312: "account saved, so that is good. But i wanted to go
  // back and edit something else and was met with this screen over and over
  // again, from multiple routes to that page."
  //
  // `if (!isOpen) return null` is BELOW this hook, so closing the modal renders
  // nothing but does not unmount the component — `success` stayed true forever.
  // Every later visit, by any door, opened straight onto "Account Created!" with
  // no form behind it. The account screen became write-once per app launch,
  // which is the opposite of what routing every door here was for.
  //
  // Resetting on the OPEN edge rather than in onClose is deliberate: onClose has
  // several callers (the X, "Maybe Later", the auto-close timer, and the parent)
  // and any one of them forgetting would bring this back. There is only one way
  // to become visible.
  useEffect(() => {
    if (isOpen) setSuccess(false);
  }, [isOpen]);

  useEffect(() => {
    if (!isOpen) { setViewer(null); return undefined; }
    let live = true;
    Promise.resolve(apiClient.auth.me())
      .then((u) => { if (live) setViewer(u || { anonymous: true }); })
      // Unknown → treat as a guest: signup is the safe default for anyone
      // without a confirmed account.
      .catch(() => { if (live) setViewer({ anonymous: true }); });
    return () => { live = false; };
  }, [isOpen]);

  if (!isOpen || !viewer) return null;

  if (accountTier(viewer) === 'guest') {
    return (
      <GuidedSignup
        initialUsername={guestUsername(viewer)}
        excludeUserId={viewer.id ?? null}
        onCancel={() => onClose(false)}
        onDone={(user) => onClose(user || true)}
        onLogin={onLogin}
      />
    );
  }

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 u37-ad-safe-pb"
      >
        <motion.div
          initial={{ scale: 0.9, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          exit={{ scale: 0.9, opacity: 0 }}
          onClick={(e) => e.stopPropagation()}
          className="w-full max-w-md rounded-3xl p-6 border-2 shadow-2xl relative overflow-y-auto"
          style={{
            // Cosmic-neon panel (2026-09-17). These four account modals were
            // the last surfaces still painting the old indigo→purple→pink
            // gradient, which read as a different app from the neon home,
            // drawer and contest sheet around them — and they sit in the
            // middle of the save-your-account journey, so a player met all
            // four in a row.
            background: 'var(--u37-panel-bg-cosmic)',
            borderColor: 'color-mix(in srgb, var(--u37-violet) 55%, transparent)',
            boxShadow: '0 0 44px -14px var(--u37-violet), 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)',
            maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
          }}
        >
          <button onClick={onClose} className="absolute top-4 right-4 text-slate-400 hover:text-white transition-colors z-10">
            <X className="w-5 h-5" />
          </button>

          {success ? (
            <div className="text-center py-8">
              <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} className="text-6xl mb-4">✅</motion.div>
              <h2 className="text-2xl font-bold text-white mb-2">Saved!</h2>
              <p className="text-slate-300">Your progress is now saved and will follow you to any device.</p>
            </div>
          ) : (
            <>
              <div className="text-center mb-5">
                <motion.div
                  initial={{ scale: 0 }}
                  animate={{ scale: 1 }}
                  transition={{ delay: 0.1, type: 'spring' }}
                  className="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-emerald-400 to-green-600 rounded-2xl mb-3 shadow-lg"
                >
                  <CloudUpload className="w-8 h-8 text-white" />
                </motion.div>
                <h2 className="text-2xl font-black bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400 bg-clip-text text-transparent mb-2">
                  Your Account
                </h2>
                {/* Members only (guests get GuidedSignup above), who are EDITING an
                    account they already have. The old header said "Create an
                    account … no email needed" — wrong twice over for them, and it
                    contradicted the email line in the form below. Fixed 2026-10-18. */}
                <p className="text-slate-300 text-sm">
                  Log in with username + password. Email optional — needed for the giveaway.
                </p>
              </div>

              <CreateAccountForm
                submitLabel="Create Account"
                onSuccess={() => { setSuccess(true); setTimeout(() => onClose(true), 1800); }}
              />

              <Button
                type="button"
                onClick={onClose}
                variant="ghost"
                className="w-full text-slate-400 hover:text-white hover:bg-slate-700/50 py-3 rounded-xl font-semibold mt-2"
              >
                Maybe Later
              </Button>
            </>
          )}
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}
