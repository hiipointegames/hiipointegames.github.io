// ---------------------------------------------------------------------------
// EXISTING SYSTEMS, FOLDED IN — thresholds preserved EXACTLY.
//
// Laddered families render as ONE badge that levels up (§9.2a), not one card per
// tier, so the ten speed records become a single Speed Record medal whose detail
// carousel walks all ten. The ladder arrays are imported, not retyped, so the
// registry cannot drift from the live milestone config.
// ---------------------------------------------------------------------------

// The Blitz win-count ladder. This is now the SOLE declaration — the inline
// WIN_ACHIEVEMENTS emoji grid in src/head-to-head/BattleModeStatsPanel.jsx that
// it used to mirror was deleted 2026-08-05 (it rendered this same ladder a
// second time, in pre-badge language). The drift guard in badgeRegistry.test.js
// is inverted to match: it now asserts no rival ladder reappears in that UI.
const BLITZ_WIN_TIERS = [1, 5, 10, 25, 50, 100];
const BLITZ_WIN_TIER_NAMES = ['First Win', 'Competitor', 'Soldier', 'Warrior', 'Dominator', 'Juggernaut'];

const POINTS_TIER_NAMES = ['Bronze', 'Silver', 'Gold'];


/** @type {BadgeDefinition[]} */
const EXISTING_BADGES = [
  {
    id: 'dailyStreak', featId: 'dailyStreak', mode: 'daily', category: 'streaks',
