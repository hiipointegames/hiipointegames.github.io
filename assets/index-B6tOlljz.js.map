import { useSyncExternalStore } from 'react';

// A tiny external store for the Notifications inbox modal's open state + which
// scope opened it. The inbox is mounted ONCE at the Layout root; the Home button,
// the Colosseum button, and the hamburger "Notifications" item all call
// openInbox() so they can open the same shared surface from anywhere in the tree.

let state = { open: false, scope: 'home' };
const listeners = new Set();

const emit = () => { for (const cb of listeners) cb(); };
const subscribe = (cb) => { listeners.add(cb); return () => listeners.delete(cb); };

export function openInbox(scope = 'home') {
  state = { open: true, scope };
  emit();
}

export function closeInbox() {
  if (state.open) { state = { ...state, open: false }; emit(); }
}

// test-only
export function __resetInbox() { state = { open: false, scope: 'home' }; emit(); }

// Reactive read; getSnapshot returns the stable `state` reference (only replaced
// on change), satisfying useSyncExternalStore.
export function useInboxState() {
  return useSyncExternalStore(subscribe, () => state, () => state);
}
