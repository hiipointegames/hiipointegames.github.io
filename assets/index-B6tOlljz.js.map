// One read path for resolving PublicProfile rows by id.
//
// A profile-by-id read was reimplemented across ~10 sites in three idioms:
//   apiClient.entities.PublicProfile.filter({ id })[0]   (server-side eq)
//   apiClient.entities.PublicProfile.list().find(p => p.id === x)  (full-table
//                                                                   scan for 1 row)
//   apiClient.entities.PublicProfile.get(id)             (the correct single row)
// plus a `new Map(profiles.map(p => [p.id, p]))` enrichment idiom and several
// per-id `.get()` loops (N+1). Worst case (ChallengeList, FriendRequests) ran
// one or two queries *per row*. This module owns the read: single-row by id,
// batch-by-ids in one `.in(...)` query, and the pure id→profile Map builder
// (the test surface). player/ is the right home — its public surface is
// "the social layer ... and the opponent-identity lookup".

import { apiClient, PROFILE_PUBLIC_COLUMNS } from '@/transport';

/**
 * Build an id→profile Map from a profiles array. Skips falsy rows and rows
 * with no id (matching the defensive `.filter(p => p)` callers used inline).
 *
 * @param {Array<object>} profiles
 * @returns {Map<string, object>}
 */
export function buildProfileMap(profiles) {
  const map = new Map();
  if (!Array.isArray(profiles)) return map;
  for (const p of profiles) {
    if (p && p.id != null) map.set(p.id, p);
  }
  return map;
}

/**
 * Resolve a single profile by id. Wraps the entity client's `.get`, which does
 * the correct `.eq('id').maybeSingle()` — one indexed row, null if not found.
 *
 * @param {string} id
 * @returns {Promise<object|null>}
 */
export async function getProfileById(id) {
  if (!id) return null;
  return apiClient.entities.PublicProfile.get(id);
}

/**
 * Resolve many profiles by id in ONE `.in('id', ids)` query (deduped). Returns
 * an id→profile Map so callers index in O(1) instead of `.find` per row. The
 * entity client has no batch helper, so this reaches the supabase client
 * directly (same pattern FriendsList already used).
 *
 * @param {Array<string>} ids
 * @returns {Promise<Map<string, object>>}
 */
export async function getProfilesByIds(ids) {
  const unique = [...new Set((ids || []).filter(Boolean))];
  if (unique.length === 0) return new Map();
  const { data, error } = await apiClient.supabase
    .from('profiles')
    // Email-free allowlist (NOT select('*')) — never ship any player's email.
    // Typed as '*' so supabase-js keeps inferring the row shape (a runtime string
    // otherwise yields GenericStringError). Type-only; runtime unchanged.
    .select(/** @type {'*'} */ (PROFILE_PUBLIC_COLUMNS))
    .in('id', unique);
  if (error) throw error;
  return buildProfileMap(data || []);
}

/**
 * Is a username already claimed by some OTHER user? Usernames are stored
 * lowercased (usernameValidation formats them), so the candidate is normalized
 * the same way before the equality match. `excludeUserId` lets a user re-save
 * their own profile without colliding with themselves.
 *
 * Why this exists: the profile-create paths (InitialWelcomeModal, UsernamePrompt)
 * only caught a DB "duplicate" error to detect a taken name, but `profiles`
 * historically had no unique constraint on `username`, so that error never fired
 * — any user (incl. an anonymous guest) could claim a name already in use,
 * producing duplicate usernames that also break login-by-username (`.single()`
 * throws on >1 row). A case-insensitive UNIQUE index now backstops this
 * (migration 20260613120000); this read stays the fast UX pre-check that gives a
 * friendly "name taken" message before the write hits the constraint.
 *
 * @param {string} username - raw candidate (will be trimmed + lowercased)
 * @param {string} [excludeUserId] - a user id to ignore (the current user)
 * @returns {Promise<boolean>} true if another user already holds the name
 */
export async function isUsernameTaken(username, excludeUserId) {
  const formatted = (username || '').trim().toLowerCase();
  if (!formatted) return false;
  const rows = await apiClient.entities.PublicProfile.filter({ username: formatted });
  return (rows || []).some((r) => r.id !== excludeUserId);
}
