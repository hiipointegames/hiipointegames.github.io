// Badge registry — the ONE declarative catalog for the Badge System Redesign.
//
// Slice 3 of the redesign (see .workshop/badge-system-redesign-proposal-2026-07-30.md
// §4/§8.3, Lane C). This module is PURE METADATA: what badges exist, what mode
// and category they belong to, how they ladder up, what they're called, and the
// plain-English criteria the detail modal shows. It contains NO detection logic
// and NO React.
//
//   - Detection predicates          → src/equation-engine/    (Lane A)
//   - Retroactive derivation        → src/stats-aggregation/  (Lanes B, D)
//   - Rendering                     → src/components/stats/   (Lanes E, F, G)
//   - "which badges exist" (here)   → src/game-mechanics/     (Lane C)
//
// Two id concepts, deliberately separate:
//   `featId` — the canonical detection key shared with Lanes A/B/D. A craft feat
//              earnable in two modes has ONE featId.
//   `id`     — unique per registry ENTRY. Craft feats appear twice (Daily marquee
//              name + Challenge practice name), so their ids are suffixed
//              `…Daily` / `…Challenge`. For single-mode badges id === featId.
//
// Existing badges (streak / perfect-streak / speed / podium / points / Blitz win
// ladder) are folded in with their thresholds UNCHANGED — the ladder arrays are
// imported from ./milestones where a constant already exists, so the registry
// cannot drift from the live values.
//
// Not frozen, matching ./milestones' style — treat every export as read-only.

import { STREAK_MILESTONES, PERFECT_MILESTONES, PUZZLE_POINTS, BATTLE_POINTS } from './milestones';
import { TIME_MILESTONES } from './badgeRarity';
import { assignBadgeIdentities } from './badgeIdentity';
import { SPEED_TIER_NAMES, SPEED_TIER_ICONS } from './speedLadder';
import { oneTime, countLadder, thresholdLadder } from './badgeScaling';
// The EASY track and the CRAFT catalog each live in their own file — see the
// header in each for why. Round 2 § D7 took Easy from 5 badges to 9, and the
// craft block is the one that grows every time a feat is added; either alone
// would have pushed this file past the 800-line structural cap. Both are still
// assembled into BADGES below, so nothing outside this module can tell the
// difference.
import { ON_RAMP_BADGES } from './onRampBadges';
import { PIECES_PER_PERFECT_CHALLENGE, PIECES_PER_FAST_EXPERT, EXPERT_PIECE_SECONDS } from './puzzlePoints';

// The Puzzle Piece earn rate, built from the rule constants (copy-condense
// 2026-10-18) — the old 'one per perfect solve' was wrong for Expert.
const PIECE_RATE_TEXT = `${PIECES_PER_PERFECT_CHALLENGE} per perfect Challenge Daily, ${PIECES_PER_FAST_EXPERT} per Expert Daily under ${EXPERT_PIECE_SECONDS}s`;
import { CRAFT_FAMILIES, expandCraftFeat, THREE_MODE_BADGES_DATE } from './craftFeats';

/**
 * @typedef {'dailyEasy'|'daily'|'dailyExpert'|'easy'|'challenge'|'expert'|'soloBlitz'|'blitzBattle'|'crossArena'|'any'} BadgeMode
 * @typedef {'streaks'|'speed'|'mastery'|'competition'|'craft'|'onRamp'|'dojo'|'arena'} BadgeCategory
 *
 * Round 2 (2026-08-01, § D3): the `firsts` CATEGORY is gone. The five one-time
 * shields it held moved to the mode they are actually earned in, because a
 * "Firsts" tab of five cards was a fifth home competing with the five mode tabs
 * for the same badges. § DEDUPE (2026-08-02) then found that two of those five
 * were duplicates of a ladder's first rung once they stood next to it —
 * `firstBlitzWin` beside `blitzWinLadder`, `firstPodium` beside the three podium
 * counts — and retired them; `firstSolve`, `firstPerfect` and (via § D2)
 * `firstGenius` are the ones that survive or were folded in. `mode: 'any'` survives as a
 * declared enum member with no current members; a future genuinely cross-mode
 * badge can use it, and the showcase test pins that every badge resolves to
 * exactly one section so an orphan can't ship silently.
 */

/**
 * How a badge levels up. Declared with the factories that build it in
 * ./badgeScaling — which both this file's blocks and the extracted ./onRampBadges
 * and ./craftFeats need — and re-exported as a type here because every consumer
 * already imports `BadgeScaling` from the registry.
 *
 * @typedef {import('./badgeScaling').BadgeScaling} BadgeScaling
 */
/**
 * What a badge DECLARES here — everything but the identity colour, which is
 * derived from the assembled catalog rather than written per entry. The split
 * lets the types state the two stages honestly: the source arrays below are
 * `BadgeDefinition[]`, `BADGES` is `Badge[]` once `assignBadgeIdentities` has
 * run. Outside this file only `Badge` is ever seen.
 *
 * @typedef {Object} BadgeDefinition
 * @property {string} id            Unique registry key.
 * @property {string} featId        Canonical detection key (shared with Lanes A/B/D).
 * @property {BadgeMode} mode
 * @property {BadgeCategory} category
 * @property {string} name          Display name.
 * @property {boolean} hidden       Hidden badges stay silhouetted until earned.
 * @property {string} [availableFrom] ISO date this badge ENTERED THE CATALOG.
 *   Absent means "shipped with the badge system" (BADGE_SYSTEM_LAUNCH_DATE).
 *   Because badges are DERIVED from a player's whole history, a badge added later
 *   is instantly earned by past solves — and those must be announced as ONE
 *   retroactive summary, never as a queue of per-earn pops for solves the player
 *   made before the badge existed. `retroactiveCutoff` in
 *   src/game-flow/badgeAnnouncements.js reads this. Set it on every badge added
 *   after launch.
 * @property {string} [perfectOf]   RETIRED 2026-09-03 and carried by no badge in
 *   the catalog today. It marked a perfect VARIANT — a second card that shadowed
 *   a base craft feat and counted the subset of its solves that were also perfect.
 *   The merge folded all seven variants into top RUNGS of the families they
 *   shadowed, so there is nothing left to mark. The field and its reader
 *   (`isPerfectVariant` in src/components/stats/badgeVisuals.js) are kept because
 *   a future variant-shaped badge would want exactly this contract back.
 * @property {BadgeScaling} scaling
 * @property {string} criteriaText  Plain-English "how to earn it" for the badge as a whole.
 * @property {string} [criteriaScope] WHERE a stage-ladder badge's rungs are
 *   earned ("in the Daily Challenge"), appended by `tierCriteriaText` to the
 *   per-rung `criteria` phrase on `scaling.stages`. Carried by the craft twins,
 *   whose rungs are different requirements rather than values of one measure.
 * @property {string} [criteriaTemplate] Plain-English "how to earn it" for ONE rung,
 *   with placeholders the renderer fills per tier. Declared on every laddered badge
 *   whose requirement is the tier VALUE (thresholds) or whose `criteriaText`
 *   enumerates its rungs; count ladders that simply repeat a feat leave it off and
 *   let the renderer append the repeat-count. Placeholders (see
 *   `tierCriteriaText` in src/components/stats/badgeVisuals.js):
 *     `{value}` the tier number with thousands separators · `{time}` the tier
 *     seconds as a clock (`1:30`) · `{label}` the tier's headline label
 *     ("Commander", "Gold") · `{s}` a plural "s", empty when the value is 1.
 * @property {string} icon          The badge's ART: a key into the curated SVG icon
 *   set at src/components/stats/badgeIcons.jsx. This is what every badge SURFACE
 *   renders — frame, card, carousel, detail modal — because it is one cohesive
 *   set drawn on one grid and tinted from the badge's mode accent via
 *   `currentColor`. Every badge must declare one; a test asserts the key exists
 *   in the set, so a new badge cannot ship with a blank frame.
 * @property {string} art           EMOJI FALLBACK, deliberately kept. It is no
 *   longer the badge's art — `icon` is — but it remains the glyph for the one
 *   consumer that needs a text character rather than a component: the award
 *   celebration pop-up (`src/game-flow/awards.js`, which puts `emoji` into a
 *   text node). Keep it in sync with `icon` in spirit when adding a badge.
 */

/**
 * A badge as every CONSUMER sees it: a definition plus its derived identity
 * colour — the innermost of the three colour axes (mode paints the card outline,
 * identity the medal, rarity the glow). See ./badgeIdentity.
 *
 * @typedef {BadgeDefinition & {identity: import('./badgeIdentity').BadgeIdentity}} Badge
 */

// THE MODE ENUM IS (DIFFICULTY TIER x ROUND TYPE), PLUS THE ARENAS (2026-09-04).
//
// It used to be `daily | challenge | easy | soloBlitz | blitzBattle`, which read
// like one axis and was three: `daily` meant CHALLENGE's Daily, `challenge`
// meant Challenge PRACTICE, `easy` meant Easy PRACTICE — and there was no
// Expert anything, in a game that ships three difficulty tiers. That collapse is
// the structural half of David's "the way the badges are nested and collected
// makes no sense": the catalog could not express the sections he asked for.
//
// The six puzzle modes are now the same product `modeKeys.js` uses app-wide —
// {easy, challenge, expert} x {daily, practice} — under the registry's own
// spelling. `daily` KEEPS its name for Challenge's Daily: it is the legacy wire
// key, every existing badge id and every shipped `game_stats` field is written
// in terms of it, and renaming it would be a migration for no gain.
export const BADGE_MODES = [
  'dailyEasy', 'daily', 'dailyExpert',   // the three Dailies (`daily` = Challenge's)
  'easy', 'challenge', 'expert',         // the three practice tiers
  'soloBlitz', 'blitzBattle', 'crossArena',
  'any',
];
export const BADGE_CATEGORIES = ['streaks', 'speed', 'mastery', 'competition', 'craft', 'onRamp', 'dojo', 'arena'];
export const BADGE_SCALING_TYPES = ['oneTime', 'countLadder', 'thresholdLadder', 'stageLadder'];


/** @type {BadgeDefinition[]} */
const CRAFT_BADGES = [
  ...CRAFT_FAMILIES.flatMap(expandCraftFeat),
  {
    // Daily-only: a broken streak is a Daily concept, so there is no practice twin.
    id: 'comebackKid', featId: 'comebackKid', mode: 'daily', category: 'craft',
    name: 'Comeback Kid', hidden: false,
    scaling: countLadder([1, 10, 37]),
    criteriaText: 'Solve the Daily Challenge the day after your streak breaks.',
    art: '🔁', icon: 'comeback',
  },
  {
    // Sector 73's Mirror (2026-10-04). Hidden: the silhouette + cryptic hint IS a
    // clue to the secret, and the earn pop-up is the reveal. Any tier's Daily.
    id: 'lookingGlass', featId: 'lookingGlass', mode: 'daily', category: 'craft',
    name: 'Looking Glass', hidden: true, scaling: oneTime(),
    criteriaText: 'Cross the Mirror: solve a Daily to 73 and warp into Sector 73.',
    art: '🪞', icon: 'mirror',
  },
  // The seven PERFECT VARIANTS that used to sit here were RETIRED 2026-09-03
  // (design-per-mode-2026-08-31 § 2). Each was a strict subsumption of a base
  // craft feat — `supernova` could not light without `bigBang`, which could not
  // light without `fullSpectrum` — so each is now the TOP RUNG of the family it
  // shadowed, keeping its own name and art as that rung's label and `tierIcons`
  // entry. Nobody loses anything: badge state is derived, so a variant holder
  // simply resolves as a higher tier of the survivor. See ./craftFeats.
  {
    // Round 2 § D3 — was `firsts`/`any`. A perfect solve IS a craft feat (all
    // three power dice used correctly), so its first-time shield belongs beside
    // the craft catalog rather than on a tab of its own. Daily because that is
    // where the perfect-solve prestige lives (Supernova, Resonance, the perfect
    // streak); the DERIVATION still reads Daily + Challenge rows, which is what
    // the criteria sentence says, so the badge is not narrowed by the move.
    // Id UNCHANGED — earned state keys on it.
    id: 'firstPerfect', featId: 'firstPerfect', mode: 'daily', category: 'craft',
    name: 'First Perfect', hidden: false, scaling: oneTime(),
    criteriaText: 'Complete your first perfect solve — all three power dice used correctly.',
    art: '🎯', icon: 'target',
  },
];

// ---------------------------------------------------------------------------
// PRACTICE — Dojo volume ladders (on top of the craft catalog above).
//
// Registry mode is still `challenge` (the frozen wire key), but since David's
// 2026-09-03 per-mode ruling these count EVERY power-dice practice solve —
// Challenge and Expert. Easy is excluded: it has no power dice, and the Easy
// On-Ramp ladders its volume separately.
//
// ⚠️ The criteriaText below still says "Challenge free-play" and is therefore
// narrower than the badge. Its exact string is pinned by src/components/stats/
// badgeVisuals.test.js, another lane's file this wave; the copy fix lands with
// the Practice-section re-cut.
// ---------------------------------------------------------------------------

/** @type {BadgeDefinition[]} */
const DOJO_BADGES = [
