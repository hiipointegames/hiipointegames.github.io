import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { Search, UserPlus } from 'lucide-react';
import { buildInviteText, shareOrCopy } from '@/game-flow';
import { apiClient } from '@/transport';
import { getFriendEdges, selectFriendIds, partitionPendingRequests } from '@/player';
import { useQuery } from '@tanstack/react-query';
import UserSearch from './UserSearch';
import FriendsList from './FriendsList';
import RecommendedPlayers from './RecommendedPlayers';
import { useNotifications } from '@/notifications';

// Neon-outline cosmic button style — the same outline + translucent-accent fill
// + glow language as the Stats/Leaderboard/Blitz buttons, replacing the old
// solid emerald/violet gradient fills so the Friends surface matches the
// neon-cosmic theme (David, 2026-07-13).
const GREEN = 'var(--u37-green)';
const VIOLET = 'var(--u37-violet)';
const neonBtnStyle = (color) => ({
  color: `color-mix(in srgb, ${color} 30%, white)`,
  background: `color-mix(in srgb, ${color} 12%, transparent)`,
  border: `1.5px solid ${color}`,
  boxShadow: `0 0 16px -5px ${color}, inset 0 0 18px -12px ${color}`,
  textShadow: `0 0 8px color-mix(in srgb, ${color} 55%, transparent)`,
});

// Friends management surface — search, friends list, recommended players, and
// friend requests — lifted out of the (dissolved) standalone Friends page so the
// Blitz Colosseum can host it (friends ↔ battles are coupled: you need friends to
// battle). Self-contained: owns the friend-edge sync + 3s poll that the old page
// ran. The friends DAILY-challenge leaderboard is NOT here — it now lives in the
// unified Leaderboard's Daily › Friends tab.
export default function FriendsSection({ embedded = false }) {
  const [showSearch, setShowSearch] = useState(false);
  const [previousRequestCount, setPreviousRequestCount] = useState(0);
  const { addNotification } = useNotifications();

  // Auto-refresh user data every 3 seconds for real-time friend updates.
  const { data: user, refetch } = useQuery({
    queryKey: ['currentUser'],
    queryFn: async () => {
      const currentUser = await apiClient.auth.me();

      const edges = await getFriendEdges(currentUser.id);
      const friendIds = new Set(selectFriendIds(edges, currentUser.id));
      const { incoming: requestIds, outgoing: sentRequestIds } =
        partitionPendingRequests(edges, currentUser.id);

      const currentFriends = new Set(currentUser['friends'] || []);
      const currentRequests = new Set(currentUser['friend_requests_received'] || []);
      const currentSentRequests = new Set(currentUser['friend_requests_sent'] || []);

      const friendsMatch = friendIds.size === currentFriends.size &&
        [...friendIds].every(e => currentFriends.has(e));
      const requestsMatch = requestIds.length === currentRequests.size &&
        requestIds.every(e => currentRequests.has(e));
      const sentRequestsMatch = sentRequestIds.length === currentSentRequests.size &&
        sentRequestIds.every(e => currentSentRequests.has(e));

      if (!friendsMatch || !requestsMatch || !sentRequestsMatch) {
        await apiClient.auth.updateMe({
          friends: Array.from(friendIds),
          friend_requests_received: requestIds,
          friend_requests_sent: sentRequestIds
        });
        return await apiClient.auth.me();
      }

      return currentUser;
    },
    refetchInterval: 3000,
    refetchIntervalInBackground: true,
    staleTime: 0
  });

  // Notify on a newly-arrived friend request.
  useEffect(() => {
    if (user && user['friend_requests_received']) {
      const currentCount = user['friend_requests_received'].length;
      if (currentCount > previousRequestCount && previousRequestCount > 0) {
        addNotification({
          type: 'request',
          title: 'New Friend Request!',
          message: 'You have a new friend request'
        });
      }
      setPreviousRequestCount(currentCount);
    }
  }, [user?.['friend_requests_received']?.length]);

  const refreshUser = () => refetch();

  return (
    <div data-testid="friends-section">
      {/* Section header. Shown only when NOT embedded — the Home collapsible
          panel supplies its own "Friends & Players" title. The old requests bell
          + its dropdown were removed: friend requests now surface in the shared
          Notifications center (in green), so there's no second inbox here
          (David, 2026-07-13). */}
      {!embedded && (
        <div className="flex items-center gap-3 mb-4">
          <span className="text-2xl">👥</span>
          {/* 7A: readability — solid bright-green neon with a glow keeps the neon
              feel but stays clearly legible on iPhone. */}
          <h2
            className="text-xl font-black"
            style={{
              color: 'var(--u37-green)',
              textShadow: '0 0 12px color-mix(in srgb, var(--u37-green) 55%, transparent)',
            }}
          >
            Friends &amp; Players
          </h2>
        </div>
      )}

      {/* Search + invite */}
      <div className="mb-6 flex flex-wrap justify-center gap-3">
        <Button
          variant="ghost"
          onClick={() => setShowSearch(!showSearch)}
          className="rounded-full py-5 px-8 min-h-[56px] touch-manipulation text-base font-black"
          style={neonBtnStyle(GREEN)}
        >
          <Search className="w-5 h-5 mr-2" />
          Search Players
        </Button>
        {/* Invite friends — reuses the daily-share Web Share path (navigator.share
            → clipboard fallback); shares the Linktree. No native plugin.
            The tap sound comes from the Button primitive's onPointerDown; do NOT
            also call playSound('buttonTap') here or the tap plays twice (double
            click reported on 1.0.285 iOS). */}
        <Button
          variant="ghost"
          onClick={() => { shareOrCopy('native', buildInviteText()); }}
          className="rounded-full py-5 px-8 min-h-[56px] touch-manipulation text-base font-black"
          style={neonBtnStyle(VIOLET)}
        >
          <UserPlus className="w-5 h-5 mr-2" />
          Invite Friends
        </Button>
      </div>

      {showSearch && (
        <motion.div initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }} className="mb-6">
          <UserSearch currentUserId={user?.id} />
        </motion.div>
      )}

      {/* Friends list */}
      <div className="mb-6">
        <FriendsList currentUser={user} onUpdate={refreshUser} />
      </div>

      {/* Recommended players */}
      <div className="mb-2">
        <RecommendedPlayers
          currentUserId={user?.id}
          currentUserFriendIds={user?.['friends'] || []}
          onUpdate={refreshUser}
        />
      </div>
    </div>
  );
}
