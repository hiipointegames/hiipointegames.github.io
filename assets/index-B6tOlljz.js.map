import swoshSound from '@/assets/220563930-swosh-fast-splash.m4a';
import funkGuitarSound from '@/assets/276792592-funk-guitar-strum-4.m4a';
import buttonTapSound from '@/assets/button-tap.m4a';
import soloBlitzSubmitSound from '@/assets/SoloBlitzSubmit.m4a';
import shorterDiceRollSound from '@/assets/shorter-dice-roll.m4a';
import diceClickSound from '@/assets/click-2-05.m4a';
import hamburgerMenuSound from '@/assets/HamburgerMenuSound.m4a';
import swordClashSound from '@/assets/sword-clash-4.m4a';
import battleBeginSound from '@/assets/ui-battle-begin.m4a';
import punchSound from '@/assets/Punch.m4a';
import victoryResultsSound from '@/assets/VictoryViewResults.m4a';
import bassGuitarSound from '@/assets/funky-distorted-bass-guitar-li.m4a';

// AUDIT 2026-09-11 — every WAV re-encoded to AAC (.m4a). 3.90 MB -> 364 KB.
//
// The eleven WAVs in this registry were STUDIO MASTERS, not game assets:
// SoloBlitzSubmit at 96 kHz / 24-bit, three more at 24-bit, and
// VictoryViewResults carrying an embedded 500x500 MJPEG cover-art stream from
// whatever stock library it came from. 3.90 MB to deliver 15.4 SECONDS of audio.
//
// Re-encoded with ffmpeg to AAC — 128 kbps for the SFX, 192 kbps for
// funky-distorted-bass-guitar-li (the Daily theme, the most musically complex
// asset and the one most likely to expose encoder artefacts). Every output was
// verified single-stream, duration-identical to the millisecond, and clean under
// `ffprobe -v warning`.
//
// The exact command, so this is reproducible rather than folklore:
//   ffmpeg -i IN.wav -map 0:a:0 -map_chapters -1 -map_metadata -1 //          -c:a aac -b:a 128k -ar 44100 -movflags +faststart OUT.m4a
//
// `-map 0:a:0` is load-bearing, not decoration: a plain `-vn` still carried a
// stray bin_data stream on three files, and VictoryViewResults FAILED to convert
// at all until its video stream was excluded ("Could not find tag for codec
// h264"). A naive batch script would have silently produced a broken file.
//
// Format safety was not assumed — `276792592-funk-guitar-strum-4.m4a` had
// already been shipping AAC in production for months, on both the Android
// WebView and iOS WKWebView. That file is why this pass carried no codec risk.
//
// Pinned by audioAssetBudget.test.js (a size ratchet). Also removed here: a
// 61 KB public/dice-3d.png that Vite was copying into every bundle with no
// reference anywhere, plus two unreferenced src/assets files.
//
// AUDIT 2026-09-03 — four audio files removed from src/assets across two passes.
//
// PASS 1 (source hygiene, zero bundle bytes) removed two files Vite was already
// dropping: a 515 KB copy with no importer at all, and a 121 KB byte-identical
// twin of `shorter-dice-roll.wav`. Neither cost a player anything; they were
// simply two files nobody could tell apart.
//
// PASS 2 (David's ruling) removed two that DID ship, because they were
// registered here and played by no code path in the app:
//
//   fireworks     → fireworks-13.wav                          729,416 B
//   diceRollLong  → 035061884-…-fast.wav                      354,644 B
//   diceShuffle   → (a second name for the same file)                —
//
// ≈1.03 MB off every bundle and every OTA. That matters more than it looks: a
// CapGo OTA bundle must download inside a 25s timeout, so dead audio is paid for
// by every user on every update, forever, to play nothing.
//
// ⚠️ HOW REACHABILITY WAS ESTABLISHED — do not shortcut this if you delete more.
// A `playSound('name')` grep ALONE IS WRONG. `bassGuitar` (1.27 MB) has no
// literal call site anywhere; it is reached through the ROCKET_LAUNCH_SOUNDS
// lookup in game-flow/RocketLaunchScreen.jsx. A naive grep reports it dead. The
// check that is correct: enumerate literal call sites, then find every
// NON-literal `playSound(` argument and read the table behind it. Confirmed
// against `dist/assets` from a real `vite build`, not from source alone.
//
// `diceRollShort` is a surviving name with no call site, deliberately left: it
// aliases the same asset as `shorterDiceRoll` (which IS played), so it costs
// zero bytes, and retiring a name from the sound library is David's call.

// Map sound names to imported assets
const soundAssets = {
  swosh: swoshSound,
  funkGuitar: funkGuitarSound,
  // Same audio as `shorterDiceRoll` — see the alias note above.
  diceRollShort: shorterDiceRollSound,
  buttonTap: buttonTapSound,
  soloBlitzSubmit: soloBlitzSubmitSound,
  shorterDiceRoll: shorterDiceRollSound,
  diceClick: diceClickSound,
  hamburgerMenu: hamburgerMenuSound,
  swordClash: swordClashSound,
  battleBegin: battleBeginSound,
  punch: punchSound,
  victoryResults: victoryResultsSound,
  bassGuitar: bassGuitarSound,
};

// Map sound names to their preset volumes
const soundVolumes = {
  swosh: 0.6,
  funkGuitar: 0.8,
  diceRollShort: 0.8,
  buttonTap: 0.5,
  soloBlitzSubmit: 0.7,
  shorterDiceRoll: 0.8,
  diceClick: 0.5,
  hamburgerMenu: 0.6,
  swordClash: 0.7,
  battleBegin: 0.8,
  punch: 0.7,
  victoryResults: 0.7,
  bassGuitar: 0.8,
};

// Cache for Audio instances to avoid re-creating them
const audioInstances = {};

export const playSound = (soundName) => {
  // Check mute preference
  const isMuted = localStorage.getItem('soundMuted') === 'true';
  if (isMuted) return;

  // Lazy-load the Audio instance if it doesn't exist
  // Creating Audio objects inside a user-triggered function is more reliable on mobile
  if (!audioInstances[soundName] && soundAssets[soundName]) {
    try {
      const audio = new Audio(soundAssets[soundName]);
      audio.volume = soundVolumes[soundName] || 0.7;
      audioInstances[soundName] = audio;
    } catch (e) {
      console.warn(`Failed to create Audio instance for ${soundName}:`, e);
    }
  }

  const originalSound = audioInstances[soundName];
  if (originalSound) {
    try {
      // Clone the node to allow overlapping playback (e.g. rapid taps)
      const soundClone = originalSound.cloneNode();
      soundClone.volume = originalSound.volume;
      soundClone.play().catch(err => {
        // Silent catch for interaction-policy errors
        console.warn(`Error playing sound ${soundName}:`, err);
      });
    } catch (e) {
      console.error("Audio playback error:", e);
    }
  } else {
    console.warn(`Sound "${soundName}" not found or failed to load.`);
  }
};

export default audioInstances;
