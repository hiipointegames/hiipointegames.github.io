// feature-tips/tips — THE REGISTRY. Data only: no logic, no React.
//
// Every player-visible word of the first-week tips lives in this one file, so
// the copy can be swapped wholesale once David approves the final text (CRISPY
// 2026-10-20 tips-and-referrals, slice 6). The strings below are PLACEHOLDERS
// written to be shippable, not final.
//
// A week-one card:
//   id       stable key written to user_metadata.feature_tips.seen — never rename
//   day      the play-day it becomes due on (1, 3, 5, 7)
//   trigger  'results' — when the results screen of the first finished Daily of
//                        a play-day closes (card 1 only)
//            'home'    — on Home idle, after the existing pop-up chain
//   icon     an icon key FeatureTipCard maps to a glyph
//   title / lines   the card's words (1–2 lines; `stats` has 3 short ones)
//   referralLine    optional extra line, shown ONLY while the `referrals` switch is on
//   actions  buttons, primary first. `go` is an action KEY the host resolves
//            (useFeatureTips TIP_ACTIONS) — never a URL, so routes stay in code.
//
// "Not now" is not listed: every card has it, and it is spelled once below.

export const NOT_NOW_LABEL = 'Not now';

export const WEEK_ONE_TIPS = Object.freeze([
  Object.freeze({
    id: 'share_result',
    day: 1,
    trigger: 'results',
    icon: 'share',
    title: 'Show off your solve',
    lines: Object.freeze([
      'Send today’s result to a friend and see if they can beat your time.',
    ]),
    referralLine: 'New friends who enter your username when they join earn you bonus giveaway entries.',
    actions: Object.freeze([Object.freeze({ label: 'Share', go: 'share_result' })]),
  }),
  Object.freeze({
    id: 'friends_blitz',
    day: 3,
    trigger: 'home',
    icon: 'friends',
    title: 'Play with friends',
    lines: Object.freeze([
      'Add friends to follow their solves.',
      'Then challenge them to a Blitz battle: same dice, fastest 37 wins.',
    ]),
    actions: Object.freeze([
      Object.freeze({ label: 'Find friends', go: 'friends' }),
      Object.freeze({ label: 'Start a Blitz', go: 'blitz' }),
    ]),
  }),
  Object.freeze({
    id: 'stats',
    day: 5,
    trigger: 'home',
    icon: 'stats',
    title: 'Your stats tell a story',
    lines: Object.freeze([
      'Track your solve times for every Daily.',
      'Watch your streaks grow day by day.',
      'See how you stack up against the world.',
    ]),
    actions: Object.freeze([Object.freeze({ label: 'See my stats →', go: 'stats' })]),
  }),
  Object.freeze({
    id: 'badges_boards',
    day: 7,
    trigger: 'home',
    icon: 'badges',
    title: 'Badges and leaderboards',
    lines: Object.freeze([
      'One week in! You’ve been earning badges as you play.',
      'Check your collection, then see where you rank today.',
    ]),
    actions: Object.freeze([
      Object.freeze({ label: 'Badges', go: 'badges' }),
      Object.freeze({ label: 'Leaderboards', go: 'leaderboards' }),
    ]),
  }),
]);

// What's new — one entry per app version that deserves a note. Each entry:
//   { version: '1.0.340', id: 'whats_new_1_0_340', icon, title, lines, actions? }
// Shown once per account on the first Home idle after updating to (or past) that
// version — see tipRules.dueWhatsNew. Ships EMPTY: the mechanism is ready; the
// first note (Sector 73) is added when that ships.
export const WHATS_NEW = Object.freeze([]);
