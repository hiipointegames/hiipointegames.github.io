// Cues — ONE table that ties sound, vibration and visuals together for each kind of moment,
// so they always fire in sync and the "feel" is tuned in one place (animation playbook §4).
//
// Tiers (David, 2026-10-05): 1 = every tap, quiet, ≤120 ms · 2 = a correct move, 300–700 ms ·
// 3 = a win, 1.5–3.5 s, skippable. Thinking screens stay calm; only outcomes are loud.

export const CUES = Object.freeze({
  tap: { tier: 1, sound: 'blip', haptic: 'select' },
  tokenSnap: { tier: 1, sound: 'blip', haptic: 'select' },
  fail: { tier: 2, sound: 'fail', haptic: 'error', elementShake: true },
  lineDone: { tier: 2, sound: 'ignite', haptic: 'medium', burst: 'ring', hitStop: 40 },
  jumpValid: { tier: 2, sound: 'impact', haptic: 'medium', burst: 'burst', hitStop: 60, trauma: 0.2 },
  bossEscape: { tier: 3, sound: 'impact', haptic: 'heavy', burst: 'burst', hitStop: 80, trauma: 0.6 },
  bossArrive: { tier: 3, sound: 'warp', haptic: 'heavy', trauma: 0.35 }, // Hyperjump boss entrance (2026-10-11)
  touchdown: { tier: 3, sound: 'impact', haptic: 'heavy', burst: 'dust', hitStop: 50, trauma: 0.5 },
  modeWin: { tier: 3, sound: 'success', haptic: 'success', burst: 'confetti37' },
  dock: { tier: 2, sound: 'dock', haptic: 'light', trauma: 0.15 },
});

/** The cue spec, or null for an unknown name. */
export const cueSpec = (name) => CUES[name] || null;

/**
 * What a cue should actually do given the player's settings — pure, so it is testable.
 * Reduced motion keeps sound + haptics (they are not motion) but drops shake, bursts and
 * hit-stop freezes.
 */
export function resolveCue(name, { reducedMotion = false } = {}) {
  const spec = cueSpec(name);
  if (!spec) return null;
  return {
    sound: spec.sound || null,
    haptic: spec.haptic || null,
    burst: reducedMotion ? null : spec.burst || null,
    trauma: reducedMotion ? 0 : spec.trauma || 0,
    hitStop: reducedMotion ? 0 : spec.hitStop || 0,
    elementShake: reducedMotion ? false : Boolean(spec.elementShake),
    tier: spec.tier,
  };
}
