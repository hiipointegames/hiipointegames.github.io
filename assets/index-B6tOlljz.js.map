// shell/adGate — the single async gate that decides whether ads may load.
//
// Why this exists: UMP consent is gathered once at startup (src/shell/consent.js
// → initAdMob), but ad LOADERS run later and elsewhere — the banner manager on
// each route change, the interstitial hook on mount. They must NOT request ads
// until consent resolves, and must NOT request them at all if the user denied
// consent (canRequestAds === false). Google requires gating ad requests on
// canRequestAds; the SDK does not suppress them for you.
//
// This is a one-shot promise: loaders `await whenAdsAllowed()` and get the
// boolean once initAdMob calls setAdsAllowed(canRequestAds). Loaders that run
// before consent resolves simply wait; loaders that run after get the cached
// answer immediately.

let resolveGate;
let gatePromise = new Promise((resolve) => {
  resolveGate = resolve;
});
let settled = false;

/**
 * Record the consent outcome. Idempotent — only the first call counts, so a
 * stray second consent pass can't flip an already-decided session.
 */
export function setAdsAllowed(allowed) {
  if (settled) return;
  settled = true;
  resolveGate(Boolean(allowed));
}

/**
 * Resolves to true when ads may be requested, false when consent was denied.
 * Pending until setAdsAllowed runs, so callers naturally wait for consent.
 */
export function whenAdsAllowed() {
  return gatePromise;
}

// Test-only: reset the one-shot gate between cases.
export function __resetAdGateForTests() {
  settled = false;
  gatePromise = new Promise((resolve) => {
    resolveGate = resolve;
  });
}
