// Matching a name against the terms, and deciding whether a hit is real.
//
// Two ideas, and they are separable — which is the point, because the two
// failures this module exists to fix are NOT on the same dial:
//
//   1. REPEAT TOLERANCE fixes the bypass. A term compiles so that each of its
//      characters may repeat: `shit` becomes /s+h+i+t+/. The old code instead
//      CLAMPED runs in the input to two, which is what created the bypass
//      (`shiitlord` and `fuuck` passed) and simultaneously killed `kkk` and
//      `xxx`, whose terms could never survive their own normalization. Matching
//      the repeats instead of destroying them fixes both directions at once.
//
//   2. COVER fixes the Scunthorpe problem. A hit only rejects if no real word or
//      name explains it. `tit` inside `titanium` is explained by `titanium`;
//      `tit` alone is explained by nothing.
//
// Repeat tolerance and cover pull in opposite directions by design: the first
// widens what matches, the second narrows what a match means. Measured together
// against 429,765 real words and names, the pair rejects 5 dictionary words and
// 6 surnames — versus dozens of everyday words before.

import { MIN_COVER, transformsForTerm } from './transforms.js';

/**
 * A term compiled for one transform.
 *
 * @typedef {{ term: string, mode: 'substring' | 'whole', re: RegExp }} CompiledTerm
 */

/**
 * Compile a term into its repeat-tolerant form.
 *
 * Terms are `[a-z0-9]` only, so no regex escaping is required — asserted by
 * `matcher.test.js` so a future term containing punctuation fails loudly
 * instead of compiling into an unintended pattern.
 *
 * @param {string} term
 * @param {string} flags
 * @returns {RegExp}
 */
export function repeatTolerant(term, flags) {
  if (!/^[a-z0-9]+$/.test(term)) {
    throw new Error(`moderation: term ${JSON.stringify(term)} must be [a-z0-9] only`);
  }
  return new RegExp(term.split('').map((c) => `${c}+`).join(''), flags);
}

/**
 * Compile every term, grouped by the transform it is matched under.
 *
 * A term is skipped for a transform that would shrink it below three characters
 * or collapse it onto a term already compiled for that transform — both would
 * only add false positives.
 *
 * @param {{ term: string, mode?: 'substring' | 'whole' }[]} terms
 * @returns {Map<string, CompiledTerm[]>} keyed by transform name
 */
export function compileTerms(terms) {
  /** @type {Map<string, CompiledTerm[]>} */
  const byTransform = new Map();
  for (const { term, mode = 'substring' } of terms) {
    for (const transform of transformsForTerm(term)) {
      const folded = transform.fn(term);
      if (folded.length < 3) continue;
      if (!byTransform.has(transform.name)) byTransform.set(transform.name, []);
      const list = byTransform.get(transform.name);
      if (list.some((entry) => entry.re.source === repeatTolerant(folded, '').source)) continue;
      list.push({ term, mode, re: repeatTolerant(folded, 'g') });
    }
  }
  return byTransform;
}

/**
 * Is a matched span explained by an allowlisted real word or name?
 *
 * Scans the substrings of the candidate that span the match. A username is at
 * most 20 characters, so this is at worst a couple of hundred set lookups — the
 * whole check costs ~0.03 ms.
 *
 * TWO CONSTRAINTS, and both were added because the prototype without them was
 * exploitable:
 *
 *   * `MIN_COVER` — an entry shorter than four characters licenses nothing. At
 *     three, the seaweed plural `fuci` licensed `phuckyou`.
 *   * STRICTLY LONGER than the span it explains. Without this a name that folds
 *     onto a slur licenses the slur itself: the census surname `koon` would have
 *     made `coon` an acceptable username.
 *
 * @param {string} candidate the folded candidate text
 * @param {Set<string>} allow allowlist for this transform
 * @param {number} start inclusive
 * @param {number} end exclusive
 * @param {{start: number, end: number}} [forbidden] a span the cover may not
 *   overlap. Used by tier 2 so a cover cannot borrow letters from the targeting
 *   word: in `killass` the word `lass` spans the `ass`, but three of its four
 *   letters come out of `kill`, which is not an innocent reading of anything.
 * @returns {string|null} the covering word, or null
 */
export function coverFor(candidate, allow, start, end, forbidden) {
  const need = Math.max(MIN_COVER, end - start + 1);
  for (let i = 0; i <= start; i += 1) {
    if (forbidden && i < forbidden.end && end > forbidden.start) {
      // The cover would start inside the forbidden span.
      if (i >= forbidden.start) continue;
    }
    for (let j = Math.max(end, i + need); j <= candidate.length; j += 1) {
      if (forbidden && i < forbidden.end && j > forbidden.start) continue;
      const slice = candidate.slice(i, j);
      if (slice.length >= need && allow.has(slice)) return slice;
    }
  }
  return null;
}

/**
 * The first term that matches the candidate and is NOT explained away.
 *
 * @param {string} candidate the folded candidate text
 * @param {CompiledTerm[]} terms compiled for this same transform
 * @param {Set<string>} allow allowlist for this same transform
 * @returns {{ term: string, start: number, end: number }|null}
 */
export function findUnexplained(candidate, terms, allow) {
  for (const { term, mode, re } of terms) {
    re.lastIndex = 0;
    let match;
    while ((match = re.exec(candidate)) !== null) {
      if (match[0].length === 0) { re.lastIndex += 1; continue; }
      const start = match.index;
      const end = start + match[0].length;
      // A whole-name term rejects only when it IS the name — no cover check,
      // because there is nothing left of the name to provide context.
      if (mode === 'whole') {
        if (start === 0 && end === candidate.length) return { term, start, end };
        continue;
      }
      if (!coverFor(candidate, allow, start, end)) return { term, start, end };
    }
  }
  return null;
}

/**
 * Precompile the tier-2 pairs.
 *
 * 6 contextual × 8 targeting = 48 patterns, built once at module load. Building
 * them per call cost 0.30 ms against 0.03 ms — a tenfold difference on a check
 * that also runs three times per name.
 *
 * @param {string[]} contextual
 * @param {string[]} targeting
 * @returns {{ contextual: string, targeting: string, re: RegExp }[]}
 */
export function compileAbusePairs(contextual, targeting) {
  const pairs = [];
  for (const word of contextual) {
    const w = repeatTolerant(word, '').source;
    for (const target of targeting) {
      const t = repeatTolerant(target, '').source;
      pairs.push({
        contextual: word,
        targeting: target,
        // Either order, with the contextual word CAPTURED so its span can be
        // cover-checked. `assskill` reads the same as `asskill`.
        re: new RegExp(`(?:(${w})(?:${t}))|(?:(?:${t})(${w}))`, 'g'),
      });
    }
  }
  return pairs;
}

/**
 * A mild word sitting directly beside a targeting word, with no innocent reading.
 *
 * TWO conditions, and the second is the one that took a bug to learn:
 *
 *   1. ADJACENCY. The previous rule asked only whether both words appeared
 *      SOMEWHERE in the name, in any order and unrelated, which is why it
 *      rejected `PassRemover` and `BassDestroyer`.
 *   2. THE CONTEXTUAL WORD MUST BE UNEXPLAINED. Adjacency alone is not enough:
 *      in `GrassKiller` the letters `ass` really are immediately followed by
 *      `kill`, so an adjacency-only rule still rejects it. `grass` explains the
 *      `ass`, and that is what makes the name innocent.
 *
 * @param {string} candidate the folded candidate text
 * @param {{ contextual: string, targeting: string, re: RegExp }[]} pairs
 * @param {Set<string>} allow allowlist for this same transform
 * @returns {{ contextual: string, targeting: string }|null}
 */
export function findAdjacentAbuse(candidate, pairs, allow) {
  for (const { contextual, targeting, re } of pairs) {
    re.lastIndex = 0;
    let match;
    while ((match = re.exec(candidate)) !== null) {
      if (match[0].length === 0) { re.lastIndex += 1; continue; }
      const word = match[1] ?? match[2] ?? '';
      const contextualFirst = match[1] !== undefined;
      const start = contextualFirst ? match.index : match.index + match[0].length - word.length;
      const end = start + word.length;
      // Whatever of the pair is not the contextual word is the targeting word.
      const forbidden = contextualFirst
        ? { start: end, end: match.index + match[0].length }
        : { start: match.index, end: start };
      if (!coverFor(candidate, allow, start, end, forbidden)) {
        return { contextual, targeting };
      }
    }
  }
  return null;
}
