// AdSense env resolution — the single gate for web monetization.
//
// The web build mirrors the mobile AdMob BANNER placement (the web interstitial
// was removed 2026-08-23 — see webInterstitialController.js) as a visible
// placeholder until AdSense is approved. The switch is one env var:
//
//   VITE_ADSENSE_CLIENT absent  → render the labeled placeholder (ships today)
//   VITE_ADSENSE_CLIENT present → render the real AdSense <ins> unit
//
// (mirrors the absent/present gate AdMob has via adIsTesting/getBannerAdId.)
// The banner slot id lets the unit be addressed once AdSense issues one; until
// then WebAdSlot renders nothing rather than a slot-less <ins>. Native AdMob is
// untouched by any of this — these helpers are read only on web.

/** The AdSense publisher id (ca-pub-…), or null when not yet configured. */
export function getAdSenseClient() {
  const client = import.meta.env?.VITE_ADSENSE_CLIENT;
  return client && String(client).trim() ? String(client).trim() : null;
}

/** Optional banner ad-unit slot id; null until AdSense issues one. */
export function getAdSenseBannerSlot() {
  const slot = import.meta.env?.VITE_ADSENSE_BANNER_SLOT;
  return slot && String(slot).trim() ? String(slot).trim() : null;
}

/** True when AdSense is configured and real units should render. */
export function isAdSenseEnabled() {
  return getAdSenseClient() !== null;
}
