import React, { useEffect } from 'react';
import { createPortal } from 'react-dom';
import { motion, useReducedMotion } from 'framer-motion';
import { Capacitor } from '@capacitor/core';

// BottomNavBar — the app-wide persistent bottom navigation bar (home redesign
// "Option A", approved by David 2026-07-26). It is PURELY ADDITIVE: it relocates
// the four home-body destination entry points (Blitz / Leaderboards / Stats /
// Friends) plus Home into one fixed bar. No existing component is restyled — the
// bar is new chrome that rides above the AdMob banner, mirroring how the top
// chrome (bell / hamburger / Save-Stats) is mounted in routing/Layout.jsx.
//
// Presentational: the parent (Layout) decides the active tab from the current
// route + the Friends-overlay state and supplies `onSelect`, so this component
// holds no routing/app state of its own. Custom neon SVG icons + per-tab accent
// come straight from the approved artifact.
//
// PORTALED to document.body (like the top chrome): #root is a momentum-scroll
// container (overflow-y:auto + -webkit-overflow-scrolling:touch, index.css), and
// on Android WebView / iOS a `position:fixed` descendant of that container gets
// painted INTO the scrolling surface (it rides the page instead of pinning). The
// top chrome hit exactly this (David, 2026-07-13); rendering the bar as a child
// of <body> — outside the scroll container — pins it to the true viewport.

// The five tabs, in fixed order: Home · Blitz · Leaderboards (center) · Stats ·
// Friends. `page` is the route name (createPageUrl target); Friends has NO route
// — it opens the existing FriendsScreen overlay, so its page is null and the
// parent wires it to the overlay instead of navigating.
// Per-tab neon accents. Beta-2 refinement (2026-07-26): each was nudged a touch
// MORE SATURATED (kept its identity hue) so the bar reads more vividly on device
// without changing which colour belongs to which tab —
//   home  cyan   #38e0ff → #22e3ff   blitz pink  #f472b6 → #ff5cb8
//   board gold   #fcd34d → #ffcf2e   stats blue  #7cc4ff → #5bb6ff
//   friends green #4ade80 → #2ff08a
export const NAV_TABS = [
  { id: 'home', label: 'Home', page: 'Game', color: '#22e3ff' },
  { id: 'blitz', label: 'Blitz', page: 'HeadToHead', color: '#ff5cb8' },
  { id: 'board', label: 'Leaderboards', page: 'Leaderboard', color: '#ffcf2e' },
  { id: 'stats', label: 'Stats', page: 'Statistics', color: '#5bb6ff' },
  { id: 'friends', label: 'Friends', page: null, color: '#2ff08a' },
];

// Bar height in px — exported so the ad/safe-area reservation (index.css
// --u37-nav-reserved, set at runtime by the mount) stays in sync with the bar.
export const BOTTOM_NAV_HEIGHT = 62;

// The bar's `bottom` offset — how far its bottom edge sits above the physical
// screen bottom, so it lands FLUSH on the AdMob banner's top edge. This is
// platform-aware because the two native platforms position the banner
// differently, and --ad-reserved-bottom (set by GlobalAdManager = banner height
// + banner margin) does NOT capture the difference:
//
//   • ANDROID — the banner is anchored at the physical bottom plus a 55px margin
//     that GlobalAdManager already folds into --ad-reserved-bottom (h + 55). So
//     that var alone equals the banner's top-edge distance from the physical
//     bottom. max(safe, ad) is correct: the ad reservation wins once loaded, and
//     the gesture inset (--safe-bottom) wins before it loads. ADDING safe-bottom
//     here would float the bar a gesture-inset above the ad — the exact S21 gap
//     the 1.0.280 flush change fixed; keep max() so that fix stands.
//
//   • iOS — the banner margin is 0 and AdMob lays the banner out INSIDE the safe
//     area: its bottom sits above the home-indicator inset. So the banner's true
//     top-edge distance from the physical bottom is safe-bottom + banner height,
//     but --ad-reserved-bottom only carries the banner height (margin 0). With
//     max(), the banner height (~50px) beats the inset (~34px) and the bar lands
//     safe-bottom too LOW — the ad overlaps its bottom edge. That was the 1.0.280
//     iOS regression. Adding --safe-bottom restores the inset the banner floats
//     above, so the bar clears the ad in every ad-load state (no ad → reservation
//     is 0, offset collapses to safe-bottom, still clearing the home indicator).
//
//   • WEB — both vars are 0, so either form yields 0 and the bar pins to the
//     very bottom.
//
// Exported (pure, platform in → CSS string out) so the offset math is unit-
// testable per platform without depending on the CSSOM (happy-dom drops
// max()/calc() inline values on serialize).
export function navBarBottomOffset(platform) {
  return platform === 'ios'
    ? 'calc(var(--safe-bottom, 0px) + var(--ad-reserved-bottom, 0px))'
    : 'max(var(--safe-bottom, 0px), var(--ad-reserved-bottom, 0px))';
}

// Custom neon icons — verbatim path data from the approved artifact, one 24x24
// symbol per tab. Rendered as inline <svg> so each inherits the tab's accent via
// `stroke:currentColor` (the tab sets color to its accent).
const NAV_ICONS = {
  home: (
    <>
      <path d="M12 2.5 21 8v8.5L12 22 3 16.5V8z" />
      <path d="M9 21v-6h6v6" />
    </>
  ),
  // Two crossed swords (lucide-react `Swords`, v0.475 geometry inlined so it
  // inherits the tab's neon stroke/glow like the other custom icons — the old
  // path set read as crossed hammers/tools on device, David 2026-07-26).
  blitz: (
    <>
      <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5" />
      <line x1="13" x2="19" y1="19" y2="13" />
      <line x1="16" x2="20" y1="16" y2="20" />
      <line x1="19" x2="21" y1="21" y2="19" />
      <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5" />
      <line x1="5" x2="9" y1="14" y2="18" />
      <line x1="7" x2="4" y1="17" y2="20" />
      <line x1="3" x2="5" y1="19" y2="21" />
    </>
  ),
  board: (
    <>
      <path d="M7 4h10v5a5 5 0 0 1-10 0z" />
      <path d="M7 6H4v1a3 3 0 0 0 3 3" />
      <path d="M17 6h3v1a3 3 0 0 1-3 3" />
      <path d="M12 14v3" />
      <path d="M8.5 21h7" />
      <path d="M10 17h4l1 4H9z" />
    </>
  ),
  stats: (
    <>
      <path d="M4 20h16" />
      <path d="M7 20v-6" />
      <path d="M12 20V8" />
      <path d="M17 20v-9" />
    </>
  ),
  friends: (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 20a5.5 5.5 0 0 1 11 0" />
      <circle cx="17" cy="8.5" r="2.4" />
      <path d="M15.5 14.4A4.6 4.6 0 0 1 21 20" />
    </>
  ),
};

function NavTab({ tab, active, onSelect, reduce, locked = false }) {
  const { id, label, color } = tab;
  // Inactive = the accent muted toward the neutral slate (#7c8aa3), so every tab
  // still reads with a hint of its identity color; active = the full accent.
  const inactiveColor = `color-mix(in srgb, ${color} 60%, #7c8aa3)`;

  return (
    <motion.button
      type="button"
      role="tab"
      aria-selected={active}
      aria-current={active ? 'page' : undefined}
      aria-label={locked ? `${label}, locked — create a free account` : label}
      data-locked={locked ? 'true' : undefined}
      onClick={() => onSelect(tab)}
      whileTap={reduce ? undefined : { scale: 0.9 }}
      className="relative flex flex-col items-center justify-center gap-1 min-h-[44px] touch-manipulation bg-transparent border-0"
      style={{ color: active ? color : inactiveColor }}
    >
      {/* Active top indicator — a crisp neon accent line pinned to the bar's top
          edge. Beta-2 amp (2026-07-26): a touch wider with a bright white-hot
          core (gradient) + a stronger two-step glow so the active tab reads
          instantly, without going gaudy. */}
      {active && (
        <span
          aria-hidden="true"
          className="absolute top-0 rounded-full"
          style={{
            width: 34,
            height: 3,
            background: `linear-gradient(90deg, transparent, ${color} 22%, color-mix(in srgb, ${color} 55%, #fff) 50%, ${color} 78%, transparent)`,
            boxShadow: `0 0 8px ${color}, 0 0 18px color-mix(in srgb, ${color} 70%, transparent)`,
          }}
        />
      )}
      {/* Active radial glow behind the icon/label. pointer-events off. Beta-2 amp:
          brighter + slightly larger bloom so the active tab visibly pops. */}
      {active && (
        <span
          aria-hidden="true"
          className="absolute inset-0 pointer-events-none"
          style={{
            background: `radial-gradient(66% 66% at 50% 32%, color-mix(in srgb, ${color} 28%, transparent), transparent 72%)`,
          }}
        />
      )}
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="23"
        height="23"
        fill="none"
        stroke="currentColor"
        strokeWidth={active ? 2.2 : 1.9}
        strokeLinecap="round"
        strokeLinejoin="round"
        style={{
          // Beta-2 amp: a stronger two-layer glow on the ACTIVE icon (a tight
          // core + a wider bloom) so it reads as clearly lit, not just tinted.
          filter: active
            ? `drop-shadow(0 0 6px ${color}) drop-shadow(0 0 12px color-mix(in srgb, ${color} 65%, transparent))`
            : `drop-shadow(0 0 4px color-mix(in srgb, ${color} 45%, transparent))`,
        }}
      >
        {NAV_ICONS[id]}
      </svg>
      {/* Soft-wall lock badge (approved mockup screen 8): a guest sees the tab,
          and that it unlocks with an account. */}
      {locked && (
        <span
          aria-hidden="true"
          data-testid={`nav-lock-${id}`}
          className="absolute flex items-center justify-center rounded-full"
          style={{ top: 2, right: '50%', marginRight: -20, width: 15, height: 15, background: '#0b0f26', border: '1.5px solid #8a82b5' }}
        >
          <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#c9c1ee" strokeWidth="3.2" strokeLinecap="round">
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
        </span>
      )}
      <span
        className="whitespace-nowrap font-extrabold"
        style={{
          fontSize: 9,
          letterSpacing: '0.02em',
          // Beta-2 amp: light the ACTIVE label with its accent so it matches the
          // brightened icon/indicator; inactive labels stay clean (no shadow).
          textShadow: active ? `0 0 7px color-mix(in srgb, ${color} 60%, transparent)` : undefined,
        }}
      >
        {label}
      </span>
    </motion.button>
  );
}

/**
 * The persistent bottom navigation bar.
 *
 * @param {{
 *   activeId: string|null,          // which tab id is active (null = none)
 *   onSelect: (tab: {id:string,label:string,page:string|null,color:string}) => void,
 *   lockedIds?: string[],           // tabs a guest cannot open (soft wall, 2026-10-10)
 * }} props
 */
export default function BottomNavBar({ activeId, onSelect, lockedIds = [] }) {
  const reduce = useReducedMotion();

  // While the bar is mounted (Layout mounts it only when visible), tell the CSS
  // how much bottom space page scroll regions + band-escaping modals must clear:
  //  • --u37-nav-reserved = the bar's own height (--u37-nav-h) above the ad band.
  //  • --u37-bottom-reserved = the bar's REAL platform-aware bottom offset — the
  //    SAME expression navBarBottomOffset gives the bar's `bottom`. Content and
  //    modals subtract this instead of a fixed safe+ad sum so they track the bar
  //    exactly. On Android the bar sits at max(safe, ad); a fixed safe+ad
  //    over-reserves by min(safe, ad) — the visible gap between page content and
  //    the bar once the AdMob banner loads (the S21 1.0.280 regression this fixes).
  // Both are cleared on unmount so drill-downs / gameplay leave no dead band —
  // --u37-bottom-reserved is REMOVED (not zeroed) so the CSS fallback (safe+ad,
  // matching #root's padding) applies. Same runtime-var pattern as
  // --ad-reserved-bottom.
  useEffect(() => {
    const root = document.documentElement;
    const platform = Capacitor.getPlatform();
    root.style.setProperty('--u37-nav-reserved', `${BOTTOM_NAV_HEIGHT}px`);
    root.style.setProperty('--u37-bottom-reserved', navBarBottomOffset(platform));
    return () => {
      root.style.setProperty('--u37-nav-reserved', '0px');
      root.style.removeProperty('--u37-bottom-reserved');
    };
  }, []);

  const bar = (
    <nav
      role="tablist"
      aria-label="Primary navigation"
      data-testid="bottom-nav-bar"
      className="fixed left-0 right-0"
      style={{
        // Sit FLUSH on top of the AdMob banner. The offset is platform-aware —
        // see navBarBottomOffset above for why iOS must add --safe-bottom
        // (banner floats above the home-indicator inset) while Android keeps
        // max() (its 55px margin is already in --ad-reserved-bottom). This is the
        // fix for the 1.0.280 iOS regression where the ad overlapped the bar.
        bottom: navBarBottomOffset(Capacitor.getPlatform()),
        height: 'var(--u37-nav-h, 62px)',
        // Above the Friends overlay (z-130) + notifications inbox (z-120) + the
        // top chrome (z-50) so tabs stay tappable from within the Friends screen
        // and the active tab reflects it. The bar is hidden during gameplay, so
        // it never covers an in-play board.
        zIndex: 140,
        display: 'grid',
        gridTemplateColumns: 'repeat(5, 1fr)',
        alignItems: 'stretch',
        background: 'linear-gradient(180deg, rgba(9,15,26,.78), rgba(6,10,18,.98))',
        borderTop: '1px solid rgba(255,255,255,.12)',
        backdropFilter: 'blur(10px)',
        WebkitBackdropFilter: 'blur(10px)',
        boxShadow: '0 -14px 26px -20px #000',
      }}
    >
      {NAV_TABS.map((tab) => (
        <NavTab
          key={tab.id}
          tab={tab}
          active={tab.id === activeId}
          onSelect={onSelect}
          reduce={reduce}
          locked={lockedIds.includes(tab.id)}
        />
      ))}
    </nav>
  );

  // Portal to <body> — same reason the top chrome is portaled (see header note).
  if (typeof document === 'undefined') return bar;
  return createPortal(bar, document.body);
}
