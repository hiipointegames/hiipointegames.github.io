import { isMember } from '@/auth';
import { useSector73Unlocked } from './useSector73Unlocked';
import { useSector73Enabled } from './sector73Switch';

/**
 * THE ONE RULE for "does this player have the home portal to Sector 73?" — shared by the
 * Mirror (useMirrorWarp, which renders the portal on the Game home) and the Layout (which
 * moves the notifications bell off the top-left corner while the portal sits there, and
 * lights a badge on the ☰ menu instead — David, 2026-10-20).
 *
 *   visible  ⇔  isMember(user)  &&  the master switch is ON  &&  the player has unlocked it
 *
 * NETWORK. A guest never asks the switch (useSector73Enabled(false) makes no read). A member
 * asks the switch — one read, cached and shared app-wide (sector73Switch.js). The unlock read
 * (a daily_challenge_times select) fires ONLY when the player is a member AND the switch is ON:
 * while the switch is OFF or still unresolved, the user id passed down is null, and
 * useSector73Unlocked makes no read for a null id. A cached unlock on the device never shows
 * the portal while OFF or for a guest (`&& active`).
 *
 * Imported DIRECTLY by Layout (`@/sector73/useSector73PortalVisible`), not through the
 * `@/sector73` barrel: the barrel carries the Mirror overlays, which the entry chunk does not
 * need. This file reaches only the switch, the unlock hook and mirror.js.
 *
 * @param {Record<string, any> | null | undefined} user the signed-in player (raw auth user or me() shape)
 * @param {unknown} [refreshKey] change it to re-read the unlock
 * @returns {{ active: boolean, userId: string | null, unlocked: boolean }}
 *   active   — a member with Sector 73 switched ON (the Mirror may act at all)
 *   userId   — the id the unlock is read/written for (null unless active)
 *   unlocked — the portal is visible
 */
export function useSector73Portal(user, refreshKey) {
  const member = isMember(user);
  const s73On = useSector73Enabled(member); // always called (hook order); a guest never reads
  const active = member && s73On;
  const userId = active ? (user?.id ?? null) : null;
  const unlocked = useSector73Unlocked(userId, refreshKey) && active;
  return { active, userId, unlocked };
}

/**
 * Is the home portal to Sector 73 showing for this player? See useSector73Portal.
 * @param {Record<string, any> | null | undefined} user
 * @param {unknown} [refreshKey]
 * @returns {boolean}
 */
export function useSector73PortalVisible(user, refreshKey) {
  return useSector73Portal(user, refreshKey).unlocked;
}
