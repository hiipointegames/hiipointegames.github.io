// Craft predicates — pure "what shape was this solve?" detectors for the badge
// system redesign (Lane A).
//
// Every function here answers ONE structural question about a finished
// equation and nothing else: no thresholds, no ladders, no badge ids, no
// awarding, no UI, no I/O. The feat/ladder composition (and the composed feats
// Lightning Divide + Comeback Kid, which also need timing/streak inputs) lives
// in the badge layer, not here.
//
// Shared signature: `(equation, usedDiceIndices, diceColors)` — the exact inputs
// `isPerfectSolve` takes. `diceColors` is POSITIONAL (ADR-0002): the Nth number
// in equation order belongs to the die at `diceColors[usedDiceIndices[N]]`, and
// the colors mean:
//   blue  → this die must be a × or ÷ operand
//   green → this die must be a + or − operand
//   red   → this die must sit in an exponent
//
// Which feat each predicate backs (so the lanes line up):
//   greatDivide    → finishesOnBlueDivision
//   riseToPower    → finishesOnExponent
//   constellation  → parenClusterCount >= 3    (SEPARATE groups, not opening parens)
//   eventHorizon   → maxParenDepth >= 3
//   straightLine   → parenClusterCount === 0   (identical to the paren count at 0)
//   fullSpectrum   → usesAllFourOps
//   bigBang        → usesAllFourOpsWithExponent
//   overTheTop     → maxIntermediateMagnitude  (ladder 100 / 1k / 10k / 100k)
//   echoOf37       → highestEchoMultiple       (ladder 74 / 111 / 148 / 185 / 222)
//
// Robustness contract: NOTHING here throws. Anything malformed — empty string,
// a mid-build draft, unbalanced parens, missing dice arrays, a `÷+` unary trap —
// degrades to the safe default (`false` for the booleans, `0` for the numbers).
// That's enforced by `parseEquationAST`, which hands back `null` for any
// equation the evaluator itself would refuse to score.

import { parseEquationAST, getPowerDiceCorrectness } from './equationUtils';

/** @typedef {import('./equationUtils').EquationNode} EquationNode */

// The "echo of 37" ladder: 2×37 through 6×37. A solve that passes through one
// of these mid-flight is quietly a multiple of the target before it lands on it.
export const ECHO_MULTIPLES = Object.freeze([74, 111, 148, 185, 222]);

// Float slack for echo matching. Division can put a value a few ULPs off an
// integer (e.g. 666/3), so exact `===` would miss real hits.
const ECHO_EPSILON = 1e-9;

// Unicode → ASCII, mirroring the engine's own normalizer. Kept local (and
// trivially small) so the string-only predicates don't need the AST at all.
const toAscii = (equation) =>
  equation.replace(/×/g, '*').replace(/−/g, '-').replace(/÷/g, '/').replace(/＋/g, '+');

/**
 * Number every leaf with its position in EQUATION ORDER (0-based), which is the
 * index the positional dice contract is expressed in. An in-order walk of a
 * Pratt-built tree visits leaves left-to-right, so `left` before `right` is
 * exactly source order — the same walk `findFirstOperatorForNumbers` relies on.
 *
 * @param {EquationNode} ast
 * @returns {Map<EquationNode, number>} leaf node → its equation-order index
 */
const indexLeaves = (ast) => {
  /** @type {Map<EquationNode, number>} */
  const leaves = new Map();
  let next = 0;
  /** @param {EquationNode} node */
  const walk = (node) => {
    if (!node) return;
    if (node.type === 'number') {
      leaves.set(node, next++);
      return;
    }
    if (node.type === 'binary') {
      walk(node.left);
      walk(node.right);
    }
  };
  walk(ast);
  return leaves;
};

/**
 * The positional color of a LEAF node, or null if it isn't a leaf / the dice
 * inputs don't cover it. Non-power dice come back as 'white'.
 *
 * @param {EquationNode} node
 * @param {Map<EquationNode, number>} leaves
 * @param {number[]} usedDiceIndices
 * @param {readonly string[]} diceColors
 * @returns {string | null}
 */
const leafColor = (node, leaves, usedDiceIndices, diceColors) => {
  if (!node || node.type !== 'number') return null;
  if (!usedDiceIndices || !diceColors) return null;
  const leafIndex = leaves.get(node);
  if (leafIndex === undefined) return null;
  const diceIndex = usedDiceIndices[leafIndex];
  if (typeof diceIndex !== 'number') return null;
  return diceColors[diceIndex] ?? null;
};

/**
 * Evaluate EVERY subtree once, post-order, and return the node → value map.
 *
 * A node is recorded only when it (and everything under it) evaluates to a
 * finite number; a failed node is simply absent, and its already-computed
 * descendants stay in the map. Values are NOT rounded here — callers round what
 * they report, so intermediate rounding can't compound.
 *
 * @param {EquationNode} ast
 * @returns {Map<EquationNode, number>}
 */
const evaluateSubtrees = (ast) => {
  /** @type {Map<EquationNode, number>} */
  const values = new Map();
  /** @param {EquationNode} node @returns {number | null} */
  const walk = (node) => {
    if (!node) return null;
    if (node.type === 'number') {
      values.set(node, node.value);
      return node.value;
    }
    if (node.type !== 'binary') return null;
    const left = walk(node.left);
    const right = walk(node.right);
    if (left === null || right === null) return null;
    let value;
    switch (node.operator) {
      case '+': value = left + right; break;
      case '-': value = left - right; break;
      case '*': value = left * right; break;
      case '/':
        if (right === 0) return null;
        value = left / right;
        break;
      case '^': value = left ** right; break;
      default: return null;
    }
    if (!Number.isFinite(value)) return null;
    values.set(node, value);
    return value;
  };
  walk(ast);
  return values;
};

/**
 * Is the ROOT operation a division whose divisor is the blue die?
 *
 * Backs **Great Divide**: the player built one big value and landed on 37 by
 * dividing it with their ×/÷ die as the very last move. "Root" is the right
 * test for "last move" — the root of a precedence-correct AST is always the
 * operation evaluated last.
 *
 * The divisor must BE the blue die (a bare leaf), not a subtree that merely
 * contains it: `222/6` counts, `222/(3*2)` does not.
 *
 * @param {string} equation
 * @param {number[]} usedDiceIndices
 * @param {readonly string[]} diceColors
 * @returns {boolean}
 */
export const finishesOnBlueDivision = (equation, usedDiceIndices, diceColors) => {
  const ast = parseEquationAST(equation);
  if (!ast || ast.type !== 'binary' || ast.operator !== '/') return false;
  const leaves = indexLeaves(ast);
  return leafColor(ast.right, leaves, usedDiceIndices, diceColors) === 'blue';
};

/**
 * Was the RED exponent die the LAST die the player placed, and used correctly?
 *
 * Backs **Rise to Power** — design doc §4 #2: *"Red exponent die is the last die
 * placed — usedDiceIndices[last] = red position."* So this is a PLACEMENT-ORDER
 * test, not a tree-shape one:
 *
 *  1. the last entry of `usedDiceIndices` points at a red die, and
 *  2. the engine scores that die as used correctly — i.e. it sits in an
 *     exponent, per the same `getPowerDiceCorrectness` / `inExponent` logic
 *     that decides a perfect solve, so a red die never means one thing to the
 *     badge and another to the score.
 *
 * Deliberately NOT "the root op is `^`". 37 is not a perfect power, so a solve
 * that ends on a root exponent could only ever land on 37 via `X^1` — the strict
 * reading made the feat unreachable in real play. (David's call, 2026-07-30.)
 *
 * The equation must still be a well-formed, evaluable solve: a half-built draft
 * would otherwise be scored by the engine's simple string fallback.
 *
 * Note `getPowerDiceCorrectness` needs the FULL positional colour array (7
 * entries); a short array yields no correctness at all, hence `false`.
 *
 * @param {string} equation
 * @param {number[]} usedDiceIndices
 * @param {readonly string[]} diceColors
 * @returns {boolean}
 */
export const finishesOnExponent = (equation, usedDiceIndices, diceColors) => {
  if (!usedDiceIndices || !diceColors) return false;
  const lastPlaced = usedDiceIndices.length - 1;
  if (lastPlaced < 0) return false;

  const lastDie = usedDiceIndices[lastPlaced];
  if (typeof lastDie !== 'number' || diceColors[lastDie] !== 'red') return false;

  // Only score a finished equation — never a draft.
  if (!parseEquationAST(equation)) return false;

  // The correctness map is keyed by EQUATION-order number index, and the last
  // die placed is the last number in the equation. For a red die the map's
  // value IS the "sits in an exponent" verdict.
  return getPowerDiceCorrectness(equation, usedDiceIndices, diceColors).get(lastPlaced) === true;
};

/**
 * Deepest parenthesis NESTING in the equation (not how many groups — how deep).
 * `(1+2)*(3+4)` is depth 1; `((1+2)*3)+4` is depth 2.
 *
 * Backs **Event Horizon** (depth >= 3). Pairs with `parenClusterCount`, which
 * counts separate groups rather than depth and backs Constellation / Straight
 * Line — see that function for why the two were entangled until 2026-09-03.
 *
 * Purely a string measure — it never parses, so it stays honest on a
 * mid-build draft. A stray closing paren is ignored rather than driving the
 * depth negative.
 *
 * @param {string} equation
 * @returns {number} 0 when there are no parens (or the input isn't a string)
 */
export const maxParenDepth = (equation) => {
  if (typeof equation !== 'string' || equation.length === 0) return 0;
  let depth = 0;
  let deepest = 0;
  for (const char of equation) {
    if (char === '(') {
      depth++;
      if (depth > deepest) deepest = depth;
    } else if (char === ')' && depth > 0) {
      depth--;
    }
  }
  return deepest;
};

/**
 * How many SEPARATE parenthesis clusters the equation has — top-level groups,
 * not opening brackets.
 *
 * `(1+2)*(3+4)` is 2 clusters; `((1+2)*3)+4` is ONE cluster two levels deep;
 * `1+2` is 0.
 *
 * Backs **Constellation**, whose rungs are literally named One / Two / Three
 * Clusters, and whose `how` promises "one set, then two, then three or more".
 *
 * ---------------------------------------------------------------------------
 * WHY THIS EXISTS AND `parenGroupCount` DOES NOT ANSWER IT
 * ---------------------------------------------------------------------------
 * `parenGroupCount` (solveDaily.js) counts OPENING PARENS. That is the right
 * measure for the job it was written for — ranking candidate solves by
 * simplicity, where more brackets of any kind means a busier equation — but it
 * is not "how many groups", despite the name and the docblock.
 *
 * The consequence was a badge bug, not a cosmetic one. Nesting depth 3 implies
 * three opening parens, so **Event Horizon's "Three Deep" rung could never light
 * without Constellation's "Three Clusters" rung lighting too**: two families
 * sold to the player as opposites (depth vs breadth) were the same badge at the
 * top. Wave 1 found it and documented it in game-mechanics/craftFeats.js;
 * this is the fix.
 *
 * The fix is a NEW predicate rather than a change to `parenGroupCount`, because
 * that function has a second reader with a different need: `pickSolvePair`
 * (solveDaily.js) selects the forfeit screen's teaching examples by asking for
 * one solve with `parens === 0` and one with `parens === 1` — "flat, and a
 * single necessary bracket group". Under a cluster count, `((1+2)*3)+4` would
 * newly answer 1 and could be offered as the single-bracket teaching example,
 * which is exactly the equation that spec is avoiding. Two readers, two honest
 * measures, no shared lie.
 *
 * Purely a string measure like `maxParenDepth` — it never parses, so it stays
 * honest on a mid-build draft, and a stray closing paren is ignored rather than
 * opening a phantom cluster.
 *
 * @param {string} equation
 * @returns {number} 0 when there are no parens (or the input isn't a string)
 */
export const parenClusterCount = (equation) => {
  if (typeof equation !== 'string' || equation.length === 0) return 0;
  let depth = 0;
  let clusters = 0;
  for (const char of equation) {
    if (char === '(') {
      // A cluster opens only at the top level; every paren inside one is nesting.
      if (depth === 0) clusters++;
      depth++;
    } else if (char === ')' && depth > 0) {
      depth--;
    }
  }
  return clusters;
};

/**
 * Are all four basic operations (+ − × ÷) present?
 *
 * Backs **Full Spectrum**. Implicit multiplication counts: `4(3+2)` really is a
 * multiplication to the evaluator, so it is one here too — the check runs on the
 * same normalized string `evaluateEquation` scores.
 *
 * @param {string} equation
 * @returns {boolean}
 */
export const usesAllFourOps = (equation) => {
  if (typeof equation !== 'string' || equation.length === 0) return false;
  const normalized = toAscii(equation)
    .replace(/(\d)\(/g, '$1*(')
    .replace(/\)\(/g, ')*(')
    .replace(/\)(\d)/g, ')*$1');
  return ['+', '-', '*', '/'].every((op) => normalized.includes(op));
};

/**
 * All four basic operations AND an exponent — every operator the game offers,
 * in one equation.
 *
 * Backs **Big Bang**.
 *
 * @param {string} equation
 * @returns {boolean}
 */
export const usesAllFourOpsWithExponent = (equation) =>
  usesAllFourOps(equation) && typeof equation === 'string' && equation.includes('^');

/**
 * Is there an exponent in the equation at all?
 *
 * Backs **Tower** on the Easy On-Ramp, and it really is the whole test. `^` sits
 * on the operator pad in EVERY mode — `OperatorPad` takes a `mode` prop and never
 * reads it — so an Easy player can raise a die to a power despite Easy dealing no
 * red power die. The red die governs whether an exponent was placed *correctly*
 * for scoring (`finishesOnExponent`, `getPowerDiceCorrectness`); it has never
 * governed whether one is *available*. Tower's job is to tell a new player the
 * operator is there.
 *
 * Matches `usesAllFourOpsWithExponent`'s raw `includes('^')` rather than running
 * `toAscii` first: `^` is the only glyph the pad emits for a power, and it is
 * already ASCII, so there is no alternate form to fold.
 *
 * @param {string} equation
 * @returns {boolean}
 */
export const usesExponent = (equation) =>
  typeof equation === 'string' && equation.includes('^');

/**
 * The largest ABSOLUTE value any subtree of the equation evaluates to — how far
 * from 37 the player travelled on the way to 37.
 *
 * Backs **Over the Top** (ladder 100 / 1k / 10k / 100k). Every subtree counts,
 * including the leaves (a die) and the root (the final 37) — with the ladder
 * starting at 100, neither can ever be the maximum in a real solve, so
 * including them costs nothing and keeps the rule simple to state.
 *
 * `usedDiceIndices` / `diceColors` are unused — magnitude is colour-blind. They
 * stay in the signature so every predicate in this file is callable with the
 * one `isPerfectSolve`-shaped argument list.
 *
 * @param {string} equation
 * @param {number[]} [usedDiceIndices] - unused; signature symmetry only
 * @param {readonly string[]} [diceColors] - unused; signature symmetry only
 * @returns {number} 0 for anything the evaluator won't score
 */
export const maxIntermediateMagnitude = (equation, usedDiceIndices, diceColors) => {
  const ast = parseEquationAST(equation);
  if (!ast) return 0;
  let largest = 0;
  for (const value of evaluateSubtrees(ast).values()) {
    const magnitude = Math.abs(value);
    if (magnitude > largest) largest = magnitude;
  }
  return Math.round(largest * 1000) / 1000;
};

/**
 * The highest multiple of 37 (74 / 111 / 148 / 185 / 222) the solve passes
 * through MID-FLIGHT, or 0 if it passes through none.
 *
 * Backs **Echo of 37**: hitting 148 on the way to 37 is a small piece of
 * craft, and hitting a bigger multiple is a bigger one.
 *
 * Two exclusions keep the feat honest:
 *  1. **The final answer.** The root is where you LAND, not somewhere you pass
 *     through, so it never counts.
 *  2. **The Great-Divide dividend.** When the solve finishes by dividing with
 *     the blue die (see {@link finishesOnBlueDivision}), the dividend is 37×N by
 *     arithmetic necessity — `222/6` can't help but "reach" 222. Awarding Echo
 *     for that would be paying twice for one idea, so that one node's value is
 *     skipped. Its DESCENDANTS still count: reaching 148 inside the dividend is
 *     a genuinely separate move.
 *
 * @param {string} equation
 * @param {number[]} usedDiceIndices
 * @param {readonly string[]} diceColors
 * @returns {number} the highest multiple reached, or 0
 */
export const highestEchoMultiple = (equation, usedDiceIndices, diceColors) => {
  const ast = parseEquationAST(equation);
  if (!ast) return 0;

  const leaves = indexLeaves(ast);
  const isGreatDivide =
    ast.type === 'binary' &&
    ast.operator === '/' &&
    leafColor(ast.right, leaves, usedDiceIndices, diceColors) === 'blue';
  const excludedDividend = isGreatDivide && ast.type === 'binary' ? ast.left : null;

  let highest = 0;
  for (const [node, value] of evaluateSubtrees(ast)) {
    if (node === ast) continue;                 // where you land, not a waypoint
    if (node === excludedDividend) continue;    // already paid for as Great Divide
    for (const multiple of ECHO_MULTIPLES) {
      if (multiple > highest && Math.abs(value - multiple) < ECHO_EPSILON) {
        highest = multiple;
      }
    }
  }
  return highest;
};
