// The $37 weekly giveaway — the facts, in one place.
//
// SOURCE OF TRUTH IS THE WEBSITE, NOT THIS FILE. The official rules live at
// CONTEST.rulesUrl and are maintained by Bryce on the .com site. Everything here
// is the short promotional summary plus the link out; if the two ever disagree,
// the website wins and this file is the thing that is wrong.
//
// That is a deliberate choice (David, 2026-09-05): duplicating the full rules
// in the app would create exactly the drift that left the how-to-play page
// describing three modes months after there were six. One canonical page, one
// link to it.
//
// NATIVE IS NOW ON (David, 2026-09-11, for the 1.0.301 beta). It was web-only
// from 2026-09-05 until then; the two reasons it waited are recorded at
// NATIVE_ENABLED below along with what changed, because "why is this visible in
// the app now" is the first question anyone will ask of this file.

import { Capacitor } from '@capacitor/core';

import { isCredentialedAccount, hasContactableEmail, isGuest } from '@/auth';
import { emailVerificationRequired } from './emailVerifiedFrom';
import { EMAIL_CODE_COPY } from './emailCodeCopy';

/**
 * The promotional facts. Kept minimal on purpose — anything that could change
 * (odds, extensions, how winners are contacted) belongs on the rules page, not
 * in a shipped bundle.
 */
export const CONTEST = Object.freeze({
  /** The official rules. An anchor on the .com homepage, not a standalone page —
   *  verified 2026-09-05: /prize, /contest, /giveaway and /rules all 404, and the
   *  apex 308-redirects to www, so this is the canonical form. */
  rulesUrl: 'https://www.37themathpuzzle.com/#prize',
  prize: '$37',
  /** How many entries ONE PLAYER can earn in a day — one per Daily mode.
   *
   *  ⚠️ THE NUMBER HAS NOT MOVED SINCE 2026-09-10 BUT ITS MEANING HAS INVERTED,
   *  so read this before reusing it anywhere.
   *
   *  Originally the giveaway ran on the fastest EXPERT Daily and nothing else,
   *  which quietly excluded every player who cannot solve Expert from a prize
   *  the app advertises to all of them. On 2026-09-10 it opened to all three
   *  modes, and 3 meant "entries the whole player base generates in a day" —
   *  one per mode, awarded to that mode's fastest solver. A week produced 21
   *  entries in total, across everyone.
   *
   *  ON 2026-09-17 SPEED STOPPED MATTERING (David). Anyone who COMPLETES a
   *  Daily is entered, so 3 is now the number of entries a SINGLE PLAYER can
   *  earn in a day, and the week's total is unbounded — it is however many
   *  entries every eligible player between them earns.
   *
   *  So "21" now means "the most one player can hold in a week", NOT "the
   *  entries that exist". Anything still reading 21 as a total is wrong.
   *
   *  The cap is real rather than conventional: a player gets ONE attempt at
   *  each Daily per day (David's ruling 2026-07-13, enforced server-side by
   *  submit-daily-time), so three modes is three entries and there is no
   *  fourth to be had. */
  qualifyingModeCount: 3,
  /** Stated so the promo is accurate before, during and after the run without
   *  needing date logic (David chose an always-visible promo he removes by hand).
   *
   *  20 September is a SUNDAY and 27 February is a SATURDAY, which makes the run
   *  exactly 23 whole Sun–Sat weeks — 23 drawings, no ragged part-week at either
   *  end. The end date moved from 1 March (a Monday) to the nearest Saturday;
   *  27 February is two days away and 6 March is five. */
  startsOn: '20 September 2026',
  endsOn: '27 February 2027',
  /** The ENTRY WINDOW and the DRAWING, which the app did not state at all until
   *  now (David, 2026-09-11: "correct dates, entry info, and competition
   *  windows"). Start/end alone answers "is it running?" and leaves the two
   *  questions a player actually has unanswered: how long do I have, and when do
   *  I find out.
   *
   *  Verified against the rules page the same day rather than reasoned from the
   *  dates here — this file is the SUMMARY, the .com page is the source (see the
   *  header). It reads: "One winner is randomly selected every Sunday by 9:00pm
   *  EST and announced on all of our social channels", over an entry period that
   *  runs "from Sunday through Saturday".
   *
   *  EST is quoted as the page writes it. The app says ET everywhere else
   *  because the daily itself rolls over on Eastern *clock* time (`todayET`),
   *  which is EDT for the first six weeks of the run — writing "EST" in the app
   *  would put a one-hour error in front of the player for most of the autumn. */
  weekWindow: 'Sunday–Saturday',
  drawnOn: 'every Sunday by 9pm ET',
  /** 23 whole Sun–Sat weeks between startsOn and endsOn. Stated rather than
   *  computed: a date calculation here could disagree with the rules page, and
   *  the rules page wins by definition. */
  drawings: 23,
  /** The giveaway is not open to everyone, and the promo says so up front.
   *
   *  ⚠️ "account required" IS LOAD-BEARING, not padding. The official rules
   *  (fetched 2026-09-05) read: "Players must be at least 18 years old and must
   *  live in the United States. You also need a saved account, meaning a custom
   *  username, a password, and an email address attached to the account, so that
   *  we can contact you for payment information."
   *
   *  The first draft of this line said only "18+, US only". That reads as the
   *  COMPLETE list, so a player concludes they qualify and never clicks through
   *  — and this app starts every visitor as an anonymous guest, so the fastest
   *  Expert Daily solve on a given day can very easily belong to someone who was
   *  never eligible. Measured on prod the same day: 1,540 of 1,576 accounts were
   *  anonymous guests. A partial eligibility line is worse than none.
   *
   *  ⚠️ AND IT WAS STILL PARTIAL until 2026-09-12. "account required" covered the
   *  username and password but silently dropped the EMAIL, which the quoted rules
   *  above require in the same sentence — "so that we can contact you for payment
   *  information". Meanwhile the welcome screen advertised "Username + password —
   *  no email needed" one row above the giveaway row, and the sign-up form marks
   *  Email "(optional)" with helper text about password resets and nothing about
   *  the prize.
   *
   *  So a player could read this line, create an account with no email, win the
   *  $37, and be unpayable — having been told they qualified. Exactly the failure
   *  the paragraph above describes, one clause further down. Both surfaces now
   *  say it, and both take the words from here. */
  eligibility: '18+, US only, account with email',
});

/**
 * Native is ON as of 2026-09-11 (David, for the 1.0.301 beta: "I want the
 * information in there about the sweepstakes").
 *
 * ⚠️ IT WAS OFF ON PURPOSE, AND THE TWO REASONS HAVE NOT GONE AWAY — they were
 * weighed and accepted rather than disproved. Whoever reads this next should
 * know what was traded:
 *
 *   1. STORE POLICY. Both the App Store and Play have explicit sweepstakes
 *      rules. The promo does not collect entries, take payment or run the
 *      drawing — it states the terms and links to the official rules, which is
 *      the shape both stores permit — but it is still a giveaway promo inside a
 *      shipped app and a reviewer may treat it as a new flag. It ships by OTA
 *      first (CapGo), so it reaches players without passing review; the exposure
 *      begins at the NEXT native store submission, which is the moment to
 *      re-read this.
 *
 *   2. THE APPS SHIP WORLDWIDE; the giveaway is 18+ and US-only. This is why
 *      `eligibility` is rendered on the banner face rather than hidden behind
 *      the link — a player outside the US learns it costs them nothing, before
 *      they click.
 *
 * Exported so a test can assert the SHIPPED value rather than trusting a
 * comment, which is the whole point of it being a named constant.
 */
export const NATIVE_ENABLED = true;

/**
 * Should the contest promo render on this platform?
 *
 * @param {{ isNative?: boolean }} [deps] injectable for tests
 * @returns {boolean}
 */
export function isContestPromoVisible({ isNative } = {}) {
  const native = isNative === undefined ? Capacitor.isNativePlatform() : isNative;
  return native ? NATIVE_ENABLED : true;
}

/** The one-line promo, assembled so the banner and the drawer cannot disagree. */
export const CONTEST_HEADLINE = `Win ${CONTEST.prize} — weekly giveaway`;

/** The supporting line. States what actually qualifies you.
 *
 *  ⚠️ "FINISH", NOT "FASTEST" (2026-09-17). Speed used to decide entry — only a
 *  mode's fastest solver was entered. It no longer does: finishing the Daily is
 *  the whole bar. This line is the most-read statement of the mechanic in the
 *  app (banner, detail sheet, and the banner's aria-label), so a stale
 *  "fastest" here tells most of the player base they cannot win when they can.
 *
 *  The three mode names stay, for the reason they were added on 2026-09-11: a
 *  player who only solves Easy needs to see Easy named or they assume the prize
 *  is not for them. And it is still "ANY", not "EACH" — one Daily enters you;
 *  three is three entries, not a requirement.
 *
 *  "your time does not matter" is doing real work and is not padding. Every
 *  other mention of a Daily in this app is about speed — podiums, leaderboards,
 *  streaks, personal bests — so a player who reads "finish any Daily" against
 *  that background will still assume a good time is implied. */
export const CONTEST_BLURB =
  'Finish any Daily — Easy, Challenge or Expert — and you are in that week\'s drawing. '
  + 'No purchase necessary, and your time does not matter.';

/** The small print, shown on the promo itself rather than hidden behind the link. */


export const CONTEST_TERMS =
  // ⚠️ CONTEST_VOID is NOT appended here. This string rides the home CHIP,
  // which is length-guarded for a real reason — it has to fit two lines on a
  // phone without growing the launcher. The legal lines live in the details
  // sheet beside the sponsor disclaimer, which is one tap away and already
  // carries the claim and payment terms.
  `${CONTEST.startsOn} – ${CONTEST.endsOn} · ${CONTEST.eligibility}`;


/** The competition window — its own line, because it answers a different
 *  question from the run dates and reads as noise appended to them.
 *
 *  "Entries reset" rather than "the week runs": the fact a player needs is that
 *  missing Tuesday does not cost them the week, and that a new week is a clean
 *  slate. Naming the deadline and the draw in one sentence is what makes the
 *  promo actionable on the day someone reads it. */
export const CONTEST_WINDOW =
  `Entries reset weekly (${CONTEST.weekWindow}) · Winner drawn ${CONTEST.drawnOn}`;

/** The window, squeezed onto one 10px line for the home-screen chip.
 *
 *  The chip has room for the prize and ONE more fact, so this is the one that
 *  earns it: a deadline is the only part of a giveaway that is urgent. Run dates
 *  and eligibility answer questions a player has not asked yet, and they are a
 *  tap away in ContestDetails.
 *
 *  ⚠️ THIS IS A SECOND HAND-WRITTEN COPY OF THE SAME FACT, which is exactly the
 *  duplication this file's header warns about. It is not derived from
 *  `weekWindow`/`drawnOn` because no honest abbreviation of "Sunday–Saturday"
 *  and "every Sunday by 9pm ET" falls out of a string operation — it needs a
 *  human. The mitigation is a DRIFT TEST (contest.test.js) asserting the chip
 *  and the long form still agree on the load-bearing tokens: the day the week
 *  closes, and the hour of the drawing. Change one and the test names the other. */
export const CONTEST_CHIP_LINE = 'Sun–Sat week · drawn Sundays 9pm ET';

/**
 * HOW YOU CLAIM, AND THE DEADLINE THAT CAN COST YOU THE PRIZE.
 *
 * ⚠️ THIS WAS MISSING FROM THE APP ENTIRELY until 2026-09-12, and it is the one
 * omission in this module that could take money off a player.
 *
 * The .com rules carry a section the app did not: HiiPointe emails the winner,
 * sends **at most two** emails, and the winner has **four weeks** from the first
 * one to reply with payment details — after which "the prize is forfeited".
 *
 * The whole design of this app is that a player can enter, qualify and WIN
 * without ever opening the website: the giveaway is won by solving a Daily, and
 * every surface that mentions it is in-app. So a player could do all of that,
 * miss two emails that landed in spam, lose the $37 at four weeks, and never
 * have been shown the deadline on any screen they actually saw.
 *
 * That is why this is stated in the app rather than left behind the rules link,
 * which is the default for everything else here (see the file header). The bar
 * this clears is not "did we publish it somewhere" — it is "did the player who
 * can lose by it ever get told".
 *
 * It also happens to be the most persuasive thing we can show if App Review ever
 * questions guideline 5.3.2 ("official rules ... must be presented in the app"),
 * but that is a side effect. The fairness argument stands on its own.
 *
 * The spam-folder line is load-bearing, not padding: it is the single most
 * likely reason a real winner misses both emails, and it is the only part of
 * this the player can do anything about in advance.
 */
export const CONTEST_CLAIM =
  'HiiPointe Games LLC emails you from contactus@hiipointegames.com (two emails max). '
  + 'Reply with payment details within 4 weeks of the first, or the prize is forfeited. '
  + 'Check spam.';

/**
 * HOW THE PRIZE IS ACTUALLY PAID.
 *
 * Same omission, same reason it matters: "Venmo or Zelle, no exceptions" is a
 * term a player can fail to meet. Someone who has neither cannot be paid, and
 * the app advertises the prize to them anyway. Cheap to state, and it is the
 * second question every real winner asks after "did I win".
 *
 * Kept separate from CONTEST_CLAIM rather than folded into one paragraph: they
 * answer different questions ("what happens next" vs "how does the money
 * arrive") and the detail sheet renders one labelled Fact per question, which
 * is what lets a player find the answer without reading the other one.
 */
export const CONTEST_PAYMENT = 'Venmo or Zelle only, sent by HiiPointe Games LLC.';

/**
 * THE PLATFORM SPONSOR DISCLAIMER. This one is a CONTRACTUAL OBLIGATION, not
 * copy — which is why it is a frozen constant with its own tests rather than a
 * sentence typed into a component.
 *
 * Apple Developer Program License Agreement §3.3.4(A)(vi) requires that we
 * "clearly state in binding official rules for each promotion that Apple is not
 * a sponsor of, or responsible for conducting, the promotion." Google Play's
 * policy carries an equivalent requirement. Verified absent 2026-09-11: the word
 * "sponsor" appeared nowhere in this file, nowhere else in src/, and nowhere on
 * 37themathpuzzle.com.
 *
 * ⚠️ THIS BECAME URGENT THE DAY THE PROMO WENT NATIVE. It was arguably academic
 * while `NATIVE_ENABLED` was false and the promo rendered only in a browser.
 * That flag flipped to true on 2026-09-11 (see NATIVE_ENABLED), so the promotion
 * is now surfaced inside the shipped iOS and Android apps — which is exactly the
 * condition the PLA clause is about. The promotion opens 20 September 2026.
 *
 * ⚠️ AND THE APP IS THE SMALLER HALF. The clause says "binding official rules",
 * and the binding official rules live on the .com site, not here (see the file
 * header: the website is the source of truth and this module is a summary). The
 * app carrying it is good practice and costs nothing; the .com page carrying it
 * is the part that actually discharges the obligation, and that page is Bryce's.
 * Shipping this constant does NOT close the requirement on its own.
 *
 * Naming both stores in one sentence is deliberate: a disclaimer that names only
 * Apple invites the reasonable reading that Google IS involved.
 */
export const CONTEST_SPONSOR_DISCLAIMER =
  'Sponsor. This promotion is sponsored solely by HiiPointe Games LLC. It is not '
  + 'sponsored, endorsed, administered by, or associated with Apple Inc. or Google '
  + 'LLC. Apple is not a sponsor of, and is not responsible for conducting, this '
  + 'promotion.';

/** Label used by every entry point, so they read identically. */
export const CONTEST_LINK_LABEL = 'Official Contest Rules';


// ---------------------------------------------------------------------------
// THE ACCOUNT REQUIREMENT
// ---------------------------------------------------------------------------

/**
 * Does this account meet the giveaway's ACCOUNT requirement?
 *
 * Deliberately NOT called `isEligible`. Eligibility also requires being 18+ and
 * a US resident, and the app knows neither — naming this function after the
 * whole rule would invite a future caller to treat a `true` here as "this player
 * can win", which it is not. It answers exactly one third of the question.
 *
 * The rules require "a custom username, a password, and an email address
 * attached to the account". A credentialed account always carries a username
 * (CreateAccountForm sets both together), so the two things worth checking are
 * the credential and a REAL email — the form makes email optional and fills in a
 * synthetic address when it is skipped.
 *
 * @param {{is_anonymous?: boolean, email?: string} | null | undefined} user
 * @returns {boolean}
 */
export function meetsContestAccountRequirement(user) {
  return isCredentialedAccount(user) && hasContactableEmail(user);
}

/**
 * The nudge shown to a player who cannot enter as things stand.
 *
 * States the REASON rather than just the action. "Save your account" alone does
 * not explain why a giveaway banner is asking, and a player who has already
 * dismissed generic save-your-stats prompts has no reason to treat this one
 * differently.
 */
export const CONTEST_ACCOUNT_PROMPT =
  'You are playing as a guest — save an account with an email to be eligible.';

/** The button that opens the existing save-account flow. */
export const CONTEST_ACCOUNT_CTA = 'Save your account';

/**
 * The same nudge for a player who ALREADY has an account but no reachable
 * email. A different sentence on purpose — telling someone with a username and
 * a password to "save your account" reads as though the app has forgotten them.
 */
export const CONTEST_EMAIL_PROMPT =
  'Your account has no email — add one to be eligible.';

/** The button that opens the add-email flow. */
export const CONTEST_EMAIL_CTA = 'Add your email';

/**
 * Which nudge, if any, this viewer should see.
 *
 * Returns 'account' for a guest, 'email' for a credentialed account with only a
 * synthetic address, 'age' for an account that has both but has never affirmed
 * it is 18+ and in the US, and null for a player who needs nothing.
 *
 * ORDER IS LOAD-BEARING and runs cheapest-blocker-first: a guest needs an
 * account before an email is even meaningful, and both before the affirmation
 * is worth asking for. Showing a guest 'age' would be asking them to confirm
 * eligibility for a draw they still cannot enter.
 *
 * One function rather than three booleans at the call site, because the states
 * are mutually exclusive and a component asking them separately can render more
 * than one — which is exactly the bug this shape prevents.
 *
 * ⚠️ 'declined' WAS ADDED 2026-09-17 AND IT IS NOT A NUDGE. It is the absence
 * of one: a player who answered no has made a decision, and the app owes them
 * not asking again. It is returned rather than null so the ONE surface that
 * should still react — the contest sheet, where they can change their mind —
 * can tell "said no" from "already eligible". Everywhere else must treat it the
 * same as null.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {'account' | 'email' | 'age' | 'declined' | null}
 */
export function contestNudgeFor(user) {
  if (meetsContestEligibility(user)) return null;
  if (!meetsContestAccountRequirement(user)) return isGuest(user) ? 'account' : 'email';
  // Account and email are in place. Either they said no, or they have not been
  // asked — and those now mean different things.
  if (hasDeclinedContestEligibility(user)) return 'declined';
  return 'age';
}

// ---------------------------------------------------------------------------
// THE ELIGIBILITY ATTESTATION — "I am 18 or older and I live in the US"
// ---------------------------------------------------------------------------

/**
 * WHY THIS EXISTS, AND WHY IT IS NOT AN AGE GATE.
 *
 * Until 2026-09-17 the rules said 18+ and US-only and the app never ASKED. The
 * two facts sat side by side and nothing reconciled them: the entry mechanic is
 * "post the fastest time on a Daily", the store rating is 13+, the apps ship
 * worldwide, and roughly 97% of accounts are anonymous guests. So most players
 * who topped a podium were structurally ineligible for a prize the app was
 * actively advertising to them, and the rules were silent on what happened next.
 *
 * `eligibility` above was the app DISPLAYING the requirement. This is the app
 * COLLECTING it. Those are different things and only the second one is evidence.
 *
 * ⚠️ THIS IS NOT A COPPA AGE SCREEN, AND MUST NOT BE MISTAKEN FOR ONE. A COPPA
 * age screen has to be NEUTRAL — it may not nudge the reader toward an answer.
 * This one deliberately nudges: it tells the player that ticking it is how they
 * get entered into a $37 draw, which is the opposite of neutral. That is correct
 * for a sweepstakes eligibility affirmation (the standard shape) and wrong for
 * an age screen. If the under-13 COPPA question ever needs answering, it needs
 * its OWN neutral month/year-of-birth screen; this checkbox will not do it and
 * shipping it does not close that question. See
 * `.workshop/legal/age-18-plus-research-2026-09-16.md`.
 */

/** Where the attestation lives on the user.
 *
 *  ⚠️ `user_metadata` IS CLIENT-WRITABLE (`supabase.auth.updateUser`), and that
 *  is normally a reason NOT to put something here — a player once unlocked the
 *  daily-reveal gate by self-declaring a completion in metadata. The distinction
 *  that makes it acceptable HERE is worth stating plainly, because the next
 *  reader will recognise the shape and reach for a fix that is not needed:
 *
 *    This value is an ATTESTATION, not an AUTHORISATION.
 *
 *  There is no server-side truth about the player's age for a client write to
 *  contradict. A player who lies by ticking the box and a player who lies by
 *  calling `updateUser` directly have done exactly the same thing — made a false
 *  statement about themselves. The legal value of an affirmation comes from the
 *  entrant having made it, not from us being unable to fake it on their behalf.
 *
 *  What client-writability DOES cost is tamper-evidence of the timestamp. For a
 *  $37 weekly draw that is proportionate. If the prize ever grows enough that a
 *  disputed entry is worth arguing over, move the write behind an edge function
 *  so the server stamps the time — note that edge deploys are release-gated
 *  (see CLAUDE.md), so that is a planned change, not a quick one. */
export const CONTEST_ELIGIBILITY_META_KEY = 'contest_eligibility';

/** The checkbox label. One sentence, both conditions, no legalese — a player has
 *  to be able to tell at a glance whether it is true of them.
 *
 *  ⚠️ PHRASED AS AN ELIGIBILITY STATEMENT, NOT AN AGE QUESTION, AND THAT IS A
 *  LEGAL DISTINCTION RATHER THAN A STYLISTIC ONE. "I am 18 or older and I live
 *  in the United States" is a sweepstakes affirmation. "How old are you?" would
 *  be an age screen — and a COPPA age screen has to be NEUTRAL, which this
 *  deliberately is not: the helper text tells the player that answering yes is
 *  what enters them in a draw.
 *
 *  So this wording is load-bearing. Reframing it as a question about age would
 *  build something that LOOKS like an age gate without meeting the standard for
 *  one. See .workshop/legal/age-18-plus-research-2026-09-16.md. */
export const CONTEST_AGE_CONFIRM_LABEL =
  'I am 18 or older and I live in the United States';

/** The question, asked on the signup form where it must be ANSWERED rather than
 *  noticed. Kept separate from the label above because a required choice reads
 *  as a question and an optional tick reads as a statement. */
export const CONTEST_AGE_QUESTION =
  'Are you 18 or older and living in the United States?';

/** The two answers. "No" is a first-class outcome, not a refusal — see
 *  CONTEST_AGE_REASSURANCE for why it has to look like one. */
export const CONTEST_AGE_YES = 'Yes';
export const CONTEST_AGE_NO = 'No';

/** The line that makes "No" safe to press.
 *
 *  ⚠️ WITHOUT THIS THE REQUIRED QUESTION IS A TRAP. A player who is 16, or in
 *  Canada, faces a mandatory question on a signup form with no visible
 *  consequence for either answer — and the safe-looking move is to lie, because
 *  a wrong "no" might mean no account. Saying plainly that the game is
 *  unaffected is what makes an honest "no" cost nothing, and an honest answer
 *  is the entire reason for asking. */
export const CONTEST_AGE_REASSURANCE = Object.freeze({
  // ONE block for all three surfaces that ask (copy-condense, 2026-10-18): the
  // signup form, the guided signup's age step and the ask-once dialog each used
  // to word it differently. Rendered head (bold, green) / body / foot (small).
  // "decides if you see" is accurate since 2026-10-10: contestVisibility hides
  // the giveaway after a "No".
  head: 'Either answer keeps the full game.',
  body: `It only decides if you see the ${CONTEST.prize} giveaway (US, 18+).`,
  foot: 'Change it any time in your profile.',
});

/** Shown once a player has answered no, wherever they might want to undo it.
 *  People turn 18, move, and mis-tap. */
export const CONTEST_AGE_DECLINED_NOTE =
  'You told us you are not eligible for the giveaway, so we have stopped asking. '
  + 'Nothing else about the game is affected.';

/** The control that reverses it. */
export const CONTEST_AGE_UNDECLINE_CTA = 'I am 18+ and in the US after all';

/**
 * THE OTHER DIRECTION, added 2026-09-17 at David's request.
 *
 * ⚠️ Until now the answer was a ONE-WAY DOOR. A player could go from "no" to
 * "yes" here, and from "never asked" to "yes" — but a player who had said yes
 * had no way to say no, anywhere in the app. That is the direction that
 * actually matters legally: a yes is a declaration that they are 18+ and in the
 * US, and someone who realises they answered wrongly, or whose circumstances
 * change, was left declaring something untrue every week with no way to
 * withdraw it.
 *
 * Phrased as a withdrawal rather than a re-ask, and deliberately quiet — it sits
 * under the terms for the player looking for it, not in front of the player who
 * is happily entered.
 */
export const CONTEST_AGE_WITHDRAW_CTA = 'I am not eligible after all';

/** Shown once they withdraw, so the change visibly took. */
export const CONTEST_AGE_WITHDRAWN_NOTE =
  'Thanks — we have stopped entering you in the giveaway. Nothing else about '
  + 'the game changes, and you can turn it back on here any time.';

/** The line under the checkbox.
 *
 *  ⚠️ "Optional" and "required to be entered" have to BOTH be here, and the
 *  order matters. David's instruction was that the box is optional but that
 *  players must know ticking it is what puts them in the draw. A checkbox
 *  labelled only "optional" reads as skippable padding and gets skipped — which
 *  would quietly produce the exact state this change exists to end, a player who
 *  qualifies, plays all season and cannot be entered. */
export const CONTEST_AGE_CONFIRM_HELP =
  `Optional — but you must tick this to be entered into the weekly ${CONTEST.prize} `
  + 'giveaway. We cannot enter you without it, however many Dailies you finish.';

/** The nudge shown to a player who has an account and an email but has never
 *  confirmed. Separate sentence from the other two nudges on purpose: telling
 *  someone who already has a full account to "save your account" reads as
 *  though the app has forgotten them. */
export const CONTEST_AGE_PROMPT =
  'One thing left — confirm you are 18+ and in the US, or we cannot enter you.';

/** The control that records it. Written in the first person because ticking it
 *  IS the statement; a neutral button label like "Confirm" would leave the
 *  player unsure what they just asserted. */
export const CONTEST_AGE_CTA = CONTEST_AGE_CONFIRM_LABEL;

/**
 * HOW ENTRIES ADD UP.
 *
 * ⚠️ THIS REPLACED `CONTEST_NEXT_ELIGIBLE` ON 2026-09-17 AND THE OLD CONSTANT IS
 * GONE ON PURPOSE. That one described a fallback — "if the fastest solver is not
 * eligible, the entry passes to the next fastest" — which existed only because
 * entry was a podium prize with exactly one holder per mode per day. Entry is no
 * longer scarce or contested, so there is nothing to pass to anybody: an
 * ineligible player's completion simply earns nothing, and takes nothing from
 * anyone else. Leaving a renamed version of that rule in place would have
 * described machinery the promotion no longer has.
 *
 * Stated in the app rather than left behind the rules link because it is the
 * fact that changes what a player DOES today: three Dailies is three entries,
 * and the ceiling is reachable by anyone who shows up, not just by the fast.
 */
export const CONTEST_ENTRY_RULE =
  'One per Daily finished — Easy, Challenge, Expert. One attempt each, so max 3 a day, '
  + '21 a week. Entries reset each Sunday; nothing carries over.';

/**
 * WHAT DOES NOT EARN AN ENTRY.
 *
 * Two traps, and the second one is new as of this rule change.
 *
 * The first is eligibility: finishing a Daily while under 18, outside the US,
 * without a saved account and email, or without the affirmation, earns nothing.
 * A player in that state still sees their time on the podium, which is exactly
 * the surface that would otherwise persuade them they were entered.
 *
 * The second is PRACTICE, and it only became dangerous when speed stopped
 * mattering. While entry meant "post the fastest time of the day", nobody could
 * mistake an untimed Practice round with unlimited re-rolls for a qualifying
 * one. Now that finishing is the whole bar, "I solved it" feels identical in
 * both places — and Practice is the mode a player reaches for when they want to
 * solve something. Naming it is cheap; discovering it in February is not.
 */
export const CONTEST_NO_ENTRY =
  'Practice rounds. Dailies finished while ineligible (under 18, outside the US, no '
  + 'account with email, or 18+/US not confirmed) — even if your time is on the podium. '
  + "Becoming eligible later doesn't count past Dailies.";

/**
 * WHICH WEEK EACH SUNDAY'S DRAWING COVERS.
 *
 * ⚠️ THE AMBIGUITY THIS EXISTS TO KILL: the entry week runs Sunday to Saturday
 * and the drawing happens "every Sunday", so a Sunday is BOTH the day after one
 * week closes and the first day of the next. Every reader resolves that on their
 * own and roughly half of them will resolve it the wrong way — then believe a
 * Daily they finished that morning was in the draw held that evening.
 *
 * David's ruling, 2026-09-17, stated in his own terms: "the contest opens on the
 * 20th. On the 27th, the following Sunday, we will draw a winner from the 7 days
 * of the 20th, 21st, 22nd, 23rd, 24th, 25th, and 26th."
 *
 * So: the drawing on any Sunday covers the seven days that ENDED the day before.
 * Anything you finish on the Sunday of a drawing belongs to the NEXT week's.
 *
 * The two dates are stated rather than computed. Both were checked against a
 * calendar: 20 September 2026 is a Sunday, the 23rd entry week ends Saturday
 * 27 February 2027, and its drawing therefore falls on Sunday 28 February —
 * one day AFTER the run's stated end date, which is exactly the sort of detail
 * an entrant notices and nobody thinks to write down.
 */
export const CONTEST_DRAW_SCHEDULE =
  'Each Sunday draws from the Sun–Sat week just ended. First: Sun 27 Sep 2026 (20–26 Sep). '
  + 'Last: Sun 28 Feb 2027. A Daily finished on a drawing Sunday counts toward the next week.';

/**
 * Has this player affirmed they are 18+ and in the US?
 *
 * Reads both the merged shape and the raw `user_metadata` shape, because
 * `apiClient.auth.me()` spreads metadata onto the top level for convenience and
 * callers hold whichever object they happened to be given.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {boolean}
 */
export function hasConfirmedContestEligibility(user) {
  if (!user) return false;
  const record = user[CONTEST_ELIGIBILITY_META_KEY]
    ?? user.user_metadata?.[CONTEST_ELIGIBILITY_META_KEY];
  return record?.confirmed_18_us === true;
}

/**
 * The value to write when a player ANSWERS the eligibility question.
 *
 * ⚠️ THIS TOOK AN ANSWER AS OF 2026-09-17 AND USED TO ASSUME ONE. It only ever
 * wrote `true`, because the only way to reach it was ticking a box — so "said
 * no" and "was never asked" were the same absence, and the app could not tell
 * them apart.
 *
 * That cost something real: a player who had decided not to enter got the
 * "this Daily earned you nothing" notice after EVERY Daily, for ever, because
 * nothing recorded the decision. Three states fix that. `false` is a decision,
 * and a decision can be respected.
 *
 * A function rather than an inline object literal at the call sites, so no two
 * of them can drift into writing different shapes — which would leave the
 * readers below disagreeing about a player's own answer.
 *
 * @param {boolean} answer true = 18+ and US, false = not eligible
 * @param {Date} [now] injectable for tests
 * @returns {{confirmed_18_us: boolean, confirmed_at: string}}
 */
export function buildContestEligibilityAttestation(answer, now = new Date()) {
  // Coerced deliberately. A caller that passes undefined is a caller that has
  // not actually asked the player anything, and the safe reading of "no answer"
  // on a prize is "not eligible" — never an accidental yes.
  return { confirmed_18_us: answer === true, confirmed_at: now.toISOString() };
}

/**
 * Has this player said they are NOT eligible?
 *
 * Distinct from "has not confirmed", which is the absence of an answer. The
 * difference is the whole point of the three states: this one is a decision the
 * player made, and the app owes them not asking again.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {boolean}
 */
export function hasDeclinedContestEligibility(user) {
  if (!user) return false;
  const record = user[CONTEST_ELIGIBILITY_META_KEY]
    ?? user.user_metadata?.[CONTEST_ELIGIBILITY_META_KEY];
  return record?.confirmed_18_us === false;
}

/**
 * Has this player answered the question at all, either way?
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {boolean}
 */
export function hasAnsweredContestEligibility(user) {
  return hasConfirmedContestEligibility(user) || hasDeclinedContestEligibility(user);
}

/**
 * Does this player meet EVERY requirement the app is able to check?
 *
 * Deliberately a different function from `meetsContestAccountRequirement`, which
 * answers only the account question and is named for it. This one is the whole
 * of what the app knows: a credentialed account, a reachable email, and the
 * affirmation.
 *
 * Still not the same as "this player can win" — we take the affirmation at its
 * word, and the draw itself is run against the official rules.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {boolean}
 */
export function meetsContestEligibility(user) {
  return meetsContestAccountRequirement(user) && hasConfirmedContestEligibility(user);
}
// ---------------------------------------------------------------------------
// WHY THIS PLAYER IS NOT ELIGIBLE — all of it, not just the next step
// ---------------------------------------------------------------------------

/**
 * EVERY reason this player cannot be entered, not merely the first one.
 *
 * ⚠️ THIS IS DELIBERATELY NOT `contestNudgeFor`, AND BOTH ARE KEPT. They answer
 * different questions and the difference matters:
 *
 *   contestNudgeFor      → "what is the ONE next thing to do?"  (a control)
 *   contestEligibilityGaps → "why am I not eligible?"           (an explanation)
 *
 * The nudge is right where there is room for one line and one tap. It is wrong
 * when the player has just finished a Daily and needs to understand why it
 * earned them nothing — "save your account" answers a question they did not ask
 * and hides the fact that an email and the affirmation are also outstanding. A
 * guest who fixes only what the nudge showed them, plays again the next day and
 * is STILL not entered has been misled by a technically-true message.
 *
 * David asked for this shape on 2026-09-17: something that tells an active
 * player they are not eligible "because of x y or z reasons".
 *
 * Order is fix-order, not severity: an email is meaningless without an account,
 * and the affirmation is meaningless without either. Rendering them in this
 * order means working down the list always terminates.
 *
 * ⚠️ 'verify' (from 25 Oct 2026, emailVerifiedFrom.js) appears ONLY when the
 * caller passes `emailVerified: false`, the server's own answer. Unknown
 * (`null`/absent) adds nothing: a failed read must never tell a verified
 * player they are missing entries. Callers that pass nothing get the old list.
 *
 * @param {Record<string, any> | null | undefined} user
 * @param {{ emailVerified?: boolean|'grace'|null, today?: string }} [opts]
 * @returns {{code: 'account'|'email'|'verify'|'age', reason: string, cta: string}[]}
 *   empty when the player meets everything the app can check
 */
export function contestEligibilityGaps(user, { emailVerified = null, today } = {}) {
  /** @type {{code: 'account'|'email'|'verify'|'age', reason: string, cta: string}[]} */
  const gaps = [];

  if (isGuest(user)) {
    gaps.push({
      code: 'account',
      reason: "You're a guest — entries need an account.",
      cta: CONTEST_ACCOUNT_CTA,
    });
  }

  if (!hasContactableEmail(user)) {
    gaps.push({
      code: 'email',
      // Named consequence rather than "no email on file": the email is not an
      // administrative detail, it is the only way a winner can be paid.
      reason: "No email — we couldn't tell you that you won.",
      cta: CONTEST_EMAIL_CTA,
    });
  }

  // Only a real, saved address can be verified; without one the 'email' gap
  // above is the fix, and asking for a code too would be a dead end.
  if (emailVerified === false && !isGuest(user) && hasContactableEmail(user)
    && emailVerificationRequired(today)) {
    gaps.push({ code: 'verify', reason: EMAIL_CODE_COPY.gapReason, cta: EMAIL_CODE_COPY.gapCta });
  }

  if (!hasConfirmedContestEligibility(user)) {
    // Two different sentences, because they are two different situations. A
    // player who SAID NO is not missing a step — they answered, and telling
    // them they have "not confirmed" would read as the app ignoring them.
    gaps.push(hasDeclinedContestEligibility(user)
      ? {
        code: 'age',
        reason: 'You told us you are not 18 or living in the United States.',
        cta: CONTEST_AGE_UNDECLINE_CTA,
      }
      : {
        code: 'age',
        reason: '18+ and US not confirmed.',
        cta: CONTEST_AGE_CTA,
      });
  }

  return gaps;
}

/** The heading over that list. States the consequence in the first four words,
 *  because a player who reads nothing else should still learn the thing that
 *  costs them something. */
export const CONTEST_GAPS_TITLE = "This Daily didn't earn an entry";

/** The line under the list. Carries the non-retroactive rule, which is the
 *  whole reason the notice is worth showing at this moment rather than later:
 *  fixing it tomorrow does not recover today. */
export const CONTEST_GAPS_FOOTER =
  "Fixes count from now on — played Dailies can't be added.";
