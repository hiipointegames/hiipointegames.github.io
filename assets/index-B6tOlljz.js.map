import * as React from "react"
import { Slot } from "@radix-ui/react-slot"
import { cva } from "class-variance-authority";

import { cn } from "@/ui/utils"
import { playSound } from "@/ui/feedback"

const buttonVariants = cva(
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0",
  {
    variants: {
      variant: {
        default:
          "bg-primary text-primary-foreground shadow hover:bg-primary/90",
        destructive:
          "bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90",
        outline:
          "border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground",
        secondary:
          "bg-secondary text-secondary-foreground shadow-sm hover:bg-secondary/80",
        ghost: "hover:bg-accent hover:text-accent-foreground",
        link: "text-primary underline-offset-4 hover:underline",
      },
      size: {
        default: "h-9 px-4 py-2",
        sm: "h-8 rounded-md px-3 text-xs",
        lg: "h-10 rounded-md px-8",
        icon: "h-9 w-9",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
)

/**
 * @typedef {Object} ButtonProps
 * @property {string} [className]
 * @property {"default" | "destructive" | "outline" | "secondary" | "ghost" | "link"} [variant]
 * @property {"default" | "sm" | "lg" | "icon"} [size]
 * @property {boolean} [asChild]
 * @property {React.ReactNode} [children]
 * @property {(e: any) => void} [onClick]
 * @property {(e: any) => void} [onPointerDown]
 * @property {boolean} [disableDefaultSound]
 * @property {boolean} [disabled]
 * @property {"button" | "submit" | "reset"} [type]
 * @property {React.CSSProperties} [style]
 */

/**
 * @type {React.ForwardRefExoticComponent<ButtonProps & React.RefAttributes<HTMLButtonElement>>}
 */
const Button = React.forwardRef(({ className, variant, size, asChild = false, disableDefaultSound = false, onClick, onPointerDown, ...props }, ref) => {
  const Comp = asChild ? Slot : "button"

  const lastPlayedRef = React.useRef(0);
  const handlePointerDown = (e) => {
    // Play sound on the very first touch/click interaction point for maximum reliability on Android
    const now = Date.now();
    if (!disableDefaultSound && now - lastPlayedRef.current > 150) {
      playSound('buttonTap');
      lastPlayedRef.current = now;
    }
    if (onPointerDown) onPointerDown(e);
  };

  const handleClick = (e) => {
    // We removed the sound from handleClick because we moved it to handlePointerDown 
    // for better responsiveness and Android compatibility.
    if (onClick) onClick(e);
  };

  return (
    (<Comp
      className={cn(buttonVariants({ variant, size, className }))}
      ref={ref}
      onClick={handleClick}
      onPointerDown={handlePointerDown}
      {...props} />)
  );
})
Button.displayName = "Button"

export { Button, buttonVariants }
