// The cosmic-neon recipe the guided signup draws with — the same one the home
// Daily button and the three-Dailies pop-up use (dark cosmic panel, accent wash
// from the top, 3px neon border, halo, inset highlight, white glowing text).
// Each signup step has its own accent, in mode-colour order (approved mockup).

export const STEP_ACCENT = Object.freeze({
  username: 'var(--u37-green)',
  password: 'var(--u37-cyan)',
  age: 'var(--u37-violet)',
  email: 'var(--u37-gold)',
  referral: 'var(--u37-cyan)',
  country: 'var(--u37-magenta)',
  done: 'var(--u37-green)',
});

/** A lit neon button / surface in `c`. */
export const neonSurface = (c, wash = 30) => ({
  background: `linear-gradient(180deg, color-mix(in srgb, ${c} ${wash}%, transparent), transparent 70%), var(--u37-panel-bg-cosmic)`,
  border: `3px solid ${c}`,
  boxShadow: `0 0 26px -6px ${c}, inset 0 1px 5px rgba(255,255,255,0.28)`,
});

/** White text glowing in `c`. */
export const neonText = (c) => ({ color: 'white', textShadow: `0 0 10px ${c}` });

/** A neon-outlined input well in `c`. */
export const neonField = (c) => ({
  border: `2px solid ${c}`,
  background: 'var(--u37-panel-bg-cosmic)',
  boxShadow: `0 0 20px -8px ${c}`,
});
