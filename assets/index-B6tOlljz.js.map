/**
 * Centralized Configuration for Game Milestones and Thresholds
 * 
 * FLIP THIS BOOLEAN TO `true` FOR TESTING STREAKS/BADGES COMPRESSED
 * FLIP THIS BOOLEAN TO `false` BEFORE SHIPPING TO PRODUCTION
 */
export const IS_TESTING_MODE = false;
export const SHOW_SHUFFLE_BUTTON = false;

// -------------------------------------------------------------
// STREAKS
// -------------------------------------------------------------

// Ultimate-UI ladder retune (2026-07-02, approved by David): gentle early
// on-ramp for frequent early wins (3/7/14) + brand "37" mid-rung + long-tail
// (100/365). Replaces the old [7,25,50,100,200,365] which had an 18-day dead
// zone between rungs 1 and 2. Six tiers (icon configs are fixed at six).
export const STREAK_MILESTONES = IS_TESTING_MODE
    ? [1, 2, 3, 4, 5, 6]
    : [3, 7, 14, 37, 100, 365];

export const PERFECT_MILESTONES = IS_TESTING_MODE
    ? [1, 2, 3, 4, 5, 6]
    // Retuned to align rung 1 with the streak ladder (3) and keep the 37 anchor.
    : [3, 7, 14, 37, 100, 365];

// -------------------------------------------------------------
// POINTS (BRONZE, SILVER, GOLD)
// -------------------------------------------------------------

// Retune: keep 37 bronze (brand), raise silver/gold to repdigit "slot" targets
// (111/222) for a touch more gold prestige. Both point families move together.
export const PUZZLE_POINTS = IS_TESTING_MODE
    ? { BRONZE: 1, SILVER: 2, GOLD: 3 }
    : { BRONZE: 37, SILVER: 111, GOLD: 222 };

export const BATTLE_POINTS = IS_TESTING_MODE
    ? { BRONZE: 1, SILVER: 2, GOLD: 3 }
    : { BRONZE: 37, SILVER: 111, GOLD: 222 };
// -------------------------------------------------------------
// VISUAL CONFIGURATIONS
// -------------------------------------------------------------

// 8B: each achievement category owns a DISTINCT, crisp palette that flows cleanly
// from its weakest to its strongest tier, so the three sections read as different
// families at a glance and each section is a coherent gradient run:
//   • Streak  → WARM "heat" ramp (amber → orange → red → rose) — streaks are "on fire".
//   • Perfect → COOL "jewel" ramp (emerald → teal → cyan → blue → indigo) — puzzle gems.
//   • Time    → ELECTRIC "speed" ramp (slate → violet → fuchsia → pink) — velocity.
// All saturated (white label reads on every tier), theme-tied, not cartoony.
export const STREAK_ICON_CONFIGS = [
  { emoji: '🔥', color: 'from-yellow-300 via-amber-400 to-orange-500', glow: 'shadow-amber-400/50' },
