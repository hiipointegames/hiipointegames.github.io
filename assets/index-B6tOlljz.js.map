import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { Loader2, LogIn } from 'lucide-react';
import { apiClient } from '@/transport';
import { useNavigate } from 'react-router-dom';
import Starfield from '@/shell/Starfield';
import { Logo37 } from '@/dice-visuals';
import { CONTEST } from '@/contest';
import GuidedSignup from './guided-signup/GuidedSignup';

// First-run welcome (redesigned 2026-10-10, approved mockup). Three paths:
//   • Create free account — the guided, one-question-per-screen signup
//     (GuidedSignup): username → password → 18+/US → email → country.
//   • I have an account — Log in (/login).
//   • Just play today's Daily — stay a guest: the Daily and Practice are open,
//     identity features (podium, leaderboards, stats, battles…) are locked
//     until they sign up. Guest Daily times are still recorded (as "Guest ####").
/**
 * @param {{ isOpen: any, onClose: any, currentUsername?: any }} props
 */
export default function InitialWelcomeModal({ isOpen, onClose }) {
  const [view, setView] = useState('intro'); // 'intro' | 'create'
  const [guestLoading, setGuestLoading] = useState(false);
  const navigate = useNavigate();

  const handlePlayAsGuest = async () => {
    setGuestLoading(true);
    try {
      // Mark the welcome as seen so guests aren't re-prompted every navigation.
      // No username is set — they remain an anonymous guest that stores nothing.
      // Write ONLY game_stats. Supabase merges user_metadata by top-level key,
      // so sending the whole read-back object (as this did until 2026-10-20)
      // re-wrote every other key with whatever this read saw — and a write
      // landing in between from elsewhere (the 18+ answer, the three-Dailies
      // intro days) was silently reverted. Bug log 2026-10-20.
      const currentUser = await apiClient.auth.me();
      await apiClient.auth.updateMe({
        game_stats: {
          ...(currentUser?.user_metadata?.game_stats || {}),
          hasSeenInitialWelcomeModal: true,
        },
      });
    } catch (e) {
      console.warn('Could not record guest welcome-seen flag:', e);
    }
    setGuestLoading(false);
    onClose();
  };

  if (!isOpen) return null;

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 z-50 flex items-center justify-center p-4 u37-ad-safe-pb"
      >
        {/* Cosmic-neon backdrop: the shared animated starfield behind a soft scrim
            (this modal renders OUTSIDE the app Layout, so it needs its own copy of
            the global starfield to get the same starry surface as the home screen). */}
        <div className="absolute inset-0 overflow-hidden" aria-hidden="true">
          <Starfield />
          <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" />
        </div>
        <motion.div
          // Opacity/translate entrance ONLY — no `scale`. The Logo37 brand mark is
          // a filtered SVG (neon-glow feDropShadow); animating a transform over it
          // triggers the Android-webview compositing flicker that hit the home logo
          // (memory: home-logo flicker). Keeping the panel un-scaled means the 37
          // never renders under a transform, so it stays crisp and static.
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          exit={{ opacity: 0, y: 16 }}
          className="relative z-10 w-full max-w-md rounded-3xl p-5 overflow-y-auto border-2"
          style={{
            maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
            background: 'var(--u37-panel-bg-cosmic)',
            borderColor: 'color-mix(in srgb, var(--u37-violet) 55%, transparent)',
            boxShadow: '0 0 44px -12px var(--u37-violet), 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)',
          }}
        >
          {/* Header
              ─────────────────────────────────────────────────────────────────
              ⚠️ THE WHOLE SCREEN IS BUDGETED TO FIT WITHOUT SCROLLING.
              David, 2026-09-12: "make it so that you do not have to scroll to see
              the log in or continue as guest buttons." Those two are the LAST
              things on the panel, so every line above them is spending their
              visibility. It previously overran a 360x800 device and both buttons
              sat below the fold — on the first screen a new player ever sees.

              That is why the intro is one sentence rather than the old
              five-line paragraph, why the logo is 76 rather than 92, and why the
              benefit rows are tight. Adding a line here is not free: re-measure
              at 360x800 (initialWelcomeFit.test.jsx pins the budget) before
              growing anything. */}
          <div className="flex flex-col items-center text-center mb-4">
            {/* Brand mark — the 37 hexagon logo (replaces the platform 🎲 emoji,
                which rendered glitchy under a CSS drop-shadow on Android). */}
            <div className="w-[76px] h-[76px] flex items-center justify-center mb-1.5">
              <Logo37 size={76} />
            </div>
            {/* "The Math Puzzle" on its own line (David): the product is called
                "37 — The Math Puzzle", and the subtitle is what tells a first-time
                visitor what the app actually is. */}
            <h2 className="text-3xl font-black bg-gradient-to-r from-amber-300 via-yellow-400 to-orange-400 bg-clip-text text-transparent tracking-tight leading-none">
              Welcome to 37
            </h2>
            <div className="text-[11px] font-bold uppercase tracking-[0.3em] text-purple-100/80 mt-1 mb-2.5">
              The Math Puzzle
            </div>
            {/* The value line (approved mockup 2026-10-10). The eligibility line
                under it stays: CONTEST.eligibility exists because a partial
                promise ("win $37") reads as the complete terms — see contest.js. */}
            <p className="text-sm text-purple-100/90 leading-snug px-1">
              Save your streaks, see today&apos;s podium, battle friends — and win{' '}
              <span className="font-black" style={{ color: 'var(--u37-gold)' }}>{CONTEST.prize} every week</span>.
            </p>
            <p className="mt-1 text-[11px] text-slate-400" data-testid="welcome-eligibility">{CONTEST.eligibility} — so we can reach you if you win</p>
          </div>

          <div className="space-y-2.5">
            {/* Create — the guided, one-question-per-screen signup (2026-10-10). */}
            <button
              type="button"
              data-testid="welcome-create"
              onClick={() => setView('create')}
              className="w-full font-black text-lg min-h-[56px] touch-manipulation rounded-2xl active:scale-95"
              style={{
                color: 'white',
                textShadow: '0 0 10px var(--u37-green)',
                background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-green) 32%, transparent), transparent 70%), var(--u37-panel-bg-cosmic)',
                border: '3px solid var(--u37-green)',
                boxShadow: '0 0 26px -6px var(--u37-green), inset 0 1px 5px rgba(255,255,255,0.28)',
              }}
            >
              Create free account
            </button>

            {/* Returning players — prominent cyan outline (a tiny text link was missed). */}
            <Button
              data-testid="welcome-login"
              onClick={() => { if (onClose) onClose(); navigate('/login', { state: { allowLogin: true } }); }}
              className="w-full font-bold py-4 text-base min-h-[50px] touch-manipulation rounded-2xl flex items-center justify-center gap-2 active:scale-95"
              style={{
                color: 'var(--u37-cyan)',
                background: 'color-mix(in srgb, var(--u37-cyan) 12%, transparent)',
                border: '2px solid color-mix(in srgb, var(--u37-cyan) 70%, transparent)',
                boxShadow: '0 0 20px -8px var(--u37-cyan)',
              }}
            >
              <LogIn className="w-5 h-5" />
              I have an account — Log in
            </Button>

            {/* The no-login path stays one obvious tap (App Store 5.1.1(v)):
                guests can play the Daily and Practice; identity features are
                locked until they sign up (the soft wall). */}
            <button
              type="button"
              data-testid="welcome-just-play"
              onClick={handlePlayAsGuest}
              disabled={guestLoading}
              className="w-full min-h-[48px] flex flex-col items-center justify-center rounded-xl"
            >
              {guestLoading ? <Loader2 className="w-5 h-5 animate-spin text-slate-300" /> : (
                <>
                  <span className="text-[15px] font-extrabold text-purple-50">Just play today&apos;s Daily ›</span>
                  <span className="text-[12px] text-slate-400">No podium, stats or battles until you sign up</span>
                </>
              )}
            </button>
          </div>

          {view === 'create' && (
            <GuidedSignup
              onCancel={() => setView('intro')}
              onDone={(updatedUser) => onClose(updatedUser)}
              onLogin={() => { if (onClose) onClose(); navigate('/login', { state: { allowLogin: true } }); }}
            />
          )}
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}
