// The daily-challenge "day boundary" timezone.
//
// The whole app keys its notion of "today" off America/New_York — the
// daily challenge resets at ET midnight, and head-to-head expiry + stats
// displays all follow that same boundary. This module is the single home
// for that rule so the magic string isn't repeated ~40 times.
//
// Note: docs/architecture/lexicon.md currently describes the daily
// challenge date as UTC. The shipped behavior is ET (this module). The
// lexicon is the thing that's out of date, not the code — flagged for a
// lexicon fix, not a behavior change.

import moment from 'moment';
import 'moment-timezone';

export const DAILY_CHALLENGE_TZ = 'America/New_York';

// Current moment in the daily-challenge timezone. Use for comparisons
// (.isSame / .isAfter), custom formatting, or date arithmetic where the
// two named helpers below don't fit.
export function nowET() {
  return moment().tz(DAILY_CHALLENGE_TZ);
}

// Today's date in the daily-challenge timezone, as 'YYYY-MM-DD'.
// This is the canonical "what counts as today" for the daily challenge.
export function todayET() {
  return nowET().format('YYYY-MM-DD');
}

// Yesterday's date in the daily-challenge timezone, as 'YYYY-MM-DD'.
// Used by streak math to decide whether a solve continues a streak.
export function yesterdayET() {
  return nowET().subtract(1, 'days').format('YYYY-MM-DD');
}

// The current week's Monday in the daily-challenge timezone, as 'YYYY-MM-DD'.
// Uses ISO week (Monday-first), which is correct on EVERY weekday including
// Sunday. The old inline form — moment's locale `startOf('week')` (Sunday) plus
// a manual `+1 day` to "get Monday" — overshoots to NEXT Monday when today is a
// Sunday, producing a week window that starts after today and shows nothing (the
// "This Week's Daily Challenges is empty on Sundays" bug). This is the single
// home for "Monday of the current week" so the two profile pages can't drift.
export function startOfWeekET() {
  return nowET().startOf('isoWeek').format('YYYY-MM-DD');
}
