// Sector 73 sound effects, synthesized with the Web Audio API — 0 KB of files.
//
// Respects the app-wide mute preference (the same `soundMuted` flag playSound
// reads), so the in-game speaker toggle and the drawer's Mute Sound both apply.
// Every call is best-effort: a browser without Web Audio, or one that refuses to
// start audio before a gesture, just stays silent.

import { isSoundMuted } from '@/ui/feedback';

let ctx = null;

/** The shared AudioContext for sound effects (null when muted or unsupported). */
export const audioContext = () => audio();

let musicCtx = null;
/**
 * The MUSIC's own AudioContext, asking for bigger audio buffers (latencyHint 'playback'). The S21
 * heard static in the music (2026-10-14): a phone that can't refill a small buffer in time crackles.
 * Music doesn't need instant response, so it trades latency for smooth playback; sound effects keep
 * the low-latency context above. Null when muted or unsupported.
 */
export const musicContext = () => {
  if (isSoundMuted()) return null;
  try {
    const AudioCtx = globalThis.AudioContext || globalThis.webkitAudioContext;
    if (!AudioCtx) return null;
    if (!musicCtx) {
      try { musicCtx = new AudioCtx({ latencyHint: 'playback' }); } catch { musicCtx = new AudioCtx(); }
    }
    if (musicCtx.state === 'suspended') musicCtx.resume().catch(() => {});
    return musicCtx;
  } catch {
    return null;
  }
};

const audio = () => {
  if (isSoundMuted()) return null;
  try {
    const AudioCtx = globalThis.AudioContext || globalThis.webkitAudioContext;
    if (!AudioCtx) return null;
    ctx = ctx || new AudioCtx();
    if (ctx.state === 'suspended') ctx.resume().catch(() => {});
    return ctx;
  } catch {
    return null;
  }
};

/** A single enveloped oscillator note. */
const tone = (ac, { type = 'sine', from, to = from, start = 0, dur = 0.3, gain = 0.15 }) => {
  const t0 = ac.currentTime + start;
  const osc = ac.createOscillator();
  const amp = ac.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(from, t0);
  osc.frequency.exponentialRampToValueAtTime(Math.max(1, to), t0 + dur);
  amp.gain.setValueAtTime(0.0001, t0);
  amp.gain.exponentialRampToValueAtTime(gain, t0 + Math.min(0.05, dur / 3));
  amp.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
  osc.connect(amp).connect(ac.destination);
  osc.start(t0);
  osc.stop(t0 + dur + 0.02);
};

/** Filtered noise burst — whooshes and shatters. */
const noise = (ac, { start = 0, dur = 0.6, from = 400, to = 4000, gain = 0.2, q = 1 }) => {
  const t0 = ac.currentTime + start;
  const len = Math.max(1, Math.floor(ac.sampleRate * dur));
  const buf = ac.createBuffer(1, len, ac.sampleRate);
  const data = buf.getChannelData(0);
  for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
  const src = ac.createBufferSource();
  src.buffer = buf;
  const filter = ac.createBiquadFilter();
  filter.type = 'bandpass';
  filter.Q.value = q;
  filter.frequency.setValueAtTime(from, t0);
  filter.frequency.exponentialRampToValueAtTime(to, t0 + dur);
  const amp = ac.createGain();
  amp.gain.setValueAtTime(0.0001, t0);
  amp.gain.exponentialRampToValueAtTime(gain, t0 + dur * 0.3);
  amp.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
  src.connect(filter).connect(amp).connect(ac.destination);
  src.start(t0);
  src.stop(t0 + dur + 0.02);
};

const SOUNDS = {
  /** Glass crack + shatter. */
  shatter: (ac) => {
    noise(ac, { dur: 0.25, from: 6000, to: 2500, gain: 0.25, q: 4 });
    tone(ac, { type: 'triangle', from: 2400, to: 1200, dur: 0.18, gain: 0.08 });
    noise(ac, { start: 0.12, dur: 0.5, from: 5000, to: 900, gain: 0.18, q: 2 });
  },
  /** Rising warp-tunnel whoosh. */
  warp: (ac) => {
    noise(ac, { dur: 2.6, from: 150, to: 5000, gain: 0.22, q: 0.8 });
    tone(ac, { type: 'sawtooth', from: 55, to: 440, dur: 2.6, gain: 0.05 });
  },
  /** Soft arrival chime. */
  arrive: (ac) => {
    [523.25, 659.25, 783.99].forEach((f, i) => tone(ac, { from: f, start: i * 0.09, dur: 0.6, gain: 0.07 }));
  },
  /** Docking clamp: low thunk + chime. */
  dock: (ac) => {
    tone(ac, { type: 'square', from: 110, to: 70, dur: 0.15, gain: 0.08 });
    tone(ac, { from: 880, start: 0.1, dur: 0.35, gain: 0.06 });
  },
  /** UI blip. */
  blip: (ac) => tone(ac, { type: 'triangle', from: 660, to: 990, dur: 0.08, gain: 0.06 }),
  /** Success arpeggio. */
  success: (ac) => {
    [392, 523.25, 659.25, 1046.5].forEach((f, i) => tone(ac, { type: 'triangle', from: f, start: i * 0.08, dur: 0.4, gain: 0.07 }));
  },
  /** Failure buzz. */
  fail: (ac) => tone(ac, { type: 'sawtooth', from: 180, to: 90, dur: 0.35, gain: 0.07 }),
  /** Low thud for landings and accepted jumps (fx cues). */
  impact: (ac) => {
    tone(ac, { type: 'sine', from: 140, to: 40, dur: 0.28, gain: 0.22 });
    noise(ac, { dur: 0.18, from: 900, to: 200, gain: 0.08, q: 0.7 });
  },
  /** Rising shimmer as a constellation line ignites. */
  ignite: (ac, { pitch = 0 } = {}) => {
    const base = 520 * 2 ** (pitch / 12);
    tone(ac, { type: 'triangle', from: base, to: base * 1.5, dur: 0.22, gain: 0.07 });
    tone(ac, { type: 'sine', from: base * 2, to: base * 3, start: 0.04, dur: 0.18, gain: 0.03 });
  },
  /** A count-up tick; `pitch` 0..1 climbs as the number rises. */
  tick: (ac, { pitch = 0 } = {}) => tone(ac, { type: 'square', from: 900 + 700 * pitch, dur: 0.03, gain: 0.025 }),
};

/**
 * @param {keyof typeof SOUNDS} name
 * @param {{ pitch?: number }} [opts]  for pitched sounds (tick, ignite)
 */
export function playSynth(name, opts = {}) {
  const ac = audio();
  const sound = SOUNDS[name];
  if (!ac || !sound) return;
  try {
    sound(ac, opts);
  } catch {
    // Audio is decoration; never let it break play.
  }
}

/**
 * Continuous engine hum whose pitch/volume follow `throttle` (0..1).
 * @returns {{ set: (throttle: number) => void, stop: () => void }}
 */
export function createEngineHum() {
  const ac = audio();
  if (!ac) return { set: () => {}, stop: () => {} };
  try {
    const osc = ac.createOscillator();
    const lfo = ac.createOscillator();
    const lfoGain = ac.createGain();
    const amp = ac.createGain();
    osc.type = 'sawtooth';
    osc.frequency.value = 48;
    lfo.frequency.value = 7;
    lfoGain.gain.value = 3;
    lfo.connect(lfoGain).connect(osc.frequency);
    const filter = ac.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 300;
    amp.gain.value = 0.0001;
    osc.connect(filter).connect(amp).connect(ac.destination);
    osc.start();
    lfo.start();
    return {
      set(throttle) {
        const t = Math.max(0, Math.min(1, throttle));
        const now = ac.currentTime;
        amp.gain.setTargetAtTime(0.0001 + t * 0.035, now, 0.1);
        osc.frequency.setTargetAtTime(48 + t * 40, now, 0.15);
        filter.frequency.setTargetAtTime(300 + t * 700, now, 0.15);
      },
      stop() {
        try {
          amp.gain.setTargetAtTime(0.0001, ac.currentTime, 0.05);
          osc.stop(ac.currentTime + 0.2);
          lfo.stop(ac.currentTime + 0.2);
        } catch {
          // already stopped
        }
      },
    };
  } catch {
    return { set: () => {}, stop: () => {} };
  }
}
