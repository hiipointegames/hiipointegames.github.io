// Pure battle-resolution logic for head-to-head blitz battles.
//
// Extracted from two byte-identical blocks in HeadToHeadGame.jsx — the
// early-exit opponent-done branch and the both-players-done branch — which
// each inlined the same winner/tiebreaker decision and the same blitzStats
// increment. The orchestrator still owns the side effects (the
// HeadToHeadChallenge.update + auth.updateMe writes); this module owns only
// the decisions, so they live on one read path with exhaustive tests.

/**
 * Decide the winner of a finished battle.
 *
 * Higher score wins. On a tie with a non-zero score, the faster single solve
 * wins (tiebreaker). A 0-0 game — or a tie with no usable fastest times —
 * returns null (no winner). A fastest-solve time of 0 is treated as absent,
 * matching the original inlined behavior.
 *
 * @param {object} p
 * @param {number} p.myScore - my puzzles solved
 * @param {number} p.opponentScore - opponent's puzzles solved
 * @param {string} p.myId - my player id
 * @param {string} p.opponentId - opponent player id
 * @param {number} p.myFastestSolve - my fastest solve in seconds (Infinity if none)
 * @param {number|null|undefined} p.opponentFastestSolve - opponent's fastest, may be unset
 * @param {Array<{solve_time:number}>} [p.opponentSolutions] - fallback source for opponent's fastest
 * @returns {string|null} the winning player id, or null for an unresolved tie
 */
export function resolveBattleWinner({
  myScore,
  opponentScore,
  myId,
  opponentId,
  myFastestSolve,
  opponentFastestSolve,
  opponentSolutions,
}) {
  if (myScore > opponentScore) return myId;
  if (opponentScore > myScore) return opponentId;

  // Equal scores: only a non-zero tie goes to the fastest-solve tiebreaker.
  if (myScore === opponentScore && myScore > 0) {
    let oppFastest = opponentFastestSolve;
    if (!oppFastest && opponentSolutions && opponentSolutions.length > 0) {
      oppFastest = Math.min(...opponentSolutions.map((s) => s.solve_time));
    }
    if (oppFastest && myFastestSolve < oppFastest) return myId;
    if (oppFastest && oppFastest < myFastestSolve) return opponentId;
  }

  return null;
}

/**
 * Apply a finished battle's outcome to a player's blitzStats counters.
 * Pure — returns a fresh counters object; the caller persists it. Always
 * increments totalBattles; routes the result into wins / ties / losses.
 *
 * @param {{totalBattles?:number, wins?:number, losses?:number, ties?:number}|undefined} prevBlitzStats
 * @param {object} p
 * @param {string|null} p.winnerId - the resolveBattleWinner result
 * @param {string} p.myId - this player's id
 * @returns {{totalBattles:number, wins:number, losses:number, ties:number}}
 */
export function applyBattleOutcome(prevBlitzStats, { winnerId, myId }) {
  const next = {
    totalBattles: (prevBlitzStats?.totalBattles || 0) + 1,
    wins: prevBlitzStats?.wins || 0,
    losses: prevBlitzStats?.losses || 0,
    ties: prevBlitzStats?.ties || 0,
  };

  if (winnerId === myId) {
    next.wins += 1;
  } else if (winnerId === null) {
    next.ties += 1;
  } else {
    next.losses += 1;
  }

  return next;
}
