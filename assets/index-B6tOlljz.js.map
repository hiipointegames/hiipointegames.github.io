/**
 * Edge call port — the seam between the frontend and Supabase Edge Functions.
 *
 * Returns a tagged-union `EdgeCallResult<T>`:
 *   { success: true,  data: T }
 *   { success: false, error: { code, message }, context? }
 *
 * Callers consume it via discriminant:
 *
 *   const result = await edgeCall('daily-challenge-controller', { action: 'start' });
 *   if (result.success) {
 *     // result.data is the payload
 *   } else {
 *     // result.error.code is a machine-readable string
 *     // result.error.message is a human-readable string
 *   }
 *
 * During the ADR-0001 strangler-fig migration, this port detects both the new
 * envelope shape ({success, data?, error?}) and the seven legacy shapes still
 * returned by unmigrated edge functions. Once every edge function speaks the
 * envelope, the `normalizeLegacyShape` branch can be deleted.
 *
 * See docs/adr/0001-edge-call-envelope.md for the contract spec.
 */
import { supabase } from './supabaseClient';
import { resolveSession } from './sessionResolution';

/**
 * Result returned by every call through this port. Conceptually a tagged
 * union discriminated on `success`:
 *   { success: true,  data: T }
 *   { success: false, error: { code, message }, context? }
 * Modeled here as one object with optional members so existing callers can
 * read `.data` / `.error` after a plain `success` check without per-call
 * discriminant narrowing.
 *
 * @typedef {{ success: boolean, data?: any, error?: { code: string, message: string }, context?: any }} EdgeCallResult
 */

// ─────────────────────────────────────────────────────────────────────────────
// Public API
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Invoke a Supabase Edge Function and return an EdgeCallResult.
 *
 * @param {string} functionName - camelCase or kebab-case; converted to kebab.
 * @param {object} [payload] - function body.
 * @returns {Promise<EdgeCallResult>} tagged-union result; never throws on
 *   domain failure, only on programmer error (e.g. supabase client missing).
 */
export async function edgeCall(functionName, payload) {
  const edgeFunctionName = toKebabCase(functionName);

  const authToken = await resolveAuthToken(edgeFunctionName);
  const anonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;

  const { data, error } = await supabase.functions.invoke(edgeFunctionName, {
    body: payload,
    headers: {
      Authorization: `Bearer ${authToken}`,
      apikey: anonKey,
    },
  });

  if (error) {
    return await translateInvokeError(edgeFunctionName, error);
  }

  return parseEnvelope(data);
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth — JWT with anonymous-session fallback. Per ADR-0001 the get-player-stats
// quirk (must use anonKey directly) is preserved here until that function is
// migrated to use Authorization: Bearer normally.
// ─────────────────────────────────────────────────────────────────────────────

async function resolveAuthToken(edgeFunctionName) {
  const anonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;

  // Legacy quirk: get-player-stats bypasses RLS via service role and accepts
  // anonKey directly. Remove this branch once that function is migrated.
  if (edgeFunctionName === 'get-player-stats') {
    return anonKey;
  }

  // resolveSession, not getSession: when the token could not be refreshed
  // because the network is down, a real member is still stored. Creating a
  // guest here would overwrite them the moment the network came back.
  let { session, offline } = await resolveSession();
  if (!session && !offline) {
    const { data: signInData, error: signInError } = await supabase.auth.signInAnonymously();
    if (signInError) {
      console.error('[edgeCall] anonymous sign-in failed:', signInError);
    } else if (signInData?.session) {
      session = signInData.session;
    }
  }
  return session?.access_token || anonKey;
}

// ─────────────────────────────────────────────────────────────────────────────
// Envelope parsing
// ─────────────────────────────────────────────────────────────────────────────

function parseEnvelope(data) {
  if (data == null) {
    return errorResult('empty_response', 'Edge function returned no body.');
  }

  // New envelope shape (ADR-0001): {success, data?, error?}.
  if (typeof data === 'object' && 'success' in data) {
    if (data.success === true) {
      return { success: true, data: data.data === undefined ? data : data.data };
    }
    const err = data.error;
    if (err && typeof err === 'object' && 'code' in err) {
      return {
        success: false,
        error: { code: String(err.code), message: String(err.message || err.code) },
        context: data.data,
      };
    }
    // success: false but error isn't envelope-shaped — fall through to legacy.
  }

  // Legacy shape — kept until every edge function is on the envelope.
  return normalizeLegacyShape(data);
}

/**
 * Translate the seven known pre-envelope shapes into EdgeCallResult.
 * Each branch documents which edge function emits that shape so we can
 * remove the branch when that function is migrated.
 */
function normalizeLegacyShape(data) {
  if (typeof data !== 'object') {
    // Some legacy functions returned a raw domain object on the happy path
    // and never has an envelope. Treat any non-object as data.
    return { success: true, data };
  }

  // dcc:heartbeat / dcc:status / dcc:start-success-with-status —
  // {status: 'active' | 'forfeited' | 'completed' | 'in_progress' | ...}
  // Always treat as success; the caller branches on .status itself.
  if ('status' in data && !('success' in data) && !('error' in data)) {
    return { success: true, data };
  }

  // get-player-stats: {data: {...}, ...spread} — un-double-wrap to data only.
  if ('data' in data && typeof data.data === 'object' && data.data !== null) {
    return { success: true, data: data.data };
  }

  // Legacy failure-by-shape (returns {error}) and other
  // legacy {error: msg} responses — treat as failure even when HTTP was 200.
  if ('error' in data && !('success' in data)) {
    const msg = typeof data.error === 'string' ? data.error : 'Edge function reported error.';
    return errorResult('legacy_error', msg);
  }

  // Fallthrough: happy-path domain object without status/error/success/data.
  return { success: true, data };
}

// ─────────────────────────────────────────────────────────────────────────────
// supabase.functions.invoke error translation
// supabase wraps protocol errors (4xx/5xx) inside an Error with .context (a
// Response). We try to parse the body; if it matches the envelope or any legacy
// shape, that takes precedence over the HTTP status.
// ─────────────────────────────────────────────────────────────────────────────

async function translateInvokeError(edgeFunctionName, error) {
  if (!error.context) {
    return errorResult('transport_error', error.message || 'Edge function invoke failed.');
  }

  let errorBody = null;
  try {
    errorBody = await error.context.json();
  } catch (e) {
    return errorResult('unparseable_error_body', error.message || 'Could not parse error body.');
  }

  const httpStatus = error.context?.status;

  // Auto-logout on Invalid JWT (preserved from legacy apiClient — covers stale
  // sessions where the JWT validates locally but is rejected server-side).
  if (errorBody?.code === 401 && errorBody?.message === 'Invalid JWT') {
    console.warn('[edgeCall] Invalid JWT — clearing session and redirecting to login.');
    await supabase.auth.signOut();
    window.location.href = '/login';
    return errorResult('invalid_jwt', 'Session expired; redirecting to login.');
  }

  // Post-migration shape: 4xx/5xx with an envelope body. Parse the envelope
  // directly so error.code / error.message land cleanly.
  if (errorBody && typeof errorBody === 'object' && 'success' in errorBody) {
    return parseEnvelope(errorBody);
  }

  // For 4xx with a structured legacy body, treat it like a domain failure.
  // Once all edge functions return the envelope shape, this branch goes away.
  if (httpStatus >= 400 && httpStatus < 500 && errorBody && typeof errorBody === 'object') {
    const code = errorBody.code || errorBody.error || `http_${httpStatus}`;
    const message = errorBody.message || errorBody.error || `Request failed with status ${httpStatus}.`;
    return {
      success: false,
      error: { code: String(code), message: String(message) },
      context: errorBody,
    };
  }

  return errorResult(
    httpStatus >= 500 ? 'internal_error' : 'request_failed',
    errorBody?.message || error.message || `Edge function "${edgeFunctionName}" failed.`,
  );
}

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────

function toKebabCase(name) {
  return name.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase();
}

function errorResult(code, message) {
  return { success: false, error: { code, message } };
}
