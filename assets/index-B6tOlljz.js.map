// Create the account at the END of the guided signup — every write, in a safe order.
//
// ORDER IS THE BUG FIX (2026-10-10, docs/bugs.md). The old form wrote the
// welcome flag + 18+ answer FIRST, then named the account, then claimed it. A
// failed claim left the answer stranded on a still-anonymous guest, where it
// does nothing (research Q2). Here nothing about the player is saved until the
// account exists:
//
//   1. set-username   (name + optional country; server re-checks format,
//                      moderation and uniqueness, and renames past board rows)
//   2. resolve-username-login (sets password + optional email on THIS
//                      anonymous account and returns its session)
//   3. setSession     (the player is now the member account — same user id, so
//                      their guest Dailies come with them)
//   4. profile extras (welcome flag + the 18+ answer, written to the member)
//   5. the referral claim, when one was typed (never fails the signup)
//
// A failure at 1–3 returns the STEP to send the player back to, with the
// server's own message. A failure at 4 does not undo a created account: it is
// reported, and the one-time 18+ question (contestVisibility 'ask') catches a
// missing answer next launch.

import { setUsername as setUsernameOnServer, resolveUsernameLogin, supabase, apiClient } from '@/transport';
import { CONTEST_ELIGIBILITY_META_KEY, buildContestEligibilityAttestation } from '@/contest';
import { reportedFallback, captureError, recordOutcome } from '@/observability';
import { claimReferral } from '@/referrals';

/** Which guided step a server error belongs to. */
const STEP_FOR_CODE = Object.freeze({
  // set-username
  invalid_format: 'username',
  rejected_name: 'username',
  name_taken: 'username',
  // resolve-username-login
  invalid_input: 'username',
  claim_requires_session: 'username', // the name belongs to an account with history
  invalid_credentials: 'username',    // …or to one that already has a password
  weak_password: 'password',
  invalid_email: 'email',
});

/** Friendlier wording where the server's is about the other account. */
const MESSAGE_FOR_CODE = Object.freeze({
  session_failed: 'Your account was created, but we couldn’t sign you in. Try logging in.',
  network: 'Couldn’t reach the server. Check your connection and try again.',
  claim_requires_session: 'That username belongs to another player. Pick a different one, or log in if it’s yours.',
  invalid_credentials: 'That username belongs to another player. Pick a different one, or log in if it’s yours.',
});

/** What the player sees when the failure is ours, not theirs. */
export const FRIENDLY_RETRY = 'We couldn’t create your account just now. Check your connection and try again.';

/**
 * @typedef {{ username: string, password: string, email?: string, country?: string, eligible: boolean, referrer?: string }} SignupAnswers
 * @typedef {{ ok: true, user: any, referral?: any } | { ok: false, step: 'username'|'password'|'email'|'final', code: string, message: string }} SignupResult
 */

/**
 * @param {SignupAnswers} answers
 * @param {{ setUsername?: Function, resolveUsernameLogin?: Function, setSession?: Function, me?: Function, updateMe?: Function, now?: Date, claimReferral?: Function, record?: Function }} [deps]
 * @returns {Promise<SignupResult>}
 */
export async function submitSignup(answers, deps = {}) {
  const callSetUsername = deps.setUsername || setUsernameOnServer;
  const callClaim = deps.resolveUsernameLogin || resolveUsernameLogin;
  const callSetSession = deps.setSession || ((s) => supabase.auth.setSession(s));
  const callMe = deps.me || (() => apiClient.auth.me());
  const callUpdateMe = deps.updateMe || ((d) => apiClient.auth.updateMe(d));

  /**
   * @param {{ code?: string, message?: string } | undefined} error
   * @param {'username'|'password'|'email'|'final'} fallbackStep
   * @returns {{ ok: false, step: 'username'|'password'|'email'|'final', code: string, message: string }}
   */
  const failFrom = (error, fallbackStep) => {
    const code = error?.code || 'unknown';
    const step = STEP_FOR_CODE[code] || fallbackStep;
    // A failure that isn't about one of the player's answers (transport_error,
    // http_5xx, internal_error, …) gets ONE friendly retry message. The raw text
    // ("Failed to send a request to the Edge Function", seen on staging
    // 2026-10-10) goes to Sentry, never onto the screen.
    if (step === 'final' && !MESSAGE_FOR_CODE[code]) {
      captureError(new Error(`signup failed: ${code}`), { where: 'signup.server', code, detail: String(error?.message || '') });
      return {
        ok: /** @type {false} */ (false),
        step: /** @type {'final'} */ ('final'),
        code,
        message: FRIENDLY_RETRY,
      };
    }
    return {
      ok: /** @type {false} */ (false),
      step: /** @type {'username'|'password'|'email'|'final'} */ (STEP_FOR_CODE[code] || fallbackStep),
      code,
      message: MESSAGE_FOR_CODE[code] || error?.message || 'Something went wrong. Please try again.',
    };
  };

  try {
    // 1 — name (+ country)
    const named = await callSetUsername(answers.username, answers.country || undefined);
    if (!named?.success) return failFrom(named?.error, 'final');

    // 2 — claim this anonymous account with the password (+ email)
    const claimed = await callClaim(answers.username, answers.password, answers.email || undefined);
    if (!claimed?.success) return failFrom(claimed?.error, 'final');

    // 3 — become the member
    const session = claimed.data?.session;
    const { error: sessionError } = await callSetSession({
      access_token: session?.access_token,
      refresh_token: session?.refresh_token,
    });
    if (sessionError) return failFrom({ code: 'session_failed', message: 'Your account was created, but we couldn’t sign you in. Try logging in.' }, 'final');
  } catch (err) {
    captureError(err, { where: 'signup.create' });
    return failFrom({ code: 'network', message: 'Couldn’t reach the server. Check your connection and try again.' }, 'final');
  }

  // 4 — profile extras, now on the member account. Never undoes the account.
  let fresh = await Promise.resolve(callMe()).catch(reportedFallback('signup.me', null));
  try {
    await callUpdateMe({
      game_stats: {
        ...(fresh?.user_metadata?.game_stats || fresh?.game_stats || {}),
        hasSeenInitialWelcomeModal: true,
      },
      [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(answers.eligible === true, deps.now),
    });
    fresh = (await Promise.resolve(callMe()).catch(reportedFallback('signup.me', null))) || fresh;
  } catch (err) {
    captureError(err, { where: 'signup.extras' });
  }

  // 5 — "Did a friend invite you?" (optional; only asked while the referrals
  // switch is on). LAST, because claim_referral needs the saved (non-anonymous)
  // account. A refusal or a failure NEVER fails the signup: the Done screen
  // shows its message and the profile can fix it within 7 days.
  let referral = null;
  if (answers.referrer && answers.referrer.trim()) {
    const callClaimReferral = deps.claimReferral || claimReferral;
    const record = deps.record || recordOutcome;
    try {
      referral = await callClaimReferral(answers.referrer);
    } catch (err) {
      captureError(err, { where: 'signup.referral' });
      referral = { ok: false, reason: 'network' };
    }
    if (!referral || typeof referral !== 'object') referral = { ok: false, reason: 'network' };
    record('referral', referral.ok ? 'ok' : String(referral.reason || 'network'), { step: 'signup' });
  }

  return { ok: true, user: fresh, referral };
}

export const __STEP_FOR_CODE = STEP_FOR_CODE;
