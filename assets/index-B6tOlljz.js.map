// WebAdSlot — the web counterpart to the native AdMob anchored banner.
//
// PLACEMENT parity with the native banner (a fixed bottom bar), but deliberately
// NOT ROUTE parity any more. Native shows its banner on every route except
// NO_AD_PATHS; web shows one only on the routes in WEB_AD_ELIGIBLE_PATHS.
//
// Why the split: AdSense policy forbids Google-served ads on screens without
// publisher content, and almost every screen in this app is a navigation or
// behavioural surface (a launcher, a leaderboard, a tab of stats). Mirroring the
// native blocklist here is what put ads on all of them and produced the AdSense
// "Google-served ads on screens without publisher-content" violation. AdMob's
// in-app policy is different, so the native banner is unchanged — only web
// narrowed. See GlobalAdManager's WEB_AD_ELIGIBLE_PATHS comment for the full
// rationale and for how to widen the list as content pages ship.
//
// Renders either a real AdSense unit (when VITE_ADSENSE_CLIENT *and* a banner
// slot id are configured) or, until AdSense is approved, a labeled placeholder
// so the slot is visible and reserved.
//
// z-index is intentionally BELOW the app's modals (z-50/z-60). Like the native
// banner this overlays page content, but when a modal opens it covers the bar —
// which is why the per-modal iOS banner spacers are collapsed on web (they'd be
// dead space behind the modal backdrop). See the spacer edits in
// head-to-head/ChallengeResults.jsx + HeadToHeadStats.jsx.

import React from 'react';
import { Capacitor } from '@capacitor/core';
import { useLocation } from 'react-router-dom';
import { WEB_AD_ELIGIBLE_PATHS } from '../GlobalAdManager';
import { getAdSenseClient, getAdSenseBannerSlot, isAdSenseEnabled } from './adsenseClient';
import AdSenseUnit from './AdSenseUnit';

export const WEB_AD_SLOT_HEIGHT = 60; // px — mirrors a standard mobile banner

export default function WebAdSlot() {
  const location = useLocation();

  // Native uses the real AdMob banner (GlobalAdManager). Web only here.
  if (Capacitor.isNativePlatform()) return null;
  // Allowlist: only routes carrying real publisher content get an ad. Anything
  // not listed — including routes added later, and unknown/404 paths — is
  // ad-free by default. This is the AdSense-compliance gate; see
  // WEB_AD_ELIGIBLE_PATHS.
  if (!WEB_AD_ELIGIBLE_PATHS.includes(location.pathname)) return null;
  // AdSense is configured but no ad-unit slot id exists yet (units cannot be
  // created until the account is approved). AdSenseUnit refuses to render a
  // slot-less <ins>, so reserving an empty 60px bar here would be dead space —
  // and a slot-less unit is what AdSense treats as page-level inventory.
  if (isAdSenseEnabled() && !getAdSenseBannerSlot()) return null;

  return (
    <div
      role="complementary"
      aria-label="Advertisement"
      data-testid="web-ad-slot"
      style={{
        position: 'fixed',
        left: 0,
        right: 0,
        bottom: 0,
        height: WEB_AD_SLOT_HEIGHT,
        zIndex: 30,
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        // Transparent so the page background (e.g. the game's starfield) blends
        // straight through behind the ad — no opaque bar / seam. The ad content
        // itself is opaque; only the surrounding slot is see-through.
        background: 'transparent',
        color: 'rgba(148,163,184,0.65)',
        fontFamily: 'system-ui,-apple-system,"Segoe UI",Roboto,sans-serif',
        fontSize: 12,
        letterSpacing: '0.08em',
        textTransform: 'uppercase',
        overflow: 'hidden',
      }}
    >
      {isAdSenseEnabled() ? (
        <AdSenseUnit
          client={getAdSenseClient()}
          slot={getAdSenseBannerSlot()}
          format="horizontal"
          style={{ display: 'block', width: '100%', height: WEB_AD_SLOT_HEIGHT }}
        />
      ) : (
        <span data-testid="web-ad-placeholder">Advertisement</span>
      )}
    </div>
  );
}
