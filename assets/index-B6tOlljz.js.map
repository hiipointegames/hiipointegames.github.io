import React, { useState } from 'react';
import { createPortal } from 'react-dom';
import { Loader2 } from 'lucide-react';

import { apiClient } from '@/transport';

import { CONTEST_AGE_REASSURANCE, CONTEST_ELIGIBILITY_META_KEY, buildContestEligibilityAttestation } from './contest';
import { announceProfileChanged } from './announceProfileChanged';

// The one-time 18+/US question for EXISTING members (David, 2026-10-10;
// approved mockup screen 12).
//
// Who sees it: `needsContestReask(user)` — a member who never answered, or
// whose "No" predates the 2026-10-06 fix (until then a skipped question was
// saved as "No"). Their answer decides whether the $37 giveaway shows at all
// (contestVisibility). No "later" button: it is one tap either way, and both
// answers keep the full game.
//
// It ALWAYS writes (unlike the profile form's contestAttestationPatch, which
// skips an unchanged answer): a fresh confirmed_at is what marks the question
// as asked, so an old "No" re-confirmed as "No" never comes back.
//
// Portaled to <body> at z-[200] — the iPhone stacking rule (40a906f).

/**
 * @param {{ username?: string | null, onAnswered: (answer: boolean) => void, deps?: { updateMe?: Function, announce?: Function } }} props
 */
export default function AskOnceQuestion({ username = null, onAnswered, deps = {} }) {
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const updateMe = deps.updateMe || ((d) => apiClient.auth.updateMe(d));
  const announce = deps.announce || announceProfileChanged;

  const answer = async (value) => {
    if (saving) return;
    setSaving(true);
    setError('');
    try {
      await updateMe({ [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(value) });
      await announce();
      onAnswered(value);
    } catch {
      // Said, not swallowed: a player who answers and is not told it failed
      // would believe their choice took effect.
      setError('Could not save that. Check your connection and try again.');
    } finally {
      setSaving(false);
    }
  };

  const button = (value, label) => (
    <button
      type="button"
      data-testid={`ask-once-${value ? 'yes' : 'no'}`}
      onClick={() => answer(value)}
      disabled={saving}
      className="min-h-[60px] rounded-[18px] border-[3px] border-white/55 bg-[#0e1230] text-white text-xl font-black disabled:opacity-60"
    >
      {saving ? <Loader2 className="w-5 h-5 animate-spin mx-auto" /> : label}
    </button>
  );

  const node = (
    <div
      className="fixed inset-0 z-[200] flex items-center justify-center px-5"
      style={{ background: 'linear-gradient(180deg, rgba(5,3,17,0.6), rgba(5,3,17,0.88))' }}
      data-testid="ask-once"
    >
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="ask-once-title"
        className="w-full max-w-sm rounded-[26px] border-2 px-5 pt-6 pb-5 text-white"
        style={{
          borderColor: 'color-mix(in srgb, var(--u37-violet) 60%, transparent)',
          background: 'var(--u37-panel-bg-cosmic)',
          boxShadow: '0 0 44px -12px var(--u37-violet), 0 20px 70px rgba(0,0,0,0.6)',
        }}
      >
        <div className="text-[13px] font-black tracking-[0.2em] uppercase" style={{ color: '#d39bff' }}>
          {username ? `Hi ${username} · ` : ''}One quick question
        </div>
        <h2 id="ask-once-title" className="mt-2.5 text-[25px] font-black leading-tight">
          Are you 18 or older and living in the United States?
        </h2>
        <p className="mt-3 text-sm leading-relaxed text-emerald-50/90">
          <span className="font-black" style={{ color: 'var(--u37-green)' }}>{CONTEST_AGE_REASSURANCE.head}</span>{' '}
          {CONTEST_AGE_REASSURANCE.body}
        </p>
        <div className="mt-5 grid grid-cols-2 gap-3">
          {button(true, 'Yes')}
          {button(false, 'No')}
        </div>
        {error && <p role="alert" className="mt-3 text-center text-[13px] font-bold text-red-300">{error}</p>}
        <p className="mt-3.5 text-center text-xs text-purple-200/70">{CONTEST_AGE_REASSURANCE.foot}</p>
      </div>
    </div>
  );

  return typeof document !== 'undefined' ? createPortal(node, document.body) : node;
}
