// Is this username free? Asked live while the player types (guided signup, step 1).
//
// ⚠️ CASE-INSENSITIVE, and that is a bug fix (2026-10-10, docs/bugs.md). The old
// pre-check (`isUsernameTaken`) lowercased the input and then asked for an EXACT
// match, while usernames are now stored with the player's own capitals. So
// "biscuitsngravy" sailed past a stored "BiscuitsNGravy", and the clash only
// surfaced later at the server (`set-username` uses ilike + a lower() unique
// index) as a generic error. This asks the same question the server does.
//
// It is still only a fast pre-check: the unique index is the authority, and
// submitSignup maps a late `name_taken` back to this step.

import { apiClient } from '@/transport';
import { validateUsername } from '@/components/utils/usernameValidation';

/** Escape LIKE wildcards. `_` is a legal username character but a single-char
 *  wildcard in LIKE, so "a_b" would otherwise match "axb". */
export function escapeLike(value) {
  return String(value).replace(/[\\%_]/g, (c) => `\\${c}`);
}

/**
 * @param {string} raw what the player typed
 * @param {{ excludeUserId?: string | null, client?: any }} [opts]
 *   excludeUserId — the player's own id, so a legacy named guest keeping their
 *   own name is not told it is taken; client — test seam
 * @returns {Promise<{ status: 'invalid', message: string }
 *   | { status: 'available', name: string }
 *   | { status: 'taken', name: string }
 *   | { status: 'unknown', name: string }>}
 *   'unknown' = the lookup failed; the UI lets them continue and the server decides
 */
export async function checkUsername(raw, { excludeUserId = null, client } = {}) {
  const v = validateUsername(raw);
  if (!v.valid) return { status: 'invalid', message: v.error };
  const name = v.formatted;
  try {
    const db = client || apiClient.supabase;
    const { data, error } = await db
      .from('profiles')
      .select('id')
      .ilike('username', escapeLike(name))
      .limit(5);
    if (error) throw error;
    const taken = (data || []).some((row) => row.id !== excludeUserId);
    return { status: taken ? 'taken' : 'available', name };
  } catch {
    return { status: 'unknown', name };
  }
}

/** Debounce for the live check: fast enough to feel instant, slow enough not to
 *  query on every keystroke. */
export const AVAILABILITY_DEBOUNCE_MS = 350;
