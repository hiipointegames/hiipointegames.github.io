import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { Logo37 } from './Logo37';

// DiceLoader — the app's branded loading indicator. Shows the 37 hexagon brand
// mark (Logo37) with a calm cyan pulse (scale + glow) while a panel loads, so a
// wait reads as "on brand" instead of a stock spinner. Honours
// prefers-reduced-motion (static mark, no pulse). Accessible: role="status" +
// aria-label.
//
// The name is kept as DiceLoader for its existing call sites; as of 2026-07-13
// (David's ask) it renders the 37 hexagon mark rather than a rolling die. Logo37
// is a same-module sibling (dice-visuals), dependency-free SVG — no image asset
// and no cross-module import (which would cycle with puzzle-input).
//
// `label` defaults to "Loading…" — pass label="" (or null) for the mark alone.

/**
 * @param {{ size?: number, label?: string|null, className?: string }} props
 */
export default function DiceLoader({ size = 48, label = 'Loading…', className = '' }) {
  const reduce = useReducedMotion();

  return (
    <div
      className={`flex flex-col items-center justify-center gap-2 ${className}`}
      role="status"
      aria-label={label || 'Loading'}
      data-testid="dice-loader"
    >
      <motion.div
        aria-hidden="true"
        data-testid="dice-loader-mark"
        style={{ width: size, height: size, display: 'inline-flex' }}
        // Gentle OPACITY breath only — no scale/filter animation over the mark.
        // Logo37 is a filtered SVG (internal neon glow); animating a transform or
        // CSS filter across it triggers the Android-webview compositing flicker
        // that hit the home logo (David 2026-07-13). Opacity is compositing-safe
        // and Logo37's built-in cyan glow supplies the neon, so the loader still
        // reads as "on brand" without ever re-rasterizing the filter per frame.
        animate={reduce ? undefined : { opacity: [0.5, 1, 0.5] }}
        transition={reduce ? undefined : { duration: 1.4, repeat: Infinity, ease: 'easeInOut' }}
      >
        <Logo37 size={size} />
      </motion.div>
      {label ? (
        <span className="text-xs font-semibold tracking-wide" style={{ color: 'var(--u37-muted, #a59fce)' }}>
          {label}
        </span>
      ) : null}
    </div>
  );
}
