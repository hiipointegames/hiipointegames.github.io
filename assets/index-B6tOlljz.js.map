// The personal link: 37themathpuzzle.com/play/<code>.
//
// The code is made here and saved through the `create_share_link` database
// function (supabase/migrations/20260929200000_share_links.sql), which reads the
// username server-side — a client cannot put another player's name on a link.
//
// ⚠️ A SHARE MUST NEVER WAIT ON THIS. The link is a nice-to-have (a greeting on
// the /play page, and the closing-line numbers); the share is the point. So this
// never throws, gives up after a short timeout, and on ANY failure returns null —
// the message then carries the plain /play link. That also keeps the share
// working before the migration reaches a given database.

// No 0/o, 1/l/i: a code read aloud or retyped from a screenshot should survive.
const ALPHABET = 'abcdefghjkmnpqrstuvwxyz23456789';
export const CODE_LENGTH = 8;

const WIRE_MODE = Object.freeze({ easy: 'daily_easy', challenge: 'daily', expert: 'daily_expert' });

/**
 * A random share code. Uses the platform CSPRNG when there is one.
 * @param {(n: number) => Uint8Array} [randomBytes] injectable for tests
 */
export function generateShareCode(randomBytes = defaultRandomBytes) {
  const bytes = randomBytes(CODE_LENGTH);
  let out = '';
  for (let i = 0; i < CODE_LENGTH; i++) out += ALPHABET[bytes[i] % ALPHABET.length];
  return out;
}

function defaultRandomBytes(n) {
  const b = new Uint8Array(n);
  if (globalThis.crypto?.getRandomValues) return globalThis.crypto.getRandomValues(b);
  for (let i = 0; i < n; i++) b[i] = Math.floor(Math.random() * 256);
  return b;
}

function withTimeout(promise, ms) {
  let timer;
  return Promise.race([
    promise,
    new Promise((resolve) => { timer = setTimeout(() => resolve({ timedOut: true }), ms); }),
  ]).finally(() => clearTimeout(timer));
}

/**
 * Save a share link. Resolves to the code, or null on any failure.
 * @param {object} p
 * @param {{ rpc: Function }} p.client a supabase client
 * @param {'easy'|'challenge'|'expert'} p.tier
 * @param {'perfect'|'solved'|'forfeit'} p.result
 * @param {number|null} p.seconds
 * @param {number} p.puzzleNumber
 * @param {string} p.closingLine
 * @param {'ios'|'android'|'web'} p.platform
 * @param {number} [p.timeoutMs]
 * @param {() => string} [p.makeCode]
 * @returns {Promise<string|null>}
 */
export async function createShareLink({
  client, tier, result, seconds, puzzleNumber, closingLine, platform,
  timeoutMs = 2500, makeCode = generateShareCode,
}) {
  if (!client?.rpc || !puzzleNumber) return null;
  // Two tries: the only expected failure worth retrying is a code collision
  // (unique violation, 23505), which a fresh code fixes.
  for (let attempt = 0; attempt < 2; attempt++) {
    const code = makeCode();
    try {
      const res = await withTimeout(client.rpc('create_share_link', {
        p_code: code,
        p_mode: WIRE_MODE[tier] || WIRE_MODE.challenge,
        p_result: result,
        p_solve_seconds: result === 'forfeit' ? null : seconds,
        p_puzzle_number: puzzleNumber,
        p_closing_line: closingLine,
        p_platform: platform,
      }), timeoutMs);
      if (res?.timedOut) return null;
      if (!res?.error) return typeof res?.data === 'string' ? res.data : code;
      if (res.error.code !== '23505') return null;
    } catch {
      return null;
    }
  }
  return null;
}
