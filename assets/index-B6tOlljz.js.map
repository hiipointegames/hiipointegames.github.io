import { STREAK_MILESTONES, PERFECT_MILESTONES, TIME_ICON_CONFIGS } from './milestones';

// Achievement badge RARITY mapping.
//
// The Ultimate-UI redesign colours achievement badges by TIER/RARITY (how hard
// they are to earn) rather than by category, walking the six-stop neon wheel in
// tokens.css (--u37-tier-1..6: green→cyan→blue→violet→magenta→gold). Category is
// still encoded by the per-tier emoji; colour now encodes rarity, so a row of a
// family's tiers reads as one smooth flow of colour weakest→strongest.
//
// Pure derivation — no React, no colour literals (returns CSS var() names so the
// single source of truth stays in tokens.css).

// TIME badges are keyed by a seconds threshold, descending in difficulty
// (600s easiest → 10s hardest). Sorted hardest-last so index 0 is the weakest
// tier, matching STREAK/PERFECT ordering.
export const TIME_MILESTONES = Object.keys(TIME_ICON_CONFIGS)
  .map(Number)
  .sort((a, b) => b - a);

/** Number of tiers in a badge family. 0 for an unknown type. */
export function tierCount(type) {
  if (type === 'streak') return STREAK_MILESTONES.length;
  if (type === 'perfect') return PERFECT_MILESTONES.length;
  if (type === 'time') return TIME_MILESTONES.length;
  return 0;
}

/**
 * 0-based tier index of a milestone value within its family (weakest = 0).
 * Returns -1 when the value isn't a real milestone for that type.
 * `perfect` accepts the 7.1 alias the badge grid uses for the second 7-day tier.
 */
export function tierIndex(type, milestone) {
  if (type === 'streak') return STREAK_MILESTONES.indexOf(milestone);
  if (type === 'perfect') {
    const normalized = milestone === 7.1 ? 7 : milestone;
    return PERFECT_MILESTONES.indexOf(normalized);
  }
  if (type === 'time') return TIME_MILESTONES.indexOf(milestone);
  return -1;
}

/**
 * Map a tier position onto the six-stop rarity wheel, returning a CSS var()
 * string (`var(--u37-tier-N)`, N in 1..6). Tiers are spaced evenly across the
 * six hues so families with more than six tiers (e.g. TIME has ten) still flow
 * smoothly weakest→strongest. Unknown/degenerate inputs fall back to tier 1.
 */
export function rarityVar(index, total) {
  if (!Number.isFinite(index) || index < 0 || total <= 1) return 'var(--u37-tier-1)';
  const stop = Math.round((index / (total - 1)) * 5) + 1;
  const clamped = Math.min(6, Math.max(1, stop));
  return `var(--u37-tier-${clamped})`;
}

/** Convenience: the rarity CSS var for a specific badge (type + milestone). */
export function badgeRarityVar(type, milestone) {
  return rarityVar(tierIndex(type, milestone), tierCount(type));
}
