import { useEffect } from 'react';
import { isDaily, DAILY_MODE_KEYS } from '@/game-modes';

// dailyResultsSignal — two small window events between the round and the
// first-week tips (CRISPY 2026-10-20 tips-and-referrals, slice 5).
//
// 1. 'dailyResultsClosed' — the results screen of a Daily just closed. Before
//    this, closing results only reset local round state (RoundStage), so nothing
//    outside the round could know "the player just finished their first Daily
//    today". Tip card 1 fires on exactly that moment.
// 2. 'openDailyShareMenu' — open the Home result card's share menu. Card 1's
//    Share button lands the player on that menu: the results screen (and its
//    share buttons) has closed, and the Home result card under it carries the
//    same share for the same Daily.
//
// Events, not props, for the same reason as 'homeChromeChanged': the listener
// (Layout) and the emitter (the round, mounted by Game) are siblings, and
// threading a callback through Game.jsx would grow the page for no gain.

export const DAILY_RESULTS_CLOSED_EVENT = 'dailyResultsClosed';
export const OPEN_DAILY_SHARE_MENU_EVENT = 'openDailyShareMenu';

/**
 * What the tips need to know about a results close, or null for a non-Daily.
 *
 * `statusByMode` is read AT CLOSE: submit() marks the Daily completed before the
 * results open, so the just-finished Daily is already counted. A forfeit is not
 * a finish (same rule as contestEntries.finishedTodayCount).
 *
 * @param {string} mode the round's wire key
 * @param {Record<string, string> | null | undefined} statusByMode
 * @returns {{ mode: string, completed: boolean, finishedToday: number, firstToday: boolean } | null}
 */
export function dailyResultsClosedDetail(mode, statusByMode) {
  if (!isDaily(mode)) return null;
  const completed = statusByMode?.[mode] === 'completed';
  const finishedToday = DAILY_MODE_KEYS.filter((k) => statusByMode?.[k] === 'completed').length;
  return { mode, completed, finishedToday, firstToday: completed && finishedToday === 1 };
}

/** Announce a results close. A no-op for a non-Daily round. Never throws. */
export function emitDailyResultsClosed(mode, statusByMode) {
  try {
    const detail = dailyResultsClosedDetail(mode, statusByMode);
    if (detail) window.dispatchEvent(new CustomEvent(DAILY_RESULTS_CLOSED_EVENT, { detail }));
  } catch {
    // A signal for a tip must never break closing the results.
  }
}

/**
 * Listen for results closes.
 * @param {(detail: NonNullable<ReturnType<typeof dailyResultsClosedDetail>>) => void} fn
 * @returns {() => void} unsubscribe
 */
export function onDailyResultsClosed(fn) {
  const handler = (/** @type {any} */ e) => { if (e?.detail) fn(e.detail); };
  window.addEventListener(DAILY_RESULTS_CLOSED_EVENT, handler);
  return () => window.removeEventListener(DAILY_RESULTS_CLOSED_EVENT, handler);
}

/** Ask the Home result card to open its share menu. */
export function requestDailyShareMenu() {
  window.dispatchEvent(new CustomEvent(OPEN_DAILY_SHARE_MENU_EVENT));
}

/**
 * Game's half: open the share menu when asked. One line in Game.jsx, which
 * passes its (stable) state setter.
 * @param {(open: boolean) => void} setShareMenuOpen
 */
export function useDailyShareMenuRequest(setShareMenuOpen) {
  useEffect(() => {
    const handler = () => setShareMenuOpen(true);
    window.addEventListener(OPEN_DAILY_SHARE_MENU_EVENT, handler);
    return () => window.removeEventListener(OPEN_DAILY_SHARE_MENU_EVENT, handler);
  }, [setShareMenuOpen]);
}
