import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Sheet, SheetContent, SheetTrigger } from '@/ui/primitives/sheet';
import { Button } from '@/ui/primitives/button';
import { Menu, LogOut, FileText, User, Volume2, VolumeX, CloudUpload, Mail, Trash2, FlaskConical, Share2, Bell, Trophy, Sparkles } from 'lucide-react';
import { apiClient } from '@/transport';
import { buildInviteText, shareOrCopy } from '@/game-flow';
import { CONTEST, CONTEST_LINK_LABEL, contestVisibility } from '@/contest';
import { useNavigate } from 'react-router-dom';
import SignOutWarningModal from './SignOutWarningModal';
import DeleteAccountModal from './DeleteAccountModal';
import { playSound, useSoundMute } from '@/ui/feedback';
import { isCredentialedAccount, isNamedAccount } from '@/auth';
import { getCurrentChannel, joinBeta, leaveBeta } from '@/shell';
import { usePendingActions, openInbox } from '@/action-center';

// Tapping the Menu title this many times reveals the hidden beta-channel toggle
// (the Android-dev-options pattern). The gesture lives on the always-visible
// Menu header rather than the version label, which the banner ad can cover.
// Testers are told the gesture; it stays out of the way for everyone else.
// See docs/capgo-channels.md.
const BETA_REVEAL_TAPS = 7;

/**
 * WHERE THE APP SENDS A PLAYER FOR THE LEGAL DOCUMENTS.
 *
 * These pointed at hiipointegames.com (the Wix company site) until 2026-09-16.
 * They now point at the product's own domain, and the reason is a real failure
 * rather than tidiness: the legal text exists in THREE places (this app's linked
 * pages, 37themathpuzzle.com, and hiipointegames.com on Wix), maintained by two
 * different mechanisms. That is exactly how the sweepstakes gap happened — the
 * $37 weekly draw collects emails and payment handles and was disclosed in NONE
 * of the three policies until 2026-09-14/15.
 *
 * 37themathpuzzle.com is now the copy that carries everything the app actually
 * needs in one place: the privacy policy, the terms, AND the binding official
 * rules for the giveaway (CONTEST.rulesUrl → the /#prize anchor on the same
 * site), including eligibility, no-purchase-necessary and the Apple/Google
 * sponsor disclaimer the Apple PLA §3.3.4(A)(vi) requires. Pointing the drawer
 * at the same domain the rules live on means one site to keep correct, and a
 * player who follows any legal link lands somewhere that knows about the promo.
 *
 * ⚠️ VERIFIED LIVE, NOT ASSUMED (2026-09-16): both URLs return HTTP 200 with no
 * redirect, and both carry the "Promotions and Prize Draws" section. The apex
 * domain 308-redirects to www, so the `www.` form is canonical — same finding as
 * CONTEST.rulesUrl. Re-run `curl -sI` on both before changing either one.
 *
 * Named constants rather than inline strings so the test below can assert the
 * shipped destination instead of trusting this comment.
 */
export const POLICY_URLS = Object.freeze({
  privacy: 'https://www.37themathpuzzle.com/privacy',
  terms: 'https://www.37themathpuzzle.com/terms',
});

/**
 * THIS WEEK'S $37 DRAWING — the public page on 37themathpuzzle.com that shows
 * who is in the hat, their entries and odds, updated nightly (David,
 * 2026-10-05). Same canonical www. host as the legal pages and the rules; the
 * old /draw address 308-redirects here, so this is the one to link.
 *
 * Kept HERE rather than on CONTEST in the contest module on purpose: another lane had
 * uncommitted work in src/contest/index.js when this was added, and a menu
 * link does not need to touch the contest model.
 */
export const DRAWING_URL = 'https://www.37themathpuzzle.com/drawing';

// `menuBadge` (David, 2026-10-20): while the home portal to Sector 73 holds the top-left
// corner, the notifications bell is not shown there — the ☰ button carries the unread count
// instead, as a badge styled like the bell's, so it stays "obvious and easy to find". Off (the
// default), the trigger renders exactly as before.
export default function AppDrawer({ onEditProfileClick, onSaveStatsClick, onOpenChange, menuBadge = false }) {
  const [open, setOpen] = useState(false);
  const [user, setUser] = useState(null);
  // Shared mute preference (also driven by the in-game speaker toggle) — see
  // useSoundMute. Keeps the drawer's Mute Sound in sync with that control.
  const { muted: soundMuted, toggleMute } = useSoundMute();
  const { total: notificationCount } = usePendingActions();
  const [showSignOutWarning, setShowSignOutWarning] = useState(false);
  const [showDeleteAccount, setShowDeleteAccount] = useState(false);
  const [menuTaps, setMenuTaps] = useState(0);
  const [betaRevealed, setBetaRevealed] = useState(false);
  const [onBeta, setOnBeta] = useState(false);
  const [betaBusy, setBetaBusy] = useState(false);
  const [betaMessage, setBetaMessage] = useState('');
  const navigate = useNavigate();

  useEffect(() => {
    const loadUser = async () => {
      try {
        const currentUser = await apiClient.auth.me();
        setUser(currentUser);
      } catch (error) {
        console.error('Failed to load user:', error);
      }
    };
    // Reflect whether this device is already on the beta OTA channel, so the
    // hidden toggle shows the right state once revealed.
    const loadChannel = async () => {
      const res = await getCurrentChannel();
      if (res.ok) setOnBeta(res.channel === 'beta');
    };
    loadUser();
    loadChannel();
  }, []);

  // Report the drawer's open/closed state up to Layout so it can hide the bottom
  // nav bar while the menu is open (the bar sits behind the drawer and, apart from
  // Home, its tabs aren't operable there — confusing). Firing from an effect on
  // `open` (rather than wiring each call site) covers EVERY transition: the Radix
  // trigger/backdrop/Escape AND the ~8 internal setOpen(false) menu-item closes,
  // so the bar reliably reappears after any drawer action. onOpenChange is a
  // stable setter from Layout, so this doesn't loop.
  useEffect(() => {
    onOpenChange?.(open);
  }, [open, onOpenChange]);

  // Hidden gesture: tap the Menu title BETA_REVEAL_TAPS times to expose the
  // beta-channel opt-in. No-op once already revealed.
  const handleMenuTap = () => {
    if (betaRevealed) return;
    const next = menuTaps + 1;
    setMenuTaps(next);
    if (next >= BETA_REVEAL_TAPS) {
      setBetaRevealed(true);
      playSound('hamburgerMenu');
    }
  };

  // Join/leave the beta OTA channel. All the plugin logic lives in the tested
  // shell/betaChannel helper; this just drives the UI state.
  const handleBetaToggle = async () => {
    if (betaBusy) return;
    setBetaBusy(true);
    setBetaMessage('');
    const res = onBeta ? await leaveBeta() : await joinBeta();
    if (res.ok) {
      setOnBeta(!onBeta);
      setBetaMessage(
        onBeta
          ? 'Left beta. Restart the app to get production updates.'
          : 'Joined beta. Restart the app to get beta updates.',
      );
    } else {
      setBetaMessage(res.error || 'Could not change channel.');
    }
    setBetaBusy(false);
  };

  // The always-available entry to the Notifications inbox (the Home button only
  // appears when something is pending). Opens the same shared inbox modal.
  const handleNotificationsClick = () => {
    playSound('hamburgerMenu');
    setOpen(false);
    openInbox('home');
  };

  const handleLogoutClick = () => {
    playSound('hamburgerMenu');
    setShowSignOutWarning(true);
    setOpen(false); // Close the drawer
  };

  const confirmLogout = async () => {
    setShowSignOutWarning(false);
    await apiClient.auth.logout();
    // Land on the Welcome screen (home with the welcome forced open), NOT the
    // login page. Dumping a signed-out user straight onto /login caused the
    // "sign in twice" loop: the guest-gate could bounce the first sign-in back to
    // Welcome. Welcome is the top of the funnel — it offers Create Account, Play
    // as Guest, and a prominent Log In — so the flow is linear from here.
    navigate('/', { state: { showWelcome: true } });
  };

  const handleSoundToggle = () => {
    playSound('hamburgerMenu');
    toggleMute(); // writes localStorage + broadcasts so the in-game toggle stays in sync
  };

  const handleLinkClick = (url) => {
    playSound('hamburgerMenu');
    window.open(url, '_blank');
    setOpen(false);
  };

  // Show the account entry (Create free account / Add a password) until the
  // player has secured their account with a credential.
  const isSecured = isCredentialedAccount(user);
  // The 18+ answer decides (David, 2026-10-10): the rules link for anyone who
  // could still enter (Yes-members, and guests who'd sign up first); the
  // drawing only for Yes-members. A No (or a not-yet-answered member) sees
  // neither — see @/contest contestVisibility.
  const contestVis = contestVisibility(user);
  const showMenuBadge = menuBadge && notificationCount > 0;
  const TRIGGER_CLASS = 'bg-slate-900/90 hover:bg-slate-800/90 text-violet-200 hover:text-white backdrop-blur-md px-3 py-2.5 sm:px-4 sm:py-3 h-auto min-h-[48px] touch-manipulation text-xs sm:text-sm transition-all duration-300';
  const showContestRules = contestVis === 'full' || contestVis === 'teaser';
  const showContestDrawing = contestVis === 'full';

  return (
    <>
      <Sheet open={open} onOpenChange={setOpen}>
        <SheetTrigger asChild>
          <Button
            onClick={() => playSound('hamburgerMenu')}
            disableDefaultSound={true}
            variant="ghost"
            size="sm"
            // Neon violet outline + glow to match the top-left corner chrome
            // (Notifications / Save Stats pills) — the whole home chrome reads as a
            // cohesive neon set.
            style={{
              border: '1.5px solid color-mix(in srgb, var(--u37-violet) 85%, white)',
              boxShadow: '0 0 16px -4px var(--u37-violet), 0 4px 12px rgba(0,0,0,0.4)',
            }}
            className={showMenuBadge ? `relative ${TRIGGER_CLASS}` : TRIGGER_CLASS}
            {...(showMenuBadge ? { 'aria-label': `Menu, ${notificationCount} notification${notificationCount === 1 ? '' : 's'}` } : {})}
          >
            <Menu className="w-4 h-4 sm:w-5 sm:h-5" />
            {showMenuBadge && (
              // The bell's count badge, moved onto the ☰ (NotificationsButton.jsx): white
              // circle, magenta text/rim/glow, gentle pulse, the raw count.
              <motion.span
                data-testid="menu-notifications-badge"
                aria-hidden="true"
                animate={{ scale: [1, 1.14, 1] }}
                transition={{ duration: 1.8, repeat: Infinity, ease: 'easeInOut' }}
                className="absolute -top-1.5 -right-1.5 min-w-[22px] h-[22px] px-1 rounded-full text-[12px] font-black flex items-center justify-center leading-none pointer-events-none"
                style={{ background: '#fff', color: 'var(--u37-magenta-deep)', border: '1.5px solid var(--u37-magenta)', boxShadow: '0 0 11px -1px var(--u37-magenta)' }}
              >
                {notificationCount}
              </motion.span>
            )}
          </Button>
        </SheetTrigger>
        {/* @ts-ignore */}
        <SheetContent
          side="right"
          className="w-72 [&>button]:hidden"
          // Cosmic-neon drawer (U4): near-black cosmic panel with a violet neon
          // left edge + glow, so it reads cleanly OVER the neon home background
          // (matches the violet-neon trigger button + the home chrome pills).
          style={{
            background: 'var(--u37-panel-bg-cosmic)',
            borderLeft: '1.5px solid color-mix(in srgb, var(--u37-violet) 60%, transparent)',
            boxShadow: '-8px 0 44px -12px var(--u37-violet)',
          }}
        >
          {/* Decorative neon glow wash */}
          <div
            className="absolute inset-0 pointer-events-none"
            style={{ background: 'radial-gradient(120% 60% at 100% 0%, color-mix(in srgb, var(--u37-violet) 12%, transparent), transparent 60%)' }}
          />

          {/* Reserve the REAL bottom band dynamically (home-indicator safe area +
              live AdMob banner) + a small buffer, so menu items never sit under
              the ad and there's no fixed-130px dead space when the ad is smaller
              or absent (web). The nav scrolls within the remaining space. */}
          <div
            className="relative flex flex-col h-full pt-8"
            style={{ paddingBottom: 'calc(0.5rem + var(--safe-bottom) + var(--ad-reserved-bottom))' }}
          >
            {/* Header */}
            <motion.div
              initial={{ opacity: 0, y: -20 }}
              animate={{ opacity: 1, y: 0 }}
              className="mb-3 text-center"
            >
              <h2
                onClick={handleMenuTap}
                data-testid="app-menu-title"
                className="text-xl font-black bg-gradient-to-r from-fuchsia-300 via-violet-300 to-fuchsia-300 bg-clip-text text-transparent mb-1.5 cursor-pointer select-none"
                style={{ filter: 'drop-shadow(0 0 10px color-mix(in srgb, var(--u37-violet) 45%, transparent))' }}
              >
                Menu
              </h2>
              <div
                className="h-0.5 w-16 mx-auto rounded-full"
                style={{ background: 'linear-gradient(90deg, var(--u37-violet), var(--u37-magenta))', boxShadow: '0 0 8px color-mix(in srgb, var(--u37-magenta) 50%, transparent)' }}
              />
            </motion.div>

            <nav className="flex-1 min-h-0 overflow-y-auto space-y-1.5 pr-1">
              {/* Notifications — the persistent re-access point for the Action
                  Center (friend requests + battle invites/your-move). A magenta
                  count pill when something's waiting; tapping restores the card
                  and lands on Home. */}
              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.03 }}
                onClick={handleNotificationsClick}
                data-testid="drawer-notifications"
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-fuchsia-500/20 rounded-xl transition-all duration-200 text-left border border-fuchsia-400/20 hover:border-fuchsia-400/50"
                // With the bell moved off the corner, a waiting item gets a faint magenta wash
                // so the eye lands on it after following the ☰ badge (subtle on purpose).
                {...(showMenuBadge ? { 'data-highlighted': 'true', style: { background: 'color-mix(in srgb, var(--u37-magenta) 10%, transparent)' } } : {})}
              >
                <Bell className="w-5 h-5 text-fuchsia-300 flex-shrink-0" />
                <span className="font-semibold flex-1">Notifications</span>
                {notificationCount > 0 && (
                  <span
                    data-testid="drawer-notifications-count"
                    className="min-w-[22px] h-[22px] px-1.5 rounded-full text-xs font-black flex items-center justify-center text-[#1a0320]"
                    style={{ background: 'var(--u37-magenta)', boxShadow: '0 0 12px -3px var(--u37-magenta)' }}
                  >
                    {notificationCount}
                  </span>
                )}
              </motion.button>

              {/* $37 weekly giveaway (David, 2026-09-05). Opens the official
                  rules on the .com site; the rules are not duplicated in the app.
                  Second in the menu as of 2026-09-12 (David's ordering).

                  ⚠️ THIS COMMENT USED TO SAY "WEB ONLY — inert on iOS/Android".
                  That was FALSE, and false before this edit: `NATIVE_ENABLED` in
                  contest.js is `true`, so `isContestPromoVisible()` returns true
                  on native and this button ships in BOTH apps. It was left behind
                  by the native rollout. If the giveaway is ever pulled from the
                  stores, flip NATIVE_ENABLED — do not re-add a comment describing
                  a gate the code does not have. */}
              {showContestRules && (
                <motion.button
                  data-testid="drawer-contest-link"
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: 0.05 }}
                  onClick={() => handleLinkClick(CONTEST.rulesUrl)}
                  className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-amber-500/20 rounded-xl transition-all duration-200 text-left border border-amber-400/20 hover:border-amber-400/50"
                >
                  <Trophy className="w-5 h-5 text-amber-300 flex-shrink-0" />
                  <span className="font-semibold">{CONTEST_LINK_LABEL}</span>
                </motion.button>
              )}

              {/* This week's $37 drawing (David, 2026-10-05): the live entrant
                  list and wheel on the .com site. Right under the rules, shown
                  under the same giveaway gate, and given a magenta glow so it
                  stands out from the plain rows. Opens in the browser the same
                  way the rules and legal links do (window.open, new tab). */}
              {showContestDrawing && (
                <motion.button
                  data-testid="drawer-drawing-link"
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: 0.06 }}
                  onClick={() => handleLinkClick(DRAWING_URL)}
                  className="w-full flex items-center gap-3 px-4 py-2.5 text-white rounded-xl transition-all duration-200 text-left border"
                  style={{
                    borderColor: 'color-mix(in srgb, var(--u37-magenta) 65%, transparent)',
                    background: 'linear-gradient(100deg, color-mix(in srgb, var(--u37-magenta) 26%, transparent), color-mix(in srgb, var(--u37-violet) 22%, transparent))',
                    boxShadow: '0 0 16px -6px var(--u37-magenta)',
                  }}
                >
                  <Sparkles className="w-5 h-5 text-fuchsia-300 flex-shrink-0" />
                  <span className="font-semibold">This Week&apos;s $37 Drawing</span>
                </motion.button>
              )}

              {/* Invite a friend — native share sheet (SMS/email/any target).
                  Reuses the shared invite text + share dispatcher (same path as
                  the Colosseum Invite-Friends CTA). Third in the menu as of
                  2026-09-12 (David's ordering); it used to sit below Mute Sound,
                  which the comment here still claimed after the move. */}
              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.075 }}
                onClick={() => {
                  playSound('hamburgerMenu');
                  shareOrCopy('native', buildInviteText());
                  setOpen(false);
                }}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-emerald-500/20 rounded-xl transition-all duration-200 text-left border border-emerald-400/20 hover:border-emerald-400/50"
              >
                <Share2 className="w-5 h-5 text-emerald-300 flex-shrink-0" />
                <span className="font-semibold">Invite Friends to 37</span>
              </motion.button>

              

              {/* ⚠️ SECURED ACCOUNTS ONLY (David, 2026-09-17, on beta 1.0.311).
                  "the edit profile button in the hamburger menu… should not be
                  present for guests. instead it should be the save stats page."

                  It rendered unconditionally while Save Stats below it was
                  correctly gated on `!isSecured`, so a guest was offered BOTH —
                  and the two lead opposite ways. Edit Profile asks a player to
                  decorate an account that will not survive the session; Save
                  Stats is the one that turns it into an account at all, and is
                  where the 18+/US question and the email live. For a guest, the
                  profile editor is not just redundant, it is the wrong door at
                  the exact moment the giveaway needs them through the right one.

                  The two conditions are now exact complements — `isSecured` here,
                  `!isSecured` there — so a player is offered exactly one. */}
              {isSecured && (
                <motion.button
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: 0.1 }}
                  onClick={() => {
                    playSound('hamburgerMenu');
                    onEditProfileClick?.();
                    setOpen(false);
                  }}
                  className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-indigo-500/20 rounded-xl transition-all duration-200 text-left border border-indigo-400/20 hover:border-indigo-400/50"
                >
                  <User className="w-5 h-5 text-indigo-300 flex-shrink-0" />
                  <span className="font-semibold text-white">Edit Profile</span>
                </motion.button>
              )}

              

              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.125 }}
                onClick={handleSoundToggle}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-blue-500/20 rounded-xl transition-all duration-200 text-left border border-blue-400/20 hover:border-blue-400/50"
              >
                {soundMuted ? (
                  <VolumeX className="w-5 h-5 text-blue-300 flex-shrink-0" />
                ) : (
                  <Volume2 className="w-5 h-5 text-blue-300 flex-shrink-0" />
                )}
                <span className="font-semibold">{soundMuted ? 'Unmute Sound' : 'Mute Sound'}</span>
              </motion.button>

              

              {/* The account entry for guests (and legacy passwordless users).
                  Was "Save Stats"; renamed when the corner pill went (David,
                  2026-10-10). A named-but-unsecured player already HAS the name,
                  so for them it reads "Add a password". Hidden once secured. */}
              {user && !isSecured && (
                <motion.button
                  initial={{ opacity: 0, x: -20 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: 0.15 }}
                  onClick={() => {
                    playSound('hamburgerMenu');
                    onSaveStatsClick?.();
                    setOpen(false);
                  }}
                  className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-blue-500/20 rounded-xl transition-all duration-200 text-left border border-blue-400/20 hover:border-blue-400/50"
                >
                  <CloudUpload className="w-5 h-5 text-blue-300 flex-shrink-0" />
                  <span className="font-semibold" data-testid="drawer-account-entry">
                    {isNamedAccount(user) ? 'Add a password' : 'Create free account'}
                  </span>
                </motion.button>
              )}

              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.15 }}
                onClick={() => handleLinkClick(POLICY_URLS.privacy)}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-purple-500/20 rounded-xl transition-all duration-200 text-left border border-purple-400/20 hover:border-purple-400/50"
              >
                <FileText className="w-5 h-5 text-purple-300 flex-shrink-0" />
                <span className="font-semibold">Privacy Policy</span>
              </motion.button>

              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.2 }}
                onClick={() => handleLinkClick(POLICY_URLS.terms)}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-purple-500/20 rounded-xl transition-all duration-200 text-left border border-purple-400/20 hover:border-purple-400/50"
              >
                <FileText className="w-5 h-5 text-purple-300 flex-shrink-0" />
                <span className="font-semibold">Terms and Conditions</span>
              </motion.button>

              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.3 }}
                onClick={() => handleLinkClick('mailto:contactus@hiipointegames.com')}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-blue-500/20 rounded-xl transition-all duration-200 text-left border border-blue-400/20 hover:border-blue-400/50"
              >
                <Mail className="w-5 h-5 text-blue-300 flex-shrink-0" />
                <span className="font-semibold">Contact Us</span>
              </motion.button>

              <motion.button
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.35 }}
                onClick={() => {
                  playSound('hamburgerMenu');
                  setShowDeleteAccount(true);
                  setOpen(false);
                }}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-red-300 hover:text-red-200 hover:bg-red-500/10 rounded-xl transition-all duration-200 text-left border border-red-500/20 hover:border-red-500/40"
              >
                <Trash2 className="w-5 h-5 text-red-400 flex-shrink-0" />
                <span className="font-semibold">Delete Account</span>
              </motion.button>
            </nav>

            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.2 }}
              className="border-t border-purple-400/30 pt-3 space-y-2"
            >
              <button
                onClick={() => { playSound('hamburgerMenu'); setOpen(false); }}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white hover:bg-purple-500/20 rounded-xl transition-all duration-200 text-left border border-purple-400/20 hover:border-purple-400/50 font-semibold"
              >
                <span>Close</span>
              </button>
              <button
                onClick={handleLogoutClick}
                className="w-full flex items-center gap-3 px-4 py-2.5 text-slate-200 hover:text-white bg-gradient-to-r from-red-500/10 to-orange-500/10 hover:from-red-500/20 hover:to-orange-500/20 rounded-xl transition-all duration-200 text-left border border-red-400/20 hover:border-red-400/50 font-semibold"
              >
                <LogOut className="w-5 h-5 text-red-300 flex-shrink-0" />
                <span>Sign Out</span>
              </button>

              {/* Beta-channel opt-in, revealed by tapping the Menu title
                  BETA_REVEAL_TAPS times. Hidden for ordinary users. */}
              {betaRevealed && (
                <div className="rounded-xl border border-amber-400/30 bg-amber-500/5 p-3">
                  <button
                    onClick={handleBetaToggle}
                    disabled={betaBusy}
                    className="w-full flex items-center gap-3 text-amber-200 hover:text-amber-100 disabled:opacity-50 transition-colors text-left font-semibold"
                  >
                    <FlaskConical className="w-5 h-5 text-amber-300 flex-shrink-0" />
                    <span>{onBeta ? 'Leave beta updates' : 'Join beta updates'}</span>
                  </button>
                  {betaMessage && (
                    <p className="mt-2 text-xs text-amber-100/80">{betaMessage}</p>
                  )}
                </div>
              )}

              <div
                data-testid="app-version"
                className="w-full text-center text-[11px] text-purple-200/50 pt-1"
              >
                v{typeof __APP_VERSION__ !== 'undefined' ? __APP_VERSION__ : '—'}
                {onBeta ? ' · beta' : ''}
              </div>
            </motion.div>
          </div>
        </SheetContent>
      </Sheet>

      <SignOutWarningModal
        isOpen={showSignOutWarning}
        onConfirm={() => {
          confirmLogout();
          setShowSignOutWarning(false);
        }}
        onCancel={() => setShowSignOutWarning(false)}
      />
      <DeleteAccountModal
        isOpen={showDeleteAccount}
        onCancel={() => setShowDeleteAccount(false)}
      />
    </>
  );
}
