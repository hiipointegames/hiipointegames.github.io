// The candidate spellings a name is judged under.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE INVARIANT, and it is the one that bit hardest during design
// ─────────────────────────────────────────────────────────────────────────────
// A transform applied to the CANDIDATE must be applied identically to the
// BLOCKLIST and to the ALLOWLIST. Fold all three, or fold none.
//
// The prototype that folded only the candidate produced both failure directions
// at once: terms stopped matching their own folded form (`phuck` escaped,
// because the term `fuck` folded to `fuc` while the term list still held
// `fuck`), and covered words stopped being covered (`analysis` folded to
// `analisis`, which the allowlist — holding `analysis` — could no longer
// explain). Everything downstream of that mistake looked like a tuning problem
// and was not.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY ONLY THREE
// ─────────────────────────────────────────────────────────────────────────────
// Two further transforms were built, measured against 429,765 real words and
// names, and REJECTED. They are recorded here so nobody re-adds them believing
// they are free:
//
//   * `devowel` (strip vowels) rejected ~4,000 ordinary words — `scott`, `cook`,
//     `cox`, `peacock` — to catch a handful of evasions.
//   * `phonetic` (ph→f, ck→k, k→c, z→s, y→i, rn→m) rejected `dice` — in a dice
//     game — plus `cook`, `Cox`, `pom`, `nasi` and 30-odd real surnames.
//
// Every evasion either of them caught is enumerated in blocklist.js's EXTRA
// instead, where it costs exactly nothing. A lossy fold buys a general rule and
// pays for it in collateral against real people; an explicit term buys one case
// and pays nothing. For this list, at this size, enumeration wins.

/** Characters a digit can be standing in for. */
const LEET = {
  0: 'o', 1: 'i', 2: 'z', 3: 'e', 4: 'a',
  5: 's', 6: 'g', 7: 't', 8: 'b', 9: 'g',
};

/**
 * Lowercase, strip accents, and reduce to `[a-z0-9]`.
 *
 * Runs before every transform. Note this is the ONLY place separators are
 * removed, which is what lets `s-h-i-t` and `s.h.i.t` be seen as one word.
 *
 * The accent strip is retained for correctness even though the format gate in
 * `validateUsername` rejects non-ASCII before this is reached — this module is
 * also called from the server, where no such gate has run.
 *
 * @param {string} input
 * @returns {string}
 */
export function baseNormalize(input) {
  return String(input ?? '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]/g, '');
}

/**
 * The transforms, applied to candidate, terms and allowlist alike.
 *
 * `plain` must stay first: it is the only one a digit-bearing term is matched
 * under (see `TRANSFORMS_FOR_TERM`).
 *
 * @type {{name: string, fn: (s: string) => string}[]}
 */
export const TRANSFORMS = [
  { name: 'plain', fn: (s) => s },
  { name: 'deleet', fn: (s) => s.split('').map((c) => LEET[c] ?? c).join('') },
  { name: 'nodigits', fn: (s) => s.replace(/[0-9]/g, '') },
];

/**
 * Which transforms a given term may be matched under.
 *
 * A digit-bearing term is a LITERAL numeric symbol — `1488`, `14words` — and
 * folding its digits away turns it into something else entirely. `14words`
 * becomes the ordinary English word `words`, which then rejects every username
 * containing it. Measured: that one bug blocked `words`, `passwords`,
 * `crosswords` and 40 others until the rule below was added.
 *
 * @param {string} term the raw (already base-normalized) term
 * @returns {{name: string, fn: (s: string) => string}[]}
 */
export function transformsForTerm(term) {
  return /[0-9]/.test(term) ? [TRANSFORMS[0]] : TRANSFORMS;
}

/**
 * Shortest allowlist entry that may license anything.
 *
 * A three-letter entry is almost always an accident of the corpus rather than a
 * word a person would choose, and short entries are exactly what turn the
 * allowlist into a loophole. Four was chosen by measurement, not taste: at 3 the
 * seaweed plural `fuci` licensed `phuckyou`.
 */
export const MIN_COVER = 4;

/**
 * Every candidate spelling of a name, de-duplicated, in transform order.
 *
 * @param {string} input the raw username
 * @returns {{name: string, text: string}[]}
 */
export function candidatesFor(input) {
  const base = baseNormalize(input);
  const seen = new Set();
  const out = [];
  for (const { name, fn } of TRANSFORMS) {
    const text = fn(base);
    if (!text || seen.has(text)) continue;
    seen.add(text);
    out.push({ name, text });
  }
  return out;
}
