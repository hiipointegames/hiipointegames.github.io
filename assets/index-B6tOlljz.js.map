// The frozen wire vocabulary for game modes and rounds.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE ONE NON-OBVIOUS THING: `'daily'` means CHALLENGE's Daily.
// ─────────────────────────────────────────────────────────────────────────────
// A reader coming to this fresh will expect a key called 'challenge' to be the
// Challenge mode's timed round. It is not. The history:
//
//   'daily'     — already, in shipped data, means "the timed, once-per-day,
//                 leaderboard-backed round played WITH power dice". That is
//                 exactly what Challenge's Daily is under the three-mode design.
//   'challenge' — already, in shipped data, means an UNTIMED PRACTICE round that
//                 also uses power dice. See src/practice-solves/recordPracticeSolve.js
//                 ("Easy and challenge are practice modes (no leaderboard)").
//
// Both strings are live in `practice_solves.mode`, in BADGE_MODES
// (src/game-mechanics/badgeRegistry.js), and in every player's badge and streak
// state. Renaming either would mean migrating real player data for no functional
// gain, so the keys are FROZEN and the two new timed rounds get new keys instead.
//
// Net effect: adding Easy's and Expert's Dailies costs zero migration.
//
// Read wire keys through the predicates in ./predicates.js rather than comparing
// strings — that is the whole point of this module.

/** @typedef {'easy'|'challenge'|'expert'} GameMode */
/** @typedef {'daily'|'practice'} RoundType */
/** @typedef {{ mode: GameMode, round: RoundType }} ModeTuple */

// Every legal wire key. Frozen: adding one is a deliberate act, not a typo.
export const MODE_KEYS = Object.freeze([
  'easy',          // Easy   · practice (untimed, unlimited)
  'challenge',     // Challenge · practice (untimed, unlimited)
  'expert',        // Expert · practice (untimed, unlimited)
  'daily_easy',    // Easy   · The Daily (timed, once/day, leaderboard)
  'daily',         // Challenge · The Daily  ← the legacy key, see above
  'daily_expert',  // Expert · The Daily (timed, once/day, leaderboard)
]);

// The three TIMED rounds, in play order. Wave 2 lanes each need this list; four
// hand-rolled copies would be four places to forget `daily_expert`.
//
// This is the client mirror of DAILY_MODES in
// supabase/functions/_shared/dailyCoverage.ts — deliberately duplicated rather
// than imported (that file is Deno, this is browser ESM), and pinned
// element-for-element by a test on BOTH sides so the two cannot drift.
//
// Order is PLAY order (easiest first), not alphabetical: it is what a UI mapping
// over the three modes should render, so the array is the single place that
// decision lives.
export const DAILY_MODE_KEYS = Object.freeze(['daily_easy', 'daily', 'daily_expert']);

/**
 * Difficulty tier → the word a player sees.
 *
 * Lives HERE, with the frozen key list, because it is the other half of the same
 * vocabulary: `modeOf` turns a wire key into a tier and this turns a tier into
 * the word. It used to live in `@/leaderboard/dailyModeTabs`, which is fine for
 * a board's pills and wrong for anything outside the leaderboard — reaching into
 * that barrel for three words drags every board component into the import graph.
 * `DAILY_MODE_LABELS` is still exported from there, now as a re-export, so this
 * is one definition rather than a mirror-and-pin pair.
 *
 * The label is the TIER, never the wire key: Challenge's Daily is stored as the
 * bare string 'daily' for zero-migration reasons (see this file's header), and
 * that is a storage detail a player must never see.
 *
 * @type {Readonly<Record<string, string>>}
 */
export const MODE_TIER_LABELS = Object.freeze({
  easy: 'Easy',
  challenge: 'Challenge',
  expert: 'Expert',
});

/**
 * The tier badge a player shares, icon included.
 *
 * ⚠️ THIS EXISTS BECAUSE THE SHARE TEXT WAS A BINARY. `SuccessModal.jsx` built
 * it as `mode === 'challenge' ? '🔥 Challenge Mode' : '🎲 Easy Mode'`, written
 * when Easy and Challenge were the only two tiers. Expert is not Challenge, so
 * it fell to the else branch and EVERY shared Expert solve announced itself as
 * "🎲 Easy Mode" — on the mode the $37 giveaway is won on, in the one artefact
 * that leaves the app and goes to other people.
 *
 * Keyed by TIER, so both rounds of a tier share one badge: a Daily Expert solve
 * and a practice Expert solve are both Expert.
 *
 * The icons are the ones already in use — 🎲 for Easy and 🔥 for Challenge come
 * straight from the string this replaces, so nothing a player already recognises
 * changes. ⚡ is new, because Expert never had one.
 *
 * @type {Readonly<Record<string, string>>}
 */
export const MODE_SHARE_LABELS = Object.freeze({
  easy: '🎲 Easy Mode',
  challenge: '🔥 Challenge Mode',
  expert: '⚡ Expert Mode',
});

/** Wire key → {mode, round}. @type {Readonly<Record<string, ModeTuple>>} */
export const KEY_TO_TUPLE = Object.freeze({
  easy:         Object.freeze({ mode: 'easy',      round: 'practice' }),
  challenge:    Object.freeze({ mode: 'challenge', round: 'practice' }),
  expert:       Object.freeze({ mode: 'expert',    round: 'practice' }),
  daily_easy:   Object.freeze({ mode: 'easy',      round: 'daily' }),
  daily:        Object.freeze({ mode: 'challenge', round: 'daily' }),
  daily_expert: Object.freeze({ mode: 'expert',    round: 'daily' }),
});

// The default for an absent or unrecognised mode.
//
// S12: Game.jsx currently coerces at six sites with TWO different defaults —
// 'daily' at :78 and :321, 'easy' at :398. One module now owns this, and the
// answer is 'easy' because it is the SAFE failure: no power dice, no timer, no
// leaderboard write. Defaulting to 'daily' would hand an unknown value a timed,
// ranked, once-per-day round. This also matches getDiceColors in src/dice/dice.js,
// which already falls back to all-white for anything it does not recognise.
export const DEFAULT_MODE_KEY = 'easy';

/** {mode, round} → wire key. Inverse of KEY_TO_TUPLE. */
export const TUPLE_TO_KEY = Object.freeze(
  Object.fromEntries(
    Object.entries(KEY_TO_TUPLE).map(([key, { mode, round }]) => [`${mode}:${round}`, key]),
  ),
);

/**
 * Wire key for a {mode, round} pair.
 * @param {GameMode} mode
 * @param {RoundType} round
 * @returns {string|null} the key, or null if the pair is not a real round
 */
export const keyFor = (mode, round) => TUPLE_TO_KEY[`${mode}:${round}`] ?? null;

/**
 * Coerce anything into a known wire key. The single coercion point.
 * @param {unknown} key
 * @returns {string} a member of MODE_KEYS
 */
export const normalizeModeKey = (key) =>
  isKnownModeKey(key) ? /** @type {string} */ (key) : DEFAULT_MODE_KEY;

// NOTE ON `Object.hasOwn` vs `in`: `in` walks the prototype chain, so
// `'toString' in KEY_TO_TUPLE` is true. The first version of this module used
// `in`, which meant normalizeModeKey('toString') returned 'toString' as if it
// were a real key, and KEY_TO_TUPLE['toString'] handed back a FUNCTION whose
// `.mode` is undefined — so every predicate would answer nonsense for any input
// naming an Object.prototype member. Own-property checks only.
/**
 * STRICT membership: is this exactly a known wire key, with no coercion?
 *
 * Use this — not the predicates — when the value is UNTRUSTED and an unknown one
 * must be REJECTED rather than defaulted. The predicates all normalize first, so
 * `isPractice('nonsense')` is true (it coerces to 'easy', which is a practice
 * mode). That is the right behaviour for rendering, where a sane fallback beats a
 * crash, and the wrong behaviour for a write gate, where an unrecognised mode
 * should mean "do nothing".
 *
 * recordPracticeSolve is the motivating case: it previously used a local
 * `Set(['easy','challenge']).has(mode)`, and swapping that for `isPractice`
 * silently turned "ignore unknown modes" into "record them as Easy".
 *
 * @param {unknown} key
 * @returns {boolean}
 */
export const isKnownModeKey = (key) =>
  typeof key === 'string' && Object.hasOwn(KEY_TO_TUPLE, key);
