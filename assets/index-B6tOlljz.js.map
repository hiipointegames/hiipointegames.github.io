// dice — internal implementation. Public surface lives in index.js.
//
// The codebase historically generated dice two different shapes inline
// across 6 files:
//   1. Rich objects `{id, value, originalIndex}` — Game.jsx (interactive
//      daily/solo mode where the dice list needs stable React keys).
//   2. Plain integers — HeadToHeadGame / ChallengeFriend / CreateChallenge
//      (battle dice_sequence stored in the DB on the HeadToHeadChallenge
//      entity; never shuffled, indexed positionally).
//
// Both shapes are preserved as named functions so callers pick by use case,
// not by shape.

// Canonical power-dice color array. The first 4 dice are white; the last
// 3 are colored. The equation engine only differentiates colored from
// white — order within the colored trio is purely visual but is now
// canonicalised here so all renderers display the same colors at the
// same positions.
export const POWER_DICE_COLORS = Object.freeze([
  'white', 'white', 'white', 'white', 'blue', 'red', 'green',
]);

// Colors for easy / non-challenge modes — all white, no power dice.
export const EASY_DICE_COLORS = Object.freeze([
  'white', 'white', 'white', 'white', 'white', 'white', 'white',
]);

// Every wire key whose dice carry power colours.
//
// EXPERT WAS MISSING HERE, and it made Expert impossible to generate. This read
// `mode === 'challenge' || mode === 'daily'`, so 'expert' and 'daily_expert'
// fell through to all-white — while hasPowerDice() in @/game-modes answers TRUE
// for them (it is `modeOf(key) !== 'easy'`). Two helpers that document each
// other as mirrors, disagreeing on exactly the mode neither had shipped yet.
//
// The consequence was total, not cosmetic: the generator coloured an Expert
// candidate all-white, and Expert's acceptance predicate demands
// `valid_solutions_count >= 3` — a count that can only ever be 0 with no
// coloured dice. Measured before the fix: 0/10 Expert candidates accepted.
// Expert would have returned `no_solvable_puzzle` every single night.
//
// An explicit set rather than a negation, so adding a mode is a deliberate act:
// a new key that belongs here must be added on purpose, and anything
// unrecognised still falls back to all-white, which is the safe direction.
const POWER_DICE_MODES = new Set(['challenge', 'daily', 'expert', 'daily_expert']);

// Map a game mode string to its color array. Unknown modes get all-white — never
// silently hand out power dice for a key we do not recognise.
export const getDiceColors = (mode) =>
  (POWER_DICE_MODES.has(mode) ? POWER_DICE_COLORS : EASY_DICE_COLORS);

// Generate a die value 1-6 inclusive.
const rollDie = () => Math.floor(Math.random() * 6) + 1;

// Rich dice — stable IDs for React keys, required for Game.jsx interactive
// state where usedDiceIndices must follow each die through reorderings.
export const generateDailyDice = () => {
  const timestamp = Date.now();
  return Array.from({ length: 7 }, (_, index) => ({
    id: `die_${timestamp}_${index}_${Math.random().toString(36).substring(7)}`,
    value: rollDie(),
    originalIndex: index,
  }));
};

// Plain dice — integers only, for HeadToHead battle dice_sequence storage
// and any consumer that doesn't need stable per-die identity.
//
// NOTE: this is UNSEEDED (Math.random). That is CORRECT for solo Blitz — there
// is no opponent to stay in sync with — but WRONG for a two-player battle, where
// both devices must roll the identical puzzle at each index. Battles use the
// stored `dice_sequence` array (shared DB row) plus `blitzDiceForIndex` below
// for any puzzle past the array's end. See docs/bugs.md 2026-07-30.
export const generateBlitzDice = () => {
  return Array.from({ length: 7 }, () => rollDie());
};

// --- Deterministic seeded blitz dice (BATTLE mode) ---------------------------
//
// Two players in a battle must race the SAME puzzle at each sequential index.
// The stored `dice_sequence` keeps them synced while in range; this function is
// the synced source PAST the array's end (and a defensive backstop generally).
// Determinism comes from the challenge's shared UUID (`seed`) plus the puzzle
// `index`: both devices hash the identical `${seed}:${index}` string, so index N
// yields byte-identical dice on both. Pure — no Date, no Math.random, no globals.
//
// PRNG: xmur3 string-hash seeds mulberry32. Both are small, well-known, and fast
// — good enough for fairness (these are game dice, not cryptographic material).

// xmur3 — hash a string into a 32-bit seed generator (returns a stateful fn).
const xmur3 = (str) => {
  let h = 1779033703 ^ str.length;
  for (let i = 0; i < str.length; i++) {
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  return () => {
    h = Math.imul(h ^ (h >>> 16), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    h ^= h >>> 16;
    return h >>> 0;
  };
};

// mulberry32 — a 32-bit seed produces a deterministic [0, 1) sequence.
const mulberry32 = (seed) => {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

// Deterministic 7-dice roll for battle puzzle `index`, derived from the battle's
// shared `seed` (pass `challenge.id`). Same (seed, index) → identical array on
// every device; distinct indices/seeds generally differ. Values are 1-6.
export const blitzDiceForIndex = (seed, index) => {
  const nextSeed = xmur3(`${seed}:${index}`);
  const rand = mulberry32(nextSeed());
  return Array.from({ length: 7 }, () => Math.floor(rand() * 6) + 1);
};
