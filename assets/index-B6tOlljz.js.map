/**
 * Terms that reject ONLY as the whole name.
 *
 * `heil` and `sieg` are here on David's call (2026-09-06). As substrings they
 * reject `Sheila` and `Siegel` — a common first name and a common Jewish
 * surname — and, verified against the real module, they catch nothing the rest
 * of the list does not: `nazi`, `hitler`, `swastika`, `whitepower`, `kkk`,
 * `1488` and `14words` all remain. Narrowing keeps the symbol blocked while
 * ending the collateral against people who are simply called that.
 *
 * @type {string[]}
 */
export const WHOLE_NAME_TERMS = ['heil', 'sieg'];

/**
 * Evasions that a lossy normalization would have caught, enumerated instead.
 *
 * Two folds were prototyped and rejected for cost (see `transforms.js`):
 * `devowel` rejected ~4,000 ordinary words, `phonetic` rejected `dice` — in a
 * dice game — along with `cook`, `Cox` and 30-odd real surnames. Everything
 * either of them caught is listed here, where it costs nothing at all.
 *
 * This is the deliberate trade: a general fold buys a rule and pays in
 * collateral against real people; an explicit term buys one case and pays
 * nothing. At this list size, enumeration wins. Add to this list, not to the
 * transforms.
 *
 * @type {string[]}
 */
export const EVASION_TERMS = [
  'fck', 'sht', 'nggr', 'btch', 'cnt', 'niga', 'nigr', 'nigor', 'nlgger',
  'phuk', 'phuc', 'phuck', 'fuk', 'fuc', 'fvck', 'fuq', 'phag', 'phaggot',
  'kunt', 'kuunt', 'cnut', 'shyt', 'shvt', 'azz', 'azzhole',
  'nazl', 'nasi', 'kys', 'kyss',
];

/**
 * Mild words that reject only when a targeting word sits directly beside them.
 *
 * @type {string[]}
 */
export const CONTEXTUAL_TERMS = ['ass', 'bastard', 'bitch', 'damn', 'hell', 'piss'];

/**
 * Words that turn an adjacent contextual word into targeted abuse.
 *
 * ADJACENCY is the whole rule (David's call, 2026-09-06). The previous version
 * required only that both appear SOMEWHERE in the name, in any order and
 * unrelated, which is why it rejected `GrassKiller`, `PassRemover`,
 * `BassDestroyer` and `KillerBass` — verified against the real module. A set
 * intersection is not a grammar; adjacency is the cheapest thing that is.
 *
 * @type {string[]}
 */
export const TARGETING_TERMS = [
  'kill', 'hate', 'death', 'die', 'destroy', 'exterminate', 'eliminate', 'remove',
];

/**
 * Every term the matcher compiles, with its mode.
 *
 * @returns {BlockTerm[]}
 */
export function allBlockTerms() {
  return [
    ...SUBSTRING_TERMS.map((term) => ({ term, mode: /** @type {const} */ ('substring') })),
    ...EVASION_TERMS.map((term) => ({ term, mode: /** @type {const} */ ('substring') })),
    ...WHOLE_NAME_TERMS.map((term) => ({ term, mode: /** @type {const} */ ('whole') })),
  ];
}

/**
 * A stable fingerprint of everything the derived allowlist depends on.
 *
 * `allowlist.generated.js` records the fingerprint it was built from, and
 * `allowlistDrift.test.js` fails when the two disagree — which is what stops a
 * term being added without the allowlist being regenerated. Without it, a new
 * term silently starts rejecting every real word that contains it.
 *
 * A plain FNV-1a over the sorted term set: it needs to be stable and
 * dependency-free, not cryptographic.
 *
 * @returns {string} 8 hex characters
 */
export function blocklistFingerprint() {
  const material = [
    ...SUBSTRING_TERMS, ...EVASION_TERMS, ...WHOLE_NAME_TERMS, ...CONTEXTUAL_TERMS,
  ].slice().sort().join('\n');
  let hash = 0x811c9dc5;
  for (let i = 0; i < material.length; i += 1) {
    hash ^= material.charCodeAt(i);
    hash = Math.imul(hash, 0x01000193) >>> 0;
  }
  return hash.toString(16).padStart(8, '0');
}
