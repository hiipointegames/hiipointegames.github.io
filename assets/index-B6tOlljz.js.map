import React, { useEffect, useRef, useState } from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { playSound } from '@/ui/feedback';
import { computeRocketHandoff, ROCKET_MIN_MS, ROCKET_CAP_MS } from './rocketLaunchController';

// RocketLaunchScreen — the daily-win loading celebration (2026-07-13, David's
// interview + crispy review). On a daily win this overlays the results at
// z-[200] while the SuccessModal computes its "what was possible" solver
// UNDERNEATH; the rocket shoots diagonally across a warping starfield, then the
// overlay lifts away to reveal the already-loaded results. It is a *latency
// mask*: the flight lasts at least `minMs` and at most `capMs`, handing off early
// the instant `ready` flips true.
//
// Design (crispy R1): themed to DAILY's signature cyan (--u37-cyan/-blue); the
// warp-streak stars run continuously so the screen never goes static after the
// rocket exits (kills the "dead air" gap when results are slow); honours
// prefers-reduced-motion (calm centered rocket, no fly/warp). GPU-cheap:
// transform/opacity only; `will-change` scoped to the moving parts. Launch music
// is per-mode (L2-3, David 2026-07-26): DAILY keeps its signature theme
// (`bassGuitar`) as the once-a-day marquee track; Easy & Challenge play a shorter
// generic win chime (`victoryResults`) so a practice win no longer plays the
// Daily anthem.

// A hand-built vector rocket (points "up"; the flight wrapper rotates it along
// the diagonal). Daily-cyan palette via design tokens.
function RocketGlyph() {
  return (
    <svg width="72" height="112" viewBox="0 0 72 112" fill="none" aria-hidden="true">
      {/* exhaust flame — cyan→blue, flickers via opacity/scale only */}
      <motion.g
        animate={{ scaleY: [1, 1.5, 0.9, 1.35, 1], opacity: [0.95, 0.7, 1, 0.75, 0.95] }}
        transition={{ duration: 0.28, repeat: Infinity, ease: 'easeInOut' }}
        style={{ transformOrigin: '36px 92px', willChange: 'transform, opacity' }}
      >
        <path d="M26 92 Q36 128 46 92 Q36 104 26 92 Z" fill="var(--rk-primary)" />
        <path d="M30 92 Q36 116 42 92 Q36 100 30 92 Z" fill="var(--rk-secondary)" />
      </motion.g>
      {/* body */}
      <path d="M36 6 C50 20 52 48 50 74 L22 74 C20 48 22 20 36 6 Z"
        fill="var(--u37-text)" stroke="var(--rk-primary)" strokeWidth="2" />
      {/* nose tip glow */}
      <path d="M36 6 C44 15 47 28 47 40 L25 40 C25 28 28 15 36 6 Z"
        fill="var(--rk-primary)" opacity="0.85" />
      {/* window */}
      <circle cx="36" cy="42" r="8" fill="var(--u37-bg)" stroke="var(--rk-primary)" strokeWidth="2" />
      <circle cx="36" cy="42" r="3.5" fill="var(--rk-primary)" />
      {/* fins */}
      <path d="M22 66 L10 86 L22 78 Z" fill="var(--rk-secondary)" />
      <path d="M50 66 L62 86 L50 78 Z" fill="var(--rk-secondary)" />
    </svg>
  );
}

// Sparse starfield backdrop — a few twinkling dots, pure opacity animation.
const STARS = Array.from({ length: 18 }, (_, i) => ({
  left: (i * 37 + 11) % 100,
  top: (i * 53 + 7) % 100,
  size: 1 + (i % 3),
  delay: (i % 5) * 0.3,
}));

// Warp-streak lines — thin cyan streaks that continuously rush bottom-left→
// top-right, so motion never dies after the rocket exits (crispy F1/E2).
const STREAKS = Array.from({ length: 9 }, (_, i) => ({
  top: (i * 11 + 6) % 96,
  delay: (i % 6) * 0.18,
  dur: 0.7 + (i % 4) * 0.16,
  len: 60 + (i % 3) * 34,
}));

// Per-mode palette so the loader reads as the mode you're in and differs from
// daily (David, 2026-07-13): daily = signature cyan/blue (unchanged), easy =
// green, challenge = cyan -- Challenge and its Daily are ONE mode since
// 2026-08-31, so they deliberately share the cyan primary and differ only in
// the secondary and the backdrop tint. `primary`/`secondary` drive every accent via the
// inherited --rk-primary/--rk-secondary custom properties; `bg` tints the
// radial backdrop.
//
// ⚠️ EVERY MODE KEY MUST BE PRESENT. Lookup is `ROCKET_PALETTES[mode] ||
// ROCKET_PALETTES.daily`, so a MISSING key is silent — it does not throw, it
// just paints cyan. That is exactly the bug David reported on 2026-09-12:
// "currently all of them are the cyan blue for just challenge". The map held
// only `daily`, `easy` and `challenge`, while the daily surfaces pass
// `daily_easy` and `daily_expert` — neither matched, both fell back to cyan, and
// the Easy and Expert dailies had never once launched in their own colour.
//
// The tier colours are the app-wide ones (TIER_ACCENT in head-to-head/blitzMode):
// easy green, challenge cyan, expert gold. A daily and its practice tier share a
// colour — the tier is what the colour identifies, not the surface.
const ROCKET_PALETTES = {
  // Challenge — cyan. `daily` is Challenge's daily (the historical key).
  daily: { primary: 'var(--u37-cyan)', secondary: 'var(--u37-blue)', bg: 'radial-gradient(ellipse at 50% 120%, #0b2b47 0%, #05101d 55%, #02060d 100%)' },
  challenge: { primary: 'var(--u37-cyan)', secondary: 'var(--u37-cyan-deep)', bg: 'radial-gradient(ellipse at 50% 120%, #2a1147 0%, #12061f 55%, #02060d 100%)' },

  // Easy — green.
  easy: { primary: 'var(--u37-green)', secondary: '#0f8a52', bg: 'radial-gradient(ellipse at 50% 120%, #0b3a24 0%, #05130d 55%, #02060d 100%)' },
  daily_easy: { primary: 'var(--u37-green)', secondary: '#0f8a52', bg: 'radial-gradient(ellipse at 50% 120%, #0b3a24 0%, #05130d 55%, #02060d 100%)' },

  // Expert — gold. `--u37-gold-deep` is the token's own darker step, so the
  // exhaust reads as one material rather than two unrelated yellows.
  expert: { primary: 'var(--u37-gold)', secondary: 'var(--u37-gold-deep)', bg: 'radial-gradient(ellipse at 50% 120%, #40300a 0%, #1a1204 55%, #02060d 100%)' },
  daily_expert: { primary: 'var(--u37-gold)', secondary: 'var(--u37-gold-deep)', bg: 'radial-gradient(ellipse at 50% 120%, #40300a 0%, #1a1204 55%, #02060d 100%)' },
};

// Per-mode launch sound (L2-3, David 2026-07-26). DAILY = the signature theme
// (`bassGuitar`); Easy & Challenge = the shorter generic win chime
// (`victoryResults`) so a regular win no longer plays the Daily anthem. Falls
// back to the daily theme for any unknown mode.
//
// This map has the SAME every-key-must-be-present rule as the palettes above, and
// had the same hole. `expert` was missing, so a practice Expert win fell back to
// `bassGuitar` — the Daily anthem — while practice Easy and Challenge correctly
// played the short chime. Fixed 2026-09-12 alongside the palettes.
//
// The rule, stated so a new key is an obvious decision rather than a guess:
//   every DAILY  -> bassGuitar     (the signature theme; a daily is the event)
//   every PRACTICE -> victoryResults (the short chime; a practice win is not)
const ROCKET_LAUNCH_SOUNDS = {
  daily: 'bassGuitar',
  daily_easy: 'bassGuitar',
  daily_expert: 'bassGuitar',
  easy: 'victoryResults',
  challenge: 'victoryResults',
  expert: 'victoryResults',
};

/**
 * @param {{
 *   isOpen?: boolean, ready?: boolean, onComplete?: () => void,
 *   minMs?: number, capMs?: number,
 *   mode?: 'easy' | 'challenge' | 'expert' | 'daily_easy' | 'daily' | 'daily_expert'
 * }} props
 */
export default function RocketLaunchScreen({
  isOpen = false,
  ready = false,
  onComplete,
  minMs = ROCKET_MIN_MS,
  capMs = ROCKET_CAP_MS,
  mode = 'daily',
}) {
  const reduce = useReducedMotion();
  const pal = ROCKET_PALETTES[mode] || ROCKET_PALETTES.daily;
  const [dismissing, setDismissing] = useState(false);
  const readyRef = useRef(ready);
  const onCompleteRef = useRef(onComplete);

  useEffect(() => { readyRef.current = ready; }, [ready]);
  useEffect(() => { onCompleteRef.current = onComplete; }, [onComplete]);

  // Launch: play music, then poll the handoff policy until it says done. Elapsed
  // time is accumulated from the poll interval itself (not Date.now()) so the
  // latency-mask timing is deterministic and independent of the wall clock.
  useEffect(() => {
    if (!isOpen) return undefined;
    setDismissing(false);
    playSound(ROCKET_LAUNCH_SOUNDS[mode] || ROCKET_LAUNCH_SOUNDS.daily);
    const POLL_MS = 80;
    let elapsedMs = 0;
    const id = setInterval(() => {
      elapsedMs += POLL_MS;
      const { done } = computeRocketHandoff({ elapsedMs, ready: readyRef.current, minMs, capMs });
      if (done) {
        clearInterval(id);
        setDismissing(true);
      }
    }, POLL_MS);
    return () => clearInterval(id);
  }, [isOpen, minMs, capMs, mode]);

  // Once we start dismissing, let the fade-out play, then hand off to results.
  useEffect(() => {
    if (!dismissing) return undefined;
    const t = setTimeout(() => onCompleteRef.current?.(), 380);
    return () => clearTimeout(t);
  }, [dismissing]);

  if (!isOpen) return null;

  // framer-motion's MotionStyle type rejects raw CSS custom properties, so type
  // the root style as `any` (the props feed the inherited --rk-* accents).
  /** @type {any} */
  const rootStyle = { background: pal.bg, '--rk-primary': pal.primary, '--rk-secondary': pal.secondary };

  return (
    <motion.div
      // Appear FULLY OPAQUE from the first frame — no fade-in. The rocket is an
      // opaque latency mask at z-[200]; a fade-in let you see THROUGH it to the
      // z-50 SuccessModal + the home launcher behind for ~200ms on submit, which
      // is the "flash of home + success before the rocket" bug (U8). Only the
      // fade-OUT (dismissing) animates, to hand off gracefully to the results.
      initial={{ opacity: 1 }}
      animate={{ opacity: dismissing ? 0 : 1 }}
      transition={{ duration: dismissing ? 0.36 : 0 }}
      className="fixed inset-0 z-[200] overflow-hidden u37-ad-safe-pb"
      style={rootStyle}
      role="dialog"
      aria-modal="true"
      aria-label="Launching your results"
      data-testid="rocket-launch-screen"
    >
      {/* starfield (twinkles unless reduced-motion) */}
      {STARS.map((s, i) => (
        <motion.span
          key={i}
          className="absolute rounded-full"
          style={{
            left: `${s.left}%`, top: `${s.top}%`,
            width: s.size, height: s.size,
            background: '#cfeeff', boxShadow: '0 0 6px var(--rk-primary)',
          }}
          animate={reduce ? undefined : { opacity: [0.2, 0.9, 0.2] }}
          transition={reduce ? undefined : { duration: 1.8 + (i % 3) * 0.5, repeat: Infinity, ease: 'easeInOut', delay: s.delay }}
        />
      ))}

      {/* warp-streak lines — continuous motion so the screen never goes static
          after the rocket exits. Skipped entirely under reduced-motion. */}
      {!reduce && STREAKS.map((s, i) => (
        <motion.span
          key={`warp-${i}`}
          aria-hidden
          className="absolute"
          data-testid="rocket-warp-streak"
          style={{
            top: `${s.top}%`, left: 0, height: 2, width: s.len, borderRadius: 9999,
            background: 'linear-gradient(90deg, transparent, var(--rk-primary))',
            willChange: 'transform, opacity',
          }}
          initial={{ x: '-20vw', y: 0, opacity: 0 }}
          animate={{ x: '120vw', y: '-40vh', opacity: [0, 0.6, 0] }}
          transition={{ duration: s.dur, repeat: Infinity, ease: 'linear', delay: s.delay }}
        />
      ))}

      {/* flight wrapper — !reduce: shoots bottom-left → top-right, rotated along
          the arc. reduce: a calm centered rocket with a gentle pulse (no travel). */}
      <motion.div
        className="absolute"
        style={reduce
          ? { left: '50%', top: '38%', translateX: '-50%', willChange: 'transform' }
          : { left: 0, top: 0, willChange: 'transform' }}
        initial={reduce ? { scale: 0.96, opacity: 0 } : { x: '-16vw', y: '90vh', rotate: 42, scale: 0.85 }}
        animate={reduce ? { scale: [1, 1.05, 1], opacity: 1 } : { x: '112vw', y: '-26vh', rotate: 54, scale: 1.1 }}
        transition={reduce
          ? { scale: { duration: 1.6, repeat: Infinity, ease: 'easeInOut' }, opacity: { duration: 0.3 } }
          : { duration: 2.0, ease: 'easeOut' }}
      >
        {/* neon vapour trail behind the rocket (flight only) */}
        {!reduce && (
          <motion.div
            aria-hidden
            className="absolute"
            style={{
              right: 44, top: 74, width: 160, height: 10, borderRadius: 9999,
              background: 'linear-gradient(90deg, transparent, var(--rk-primary))',
              transformOrigin: 'right center', willChange: 'transform, opacity',
            }}
            animate={{ scaleX: [0.2, 1, 0.6], opacity: [0.1, 0.7, 0.25] }}
            transition={{ duration: 0.4, repeat: Infinity, ease: 'easeOut' }}
          />
        )}
        <RocketGlyph />
      </motion.div>

      {/* loading caption — reinforces that results are being prepared underneath */}
      <div className="absolute inset-x-0 bottom-[18%] flex flex-col items-center gap-3 px-6 text-center">
        <motion.h2
          className="text-2xl font-black tracking-wide"
          style={{ color: 'var(--rk-primary)', textShadow: '0 0 18px var(--rk-primary)' }}
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.15 }}
        >
          Liftoff!
        </motion.h2>
        <motion.p
          className="text-sm font-semibold text-slate-300"
          animate={reduce ? undefined : { opacity: [0.5, 1, 0.5] }}
          transition={reduce ? undefined : { duration: 1.3, repeat: Infinity, ease: 'easeInOut' }}
        >
          Preparing your results…
        </motion.p>
      </div>
    </motion.div>
  );
}
