import React from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { AlertTriangle } from 'lucide-react';

// Sign-out confirmation.
//
// ─────────────────────────────────────────────────────────────────────────────
// NEON PASS, 2026-09-12 (David: "revamped so that it's more along the neon color
// scheme of the rest of the game")
// ─────────────────────────────────────────────────────────────────────────────
// It was the last modal still wearing stock Tailwind — `bg-slate-800`, an amber
// border, a flat Material-red button — next to a launcher built entirely from
// the `--u37-*` tokens. It did not look broken so much as borrowed from another
// app, the same diagnosis ChallengeBattleCard got.
//
// ⚠️ IT IS STILL RED, AND THAT IS DELIBERATE. This is the one destructive action
// in the app, and the warning it carries is real: a guest who signs out loses
// everything. "Make it match the neon theme" is not a reason to make the
// destructive button look like every other pretty button on the screen — so the
// red became a NEON red that belongs to the palette (rose #f43f5e with a real
// glow) rather than a flat #dc2626 that belongs to Bootstrap.
//
// The safe path is the loud one: Cancel is the cyan neon fill used for primary
// actions everywhere else, and it sits FIRST. Sign Out is outlined rather than
// filled — present, legible, unmistakably the dangerous one, and not the thing
// your thumb lands on by default.
export default function SignOutWarningModal({ isOpen, onConfirm, onCancel }) {
    // Prevent background scrolling when modal is open
    React.useEffect(() => {
        if (isOpen) {
            const scrollY = window.scrollY;
            document.body.style.position = 'fixed';
            document.body.style.top = `-${scrollY}px`;
            document.body.style.width = '100%';
            document.body.style.overflow = 'hidden';

            return () => {
                document.body.style.position = '';
                document.body.style.top = '';
                document.body.style.width = '';
                document.body.style.overflow = '';
                window.scrollTo(0, scrollY);
            };
        }
    }, [isOpen]);

    const DANGER = '#f43f5e';

    return (
        <AnimatePresence>
            {isOpen && (
                <motion.div
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    exit={{ opacity: 0 }}
                    className="fixed inset-0 z-[200] flex items-center justify-center p-4 u37-ad-safe-pb backdrop-blur-sm"
                    style={{ background: 'var(--u37-scrim)' }}
                >
                    <motion.div
                        initial={{ scale: 0.9, y: 20 }}
                        animate={{ scale: 1, y: 0 }}
                        exit={{ scale: 0.9, y: 20 }}
                        data-testid="signout-panel"
                        className="w-full max-w-md rounded-3xl p-6 border-2"
                        style={{
                            // The cosmic panel every other overlay uses, with the
                            // danger colour carried in the border and glow so the
                            // whole card reads as "careful" before a word is read.
                            background: 'var(--u37-panel-bg-cosmic)',
                            borderColor: `color-mix(in srgb, ${DANGER} 55%, transparent)`,
                            boxShadow: `0 0 44px -12px ${DANGER}, 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)`,
                        }}
                    >
                        {/* Warning icon */}
                        <div className="flex justify-center mb-4">
                            <div
                                className="w-16 h-16 rounded-full flex items-center justify-center"
                                style={{
                                    background: `color-mix(in srgb, ${DANGER} 16%, transparent)`,
                                    border: `1.5px solid color-mix(in srgb, ${DANGER} 45%, transparent)`,
                                    boxShadow: `0 0 26px -8px ${DANGER}`,
                                }}
                            >
                                <AlertTriangle className="w-9 h-9" style={{ color: DANGER }} />
                            </div>
                        </div>

                        <h2
                            className="text-2xl font-black text-center mb-3 tracking-tight"
                            style={{ color: '#fff', textShadow: `0 0 18px color-mix(in srgb, ${DANGER} 55%, transparent)` }}
                        >
                            Sign out?
                        </h2>

                        {/* Message — plain English (no "local session" jargon). */}
                        <div
                            className="rounded-xl p-4 mb-6"
                            style={{ background: 'var(--u37-surface)', border: '1px solid var(--u37-hair)' }}
                        >
                            <p className="text-slate-300 text-sm text-center leading-relaxed">
                                You&apos;ll be signed out on this device.
                                <br />
                                <br />
                                <strong style={{ color: DANGER }}>
                                    If you haven&apos;t saved your stats to an account, your progress and scores will be lost.
                                </strong>
                                <br />
                                <br />
                                Do you want to sign out?
                            </p>
                        </div>

                        {/* Cancel FIRST and filled; Sign Out outlined. The safe path
                            is the one the thumb finds. */}
                        <div className="space-y-3">
                            <Button
                                onClick={onCancel}
                                className="w-full py-6 text-lg font-black rounded-xl border-0 touch-manipulation active:scale-95"
                                style={{
                                    background: 'var(--u37-cyan)',
                                    color: '#050310',
                                    boxShadow: '0 0 26px -7px var(--u37-cyan), inset 0 1px 0 rgba(255,255,255,0.4)',
                                }}
                            >
                                Cancel
                            </Button>

                            <Button
                                onClick={onConfirm}
                                data-testid="signout-confirm"
                                className="w-full py-6 text-lg font-black rounded-xl touch-manipulation active:scale-95"
                                style={{
                                    color: DANGER,
                                    background: `color-mix(in srgb, ${DANGER} 12%, transparent)`,
                                    border: `2px solid color-mix(in srgb, ${DANGER} 70%, transparent)`,
                                    boxShadow: `0 0 20px -8px ${DANGER}`,
                                }}
                            >
                                Sign Out
                            </Button>
                        </div>
                    </motion.div>
                </motion.div>
            )}
        </AnimatePresence>
    );
}
