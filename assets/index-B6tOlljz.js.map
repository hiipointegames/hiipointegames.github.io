// Username validation — FORMAT rules, plus a delegated content check.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT MOVED, AND WHY (2026-09-06)
// ─────────────────────────────────────────────────────────────────────────────
// This file used to carry a 297-entry blocklist, its own normalizer, and the
// matching logic. All three now live in `@/moderation`, which was built to fix
// two failures pinned in this file's test suite as known-wrong behaviour:
//
//   * THE DOUBLING BYPASS — the normalizer clamped runs of three-or-more to
//     TWO, so a single doubled letter defeated the entire blocklist.
//     `shiitlord` and `fuuck` passed. The same clamp made `kkk` and `xxx`
//     unmatchable by construction.
//   * THE SCUNTHORPE PROBLEM — matching was substring, so `analysis`,
//     `cockatoo`, `titanium`, `document`, `raccoon`, `Sheila`, `Dickinson` and
//     `Hancock` were all rejected.
//
// They were not fixable by tuning one dial, because they are not on one dial:
// the first is a NORMALIZATION defect and the second a MATCHING defect. See
// `.crispy/sessions/2026-09-06-username-moderation/` for the design and the
// measurements.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT STAYED
// ─────────────────────────────────────────────────────────────────────────────
// The four format gates, unchanged, and the order they run in. They come FIRST
// deliberately: a format rejection tells the player exactly what to fix, while a
// content rejection deliberately does not name the rule it hit. Reversing the
// order would leak the blocklist to anyone willing to type.
//
// The signature is unchanged — `{ valid, error, formatted }` — so
// `CreateAccountForm` and `UsernamePrompt` did not have to move with it.

import {
  CONTENT_REJECTION_MESSAGE,
  appealMailto,
  moderateName,
} from '@/moderation';

/**
 * Validate a username's format, then its content.
 *
 * @param {string} username as typed by the player
 * @returns {{ valid: boolean, error: string|null, formatted?: string, appealHref?: string }}
 *   `formatted` is present only on success. `appealHref` is present only on a
 *   CONTENT rejection — a format rejection is the player's to fix, and needs no
 *   appeal.
 */
export const validateUsername = (username) => {
  // ── Format ────────────────────────────────────────────────────────────────
  if (!username || username.trim().length === 0) {
    return { valid: false, error: 'Username is required' };
  }

  if (username.length < 3) {
    return { valid: false, error: 'Username must be at least 3 characters long' };
  }

  if (username.length > 20) {
    return { valid: false, error: 'Username must be less than 20 characters' };
  }

  if (!/^[a-zA-Z0-9_-]+$/.test(username)) {
    return { valid: false, error: 'Username can only contain letters, numbers, hyphens, and underscores' };
  }

  // ── Content ───────────────────────────────────────────────────────────────
  const verdict = moderateName(username);
  if (!verdict.ok) {
    // ONE stable message, and a route to a human.
    //
    // The previous version picked randomly from ten jokey strings on every call,
    // so submitting the same name twice showed different text — a player who
    // believed the rejection was wrong could not even quote what they saw. And
    // for `Dickinson`, `Hancock` and `Cockburn`, they were right.
    //
    // It still does not say WHICH term matched. That was always deliberate:
    // naming it tells someone probing the filter exactly what to try next.
    return {
      valid: false,
      error: CONTENT_REJECTION_MESSAGE,
      appealHref: appealMailto(username),
    };
  }

  // Stored form: the raw input, TRIMMED ONLY. NOT the normalized form the
  // content check compares against — that one drops hyphens, underscores and
  // digits, and is a matching artifact, never a value.
  //
  // The player's capitals are theirs (2026-09-10). This used to lowercase,
  // so "BiscuitsNGravy" silently became "biscuitsngravy" on every board.
  // Uniqueness and login are unaffected — both go through `lower(username)`
  // — and moderation normalises case before matching, so capitals are not a
  // way past it.
  return {
    valid: true,
    error: null,
    formatted: username.trim(),
  };
};
