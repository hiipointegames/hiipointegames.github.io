// solveCompletion — everything that happens AFTER the board says 37, lifted out
// of Game.jsx's handleSubmit.
//
// WHY IT EXISTS. Three separate concerns were braided together inside one
// 160-line callback on a page that no test could mount:
//   1. the stats LEDGER (awardDailyChallengeSolve, captured out of a setState
//      updater so the save below reads the new value and not the batched-stale one),
//   2. the PERSIST chain (updateMe → me → re-derive → sync profile), whose two
//      failure branches mean different things and are reported differently,
//   3. the CELEBRATION hand-off, which needs numbers that do not exist yet at the
//      moment the rocket launches.
//
// (3) is the reason this file is worth having. Two of the six award families are
// only knowable ASYNCHRONOUSLY:
//   • puzzle/battle point tiers — `puzzle_points` and `battle_points` are
//     SERVER-DERIVED (`get-player-stats`); the client's local count is a mirror.
//   • registry badges — craft/Blitz/existing badge state is derived from the
//     solve and battle LOGS, three network reads away.
// Game.jsx passed neither. It handed `celebration.begin` a locally-guessed
// `prevPuzzle → prevPuzzle + 1`, no battle points at all, and no badges — so the
// battle tier saw `0 → 0` and could never fire, and EVERY registry badge was
// structurally unannounceable (`detectNewAwards`' `badges` argument had no caller
// anywhere in the app). See docs/bugs.md 2026-09-03.
//
// THE SHAPE OF THE FIX: a two-phase celebration.
//   `begin`  fires immediately with what is known locally, so the rocket launches
//            the instant the player solves — no added latency, ever.
//   `settle` fires when the authoritative numbers land and RE-COMPUTES the queue.
//            It is a no-op if the player is already watching the awards, so it can
//            never yank a celebration off the screen mid-sequence.
//
// WHAT THIS DELIBERATELY DOES NOT DO. It does not invent persistence. Badge
// announcements are diffed against the SAME `announcedBadges` snapshot the stats
// page uses, so a badge announces exactly once no matter which surface gets there
// first, and the retroactive launch summary is left alone (see below).

import { apiClient } from '@/transport';
import { reportSolveFailure, SOLVE_STAGE, reportedFallback } from '@/observability';
import { awardDailyChallengeSolve, piecesForSolve } from '@/game-mechanics';
import { requiresPerfectSolve } from '@/game-modes';
import {
  getPlayerStats,
  applyReloadedStats,
  getCraftBadgeState,
  getBlitzBadgeState,
  getExistingBadgeState,
} from '@/stats-aggregation';
import { buildBadgeStateIndex } from '@/components/stats/badgeShowcaseModel';
import { syncPublicProfile } from '@/player';
import { planBadgeAnnouncement } from './badgeAnnouncements';
import { readAnnouncedAwards, badgeSnapshotFromRecord, badgesAreFirstRun } from './announcedAwards';
import { sealBadgeFirstRun } from './badgeFirstRunSeal';

/**
 * Run this solve through the stats ledger and return the result.
 *
 * 🔴 THE BUG THIS SHAPE EXISTS TO KILL (verified 2026-09-03).
 *
 * The old code ran the ledger INSIDE a `setStats` updater and read the captured
 * values on the very next line:
 *
 *     let capturedUpdatedStats = null;
 *     setStats(prev => { capturedUpdatedStats = …; return …; });
 *     celebration.begin({ updated: capturedUpdatedStats, … });   // ← still null
 *
 * React 18 only runs a `setState` updater eagerly when NOTHING else is pending on
 * that fiber. `handleSubmit` always sets something first — `setShowCompactGame`
 * on the practice path, `setFinalSolveTime` on the daily one — so the fiber has
 * lanes, the updater is deferred to render, and every captured value is still
 * `null`/`false` when the celebration reads it. Measured directly: with one prior
 * `setState` the capture is `null`; with none it is the new value.
 *
 * Consequence: `celebration.begin` was handed `prev: null, updated: null,
 * isPerfect: false`, so `detectNewAwards` diffed two empty objects. NO streak, NO
 * perfect-streak, NO time milestone and NO puzzle tier could ever be announced
 * from a solve. The award queue on Home was empty for every family, not just the
 * badges — which is why the whole surface looked inert.
 *
 * The fix is to stop depending on React's scheduling at all: the caller passes
 * the current stats explicitly (a ref, so it is never a stale closure) and this
 * writes the new blob back. Deterministic, and one fewer moving part.
 *
 * @param {{ setStats: Function, prev?: any } & Record<string, any>} args
 * @returns {{prev: any, updated: any, isPerfect: boolean}}
 */
export function recordSolveLedger({
  setStats, prev, mode, solveTimeSeconds, equation, usedDiceIndices, usedDiceIds,
  diceColors, dice, today, yesterday,
}) {
  const before = prev || {};
  const result = awardDailyChallengeSolve({
    prev: before, mode, solveTimeSeconds, equation, usedDiceIndices, usedDiceIds,
    diceColors, dice, today, yesterday,
  });
  setStats(result.updatedStats);
  return { prev: before, updated: result.updatedStats, isPerfect: result.isPerfect };
}

// ---------------------------------------------------------------------------
// The authoritative point totals
// ---------------------------------------------------------------------------

/**
 * Record a `getPlayerStats` envelope's point totals into a ref.
 *
 * A REF and not React state: nothing renders these numbers any more (the home
 * stat ribbon that did was removed in the 2026-07-08 home-condense restructure),
 * and the celebration needs the value at CALL time. Reading `puzzlePoints` out of
 * state inside `handleSubmit` gave whatever the callback's closure captured — 0
 * whenever the mount fetch had not landed yet — which is how a tier crossing was
 * silently lost.
 *
 * `null` is meaningful: it means we have NEVER had an authoritative total, which
 * is different from "the total is 0". A crossing is only ever claimed from a
 * known before-value; guessing one risks a false medal, and this project's
 * standing preference is that a missed moment beats a wrong one.
 *
 * @param {{current: {puzzle: number, battle: number}|null}} ref
 * @param {any} result a getPlayerStats envelope
 * @returns {boolean} whether anything was recorded
 */
export function rememberPlayerPoints(ref, result) {
  if (!ref || !result || result.success !== true || !result.data) return false;
  ref.current = {
    puzzle: result.data.puzzle_points ?? 0,
    battle: result.data.battle_points ?? 0,
  };
  return true;
}

/**
 * Record just a puzzle-point total (the shape `applyDerivedPlayerStats` hands its
 * `setPuzzlePoints` callback). Keeps any battle total already known.
 * @param {{current: {puzzle: number, battle: number}|null}} ref
 * @param {number} puzzle
 */
export function rememberPuzzlePoints(ref, puzzle) {
  if (!ref) return;
  ref.current = { puzzle: Number(puzzle) || 0, battle: ref.current?.battle ?? 0 };
}

/**
 * The point totals to hand `celebration.begin`, BEFORE the server has spoken.
 *
 * Claims NOTHING when no authoritative total is known — the settle pass corrects
 * that a moment later.
 *
 * ⚠️ THE INCREMENT IS THE RULE, ASKED, not a guess. This used to be
 * `+ (isPerfect ? 1 : 0)`, which was right while a perfect Challenge Daily was
 * the only way to earn. Under David's 2026-09-04 ruling an Expert Daily under 37
 * seconds pays TWO, so a hard-coded 1 would under-count the provisional total by
 * one on exactly the solve that feels most like an achievement — and a medal
 * crossing that landed on the second Piece would not fire until the settle pass
 * caught up. `piecesForSolve` is the same rule the server ledger enforces.
 *
 * @param {{current: {puzzle: number, battle: number}|null}} ref
 * @param {boolean} isPerfect
 * @param {{mode?: string, solveTimeSeconds?: number|null}} [solve] the solve just
 *   played. Omitted (or an unknown mode) earns 0 — no invented Pieces.
 * @returns {{prevPuzzle?: number, puzzle?: number, prevBattle?: number, battle?: number}}
 */
export function provisionalPoints(ref, isPerfect, solve = {}) {
  const known = ref?.current;
  if (!known) return {};
  // ⚠️ An accepted Expert Daily IS a Perfect Solve by rule (all three Power
  // Dice are required to win), so it is perfect here whatever the caller says.
  // The caller passes the stats ledger's `isPerfect`, which
  // awardDailyChallengeSolve computes for the CHALLENGE Daily only (it drives the
  // Challenge perfect-streak) — so for Expert it was always false, the estimate
  // was always 0 Pieces, and a player's first Piece earned on Expert depended on
  // the settle pass, which is dropped once the rocket has landed with another
  // card queued. The one-time "Your first Puzzle Piece!" card was lost.
  // Bug log 2026-10-20.
  const perfect = isPerfect === true || requiresPerfectSolve(solve.mode);
  const earned = piecesForSolve({
    mode: solve.mode, isPerfect: perfect, solveTimeSeconds: solve.solveTimeSeconds,
  });
  return {
    prevPuzzle: known.puzzle,
    puzzle: known.puzzle + earned,
    // A solve never moves battle points, so before === after. Passing them at all
    // is what stops `detectNewAwards` reading `undefined → undefined` as a fresh
    // 0, which is the only reason the battle tier could not fire from Home.
    prevBattle: known.battle,
    battle: known.battle,
  };
}

// ---------------------------------------------------------------------------
// The settle pass — authoritative points + the badge families
// ---------------------------------------------------------------------------

/**
 * Read everything the celebration needs that only the server knows.
 *
 * ONE `get-player-stats` read serves two purposes: the authoritative point totals
 * and the `playerStats` input `getExistingBadgeState` would otherwise fetch for
 * itself. Its `game_stats` likewise saves `getBlitzBadgeState` a read.
 *
 * Every source degrades independently. A dead battle read must not cost the
 * player their craft badge, and no read here may throw — this runs on a screen
 * the player has already won.
 *
 * @param {string} userId
 * @returns {Promise<{points: {puzzle:number, battle:number}|null, stateById: Record<string, any>|null}>}
 */
export async function readSolveOutcomeSources(userId) {
  if (!userId) return { points: null, stateById: null };

  const envelope = await getPlayerStats(userId).catch(reportedFallback('solve.stats'));
  const playerStats = envelope && envelope.success === true ? envelope.data : null;
  // `null` means UNKNOWN, and callers treat it as such — the Home catch-up
  // refuses to seal its record on an unknown, because sealing a medal it never
  // managed to count marks it announced forever.
  //
  // 🔴 `not_found` IS AN ANSWER, NOT A FAILURE, and collapsing the two broke the
  // catch-up for every guest. `get-player-stats` returns
  // `{success:false, error:{code:'not_found'}}` for an id it has no row for —
  // which is every anonymous guest, verified in a browser against prod
  // 2026-09-05. Read as "unknown", that made the catch-up refuse to seal on
  // every pass, so a guest re-ran four failing network reads a minute on the
  // launcher and never got a catch-up at all. The server is telling us the
  // player has no points, which is zero.
  const points = playerStats
    ? { puzzle: playerStats.puzzle_points ?? 0, battle: playerStats.battle_points ?? 0 }
    : (envelope?.error?.code === 'not_found' ? { puzzle: 0, battle: 0 } : null);

  const [craft, blitz, existing] = await Promise.all([
    getCraftBadgeState(userId).catch(reportedFallback('solve.badges.craft')),
    getBlitzBadgeState(userId, { gameStats: playerStats?.game_stats }).catch(reportedFallback('solve.badges.blitz')),
    getExistingBadgeState(userId, { playerStats }).catch(reportedFallback('solve.badges.existing')),
  ]);

  let stateById = null;
  try {
    // Read through the PUBLIC surface. Which badges exist, and their per-mode
    // sectioning, is owned elsewhere and is actively changing — nothing here may
    // name a badge id, a badge name or a badge count.
    stateById = buildBadgeStateIndex(craft, blitz, existing);
  } catch { stateById = null; }

  return { points, stateById };
}

/**
 * Decide which registry badges this surface may announce right now.
 *
 * Diffed against the persisted announced-record rather than against a pre-solve
 * derivation, which makes it IDEMPOTENT: every surface shares one record, so a
 * badge pops exactly once whichever surface reaches it first, and a badge earned
 * while the app was closed still gets its moment.
 *
 * ⚠️ IT RETURNS AWARDS AND NOTHING ELSE. It used to hand back a `commit`
 * closure that persisted just the badges. That is now wrong in two directions:
 * it recorded one family out of six, and it made the caller responsible for
 * remembering to fire it. The rule is now uniform — WHOEVER DRAINS A QUEUE
 * RECORDS THAT QUEUE, with `recordAnnouncedAwards`. See ./announcedAwards.
 *
 * ⚠️ It still never shows the RETROACTIVE set. On the very first run every
 * earned badge is history-derived and belongs in the single "you've unlocked N
 * badges" summary the stats page owns; firing them here would be the pop-up
 * storm `planBadgeAnnouncement` exists to prevent. `isFirstRun` is what carries
 * that distinction across the unification: an empty record and a MISSING record
 * are different things, and only the missing one is a first run.
 *
 * @param {Record<string, any>|null} stateById
 * @param {string|null|undefined} userId whose announced-record to diff against
 *   (per account since 2026-10-18 — see ./announcedAwards)
 * @returns {Array} the badge awards to queue, in registry order
 */
export function planSolveBadgeAwards(stateById, userId) {
  if (!stateById) return [];
  // QUIET CATCH-UP (2026-10-18): a badge first run is now sealed silently by
  // whichever surface gets here first — see ./badgeFirstRunSeal. Nothing pops
  // on the sealing pass; every later pass diffs against an ordinary record.
  if (sealBadgeFirstRun(stateById, userId)) return [];

  const { record, isFirstRun } = readAnnouncedAwards(userId);
  // `badgesAreFirstRun`, not `isFirstRun`: the Home catch-up seals the stat
  // families' first run, and using the record's bare existence here would flip
  // the badge family out of its retroactive branch as a side effect of that.
  const plan = planBadgeAnnouncement({
    stateById,
    announced: badgesAreFirstRun(record, isFirstRun) ? null : badgeSnapshotFromRecord(record),
  });
  return plan.live;
}

/**
 * Fetch the authoritative numbers and hand them to the celebration.
 *
 * `knownPointsRef` holds the last authoritative totals we saw — the BEFORE side
 * of a tier crossing. It is refreshed here so a second solve in the same session
 * measures from the right place.
 *
 * @param {{
 *   userId: string,
 *   celebration: {settle: Function},
 *   knownPointsRef: {current: {puzzle:number, battle:number}|null},
 * }} args
 * @returns {Promise<Array|null>} the settled award queue, or null if nothing settled
 */
export async function settleSolveCelebration({ userId, celebration, knownPointsRef }) {
  const before = knownPointsRef?.current ?? null;
  const { points, stateById } = await readSolveOutcomeSources(userId);
  if (points && knownPointsRef) knownPointsRef.current = points;

  // A crossing needs BOTH sides. Without a known before-value we hand back no
  // point totals at all, and `settle` keeps whatever `begin` provisionally
  // queued rather than inventing a medal or dropping a real one.
  const settledPoints = before && points
    ? { prevPuzzle: before.puzzle, puzzle: points.puzzle, prevBattle: before.battle, battle: points.battle }
    : null;

  return celebration.settle({
    points: settledPoints,
    badgeAwards: planSolveBadgeAwards(stateById, userId),
    userId,
  });
}

// ---------------------------------------------------------------------------
// The persist chain
// ---------------------------------------------------------------------------

/**
 * Save the solve, re-read the player, then settle the celebration.
 *
 * THE TWO FAILURE BRANCHES MEAN DIFFERENT THINGS and are reported differently —
 * that distinction predates this extraction and is preserved exactly:
 *   • `updateMe` rejected → this solve is UNRECORDED. Worth saying.
 *   • `me` rejected → the save landed; only the read-back failed, so the player's
 *     result is not at stake. Sentry only, no toast.
 * Both still call `markResultsReady()`, because a player must never be stranded
 * staring at a rocket because a background write failed.
 *
 * @param {{
 *   user: any, ledger: {updated:any, isPerfect:boolean}, mode: string,
 *   celebration: {markResultsReady: Function, settle: Function},
 *   setUser: Function, setStats: Function, setPuzzlePoints: Function,
 *   knownPointsRef: {current: {puzzle:number, battle:number}|null},
 * }} args
 * @returns {Promise<boolean>} whether the save + read-back both succeeded
 */
export function persistSolveOutcome({
  user, ledger, mode, celebration, setUser, setStats, setPuzzlePoints, knownPointsRef,
}) {
  const statsToSave = ledger?.updated;
  if (!user || !statsToSave) return Promise.resolve(false);

  return apiClient.auth.updateMe({ game_stats: statsToSave }).then(
    () => apiClient.auth.me().then(async (reloadedUser) => {
      setUser(reloadedUser);
      applyReloadedStats({ reloadedUser, fallbackStats: statsToSave, setStats, setPuzzlePoints });
      // Post-solve stats are live now → let the daily rocket hand off (it
      // otherwise flies to its 4s cap). Harmless for non-daily solves.
      celebration.markResultsReady();
      syncPublicProfile(reloadedUser).catch((err) =>
        console.error('Failed to sync profile after solve:', err));

      await settleSolveCelebration({
        userId: reloadedUser?.id || user.id, celebration, knownPointsRef,
      }).catch(reportedFallback('solve.celebration'));
      return true;
    }).catch((err) => {
      reportSolveFailure('stats-refetch', err, { mode });
      celebration.markResultsReady();
      return false;
    }),
    (err) => {
      reportSolveFailure(SOLVE_STAGE.statsSave, err, { mode });
      celebration.markResultsReady();
      return false;
    },
  );
}
