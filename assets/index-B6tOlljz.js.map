import { App } from '@capacitor/app';
import { Capacitor } from '@capacitor/core';
import { createContext, useState, useContext, useEffect } from 'react';
import { supabase, resolveUsernameLogin, withTimeout, resolveSession, readStoredSession } from '@/transport';
import { track, recordOutcome } from '@/observability';

const AuthContext = createContext(null);

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [isLoadingAuth, setIsLoadingAuth] = useState(true);
  const [authError, setAuthError] = useState(null);

  useEffect(() => {
    // Check active sessions and sets the user
    const getSession = async () => {
      console.log('AuthContext: starting getSession');
      setIsLoadingAuth(true);
      try {
        console.log('AuthContext: calling supabase.auth.getSession()');
        const { session, user: storedUser, offline, error } = await resolveSession();
        console.log('AuthContext: session retrieved', { session, offline, error });

        if (offline) {
          // The token expired and could not be refreshed because the network
          // is down — but the member is still stored. Show them as the member;
          // supabase-js retries the refresh and onAuthStateChange picks up the
          // fresh session when the connection returns. Never a guest here: on
          // a flaky network that guest would overwrite the member for good.
          console.warn('AuthContext: offline with a stored session; keeping the member');
          setUser(storedUser);
          setIsAuthenticated(true);
          return;
        }

        if (error) {
          console.error('Error checking session:', error);
          setAuthError(error.message);
        }

        // If no session exists, auto sign in anonymously
        if (!session) {
          console.log('AuthContext: no session, attempting anonymous sign in');
          try {
            // Bounded: this is a network call, and `isLoadingAuth` is only
            // cleared in this function's `finally`. A request that never
            // settles (captive portal, VPN, filtering proxy — none of which
            // reject, they just hold the connection open) would otherwise hold
            // the app on <FullScreenLoader /> forever. On timeout we fall
            // through as an unauthenticated visitor, which still renders a
            // usable welcome screen with a Log In button.
            const { data, error: anonError } = await withTimeout(
              supabase.auth.signInAnonymously(),
              { data: { user: null, session: null }, error: null },
            );
            console.log('AuthContext: anonymous sign in result', { data, anonError });
            if (anonError) {
              console.error('Anonymous sign in error:', anonError);
              // Fall back to setting no user if anonymous auth fails
              setUser(null);
              setIsAuthenticated(false);
            } else {
              // Derive authentication from whether a user actually came back,
              // rather than assuming "no error" means "signed in". The old
              // hardcoded `true` claimed an authenticated session while holding
              // a null user, which is a state nothing downstream expects — and
              // it is now reachable, because a timed-out sign-in resolves with
              // no error and no user.
              setUser(data?.user ?? null);
              setIsAuthenticated(!!data?.user);
            }
          } catch (e) {
            console.error('Failed to sign in anonymously:', e);
            setUser(null);
            setIsAuthenticated(false);
          }
        } else {
          setUser(session?.user ?? null);
          setIsAuthenticated(!!session?.user);
        }
      } catch (err) {
        console.error('Unexpected error in getSession:', err);
      } finally {
        console.log('AuthContext: finished getSession, setting isLoadingAuth false');
        setIsLoadingAuth(false);
      }
    };

    getSession();

    // Listen for changes on auth state (logged in, signed out, etc.)
    const { data: { subscription } } = supabase.auth.onAuthStateChange(async (event, session) => {
      // supabase-js emits INITIAL_SESSION with a null session when the refresh
      // failed for lack of network, while the member is still stored. Only a
      // SIGNED_OUT (or an empty store) means nobody is signed in. Storage is read
      // directly: calling getSession inside this callback would deadlock on the
      // auth lock.
      let current = session;
      if (!current && event !== 'SIGNED_OUT') {
        current = await readStoredSession();
      }
      setUser(current?.user ?? null);
      setIsAuthenticated(!!current?.user);
      setIsLoadingAuth(false);
    });

    // Listen for deep links (magic-link / password-recovery redirects)
    let appListener;
    if (Capacitor.isNativePlatform()) {
      appListener = App.addListener('appUrlOpen', async (data) => {
        try {
          const url = new URL(data.url);
          const params = new URLSearchParams(url.hash.substring(1));
          const searchParams = new URLSearchParams(url.search);
          const access_token = params.get('access_token');
          const refresh_token = params.get('refresh_token');
          const token_hash = searchParams.get('token_hash') || params.get('token_hash');
          const type = searchParams.get('type') || params.get('type');

          // Handle magic-link session tokens
          if (access_token && refresh_token) {
            const { error } = await supabase.auth.setSession({ access_token, refresh_token });
            if (error) throw error;
          }

          // Handle password reset recovery token
          if (token_hash && type === 'recovery') {
            const { error } = await supabase.auth.verifyOtp({ token_hash, type: 'recovery' });
            if (error) throw error;
          }

          // ⚠️ EMAIL CONFIRMATION COMES BACK THROUGH THIS SAME DOOR, which is
          // why adding it is three lines rather than a feature. Supabase sends
          // the link with a token_hash and a type; 'signup' is a first
          // confirmation and 'email_change' is confirming a new address on an
          // existing account. Both verify identically — only the type string
          // differs — and the deep-link plumbing above is already proven on
          // device by the password-reset flow.
          if (token_hash && (type === 'signup' || type === 'email_change' || type === 'email')) {
            const { error } = await supabase.auth.verifyOtp({
              token_hash,
              type: /** @type {any} */ (type),
            });
            if (error) throw error;
          }
        } catch (e) {
          console.error('Deep link auth error:', e);
        }
      });
    }

    return () => {
      subscription?.unsubscribe();
      if (appListener) {
        appListener.then(listener => listener.remove());
      }
    };
  }, []);

  const login = async (username, password) => {
    // Username + password ONLY. Email is never an authentication identity (it is
    // collected separately, optionally, for newsletters). The edge function maps
    // username → account, claims a credential-less account with the password (or
    // verifies an existing one), authenticates server-side, and returns a
    // session — the internal synthetic email never reaches the client. The first
    // password a legacy/credential-less account types becomes its password.
    const result = await resolveUsernameLogin(username, password);
    // The reason CODE only (e.g. 'invalid_credentials'), never the username.
    track('auth.login', { outcome: result.success ? 'ok' : 'failed', reason: result.success ? null : result.error?.code ?? null });
    recordOutcome('sign_in', result.success ? 'ok' : 'failed', { reason: result.success ? null : result.error?.code ?? null });
    if (!result.success) {
      const { code, message } = result.error;
      if (code === 'not_found') throw new Error('User not found or invalid username');
      if (code === 'invalid_credentials') throw new Error('Incorrect username or password');
      throw new Error(message || 'Could not sign in');
    }

    const { session } = result.data;
    const { data, error } = await supabase.auth.setSession({
      access_token: session.access_token,
      refresh_token: session.refresh_token,
    });
    if (error) throw error;
    return data;
  };

  const loginWithOtp = async (email) => {
    const { data, error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        emailRedirectTo: Capacitor.isNativePlatform() ? 'com.thirtyseven.app://login-callback' : window.location.origin
      }
    });
    if (error) throw error;
    return data;
  };

  const signInAnonymously = async () => {
    // Guard against clobbering an existing session (V2 "had to sign in twice").
    // App's auth effect fires this whenever it sees `!isAuthenticated` on `/`,
    // but a username login persists its real session (via setSession) BEFORE
    // its onAuthStateChange flips isAuthenticated — so the effect can call this
    // off a STALE isAuthenticated=false and replace the just-authenticated
    // account with a fresh guest, bouncing the user to the Welcome screen. Check
    // the live session (the source of truth) first; only create a guest when
    // there genuinely is none.
    // `offline` covers a stored member whose token could not be refreshed for
    // lack of network: they are not "nobody", so no guest either.
    const { session: existing, user: storedUser, offline } = await resolveSession();
    if (existing) return { user: existing.user, session: existing };
    if (offline) return { user: storedUser, session: null };
    const { data, error } = await supabase.auth.signInAnonymously();
    track('auth.guest', { outcome: error ? 'failed' : 'ok' });
    if (error) throw error;
    return data;
  };

  // Password reset is EMAIL-based and only works if the user attached a recovery
  // email to their account at creation. The user enters that email directly
  // (login is username-only; we don't map username → email here). Accounts with
  // no email have no self-service reset — they contact HiiPointe Games.
  const resetPassword = async (email) => {
    const { data, error } = await supabase.auth.resetPasswordForEmail(email.trim(), {
      redirectTo: Capacitor.isNativePlatform()
        ? 'thirtysevenapp://reset-callback'
        : window.location.origin + '/ResetPassword'
    });
    if (error) throw error;
    return data;
  };

  const logout = async () => {
    track('auth.logout');
    const { error } = await supabase.auth.signOut();
    if (error) console.error('Error signing out:', error);
    setUser(null);
    setIsAuthenticated(false);
  };

  return (
    <AuthContext.Provider value={{
      user,
      isAuthenticated,
      isLoadingAuth,
      authError,
      login,
      loginWithOtp,
      signInAnonymously,
      logout,
      resetPassword,
      supabase
    }}>
      {children}
    </AuthContext.Provider>
  );
};

/**
 * The signed-in auth user from context, or null — WITHOUT throwing outside an
 * AuthProvider and WITHOUT a network call. For components that only need to know
 * who is viewing (e.g. the Daily pre-game modal's Sector 73 clue) and must not add
 * an auth.me() round-trip on mount.
 * @returns {Record<string, any> | null}
 */
export const useOptionalAuthUser = () => useContext(AuthContext)?.user ?? null;

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};
