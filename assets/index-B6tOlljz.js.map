import { apiClient } from '@/transport';

// Anti-cheat gate for revealing another player's TODAY daily-challenge entry.
//
// Rule: a viewer may see another player's solution for *today's <mode>* only if
// the viewer has themselves finished today's <mode> — either completed it (a
// DailyChallengeTime row) or forfeited it (a DailyChallengeAttempt with
// forfeited=true). Past days are always visible; callers gate only "today".
//
// This was inlined near-identically in Statistics.jsx and OtherProfile.jsx
// and published through a `window.viewerCanSeeToday` global — including a
// "for debugging" `window.viewerCanSeeToday = true` line in Statistics that
// unconditionally defeated the gate. Centralizing it here kills the global
// and the override. See docs/bugs.md.
//
// ─────────────────────────────────────────────────────────────────────────────
// PER MODE, and why the metadata fast path had to go with it (P1, 2026-08-24)
// ─────────────────────────────────────────────────────────────────────────────
// Three Dailies a day means three gates a day. Finishing Easy earns the right to
// see other players' EASY answers — and nothing else. Un-scoped, a player could
// forfeit Easy in one tap at 00:01 and read the whole field's Challenge and
// Expert solutions before attempting either.
//
// There used to be a fast path here: short-circuit to `true` if the viewer's own
// `game_stats.dailyChallengeTimes` blob already recorded a completion for today.
// It is DELETED, not made mode-aware. That blob is the legacy client-maintained
// array; it carries no mode and never will, so under three modes it answers
// `true` for ANY mode the moment Challenge is solved — the fast path defeats the
// gate it is a fast path for. It saved exactly one query.
//
// That is the same shape as the `window.viewerCanSeeToday = true` line above,
// one layer down: a convenience that silently becomes an unconditional unlock.
// The gate is now always answered by the database, which is the only source that
// knows about modes.

/**
 * @param {{ id: string } | null} viewer - the current (viewing) user.
 * @param {string} today - today's date in the app timezone (YYYY-MM-DD, from todayET()).
 * @param {string} [modeKey='daily'] - which Daily is being gated. Defaults to
 *   'daily' (Challenge's Daily), so every existing caller keeps its exact
 *   current behaviour until it passes a mode.
 * @returns {Promise<boolean>} whether the viewer has earned the right to see today's <modeKey>.
 */
export async function canViewerSeeToday(viewer, today, modeKey = 'daily') {
  if (!viewer?.id) return false;

  // Completed this mode today?
  const times = await apiClient.entities.DailyChallengeTime.filter({
    date: today,
    user_id: viewer.id,
    mode: modeKey,
  });
  if (times && times.length > 0) return true;

  // Not completed — a forfeit of THIS mode also unlocks viewing.
  const attempts = await apiClient.entities.DailyChallengeAttempt.filter({
    date: today,
    user_id: viewer.id,
    mode: modeKey,
  });
  // ANY forfeited row, not the first one: nothing makes (user, date, mode)
  // unique in daily_challenge_attempts (3 duplicate groups on prod, 2026-10-04)
  // and the rows come back unordered. Reading only attempts[0] could disagree
  // with the server gate (daily-board hasForfeit, which asks for any
  // forfeited=true row), painting a lock note under a board the server had
  // already unlocked. Same rule both sides.
  return (attempts ?? []).some((a) => a?.forfeited === true);
}
