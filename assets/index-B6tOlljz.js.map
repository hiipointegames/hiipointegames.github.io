// EXISTING-SYSTEM badge derivation — the nine folded-in legacy badges.
//
// Badges Phase 2, Slice 1. The third derivation lane alongside Lane B (craft,
// craftBadgeDerivation.js) and Lane D (Blitz, blitzBadgeDerivation.js), with the
// SAME output contract: `{ [badgeId]: state }` where `tier === -1` means
// unearned. The showcase merges all three through `buildBadgeStateIndex`.
//
// WHY THIS EXISTS. The registry folded the pre-redesign badge families in with
// their thresholds unchanged (badgeRegistry.js EXISTING_BADGES) — daily streak,
// perfect-solve streak, speed record, the three podium counts, the two points
// medals, and the Colosseum win ladder. But no lane DERIVED them, so all nine
// rendered permanently dark: a player with a 365-day streak and 24 gold podiums
// still saw an unlit card. This supplies that derivation.
//
// RE-DERIVED FROM GROUND TRUTH, NEVER FROM AN EXACT-MATCH MAP. The legacy
// achievement grids asked "is milestone 14 recorded in the stored map?" — a
// question the 2026-07-02 ladder retune ([7,25,50,100,200,365] →
// [3,7,14,37,100,365], shipped with no migration) permanently answers "no" for a
// player who was already past the rung on the day it changed. MilestoneSection
// self-healed the STREAK grid off longest-streak-ever but left the PERFECT grid
// reading the stored map — the "twin bug". Everything here derives `>=` from a
// best-ever number instead, so a player who ever passed a rung lights it,
// retroactively, whatever the ladder was on the day.
//
// PLAYER-PARAMETERIZED, like Lanes B and D. The showcase renders on your own
// Statistics page and on another player's, so the pure core takes a stats blob
// and nothing here reads the signed-in user except as the fetcher's default.
//
// NEVER THROWS on a malformed or absent `game_stats`: every reader below
// normalizes junk to zero, so one bad historical blob renders the nine badges
// unearned rather than blanking the whole showcase.
//
// `earliestDate` is null for eight of the nine BY CONSTRUCTION, not by omission:
// these are lifetime aggregates with no event date behind them. Only the
// Colosseum win ladder has rows to date, and it reports its first win.

import { apiClient } from '@/transport';
import { getBadge, badgeTierIndex, nextTierTarget, badgeTiers } from '@/game-mechanics';
import { summarizePlayerBattleBadges, getPlayerBattles } from '@/head-to-head';
import { getPlayerStats } from './playerStats';
import { normalizePodiumFinishes } from './craftBadgeDerivation';
import { reportedFallback } from '@/observability';

/**
 * @typedef {Object} ExistingBadgeState
 * @property {string} featId      Canonical detection key — same as `badgeId` for
 *                                all nine (none is mode-split).
 * @property {string} badgeId     Registry ENTRY id, the key a card renders against.
 * @property {string} mode        Registry mode (`daily` / `blitzBattle`).
 * @property {boolean} earned
 * @property {number} count       Times achieved. Real occurrence counts for the
 *                                count ladders (podiums) and the win ladder; 1 for
 *                                an earned "personal best" badge, so `×N` renders
 *                                uniformly without the UI branching on scaling type.
 * @property {number} tier        Highest 0-based tier reached; -1 = unearned.
 * @property {string|null} earliestDate  YYYY-MM-DD first earned, or null when the
 *                                source is an aggregate with no date behind it.
 * @property {number|null} value  The ladder value behind `tier` for a threshold
 *                                badge (streak length, seconds, points, wins);
 *                                null for count ladders.
 * @property {number} progressValue The number judged against the ladder — `count`
 *                                for a count ladder, `value` otherwise. Pairs with
 *                                `nextTarget` for the "so close" row.
 * @property {number|null} nextTarget The next rung to chase, or null when maxed out.
 */

/** Every registry id this module derives, in registry order. */
export const EXISTING_BADGE_IDS = Object.freeze([
  'dailyStreak',
  'perfectStreak',
  'speedRecord',
  'podiumFirst',
  'podiumSecond',
  'podiumThird',
  'puzzlePieceBadge',
  'battlePointsBadge',
  'blitzWinLadder',
  // ── PER-TIER PRESTIGE ─────────────────────────────────────────────────────
  // ⚠️ The Easy four were added to the REGISTRY on 2026-09-04 and derived
  // NOWHERE, so they rendered permanently dark — a badge a player cannot ever
  // light is precisely the complaint the badge rework exists to answer. They are
  // derived below now, alongside Expert's (David, 2026-09-05: "all three tiers
  // get streak + podium").
  'dailyStreakEasy',
  'speedRecordEasy',
  'podiumFirstEasy',
  'podiumSecondEasy',
  'podiumThirdEasy',
  'dailyStreakExpert',
  'speedRecordExpert',
  'podiumFirstExpert',
  'podiumSecondExpert',
  'podiumThirdExpert',
]);

/**
 * Registry badge-mode → the `perMode` wire key that holds that tier's numbers.
 * Named once so a fourth tier is a line here, not a hunt through the file.
 */
const TIER_WIRE_KEY = Object.freeze({ dailyEasy: 'daily_easy', dailyExpert: 'daily_expert' });

/** One tier's server-derived block from `game_stats.perMode`, or an empty one. */
function tierBlock(stats, wireKey) {
  const block = stats?.perMode?.[wireKey];
  return block && typeof block === 'object' ? block : {};
}

/** `podiumFinishes` off a perMode block, junk-tolerant. */
function tierPodiums(block) {
  const p = block?.podiumFinishes;
  return {
    first: positiveNumber(p?.first),
    second: positiveNumber(p?.second),
    third: positiveNumber(p?.third),
  };
}

// ---------------------------------------------------------------------------
// Blob hygiene — every read below normalizes junk to 0 rather than trusting it
// ---------------------------------------------------------------------------

/** A finite non-negative number, or 0. Strings, nulls, NaN and negatives → 0. */
function positiveNumber(value) {
  const n = Number(value);
  return Number.isFinite(n) && n > 0 ? n : 0;
}

/** The blob, or an empty object — so every `?.` below is safe on junk input. */
function statsBlob(gameStats) {
  return gameStats && typeof gameStats === 'object' ? /** @type {Record<string, any>} */ (gameStats) : {};
}

/**
 * A `{ [threshold]: count }` milestone map, read off either key spelling.
 * @param {Record<string, any>} stats
 * @param {string} camel
 * @param {string} snake
 * @returns {Record<string, any>}
 */
function milestoneMap(stats, camel, snake) {
  const map = stats[camel] ?? stats[snake];
  return map && typeof map === 'object' ? map : {};
}

/**
 * The largest threshold key in a milestone map that carries a positive count.
 * The legacy 7.1 sentinel for the second 7-day perfect tier parses as 7.1, which
 * clears the 7 rung and nothing higher — exactly its intended meaning.
 *
 * @param {Record<string, any>} map
 * @returns {number}
 */
function maxRecordedThreshold(map) {
  let best = 0;
  for (const [key, count] of Object.entries(map)) {
    const threshold = Number.parseFloat(key);
    if (!Number.isFinite(threshold)) continue;
    if (positiveNumber(count) > 0 && threshold > best) best = threshold;
  }
  return best;
}

// ---------------------------------------------------------------------------
// The join: one best-ever number + the registry ladder → one badge's state
// ---------------------------------------------------------------------------

/**
 * Build one badge's state against its registry entry. Mirrors the `badgeState`
 * helpers in the craft and Blitz lanes so all three emit an identical shape.
 *
 * @param {string} badgeId
 * @param {{count?:number, value?:number|null, earliestDate?:string|null}} facts
 * @returns {ExistingBadgeState}
 */
function badgeState(badgeId, { count = 0, value = null, earliestDate = null } = {}) {
  const badge = getBadge(badgeId);
  const isCountLadder = badge?.scaling?.type === 'countLadder';
  const ladderInput = isCountLadder ? count : value;
  const judged = ladderInput === null || ladderInput === undefined ? NaN : ladderInput;
  const tier = badgeTierIndex(badge, judged);
  const hasValue = Number.isFinite(judged);

  return {
    featId: badge?.featId ?? badgeId,
    badgeId: badge?.id ?? badgeId,
    mode: badge?.mode ?? 'daily',
    earned: tier >= 0,
    // A personal-best badge has no per-occurrence notion, so an earned one still
    // reports 1 — the same convention the Blitz lane uses.
    count: !isCountLadder && tier >= 0 ? Math.max(count, 1) : count,
    tier,
    earliestDate,
    value: isCountLadder ? null : (value ?? null),
    progressValue: hasValue ? /** @type {number} */ (judged) : 0,
    nextTarget: hasValue ? nextTierTarget(badge, /** @type {number} */ (judged)) : firstTier(badge),
  };
}

/** The opening rung of a ladder — what an unearned badge is chasing. */
function firstTier(badge) {
  const tiers = badgeTiers(badge);
  return tiers.length > 0 ? tiers[0] : null;
}

// ---------------------------------------------------------------------------
// The nine best-ever numbers
// ---------------------------------------------------------------------------

/**
 * Longest daily streak EVER. `longestDailyChallengeStreak` is the truth field —
 * get-player-stats recomputes it from `daily_challenge_times` on every read, so
 * it cannot drift. The current streak and any recorded `reachedMilestones` are
 * folded in as a floor: a badge that is lit today must never go dark because a
 * blob predates the recompute.
 *
 * @param {Record<string, any>} stats
 * @returns {number}
 */
export function longestDailyStreak(stats) {
  const reached = stats.reachedMilestones ?? stats.reached_milestones;
  const recorded = Array.isArray(reached)
    ? reached.reduce((best, m) => Math.max(best, positiveNumber(m)), 0)
    : 0;
  return Math.max(
    positiveNumber(stats.longestDailyChallengeStreak),
    positiveNumber(stats.longest_daily_challenge_streak),
    positiveNumber(stats.longest_daily_streak),
    positiveNumber(stats.dailyChallengeStreak),
    positiveNumber(stats.daily_challenge_streak),
    recorded,
  );
}

/**
 * Longest PERFECT streak ever — the twin-bug fix.
 *
 * There is no stored "longest perfect streak" field. get-player-stats computes
 * the same quantity internally as `maxPerfectStreak` (currentPerfectStreak, plus
 * the largest recorded milestone key) purely to self-heal the milestone map, and
 * never returns it — so this recomputes it from the two fields it does return.
 *
 * The map is read for its KEYS as a floor, never for exact membership: a player
 * whose stored map is empty because they sailed past a rung before the ladder
 * retune still lights every tier their real streak cleared.
 *
 * @param {Record<string, any>} stats
 * @returns {number}
 */
export function longestPerfectStreak(stats) {
  const map = milestoneMap(stats, 'perfectStreakMilestones', 'perfect_streak_milestones');
  return Math.max(
    positiveNumber(stats.currentPerfectStreak),
    positiveNumber(stats.current_perfect_streak),
    maxRecordedThreshold(map),
  );
}

/**
 * The fastest speed rung a player has ever cleared, as a THRESHOLD in seconds
 * (the descending ladder's own unit), or null for "never recorded".
 *
 * FOUR sources, all treated as evidence that a rung was cleared, so the answer
 * is the smallest threshold ANY of them supports and can never dim a badge that
 * is lit today:
 *   - `timeMilestones[t] > 0`        — a solve came in under `t` (cumulative).
 *   - `fastestTimeMilestones[t] > 0` — that solve's own fastest bucket.
 *   - a recorded solve time strictly under `t` in `dailyChallengeTimes`.
 *   - `dailyRows` — the ACTUAL `daily_challenge_times` rows (added 2026-09-04).
 *
 * WHY THE FOURTH SOURCE EXISTS. The first three all read the client-maintained
 * `game_stats` blob, and this badge is the one place that mattered: on staging a
 * player with a 21.999-second solve in `daily_challenge_times` saw Speed Record
 * LOCKED at "Next: Ignition" (under 10:00) — seven rungs below where the solve
 * actually sat — because the blob's `timeMilestones` was `{}` and its
 * `dailyChallengeTimes` was `[]`. Meanwhile Constellation lit off the same row,
 * because craft badges derive from rows. Two lanes, two sources, one solve, two
 * answers — and "why did this one light and not that one?" is exactly what
 * David could not tell from the screen.
 *
 * The blob stays as a FLOOR rather than being replaced: it is the only source
 * for a player whose history predates the rows, and adding a source can only
 * ever light a rung, never dim one.
 *
 * Rows are filtered to Challenge's Daily (`mode === 'daily'`, absent === legacy
 * Challenge Daily), because that is the mode this badge is declared in. Easy and
 * Expert Dailies get their own speed badges with their own sections.
 *
 * The recorded times are converted to the rung they BEAT rather than used raw,
 * because the ladder's language is "under 0:30" — a solve of exactly 30.0s has
 * not cleared the 30 rung, and passing it raw would light it.
 *
 * @param {Record<string, any>} stats
 * @param {Array<{mode?: string, solve_time_seconds?: number}>} [dailyRows]
 * @returns {number|null}
 */
export function fastestSpeedThreshold(stats, dailyRows = [], opts = {}) {
  // `badgeId` picks whose LADDER is used; `wireMode` picks whose ROWS are read.
  // They are separate because a tier's badge can borrow Challenge's rung
  // thresholds while measuring only its own solves — which is exactly what Easy
  // does (David, 2026-09-05).
  const { badgeId = 'speedRecord', wireMode = 'daily' } = opts;
  const rungs = badgeTiers(getBadge(badgeId));
  if (rungs.length === 0) return null;

  // ⚠️ The blob floor is CHALLENGE-ONLY. `timeMilestones` and
  // `fastestTimeMilestones` are legacy top-level fields that have always meant
  // Challenge's Daily, so reading them for Easy or Expert would credit a tier
  // with another tier's record. Those tiers derive from rows alone, which is
  // correct rather than merely safe: they have no legacy history to protect.
  const challenge = wireMode === 'daily';
  const timeMap = challenge ? milestoneMap(stats, 'timeMilestones', 'time_milestones') : {};
  const fastestMap = challenge ? milestoneMap(stats, 'fastestTimeMilestones', 'fastest_time_milestones') : {};

  const recordedTimes = challenge && Array.isArray(stats.dailyChallengeTimes ?? stats.daily_challenge_times)
    ? (stats.dailyChallengeTimes ?? stats.daily_challenge_times)
    : [];
  let bestRecorded = Infinity;
  for (const entry of recordedTimes) {
    const seconds = positiveNumber(entry?.time ?? entry?.solve_time_seconds ?? entry);
    if (seconds > 0 && seconds < bestRecorded) bestRecorded = seconds;
  }

  // The rows themselves — the source that cannot be stale.
  if (Array.isArray(dailyRows)) {
    for (const row of dailyRows) {
      // An absent mode is legacy CHALLENGE, never a modern tier.
      if (!row || (row.mode ?? 'daily') !== wireMode) continue;
      const seconds = positiveNumber(row.solve_time_seconds);
      if (seconds > 0 && seconds < bestRecorded) bestRecorded = seconds;
    }
  }

  let best = null;
  for (const rung of rungs) {
    const cleared =
      positiveNumber(timeMap[rung]) > 0 ||
      positiveNumber(fastestMap[rung]) > 0 ||
      bestRecorded < rung;
    if (!cleared) continue;
    if (best === null || rung < best) best = rung;
  }
  return best;
}

// ---------------------------------------------------------------------------
// The derivation
// ---------------------------------------------------------------------------

/**
 * Derive all nine existing-system badges for ONE player.
 *
 * Pure — rows and numbers in, state out. `puzzlePoints` / `battlePoints` are
 * options rather than blob fields because they live at the TOP LEVEL of the
 * getPlayerStats envelope (`profiles.puzzle_points` / `.battle_points`), not
 * inside `game_stats`; the blob is still read as a fallback for a caller that
 * only holds the metadata copy.
 *
 * @param {object|null|undefined} gameStats - the player's `game_stats` blob
 * @param {{battleWins?: number,
 *          firstBattleWinDate?: string|null,
 *          puzzlePoints?: number,
 *          battlePoints?: number,
 *          dailyRows?: Array<object>}} [opts]
 *   `dailyRows` are the player's real `daily_challenge_times` rows. Optional, so
 *   every existing caller keeps working — but a caller that omits them gets the
 *   blob-only answer, which is the stale one this argument exists to fix.
 * @returns {Record<string, ExistingBadgeState>}
 */
export function deriveExistingBadgeState(gameStats, opts = {}) {
  const stats = statsBlob(gameStats);
  const { battleWins = 0, firstBattleWinDate = null, dailyRows = [] } = opts;

  const podiums = normalizePodiumFinishes(stats);
  const puzzlePoints = positiveNumber(opts.puzzlePoints ?? stats.puzzle_points ?? stats.puzzlePoints);
  const battlePoints = positiveNumber(opts.battlePoints ?? stats.battle_points ?? stats.battlePoints);
  const wins = positiveNumber(battleWins);

  return {
    dailyStreak: badgeState('dailyStreak', { value: longestDailyStreak(stats) }),
    perfectStreak: badgeState('perfectStreak', { value: longestPerfectStreak(stats) }),
    speedRecord: badgeState('speedRecord', { value: fastestSpeedThreshold(stats, dailyRows) }),
    podiumFirst: badgeState('podiumFirst', { count: podiums.first }),
    podiumSecond: badgeState('podiumSecond', { count: podiums.second }),
    podiumThird: badgeState('podiumThird', { count: podiums.third }),
    puzzlePieceBadge: badgeState('puzzlePieceBadge', { value: puzzlePoints }),
    battlePointsBadge: badgeState('battlePointsBadge', { value: battlePoints }),
    blitzWinLadder: badgeState('blitzWinLadder', {
      value: wins,
      count: wins,
      earliestDate: wins > 0 ? firstBattleWinDate : null,
    }),
    ...perTierPrestige(stats, dailyRows),
  };
}

/**
 * Easy's and Expert's streak, speed and podium badges.
 *
 * These read the SERVER-DERIVED `perMode` block rather than the legacy top-level
 * fields, because those fields have only ever meant Challenge. A tier with no
 * block yields zeros, which reads as an unearned badge — the honest answer for a
 * player who has never played that tier, and the same thing an empty ladder shows.
 *
 * Speed is the exception: it comes from the ROWS, filtered to the tier, because
 * `perMode.fastestTime` is a single number while the ladder needs to know which
 * rung was beaten.
 */
function perTierPrestige(stats, dailyRows) {
  const easy = tierBlock(stats, TIER_WIRE_KEY.dailyEasy);
  const expert = tierBlock(stats, TIER_WIRE_KEY.dailyExpert);
  const easyPodiums = tierPodiums(easy);
  const expertPodiums = tierPodiums(expert);

  return {
    dailyStreakEasy: badgeState('dailyStreakEasy', { value: positiveNumber(easy.longestStreak) }),
    speedRecordEasy: badgeState('speedRecordEasy', {
      value: fastestSpeedThreshold(stats, dailyRows, { badgeId: 'speedRecordEasy', wireMode: 'daily_easy' }),
    }),
    podiumFirstEasy: badgeState('podiumFirstEasy', { count: easyPodiums.first }),
    podiumSecondEasy: badgeState('podiumSecondEasy', { count: easyPodiums.second }),
    podiumThirdEasy: badgeState('podiumThirdEasy', { count: easyPodiums.third }),

    dailyStreakExpert: badgeState('dailyStreakExpert', { value: positiveNumber(expert.longestStreak) }),
    speedRecordExpert: badgeState('speedRecordExpert', {
      value: fastestSpeedThreshold(stats, dailyRows, { badgeId: 'speedRecordExpert', wireMode: 'daily_expert' }),
    }),
    podiumFirstExpert: badgeState('podiumFirstExpert', { count: expertPodiums.first }),
    podiumSecondExpert: badgeState('podiumSecondExpert', { count: expertPodiums.second }),
    podiumThirdExpert: badgeState('podiumThirdExpert', { count: expertPodiums.third }),
  };
}

/**
 * Colosseum wins for the win ladder, off the battle ROWS.
 *
 * Derived from `head_to_head_challenges` (`winner_id === userId`) via the same
 * summarizer Lane D uses — never from `game_stats.blitzStats` or
 * `profiles.battle_points`. Those client-maintained mirrors drift, and the
 * in-flight M3 finalize migration may drop them.
 *
 * @param {Array<object>} challenges - the player's completed battles
 * @param {string} userId - the TARGET player, never the signed-in one
 * @returns {{wins:number, firstWinDate:string|null}}
 */
export function deriveBlitzWinCount(challenges, userId) {
  if (!userId) return { wins: 0, firstWinDate: null };
  const summary = summarizePlayerBattleBadges(challenges, userId);
  // `battles` is chronological oldest-first, so the first winning row IS the
  // first win — no extra sort, no extra read.
  const firstWin = summary.battles.find((battle) => battle.isWin) ?? null;
  return { wins: summary.wins, firstWinDate: firstWin?.date ?? null };
}

// ---------------------------------------------------------------------------
// Fetch (thin) — the same fetch/derive split the rest of stats-aggregation uses
// ---------------------------------------------------------------------------

/**
 * Fetch + derive ANY player's existing-system badge state.
 *
 * Cross-player by construction, like Lanes B and D: `userId` is explicit and the
 * signed-in user is only the default. Both sources are already readable for any
 * authenticated viewer (`get-player-stats` is the same edge call the profile
 * pages make; `head_to_head_challenges` is world-readable), so this needs no
 * backend change.
 *
 * Pass `playerStats` / `challenges` when the caller already holds them, to skip
 * the redundant reads. A failed read degrades that ONE source rather than
 * throwing — a dead battle read must not blank the streak badges.
 *
 * @param {string} [userId] - target player; defaults to the signed-in user
 * @param {{playerStats?: object|null, challenges?: Array<object>, dailyRows?: Array<object>}} [opts]
 * @returns {Promise<Record<string, ExistingBadgeState>>}
 */
export async function getExistingBadgeState(userId, { playerStats, challenges, dailyRows } = {}) {
  const targetId = userId || (await apiClient.auth.me().catch(reportedFallback('badges.existing.me')))?.id;
  if (!targetId) return deriveExistingBadgeState(null);

  // THREE reads now, not two. The third is the same `daily_challenge_times`
  // scan craftBadgeDerivation already does — see `fastestSpeedThreshold` for
  // why the blob alone was not enough. A caller holding the rows already (the
  // Badges page fetches craft state alongside this) can pass them in to skip it.
  const [stats, battles, rows] = await Promise.all([
    playerStats !== undefined ? Promise.resolve(playerStats) : readPlayerStats(targetId),
    challenges !== undefined ? Promise.resolve(challenges) : readBattles(targetId),
    dailyRows !== undefined ? Promise.resolve(dailyRows) : readDailyRows(targetId),
  ]);

  const { wins, firstWinDate } = deriveBlitzWinCount(battles || [], targetId);
  return deriveExistingBadgeState(stats?.game_stats ?? null, {
    battleWins: wins,
    firstBattleWinDate: firstWinDate,
    puzzlePoints: stats?.puzzle_points,
    battlePoints: stats?.battle_points,
    dailyRows: rows || [],
  });
}

/** The player's Daily solve rows, degraded to `[]` rather than thrown. */
async function readDailyRows(targetId) {
  try {
    return (await apiClient.entities.DailyChallengeTime.filter({ user_id: targetId })) || [];
  } catch (error) {
    console.warn('Existing badges: failed to read daily rows, treating as none:', error);
    return [];
  }
}

/** The player's stats envelope, or null when the edge call can't serve it. */
async function readPlayerStats(targetId) {
  try {
    const result = await getPlayerStats(targetId);
    return result.success ? result.data : null;
  } catch (error) {
    console.warn('Existing badges: failed to read player stats, treating as none:', error);
    return null;
  }
}

/** The player's completed battles, degraded to `[]` rather than thrown. */
async function readBattles(targetId) {
  try {
    return (await getPlayerBattles(targetId)) || [];
  } catch (error) {
    console.warn('Existing badges: failed to read battles, treating as none:', error);
    return [];
  }
}
