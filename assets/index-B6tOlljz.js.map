// Tell the rest of the app that the signed-in user changed.
//
// ⚠️ WITHOUT THIS THE SCREEN LIES UNTIL THE APP IS RESTARTED (David, beta
// 1.0.312: "it requires the app to be closed to update. it should auto update").
//
// The eligibility writes all went to the server correctly and then set only
// LOCAL component state, so the chip on Home — which reads the `user` object
// Layout holds — kept showing the old standing. Layout already listens for
// 'userProfileUpdated' and re-reads; nothing was firing it.
//
// Re-reading the user rather than trusting the write's echo: the attestation
// lives in auth metadata, and `auth.me()` is the one place that resolves it the
// same way every reader does.
//
// Never throws. It runs after a write that has already succeeded, and a failure
// to REFRESH must not look like a failure to SAVE.

import { apiClient } from '@/transport';

export async function announceProfileChanged() {
  try {
    const fresh = await apiClient.auth.me();
    window.dispatchEvent(new CustomEvent('userProfileUpdated', { detail: fresh }));
  } catch {
    // The write landed; only the refresh did not. The next natural read fixes it.
  }
}
