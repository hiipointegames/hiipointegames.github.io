  ),

  // ── FOLDED-IN EXISTING SYSTEMS ──────────────────────────────────────────────

  // Daily Streak.
  flame: (
    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
  ),

  // Perfect Solve Streak — the flawless cut.
  diamond: (
    <>
      <path d="M6 3h12l4 6-10 12.5L2 9Z" />
      <path d="M11 3 8 9l4 12.5L16 9l-3-6" />
      <path d="M2 9h20" />
    </>
  ),

  // Speed Record.
  stopwatch: (
    <>
      <path d="M9.75 2.5h4.5" />
      <circle cx="12" cy="14" r="8" />
      <path d="m12 14 3-3" />
    </>
  ),

  // 1st / 2nd / 3rd Place Finishes. Same medal, different numeral — the podium
  // trio must read as one family and differ in exactly the thing that differs.
  'medal-1': medal('1'),
  'medal-2': medal('2'),
  'medal-3': medal('3'),

  // Puzzle Piece Badge — puzzle points.
  'puzzle-piece': (
    <path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z" />
  ),

  // Battle Points Badge — battle points.
  helmet: (
    <>
      <path d="M4.5 14.5a7.5 7.5 0 0 1 15 0" />
      <path d="M2.5 14.5h19" />
      <path d="M6 14.5v2.5a2.5 2.5 0 0 0 2.5 2.5h7a2.5 2.5 0 0 0 2.5-2.5v-2.5" />
    </>
  ),

  // Colosseum Wins — the win ladder.
  trophy: (
    <>
      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
      <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
      <path d="M4 22h16" />
      <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" />
      <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" />
      <path d="M18 2H6v7a6 6 0 0 0 12 0Z" />
    </>
  ),

  // ── RESERVED — not owned by any badge ───────────────────────────────────────

  // Hidden-and-unearned. BadgeFrame swaps to this so the art can't give the
  // feat away before the reveal pop-up.
  lock: (
    <>
      <rect x="3.5" y="10.5" width="17" height="11" rx="2.5" />
      <path d="M7.25 10.5V6.75a4.75 4.75 0 0 1 9.5 0v3.75" />
    </>
  ),

  // The default for an id this module has no drawing for. Never reached by a
  // catalog badge (there is a test), but a registry addition that forgets its
  // icon gets a plausible medal instead of an empty frame.
  medal: (
    <>
      <path d="M8.5 2.5 11 9" />
      <path d="M15.5 2.5 13 9" />
      <circle cx="12" cy="15" r="6.5" />
      <circle cx="12" cy="15" r="2.2" fill="currentColor" stroke="none" />
    </>
  ),
};

/**
 * The podium medal, parameterised by its numeral. Declared as a function rather
 * than three near-identical literals so 1st/2nd/3rd can never drift apart.
 * @param {string} numeral
 * @returns {React.ReactElement}
 */
function medal(numeral) {
  return (
    <>
      <path d="M8.5 2.5 11 9" />
      <path d="M15.5 2.5 13 9" />
      <circle cx="12" cy="15" r="6.5" />
      <text
        x="12"
        y="18.3"
        textAnchor="middle"
        fontSize="8.5"
        fontWeight="700"
        fill="currentColor"
        stroke="none"
      >
        {numeral}
      </text>
    </>
  );
}

/** Every key the set can draw. */
export const BADGE_ICON_KEYS = Object.keys(ICONS);

/** What an unmapped badge falls back to. */
export const DEFAULT_BADGE_ICON = 'medal';

/** What a hidden-and-unearned badge shows instead of its real art. */
export const LOCKED_BADGE_ICON = 'lock';

/**
 * Does this module have a drawing for `name`?
 * @param {string} [name]
 * @returns {boolean}
 */
export function hasBadgeIcon(name) {
  return typeof name === 'string' && Object.prototype.hasOwnProperty.call(ICONS, name);
}

/**
 * The icon key for a badge — its declared `icon`, or the default medal for a
 * badge that declares none (or one this set doesn't draw). Never returns a key
 * `BadgeIcon` can't render.
 * @param {{ icon?: string } | null | undefined} badge
 * @returns {string}
 */
export function badgeIconKey(badge) {
  return hasBadgeIcon(badge?.icon) ? /** @type {string} */ (badge?.icon) : DEFAULT_BADGE_ICON;
}

/**
 * One badge icon. Colour comes from `currentColor` — set `color` on an ancestor
 * (BadgeFrame sets it from the badge's mode accent) and the whole glyph follows.
 *
 * @param {Object} props
 * @param {string} [props.name] A key from `BADGE_ICON_KEYS`; unknown → the default.
 * @param {string} [props.className]
 * @param {string} [props.title] Accessible name. Omitted → the icon is decorative
 *   and hidden from assistive tech (the badge's own name is already announced).
 */
export default function BadgeIcon({ name, className = '', title }) {
  const key = hasBadgeIcon(name) ? /** @type {string} */ (name) : DEFAULT_BADGE_ICON;
  return (
    <svg
      data-testid="badge-icon"
      data-icon={key}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={1.75}
      strokeLinecap="round"
      strokeLinejoin="round"
      className={className}
      role={title ? 'img' : undefined}
      aria-hidden={title ? undefined : 'true'}
      focusable="false"
    >
      {title ? <title>{title}</title> : null}
      {ICONS[key]}
    </svg>
  );
}

export { ICONS as BADGE_ICONS };
