// shell/betaChannel — let a tester opt this device into (or out of) the Capgo
// "beta" OTA channel at runtime.
//
// Capgo channel model (see docs/capgo-channels.md for the full picture):
//   - production  → the DEFAULT channel. Every install pulls OTA bundles from
//                   here unless it has explicitly self-assigned elsewhere.
//   - beta        → a non-default channel with "Device Self Set" enabled, so the
//                   app is allowed to call setChannel({channel:'beta'}). Testers
//                   on beta receive a bundle BEFORE it is promoted to production.
//
// Joining beta = CapacitorUpdater.setChannel({channel:'beta'}). Leaving beta =
// unsetChannel(), which drops the override so the device falls back to the
// default channel (production). We deliberately use unsetChannel() rather than
// setChannel('production') so "leave beta" keeps working even if production's
// self-assign flag is ever turned off — the default is always reachable.
//
// All calls are no-ops on web (the plugin only exists in the native shell) and
// fail-safe: a plugin error is caught and reported as a structured result, never
// thrown, so a Capgo hiccup can't crash the menu that hosts the toggle.
//
// NOTE: setChannel talks to the @capgo/capacitor-updater NATIVE plugin already
// baked into the shipped store build — so this opt-in ships over the air (JS
// only), no new native release required.

import { Capacitor } from '@capacitor/core';
import { CapacitorUpdater } from '@capgo/capacitor-updater';

export const BETA_CHANNEL = 'beta';
export const PRODUCTION_CHANNEL = 'production';

/**
 * @typedef {Object} ChannelResult
 * @property {boolean} ok      true if the operation succeeded
 * @property {string=} channel the channel name now in effect (when known)
 * @property {boolean=} native false when called on web (no-op)
 * @property {string=} error   a human-readable error message when ok === false
 */

/**
 * Read the channel this device is currently assigned to.
 * On web there is no plugin, so we report production (the default everyone gets).
 * @returns {Promise<ChannelResult>}
 */
export async function getCurrentChannel() {
  if (!Capacitor.isNativePlatform()) {
    return { ok: true, channel: PRODUCTION_CHANNEL, native: false };
  }
  try {
    const res = await CapacitorUpdater.getChannel();
    // The plugin returns { channel, status, allowSet, error? }. A device that has
    // never self-assigned reports no channel override → treat as production.
    return { ok: true, channel: res?.channel || PRODUCTION_CHANNEL, native: true };
  } catch (e) {
    return { ok: false, error: e?.message || String(e), native: true };
  }
}

/**
 * Opt this device into the beta OTA channel.
 * @returns {Promise<ChannelResult>}
 */
export async function joinBeta() {
  if (!Capacitor.isNativePlatform()) {
    return { ok: false, error: 'Beta updates are only available in the app.', native: false };
  }
  try {
    await CapacitorUpdater.setChannel({ channel: BETA_CHANNEL });
    return { ok: true, channel: BETA_CHANNEL, native: true };
  } catch (e) {
    return { ok: false, error: e?.message || String(e), native: true };
  }
}

/**
 * Leave beta and fall back to the default channel (production).
 * @returns {Promise<ChannelResult>}
 */
export async function leaveBeta() {
  if (!Capacitor.isNativePlatform()) {
    return { ok: false, error: 'Beta updates are only available in the app.', native: false };
  }
  try {
    await CapacitorUpdater.unsetChannel({});
    return { ok: true, channel: PRODUCTION_CHANNEL, native: true };
  } catch (e) {
    return { ok: false, error: e?.message || String(e), native: true };
  }
}

/**
 * Convenience: true when the device is currently on beta.
 * @returns {Promise<boolean>}
 */
export async function isOnBeta() {
  const res = await getCurrentChannel();
  return res.ok && res.channel === BETA_CHANNEL;
}
