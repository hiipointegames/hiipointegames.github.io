// shell/adSwitch — may a native (AdMob) interstitial load and show right now?
//
// WHY THIS EXISTS. On 2026-10-08 Google's own close-button script inside the ad
// (gstatic `addon/countdown_close`) froze every interstitial: no X, taps dead,
// and iPhone players (no back key) stuck until a hard close. We turned them off
// with a build-time flag, so turning them off AGAIN would have needed a whole
// CapGo release while players were stuck. This reads a server switch instead,
// public.app_settings key `native_interstitials`
// (supabase/migrations/20261010000000_app_settings_and_interstitial_events.sql):
//
//   'off'  — no full-screen ads (the default)
//   'beta' — only phones on the CapGo beta channel (test with real ads, no release)
//   'on'   — everyone
//
// FAIL SAFE: a missing row, a failed read or a slow read all mean 'off'. A
// network problem may cost an ad; it must never re-trap a player.
//
// The answer is cached for SWITCH_CACHE_MS, so a flip on the server reaches a
// running app within about two minutes, and is re-checked right before each show.
//
// VITE_NATIVE_INTERSTITIALS=on|off at build time overrides the server: that is
// how a local test build forces ads on (or off) regardless of the switch.

import { Capacitor } from '@capacitor/core';
import { supabase, withTimeout } from '@/transport';
import { isOnBeta } from './betaChannel';

export const INTERSTITIAL_SETTING_KEY = 'native_interstitials';
export const INTERSTITIAL_MODES = Object.freeze(['off', 'beta', 'on']);
export const SWITCH_CACHE_MS = 2 * 60 * 1000;
const READ_TIMEOUT_MS = 4000;

// ── The generic reader (2026-10-20) ──────────────────────────────────────────
// `app_settings` holds more than one switch now (`feature_tips`, `referrals`).
// Every key gets the SAME rules as the ad switch: off/beta/on, a missing row or
// a failed/slow read is 'off', and the answer is cached per key for
// SWITCH_CACHE_MS. The interstitial functions below are thin wrappers over it.
export const APP_SWITCH_MODES = INTERSTITIAL_MODES;

/** Per-key cache: key -> { mode, at }. */
/** @type {Map<string, { mode: string, at: number }>} */
const cache = new Map();

/** 'on' | 'off' when the build forces it, otherwise null (the server decides). */
export function buildOverride() {
  const v = import.meta.env?.VITE_NATIVE_INTERSTITIALS;
  return v === 'on' || v === 'off' ? v : null;
}

/**
 * Read one `app_settings` switch from the server, uncached. Never throws;
 * anything unexpected is 'off'.
 * @param {string} key
 * @param {{ client?: any, timeoutMs?: number }} [deps]
 * @returns {Promise<'off'|'beta'|'on'>}
 */
export async function fetchAppSwitch(key, deps = {}) {
  try {
    const client = deps.client || supabase;
    const res = await withTimeout(
      client.from('app_settings').select('value').eq('key', key).maybeSingle(),
      { data: null, error: 'timeout' },
      deps.timeoutMs ?? READ_TIMEOUT_MS,
    );
    const value = res?.data?.value;
    return APP_SWITCH_MODES.includes(value) ? value : 'off';
  } catch {
    return 'off';
  }
}

/**
 * Read one switch through the per-key cache (re-read after SWITCH_CACHE_MS).
 * @param {string} key
 * @param {{ client?: any, timeoutMs?: number, now?: () => number }} [deps]
 * @returns {Promise<'off'|'beta'|'on'>}
 */
export async function readAppSwitch(key, deps = {}) {
  const now = (deps.now || Date.now)();
  const hit = cache.get(key);
  if (hit && now - hit.at <= SWITCH_CACHE_MS) return /** @type {any} */ (hit.mode);
  const mode = await fetchAppSwitch(key, deps);
  cache.set(key, { mode, at: now });
  return mode;
}

/** The dev-only localStorage override for a switch: `37.switch.<key>`. */
export const DEV_SWITCH_STORAGE_PREFIX = '37.switch.';

/** A valid mode from the DEV-only localStorage override, else null. Never in a real build. */
export function devSwitchOverride(key, deps = {}) {
  const dev = deps.dev !== undefined ? deps.dev : Boolean(import.meta.env?.DEV);
  if (!dev) return null;
  try {
    const storage = deps.storage || globalThis.localStorage;
    const v = storage?.getItem(DEV_SWITCH_STORAGE_PREFIX + key);
    return APP_SWITCH_MODES.includes(v) ? v : null;
  } catch {
    return null;
  }
}

/**
 * Is a player-facing feature switched on for THIS device right now? For switches
 * that are NOT native-only (unlike the interstitials, a feature tip works on web
 * too).
 *
 *   'on'   — everyone
 *   'beta' — phones on the CapGo beta channel, plus `npm run dev` (web has no
 *            channel, so DEV is how a developer sees a 'beta' feature in a browser)
 *   'off'  — no one
 *
 * In DEV only, `localStorage['37.switch.<key>']` overrides the server.
 *
 * @param {string} key
 * @param {{ client?: any, timeoutMs?: number, now?: () => number,
 *           isOnBeta?: () => Promise<boolean>, dev?: boolean, storage?: any }} [deps]
 * @returns {Promise<boolean>}
 */
export async function appSwitchEnabled(key, deps = {}) {
  const dev = deps.dev !== undefined ? deps.dev : Boolean(import.meta.env?.DEV);
  const mode = devSwitchOverride(key, { ...deps, dev }) || await readAppSwitch(key, deps);
  if (mode === 'on') return true;
  if (mode !== 'beta') return false;
  if (dev) return true;
  try {
    return await (deps.isOnBeta || isOnBeta)();
  } catch {
    return false;
  }
}

/**
 * Read the interstitial switch. Never throws; anything unexpected is 'off'.
 * @param {{ client?: any, timeoutMs?: number }} [deps]
 * @returns {Promise<'off'|'beta'|'on'>}
 */
export async function fetchInterstitialMode(deps = {}) {
  return fetchAppSwitch(INTERSTITIAL_SETTING_KEY, deps);
}

/**
 * True when a native interstitial may load and show right now. Always false on web
 * (web has its own placeholder interstitial, which is ours, not Google's).
 * @param {{ Capacitor?: any, override?: string|null, now?: () => number,
 *           isOnBeta?: () => Promise<boolean>, client?: any }} [deps]
 * @returns {Promise<boolean>}
 */
export async function interstitialsAllowed(deps = {}) {
  const cap = deps.Capacitor || Capacitor;
  if (!cap.isNativePlatform?.()) return false;
  const override = deps.override !== undefined ? deps.override : buildOverride();
  if (override) return override === 'on';
  const mode = await readAppSwitch(INTERSTITIAL_SETTING_KEY, deps);
  if (mode === 'on') return true;
  if (mode === 'beta') {
    try {
      return await (deps.isOnBeta || isOnBeta)();
    } catch {
      return false;
    }
  }
  return false;
}

// Test-only: forget the cached switch.
export function __resetAdSwitchForTests() { cache.clear(); }
