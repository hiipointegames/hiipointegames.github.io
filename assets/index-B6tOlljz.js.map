import React, { useState, useEffect } from 'react';
import { Users, Trash2, ChevronDown, ChevronUp } from 'lucide-react';
import { Button } from '@/ui/primitives/button';
import { Link } from 'react-router-dom';
import { countryName } from './countryName';
import { createPageUrl } from '@/routing/createPageUrl';
import { removeFriend, getFriendEdges, selectFriendIds, getProfilesByIds } from '@/player';
import { motion, AnimatePresence } from 'framer-motion';
import { playSound } from '@/ui/feedback';

export default function FriendsList({ currentUser, onUpdate }) {
  const [friendsData, setFriendsData] = useState([]);
  const [loading, setLoading] = useState(true);
  const [isExpanded, setIsExpanded] = useState(false);

  useEffect(() => {
    const loadFriends = async () => {
      if (!currentUser) {
        setLoading(false);
        return;
      }

      try {
        console.log('--- LOADING FRIENDS LIST ---');
        console.log('For User:', currentUser.id);
        // 1-3. Collect all friend IDs from the one friend-edge read path
        const edges = await getFriendEdges(currentUser.id);
        const friendIds = new Set(selectFriendIds(edges, currentUser.id));

        if (friendIds.size === 0) {
          console.log('No friends found for user:', currentUser.id);
          setFriendsData([]);
          setLoading(false);
          return;
        }

        console.log('Found Friend IDs:', Array.from(friendIds));

        // 4. Fetch profiles for these IDs only
        // Fetch the friends' profiles in one batched read by id
        const friendIdsArray = Array.from(friendIds);
        const friendUsers = [...(await getProfilesByIds(friendIdsArray)).values()];

        // Remove duplicates by ID (just in case)
        const uniqueFriends = friendUsers.reduce((acc, user) => {
          if (!acc.find(u => u.id === user.id)) {
            acc.push(user);
          }
          return acc;
        }, []);

        // Sort alphabetically by username
        const sortedFriends = uniqueFriends.sort((a, b) =>
          (a.username || '').localeCompare(b.username || '')
        );

        setFriendsData(sortedFriends);
      } catch (error) {
        console.error('Failed to load friends:', error);
      } finally {
        setLoading(false);
      }
    };

    loadFriends();
  }, [currentUser]);

  const handleRemoveFriend = async (friendId) => {
    playSound('buttonTap');
    try {
      await removeFriend(friendId);
      onUpdate();
    } catch (error) {
      console.error('Failed to remove friend:', error);
    }
  };

  return (
    <div className="bg-gradient-to-br from-emerald-900/40 to-teal-900/30 backdrop-blur rounded-2xl p-6 border-2 border-emerald-400/40 shadow-lg shadow-emerald-500/20">
      <button
        onClick={() => {
          playSound('buttonTap');
          setIsExpanded(!isExpanded);
        }}
        className="w-full flex items-center justify-between mb-4 hover:opacity-80 transition-opacity"
      >
        <h3 className="text-xl font-bold bg-gradient-to-r from-emerald-300 to-green-400 bg-clip-text text-transparent flex items-center gap-2">
          <Users className="w-5 h-5 text-emerald-400" />
          My Friends ({friendsData.length})
        </h3>
        {isExpanded ? (
          <ChevronUp className="w-5 h-5 text-emerald-300" />
        ) : (
          <ChevronDown className="w-5 h-5 text-emerald-300" />
        )}
      </button>

      <AnimatePresence>
        {isExpanded && (
          <motion.div
            initial={{ height: 0, opacity: 0 }}
            animate={{ height: 'auto', opacity: 1 }}
            exit={{ height: 0, opacity: 0 }}
            transition={{ duration: 0.2 }}
            className="overflow-hidden"
          >
            {loading ? (
              <div className="text-center text-emerald-300 py-4 font-semibold">Loading friends...</div>
            ) : friendsData.length === 0 ? (
              <div className="text-center text-emerald-400/70 py-8">
                <Users className="w-12 h-12 mx-auto mb-2 opacity-50" />
                <p>No friends yet. Search for players to add!</p>
              </div>
            ) : (
              <div className="space-y-2">
                {friendsData.map(friend => (
                  <div
                    key={friend.id}
                    className="flex items-center justify-between p-3 bg-gradient-to-r from-emerald-700/30 to-teal-700/20 rounded-lg border border-emerald-500/30 hover:border-emerald-400/60 hover:bg-gradient-to-r hover:from-emerald-700/40 hover:to-teal-700/30 transition-all"
                  >
                    <Link
                      to={`${createPageUrl('OtherProfile')}?id=${encodeURIComponent(friend.id)}`}
                      className="flex items-center gap-3 flex-1 min-w-0 hover:opacity-80 transition-opacity"
                    >
                      <div className="w-10 h-10 rounded-full bg-slate-700/50 flex items-center justify-center border border-slate-600 overflow-hidden flex-shrink-0">
                        {friend.country ? (
                          <img
                            src={`https://flagcdn.com/w80/${friend.country?.toLowerCase()}.png`}
                            alt="Country flag"
                            className="w-full h-full object-cover"
                          />
                        ) : (
                          <span className="text-xl">❓</span>
                        )}
                      </div>
                      <div className="flex items-center gap-2 min-w-0">
                        {friend.country && (
                          <img
                            src={`https://flagcdn.com/w40/${friend.country?.toLowerCase()}.png`}
                            alt="Flag"
                            className="w-6 h-4 object-cover rounded flex-shrink-0"
                          />
                        )}
                        <div className="min-w-0">
                          <div className="text-emerald-100 font-bold truncate">{friend.username}</div>
                          {/* ⚠️ THE SECOND SURFACE. UserSearch's copy of this
                              placeholder was fixed earlier the same day; this
                              one was missed, so a searched player showed
                              "United States" and the same player in the friends
                              list still read "Country Selected". Same shared
                              helper now. Absent entirely when no country is set,
                              which is what `friend.country &&` already did. */}
                          {friend.country && (
                            <div className="text-xs text-emerald-400/70">{countryName(friend.country)}</div>
                          )}
                        </div>
                      </div>
                    </Link>
                    <Button
                      onClick={() => handleRemoveFriend(friend.id)}
                      variant="ghost"
                      className="text-red-300 hover:text-red-200 hover:bg-red-500/20 flex-shrink-0"
                    >
                      <Trash2 className="w-4 h-4" />
                    </Button>
                  </div>
                ))}
              </div>
            )}
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}