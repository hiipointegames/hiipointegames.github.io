// Daily-challenge share text + the share/copy dispatcher — extracted from the
// two byte-identical copies that lived inline in Game.jsx (handleCompletionShare)
// and SuccessModal.jsx (handleShare). Both built the same share string, both
// re-rolled the leaderboard rank as findIndex+1, and both carried the same
// sms/email/navigator.share/clipboard dispatcher + toast. This owns all three.
//
// buildDailyShareText is pure (the caller passes the already-formatted `today`
// and the leaderboard, so no clock/I-O here); rank routes through the canonical
// getUserRank instead of a third hand-rolled findIndex+1. shareOrCopy is the
// side-effecting dispatcher (navigator/clipboard/location + a toast).

import { getUserRank } from '@/stats-aggregation';
import { modeOf, isDaily } from '@/game-modes';
import { formatSolveTime } from '@/ui/feedback';
import { shareDailyCard } from './dailyShareCard';
import { reportShareFailure, showCopyFallback, shareOutcome } from './shareFailure';

// The single canonical share/invite destination. Was the Linktree
// (linktr.ee/37.hiipointegames); switched 2026-07-02 to the marketing site per
// the July-2 prompt list (item 11). Change here — every share string reads it.
const ROLL_URL = 'https://www.37themathpuzzle.com';

/**
 * Build the daily-challenge share string for one of three outcomes. Pure.
 *
 *   'completed' (with a todayTime) → the full card with time + optional rank
 *   'forfeited'                    → the "Boo-Hoo!" taunt
 *   anything else / completed-without-time → the generic fallback
 *
 * @param {object} p
 * @param {'completed'|'forfeited'|'fallback'} p.status
 * @param {string} p.today - preformatted date, e.g. nowET().format('MMMM D, YYYY')
 * @param {{time?: number}} [p.todayTime] - the viewer's daily time row
 * @param {Array<{user_id: string}>} [p.leaderboard] - THAT MODE's sorted board (rank + count)
 * @param {string} [p.userId]
 * @param {string} [p.mode] - wire key; defaults to Challenge's Daily so every
 *   pre-modes caller produces a byte-identical card
 * @returns {string}
 */
// C19 -- WHICH Daily a share card is about.
//
// The card used to say "Daily Challenge" and quote a rank from a MODE-BLIND
// board, whatever mode was actually played. Under three Dailies that is wrong
// twice over: three players sharing three DIFFERENT puzzles produce
// identical-looking cards, and the rank is a position among people who did not
// play your puzzle. Naming the mode is the smaller half of the fix; the larger
// half is that the caller now passes THAT MODE's board (see @/game-flow
// useTodaysLeaderboard), so the rank is finally a rank in something.
//
// Challenge's Daily keeps the bare name "Daily Challenge": it is what every
// shipped card has said, and renaming it would make old and new cards look like
// different games.
const DAILY_TITLE = {
  easy: 'Easy Daily',
  challenge: 'Daily Challenge',
  expert: 'Expert Daily',
};

// A practice round has no share card of its own, so a non-daily key falls back
// to the legacy title rather than inventing one.
const titleFor = (mode) => (isDaily(mode) ? DAILY_TITLE[modeOf(mode)] : DAILY_TITLE.challenge);

export function buildDailyShareText({
  status, today, todayTime, leaderboard = [], userId, mode = 'daily',
}) {
  const title = titleFor(mode);

  if (status === 'forfeited') {
    return `Boo-Hoo! 37 bested me on today's ${title}. Can you beat it? ${ROLL_URL}`;
  }

  if (status === 'completed' && todayTime) {
    const rank = getUserRank(leaderboard, userId);
    const rankLine = rank > 0 ? `\n🏆 Ranked #${rank} of ${leaderboard.length} players` : '';
    return `🎲 37 The Math Puzzle - ${title}\n📅 ${today}\n\n⏱️ My Time: ${formatSolveTime(todayTime?.time || 0)}${rankLine}\n\nThink you can build your equation to 37 quicker?\nGo Roll at: ${ROLL_URL}`;
  }

  return `Check out today's ${title} at ${ROLL_URL}!`;
}

/**
 * Build the "invite your friends to 37" share string. Pure. Shares the marketing
 * site (37themathpuzzle.com) via the same web-share path as the daily share.
 * @returns {string}
 */
export function buildInviteText() {
  // Wording set by Bryce (1.0.287) from the real invite he received: name the two
  // things a friend actually joins for instead of explaining the rules, and put
  // the link on its own line so it reads as the call to action. The hyphenated
  // "37 - The Math Puzzle" is deliberate — it matches how the app is named in the
  // stores, and an em dash renders inconsistently across SMS clients.
  return `🎲 Join me in playing 37 - The Math Puzzle! Play the Daily Challenge and Battle Friends!\n\nGet it here:\n${ROLL_URL}`;
}

// Center-screen "Copied to clipboard!" toast — a DOM side effect, removed after 2s.
function showCopiedToast() {
  const toast = document.createElement('div');
  toast.textContent = 'Copied to clipboard!';
  toast.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#10b981;color:white;padding:12px 24px;border-radius:8px;z-index:9999;font-weight:600;';
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);
}

// navigator.clipboard.writeText can reject (NotAllowedError) even where it's
// the ONLY option — e.g. the async catch after a failed navigator.share runs
// outside the tap's user-activation window in some webviews. shareOrCopy is
// called fire-and-forget at every call site, so an unguarded rejection here
// becomes a genuine unhandled promise rejection in production (Sentry
// 37-THE-MATH-PUZZLE-1S). Never fail silently: report it, and hand the player a
// "Copy your result" button whose own tap is allowed to write (shareFailure).
async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
    shareOutcome('copied', 'clipboard');
    showCopiedToast();
  } catch (err) {
    shareOutcome('failed', 'clipboard');
    reportShareFailure({ step: 'clipboard', error: err });
    showCopyFallback(text);
  }
}

/**
 * Dispatch share text via the chosen method. Side-effecting.
 *   'sms'   → device SMS composer (iOS sms:& vs Android sms:?)
 *   'email' → mailto with the caller's subject
 *   default → navigator.share, falling back to clipboard + toast (and the same
 *             fallback when the Web Share API is unavailable)
 *
 * @param {'sms'|'email'|string} method
 * @param {string} text
 * @param {{ emailSubject?: string }} [opts]
 */
export async function shareOrCopy(method, text, { emailSubject } = {}) {
  if (method === 'sms') {
    const smsBody = encodeURIComponent(text);
    const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
    window.location.href = isIOS ? `sms:&body=${smsBody}` : `sms:?body=${smsBody}`;
  } else if (method === 'email') {
    const subject = encodeURIComponent(emailSubject);
    const body = encodeURIComponent(text);
    window.location.href = `mailto:?subject=${subject}&body=${body}`;
  } else if (navigator.share) {
    try {
      await navigator.share({ text });
      shareOutcome('text-shared', 'text');
    } catch (err) {
      if (err.name !== 'AbortError') {
        // Refused, not cancelled. A clipboard write in this same tap would be
        // refused too (37-THE-MATH-PUZZLE-2V), so offer a fresh tap instead.
        shareOutcome('refused', 'text');
        reportShareFailure({ step: 'web-text', error: err });
        showCopyFallback(text);
      } else {
        shareOutcome('cancelled', 'text');
      }
    }
  } else {
    await copyToClipboard(text);
  }
}

/**
 * Share the RESOLVED daily from the home result card.
 *
 * Extracted from Game.jsx's `handleCompletionShare`, which is the third and last
 * inline copy of this concern in the app. It carried the outcome ladder
 * (forfeited → completed-with-a-time → fallback), the "find my row on today's
 * board" lookup, and the subject line — none of which is about the Game page.
 * With `buildDailyShareText` and `shareOrCopy` already living here, keeping the
 * glue somewhere else was the only reason a caller had to know the ladder at all.
 *
 * @param {object} p
 * @param {'native'|'sms'|'email'|string} p.method
 * @param {Array<{user_id: string, solve_time_seconds?: number}>} [p.leaderboard]
 *   THAT mode's sorted board for today.
 * @param {string} [p.userId]
 * @param {string} [p.mode] wire key of the Daily being shared.
 * @param {boolean} [p.completed]
 * @param {boolean} [p.forfeited]
 * @param {string} p.today preformatted date, e.g. nowET().format('MMMM D, YYYY').
 *   Passed in rather than read here so this stays clock-free and testable.
 * @returns {Promise<void>}
 */
export async function shareResolvedDaily({
  method, leaderboard = [], userId, mode, completed, forfeited, today,
}, deps = {}) {
  const todayTime = leaderboard
    .filter((r) => r.user_id === userId)
    .map((r) => ({ time: r.solve_time_seconds }))[0];

  const status = forfeited
    ? 'forfeited'
    : (completed && todayTime?.time) ? 'completed' : 'fallback';

  const emailSubject = 'Check out my 37 Puzzle Daily Challenge time!';

  // A RESOLVED Daily (finished or forfeited) shares the picture card + message
  // (@/share-card, approved 2026-09-29). The card flow falls back to this same
  // dispatcher with the new message text when the device cannot share a picture.
  if (status !== 'fallback') {
    await (deps.shareDailyCard || shareDailyCard)({
      mode: mode || 'daily',
      forfeited: status === 'forfeited',
      board: leaderboard,
      userId,
      fallbackText: (text) => shareOrCopy(method, text, { emailSubject }),
    });
    return;
  }

  // Nothing resolved to show (a status flip mid-load, or a missing board row):
  // the generic line, as before, rather than a card claiming a result.
  const text = buildDailyShareText({ status, today, todayTime, leaderboard, userId, mode });
  await shareOrCopy(method, text, { emailSubject });
}
