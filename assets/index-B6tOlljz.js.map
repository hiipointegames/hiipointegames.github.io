import React, { createContext, useCallback, useContext, useEffect, useMemo, useRef } from 'react';
import { MotionConfig } from 'framer-motion';
import { playSynth } from '../synth';
import { createParticles, drawParticles } from './particles';
import { createShake } from './shake';
import { haptic } from './haptics';
import { resolveCue } from './cues';
import { prefersReducedMotion } from './motionPrefs';

// The fx layer every Sector 73 mode sits inside (animation playbook §4).
//
// - A STAGE div the mode renders into; screen shake moves it (transform only).
// - One overlay CANVAS above the stage for particles (pointer-events: none, DPR capped at 2).
// - One requestAnimationFrame loop that runs only while something is moving, and pauses
//   when the app is in the background.
// - useFx() gives modes { cue, burst, shake, hitStop }; outside a provider it is a no-op,
//   so modes (and their tests) work without one.

const noop = () => {};
/**
 * @typedef {{ cue: (name: string, opts?: object) => void, burst: (target: any, opts?: object) => void,
 *   shake: (amount: number) => void, hitStop: (ms: number) => Promise<void> }} FxApi
 */
/** @type {FxApi} */
const NOOP_FX = Object.freeze({ cue: noop, burst: noop, shake: noop, hitStop: () => Promise.resolve() });
const FxContext = createContext(NOOP_FX);

export const useFx = () => useContext(FxContext);

/** Centre of an element, relative to the provider box — or the point itself. */
function pointOf(target, box) {
  if (!target) return { x: box.width / 2, y: box.height / 2 };
  if (typeof target.x === 'number' && typeof target.y === 'number' && !target.getBoundingClientRect) return target;
  const el = target.current ?? target;
  const r = el?.getBoundingClientRect?.();
  if (!r) return { x: box.width / 2, y: box.height / 2 };
  return { x: r.left - box.left + r.width / 2, y: r.top - box.top + r.height / 2 };
}

export function FxProvider({ children, className = '', style = undefined }) {
  const rootRef = useRef(null);
  const stageRef = useRef(null);
  const canvasRef = useRef(null);
  const sim = useRef({ particles: createParticles(), shake: createShake(), raf: 0, last: 0, t: 0, frozenUntil: 0 });

  const loop = useCallback((now) => {
    const s = sim.current;
    const dt = Math.min(0.05, (now - (s.last || now)) / 1000);
    s.last = now;
    s.t += dt;
    const frozen = now < s.frozenUntil; // hit-stop: the world holds its breath
    const alive = frozen ? s.particles.alive : s.particles.step(dt);
    const off = s.shake.step(s.t, frozen ? 0 : dt);
    if (stageRef.current) {
      stageRef.current.style.transform = off.active ? `translate3d(${off.x.toFixed(2)}px, ${off.y.toFixed(2)}px, 0) rotate(${off.rotate.toFixed(3)}deg)` : '';
    }
    const c = canvasRef.current;
    const g = c?.getContext?.('2d');
    if (g && c) {
      const dpr = Math.min(2, globalThis.devicePixelRatio || 1);
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.clearRect(0, 0, c.width, c.height);
      drawParticles(g, s.particles.living());
    }
    s.raf = alive > 0 || off.active || frozen ? requestAnimationFrame(loop) : 0;
    if (!s.raf) s.last = 0;
  }, []);

  const wake = useCallback(() => {
    const s = sim.current;
    if (!s.raf && !(typeof document !== 'undefined' && document.hidden)) s.raf = requestAnimationFrame(loop);
  }, [loop]);

  // Size the overlay canvas to the provider box (DPR ≤ 2: fill cost on 3× phones).
  useEffect(() => {
    const root = rootRef.current;
    const c = canvasRef.current;
    if (!root || !c) return undefined;
    const fit = () => {
      const dpr = Math.min(2, globalThis.devicePixelRatio || 1);
      const r = root.getBoundingClientRect();
      c.width = Math.max(1, Math.round(r.width * dpr));
      c.height = Math.max(1, Math.round(r.height * dpr));
      c.style.width = `${r.width}px`;
      c.style.height = `${r.height}px`;
    };
    fit();
    globalThis.addEventListener?.('resize', fit);
    return () => globalThis.removeEventListener?.('resize', fit);
  }, []);

  useEffect(() => {
    const s = sim.current;
    const onVis = () => { if (document.hidden && s.raf) { cancelAnimationFrame(s.raf); s.raf = 0; s.last = 0; } else wake(); };
    document.addEventListener('visibilitychange', onVis);
    return () => { document.removeEventListener('visibilitychange', onVis); if (s.raf) cancelAnimationFrame(s.raf); };
  }, [wake]);

  const api = useMemo(() => {
    const box = () => rootRef.current?.getBoundingClientRect?.() || { left: 0, top: 0, width: 0, height: 0 };
    /**
     * @param {any} target  an element, a ref, or { x, y } inside the provider
     * @param {{ preset?: 'burst'|'ring'|'dust'|'confetti37', color?: string, heat?: number, count?: number }} [opts]
     */
    const burst = (target, { preset = 'burst', color = undefined, heat = 0, count = undefined } = {}) => {
      if (prefersReducedMotion()) return;
      const p = pointOf(target, box());
      sim.current.particles.emit(preset, p.x, p.y, { color, heat, count });
      wake();
    };
    const shake = (amount) => {
      if (prefersReducedMotion()) return;
      sim.current.shake.add(amount);
      wake();
    };
    const hitStop = (ms) => {
      if (prefersReducedMotion() || !ms) return Promise.resolve();
      sim.current.frozenUntil = performance.now() + ms;
      wake();
      return new Promise((resolve) => setTimeout(resolve, ms));
    };
    /**
     * Fire a cue from the table: sound + vibration + visuals, in sync.
     * @param {string} name
     * @param {{ at?: any, color?: string, heat?: number, pitch?: number }} [opts]
     */
    const cue = (name, { at = undefined, color = undefined, heat = 0, pitch = undefined } = {}) => {
      const c = resolveCue(name, { reducedMotion: prefersReducedMotion() });
      if (!c) return;
      if (c.sound) playSynth(c.sound, { pitch });
      if (c.haptic) haptic(c.haptic);
      if (c.burst) burst(at, { preset: /** @type {any} */ (c.burst), color, heat });
      if (c.trauma) shake(c.trauma * (1 + heat * 0.5));
      if (c.hitStop) hitStop(c.hitStop);
    };
    return { cue, burst, shake, hitStop };
  }, [wake]);

  return (
    <FxContext.Provider value={api}>
      <MotionConfig reducedMotion="user">
        <div ref={rootRef} className={`relative ${className}`} style={style} data-testid="fx-root">
          <div ref={stageRef} className="h-full w-full" data-testid="fx-stage">{children}</div>
          <canvas ref={canvasRef} aria-hidden="true" className="pointer-events-none absolute inset-0 z-40" data-testid="fx-canvas" />
        </div>
      </MotionConfig>
    </FxContext.Provider>
  );
}
