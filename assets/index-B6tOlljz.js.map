// sector73/sector73Switch — is Sector 73 switched ON for this app right now?
//
// WHY THIS EXISTS. Sector 73 ships to main (and the stores) SWITCHED OFF: prod has
// none of its database objects (no sector73_* RPCs or tables, no rooms), so with
// the switch off the 37 game must behave exactly like it did before Sector 73
// was merged, and the app must never call a Sector 73 server object. Turning it
// on later is a server flip, not a release. The switch is
// public.app_settings key `sector73` (the same table as shell/adSwitch.js):
//
//   'on'   — Sector 73 is open (the Mirror, the clue, the Looking Glass badge, /Sector73)
//   anything else, a missing row, a failed read, a slow read — OFF
//
// FAIL CLOSED. Prod has no `sector73` row, so prod is OFF with no write needed.
// Until the first read settles every caller sees OFF too, so nothing gated
// (e.g. the Mirror's unlock-check query) can fire before the answer is known.
//
// The answer is cached for SWITCH_CACHE_MS (like the ad switch), so a flip
// reaches a running app within about two minutes. One read is shared by every
// caller that asks while it is in flight.
//
// DEV OVERRIDE. VITE_SECTOR73=on|off forces the answer, but ONLY in a dev server
// (`vite`, mode 'development') or a staging run (`--mode staging`). Every release
// build — the CapGo bundle, the store builds, the Vercel web build — is mode
// 'production', and the override is not even read there: the expression below
// folds to `undefined` at build time, so a stray VITE_SECTOR73 in a developer's
// .env.local can never be baked into a shipped bundle.

import { useEffect, useState } from 'react';
import { supabase, withTimeout } from '@/transport';

export const SECTOR73_SETTING_KEY = 'sector73';
export const SWITCH_CACHE_MS = 2 * 60 * 1000;
const READ_TIMEOUT_MS = 4000;

/** Build modes that may honour VITE_SECTOR73. Release builds are 'production'. */
export const OVERRIDE_MODES = Object.freeze(['development', 'staging']);

const BUILD_MODE = import.meta.env.MODE;
// Read member-by-member (never the whole import.meta.env object) and compared as plain
// string literals, so a production build folds this to `undefined` at build time and the
// flag's value never lands in the bundle (an `OVERRIDE_MODES.includes(...)` here does NOT
// fold — checked with a `VITE_SECTOR73=on vite build`, 2026-10-20).
const BUILD_FLAG = import.meta.env.MODE === 'development' || import.meta.env.MODE === 'staging'
  ? import.meta.env.VITE_SECTOR73
  : undefined;

/**
 * 'on' | 'off' when a dev/staging build forces it, otherwise null (the server decides).
 * @param {{ mode?: string, flag?: string }} [build]
 * @returns {'on'|'off'|null}
 */
export function sector73BuildOverride({ mode = BUILD_MODE, flag = BUILD_FLAG } = {}) {
  if (!OVERRIDE_MODES.includes(mode)) return null;
  return flag === 'on' || flag === 'off' ? flag : null;
}

/**
 * Read the server switch. Never throws; anything but the row value 'on' is false.
 * @param {{ client?: any, timeoutMs?: number }} [deps]
 * @returns {Promise<boolean>}
 */
export async function fetchSector73Switch(deps = {}) {
  try {
    const client = deps.client || supabase;
    const res = await withTimeout(
      client.from('app_settings').select('value').eq('key', SECTOR73_SETTING_KEY).maybeSingle(),
      { data: null, error: 'timeout' },
      deps.timeoutMs ?? READ_TIMEOUT_MS,
    );
    return res?.data?.value === 'on';
  } catch {
    return false;
  }
}

/** @type {{ enabled: boolean, at: number } | null} */
let cache = null;
/** @type {Promise<boolean> | null} */
let inflight = null;

/**
 * Is Sector 73 switched on? For non-React callers. Never rejects; fails closed.
 * @param {{ override?: 'on'|'off'|null, now?: () => number, client?: any, timeoutMs?: number }} [deps]
 * @returns {Promise<boolean>}
 */
export async function isSector73Enabled(deps = {}) {
  const override = deps.override !== undefined ? deps.override : sector73BuildOverride();
  if (override) return override === 'on';
  const now = deps.now || Date.now;
  if (cache && now() - cache.at <= SWITCH_CACHE_MS) return cache.enabled;
  if (!inflight) {
    inflight = fetchSector73Switch(deps).then((enabled) => {
      cache = { enabled, at: now() };
      inflight = null;
      return enabled;
    });
  }
  return inflight;
}

/**
 * The last known answer, synchronously: true/false once a read has settled (or a
 * dev override forces it), null while nothing is known yet. Callers treat null as OFF.
 * A cached ON older than SWITCH_CACHE_MS is not trusted (null), so a screen that mounts
 * after David switched it off never flashes Sector 73 while the fresh read is in flight.
 * A stale OFF stays false: it is already the fail-closed answer.
 * @param {{ override?: 'on'|'off'|null, now?: () => number }} [deps]
 * @returns {boolean | null}
 */
export function sector73EnabledNow(deps = {}) {
  const override = deps.override !== undefined ? deps.override : sector73BuildOverride();
  if (override) return override === 'on';
  if (!cache) return null;
  const now = deps.now || Date.now;
  if (cache.enabled && now() - cache.at > SWITCH_CACHE_MS) return null;
  return cache.enabled;
}

/**
 * The switch for React. `resolved` is false until the answer is known; `enabled`
 * is false until then (fail closed). Pass `active = false` to skip the read
 * entirely (e.g. for a guest, who never gets Sector 73 anyway) — then it is OFF.
 * @param {boolean} [active]
 * @returns {{ enabled: boolean, resolved: boolean }}
 */
export function useSector73Switch(active = true) {
  const [state, setState] = useState(() => {
    const known = sector73EnabledNow();
    return { enabled: known === true, resolved: known !== null };
  });
  useEffect(() => {
    if (!active) return undefined;
    let alive = true;
    isSector73Enabled().then((enabled) => { if (alive) setState({ enabled, resolved: true }); });
    return () => { alive = false; };
  }, [active]);
  return active ? state : { enabled: false, resolved: true };
}

/**
 * Is Sector 73 switched on? false while the read is in flight, on any failure,
 * and when `active` is false.
 * @param {boolean} [active]
 * @returns {boolean}
 */
export function useSector73Enabled(active = true) {
  return useSector73Switch(active).enabled;
}

/** Badges that belong to Sector 73 — hidden from every list, total and celebration while it is OFF. */
export const SECTOR73_BADGE_IDS = Object.freeze(['lookingGlass']);

/**
 * The badge catalog a player may see: the whole thing when Sector 73 is on, without
 * its badges when it is off.
 * @template {{ id: string }} B
 * @param {B[]} badges
 * @param {boolean} enabled
 * @returns {B[]}
 */
export function sector73BadgeCatalog(badges, enabled) {
  return enabled ? badges : badges.filter((b) => !SECTOR73_BADGE_IDS.includes(b.id));
}

// Test-only: forget the cached switch.
export function __resetSector73SwitchForTests() { cache = null; inflight = null; }

// Test-only: pin the switch (true = on, false = off) as if a read had settled, until reset.
export function __setSector73SwitchForTests(enabled) { cache = { enabled, at: Infinity }; inflight = null; }
