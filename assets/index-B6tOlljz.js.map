import { supabase } from '@/transport';

// "Did a friend invite you?" — the new player names their inviter by username
// (David, 2026-10-20). The server (claim_referral, 20261021020000) enforces
// every rule: new accounts only (created from 25 Oct 2026, within 7 days), one
// inviter ever, not yourself, owner accounts can't be named. This module only
// carries the answer and the copy for each refusal.

// The copy (every refusal, the saved line) lives in ./referralCopy.js with the
// rest of the feature's words; re-exported here for existing callers.
import { REFERRAL_MESSAGES } from './referralCopy';

export { REFERRAL_MESSAGES, referralSavedMessage } from './referralCopy';

/** Usernames as typed: trimmed, one leading @ dropped. Empty → null. */
export function normalizeReferralUsername(raw) {
  const name = String(raw ?? '').trim().replace(/^@/, '').trim();
  return name ? name : null;
}

/**
 * @param {string} rawUsername
 * @returns {Promise<{ok: true, username: string} | {ok: false, reason: keyof typeof REFERRAL_MESSAGES}>}
 */
export async function claimReferral(rawUsername) {
  const name = normalizeReferralUsername(rawUsername);
  if (!name) return { ok: false, reason: 'not_found' };
  try {
    const { data, error } = await supabase.rpc('claim_referral', { p_username: name });
    if (error) return { ok: false, reason: 'network' };
    if (data?.ok === true && typeof data.username === 'string') return { ok: true, username: data.username };
    const reason = data?.reason;
    return { ok: false, reason: reason in REFERRAL_MESSAGES ? reason : 'network' };
  } catch {
    return { ok: false, reason: 'network' };
  }
}

/**
 * This player's referral state, for the profile field.
 * @returns {Promise<{inviter: string|null, canClaim: boolean, claimUntil: string|null} | null>}
 *   null when it could not be read — the field then stays hidden
 */
export async function fetchMyReferral() {
  try {
    const { data, error } = await supabase.rpc('my_referral');
    if (error || !data) return null;
    return {
      inviter: typeof data.inviter === 'string' ? data.inviter : null,
      canClaim: data.can_claim === true,
      claimUntil: typeof data.claim_until === 'string' ? data.claim_until : null,
    };
  } catch {
    return null;
  }
}
