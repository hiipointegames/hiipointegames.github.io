// catchUpAwards — what the player is OWED, worked out from current state rather
// than from a diff.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY A SECOND DERIVATION EXISTS AT ALL
// ─────────────────────────────────────────────────────────────────────────────
// `detectNewAwards` answers "what did THIS solve just earn?" by diffing a
// before/after pair. That question has no answer on Home: there is no solve, so
// there is no pair. The catch-up asks a different question — "what does this
// player HOLD, and which of it have we never mentioned?" — which is a diff
// between live state and the announced-record, not between two moments in time.
//
// This is the same shape `planBadgeAnnouncement` already uses for badges, and
// for the same reason: a record-relative diff is idempotent across reloads,
// whereas a moment-relative diff is lost the instant the moment passes.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE BACKLOG THIS SHIPS INTO — verified, and it is large
// ─────────────────────────────────────────────────────────────────────────────
// The award queue shipped 2026-07-01 (`7ecb775`). The ledger handed to it was
// always null until 2026-09-03 (`ec05049`, docs/bugs.md "Nothing at all was
// announced after a solve"), so for two months NO family fired from a solve.
// Before that, `MilestoneModal` covered STREAK ONLY — so `perfect`, `time` and
// `puzzle` have never once been announced on the Home surface.
//
// So the first run of this record is not a formality. Every existing player is
// owed something, and several are owed a lot.
//
// David ruled it (2026-09-05): ONE SUMMARY SCREEN, then the record is sealed.
// Not silence — the backlog is real and pretending otherwise throws it away.
// Not a full catch-up either — opening the app into three sequential pop-ups for
// things earned months ago is exactly the failure the badge retroactive summary
// was built to prevent. One screen says it, and the Stats page holds the detail.
//
// ─────────────────────────────────────────────────────────────────────────────
// BADGES ARE NOT DERIVED HERE
// ─────────────────────────────────────────────────────────────────────────────
// They already have a record-relative planner that knows about retroactive
// earns, hidden badges, ladder crossings and catalog re-cuts. The caller passes
// its output in as `badgeAwards`; re-deriving them here would be a second,
// worse copy of `planBadgeAnnouncement`.

import {
  STREAK_MILESTONES,
  PERFECT_MILESTONES,
  TIME_MILESTONES,
  PUZZLE_POINTS,
  BATTLE_POINTS,
} from '@/game-mechanics';
import { filterUnannounced, mergeAnnouncedAwards, statsAreFirstRun, markStatsSeeded } from './announcedAwards';

const POINT_TIERS = /** @type {const} */ (['bronze', 'silver', 'gold']);
const POINT_KEYS = /** @type {const} */ (['BRONZE', 'SILVER', 'GOLD']);

/** Which cumulative-point tiers a total has reached. */
function tiersHeld(total, thresholds) {
  const points = Number(total) || 0;
  const held = [];
  POINT_KEYS.forEach((key, i) => {
    if (points >= thresholds[key]) held.push(POINT_TIERS[i]);
  });
  return held;
}

/**
 * Every award of the five STAT families this player currently holds, in the
 * same celebration order `detectNewAwards` emits: streak → puzzle → battle →
 * perfect → time.
 *
 * ⚠️ `points` is REQUIRED for the two medal families and there is no fallback.
 * `puzzle_points` / `battle_points` are server-derived; the client's local count
 * is a mirror. Guessing a total risks claiming a medal the player has not
 * earned, and this project's standing preference is that a missed moment beats a
 * wrong one. A null `points` therefore yields no medals at all — and the caller
 * must not seal a first run on that reading (see `planCatchUp`).
 *
 * ⚠️ TIME REPORTS ONLY THE FASTEST RUNG HELD, mirroring David's 2026-09-03
 * ruling on the live path. A solve beats every rung slower than itself, so a
 * player who has been under a minute holds all ten rungs from 600s down; listing
 * them would be ten awards saying one thing. The fastest rung says all of it,
 * and because it only ever decreases, a genuinely faster solve is still new.
 *
 * @param {{stats?: any, points?: {puzzle?: number, battle?: number}|null}} [args]
 * @returns {Array<{kind: string, value: any, count?: number}>}
 */
export function deriveHeldAwards({ stats = {}, points = null } = {}) {
  const held = stats && typeof stats === 'object' ? stats : {};
  const awards = [];

  // 1) Streak milestones — `reachedMilestones` is a set, so membership IS the
  //    whole record of it. Iterated over the ladder rather than the stored array
  //    so a retired rung in old data cannot produce an award with no artwork.
  const reached = Array.isArray(held.reachedMilestones) ? held.reachedMilestones : [];
  STREAK_MILESTONES.forEach((m) => {
    if (reached.includes(m)) awards.push({ kind: 'streak', value: m });
  });

  // 2 & 3) The two medal ladders, from the authoritative totals only.
  if (points) {
    tiersHeld(points.puzzle, PUZZLE_POINTS).forEach((tier) => awards.push({ kind: 'puzzle', value: tier }));
    tiersHeld(points.battle, BATTLE_POINTS).forEach((tier) => awards.push({ kind: 'battle', value: tier }));
  }

  // 4) Perfect-streak milestones — a COUNT, and the count is the rank, because
  //    this is the one family a player can genuinely reach twice.
  const perfect = held.perfectStreakMilestones || {};
  PERFECT_MILESTONES.forEach((m) => {
    const count = perfect[m] || 0;
    if (count > 0) awards.push({ kind: 'perfect', value: m, count });
  });

  // 5) Speed — the fastest rung ever beaten, and only that one.
  const times = held.timeMilestones || {};
  const beaten = TIME_MILESTONES.filter((t) => (times[t] || 0) > 0);
  if (beaten.length > 0) awards.push({ kind: 'time', value: Math.min(...beaten) });

  return awards;
}

/**
 * Decide what a Home visit should celebrate.
 *
 * @param {Object} [args]
 * @param {any} [args.stats] the player's `game_stats` blob
 * @param {{puzzle?: number, battle?: number}|null} [args.points] authoritative totals
 * @param {Array} [args.badgeAwards] from `planSolveBadgeAwards` — already record-relative
 * @param {Array} [args.eventAwards] catch-up-only families that are neither derived
 *   from `stats` nor from the badge registry (slice 8's podium placements). Ordered
 *   AFTER the medals and BEFORE the registry badges, per the design.
 * @param {Record<string, number>} [args.record] the announced-record
 * @param {boolean} [args.isFirstRun] no record has ever existed
 * @param {boolean} [args.complete] did every source this pass needs actually
 *   resolve? A first run refuses to seal on anything less.
 * @returns {{awards: Array, summaryOnly: boolean, seal: Record<string, number>|null}}
 *   `awards` → the queue to show. `summaryOnly` → collapse it into ONE screen.
 *   `seal` → a record to write once the queue drains; null means "record the
 *   queue itself", the ordinary rule.
 */
export function planCatchUp({
  stats = {}, points = null, badgeAwards = [], eventAwards = [],
  record = {}, isFirstRun = false, complete = true,
} = {}) {
  const stat = deriveHeldAwards({ stats, points });

  // `statsAreFirstRun`, NOT the raw `isFirstRun`. A player holding the legacy
  // `announcedBadges` key — anyone who has ever opened the Stats page — is not a
  // first run by storage, but their stat families have still never been
  // recorded. Reading the raw flag sent exactly those players, the ones with the
  // biggest backlog, down the ordinary path: three award screens plus a summary
  // for milestones earned months ago. See announcedAwards STATS_SEEDED_KEY.
  if (statsAreFirstRun(record, isFirstRun)) {
    // ⚠️ REFUSE TO SEAL ON A PARTIAL READ. Sealing writes a record, and a record
    // means "not a first run" forever after. If the point totals failed to load,
    // the medals would be sealed as announced without ever having been counted —
    // and the NEXT visit, with a working read, would see them as brand new and
    // fire every medal the player has ever earned. Better to do nothing and try
    // again on the next Home visit.
    if (!points || !complete) return { awards: [], summaryOnly: false, seal: null };

    // Badges are deliberately absent from both the queue and the seal: their own
    // first run is the stats page's retroactive summary, which this must not
    // steal. `planSolveBadgeAwards` already returns [] while that is pending.
    //
    // ⚠️ EVENTS ARE SEALED BUT NOT SHOWN, which is the one asymmetry here. The
    // backlog summary exists because the app FAILED to announce achievements it
    // had promised; podium placements were never promised, because the feature
    // did not exist. There is no debt to pay, so the window is sealed quietly
    // and the first placement a player actually sees is their next one. Without
    // the seal, the SECOND visit would announce a week of placements at once.
    return {
      awards: stat,
      summaryOnly: true,
      // Sealed even when nothing is held: a player with no history still needs
      // the record to exist, or every visit stays a first run.
      // `markStatsSeeded` is what closes this branch for good — without it the
      // seal writes award identities but never says "the backlog is done", and a
      // player with nothing held would re-enter the summary path forever.
      seal: markStatsSeeded(mergeAnnouncedAwards(record, [...stat, ...eventAwards])),
    };
  }

  return {
    awards: filterUnannounced([...stat, ...eventAwards, ...badgeAwards], record),
    summaryOnly: false,
    seal: null,
  };
}
