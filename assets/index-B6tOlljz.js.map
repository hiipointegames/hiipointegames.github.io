import { useCallback, useEffect, useRef, useState } from 'react';
import { readSolveOutcomeSources, planSolveBadgeAwards } from './solveCompletion';
import { readAnnouncedAwards, recordAnnouncedAwards, writeAnnouncedAwards } from './announcedAwards';
import { planCatchUp } from './catchUpAwards';
import { collectPodiumAwards } from './podiumCatchUp';
import { todayET } from '@/daily-challenge';

// useHomeCatchUp — R1: anything earned but never announced shows the next time
// the player lands on Home.
//
// ─────────────────────────────────────────────────────────────────────────────
// THERE IS NO HOME PAGE, AND NOTHING RELOCATES
// ─────────────────────────────────────────────────────────────────────────────
// `pages.config.js` sets `mainPage: "Game"`, and `Home.jsx` was deleted in the
// 2026-07-13 nav sweep — `createPageUrlValidity.test.js` now ASSERTS the route
// is invalid. "Home" is the state of `Game.jsx` in which `HomeLauncher` renders
// with nothing mounted over it. So this hook does not move a celebration
// anywhere; it hooks into a state that already exists.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT LIVES IN LAYOUT AND NOT IN Game.jsx
// ─────────────────────────────────────────────────────────────────────────────
// Two reasons, and the second is the real one.
//
//   • `Game.jsx` sits at EXACTLY its arch-ratchet baseline (1005 by the
//     ratchet's `split('\n').length`, which is `wc -l` + 1). It has zero
//     headroom: a grandfathered blob may only shrink. One added line fails the
//     gate.
//   • Layout already holds every input. It owns `user`, it already listens for
//     'homeChromeChanged', and `isHomeChromeVisible` — the pure rule it already
//     calls — is precisely "the Game page's bare launcher, with nothing over
//     it, including Layout's own modals". Recomputing that anywhere else would
//     be a second copy of a seven-input negation that has already been wrong
//     once (David, 2026-07-11).
//
// The caller passes `active`; this hook never reaches for page state itself.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHEN IT RUNS
// ─────────────────────────────────────────────────────────────────────────────
// On the RISING EDGE of `active`, throttled. The rising edge matters: the home
// chrome hides while a celebration is up and returns when it drains, so a solve
// naturally produces one catch-up pass immediately afterwards. That is the pass
// that recovers a settle which arrived too late to join the post-solve queue —
// the case `usePostSolveCelebration.settle` documents as "catching it belongs to
// the catch-up-on-Home path, not here."
//
// The throttle exists because a pass costs four network reads and Home is
// re-entered constantly (every mode switch, every exit from a game). It is
// deliberately NOT "once per mount": a session can last hours.

/** Minimum gap between catch-up passes. Several reads apiece; Home is re-entered a lot. */
export const CATCH_UP_THROTTLE_MS = 60000;

/**
 * @param {Object} [args]
 * @param {{id?: string, game_stats?: any}|null} [args.user] the signed-in player
 * @param {boolean} [args.active] is the bare home launcher the live surface?
 * @param {Object} [deps] injected for tests; production callers pass nothing
 * @returns {{awards: Array, summaryOnly: boolean, isOpen: boolean, busy: boolean, onComplete: () => void}}
 */
export function useHomeCatchUp({ user = null, active = false } = {}, deps = {}) {
  const {
    readSources = readSolveOutcomeSources,
    planBadges = planSolveBadgeAwards,
    readRecord = readAnnouncedAwards,
    readPodiums = collectPodiumAwards,
    today = todayET,
    now = () => Date.now(),
  } = deps;

  // `userId` is WHOSE queue this is. The announced-record is per account
  // (2026-10-18), so the drain must write to the record the pass read from —
  // and a queue planned for one account must never show to the next one.
  const [queue, setQueue] = useState(/** @type {{awards: Array, summaryOnly: boolean, seal: any, userId?: string|null}} */({
    awards: [], summaryOnly: false, seal: null, userId: null,
  }));
  // Read by the activation effect, which must NOT re-run when the queue changes:
  // whether a pass is due is the throttle's decision, not a state transition's.
  // A ref rather than a dep keeps the effect's dependency list honest instead of
  // suppressed, and cannot serve a stale value out of a closure.
  const queueRef = useRef(queue);
  queueRef.current = queue;

  // Everything the effect needs at CALL time. Held in refs so the effect's only
  // dependency is `active` — a dep array carrying `user` would re-fire the whole
  // pass every time Layout re-reads the player.
  const userRef = useRef(user);
  userRef.current = user;
  const lastRunRef = useRef(0);
  const inFlightRef = useRef(false);
  // The same fact as state, for the first-week tips (2026-10-20): a tip must not
  // open while a pass is still reading, or the pass's awards would open on top.
  const [busy, setBusy] = useState(false);
  // Set on unmount so a resolved promise cannot setState into a dead component,
  // and cleared per-pass so a pass is only ever abandoned by an unmount.
  const deadRef = useRef(false);
  useEffect(() => () => { deadRef.current = true; }, []);

  const run = useCallback(async () => {
    const player = userRef.current;
    if (!player?.id || inFlightRef.current) return;
    inFlightRef.current = true;
    setBusy(true);
    try {
      const { points, stateById } = await readSources(player.id);
      if (deadRef.current) return;

      // The seventh family. Catch-up ONLY — a day's podium is not decided until
      // that day closes at ET midnight, so a placement has no post-solve moment
      // to attach to and can only ever arrive here. See podiumCatchUp.
      const podiums = await readPodiums({ userId: player.id, today: today() });
      if (deadRef.current) return;

      // ⚠️ ORDER MATTERS (2026-10-18). `planBadges` may WRITE — on the badge
      // family's first run it seals quietly (badgeFirstRunSeal). The record is
      // therefore read AFTER it: reading first (as this used to) let the stats
      // seal below be built from a stale copy and written over the badge seal,
      // which left the player in a badge first run with no pop-ups (staging
      // repro, 2026-10-18).
      const badgeAwards = stateById ? planBadges(stateById, player.id) : [];
      const { record, isFirstRun } = readRecord(player.id);

      const plan = planCatchUp({
        stats: player.game_stats || {},
        points,
        badgeAwards,
        eventAwards: podiums.awards,
        // A first run must not seal a placement it never managed to check.
        complete: podiums.complete,
        record,
        isFirstRun,
      });

      // A seal with nothing to show is written immediately — there is no queue to
      // drain, and leaving it unwritten would keep the player in a first run
      // forever, so the NEXT visit would announce their entire history.
      if (plan.seal && plan.awards.length === 0) {
        writeAnnouncedAwards(plan.seal, player.id);
        return;
      }
      if (plan.awards.length > 0) setQueue({ ...plan, userId: player.id });
    } catch {
      // Home must render whether or not any of this worked. A failed pass costs
      // the player a catch-up they did not know was pending; a thrown one costs
      // them the screen.
    } finally {
      inFlightRef.current = false;
      if (!deadRef.current) setBusy(false);
    }
  }, [readRecord, readSources, planBadges, readPodiums, today]);

  // Signed out, or into a different account: a held queue belongs to the
  // previous player. Drop it unshown and unrecorded — it is theirs, not this one's.
  const ownerMismatch = queue.awards.length > 0 && queue.userId !== (user?.id ?? null);
  useEffect(() => {
    if (ownerMismatch) setQueue({ awards: [], summaryOnly: false, seal: null, userId: null });
  }, [ownerMismatch]);

  useEffect(() => {
    if (!active || !user?.id) return;
    // Nothing on screen may be replaced: `AwardCelebrationSequence` restarts at
    // screen 1 whenever its `awards` identity changes.
    if (queueRef.current.awards.length > 0) return;
    const at = now();
    if (at - lastRunRef.current < CATCH_UP_THROTTLE_MS && lastRunRef.current !== 0) return;
    lastRunRef.current = at;
    run();
  }, [active, user?.id, run, now]);

  const onComplete = useCallback(() => {
    const { awards, seal, userId } = queue;
    try {
      // A first-run pass writes the SEAL — everything held, including what the
      // one summary screen collapsed — rather than just the queue. Every other
      // pass follows the ordinary rule: whoever drains a queue records that
      // queue. Either way it happens on the drain and never a moment sooner.
      if (seal) writeAnnouncedAwards(seal, userId);
      else recordAnnouncedAwards(awards, userId);
    } catch { /* storage must never trap the player behind a celebration */ }
    setQueue({ awards: [], summaryOnly: false, seal: null, userId: null });
  }, [queue]);

  return {
    awards: queue.awards,
    summaryOnly: queue.summaryOnly,
    // 🔴 GATED ON `active` TOO, not just on having something to show.
    //
    // Seen on the S21 (David, 2026-09-11): award screens painting over the
    // pre-game modals. `active` gated STARTING the pass and nothing gated
    // SHOWING its result, so:
    //
    //   1. player is on Home, `active` true, `run()` starts — three awaits
    //   2. player taps Start Daily; the warning modal opens, homeChromeChanged
    //      fires, `active` goes false
    //   3. `run()` resolves regardless and calls setQueue
    //   4. isOpen flipped true on top of the modal
    //
    // `deadRef` did not catch it: that guards UNMOUNT, and the Layout stays
    // mounted the whole time — only the surface underneath changed.
    //
    // The queue is NOT discarded, deliberately. It stays in state and shows
    // the moment the bare launcher is live again, so a player who starts a
    // Daily mid-pass is not silently robbed of the announcement.
    isOpen: active && queue.awards.length > 0 && !ownerMismatch,
    // A pass is reading right now (its result may open the sequence shortly).
    busy,
    onComplete,
  };
}
