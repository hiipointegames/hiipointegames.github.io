// Paints a card model (./cardModel) onto a 2D canvas.
//
// Everything is drawn with plain canvas calls — no images, no web fonts, no DOM
// capture — so it renders identically on web, iOS and Android, needs no network,
// and ships in an OTA bundle. The look mirrors the app:
//   * background: a still frame of the app's starfield (src/shell/Starfield.css:
//     four nebula glows on #050310, a faint galaxy swirl, three star sizes)
//   * dice: the app's die faces (src/dice-visuals/tokens.js POWER_DIE_FACE)
//
// drawShareCard takes the context as a parameter so tests can hand it a recorder;
// renderShareCard is the thin browser wrapper that makes a real canvas.

export const CARD_WIDTH = 1080;

const FONT = '-apple-system, "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
const MONO = 'ui-monospace, "SF Mono", Menlo, Consolas, "Roboto Mono", monospace';

const C = {
  bg: '#050310',
  ink: '#ece9ff',
  dim: '#a39ec4',
  magenta: '#ff2bd0',
  cyan: '#1ff0ff',
  gold: '#ffcf3a',
  lostBg: '#6d1b3b',
  sq: { blue: '#1e7cf0', red: '#e8344e', green: '#1fbf6c', off: '#1b1830', offLine: '#3a3558' },
};

// tailwind slate-50→slate-300, sky-600→blue-800, rose-600→red-800, emerald-600→green-800
const DIE = {
  white: { a: '#f8fafc', b: '#cbd5e1', pip: '#1e293b' },
  blue: { a: '#0284c7', b: '#1e40af', pip: '#f0f9ff' },
  red: { a: '#e11d48', b: '#991b1b', pip: '#fff1f2' },
  green: { a: '#059669', b: '#166534', pip: '#ecfdf5' },
};

// 3x3 pip grid, row-major.
const PIPS = { 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };

const DIE_SIZE = 118;
const DIE_GAP = 18;
const PAD = 64;

/** Card height for a model (the "faster than" line adds a row). */
export function cardHeight(model) {
  return model.pctLine ? 820 : 760;
}

// A tiny seeded PRNG so every card shows the same sky (and tests are stable).
function seeded(seed) {
  let s = seed;
  return () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

// Elliptical glow: a circular radial gradient drawn under a scale transform.
function glow(ctx, cx, cy, rx, ry, rgba) {
  ctx.save();
  ctx.translate(cx, cy);
  ctx.scale(1, ry / rx);
  const g = ctx.createRadialGradient(0, 0, 0, 0, 0, rx);
  g.addColorStop(0, rgba);
  g.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = g;
  ctx.fillRect(-rx, -rx, rx * 2, rx * 2);
  ctx.restore();
}

function drawStarfield(ctx, w, h) {
  ctx.fillStyle = C.bg;
  ctx.fillRect(0, 0, w, h);
  glow(ctx, w * 0.72, h * 0.10, w * 0.55, h * 0.45, 'rgba(166, 77, 255, 0.30)');
  glow(ctx, w * 0.18, h * 0.28, w * 0.50, h * 0.42, 'rgba(77, 125, 255, 0.24)');
  glow(ctx, w * 0.85, h * 0.60, w * 0.45, h * 0.40, 'rgba(255, 77, 160, 0.16)');
  glow(ctx, w * 0.50, h * 0.96, w * 0.60, h * 0.50, 'rgba(245, 200, 75, 0.12)');
  const rnd = seeded(37);
  // [radius, count] — the app's far / mid / near layers, scaled to the card.
  [[1.2, 150], [2.0, 80], [3.0, 26]].forEach(([r, n]) => {
    for (let i = 0; i < n; i++) {
      ctx.globalAlpha = 0.15 + rnd() * 0.85;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(rnd() * w, rnd() * h, r, 0, Math.PI * 2);
      ctx.fill();
    }
  });
  ctx.globalAlpha = 1;
}

function drawDie(ctx, x, y, die) {
  const face = DIE[die.color] || DIE.white;
  const g = ctx.createLinearGradient(x, y, x + DIE_SIZE, y + DIE_SIZE);
  g.addColorStop(0, face.a);
  g.addColorStop(1, face.b);
  ctx.save();
  ctx.shadowColor = 'rgba(0,0,0,0.45)';
  ctx.shadowBlur = 18;
  ctx.shadowOffsetY = 8;
  roundRect(ctx, x, y, DIE_SIZE, DIE_SIZE, 26);
  ctx.fillStyle = g;
  ctx.fill();
  ctx.restore();

  if (die.hidden) {
    ctx.save();
    ctx.setLineDash([8, 7]);
    ctx.lineWidth = 3;
    ctx.strokeStyle = die.color === 'white' ? 'rgba(30,41,59,0.45)' : 'rgba(255,255,255,0.45)';
    roundRect(ctx, x + 7, y + 7, DIE_SIZE - 14, DIE_SIZE - 14, 20);
    ctx.stroke();
    ctx.restore();
    ctx.fillStyle = face.pip;
    ctx.font = `800 72px ${FONT}`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('?', x + DIE_SIZE / 2, y + DIE_SIZE / 2 + 3);
    return;
  }

  const cell = (DIE_SIZE - 32) / 3;
  ctx.fillStyle = face.pip;
  (PIPS[die.value] || []).forEach((p) => {
    const cx = x + 16 + (p % 3) * cell + cell / 2;
    const cy = y + 16 + Math.floor(p / 3) * cell + cell / 2;
    ctx.beginPath();
    ctx.arc(cx, cy, cell * 0.34, 0, Math.PI * 2);
    ctx.fill();
  });
}

/**
 * Draw the whole card.
 * @param {CanvasRenderingContext2D} ctx
 * @param {ReturnType<import('./cardModel').buildCardModel>} model
 */
export function drawShareCard(ctx, model) {
  const w = CARD_WIDTH;
  const h = cardHeight(model);
  drawStarfield(ctx, w, h);

  // --- top: logo left, title + byline right
  ctx.textBaseline = 'alphabetic';
  ctx.save();
  ctx.shadowColor = 'rgba(255,43,208,0.6)';
  ctx.shadowBlur = 28;
  ctx.fillStyle = C.magenta;
  ctx.font = `800 96px ${FONT}`;
  ctx.textAlign = 'left';
  ctx.fillText('37', PAD, 150);
  ctx.restore();

  ctx.textAlign = 'right';
  ctx.fillStyle = C.ink;
  ctx.font = `800 40px ${FONT}`;
  ctx.fillText(model.title, w - PAD, 112);
  ctx.font = `600 30px ${MONO}`;
  if (model.username) {
    const dateText = `  ·  ${model.dateLabel}`;
    const dateW = ctx.measureText(dateText).width;
    ctx.fillStyle = C.dim;
    ctx.fillText(dateText, w - PAD, 156);
    ctx.fillStyle = C.cyan;
    ctx.fillText(model.username, w - PAD - dateW, 156);
  } else {
    ctx.fillStyle = C.dim;
    ctx.fillText(model.dateLabel, w - PAD, 156);
  }

  // --- dice row, centred
  const rowW = model.dice.length * DIE_SIZE + (model.dice.length - 1) * DIE_GAP;
  const dx = (w - rowW) / 2;
  const dy = 222;
  model.dice.forEach((die, i) => drawDie(ctx, dx + i * (DIE_SIZE + DIE_GAP), dy, die));

  // --- result row: squares · time · badge, measured then centred as one group
  const ry = 470;
  const parts = [];
  if (model.squares) parts.push({ kind: 'squares', w: 3 * 40 + 2 * 12 });
  if (model.time) parts.push({ kind: 'time', w: 0 });
  if (model.badge) parts.push({ kind: 'badge', w: 0 });
  ctx.font = `800 100px ${MONO}`;
  const timeW = model.time ? ctx.measureText(model.time).width : 0;
  ctx.font = `800 34px ${FONT}`;
  const badgeW = model.badge ? ctx.measureText(model.badge).width + 48 : 0;
  parts.forEach((p) => { if (p.kind === 'time') p.w = timeW; if (p.kind === 'badge') p.w = badgeW; });
  const gap = 32;
  const total = parts.reduce((s, p) => s + p.w, 0) + gap * Math.max(0, parts.length - 1);
  let x = (w - total) / 2;
  parts.forEach((p) => {
    if (p.kind === 'squares') {
      ['blue', 'red', 'green'].forEach((c, i) => {
        const sx = x + i * 52;
        roundRect(ctx, sx, ry - 20, 40, 40, 9);
        ctx.fillStyle = model.squares[i] ? C.sq[c] : C.sq.off;
        ctx.fill();
        if (!model.squares[i]) { ctx.lineWidth = 2; ctx.strokeStyle = C.sq.offLine; ctx.stroke(); }
      });
    } else if (p.kind === 'time') {
      ctx.save();
      ctx.shadowColor = 'rgba(31,240,255,0.5)';
      ctx.shadowBlur = 24;
      ctx.fillStyle = C.cyan;
      ctx.font = `800 100px ${MONO}`;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(model.time, x, ry + 4);
      ctx.restore();
    } else {
      roundRect(ctx, x, ry - 32, p.w, 64, 12);
      ctx.fillStyle = model.lost ? C.lostBg : C.gold;
      ctx.fill();
      ctx.fillStyle = model.lost ? '#ffffff' : '#231800';
      ctx.font = `800 34px ${FONT}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(model.badge, x + p.w / 2, ry + 2);
    }
    x += p.w + gap;
  });

  if (model.pctLine) {
    ctx.fillStyle = C.dim;
    ctx.font = `600 32px ${MONO}`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    ctx.fillText(model.pctLine, w / 2, 590);
  }

  // --- foot: a CAPTION band, not a button (a shared picture cannot be tapped)
  const fy = h - 150;
  ctx.fillStyle = 'rgba(5, 3, 16, 0.55)';
  ctx.fillRect(0, fy, w, 150);
  ctx.fillStyle = 'rgba(255, 43, 208, 0.55)';
  ctx.fillRect(0, fy, w, 2);
  ctx.textAlign = 'center';
  ctx.textBaseline = 'alphabetic';
  ctx.fillStyle = C.magenta;
  ctx.font = `700 28px ${MONO}`;
  ctx.fillText(model.footTop, w / 2, fy + 58);
  ctx.fillStyle = C.ink;
  ctx.font = `700 42px ${FONT}`;
  ctx.fillText(model.footBottom, w / 2, fy + 110);
}

/**
 * Render a model to a new canvas element.
 * @returns {HTMLCanvasElement|null} null when the platform has no 2D canvas
 */
export function renderShareCard(model, doc = globalThis.document) {
  if (!doc?.createElement) return null;
  const canvas = doc.createElement('canvas');
  canvas.width = CARD_WIDTH;
  canvas.height = cardHeight(model);
  const ctx = canvas.getContext?.('2d');
  if (!ctx) return null;
  drawShareCard(ctx, model);
  return canvas;
}
