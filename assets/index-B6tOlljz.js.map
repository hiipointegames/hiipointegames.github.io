import { useEffect, useState } from 'react';
import { fetchSector73Unlocked, readCachedUnlock } from './mirror';

/**
 * Has the signed-in player unlocked Sector 73?
 *
 * Starts from the device cache so the home wormhole appears without a flash,
 * then confirms against the player's rows. A failed read keeps the cached
 * answer rather than hiding a portal the player has earned.
 *
 * @param {string | null | undefined} userId
 * @param {unknown} [refreshKey] change it to re-check (e.g. after a Daily submit)
 * @returns {boolean}
 */
export function useSector73Unlocked(userId, refreshKey) {
  // Keyed by account: switching accounts starts from THAT account's cache, never the last one's.
  const [state, setState] = useState(() => ({ userId, unlocked: readCachedUnlock(userId) }));
  const unlocked = state.userId === userId ? state.unlocked : readCachedUnlock(userId);

  useEffect(() => {
    let alive = true;
    // No account (e.g. the switch read is still settling on return from /Sector73): forget the
    // last answer, so the same account coming back starts from the device cache, not a stale false.
    if (!userId) { setState((s) => (s.userId ? { userId: null, unlocked: false } : s)); return undefined; }
    fetchSector73Unlocked(userId)
      .then((value) => { if (alive) setState({ userId, unlocked: value }); })
      .catch(() => { /* keep the cached answer — see header */ });
    return () => { alive = false; };
  }, [userId, refreshKey]);

  return unlocked;
}
