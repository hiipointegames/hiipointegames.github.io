// Does this player see the $37 giveaway at all — and in which form?
//
// David, 2026-10-10: the 18+/US answer decides it, everywhere and consistently.
//
//   'teaser' — guest. Cannot enter without an account; sees "Win $37 every
//              week — create a free account to enter", which opens signup.
//   'full'   — member who answered YES. Every contest surface, as today.
//   'hidden' — member who answered NO. No chip, sheet, drawer links, $37 share
//              lines, eligibility notice, or giveaway half of the 3-Dailies
//              pop-up. "No" still gets the whole game — just no contest.
//   'ask'    — member whose answer we don't trust yet: never answered, or a
//              `false` recorded before the 2026-10-06 fix (until then a SKIPPED
//              question was saved as `false`, indistinguishable from a real No —
//              docs/bugs.md). They get the one-time question (AskOnceQuestion).
//
// Replaces `isContestPromoVisible()`, which returns a constant `true` and which
// three contest surfaces never called (research 2026-10-10, Q9). The platform
// switch that constant carries (NATIVE_ENABLED) is still honoured here, so
// flipping it off hides the contest for everyone in one place.

import { accountTier } from '@/auth';

import {
  CONTEST_ELIGIBILITY_META_KEY,
  hasConfirmedContestEligibility,
  hasDeclinedContestEligibility,
  isContestPromoVisible,
} from './contest';

/**
 * Answers recorded before this instant may be a skip saved as "No". The skip
 * bug was fixed in the 2026-10-06 beta and reached production on 2026-10-08;
 * the cutoff sits two days later so a device that updated late is covered.
 * Re-asking a genuine "No" once costs one tap; trusting a skip costs a player
 * the giveaway for good.
 */
export const CONTEST_REASK_CUTOFF = '2026-10-10T00:00:00.000Z';

/** @param {Record<string, any> | null | undefined} user */
function attestationRecord(user) {
  return user?.[CONTEST_ELIGIBILITY_META_KEY] ?? user?.user_metadata?.[CONTEST_ELIGIBILITY_META_KEY] ?? null;
}

/**
 * Should this member get the one-time 18+/US question?
 *
 * No separate "already asked" marker is needed: answering writes a fresh
 * `confirmed_at`, and a `false` dated after the cutoff is a real No by
 * construction — so it can never ask twice.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {boolean}
 */
export function needsContestReask(user) {
  if (!user || accountTier(user) !== 'member') return false;
  if (hasConfirmedContestEligibility(user)) return false;
  if (!hasDeclinedContestEligibility(user)) return true; // never answered (or junk)
  const at = Date.parse(attestationRecord(user)?.confirmed_at ?? '');
  // An undatable "No" is treated like an old one: ask, rather than guess.
  return !Number.isFinite(at) || at < Date.parse(CONTEST_REASK_CUTOFF);
}

/**
 * @param {Record<string, any> | null | undefined} user
 * @param {{ isNative?: boolean }} [deps] passed through to the platform switch
 * @returns {'teaser' | 'full' | 'hidden' | 'ask'}
 */
export function contestVisibility(user, deps) {
  if (!isContestPromoVisible(deps)) return 'hidden';
  if (accountTier(user) === 'guest') return 'teaser';
  if (hasConfirmedContestEligibility(user)) return 'full';
  if (needsContestReask(user)) return 'ask';
  return 'hidden';
}

/** Shorthand for surfaces that only care whether the real contest shows. */
export function showsFullContest(user, deps) {
  return contestVisibility(user, deps) === 'full';
}
