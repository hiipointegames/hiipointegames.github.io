// The PublicProfile stats codec — the camelCase (in-app game_stats) →
// snake_case (the profiles.stats JSON column) field map.
//
// This map is the contract between the writer (syncPublicProfile) and every
// reader of a player's public stats. It was welded inline inside
// syncPublicProfile.js, untested, so the two sides could drift silently.
// Pulling it out pins the field list with tests (the interface is the test
// surface) and gives readers one named contract to point at.

// ─────────────────────────────────────────────────────────────────────────────
// C22 — the snapshot had ONE streak, and OtherProfile read it
// ─────────────────────────────────────────────────────────────────────────────
// `daily_challenge_streak`, `daily_challenge_times` and `daily_challenge_solutions`
// are all singular: they were written when a player had one Daily. Q-F rules
// THREE independent streaks, so a snapshot carrying one of them describes a
// third of the player.
//
// The fix is ADDITIVE, and deliberately so. Every existing key keeps its exact
// current meaning — Challenge's Daily — because that is what every already-stored
// snapshot means and what every existing reader (including installed mobile
// builds) expects. A new `per_mode` block carries the other two.
//
// ⚠️ `per_mode` MIRRORS `game_stats.perMode`, WHICH MAY BE ABSENT (seam 3.5).
// W2-BOARDS owns the producer and an old server does not send it. When it is
// missing this writes `null` — NOT an object of zeroes. A zeroed per-mode block
// is indistinguishable from "this player has never solved an Easy Daily", and
// once written it would be read back as fact. `null` says "not measured here",
// which is the truth, and the reader falls back to the legacy fields.
//
// Nothing new is COMPUTED here. This is a codec: it moves numbers the server
// already derived into their stored names. Deriving a per-mode aggregate at
// write time is exactly how stored copies start rotting away from
// daily_challenge_times.

/** The per-mode fields carried into the snapshot, in the shape §3.5 freezes. */
const perModeSnapshot = (perMode) => {
  if (perMode == null || typeof perMode !== 'object') return null;
  /** @type {Record<string, any>} */
  const out = {};
  for (const [key, v] of Object.entries(perMode)) {
    if (v == null || typeof v !== 'object') continue;
    out[key] = {
      solved: v.solved || 0,
      current_streak: v.currentStreak || 0,
      longest_streak: v.longestStreak || 0,
      podium_finishes: v.podiumFinishes || { first: 0, second: 0, third: 0 },
      avg_time: v.avgTime || 0,
      fastest_time: v.fastestTime || 0,
    };
  }
  return Object.keys(out).length > 0 ? out : null;
};

/**
 * Map an in-app `game_stats` object (camelCase) to the snake_case shape stored
 * in the `profiles.stats` JSON column. Missing fields fall back to typed
 * empties so the snapshot shape is always complete.
 *
 * @param {object} [gameStats]
 * @returns {object} the snake_case stats snapshot
 */
export function buildPublicProfileStats(gameStats = {}) {
  const g = gameStats || {};
  return {
    total_solved: g.totalSolved || 0,
    daily_challenge_streak: g.dailyChallengeStreak || 0,
    longest_daily_streak: g.longestDailyChallengeStreak || 0,
    best_streak: g.bestStreak || 0,
    podium_finishes: g.podiumFinishes || { first: 0, second: 0, third: 0 },
    time_milestones: g.timeMilestones || {},
    fastest_time_milestones: g.fastestTimeMilestones || {},
    reached_milestones: g.reachedMilestones || [],
    perfect_streak_milestones: g.perfectStreakMilestones || {},
    // All THREE tiers. This defaulted to `{ easy, challenge }` while every reader
    // — HeadToHeadStats, the solo panels — asks for `expert` too, so a player with
    // no stored soloBlitz got a snapshot whose shape disagreed with its consumers.
    // Harmless today only because the readers use `?.… || 0`; a reader that did
    // not would have read undefined.
    solo_blitz: g.soloBlitz || { easy: {}, challenge: {}, expert: {} },
    daily_challenge_times: g.dailyChallengeTimes || [],
    daily_challenge_solutions: g.dailyChallengeSolutions || [],
    // Additive; `null` when the server sent no perMode. See the header.
    per_mode: perModeSnapshot(g.perMode),
  };
}
