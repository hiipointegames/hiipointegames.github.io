// Calculate battle points from completed head-to-head challenges
// A battle point is awarded for each won blitz battle

export function calculateBattlePoints(userId, completedChallenges) {
  if (!userId || !completedChallenges || !Array.isArray(completedChallenges)) {
    return 0;
  }

  // Count challenges where this user is the winner
  const wins = completedChallenges.filter(challenge =>
    challenge.status === 'completed' &&
    challenge.winner_id === userId
  );

  return wins.length;
}