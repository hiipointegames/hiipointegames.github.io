// badgeTargetForAward — which card on the Badges page a celebrated award is.
//
// A pop-up's "See it in Badges" button (CRISPY 2026-10-18) needs the registry
// badge each award belongs to. Only `kind:'badge'` awards carry a registry id;
// the other families are announced in their own words and have to be mapped:
//
//   badge    → its own `badgeId` (or legacy `value`)
//   podium   → the ladder for that place in that Daily: Easy 2nd → podiumSecondEasy
//   streak / perfect / time / puzzle / battle → the registry badge that family
//              was folded into (badgeRegistry.js "legacy families"). These come
//              from the Challenge Daily's stats blob, hence the Challenge ids.
//
// Unknown input maps to null, and callers fall back to the plain Badges page:
// a stale or new award kind must never dead-end a tap.

import { getBadge } from '@/game-mechanics';
import { badgesUrl, showcaseModeIdForBadge } from '@/components/stats/badgeDeepLink';

/** Legacy stat families → the registry badge they live on. */
const FAMILY_BADGE = Object.freeze({
  streak: 'dailyStreak',
  perfect: 'perfectStreak',
  time: 'speedRecord',
  puzzle: 'puzzlePieceBadge',
  battle: 'battlePointsBadge',
  // The one-time explainers point at the ladder they introduce.
  pieceIntro: 'puzzlePieceBadge',
  battlePointIntro: 'battlePointsBadge',
});

const PLACE = ['First', 'Second', 'Third'];
/** Daily wire key (podium award `mode`) → registry-id suffix. */
const DAILY_SUFFIX = Object.freeze({ daily: '', daily_easy: 'Easy', daily_expert: 'Expert' });

/**
 * @param {Record<string, any> | null | undefined} award
 * @returns {string | null} A registry badge id that exists, or null.
 */
export function badgeIdForAward(award) {
  if (!award || typeof award !== 'object') return null;
  let id = null;
  if (award.kind === 'badge') id = award.badgeId ?? award.value;
  else if (award.kind === 'podium') {
    const place = PLACE[Number(award.rank) - 1];
    const suffix = DAILY_SUFFIX[award.mode ?? 'daily'];
    if (place && suffix !== undefined) id = `podium${place}${suffix}`;
  } else id = FAMILY_BADGE[award.kind] ?? null;
  return typeof id === 'string' && getBadge(id) ? id : null;
}

/**
 * The Badges-page target for a set of awards shown together (one pop-up step).
 * Opens the FIRST mappable award's tab and glows every award on that tab —
 * the page can only show one tab at a time.
 *
 * @param {Array<Record<string, any>>} awards
 * @returns {{ modeId: string | null, badgeIds: string[] }}
 */
export function targetForAwards(awards = []) {
  const ids = [...new Set(awards.map(badgeIdForAward).filter(Boolean))];
  if (ids.length === 0) return { modeId: null, badgeIds: [] };
  const modeId = showcaseModeIdForBadge(/** @type {string} */ (ids[0]));
  return { modeId, badgeIds: ids.filter((id) => showcaseModeIdForBadge(/** @type {string} */ (id)) === modeId) };
}

/**
 * The URL a "See it in Badges" tap goes to for these awards. Guests need no
 * special case here: the soft wall turns any guest arrival at /Badges into the
 * unlock sheet (Layout's page guard), the same one rule as every other link.
 *
 * @param {Array<Record<string, any>>} awards
 * @returns {string}
 */
export function badgesUrlForAwards(awards = []) {
  return badgesUrl(targetForAwards(awards));
}
