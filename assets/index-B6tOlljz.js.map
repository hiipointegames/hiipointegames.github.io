// shell/liveUpdate — Capgo OTA "app is healthy" signal.
//
// Capgo applies a downloaded bundle, then waits for the app to call
// notifyAppReady() within appReadyTimeout (capacitor.config.ts). If we never
// call it — because the new bundle failed to parse, threw on boot, or was just
// too slow to get here — Capgo assumes the update is broken and automatically
// rolls back to the last good bundle. So this call is what makes OTA updates
// safe: a bad deploy self-heals.
//
// CRITICAL: call this AS EARLY AS POSSIBLE — the call site is the top of
// main.jsx, before React mounts and before any network/auth work. It must fire
// after the JS bundle has parsed (so an unparseable bundle still rolls back —
// the protection we actually want) but before the heavy mount path, or a slow
// device blows the rollback window and a HEALTHY bundle gets reverted. See the
// 2026-06-12 bug-log entry (capgo-ota-slow-boot-rollback) for the full trace.
//
// No-op on web and fail-safe: any error is swallowed so a Capgo hiccup can't
// block startup.

import { Capacitor } from '@capacitor/core';
import { CapacitorUpdater } from '@capgo/capacitor-updater';

/**
 * Tell Capgo the current bundle booted successfully. Call once, as early as
 * possible after the bundle has loaded. No-op on web.
 */
export async function notifyLiveUpdateReady() {
  if (!Capacitor.isNativePlatform()) return;
  // Boot telemetry: ms from webview navigation start to the moment we signal
  // Capgo. This is the number that races appReadyTimeout (a 30s floor applies on
  // a bundle's first boot after an OTA), so it tells us how much headroom a real
  // device has. Logged → Sentry breadcrumb. Filter logcat for "[capgo]".
  const tReady =
    typeof performance !== 'undefined' && performance.now ? Math.round(performance.now()) : null;
  if (tReady !== null) {
    console.log(`[capgo] notifyAppReady invoked at ${tReady}ms since nav start`);
  }
  try {
    await CapacitorUpdater.notifyAppReady();
  } catch (e) {
    console.error('Capgo notifyAppReady failed:', e);
  }
}
