// tierReachedDate — the day a badge reached its CURRENT tier (2026-10-18).
//
// `earliestDate` is the day of the FIRST qualifying event. For a ladder that is
// the wrong date to judge a tier by: a player whose first Easy solve was in
// August and whose 10th was today crossed "Getting the Hang of It" tier 1 TODAY,
// but `earliestDate` says August. `planBadgeAnnouncement` used `earliestDate`
// to decide "earned before launch → history, not news", so that first earn was
// filed as retroactive and never popped (docs/bugs.md 2026-10-18; David: "date
// by tier reached").
//
// These helpers answer the right question from per-event days. Pure; no
// registry knowledge — the caller hands in the rung to judge against.
//
// CONSERVATIVE ON MISSING DATES. If an event that could matter has no day, the
// answer is unknowable and these return null; callers then fall back to
// `earliestDate` (the old behaviour), so a gap in the data can never turn an old
// earn into a fresh pop.

/**
 * A count ladder's tier is reached on the day of its Nth qualifying event.
 *
 * @param {Array<string|null|undefined>} days one entry per qualifying event
 * @param {number} threshold the rung's count (N)
 * @returns {string|null} YYYY-MM-DD, or null when unknowable / not reached
 */
export function countTierReachedDate(days, threshold) {
  if (!Array.isArray(days) || !Number.isInteger(threshold) || threshold < 1) return null;
  if (days.length < threshold) return null;
  // An undated event could sit anywhere in the order, so the Nth day is unknowable.
  if (days.some((day) => !day)) return null;
  const sorted = /** @type {string[]} */ ([...days]).sort();
  return sorted[threshold - 1];
}

/**
 * A threshold ladder's tier is reached on the first day an event met that rung.
 *
 * @param {Array<{day?: string|null, value?: number|null}>} events
 * @param {(value: number) => boolean} meets does this value reach the current rung?
 * @returns {string|null} YYYY-MM-DD, or null when unknowable / not reached
 */
export function thresholdTierReachedDate(events, meets) {
  if (!Array.isArray(events) || typeof meets !== 'function') return null;
  let first = null;
  for (const event of events) {
    const value = event?.value;
    if (typeof value !== 'number' || !Number.isFinite(value) || !meets(value)) continue;
    if (!event.day) return null; // an undated qualifier could have been the first
    if (first === null || event.day < first) first = event.day;
  }
  return first;
}
