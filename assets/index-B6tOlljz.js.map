// Haptics — short, precise vibration taps synced to moments (David, 2026-10-05; plugin
// installed 2026-10-10 to ship with that weekend's store resubmit).
//
// The vibration engine is native code (@capacitor/haptics). Over-the-air updates cannot add
// native code, so on store builds from before the plugin this is a silent no-op: the plugin's
// JavaScript is imported normally (safe everywhere), but it is only CALLED when
// `Capacitor.isPluginAvailable('Haptics')` says the native side exists — the same pattern
// src/share-card/dispatchShare.js uses for Share + Filesystem. On the web it is a no-op too
// (parity decision: no browser counterpart; nothing is lost without vibration).

import { Capacitor } from '@capacitor/core';
import { Haptics, ImpactStyle, NotificationType } from '@capacitor/haptics';
import { reportedFallback } from '@/observability';

/**
 * What each kind maps to in the Haptics plugin API.
 * @type {Readonly<Record<string, { method: string, args?: object }>>}
 */
export const HAPTIC_KINDS = Object.freeze({
  select: { method: 'selectionChanged' },
  light: { method: 'impact', args: { style: ImpactStyle.Light } },
  medium: { method: 'impact', args: { style: ImpactStyle.Medium } },
  heavy: { method: 'impact', args: { style: ImpactStyle.Heavy } },
  success: { method: 'notification', args: { type: NotificationType.Success } },
  warning: { method: 'notification', args: { type: NotificationType.Warning } },
  error: { method: 'notification', args: { type: NotificationType.Error } },
});

let enabled = true;
/** Player setting (Settings toggle, later): turn vibration off entirely. */
export const setHapticsEnabled = (on) => { enabled = Boolean(on); };

/**
 * Fire one haptic. Returns true if a native vibration was requested.
 * @param {keyof typeof HAPTIC_KINDS} kind
 * @param {{ cap?: any, plugin?: any }} [deps]  injectable for tests
 */
export function haptic(kind, deps = {}) {
  const cap = deps.cap ?? Capacitor;
  const plugin = deps.plugin ?? Haptics;
  const spec = HAPTIC_KINDS[kind];
  if (!enabled || !spec) return false;
  try {
    if (!cap?.isNativePlatform?.() || !cap?.isPluginAvailable?.('Haptics')) return false;
    if (typeof plugin?.[spec.method] !== 'function') return false;
    // A failing vibration is reported (no silent catches — src/observability), never thrown.
    Promise.resolve(plugin[spec.method](spec.args)).catch(reportedFallback('sector73.haptics'));
    return true;
  } catch {
    return false; // vibration is decoration; never break play
  }
}
