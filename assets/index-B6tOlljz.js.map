// What happens when a share is REFUSED, and how we hear about it.
//
// 2026-10-04, Sentry 37-THE-MATH-PUZZLE-2V: an iPhone on the 1.0.314 store build
// (no native Share plugin) running the 1.0.320 OTA tapped Share and got nothing.
// WebKit opens one share sheet per tap. If the browser refuses the picture
// share, every follow-up in the same tap (text share, clipboard) is refused too.
// Before this module only that last refusal reached Sentry.
//
// Two fixes, one place:
//   reportShareFailure — every failed share step becomes ONE event in ONE Sentry
//     issue ("ShareFailure: Share failed"), tagged with the step. Its event and
//     user counts are the iPhone share-failure rate, which should fall to zero
//     once players are on a store build with the native plugin (1.0.319+). The
//     store build itself is already on every event (Sentry's dist/app_version).
//   showCopyFallback — instead of a second share attempt that can't succeed, a
//     small "Copy your result" button. Its tap is a NEW user activation, so the
//     clipboard write is allowed.

import { captureError, track, recordOutcome } from '@/observability';

/**
 * How a share ended: one step on the error trail AND one row in the outcome
 * counts (client_events), so both the story and the rate are recorded.
 * @param {string} outcome native | web-files | cancelled | refused | unsupported | text-shared | copied | failed
 * @param {'card'|'text'|'clipboard'|'copy-button'} route
 * @param {object} [deps] test seams: track, record
 */
export function shareOutcome(outcome, route, deps = {}) {
  (deps.track || track)('share', { outcome, route });
  (deps.record || recordOutcome)('share', outcome, { route });
}

/** Fixed name + message so every failure groups into one Sentry issue. */
export class ShareFailure extends Error {
  constructor() {
    super('Share failed');
    this.name = 'ShareFailure';
  }
}

/**
 * @param {object} p
 * @param {'native'|'web-files'|'web-text'|'clipboard'|'copy-button'} p.step which attempt failed
 * @param {unknown} [p.error] what the platform threw
 * @param {object} [deps] test seam: capture
 */
export function reportShareFailure({ step, error }, deps = {}) {
  const e = /** @type {any} */ (error);
  (deps.capture || captureError)(new ShareFailure(), {
    step,
    errorName: e?.name ?? null,
    errorMessage: e?.message ? String(e.message).slice(0, 200) : null,
  });
}

const FALLBACK_ID = 'share-copy-fallback';

/**
 * Show a "Copy your result" button for the text a refused share would have sent.
 * One at a time; it removes itself after a while or once used.
 * @param {string} text
 * @param {object} [deps] test seams: clipboard, report, timeoutMs
 * @returns {HTMLElement} the panel (for tests)
 */
export function showCopyFallback(text, deps = {}) {
  document.getElementById(FALLBACK_ID)?.remove();
  const clipboard = deps.clipboard || globalThis.navigator?.clipboard;
  const report = deps.report || reportShareFailure;
  const outcome = deps.outcome || shareOutcome;

  const panel = document.createElement('div');
  panel.id = FALLBACK_ID;
  panel.setAttribute('role', 'dialog');
  panel.setAttribute('aria-label', 'Copy your result');
  panel.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;'
    + 'background:#111827;color:#fff;border:1px solid #8b5cf6;border-radius:14px;padding:14px 16px;'
    + 'width:min(92vw,360px);box-shadow:0 10px 30px rgba(0,0,0,.5);font-family:inherit;';

  const note = document.createElement('div');
  note.textContent = "Sharing didn't open. Copy your result and paste it anywhere.";
  note.style.cssText = 'font-size:14px;line-height:1.35;margin-bottom:10px;';

  const row = document.createElement('div');
  row.style.cssText = 'display:flex;gap:8px;';

  const copy = document.createElement('button');
  copy.type = 'button';
  copy.textContent = 'Copy your result';
  copy.style.cssText = 'flex:1;background:#8b5cf6;color:#fff;border:0;border-radius:10px;padding:10px;font-weight:700;font-size:15px;';

  const close = document.createElement('button');
  close.type = 'button';
  close.textContent = 'Close';
  close.setAttribute('aria-label', 'Close');
  close.style.cssText = 'background:transparent;color:#cbd5e1;border:1px solid #475569;border-radius:10px;padding:10px 12px;font-size:14px;';

  let timer = null;
  const dismiss = () => { clearTimeout(timer); panel.remove(); };
  close.addEventListener('click', dismiss);
  copy.addEventListener('click', async () => {
    try {
      await clipboard.writeText(text);
      outcome('copied', 'copy-button');
      note.textContent = 'Copied! Paste it into a message.';
      copy.remove();
      setTimeout(dismiss, 2000);
    } catch (err) {
      // Last resort: put the text on screen so it can be selected by hand.
      report({ step: 'copy-button', error: err });
      outcome('failed', 'copy-button');
      clearTimeout(timer); // stay up while they select it; Close still works
      note.textContent = 'Press and hold to copy:';
      const box = document.createElement('textarea');
      box.readOnly = true;
      box.value = text;
      box.style.cssText = 'width:100%;height:96px;margin-bottom:8px;border-radius:8px;padding:8px;font-size:13px;color:#111;';
      row.before(box);
      copy.remove();
    }
  });

  row.append(copy, close);
  panel.append(note, row);
  document.body.appendChild(panel);
  timer = setTimeout(dismiss, deps.timeoutMs ?? 15000);
  return panel;
}
