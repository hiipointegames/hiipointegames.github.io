// When does a form save write the 18+/US answer? Only when there IS an answer,
// and only when it differs from the one already recorded.
//
// Two bugs, one line (both fixed 2026-10-05, logged in docs/bugs.md):
//
//   1. A SKIP WAS SAVED AS "NO". CreateAccountForm wrote
//      buildContestEligibilityAttestation(eligibleAnswer) on every submit, and
//      that coerces null to false — so a player who left the optional question
//      blank was recorded as having DECLINED: marked "not eligible" and never
//      offered the opt-in again. The form's own comment said a skip "stays
//      unanswered". Now a skip writes nothing and the player stays "not asked".
//
//   2. EVERY SAVE RE-STAMPED confirmed_at. Editing anything (country, email)
//      re-wrote an unchanged "Yes" with a fresh timestamp. Entries are not
//      retroactive (only Dailies finished after confirmed_at count), so the
//      player's Dailies from earlier that day dropped out of the nightly pool
//      save and their in-app weekly count shrank. An unchanged answer now keeps
//      its original time.

import { CONTEST_ELIGIBILITY_META_KEY, buildContestEligibilityAttestation } from './contest';

/**
 * The metadata to merge into a form save for the eligibility answer.
 *
 * @param {boolean | null | undefined} answer  what the form holds now
 * @param {Record<string, any> | null | undefined} user  a FRESH read of the account
 * @param {Date} [now] injectable for tests
 * @returns {Record<string, {confirmed_18_us: boolean, confirmed_at: string}>}
 *   `{}` when there is nothing to write, else `{ contest_eligibility: … }`
 */
export function contestAttestationPatch(answer, user, now = new Date()) {
  if (typeof answer !== 'boolean') return {};
  const record = user?.user_metadata?.[CONTEST_ELIGIBILITY_META_KEY]
    ?? user?.[CONTEST_ELIGIBILITY_META_KEY];
  if (record?.confirmed_18_us === answer) return {};
  return { [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(answer, now) };
}
