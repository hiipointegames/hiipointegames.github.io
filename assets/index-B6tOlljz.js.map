// Web-only service worker registration.
//
// WHY this is its own module (not inline in main.jsx): the registration has two
// hard gates that must be testable in isolation —
//   1. NEVER register on native (Capacitor). Native update delivery is CapGo
//      OTA; a service worker there would be a second, conflicting update channel
//      caching the WebView's assets. Web only.
//   2. NEVER register in dev. The Vite dev server has its own HMR; a SW caching
//      module requests fights it. Production builds only.
//
// The SW itself (public/sw.js) is network-first, so it can't serve a stale
// deploy — see that file's header. This module just decides WHETHER to register.

import { Capacitor } from '@capacitor/core';

/**
 * Register the network-first service worker, web + production only.
 * Safe to call unconditionally from boot — it self-gates and swallows errors
 * (a failed SW registration must never block the app from rendering).
 *
 * @returns {boolean} true if registration was attempted, false if gated out.
 */
export function registerServiceWorker() {
  // Native: CapGo owns updates. Never run a SW inside the Capacitor WebView.
  if (Capacitor.isNativePlatform()) return false;

  // No SW support (older browsers, some embedded webviews): nothing to do.
  if (typeof navigator === 'undefined' || !('serviceWorker' in navigator)) {
    return false;
  }

  // Dev: skip so the SW cache doesn't shadow Vite HMR. import.meta.env.PROD is
  // true only in a real `vite build` bundle.
  if (!import.meta.env || !import.meta.env.PROD) return false;

  // Fire-and-forget; a registration failure is non-fatal to the app.
  navigator.serviceWorker.register('/sw.js').catch((err) => {
    console.warn('service worker registration failed:', err);
  });
  return true;
}
