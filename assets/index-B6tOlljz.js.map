// Account credential status — single source of truth for "is this a secured
// account or an anonymous guest?".
//
// Background: the app starts every visitor as a Supabase anonymous user
// (auth `user.is_anonymous === true`, empty `user.email`). A guest can pick a
// display username while still anonymous — that does NOT secure the account.
// An account becomes credentialed once a password is attached (server-side
// claim or Signup), at which point Supabase sets `is_anonymous === false`.
//
// We key off `is_anonymous` rather than inspecting `user.email`: a guest has no
// auth email at all, and the only emails ever attached are either real (Signup)
// or synthetic placeholders used purely as Supabase login plumbing — neither
// reliably indicates credential status the way `is_anonymous` does.
//
// Replaces an earlier guard that tested `user.email.includes('@anonymous.')` —
// a substring the codebase never produces (the synthetic email is
// `…@anon.local`, and it is written to `profiles.email`, never to the auth
// user's `email`). See docs/bugs.md.

// Synthetic login emails we attach internally; never a sign of a "real" email.
const SYNTHETIC_EMAIL_RE = /@(anon\.local|themathpuzzle37\.local)$/i;

/**
 * True when the account has a real credential (password) attached and can sign
 * in across devices — i.e. it is no longer an anonymous guest.
 */
export function isCredentialedAccount(user) {
  if (!user) return false;
  // Primary signal: Supabase clears is_anonymous when a credential is attached.
  if (user.is_anonymous === false) return true;
  // Fallback for accounts whose is_anonymous flag was not flipped but which
  // carry a real (non-synthetic) email — e.g. legacy client-side conversions.
  return Boolean(user.email) && !SYNTHETIC_EMAIL_RE.test(user.email);
}

/**
 * True when the account is an anonymous guest with no real credential — the
 * cohort prompted to secure their account ("Save Stats").
 */
export function isGuest(user) {
  return !isCredentialedAccount(user);
}

/**
 * True when the account has deliberately chosen a username — it owns a public
 * `profiles` row and (usually) game history worth displaying, even while it is
 * still an unsecured guest.
 *
 * This is ORTHOGONAL to credential status: a "named account" can still be a
 * guest (`isGuest(user) === true && isNamedAccount(user) === true`). It exists
 * because `is_anonymous` alone cannot tell a legacy username-only player (who
 * has stats to show) apart from a brand-new visitor (who has nothing). The
 * distinguishing field is `has_custom_username`, which `apiClient.auth.me()`
 * promotes from `user_metadata` to the top level. The rest of the app already
 * keys "is this a real, linkable player?" off the same field (leaderboards).
 */
export function isNamedAccount(user) {
  return Boolean(user?.has_custom_username);
}

/**
 * True when the account carries an email a HUMAN could actually be reached at.
 *
 * Distinct from {@link isCredentialedAccount} on purpose, and the difference is
 * not academic: `CreateAccountForm` treats the email field as OPTIONAL and
 * substitutes a synthetic `@anon.local` / `@themathpuzzle37.local` address when
 * it is left blank, purely as Supabase login plumbing. So an account can be
 * fully credentialed — real username, real password, signs in across devices —
 * and still have nowhere to send anything.
 *
 * Measured on prod 2026-09-05: 18 of the 36 credentialed accounts were in
 * exactly that state. That cohort cannot be told they are ineligible for the
 * $37 giveaway, cannot be paid if they win, and cannot reset their own password
 * — and cannot be emailed about any of it, by definition.
 */
/**
 * Has this player PROVEN the address is theirs?
 *
 * ⚠️ DELIBERATELY NOT PART OF ELIGIBILITY, and that is the whole design. If an
 * unconfirmed address stopped entries counting, every player who adds one and
 * never clicks the link becomes silently ineligible with nothing telling them
 * why — one quiet permanent harm to everybody, traded against one loud harm to
 * one winner a week. So this drives a VISIBLE STATUS and a resend button, and
 * touches `meetsContestEligibility` nowhere.
 *
 * It matters because the prize is paid by email: the rules give a winner two
 * emails and four weeks before the prize is forfeited. A typo costs someone $37
 * and there is no way to fix it after the fact — but it is fixable BEFORE, which
 * is what this is for.
 *
 * ⚠️ RETURNS TRUE WHEN THERE IS NOTHING TO CONFIRM. A synthetic address is not
 * a real one, so "unconfirmed" would be a nag about an address the player never
 * chose. Ask `hasContactableEmail` first if you care about that case.
 *
 * ⚠️ AND IT IS INERT WHILE SUPABASE'S "Confirm email" SETTING IS OFF: with
 * confirmations disabled Supabase stamps `email_confirmed_at` itself, so this
 * reads true for everyone and no status ever shows. That is intended — the code
 * can ship before the setting is flipped, and the setting can be flipped (on
 * staging first) without another release.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {boolean}
 */
export function isEmailConfirmed(user) {
  if (!user) return false;
  if (!hasContactableEmail(user)) return true;
  return Boolean(user.email_confirmed_at || user.confirmed_at);
}

export function hasContactableEmail(user) {
  const email = user?.email;
  if (!email || typeof email !== 'string') return false;
  return !SYNTHETIC_EMAIL_RE.test(email);
}
