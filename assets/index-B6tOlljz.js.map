// Screen shake — the "trauma" model (Squirrel Eiserloh, GDC 2016; animation playbook §2.7).
//
// Moments ADD trauma (0..1); trauma decays linearly; the visible shake is trauma² × a smooth
// noise, so small bumps stay subtle and big hits feel big. Phone strength is about half of
// desktop guidance. Wrong answers shake only the wrong element — never the screen.

export const MAX_OFFSET_PX = 9;
export const MAX_ROTATE_DEG = 1.6;
export const DECAY_PER_SECOND = 1.6;

/** Smooth deterministic noise in [-1, 1] (sum of sines; no randomness, so tests are exact). */
export const smoothNoise = (t, seed) =>
  (Math.sin(t * 23.1 + seed * 1.7) * 0.5 + Math.sin(t * 41.7 + seed * 3.1) * 0.3 + Math.sin(t * 67.3 + seed * 5.3) * 0.2);

export function createShake({ maxOffset = MAX_OFFSET_PX, maxRotate = MAX_ROTATE_DEG, decay = DECAY_PER_SECOND } = {}) {
  let trauma = 0;
  return {
    /** Add trauma (clamped to 1). */
    add(amount) { trauma = Math.min(1, trauma + Math.max(0, amount)); },
    get trauma() { return trauma; },
    /** Advance `dt` seconds and return the offset to apply at time `t`. */
    step(t, dt) {
      trauma = Math.max(0, trauma - decay * dt);
      const k = trauma * trauma;
      return {
        x: maxOffset * k * smoothNoise(t, 1),
        y: maxOffset * k * smoothNoise(t, 2),
        rotate: maxRotate * k * smoothNoise(t, 3),
        active: trauma > 0,
      };
    },
    reset() { trauma = 0; },
  };
}
