/**
 * The whole catalog, in showcase order: craft → on-ramp → dojo → battle → solo
 * → cross-arena → the folded-in existing systems. (Round 2 § D3 removed the
 * `firsts` block that used to sit between dojo and battle; its badges now live
 * in the blocks for the modes they are earned in.)
 * @type {Badge[]}
 */
export const BADGES = assignBadgeIdentities([
  ...CRAFT_BADGES,
  ...ON_RAMP_BADGES,
  ...DOJO_BADGES,
  ...BLITZ_BATTLE_BADGES,
  ...SOLO_BLITZ_BADGES,
  ...CROSS_ARENA_BADGES,
  ...EXISTING_BADGES,
]);

// ---------------------------------------------------------------------------
// Selectors — pure lookups over the catalog. No detection, no state.
// ---------------------------------------------------------------------------

/** @type {Map<string, Badge>} */
const BY_ID = new Map(BADGES.map((b) => [b.id, b]));

/**
 * One badge by its unique registry id.
 * @param {string} id
 * @returns {Badge | null}
 */
export function getBadge(id) {
  return BY_ID.get(id) ?? null;
}

/**
 * Every badge for a mode tab (`daily`, `challenge`, `easy`, `soloBlitz`,
 * `blitzBattle`, `crossArena`, `any`). Exact match — `any` is its own bucket,
 * not a wildcard. Round 2 § D3 emptied that bucket (every one-time shield now
 * declares the mode it is earned in), but the exact-match contract stands for
 * whatever lands there next.
 * @param {BadgeMode} mode
 * @returns {Badge[]}
 */
export function getBadgesByMode(mode) {
  return BADGES.filter((b) => b.mode === mode);
}

/**
 * Every badge in a showcase category sub-section.
 * @param {BadgeCategory} category
 * @returns {Badge[]}
 */
export function getBadgesByCategory(category) {
  return BADGES.filter((b) => b.category === category);
}

/**
 * Every entry sharing a canonical detection key — for craft feats this is the
 * Daily + Challenge pair; for single-mode badges it's a one-element array.
 * @param {string} featId
 * @returns {Badge[]}
 */
export function getBadgesByFeat(featId) {
  return BADGES.filter((b) => b.featId === featId);
}

/**
 * The single entry for a (feat, mode) pair — the lookup Lanes B/D need to turn
 * a derived feat result into the right collectible.
 * @param {string} featId
 * @param {BadgeMode} mode
 * @returns {Badge | null}
 */
export function getBadgeForFeat(featId, mode) {
  return BADGES.find((b) => b.featId === featId && b.mode === mode) ?? null;
}

/**
 * Catalog minus the hidden badges the player hasn't earned yet. Hidden badges
 * stay silhouetted until the earn pop-up reveals them (§9.4).
 * @param {Iterable<string>} [earnedIds]
 * @returns {Badge[]}
 */
export function getVisibleBadges(earnedIds = []) {
  const earned = new Set(earnedIds);
  return BADGES.filter((b) => !b.hidden || earned.has(b.id));
}

/**
 * How many tiers a badge has. One-time badges count as a single tier.
 * @param {Badge | null | undefined} badge
 * @returns {number}
 */
export function badgeTierCount(badge) {
  if (!badge) return 0;
  if (badge.scaling.type === 'oneTime') return 1;
  return badge.scaling.tiers?.length ?? 0;
}

/**
 * The tier list a badge should be judged against. Battle-length-scaled badges
 * (Meteor Shower) resolve to the row for `durationSeconds`, falling back to the
 * baseline row for an unknown/absent duration.
 * @param {Badge | null | undefined} badge
 * @param {number} [durationSeconds]
 * @returns {number[]}
 */
export function badgeTiers(badge, durationSeconds) {
  if (!badge || badge.scaling.type === 'oneTime') return [];
  const perDuration = badge.scaling.perDuration;
  if (perDuration && durationSeconds != null && perDuration[durationSeconds]) {
    return perDuration[durationSeconds];
  }
  return badge.scaling.tiers ?? [];
}

/**
 * Highest 0-based tier a value has reached, or -1 for "not yet earned".
 * Descending ladders (solve times) treat LOWER as better. One-time badges
 * return 0 for any truthy/positive value.
 * @param {Badge | null | undefined} badge
 * @param {number} value
 * @param {number} [durationSeconds]
 * @returns {number}
 */
export function badgeTierIndex(badge, value, durationSeconds) {
  if (!badge || !Number.isFinite(value)) return -1;
  if (badge.scaling.type === 'oneTime') return value > 0 ? 0 : -1;

  const tiers = badgeTiers(badge, durationSeconds);
  const descending = badge.scaling.direction === 'descending';
  let reached = -1;
  for (let i = 0; i < tiers.length; i++) {
    if (descending ? value <= tiers[i] : value >= tiers[i]) reached = i;
  }
  return reached;
}

/**
 * The next threshold to chase, or null when the ladder is maxed out. Feeds the
 * showcase's `120 / 125` progress bars.
 * @param {Badge | null | undefined} badge
 * @param {number} value
 * @param {number} [durationSeconds]
 * @returns {number | null}
 */
export function nextTierTarget(badge, value, durationSeconds) {
  if (!badge || badge.scaling.type === 'oneTime') return null;
  const tiers = badgeTiers(badge, durationSeconds);
  const next = badgeTierIndex(badge, value, durationSeconds) + 1;
  return next < tiers.length ? tiers[next] : null;
}
