// Hand the card picture + message to the device's share sheet.
//
// Three routes, tried in order:
//   1. NATIVE (iOS/Android app): write the PNG to the app cache with
//      @capacitor/filesystem, then @capacitor/share with the file AND the text.
//      Only when BOTH plugins are actually present in the running native build:
//      an OTA bundle can reach an older store build that predates them, and
//      calling a missing plugin throws. isPluginAvailable is the guard.
//   2. WEB SHARE WITH FILES (mobile browsers): navigator.share({ files, text }).
//   3. Nothing that can carry a picture → returns 'unsupported' and the caller
//      falls back to its text-only share / clipboard copy, so no player is ever
//      left with a dead Share button.
//
// WEB PARITY (CLAUDE.md "Web ↔ native parity"): @capacitor/share and
// @capacitor/filesystem are native-only; route 2 is their web counterpart and
// route 3 is today's behaviour, unchanged.
//
// A cancelled share sheet is not an error: both the plugin and the browser reject
// when the player backs out, and that must not fall through to a clipboard copy.

import { Capacitor } from '@capacitor/core';
import { Share } from '@capacitor/share';
import { Filesystem, Directory } from '@capacitor/filesystem';

const FILE_NAME = '37-daily-share.png';

/** True when the player dismissed the share sheet. */
export function isCancel(err) {
  const msg = String(err?.message || err || '').toLowerCase();
  return err?.name === 'AbortError' || msg.includes('cancel') || msg.includes('abort');
}

/** The native Share plugin is compiled into THIS build (text needs no Filesystem). */
export function nativeTextShareAvailable(cap = Capacitor) {
  return !!(cap.isNativePlatform?.() && cap.isPluginAvailable?.('Share'));
}

/** Both native plugins are compiled into THIS build. */
export function nativeShareAvailable(cap = Capacitor) {
  return !!(cap.isNativePlatform?.() && cap.isPluginAvailable?.('Share') && cap.isPluginAvailable?.('Filesystem'));
}

function canvasToBlob(canvas) {
  return new Promise((resolve) => {
    if (!canvas?.toBlob) { resolve(null); return; }
    canvas.toBlob((b) => resolve(b), 'image/png');
  });
}

/**
 * The card as a File for navigator.share, or null where files can't be shared.
 * Made AHEAD of the tap (see prepareDailyResult): toBlob is async, and a browser
 * only opens a share sheet while the tap's user activation is still live.
 */
export async function cardFile(canvas, deps = {}) {
  const FileCtor = deps.File || globalThis.File;
  if (!canvas || !FileCtor) return null;
  const blob = await canvasToBlob(canvas);
  return blob ? new FileCtor([blob], FILE_NAME, { type: 'image/png' }) : null;
}

/**
 * @param {object} p
 * @param {HTMLCanvasElement|null} p.canvas the rendered card (null → no picture)
 * @param {string} p.text the message
 * @param {File|null} [p.file] the card already converted by cardFile(). With it,
 *   navigator.share is reached with NO await before it, which is what keeps it
 *   inside the tap's user activation on iOS/Safari.
 * @param {{ Capacitor?: any, Share?: any, Filesystem?: any, navigator?: any, File?: any,
 *   onFailure?: (f: {step: 'native'|'web-files', error: unknown}) => void }} [deps]
 *   platform objects are injectable for tests. `onFailure` is told about every
 *   non-cancel failure, so the caller can report it. Without
 *   this, a refused picture share left no trace: only the LAST fallback's
 *   failure reached Sentry (37-THE-MATH-PUZZLE-2V).
 * @returns {Promise<'native'|'web-files'|'cancelled'|'refused'|'unsupported'>}
 *   'refused' = the browser REJECTED the picture share. Unlike 'unsupported',
 *   the caller must NOT try another share: WebKit lets one tap open one share
 *   sheet, so a second navigator.share is refused too. Offer a fresh tap
 *   instead (game-flow showCopyFallback).
 */
export async function dispatchShare({ canvas, text, file: preparedFile = null }, deps = {}) {
  const cap = deps.Capacitor || Capacitor;
  const share = deps.Share || Share;
  const fs = deps.Filesystem || Filesystem;
  const nav = deps.navigator || globalThis.navigator;
  const FileCtor = deps.File || globalThis.File;
  const onFailure = deps.onFailure || (() => {});

  if (canvas && nativeShareAvailable(cap)) {
    try {
      const data = canvas.toDataURL('image/png').split(',')[1];
      const { uri } = await fs.writeFile({ path: FILE_NAME, data, directory: Directory.Cache });
      await share.share({ text, files: [uri], dialogTitle: 'Share your 37' });
      return 'native';
    } catch (err) {
      if (isCancel(err)) return 'cancelled';
      // The native plugin doesn't consume the browser's user activation, so the
      // web routes below are still worth trying.
      onFailure({ step: 'native', error: err });
    }
  }

  if (canvas && nav?.share && nav?.canShare && FileCtor) {
    const file = preparedFile || await cardFile(canvas, { File: FileCtor });
    if (file && nav.canShare({ files: [file] })) {
      try {
        await nav.share({ files: [file], text });
        return 'web-files';
      } catch (err) {
        if (isCancel(err)) return 'cancelled';
        onFailure({ step: 'web-files', error: err });
        return 'refused';
      }
    }
  }

  return 'unsupported';
}

/**
 * Share the message as TEXT, with no picture attached: the card reaches the
 * friend as the link's preview instead (David, 2026-10-04; shareCardUpload.js).
 *
 * Same order and rules as dispatchShare:
 *   1. NATIVE: @capacitor/share with the text. This is the fix for Android,
 *      whose WebView has no navigator.share: without it a text share fell to a
 *      silent clipboard copy instead of the share sheet.
 *   2. WEB: navigator.share({ text }), reached with no await first.
 *   3. Neither → 'unsupported', and the caller copies the text.
 *
 * @param {{ text: string }} p
 * @param {{ Capacitor?: any, Share?: any, navigator?: any,
 *   onFailure?: (f: {step: 'native-text'|'web-text', error: unknown}) => void }} [deps]
 * @returns {Promise<'native-text'|'web-text'|'cancelled'|'refused'|'unsupported'>}
 */
export async function dispatchTextShare({ text }, deps = {}) {
  const cap = deps.Capacitor || Capacitor;
  const share = deps.Share || Share;
  const nav = deps.navigator || globalThis.navigator;
  const onFailure = deps.onFailure || (() => {});

  if (nativeTextShareAvailable(cap)) {
    try {
      await share.share({ text, dialogTitle: 'Share your 37' });
      return 'native-text';
    } catch (err) {
      if (isCancel(err)) return 'cancelled';
      onFailure({ step: 'native-text', error: err });
    }
  }

  if (nav?.share) {
    try {
      await nav.share({ text });
      return 'web-text';
    } catch (err) {
      if (isCancel(err)) return 'cancelled';
      onFailure({ step: 'web-text', error: err });
      return 'refused';
    }
  }

  return 'unsupported';
}
