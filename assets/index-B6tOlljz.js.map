// craftRowSelectors — WHICH ROWS BELONG TO WHICH TIER.
//
// Extracted from ./craftBadgeDerivation.js on 2026-09-04, when the three-mode
// split pushed that file past the 800-line structural cap. The split is along a
// real seam rather than an arbitrary line count: everything here answers one
// question — given a raw `daily_challenge_times` or `practice_solves` read,
// which rows feed which tier's badges — and nothing here derives anything.
//
// ⚠️ THESE FUNCTIONS ARE A SAFETY GUARD, NOT A CONVENIENCE. An Easy row is
// all-white (no power dice), so replaying it into Challenge's catalog would fire
// every craft feat that does not read `diceColors` — Straight Line,
// Constellation, Full Spectrum's low rungs — for free, retroactively, with a
// celebration for a badge nobody earned. Route each tier to its own badges;
// never widen one tier's filter to "fix" a tier that earns nothing.

/**
 * @typedef {import('./craftBadgeDerivation').SolveRow} SolveRow
 */

/**
 * The POWER-DICE half of a practice_solves read — the craft catalog's practice
 * source and the Dojo's volume source.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS IS A SET AND NOT `row.mode === 'challenge'`
 * ---------------------------------------------------------------------------
 * David's ruling (2026-09-03): "a separate badge section for each mode's daily,
 * and then an overall practice badge section that contains badges for all 3."
 * Practice is unlimited and untimed, so three parallel practice ladders would be
 * noise — one combined Practice section is the answer.
 *
 * Until this change `expert` matched NO selector at all. Expert practice was one
 * of three mode cells earning literally zero badges (the other two are
 * `daily_easy` and `daily_expert`, dropped by `selectChallengeDailyRows` below),
 * and that hole is the data-side shape of the complaint the ruling answers: a
 * player could grind Expert free-play forever and the badge screen would never
 * move.
 *
 * `easy` is deliberately NOT in this set even though it is a practice mode. Easy
 * has NO power dice (`POWER_DICE_MODES` in src/dice/dice.js is
 * challenge/daily/expert/daily_expert), so an Easy row is all-white — and every
 * craft feat that does not read `diceColors` (Straight Line, Constellation,
 * Full Spectrum's low rungs) would fire off it for free. Easy practice keeps its
 * own vocabulary, the On-Ramp track, which is tuned for colourless dice; the
 * combined Practice SECTION shows both sets side by side, which is arrangement
 * (Lane G) rather than derivation.
 *
 * SAFE DIRECTION. Adding a mode only ever ADDS qualifying rows, so no player can
 * lose a badge to this. Newly-discovered earns from pre-existing Expert history
 * route into the ONE retroactive summary rather than a queue of pops, because
 * every craft entry already carries `availableFrom: CRAFT_MERGE_DATE`
 * (game-mechanics/craftFeats.js) which `retroactiveCutoff` reads.
 *
 * @param {unknown} rows
 * @returns {SolveRow[]}
 */
export function selectPracticeSolves(rows) {
  if (!Array.isArray(rows)) return [];
  return rows.filter((row) => !!row && PRACTICE_POWER_DICE_MODES.has(row.mode));
}

/**
 * ONE practice tier's rows.
 *
 * ⚠️ THIS REPLACED `selectPracticeSolves` AS THE DERIVATION'S INPUT, AND THAT IS
 * A DEFECT FIX. Merging Challenge and Expert practice into one badge set meant
 * an EXPERT solve was judged against CHALLENGE's rungs — and because Expert
 * guarantees `perfect`, every family's `<shape> && perfect` top rung fired on
 * the same solve as its opening rung. One Expert practice solve maxed 7 of the 8
 * Challenge craft badges, measured against the shipped `highestStageReached`.
 * Expert now has its own entries with only the perfect rung, laddered by
 * repetition, so there is nothing left to collapse.
 *
 * @param {unknown} rows
 * @param {'easy'|'challenge'|'expert'} wireMode
 * @returns {SolveRow[]}
 */
export function selectPracticeTier(rows, wireMode) {
  if (!Array.isArray(rows)) return [];
  return rows.filter((row) => !!row && row.mode === wireMode);
}

/**
 * The practice wire keys whose dice carry power colours — the ones a craft feat
 * is reachable in. Mirrors `POWER_DICE_MODES` in src/dice/dice.js minus the two
 * Daily keys, and is pinned against it by a test so the two cannot drift.
 */
const PRACTICE_POWER_DICE_MODES = new Set(['challenge', 'expert']);

/**
 * The challenge-only half of a practice_solves read.
 *
 * SUPERSEDED as the derivation's input by `selectPracticeSolves` above — kept
 * on the public surface because it is the honest answer to "which rows are
 * Challenge free-play?", which the Dojo's pre-ruling criteria text described and
 * which a caller wanting one mode still legitimately asks.
 *
 * @param {unknown} rows
 * @returns {SolveRow[]}
 */
export function selectChallengeSolves(rows) {
  if (!Array.isArray(rows)) return [];
  return rows.filter((row) => !!row && row.mode === 'challenge');
}

/**
 * The easy-mode half of a practice_solves read — the On-Ramp's source. No craft
 * feat is reachable in Easy (there are no power dice), so these rows feed the
 * On-Ramp volume/first-time badges and `firstSolve` only.
 *
 * @param {unknown} rows
 * @returns {SolveRow[]}
 */
export function selectEasySolves(rows) {
  if (!Array.isArray(rows)) return [];
  return rows.filter((row) => !!row && row.mode === 'easy');
}

/**
 * The Challenge-Daily half of a daily_challenge_times read — E1 / ruling Q-C.
 *
 * That table holds all three Dailies once the rollout starts, but this catalog's
 * `'daily'` source means CHALLENGE's Daily and nothing else (modeKeys.js). Un-
 * filtered, the first `daily_easy` row replays Easy/Expert solves into it: every
 * feat that does not need power dice fires off an all-white Easy row. Badges are
 * DERIVED, never stored, so that lands instantly and retroactively — and
 * badgeAnnouncements.js pops a celebration for a badge nobody earned.
 *
 * Q-C ruled "change no badge criteria", which takes a CHANGE, not the absence of
 * one: the filter must exist before the first Easy row does. Filtering here, not
 * in the query, keeps the fetch shape identical and the intent greppable.
 * `?? 'daily'` — rows predating the column are all Challenge Dailies.
 *
 * @param {unknown} rows
 * @returns {SolveRow[]}
 */
export function selectChallengeDailyRows(rows) {
  return selectDailyRows(rows, 'daily');
}

/**
 * ROUTE a `daily_challenge_times` read to ONE Daily tier (2026-09-04).
 *
 * `selectChallengeDailyRows` used to be the whole story and it DROPPED the other
 * two tiers: `daily_easy` and `daily_expert` rows matched nothing, so the Easy
 * and Expert Dailies earned literally no badges. That was the data-side shape of
 * "make them daily mode independent for craft".
 *
 * The original filter was defensively RIGHT and its guard is preserved: an Easy
 * row is all-white, so replaying it into Challenge's catalog would fire every
 * craft feat that does not read `diceColors` — Straight Line, Constellation,
 * Full Spectrum's low rungs — for free, retroactively, with a celebration for a
 * badge nobody earned. The fix is to ROUTE each tier to its own badges, never to
 * widen one tier's filter.
 *
 * `?? 'daily'` — rows predating the column are all Challenge Dailies.
 *
 * @param {unknown} rows
 * @param {'daily_easy'|'daily'|'daily_expert'} wireMode
 * @returns {SolveRow[]}
 */
export function selectDailyRows(rows, wireMode) {
  if (!Array.isArray(rows)) return [];
  return rows.filter((row) => !!row && (row.mode ?? 'daily') === wireMode);
}
