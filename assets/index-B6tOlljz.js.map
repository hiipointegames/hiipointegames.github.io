import React from 'react';
import { operatorInputController } from '@/components/utils/OperatorInputController';
import { playSound } from '@/ui/feedback';
import { OPERATOR_COLORS } from '@/dice-visuals';

// This pad's per-operator gradient is the CANONICAL operator palette (shared via
// OPERATOR_COLORS); the How-To-Play operator pad adopts the same colors.
const mainOperators = [
  { symbol: '+', display: '+', color: OPERATOR_COLORS['+'] },
  { symbol: '-', display: '−', color: OPERATOR_COLORS['-'] },
  { symbol: '*', display: '×', color: OPERATOR_COLORS['*'] },
  { symbol: '/', display: '÷', color: OPERATOR_COLORS['/'] },
  { symbol: '^', display: '^', color: OPERATOR_COLORS['^'] },
];

const parentheses = [
  { symbol: '(', display: '(', color: OPERATOR_COLORS['('] },
  { symbol: ')', display: ')', color: OPERATOR_COLORS[')'] },
];

export default function OperatorPad({ onOperatorClick, disabled, mode }) {
  // Logic removed for single-row enforcement as per user request

  const handleClick = (symbol, e) => {
    if (disabled) return;
    e.preventDefault();
    e.stopPropagation();
    playSound('buttonTap');
    const eventType = e.pointerType === 'touch' ? 'touch' : 'mouse';
    operatorInputController.handleOperatorPress(symbol, eventType);
  };

  const OperatorButton = ({ symbol, display, color }) => (
    <button
      key={symbol}
      onPointerDown={(e) => {
        handleClick(symbol, e);
      }}
      className={`
        relative flex-1 rounded-xl font-black text-xl sm:text-lg text-slate-100
        bg-gradient-to-br ${color}
        ${disabled ? 'opacity-50 cursor-not-allowed' : ''}
        transition-all duration-300
        touch-manipulation h-10 sm:h-9
        shadow-[0_4px_12px_rgba(0,0,0,0.3),0_2px_4px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(255,255,255,0.3)]
        active:shadow-[inset_0_2px_8px_rgba(0,0,0,0.3)]
        active:scale-95
        before:absolute before:inset-0 before:rounded-xl before:bg-gradient-to-b before:from-white/20 before:to-transparent before:opacity-40 before:pointer-events-none
        flex items-center justify-center
      `}
      style={{ WebkitTapHighlightColor: 'transparent' }}
    >
      {display}
    </button>
  );

  return (
    <div className="w-full px-2 py-1">
      <div className="flex justify-between gap-1.5 sm:gap-2">
        {[...mainOperators, ...parentheses].map((op) => (
          <OperatorButton key={op.symbol} {...op} />
        ))}
      </div>
    </div>
  );
}