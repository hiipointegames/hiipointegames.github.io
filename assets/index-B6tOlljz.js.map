import { supabase } from './supabaseClient';

// daily_challenge_times is world-readable (public leaderboard), but it carries a
// denormalized `user_email` PII column the frontend never needs — the canonical
// email lives on auth.users. To guarantee no player's email is ever shipped to
// any browser (defense-in-depth alongside the eventual, David-gated column drop),
// the DailyChallengeTime client selects this explicit display-column allowlist
// and never `select('*')`. Every column here is public-by-design leaderboard data.
//
// IMPORTANT — this list is pinned to PROD's ACTUAL columns (verified live against
// the prod table on 2026-07-14): PostgREST 400s the whole read if ANY listed
// column is missing (error 42703). Prod does NOT have the base44-era `usedDiceIds`
// / `diceData` columns — those exist only in staging (schema drift). Selecting
// them 400'd every leaderboard read. Do not add a column here without confirming
// it exists in prod. See .workshop/W4-MED-user-email-protection-plan-2026-07-13.md.
//
// `mode` (added 2026-08-25, P3): WHICH Daily the row belongs to — see
// src/game-modes/modeKeys.js. Public-by-design like every other column here: it
// names the board, not the answer.
//
// It was held back until prod actually had the column, because adding it early
// 42703s every leaderboard read for every live player. CONFIRMED PRESENT ON PROD
// before this line shipped, by direct query against the prod ref (not inferred
// from staging, where the migration landed first): a control column that does
// not exist returned 42703 in the same probe, so an OK on `mode` is evidence the
// column is really there rather than evidence the probe cannot tell.
export const DAILY_TIME_PUBLIC_COLUMNS =
    'id,created_at,date,mode,user_id,user_name,user_country,solve_time_seconds,equation,usedDiceIndices,diceColors,shuffledDice,has_custom_username';

// profiles is world-readable (public social layer: username/country/points/stats
// are public-by-design), but on prod it still carries a real `email` column
// (the drop migration 20260624050000 is written but NOT yet applied to prod —
// see .workshop/overnight-hardening-2026-07-14.md §0). No client feature reads a
// profile row's email, so this client selects an explicit email-free allowlist
// and never `select('*')`, so our app never transmits any player's email.
// NOTE: this is defense-in-depth only — RLS still permits a direct read of the
// column, so the DB-level fix (apply the drop migration) is still required.
// Pinned to prod's actual profiles columns minus email.
export const PROFILE_PUBLIC_COLUMNS =
    'id,username,country,stats,created_at,puzzle_points,battle_points';

// Helper to create a Supabase wrapper exposing a small CRUD-like surface.
// `columns` scopes which columns every read/returning-write selects; defaults to
// '*' so existing entities are unchanged. Pass an explicit allowlist to keep a
// sensitive column (e.g. user_email) from ever reaching the client.
//
// NOTE the `@type {'*'}` on `columns`: at runtime it holds the real column-list
// string, but we type it as the literal '*' so supabase-js keeps inferring the
// row shape (a plain `string` makes `.select()` return GenericStringError and
// poisons every consumer's types). Type-only — no runtime effect.
/**
 * Comparison operators `filter` will forward to PostgREST. Deliberately small:
 * every entry is one somebody needed, and an allowlist is what stops
 * `query[op]` from reaching the rest of the query builder.
 */
const FILTER_OPERATORS = new Set(['eq', 'neq', 'lt', 'lte', 'gt', 'gte', 'in', 'is']);

const createEntityClient = (tableName, /** @type {'*'} */ columns = '*') => {
    return {
        // .filter({ field: value }, { order, limit })
        //
        // A bare value is an equality match, which is what almost every caller
        // wants and the only thing this supported for its first two years.
        //
        // A plain OBJECT value is an operator match: `{ date: { lt: today } }`.
        // Added 2026-09-09 for the stale-attempt lookback, which has to ask for
        // "before today, most recent first, at most a few" — a question equality
        // cannot express. The alternative was fetching every attempt the player
        // has ever made and filtering in the browser, which grows without bound
        // for exactly the players who have been here longest.
        //
        // ARRAYS AND null STAY EQUALITY. `.eq(key, [1,2])` and `.eq(key, null)`
        // are what callers already pass and mean; treating either as an operator
        // bag would silently change existing reads.
        filter: async (
            filters,
            /** @type {{ order?: { field: string, ascending?: boolean }, limit?: number }} */
            { order, limit } = {},
        ) => {
            let query = supabase.from(tableName).select(columns);

            Object.entries(filters).forEach(([key, value]) => {
                const isOperatorBag = value !== null
                    && typeof value === 'object'
                    && !Array.isArray(value);

                if (!isOperatorBag) {
                    query = query.eq(key, value);
                    return;
                }

                Object.entries(value).forEach(([op, operand]) => {
                    // ALLOWLISTED, not looked up dynamically. `query[op]` with an
                    // attacker- or typo-supplied key would happily call anything
                    // on the builder — `delete()` included — and a typo would
                    // fail as "not a function" at runtime rather than here.
                    if (!FILTER_OPERATORS.has(op)) {
                        throw new Error(`Unsupported filter operator '${op}' on ${tableName}.${key}`);
                    }
                    query = query[op](key, operand);
                });
            });

            if (order) {
                query = query.order(order.field, { ascending: order.ascending !== false });
            }
            if (limit) query = query.limit(limit);

            const { data, error } = await query;
            if (error) throw error;
            return data;
        },

        // .create(data)
        create: async (data) => {
            const { data: created, error } = await supabase
                .from(tableName)
                .insert(data)
                .select(columns)
                .single();

            if (error) throw error;
            return created;
        },

        // .update(id, data)
        update: async (id, data) => {
            const { data: updated, error } = await supabase
                .from(tableName)
                .update(data)
                .eq('id', id)
                .select(columns)
                .single();

            if (error) throw error;
            return updated;
        },

        // .upsert(data, onConflict)
        upsert: async (data, onConflict = 'id') => {
            const { data: upserted, error } = await supabase
                .from(tableName)
                .upsert(data, { onConflict })
                .select(columns)
                .single();

            if (error) throw error;
            return upserted;
        },

        // .list(sortStr, limit)
        // sortStr example: '-created_date' (desc), 'created_date' (asc)
        list: async (sortStr, limit) => {
            let query = supabase.from(tableName).select(columns);

            if (sortStr) {
                const isDesc = sortStr.startsWith('-');
                const field = isDesc ? sortStr.substring(1) : sortStr;
                // Map created_date to created_at if needed, or assume column compatibility
                // The standard usually defaults to created_at in Supabase
                const dbField = field === 'created_date' ? 'created_at' : field;
                query = query.order(dbField, { ascending: !isDesc });
            }

            if (limit) {
                query = query.limit(limit);
            }

            const { data, error } = await query;
            if (error) throw error;
            return data;
        },

        // .delete(id)
        delete: async (id) => {
            const { error } = await supabase
                .from(tableName)
                .delete()
                .eq('id', id);

            if (error) throw error;
            return { success: true };
        },

        // .get(id)
        get: async (id) => {
            const { data, error } = await supabase
                .from(tableName)
                .select(columns)
                .eq('id', id)
                .maybeSingle(); // Use maybeSingle to avoid 406/PGRST116 error on not found

            if (error) throw error;
            return data;
        }
    };
};

export const DailyChallenge = createEntityClient('daily_challenges');
export const DailyChallengeTime = createEntityClient('daily_challenge_times', /** @type {'*'} */ (DAILY_TIME_PUBLIC_COLUMNS));
export const DailyChallengeAttempt = createEntityClient('daily_challenge_attempts');

// The SAME table, read for one question only: how many distinct players started
// a given Daily. One column, deliberately.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY A SECOND, NARROWER CLIENT RATHER THAN REUSING THE ONE ABOVE
// ─────────────────────────────────────────────────────────────────────────────
// `DailyChallengeAttempt` selects '*', which is right for its callers — they
// read `forfeited`, `daily_status`, `created_at` for ONE player's own row. The
// participation line on the leaderboard asks a different question: it wants
// EVERY row for a date, and it needs exactly one field from each.
//
// Through the wide client that is a whole-table-row-per-player read on every
// board view, and it drags `created_at` with it — the referee's clock, the
// authoritative start time the anti-cheat gate measures every solve against.
// There is no exploit in reading it (RLS permits the select, and the server
// still computes elapsed itself), but shipping every player's start time to
// every viewer to render a percentage is more than the feature needs, and
// "more than the feature needs" is how read surfaces grow.
//
// One uuid per starter instead of a full row. The caller dedupes.
export const DailyAttemptParticipant = createEntityClient(
    'daily_challenge_attempts',
    /** @type {'*'} */ ('user_id'),
);
export const PracticeSolve = createEntityClient('practice_solves');
// Append-only per-run Blitz event log (Badge Redesign Round 2 § D6). INSERT-only
// for clients by RLS — the update/delete methods on this wrapper will be refused
// by the database, which is the intent: an event log has to be immutable to be
// worth deriving badges from.
export const BlitzRun = createEntityClient('blitz_runs');
export const PublicProfile = createEntityClient('profiles', /** @type {'*'} */ (PROFILE_PUBLIC_COLUMNS));
export const FriendConnection = createEntityClient('friend_connections');
export const HeadToHeadChallenge = createEntityClient('head_to_head_challenges');

// Export Query and User aliases if used elsewhere
export const Query = {
    // Mock implementations if Query is used for raw SQL
    // or redirect to supabase rpc
};

export const User = {
