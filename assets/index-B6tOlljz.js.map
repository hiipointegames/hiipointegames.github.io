// badgeEarnedStamps — "when did this tier pop?", for the "Just earned" row.
//
// "Just earned" ranks by `earliestDate`, which the derivations can only supply
// for badges with dated events. Count ladders — podium medals, daily streaks,
// perfect streaks, speed records — carry no date BY CONSTRUCTION (the server
// returns counts), so they could never appear there, even the day you won them
// (CRISPY 2026-10-18; David: podiums are badges and must count).
//
// The honest date we DO have is the day the player was shown the badge: the
// moment its pop-up drained. This stores that, per registry badge id, with the
// tier it was shown at — so a stamp only counts while the badge is still at
// that tier (a stale stamp can't promote an old earn).
//
// PER ACCOUNT (2026-10-18): stored under `badgeEarnedStamps.v1:<userId>`, beside
// the announced-record it rides with, for the same reason — one account's pops
// must never date another account's badges. The old device-wide key is ignored.
// No user id reads as no stamps and writes nothing.
//
// ACCEPTED LIMITS (approved design): device-local — a new phone starts with no
// stamps. Own stats only: another player's page must never read this device's
// stamps. A server-side earned-at date was out of scope.
//
// Only `kind:'badge'` awards are stamped: they carry the registry id and tier.
// A podium PLACEMENT is not a new tier; when a placement does lift a ladder, the
// same queue carries that ladder as a `badge` award.

import { todayET } from '@/daily-challenge';

/** Key PREFIX; the real key is `earnedStampsKey(userId)`. The bare prefix is the ignored pre-2026-10-18 key. */
export const EARNED_STAMPS_KEY = 'badgeEarnedStamps.v1';

/**
 * @param {string|null|undefined} userId
 * @returns {string|null} this account's stamps key, or null without an account
 */
export function earnedStampsKey(userId) {
  return typeof userId === 'string' && userId ? `${EARNED_STAMPS_KEY}:${userId}` : null;
}

/**
 * @typedef {{ tier: number, date: string }} EarnedStamp
 */

/**
 * @param {string|null|undefined} userId whose stamps
 * @returns {Record<string, EarnedStamp>} Never throws; storage trouble reads as no stamps.
 */
export function readEarnedStamps(userId) {
  const key = earnedStampsKey(userId);
  if (!key) return {};
  try {
    const parsed = JSON.parse(localStorage.getItem(key) || '{}');
    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
  } catch {
    return {};
  }
}

/**
 * Stamp the badge awards a drained queue showed. Never throws.
 *
 * @param {Array<Record<string, any>>|null|undefined} awards
 * @param {string|null|undefined} userId whose stamps — none means nothing is written
 * @param {string} [date] ET day, defaults to today.
 * @returns {boolean} true when something was written.
 */
export function stampEarnedBadges(awards, userId, date = todayET()) {
  const key = earnedStampsKey(userId);
  if (!key || !Array.isArray(awards)) return false;
  const fresh = awards.filter((a) => a?.kind === 'badge'
    && typeof (a.badgeId ?? a.value) === 'string'
    && Number.isFinite(a.tier) && a.tier >= 0);
  if (fresh.length === 0) return false;
  try {
    const stamps = readEarnedStamps(userId);
    for (const a of fresh) stamps[a.badgeId ?? a.value] = { tier: a.tier, date };
    localStorage.setItem(key, JSON.stringify(stamps));
    return true;
  } catch {
    return false;
  }
}
