// Outcome counts for key player flows, written to the insert-only
// public.client_events table (supabase/migrations/20261004000000_client_events.sql).
//
// Sentry sees failures. This sees EVERY outcome, so a rate can be computed:
// "of iPhone shares on store build 1.0.314 this week, how many failed?". The
// share fix (2026-10-04) should drive that number toward zero as players move
// to the 1.0.319 store build. This is how we'll know.
//
// Rules:
//   * Fire-and-forget. A share or a login never waits on this, and it never throws.
//   * Detail is run through track's allow-list (mode/outcome/step/reason/route/code...),
//     so nothing identifying can be written by accident.
//   * Only the three flows the table accepts. Anything else is dropped client-side.

import { Capacitor } from '@capacitor/core';
import { App } from '@capacitor/app';
import { supabase } from '@/transport';
import { safeData } from './track';

// 'three_dailies' added 2026-10-05 (pop-up shown / opt_in / dismissed / joined);
// the table CHECK was widened in migration 20261005000000 to match.
// 'interstitial' added 2026-10-10 (the ad freeze alarm: shown / dismissed /
// failed_to_show / stale_open, src/shell/adFreezeAlarm.js); migration 20261010000000.
// 'review_prompt' added 2026-10-20 (the store review card: requested / skipped /
// failed, src/shell/reviewPrompt.js); migration 20261020130000.
// 'feature_tip' (first-week tips: shown / go / dismiss, detail { tip }), 'email_code'
// (giveaway email check: sent / verified / failed, detail { step, reason }; never the
// address) and 'referral' (ok | <refusal reason>, detail { step }) added 2026-10-20;
// the CHECK allowing them is migration 20261021040000 (applied with the launch).
export const CLIENT_EVENTS = Object.freeze(['share', 'daily_submit', 'sign_in', 'three_dailies', 'interstitial', 'review_prompt', 'feature_tip', 'email_code', 'referral']);

let nativeBuildPromise = null;

/** The installed STORE build ('1.0.314'), or null on web. Cached. */
export function nativeBuild(deps = {}) {
  const cap = deps.Capacitor || Capacitor;
  if (!cap.isNativePlatform?.()) return Promise.resolve(null);
  if (!nativeBuildPromise || deps.App) {
    nativeBuildPromise = (deps.App || App).getInfo()
      .then((info) => (info?.version ? String(info.version).slice(0, 32) : null))
      .catch(() => null); // telemetry: no store build is fine, never throw
  }
  return nativeBuildPromise;
}

function appVersion() {
  return typeof __APP_VERSION__ === 'string' ? __APP_VERSION__.slice(0, 32) : null;
}

/**
 * Record how one flow ended. Never awaited by callers, never throws.
 * @param {'share'|'daily_submit'|'sign_in'|'three_dailies'|'interstitial'|'review_prompt'|'feature_tip'|'email_code'|'referral'} event
 * @param {string} outcome e.g. 'native', 'refused', 'saved', 'failed', 'ok'
 * @param {object} [detail] allow-listed keys only (see track.js SAFE_KEYS)
 * @param {object} [deps] test seams: client, Capacitor, App
 * @returns {Promise<void>}
 */
export async function recordOutcome(event, outcome, detail, deps = {}) {
  try {
    if (!CLIENT_EVENTS.includes(event) || !outcome) return;
    // Never from unit tests (no stray network calls), and never from a plain
    // `npm run dev`, which talks to the PRODUCTION database and would pollute
    // real counts. `--mode staging` writes to staging, as it should.
    const mode = import.meta.env?.MODE;
    if (!deps.client && (mode === 'test' || mode === 'development')) return;
    const cap = deps.Capacitor || Capacitor;
    const platform = cap.getPlatform?.() || 'web';
    const row = {
      event,
      outcome: String(outcome).slice(0, 32),
      platform: ['ios', 'android', 'web'].includes(platform) ? platform : 'web',
      native_build: await nativeBuild(deps),
      app_version: appVersion(),
      detail: detail ? safeData(detail) : null,
    };
    // No .select(): the table is insert-only for clients, so asking for the
    // row back would be refused.
    await (deps.client || supabase).from('client_events').insert(row);
  } catch {
    // Telemetry must never break the game.
  }
}

// Test-only reset for the cached native build.
export function __resetClientEventsForTests() { nativeBuildPromise = null; }
