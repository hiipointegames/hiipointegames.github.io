import { supabase } from '@/transport';

// This week's referral bonus entries for the signed-in player
// (contest_my_week_bonus(), 20261021030000_contest_referral_bonus.sql): 2 per
// friend whose Daily earned an entry this week, capped by the server.

/**
 * @returns {Promise<number>} 0 when there is none OR it could not be read —
 *   the entries line then simply shows no bonus (never a guess)
 */
export async function fetchMyWeekBonus() {
  try {
    const { data, error } = await supabase.rpc('contest_my_week_bonus');
    if (error) return 0;
    const n = Number(data);
    return Number.isInteger(n) && n > 0 ? n : 0;
  } catch {
    return 0;
  }
}
