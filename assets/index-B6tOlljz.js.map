// shell/splashWatchdog — the last line of defence against a dead launch screen.
//
// WHY THIS EXISTS
// ───────────────
// capacitor.config.ts sets `launchAutoHide: false`, which means the native
// splash NEVER goes away on its own — it is dismissed only when JS calls
// SplashScreen.hide(). That call lives in two places (IntroVideoScreen's mount
// effect and App.jsx's fetchUser effect), and BOTH are downstream of React
// mounting successfully.
//
// So every one of these leaves the user staring at a static, untappable branded
// image forever, with no way out but force-quitting:
//   • the JS bundle fails to parse or eval
//   • App throws during its first render (it reads sessionStorage at render time)
//   • a provider higher up the tree throws, so the error boundary renders its
//     fallback UNDERNEATH the splash — the user never sees "Something went wrong"
//   • SplashScreen.hide() itself never settles
//
// On 2026-09-23 App Review rejected 1.0.314 under Guideline 2.1(a) with
// "We couldn't access the app because it launched on an unresponsive screen"
// (iPad Air 11-inch M4, iPadOS 27.0). A permanently-parked splash is exactly
// what that describes.
//
// This module removes the whole class of failure: a timer armed at the JS entry
// point, before React is involved at all, that hides the splash no matter what
// happens afterwards. Worst case the user sees the app's own loading spinner a
// little early — which is always better than a screen that does nothing.
//
// Belt AND braces: capacitor.config.ts now also sets `launchAutoHide: true`, so
// the OS enforces a ceiling even if this JS never runs (a bundle that fails to
// parse). This module still matters because it is OTA-updatable and the native
// config is not.
//
// See:
//   docs/architecture/subsystems.md  (#13 — shell)
//   docs/bugs.md  (2026-09-23 — iPad launch screen entry)

import { Capacitor } from '@capacitor/core';
import { SplashScreen } from '@capacitor/splash-screen';

// Long enough that the normal boot path (mount → IntroVideoScreen → hide) always
// wins the race and the user never sees this fire; short enough that a reviewer
// with a stopwatch never concludes the app is dead. The happy path hides the
// splash in well under a second on a warm start.
export const SPLASH_WATCHDOG_MS = 4000;

/**
 * Arm a one-shot timer that force-hides the native splash.
 *
 * Call as early as possible — the entry module, not a React effect — so that a
 * failure anywhere in the React tree is still covered. No-op on web, where
 * there is no native splash to strand anyone behind.
 *
 * @param {number} [delayMs]
 * @returns {() => void} cancel, for tests and for callers that hide it sooner
 */
export function armSplashWatchdog(delayMs = SPLASH_WATCHDOG_MS) {
  if (!Capacitor.isNativePlatform()) return () => {};

  const timer = setTimeout(() => {
    // Fire-and-forget. If hide() rejects there is nothing useful left to do —
    // and throwing out of a timer callback would be worse than a visible splash.
    try {
      SplashScreen.hide().catch(() => {});
    } catch {
      /* plugin missing or webview torn down — nothing to recover */
    }
  }, delayMs);

  return () => clearTimeout(timer);
}
