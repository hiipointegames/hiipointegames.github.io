import moment from 'moment';
import 'moment-timezone';

// The date giveaway entries start needing a verified email. A leaf module (no
// imports from this package) so contest.js and contestEntries.js can both read
// it without an import cycle.

/**
 * The first ET day on which an entry needs a verified email.
 *
 * ⚠️ THE SERVER DECIDES, THIS COPIES IT. The same date is in the SQL that
 * counts entries (supabase/migrations/20261021010000_contest_email_verification.sql,
 * contest_entries_for_day: `p_day < date '2026-10-25'`) and in
 * scripts/contestWinners.js EMAIL_VERIFIED_FROM. Change all three together.
 */
export const EMAIL_VERIFIED_FROM = '2026-10-25';

/**
 * Does an entry on `today` (ET, 'YYYY-MM-DD') need a verified email?
 * @param {string} [today] defaults to today in ET
 */
export function emailVerificationRequired(today = moment.tz('America/New_York').format('YYYY-MM-DD')) {
  return today >= EMAIL_VERIFIED_FROM;
}
