// shell/adConfig — single source of truth for AdMob unit IDs + test mode.
//
// Why this exists: ad unit IDs were previously hardcoded in two places
// (interstitialAd.js and GlobalAdManager.jsx) with `isTesting: false`, so the
// dev server and debug builds served PRODUCTION ads. Every developer/tester tap
// is "invalid traffic" on the real AdMob account and risks suspension. This
// module centralizes the IDs and flips to Google's public test ad units
// whenever we're not in a real production build.
//
// Test mode is on when EITHER:
//   - import.meta.env.DEV is true (the Vite dev server / livereload), or
//   - VITE_ADMOB_TEST === 'true' (set this in .env before building a debug APK).
//
// Independently, VITE_ADMOB_TEST_DEVICES (comma-separated device IDs) registers
// physical test devices so THEY receive test ads even from a production build —
// the officially recommended way to keep your own devices from polluting metrics.

import { Capacitor } from '@capacitor/core';

// Google's public, always-safe test ad unit IDs. See:
// https://developers.google.com/admob/android/test-ads
const TEST_AD_IDS = {
  interstitial: {
    ios: 'ca-app-pub-3940256099942544/4411468910',
    android: 'ca-app-pub-3940256099942544/1033173712',
  },
  banner: {
    ios: 'ca-app-pub-3940256099942544/2934735716',
    android: 'ca-app-pub-3940256099942544/6300978111',
  },
};

// Real production ad unit IDs (HiiPointe Games publisher account,
// pub-6906001828646372 — AdSense customer 956-097-1302). Created 2026-06-11.
// NOTE: the prior IDs were under pub-2109107050819362, the ORIGINAL DEVELOPER's
// (Green Drop Garage) AdMob account — an orphan HiiPointe never controlled, so
// the shipped app's ads earned nothing for the client. See docs/bugs.md.
const PROD_AD_IDS = {
  interstitial: {
    ios: 'ca-app-pub-6906001828646372/2231415819',
    android: 'ca-app-pub-6906001828646372/6222631717',
  },
  banner: {
    ios: 'ca-app-pub-6906001828646372/7511662650',
    android: 'ca-app-pub-6906001828646372/8848795052',
  },
};

/** True when ad calls should use Google test inventory instead of real ads. */
export function adIsTesting() {
  return (
    import.meta.env?.DEV === true ||
    import.meta.env?.VITE_ADMOB_TEST === 'true'
  );
}

/** Physical test-device IDs to register so they always get test ads. */
export function getTestDeviceIds() {
  const raw = import.meta.env?.VITE_ADMOB_TEST_DEVICES;
  if (!raw) return [];
  return raw
    .split(',')
    .map((id) => id.trim())
    .filter(Boolean);
}

function resolveId(kind) {
  const table = adIsTesting() ? TEST_AD_IDS : PROD_AD_IDS;
  const platform = Capacitor.getPlatform();
  return table[kind][platform] ?? table[kind].android;
}

/** Interstitial ad unit ID for the current platform + mode. */
export function getInterstitialAdId() {
  return resolveId('interstitial');
}

/** Banner ad unit ID for the current platform + mode. */
export function getBannerAdId() {
  return resolveId('banner');
}
