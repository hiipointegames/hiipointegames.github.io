// The rule: is this name acceptable?
//
// Content only. Format rules — length, character set, required — stay in
// `validateUsername`, which runs them first and calls this last. That split is
// deliberate: a format rejection tells the player exactly what to fix, and a
// content rejection deliberately does not name the term it matched.

import { candidatesFor } from './transforms.js';
import {
  compileAbusePairs,
  compileTerms,
  findAdjacentAbuse,
  findUnexplained,
} from './matcher.js';
import { ALLOWLIST_SETS } from './allowlist.generated.js';
import {
  CONTEXTUAL_TERMS,
  TARGETING_TERMS,
  allBlockTerms,
} from './blocklist.js';

/** Compiled once at module load — 319 terms across three transforms. */
const COMPILED = compileTerms(allBlockTerms());

/** The 48 tier-2 pairs, also compiled once. */
const ABUSE_PAIRS = compileAbusePairs(CONTEXTUAL_TERMS, TARGETING_TERMS);

/**
 * The outcome of a content check.
 *
 * `reason` is for logs and tests, never for the player: naming the matched term
 * back to someone probing the filter tells them exactly what to try next.
 *
 * @typedef {{ ok: true } | { ok: false, tier: 'blocked' | 'targeted', reason: string }} ModerationResult
 */

/**
 * Judge a name's content.
 *
 * Every candidate spelling is checked against the terms compiled for that same
 * spelling — the symmetry documented in `transforms.js`. A hit under any one
 * candidate rejects; there is no voting.
 *
 * @param {string} name the raw username, before or after format validation
 * @returns {ModerationResult}
 */
export function moderateName(name) {
  for (const { name: transform, text } of candidatesFor(name)) {
    const allow = ALLOWLIST_SETS[transform] ?? new Set();

    const blocked = findUnexplained(text, COMPILED.get(transform) ?? [], allow);
    if (blocked) {
      return { ok: false, tier: 'blocked', reason: `${transform}:${blocked.term}` };
    }

    // Tier 2 — a mild word is only abuse when a targeting word sits beside it
    // AND nothing innocent explains the mild word. Both halves are needed:
    // `GrassKiller` really does contain `ass` immediately before `kill`, and it
    // is `grass` that makes it a name rather than an insult.
    const targeted = findAdjacentAbuse(text, ABUSE_PAIRS, allow);
    if (targeted) {
      return {
        ok: false,
        tier: 'targeted',
        reason: `${transform}:${targeted.contextual}+${targeted.targeting}`,
      };
    }
  }
  return { ok: true };
}

/**
 * The single message a player sees when a name is rejected on content.
 *
 * ONE message, not a random pick from ten.
 *
 * The previous version chose randomly on every call, so submitting the same name
 * twice produced different text. A player who believes the rejection is wrong —
 * and for `Dickinson`, `Hancock` or `Cockburn` they were right — could not even
 * quote what they saw in order to report it. A stable string is the difference
 * between "computer says no" and something a person can act on.
 *
 * It still does not say WHICH rule fired. That part was always deliberate, and
 * it is pinned by a test.
 */
export const CONTENT_REJECTION_MESSAGE =
  "That name can't be used. If it's your real name or you think this is a mistake, get in touch and we'll sort it out.";

/** Where a player who believes the rejection is wrong should be sent. */
export const APPEAL_EMAIL = 'contactus@hiipointegames.com';

/**
 * A `mailto:` for the appeal path, carrying the rejected name.
 *
 * Mirrors the pattern `CreateAccountForm.jsx` already uses for password reset,
 * so there is one way to reach a human, not two.
 *
 * @param {string} name the name that was rejected
 * @returns {string}
 */
export function appealMailto(name) {
  const subject = encodeURIComponent(`Username rejected: ${name}`);
  const body = encodeURIComponent(
    `I tried to use the username "${name}" and it was rejected.\n\n`
    + 'If this is my real name or you think it should be allowed, please let us know.',
  );
  return `mailto:${APPEAL_EMAIL}?subject=${subject}&body=${body}`;
}
