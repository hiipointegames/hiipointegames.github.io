// How-To-Play content model + verified winning examples.
//
// "smart games for smart people": every winning example here is checked against
// the real equation-engine in data.test.js — none can drift to a non-37 or
// mis-colored solve (the exact class of bug that shipped before; see
// docs/bugs.md 2026-06-14). Power-dice colors come from the live
// POWER_DICE_COLORS so Daily/Challenge always render the correct board layout.

import { POWER_DICE_COLORS, EASY_DICE_COLORS } from '@/dice';
import { requiresPerfectSolve } from '@/game-modes';
import { PUZZLE_POINTS, PUZZLE_PIECE_RULE_SHORT } from '@/game-mechanics';

export const TARGET = 37;

// A small "good to know" rule that's easy to omit but players hit in practice.
// Shown as fine print under the core loop. (The "standard order of operations
// (PEMDAS…)" note that used to live here was dropped — it's redundant now that
// the dedicated "Order of Operations" section below explains precedence in
// full. — David, 2026-07-11)
export const CORE_NOTES = [
  'Each die is its own value — you can’t push two together to make a bigger number.',
];

// Per-WIRE-KEY identity. Accent drives the page's gradients/glows; `specifics` is
// the "this mode" stat row; `powerDice` gates the power-dice section.
//
// C20 -- THE FAILURE THIS TABLE HAD, AND IT WAS SILENT. HowToPlayPage falls back
// `MODE_CONFIG[mode] || MODE_CONFIG.daily`. With only easy/challenge/daily here,
// Easy's Daily taught the POWER-DICE RULES over a board of seven white dice, and
// Expert got Challenge's rules with no mention that a perfect solve is required.
// No crash and no warning -- just the wrong lesson, in the two modes a player is
// most likely to be reading the rules for. All six wire keys now have an entry.
//
// C21 falls out for free: getSeen/markSeen in ./seen.js are already keyed per
// mode, so each new key gets its own first-run forced-scroll how-to -- but only
// once MODE_CONFIG knows the key, which is why C21 was listed as a dependency of
// this table rather than as work of its own.
