// The three-dailies pop-up and Layout, coordinated without importing each other.
//
// Two facts cross the boundary, one in each direction:
//
//   Layout → pop-up: "the bare home LAUNCHER is showing" (Layout's
//     `showHomeChrome`: the Game page's launcher, no gameplay, no Layout modal).
//     The pop-up opens only then. "Home" alone is not enough: the Game page is
//     `/` during gameplay too, and with resumes counting (design D3) a player
//     resuming mid-Daily on a new day would get the pop-up over a running Daily
//     clock. The launcher is the moment that matches "reaches the home screen".
//
//   pop-up → Layout: "still deciding / open / done". Layout's award catch-up
//     and secure-account prompt wait until it is done (design D1, David
//     2026-10-05: the pop-up goes first). Without this all three could stack on
//     launch day, when every existing player gets the pop-up.
//
// A module-level store rather than context: the gate is mounted in App, Layout
// inside Routes, and neither should have to know where the other lives.

import { useEffect, useState, useSyncExternalStore } from 'react';

/** How long Layout waits on an undecided pop-up before going ahead anyway.
 *  A safety release only — a normal decision takes one `me()` round trip. */
export const INTRO_HOLD_MAX_MS = 6000;

/** @typedef {'pending' | 'open' | 'done'} IntroStatus */

const state = {
  launcherIdle: false,
  /** @type {IntroStatus} */
  status: 'pending',
};
const subscribers = new Set();

function emit() {
  subscribers.forEach((fn) => fn());
}

function subscribe(fn) {
  subscribers.add(fn);
  return () => subscribers.delete(fn);
}

/** Layout reports whether the bare home launcher is showing. */
export function setHomeLauncherIdle(idle) {
  const next = Boolean(idle);
  if (state.launcherIdle === next) return;
  state.launcherIdle = next;
  emit();
}

/** The gate reports where its decision stands. @param {IntroStatus} status */
export function setIntroStatus(status) {
  if (state.status === status) return;
  state.status = status;
  emit();
}

export function getIntroStatus() {
  return state.status;
}

/** For the gate: is the bare home launcher showing right now? */
export function useHomeLauncherIdle() {
  return useSyncExternalStore(subscribe, () => state.launcherIdle, () => false);
}

/**
 * For Layout: may home's own prompts run? True once the pop-up has decided not
 * to show, or has been closed. False while it is open. While it is still
 * deciding, false — until `INTRO_HOLD_MAX_MS` after the launcher became idle,
 * so a stuck decision can never hold the catch-up or the prompt forever.
 *
 * @param {boolean} launcherIdle Layout's own `showHomeChrome`
 * @returns {boolean}
 */
export function useIntroSettled(launcherIdle) {
  const status = useSyncExternalStore(subscribe, () => state.status, () => 'done');
  const [expired, setExpired] = useState(false);

  useEffect(() => {
    setExpired(false);
    if (!launcherIdle || status !== 'pending') return undefined;
    const timer = setTimeout(() => setExpired(true), INTRO_HOLD_MAX_MS);
    return () => clearTimeout(timer);
  }, [launcherIdle, status]);

  if (status === 'done') return true;
  if (status === 'open') return false;
  return expired;
}

/** Tests only: back to the boot state. */
export function __resetIntroStatusForTests() {
  state.launcherIdle = false;
  state.status = 'pending';
  emit();
}
