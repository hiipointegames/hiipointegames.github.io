// SiteFooter — the app-wide, WEB-ONLY footer.
//
// WHY IT EXISTS (AdSense Phase 1, 2026-08-23): index.html carries a <main> block
// with an <h1>, two descriptive paragraphs and links to the three standalone
// static pages (/how-to-play.html, /privacy.html, /terms.html). That block lives
// inside #root, and createRoot() replaces #root's children on first render — so
// it is destroyed the instant React mounts. The AdSense crawler and Googlebot
// both execute JavaScript and judge the RENDERED DOM, where the home screen was
// measured at 210 characters of text and six anchors, none of which pointed at a
// content page. The three static pages were reachable only from sitemap.xml.
//
// Content that only non-JS clients ever see is also, structurally, the shape
// Google calls cloaking. This footer fixes both halves at once: it puts the same
// links in the rendered DOM, so the crawl graph connects for the clients that
// actually matter, and every screen carries a small amount of genuine content.
//
// WEB ONLY. On native it renders nothing — a policy-links footer under a game is
// not native UX, and this slice must not change the native app at all.
//
// LAYOUT: normal document flow, at the end of the Layout's content column, NOT
// fixed. The app already has a fixed bottom bar (home/BottomNavBar, z-index 140)
// and, on the eligible route, a fixed ad slot; a second fixed element would
// stack against them. Being in flow means it can never overlap either one. The
// `u37-ad-safe-pb` utility adds the SAME live bottom reservation #root uses
// (safe-area inset + AdMob band + nav-bar height), so when the page is scrolled
// to the very bottom the footer text sits ABOVE the nav bar rather than behind
// it. On web the safe-area and ad terms are 0, so the reservation is just the
// bar's 62px.

import React from 'react';
import { Capacitor } from '@capacitor/core';
import { StoreBadgeRow } from '@/shell/StoreBadges';

// The standalone static pages, served straight from public/ (they are real
// files, not SPA routes — plain <a href> so crawlers follow them and so a
// JS-disabled client can still read them).
// AdSense Phase 2 (2026-09-04) added /guides.html, /faq.html and /about.html.
// The hub links every guide, so one anchor here puts the whole content site two
// clicks from any screen — that is what connects the crawl graph. About and FAQ
// are listed directly because Google weighs visible ownership/contact signals.
// These pages are GENERATED AT BUILD TIME on the web train only
// (scripts/generate-web-content.mjs); they do not exist in the OTA bundle, which
// is fine because this whole component returns null on native.
export const FOOTER_LINKS = [
  { href: '/guides.html', label: 'Guides' },
  { href: '/how-to-play.html', label: 'How to Play' },
  { href: '/faq.html', label: 'FAQ' },
  { href: '/about.html', label: 'About' },
  { href: '/privacy.html', label: 'Privacy' },
  { href: '/terms.html', label: 'Terms' },
];

/**
 * Whether the footer should render for the current surface.
 *
 * Shown on every routed screen EXCEPT gameplay: a footer under a live puzzle is
 * clutter, and those surfaces suppress the bottom nav for the same reason. The
 * inputs are the ones Layout already tracks for the nav bar, so the two stay in
 * step without a second set of signals.
 *
 *  • `suppressed` — an in-page drill-down (a live battle, a single leaderboard
 *    day, the how-to overlay) hid the chrome via 'bottomNavChanged'.
 *  • `drawerOpen` — the hamburger drawer is open over the page.
 *  • Game — rides the same `homeChromeVisible` gate as the top chrome and the
 *    nav bar: visible on the bare launcher, hidden during gameplay, the
 *    results/celebration modal and the pre-game modals.
 *  • HeadToHead — the Blitz arena is a gameplay surface throughout.
 *  • Sector73 — the cockpit is immersive throughout.
 *
 * @param {{ currentPageName: string, homeChromeVisible: boolean, suppressed?: boolean, drawerOpen?: boolean }} state
 * @returns {boolean}
 */
export function isSiteFooterVisible({ currentPageName, homeChromeVisible, suppressed = false, drawerOpen = false }) {
  if (suppressed) return false;
  if (drawerOpen) return false;
  if (currentPageName === 'HeadToHead') return false;
  // The Sector 73 cockpit is immersive — same route opt-out as the nav bar
  // (@/home bottomNavVisibility, which says why the page's event is not enough).
  if (currentPageName === 'Sector73') return false;
  if (currentPageName === 'Game') return homeChromeVisible;
  return true;
}

export default function SiteFooter() {
  // Native gets AdMob and the app stores' own policy links; this is browser-only
  // chrome. Same early-return shape every web-only piece uses.
  if (Capacitor.isNativePlatform()) return null;

  return (
    <footer
      data-testid="site-footer"
      className="u37-ad-safe-pb"
      style={{
        position: 'relative',
        zIndex: 1,
        width: '100%',
        // Sits below the tallest page content, so it reads as the end of the
        // document rather than a band competing with the nav bar.
        marginTop: 'auto',
        paddingTop: 20,
        paddingLeft: 16,
        paddingRight: 16,
        borderTop: '1px solid var(--u37-hair, rgba(255,255,255,0.10))',
        background: 'var(--u37-surface, rgba(255,255,255,0.045))',
        color: 'var(--u37-muted, #a59fce)',
        fontFamily: 'system-ui,-apple-system,"Segoe UI",Roboto,sans-serif',
        fontSize: 12,
        lineHeight: 1.6,
        textAlign: 'center',
      }}
    >
      <nav
        aria-label="Site information"
        style={{
          display: 'flex',
          flexWrap: 'wrap',
          alignItems: 'center',
          justifyContent: 'center',
          gap: '4px 14px',
        }}
      >
        {FOOTER_LINKS.map((link) => (
          <a
            key={link.href}
            href={link.href}
            style={{
              color: 'var(--u37-muted, #a59fce)',
              textDecoration: 'none',
              borderBottom: '1px solid var(--u37-hair, rgba(255,255,255,0.10))',
              paddingBottom: 1,
              minHeight: 22,
            }}
          >
            {link.label}
          </a>
        ))}
      </nav>
      {/* The store badges. These REPLACE the old "Also on iOS and Android."
          sentence, which was the only pointer a web player had to the shipped
          apps and was not a link. Placed BELOW the policy links so the footer
          still reads links-then-colophon, and so the badges sit closest to the
          page edge where a download CTA belongs. */}
      <div style={{ marginTop: 14 }}>
        <StoreBadgeRow />
      </div>
      <p style={{ margin: '12px 0 0', opacity: 0.75 }}>
        37, The Math Puzzle — a free daily math puzzle from HiiPointe Games LLC.
      </p>
    </footer>
  );
}
