// One read path for friend connections (the directional friend-edge graph).
//
// player/friends.js owns the four friendship *mutations* (send / accept /
// reject / remove) but exposed no *reads*. The read side — "am I friends with
// this person?", "who are my friends?", "what requests are pending?" — was
// hand-rolled across ~7 files (OtherProfile, FriendList, FriendsList,
// RecommendedPlayers, LeaderboardView, ChallengeFriend, BattlePointsLeaderboard,
// Game), each re-deriving the user_id/friend_id symmetry of a bidirectional
// edge by hand. This module owns that derivation; the pure functions are the
// test surface, the thin async getFriendEdges owns the fetch — mirroring
// head-to-head/playerBattles.js.
//
// A FriendConnection row is a directional edge: { user_id (sender),
// friend_id (recipient), status: 'pending'|'accepted' }. Friendship itself is
// undirected, so every read has to consider both orientations.

import { apiClient } from '@/transport';

/**
 * My relationship to a specific other player, from the edge list.
 *   'friends'  — an accepted edge exists in either direction
 *   'pending'  — I sent them a request that's still pending
 *   'incoming' — they sent me a request that's still pending
 *   'none'     — no edge
 * Mirrors the original OtherProfile logic: the received edge is evaluated
 * last, so a pending incoming request reads as 'incoming' and an accepted
 * edge (either direction) reads as 'friends'.
 *
 * @param {Array<object>} edges - connection rows involving `me`
 * @param {string} me
 * @param {string} them
 * @returns {'none'|'pending'|'incoming'|'friends'}
 */
export function deriveFriendStatus(edges, me, them) {
  if (!Array.isArray(edges) || !me || !them) return 'none';
  let status = /** @type {'none'|'pending'|'incoming'|'friends'} */ ('none');
  const sent = edges.find((e) => e.user_id === me && e.friend_id === them);
  const received = edges.find((e) => e.user_id === them && e.friend_id === me);
  if (sent) {
    if (sent.status === 'accepted') status = 'friends';
    else if (sent.status === 'pending') status = 'pending';
  }
  if (received) {
    if (received.status === 'accepted') status = 'friends';
    else if (received.status === 'pending') status = 'incoming';
  }
  return status;
}

/**
 * The set of player ids I'm accepted-friends with, collapsing edge direction.
 *
 * @param {Array<object>} edges
 * @param {string} me
 * @returns {string[]} deduped friend ids
 */
export function selectFriendIds(edges, me) {
  if (!Array.isArray(edges) || !me) return [];
  const ids = new Set();
  for (const e of edges) {
    if (e.status !== 'accepted') continue;
    if (e.user_id === me) ids.add(e.friend_id);
    else if (e.friend_id === me) ids.add(e.user_id);
  }
  return [...ids];
}

/**
 * Split my pending requests into the ids I should act on vs the ids I'm
 * waiting on.
 *   incoming — senders of pending requests addressed to me (I can accept)
 *   outgoing — recipients of pending requests I sent (I'm waiting)
 *
 * @param {Array<object>} edges
 * @param {string} me
 * @returns {{incoming: string[], outgoing: string[]}}
 */
export function partitionPendingRequests(edges, me) {
  const incoming = [];
  const outgoing = [];
  if (!Array.isArray(edges) || !me) return { incoming, outgoing };
  for (const e of edges) {
    if (e.status !== 'pending') continue;
    if (e.friend_id === me) incoming.push(e.user_id);
    else if (e.user_id === me) outgoing.push(e.friend_id);
  }
  return { incoming, outgoing };
}

/**
 * Fetch every connection edge involving a user, in either direction, across
 * all statuses. The entity client only supports equality filters and the edge
 * is bidirectional, so this queries both orientations and dedupes by id —
 * cheaper than a full-table list, and the derivers above filter by status.
 *
 * @param {string} userId
 * @returns {Promise<Array<object>>}
 */
export async function getFriendEdges(userId) {
  if (!userId) return [];
  const [asSender, asRecipient] = await Promise.all([
    apiClient.entities.FriendConnection.filter({ user_id: userId }),
    apiClient.entities.FriendConnection.filter({ friend_id: userId }),
  ]);
  const byId = new Map();
  for (const e of [...(asSender || []), ...(asRecipient || [])]) byId.set(e.id, e);
  return [...byId.values()];
}
