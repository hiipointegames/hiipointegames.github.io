// Gathers what a Daily share card needs from what the two Share buttons already
// have, then hands off to @/share-card.
//
// Two callers, same flow:
//   * SuccessModal — right after a Daily, with the dice, equation and time in hand.
//   * shareResolvedDaily — the home result card later in the day, with only the
//     day's board. Everything else is recovered from the player's own board row
//     (the board is unlocked once they have finished or forfeited) or fetched.
//
// If no picture route exists on this device (an older store build reached by OTA,
// or a browser without file sharing), the SAME message goes out as text through
// the existing shareOrCopy dispatcher, so a Share tap always does something.

import { Capacitor } from '@capacitor/core';
import { apiClient } from '@/transport';
import { todayET } from '@/daily-challenge';
import { modeOf } from '@/game-modes';
import { isPerfectSolve } from '@/equation-engine';
import { prepareDailyResult, sendPreparedResult, powerSquaresFrom } from '@/share-card';
import { reportShareFailure, showCopyFallback, shareOutcome } from './shareFailure';
import { reportedFallback } from '@/observability';
import { contestVisibility } from '@/contest';
import { referralShareLine, referralsEnabled } from '@/referrals';

/** A dice array from game state ({id, value} objects) or a stored row (numbers). */
export function diceValues(dice) {
  if (!Array.isArray(dice) || dice.length !== 7) return null;
  const vals = dice.map((d) => (d && typeof d === 'object' ? d.value : d)).map(Number);
  return vals.every((v) => Number.isInteger(v) && v >= 1 && v <= 6) ? vals : null;
}

/** Username for the card: never for a guest, never a default placeholder name. */
export function cardUsername({ row, user }) {
  if (row && row.has_custom_username && row.user_name) return row.user_name;
  if (user && !user.is_anonymous && user.has_custom_username && user.username) return user.username;
  return null;
}

/** 'perfect' | 'solved' for a finished Daily. Expert only counts Perfects. */
export function solvedResult({ mode, perfect }) {
  if (modeOf(mode) === 'expert') return 'perfect';
  return perfect && modeOf(mode) !== 'easy' ? 'perfect' : 'solved';
}

async function fetchDayDice(date, mode) {
  try {
    const rows = await apiClient.entities.DailyChallenge.filter({ date, mode });
    return diceValues(rows?.[0]?.dice);
  } catch {
    return null;
  }
}

/**
 * Share a Daily: text + link, with the card as the link preview (2026-10-04;
 * the share-card module's ATTACH_CARD_PHOTO can put the photo back per platform).
 * @param {object} p
 * @param {string} p.mode wire key of the Daily
 * @param {boolean} p.forfeited
 * @param {number|null} [p.seconds]
 * @param {boolean} [p.perfect] when the caller already knows
 * @param {Array} [p.dice] 7 dice, objects or numbers
 * @param {boolean[]|null} [p.squares]
 * @param {Array<object>} [p.board] today's board for this mode
 * @param {string} [p.userId]
 * @param {(text: string) => Promise<void>} p.fallbackText text-only share
 * @param {object} [deps] test seams
 */
export async function shareDailyCard({ fallbackText, ...facts }, deps = {}) {
  return sendPreparedShare(await prepareDailyShareCard(facts, deps), fallbackText, deps);
}

/**
 * The tap half: open the share sheet from an already-prepared card, falling back
 * to the same message as text where no picture route exists.
 * @param {object} prepared from prepareDailyShareCard
 * @param {(text: string) => Promise<void>} fallbackText
 */
export async function sendPreparedShare(prepared, fallbackText, deps = {}) {
  const report = deps.report || reportShareFailure;
  const { outcome, text } = await (deps.send || sendPreparedResult)(prepared, { onFailure: report });
  // 'unsupported' = no picture route at all, so this tap is still unused and a
  // text share can have it. 'refused' = the picture share USED the tap and was
  // turned down, so another share would be refused too: give a fresh tap instead.
  shareOutcome(outcome, 'card');
  if (outcome === 'unsupported') await fallbackText(text);
  else if (outcome === 'refused') (deps.copyFallback || showCopyFallback)(text);
  return outcome;
}

/**
 * The slow half, safe to run BEFORE the tap: recover the facts (row, dice,
 * username) and build the card + message. The share-card module's
 * prepareDailyResult explains why the share must not await any of this after
 * the tap.
 * @param {object} p
 * @param {string} p.mode wire key of the Daily
 * @param {boolean} p.forfeited
 * @param {number|null} [p.seconds]
 * @param {boolean} [p.perfect] when the caller already knows
 * @param {Array} [p.dice] 7 dice, objects or numbers
 * @param {boolean[]|null} [p.squares]
 * @param {Array<object>} [p.board] today's board for this mode
 * @param {string} [p.userId]
 * @param {object} [deps] test seams
 */
export async function prepareDailyShareCard({
  mode, forfeited, seconds = null, perfect, dice, squares = null, board = [], userId,
}, deps = {}) {
  const date = (deps.today || todayET)();
  const row = board.find((r) => r && r.user_id === userId) || null;

  const result = forfeited
    ? 'forfeit'
    : solvedResult({
      mode,
      perfect: perfect ?? (row && (typeof row.is_perfect_solve === 'boolean'
        ? row.is_perfect_solve
        : isPerfectSolve(row.equation, row.usedDiceIndices, row.diceColors))),
    });

  const time = seconds ?? (row ? Number(row.solve_time_seconds) || null : null);
  const values = diceValues(dice) || diceValues(row?.shuffledDice) || await (deps.fetchDice || fetchDayDice)(date, mode);
  const litSquares = squares || (row ? powerSquaresFrom(row.equation, row.usedDiceIndices, row.diceColors) : null);

  // Read the sharer every time (it used to be only for an unnamed row): the
  // message's $37 line now depends on their 18+ answer (David, 2026-10-10) —
  // shown for Yes-members and for guests (a teaser), never for a No.
  let user = null;
  try { user = await (deps.me || apiClient.auth.me)(); } catch (e) { user = reportedFallback('share.me')(e); }
  const platform = (deps.platform || (() => Capacitor.getPlatform()))();
  const vis = contestVisibility(user, { isNative: platform !== 'web' });

  // "New to 37? Enter my username @ada when you sign up." — only while the
  // referrals switch is on, and only for a saved player with a chosen username
  // (a guest has nothing a friend could type). The switch is read only then.
  const ownName = cardUsername({ row: null, user });
  let inviteLine = null;
  if (ownName) {
    const on = await Promise.resolve().then(deps.referralsOn || referralsEnabled).catch(() => false);
    if (on === true) inviteLine = referralShareLine(ownName);
  }

  return (deps.prepare || prepareDailyResult)({
    mode, result, seconds: time, date, dice: values, squares: litSquares,
    username: cardUsername({ row, user }), board, inviteLine,
    platform,
    client: deps.client !== undefined ? deps.client : apiClient.supabase,
  }, { promo: vis === 'full' || vis === 'teaser' });
}
