import { getPlayerStats } from './playerStats';
import { reportedFallback } from '@/observability';

// derivedStats — keeping the DERIVED per-mode block alive in a screen's stats.
//
// THE PROBLEM THIS SOLVES, exactly as it shipped:
//
// `game_stats.perMode` — the three Dailies' solves, streaks, averages and podium
// finishes — is DERIVED on read by the `get-player-stats` edge function from the
// mode-tagged event log. It is deliberately NOT stored on the user (storing it is
// this project's documented drift disease; see awardDailyChallengeSolve's header).
//
// That means `apiClient.auth.me().game_stats` NEVER contains `perMode`. Game.jsx
// seeded its stats from exactly that blob, and threw away the derived block it
// separately fetched — it kept only `puzzle_points` from the getPlayerStats
// response. So the home screen's stats had no `perMode` at all.
//
// The visible symptom (David, 2026-09-02, on a real device): the 7-day streak
// track rendered on CHALLENGE and on nothing else. That is not a coincidence —
// `readPerModeStats` falls back to the legacy top-level fields for Challenge's
// Daily ONLY, because those fields have always meant Challenge. Easy and Expert
// have no legacy fields to fall back to, so they came back `tracked: false`, and
// DailyStreakTrack renders NOTHING rather than an empty track for an untracked
// tier — which is correct behaviour fed the wrong data.
//
// THE SECOND HALF. Merging it once at mount is not enough. Game.jsx replaces its
// stats wholesale in two more places — the "today's stats" refresh and the
// post-solve reload — both from `auth.me()`, both of which would drop `perMode`
// again. The post-solve one is the cruel case: the track would vanish at the
// exact moment the player earned a streak day. `preservePerMode` is what stops a
// wholesale replacement from silently discarding derived data.

/**
 * Carry a derived `perMode` block across a wholesale stats replacement.
 *
 * A replacement sourced from `auth.me()` can never carry `perMode`, so without
 * this the derived block is lost every time the user object is re-read.
 *
 * @param {any} nextStats the incoming stats blob (usually from auth.me())
 * @param {any} prevStats the stats being replaced, which may hold a derived block
 * @returns {any} nextStats, with a perMode block if either side has one
 */
export function preservePerMode(nextStats, prevStats) {
  const next = nextStats ?? {};
  // Prefer the incoming block if it somehow has one; otherwise carry the old.
  const perMode = next.perMode ?? prevStats?.perMode;
  return perMode ? { ...next, perMode } : next;
}

/**
 * Apply a `getPlayerStats` result to a screen's state.
 *
 * Takes BOTH useful things out of the response — the authoritative puzzle-piece
 * count and the derived `perMode` block. The second used to be dropped on the
 * floor, which is the whole reason this module exists.
 *
 * Never throws: it is called from a fire-and-forget `.then()` on a screen that
 * must keep working when stats are unavailable.
 *
 * @param {any} result the envelope returned by getPlayerStats
 * @param {{setPuzzlePoints?: Function, setStats?: Function}} setters
 * @returns {boolean} whether a derived perMode block was applied
 */
export function applyDerivedPlayerStats(result, { setPuzzlePoints, setStats } = {}) {
  if (!result || result.success !== true || !result.data) return false;

  try {
    setPuzzlePoints?.(result.data.puzzle_points ?? 0);
  } catch { /* a screen that cannot take the count must not break the fetch */ }

  const perMode = result.data.game_stats?.perMode;
  if (!perMode) return false;

  try {
    setStats?.((prev) => preservePerMode({ ...(prev ?? {}), perMode }, prev));
  } catch { return false; }
  return true;
}

/**
 * Apply a post-solve user reload, then REFRESH the derived block from the server.
 *
 * WHY THIS EXISTS — the bug it fixes (David, 2026-09-03).
 *
 * `preservePerMode` alone stops a reload from DESTROYING the derived block, but
 * it cannot make it CURRENT: it carries forward whatever was last fetched. And
 * `getPlayerStats` was called exactly once, during the initial page load. So
 * after a solve, `perMode.<mode>.currentStreak` still held the streak as it was
 * BEFORE that solve — a number one short, for the rest of the session.
 *
 * That was already visible in the shipped 7-day streak track (it lit one die
 * fewer than the player had earned, until they reloaded the page), and it is the
 * exact reason this helper had to exist before the post-solve message could name
 * a streak: a congratulations that says "your 79 day streak" to a player who just
 * completed their 80th is worse than saying nothing.
 *
 * The refetch is safe HERE specifically because `submitDailyLeaderboardTime` is
 * awaited before this point in the solve path, so today's row is already written
 * and the server derives a streak that includes today (`currentStreakFrom`:
 * "completed today -> the streak includes today").
 *
 * Fire-and-forget by design: the stats it refreshes are decoration on a screen
 * the player has already won. A failed refetch leaves the preserved-but-stale
 * block in place, which is exactly the old behaviour — never a broken screen.
 *
 * ⚠️ RESOLVES WITH THE ENVELOPE, NOT A BOOLEAN — deliberately, and it is the
 * whole point of the return value.
 *
 * The post-solve path fetched this exact `get-player-stats` envelope TWICE per
 * solve: once here, and once again immediately afterwards in
 * `settleSolveCelebration` -> `readSolveOutcomeSources`, which needs the same
 * response for the player's point totals and badge state. A boolean told the
 * caller only whether the refresh worked, so it had no way to reuse what had
 * just arrived and had to ask again. Two round-trips at the most latency-
 * sensitive moment in the game — the player is watching a rocket wait on them —
 * for one answer that had already landed.
 *
 * Handing the envelope back lets the caller pass it straight on. `null` means
 * "no envelope" (no user id, or the fetch failed) and a caller must then fall
 * back to fetching for itself rather than treating it as an empty result.
 *
 * Still fire-and-forget-safe: it never rejects, so a caller that ignores the
 * return is exactly as correct as before.
 *
 * @param {{
 *   reloadedUser: any, fallbackStats: any,
 *   setStats?: Function, setPuzzlePoints?: Function,
 * }} args
 * @returns {Promise<any|null>} the getPlayerStats envelope, or null if none
 */
export function applyReloadedStats({ reloadedUser, fallbackStats, setStats, setPuzzlePoints }) {
  const next = reloadedUser?.game_stats || fallbackStats;
  setStats?.((prev) => preservePerMode(next, prev));

  const id = reloadedUser?.id;
  if (!id) return Promise.resolve(null);

  return getPlayerStats(id)
    .then((r) => {
      applyDerivedPlayerStats(r, { setPuzzlePoints, setStats });
      return r ?? null;
    })
    .catch(reportedFallback('derived.stats'));
}
