import { useEffect } from 'react';

export default function VersionChecker() {
  useEffect(() => {
    const checkForUpdates = async () => {
      // Check if we already checked in this session
      const checkedThisSession = sessionStorage.getItem('version_checked');
      if (checkedThisSession) {
        return; // Already checked, don't check again
      }

      try {
        // Mark as checked for this session
        sessionStorage.setItem('version_checked', 'true');

        // Fetch a version indicator from the server (cache-busted)
        const response = await fetch('/index.html?' + Date.now(), {
          method: 'HEAD',
          cache: 'no-cache'
        });
        
        const serverETag = response.headers.get('etag') || response.headers.get('last-modified');
        const storedETag = localStorage.getItem('app_etag');

        // If ETags don't match, clear cache and reload
        if (serverETag && storedETag && serverETag !== storedETag) {
          console.log('New version detected, clearing cache...');
          
          // Clear all caches
          if ('caches' in window) {
            const cacheNames = await caches.keys();
            await Promise.all(cacheNames.map(name => caches.delete(name)));
          }
          
          // Store new ETag
          localStorage.setItem('app_etag', serverETag);
          
          // Force reload without cache
          window.location.reload();
        } else if (serverETag) {
          // Store ETag for future comparison
          localStorage.setItem('app_etag', serverETag);
        }
      } catch (error) {
        console.error('Version check failed:', error);
      }
    };

    checkForUpdates();
  }, []);

  return null;
}