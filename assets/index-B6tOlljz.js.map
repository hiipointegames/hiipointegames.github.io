import { supabase } from '@/transport';
import { contestToday as etToday } from './contestEntries';

// Giveaway email verification: the player proves they read the inbox by typing
// a 6-digit code we email (David, 2026-10-20). From 25 Oct 2026 a giveaway
// entry needs it (contest_entries_for_day, 20261021010000).
//
// ─────────────────────────────────────────────────────────────────────────────
// HOW IT WORKS, AND WHY IT IS A SIGN-IN
// ─────────────────────────────────────────────────────────────────────────────
// Supabase's own "confirmed" flag proves nothing here (prod auto-confirms every
// address), so the server keeps its own record, and it only believes the code
// was typed when the caller's session SAYS so: verifyOtp signs the player in
// again — same account — and the new session's signed JWT carries
// `amr: [{method: 'otp'}]`, which a phone cannot forge. Then
// contest_mark_email_verified() checks that and records the address.
//
// shouldCreateUser:false — this must never mint a new account for a typo'd
// address. The code goes to the address ON the account; changing the address is
// the account form's job, and a verification belongs to one address only.

/** The server's reasons, as the sheet needs to talk about them. */
export const EMAIL_CODE_ERRORS = {
  no_email: 'Add a real email to your account first.',
  email_mismatch: 'That code was for a different email. Send a new one.',
  no_code: "That code didn't go through. Send a new one.",
  bad_code: "That code isn't right, or it has expired. Check it or send a new one.",
  rate_limited: 'Too many tries. Wait a minute, then send a new code.',
  network: "Couldn't reach the server. Check your connection and try again.",
};

/** The 6 digits as typed: spaces and dashes dropped, nothing else allowed. */
export function normalizeEmailCode(raw) {
  const digits = String(raw ?? '').replace(/[\s-]/g, '');
  return /^\d{6}$/.test(digits) ? digits : null;
}

function classify(error) {
  const status = /** @type {any} */ (error)?.status;
  const msg = String(/** @type {any} */ (error)?.message ?? '').toLowerCase();
  if (status === 429 || msg.includes('rate limit') || msg.includes('security purposes')) return 'rate_limited';
  if (msg.includes('fetch') || msg.includes('network')) return 'network';
  return null;
}

/**
 * Email the player a code for the address on their account.
 * @param {string} email
 * @returns {Promise<{ok: true} | {ok: false, reason: keyof typeof EMAIL_CODE_ERRORS}>}
 */
export async function sendGiveawayEmailCode(email) {
  if (!email) return { ok: false, reason: 'no_email' };
  try {
    const { error } = await supabase.auth.signInWithOtp({ email, options: { shouldCreateUser: false } });
    if (error) return { ok: false, reason: classify(error) ?? 'no_email' };
    return { ok: true };
  } catch (e) {
    return { ok: false, reason: classify(e) ?? 'network' };
  }
}

/**
 * Check the code, then have the server record the verified address.
 * @param {string} email
 * @param {string} rawCode
 * @returns {Promise<{ok: true} | {ok: false, reason: keyof typeof EMAIL_CODE_ERRORS}>}
 */
export async function confirmGiveawayEmailCode(email, rawCode) {
  const token = normalizeEmailCode(rawCode);
  if (!token) return { ok: false, reason: 'bad_code' };
  try {
    const { error } = await supabase.auth.verifyOtp({ email, token, type: 'email' });
    if (error) return { ok: false, reason: classify(error) ?? 'bad_code' };
    const { data, error: rpcError } = await supabase.rpc('contest_mark_email_verified');
    if (rpcError) return { ok: false, reason: classify(rpcError) ?? 'network' };
    if (data?.verified === true) return { ok: true };
    const reason = data?.reason;
    return { ok: false, reason: reason in EMAIL_CODE_ERRORS ? reason : 'no_code' };
  } catch (e) {
    return { ok: false, reason: classify(e) ?? 'network' };
  }
}

/**
 * The giveaway email check, as the server sees THIS player.
 *
 *   true    — the current email is verified
 *   false   — not verified AND the requirement applies from today: a Daily now
 *             earns no entry (the only value any caller treats as blocking)
 *   'grace' — not verified, but not required yet: the player's app can verify
 *             and has the rest of their week to do it (or the server has not seen
 *             this app version yet). Entries still count; the heads-up shows.
 *   null    — unknown (could not be read): show nothing new
 *
 * The server's `required_from` is per player (20261021050000): 7 days after
 * their app first could verify, never before 25 Oct 2026. Before that file is
 * applied it is absent, which reads as grace — never as a false "no entry".
 *
 * @param {{ today?: () => string }} [deps] test seam (ET 'YYYY-MM-DD')
 * @returns {Promise<boolean|'grace'|null>}
 */
export async function fetchGiveawayEmailVerified(deps = {}) {
  try {
    const { data, error } = await supabase.rpc('contest_email_status');
    if (error) return null;
    if (data?.verified === true) return true;
    const from = typeof data?.required_from === 'string' ? data.required_from.slice(0, 10) : null;
    const today = (deps.today || etToday)();
    return from && today >= from ? false : 'grace';
  } catch {
    return null;
  }
}
