import { DAILY_MODE_KEYS } from '@/game-modes/modeKeys';
import { dailyModeLabel } from '@/leaderboard/dailyModeTabs';
import { apiClient } from '@/transport/apiClient';
import { DAILY_LIMIT_MS, DAILY_LIMIT_LABEL } from './dailyLimit';

// staleDailyNotice — tell a player their Daily ran out, even when they were not
// there to see it.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE GAP
// ─────────────────────────────────────────────────────────────────────────────
// A Daily attempt dies after DAILY_LIMIT_SECONDS. If the player is IN the app when that
// happens, useDailyChallengeAttempt fires the timeout, forfeits, and shows the
// day's solutions. If they are not — they closed the app, the phone died, they
// walked away — nothing happens at all. `restore()` only ever asks about TODAY,
// so yesterday's stranded attempt is never read again and the player is never
// told.
//
// They find out by opening the app the next day to discover the Daily is gone,
// with nothing on screen connecting that to the hour they started and abandoned.
// Measured on prod 2026-09-08: 134 attempt rows sit `forfeited: false` with the
// hour long gone — 10.2% of every attempt ever made.
//
// ─────────────────────────────────────────────────────────────────────────────
// IT TELLS. IT DOES NOT WRITE.
// ─────────────────────────────────────────────────────────────────────────────
// The obvious companion — flip those rows to `forfeited: true` — is not
// available to a client any more, and should not be. 20260906010000 revoked
// INSERT/UPDATE/DELETE on `daily_challenge_attempts` from `authenticated`,
// because the player owning the referee's start time is exactly how a two-second
// Expert Daily gets forged. `daily-challenge-controller`'s forfeit action
// resolves the attempt by authed user + TODAY, so it cannot reach yesterday's
// row either. Retiring those 134 rows needs a server-side sweep.
//
// That is data hygiene, not a player-facing debt: a stale row from a past day
// blocks nothing, because every gate reads today. So the honest split is to ship
// the telling now and leave the writing to the server — and the copy says the
// attempt "ran out" rather than "was auto-forfeited", because the second would
// be describing a write we did not do.
//
// ─────────────────────────────────────────────────────────────────────────────
// ONCE, PER PLAYER, PER DAY, PER MODE
// ─────────────────────────────────────────────────────────────────────────────
// The acknowledgement lives in localStorage, deliberately. The two failure modes
// are wildly asymmetric: a player on a second device is told a true thing twice.
// Storing it server-side would mean a write on app open, against the very table
// this module exists because the client can no longer write to.

// The attempt window, single-sourced — 1 hour until 2026-09-12, now 15:37.
// Importing it keeps 'is this attempt dead?' in step with the clock the player saw.
const ONE_DAY_MS = 24 * 60 * 60 * 1000;

/** localStorage key for "this player has been told about this day + mode". */
export const noticeKey = (userId, date, mode) => `u37.dailyTimeout.${userId}.${date}.${mode}`;

/**
 * A Storage that cannot throw. Private browsing, blocked site data and a full
 * quota all raise, and a courtesy notice is never worth breaking app start over.
 */
function safeStorage(storage) {
  return {
    get(key) {
      try { return storage?.getItem(key) ?? null; } catch { return null; }
    },
    set(key, value) {
      try { storage?.setItem(key, value); } catch { /* nothing to be done */ }
    },
  };
}

/**
 * @typedef {{ date: string, mode: string, startedAtMs: number }} StaleAttempt
 */

/**
 * Which abandoned attempts deserve a message? PURE — the queries live below, so
 * every branch here is reachable from a test.
 *
 * @param {Object} args
 * @param {string} args.userId
 * @param {{date: string, mode: string, created_at: string}[]} args.attempts
 *   unforfeited attempts from BEFORE today
 * @param {{date: string, mode: string}[]} args.completions leaderboard rows for those days
 * @param {number} args.nowMs
 * @param {Storage} [args.storage]
 * @returns {StaleAttempt[]} newest first
 */
export function selectUnannouncedTimeouts({ userId, attempts, completions, nowMs, storage }) {
  const store = safeStorage(storage);
  const finished = new Set((completions ?? []).map((c) => `${c.date}:${c.mode}`));

  return (attempts ?? [])
    .filter((a) => {
      // A COMPLETED day leaves `forfeited: false` too — the attempt row is
      // simply never updated on a win. Without this line every Daily the player
      // ever solved would be announced as a timeout, which is the precise
      // opposite of the message. This is the load-bearing filter in the file.
      if (finished.has(`${a.date}:${a.mode}`)) return false;

      const startedAtMs = new Date(a.created_at ?? '').getTime();
      // No usable start means we cannot say the hour ran out, only that
      // something is odd. Silence is the honest answer.
      if (!Number.isFinite(startedAtMs)) return false;

      // Only announce an attempt that genuinely passed the hour. One started 20
      // minutes before midnight ET carries yesterday's date and may still have
      // been live when the day rolled; telling that player their time ran out
      // would be false.
      if (nowMs - startedAtMs < DAILY_LIMIT_MS) return false;

      return store.get(noticeKey(userId, a.date, a.mode)) === null;
    })
    .map((a) => ({ date: a.date, mode: a.mode, startedAtMs: new Date(a.created_at).getTime() }))
    .sort((a, b) => b.date.localeCompare(a.date));
}

/**
 * Remember that this one has been announced.
 *
 * @param {string} userId
 * @param {StaleAttempt} attempt
 * @param {Storage} [storage]
 */
export function markAnnounced(userId, attempt, storage) {
  safeStorage(storage).set(noticeKey(userId, attempt.date, attempt.mode), '1');
}

/**
 * The sentence a player reads.
 *
 * @param {StaleAttempt} attempt
 * @param {string} today ET date, so "yesterday" is only claimed when it is true
 * @returns {{title: string, description: string}}
 */
export function timeoutMessage(attempt, today) {
  const label = dailyModeLabel(attempt.mode) ?? 'Daily';
  const yesterdayIso = new Date(new Date(`${today}T00:00:00Z`).getTime() - ONE_DAY_MS)
    .toISOString().slice(0, 10);
  const wasYesterday = attempt.date === yesterdayIso;

  // Names the day whenever it was not, in fact, yesterday. A player coming back
  // after a week should not be told this happened last night.
  const when = wasYesterday ? 'yesterday' : `on ${attempt.date}`;

  return {
    title: `Your ${label} Daily ran out of time`,
    description: `You started it ${when} and did not finish inside ${DAILY_LIMIT_LABEL}, so it did not count. The clock keeps running even when the app is closed.`,
  };
}

/**
 * Read the abandoned attempts worth announcing. Two bounded queries, run once
 * per app open. `deps` is injected by tests; production passes nothing.
 *
 * @param {{
 *   userId: string|null|undefined,
 *   today: string|null|undefined,
 *   nowMs?: number,
 *   limit?: number,
 *   storage?: Storage,
 *   deps?: { attemptsFor?: Function, timesFor?: Function },
 * }} args
 * @returns {Promise<StaleAttempt[]>}
 */
export async function loadTimedOutAttempts({
  userId, today, nowMs = Date.now(), limit = 3, storage, deps = {},
}) {
  const {
    attemptsFor = (filters, options) => apiClient.entities.DailyChallengeAttempt.filter(filters, options),
    timesFor = (filters) => apiClient.entities.DailyChallengeTime.filter(filters),
  } = deps;

  if (!userId || !today) return [];

  try {
    const attempts = await attemptsFor(
      { user_id: userId, forfeited: false, date: { lt: today } },
      { order: { field: 'date', ascending: false }, limit },
    );
    if (!attempts?.length) return [];

    const dates = [...new Set(attempts.map((a) => a.date))];
    const completions = await timesFor({
      user_id: userId,
      date: dates.length === 1 ? dates[0] : { in: dates },
      mode: { in: [...DAILY_MODE_KEYS] },
    });

    return selectUnannouncedTimeouts({ userId, attempts, completions, nowMs, storage });
  } catch (error) {
    // A courtesy notice must never be the reason the app fails to start.
    console.warn('Could not check for abandoned Daily attempts:', error);
    return [];
  }
}
