import React from 'react';
import { createPortal } from 'react-dom';
import { motion } from 'framer-motion';
import { Share2, Users, BarChart3, Award, Sparkles } from 'lucide-react';
import {
  CelebrationCard, HeroGlyph, HeroTitle, CELEBRATION_Z_INDEX, useHideNavWhileCelebrating,
} from '@/game-flow';
import { NOT_NOW_LABEL } from './tips';

// FeatureTipCard — one first-week tip (or What's-new note), in the badge pop-up's
// look: the same card, hero glyph and title as AwardCelebrationSequence.
//
// PORTALED TO <body>. Inside #root (a momentum-scroll container) iOS traps an
// overlay's z-index under the body-portaled bottom nav, so a z bump alone only
// fixes Android (memory: ios-overlays-must-portal; the Three Dailies pop-up
// shipped dead buttons on iPhone until it moved to <body>).
//
// It hides the bottom nav while up (celebrationChrome), like every celebration.

const TIP_HUE = 'var(--u37-tier-6)';

/** Icon key (registry) → glyph. Unknown keys get the sparkle. */
export const TIP_ICONS = Object.freeze({
  share: Share2,
  friends: Users,
  stats: BarChart3,
  badges: Award,
  new: Sparkles,
});

/**
 * @param {Object} props
 * @param {{ id: string, icon?: string, title: string, lines?: ReadonlyArray<string>,
 *           actions?: ReadonlyArray<{ label: string, go: string }> }} props.tip
 * @param {string | null} [props.extraLine] e.g. card 1's referral line, when that switch is on
 * @param {(go: string) => void} props.onGo
 * @param {() => void} props.onDismiss
 */
export default function FeatureTipCard({ tip, extraLine = null, onGo, onDismiss }) {
  useHideNavWhileCelebrating(true);
  const Icon = TIP_ICONS[tip.icon] || Sparkles;
  const lines = [...(tip.lines || []), ...(extraLine ? [extraLine] : [])];
  const actions = tip.actions || [];

  return createPortal(
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      className="fixed inset-0 flex items-center justify-center p-4 u37-ad-safe-pb bg-black/85 backdrop-blur-sm"
      style={{ zIndex: CELEBRATION_Z_INDEX }}
      role="dialog"
      aria-modal="true"
      aria-labelledby={`feature-tip-${tip.id}-title`}
      data-testid="feature-tip"
      data-tip={tip.id}
    >
      <CelebrationCard hue={TIP_HUE}>
        <HeroGlyph hue={TIP_HUE} color={TIP_HUE}>
          <Icon className="w-3/5 h-3/5" aria-hidden="true" />
        </HeroGlyph>
        <div id={`feature-tip-${tip.id}-title`}>
          <HeroTitle hue={TIP_HUE}>{tip.title}</HeroTitle>
        </div>
        {lines.length > 0 && (
          <div className="mt-2 space-y-1.5">
            {lines.map((line) => (
              <p key={line} className="text-slate-300 text-sm">{line}</p>
            ))}
          </div>
        )}
        {actions.map((a, i) => (
          <button
            key={a.go}
            type="button"
            data-testid={`feature-tip-go-${a.go}`}
            onClick={() => onGo(a.go)}
            className={i === 0
              ? 'mt-6 w-full rounded-xl py-3 font-black text-[#04121a]'
              : 'mt-2 w-full rounded-xl py-2.5 text-sm font-bold border'}
            style={i === 0
              ? { background: TIP_HUE, boxShadow: `0 0 22px -7px ${TIP_HUE}` }
              : { color: TIP_HUE, borderColor: `color-mix(in srgb, ${TIP_HUE} 55%, transparent)` }}
          >
            {a.label}
          </button>
        ))}
        <button
          type="button"
          data-testid="feature-tip-dismiss"
          onClick={onDismiss}
          className={`${actions.length ? 'mt-2' : 'mt-6'} w-full rounded-xl py-2.5 text-sm font-bold text-slate-400`}
        >
          {NOT_NOW_LABEL}
        </button>
      </CelebrationCard>
    </motion.div>,
    document.body,
  );
}
