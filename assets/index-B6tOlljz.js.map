import { GlobalAdManager, initNativeShell } from '@/shell';
import { WebAdSlot } from '@/shell/web-ads';

import React, { useState, useEffect, Suspense, lazy } from 'react';
import './App.css'
import { Toaster } from "@/ui/primitives/toaster"
import { QueryClientProvider } from '@tanstack/react-query'
import { queryClientInstance } from './query-client'
import NavigationTracker from './NavigationTracker'
import { pagesConfig } from './pages.config'
import { BrowserRouter as Router, Route, Routes, useNavigate, useLocation } from 'react-router-dom';
import PageNotFound from './PageNotFound';
import Sector73RouteGate from './Sector73RouteGate';
import { AuthProvider, useAuth, handleGuestSignInFailure } from '@/auth';
import { useStaleDailyNotice } from '@/daily-challenge';
import UserNotRegisteredError from '@/components/UserNotRegisteredError';
import { DiceLoader } from '@/dice-visuals';
import { InitialWelcomeModal } from '@/game-flow';
import { ThreeDailiesIntroGate } from '@/contest';
import { IntroVideoScreen } from '@/game-flow';
import { apiClient, withTimeout } from '@/transport';
import { setSentryUser, track, screenName } from '@/observability';
import { App as CapApp } from '@capacitor/app';
import { SplashScreen } from '@capacitor/splash-screen';
import { Capacitor } from '@capacitor/core';

// Login is lazy for the same reason the ten routed pages are (see
// pages.config.js): it is only reachable by a deliberate navigation to
// /login or /signup, so it does not belong in the first-paint download.
const Login = lazy(() => import('@/pages/Login'));

const { Pages, Layout, mainPage } = pagesConfig;
const mainPageKey = mainPage ?? Object.keys(Pages)[0];
const MainPage = mainPageKey ? Pages[mainPageKey] : <></>;

// The full-screen branded loader. Used for the pre-route waits (auth /
// user-fetch) and for the layout-less routes (/login, /signup), where there is
// no app chrome to preserve.
const FullScreenLoader = () => (
  <div className="fixed inset-0 flex items-center justify-center" style={{ background: 'var(--u37-bg)' }}>
    <DiceLoader size={64} />
  </div>
);

// The in-layout route fallback. Route chunks are fetched lazily now
// (pages.config.js), so a first visit to a route can wait on a network
// round-trip. This renders INSIDE the Layout, so the nav chrome stays put and a
// route transition reads as "this page is loading", not "the app restarted".
// It is the same DiceLoader the app already uses everywhere else it waits.
const RouteLoader = () => (
  <div
    className="flex items-center justify-center"
    style={{ minHeight: '60vh' }}
    data-testid="route-suspense-fallback"
  >
    <DiceLoader size={64} />
  </div>
);

// One <Suspense> per route element rather than one around <Routes>: a boundary
// above <Routes> would unmount the Layout on every first-visit transition (the
// whole subtree suspends), which is exactly the "looks like a different app"
// flash we are trying to avoid.
const LayoutWrapper = ({ children, currentPageName }) => Layout ?
  <Layout currentPageName={currentPageName}>
    <Suspense fallback={<RouteLoader />}>{children}</Suspense>
  </Layout>
  : <Suspense fallback={<RouteLoader />}>{children}</Suspense>;

const AuthenticatedApp = () => {
  const { isLoadingAuth, authError, isAuthenticated, signInAnonymously, supabase } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();
  // Player-action trail: which screen, with ids stripped (@/observability track).
  useEffect(() => { track('screen', { screen: screenName(location.pathname) }); }, [location.pathname]);
  const [user, setUser] = useState(null);
  const [loadingUser, setLoadingUser] = useState(true);
  const [showWelcomeModal, setShowWelcomeModal] = useState(false);
  // Read through a try/catch: this runs during the FIRST render, and
  // sessionStorage is not guaranteed to exist. A WKWebView with website data
  // blocked (and Safari private mode on web) throws on plain ACCESS, not just on
  // write. An uncaught throw here takes down the initial render — and because
  // the native splash only hides further down the boot path, the user is left
  // on a static screen that ignores taps. Failing open (show the intro) is the
  // safe default: the worst case is seeing a 10-second video twice.
  const [showIntro, setShowIntro] = useState(() => {
    try {
      return !sessionStorage.getItem('introPlayed');
    } catch {
      return true;
    }
  });

  // Native shell init (StatusBar + AdMob). See src/shell/nativeInit.js.
  // No-op on web.
  useEffect(() => {
    initNativeShell();
  }, []);

  // A Daily attempt dies after an hour, and if the player was not in the app
  // when it happened nothing has ever told them — `restore()` only asks about
  // today. Mounted here rather than in Game.jsx because the abandoned attempt
  // may be a mode the player is not opening onto. See @/daily-challenge
  // staleDailyNotice for why this tells rather than writes.
  useStaleDailyNotice(user);

  // Handle authentication
  useEffect(() => {
    if (!isLoadingAuth) {
      if (isAuthenticated && location.pathname === '/login' && !location.state?.allowLogin) {
        navigate('/');
      }
      if (!isAuthenticated && location.pathname === '/') {
        // Fire-and-forget, so it needs its own catch: an offline player is
        // ignored (retried on the next visit), anything else is reported.
        signInAnonymously().catch(handleGuestSignInFailure);
      }
    }
  }, [isLoadingAuth, isAuthenticated, location, navigate, signInAnonymously]);

  // Handle deep links (native only). On native, password-reset emails open the
  // app via a custom URL scheme (reset-callback) routed through `appUrlOpen`. In
  // a browser there is no custom-scheme deep link — the reset link lands on the
  // normal /ResetPassword route at window.location.origin — so this listener is
  // dead weight on web. `@capacitor/app` no-ops it there, but guard explicitly
  // for parity with AuthContext's native-only listeners.
  useEffect(() => {
    if (!Capacitor.isNativePlatform()) return;

    const handleDeepLink = async ({ url }) => {
      if (url.includes('reset-callback')) {
        const hashIndex = url.indexOf('#');
        if (hashIndex > -1) {
          const hash = url.substring(hashIndex + 1);
          const params = new URLSearchParams(hash);
          const accessToken = params.get('access_token');
          const refreshToken = params.get('refresh_token');
          const type = params.get('type');

          if (accessToken && refreshToken && type === 'recovery') {
            const { error } = await supabase.auth.setSession({
              access_token: accessToken,
              refresh_token: refreshToken
            });

            if (!error) {
              navigate('/ResetPassword');
            }
          }
        }
      }
    };

    const listener = CapApp.addListener('appUrlOpen', handleDeepLink);
    return () => {
      listener.then(handle => handle.remove());
    };
  }, [navigate, supabase]);

  // Fetch user data
  useEffect(() => {
    const fetchUser = async () => {
      const isNative = Capacitor.isNativePlatform();

      if (!isAuthenticated) {
        setSentryUser(null);
        setLoadingUser(false);
        if (isNative) {
          SplashScreen.hide().catch(() => { });
        }
        return;
      }

      try {
        // Bounded for the same reason as the anonymous sign-in: me() performs
        // a network getUser(), and `loadingUser` is only cleared in the
        // `finally` below, so a request that never settles pins the app on
        // <FullScreenLoader />. Resolving null on timeout is already a safe
        // path here — the guard below requires a real `currentUser` before
        // treating anyone as an unregistered guest, so a timeout renders the
        // app rather than bouncing a signed-in player to onboarding.
        const currentUser = await withTimeout(apiClient.auth.me(), null);
        setUser(currentUser);
        // Tag crash reports with the user id only (no email/PII).
        setSentryUser(currentUser?.id ?? null);
        
        // Don't show welcome modal if user is on auth pages (login/signup)
        const isAuthPage = ['/login', '/signup'].includes(location.pathname);
        // Show onboarding to users with no account (no username) UNLESS they've
        // already chosen "Play as Guest" (hasSeenInitialWelcomeModal) — otherwise
        // a guest would be re-prompted on every navigation. Explicit requests
        // (location.state.showWelcome) always show it.
        const hasSeenWelcome = currentUser?.user_metadata?.game_stats?.hasSeenInitialWelcomeModal;
        // Only treat someone as an unregistered guest when we actually resolved a
        // user that has no custom username. A null/failed `me()` (e.g. a network
        // blip on `getUser`) must NOT bounce a logged-in user to onboarding —
        // that was the "had to sign in twice" bug. `me()` now falls back to the
        // local session, but guard here too for defence in depth.
        const isUnregisteredGuest = !!currentUser && !currentUser.user_metadata?.username && !hasSeenWelcome;
        const needsWelcome =
          (isUnregisteredGuest || location.state?.showWelcome) &&
          !isAuthPage;
        
        setShowWelcomeModal(needsWelcome);
        if (location.state?.showWelcome && !isAuthPage) {
          navigate(location.pathname, { replace: true, state: {} });
        }
      } catch (error) {
        console.error('Failed to fetch user:', error);
      } finally {
        setLoadingUser(false);
        if (isNative) {
          SplashScreen.hide().catch(() => { });
        }
      }
    };

    fetchUser();
  }, [isAuthenticated, location.state?.showWelcome, navigate, location.pathname]);

  if (showIntro) {
    return <IntroVideoScreen onComplete={() => setShowIntro(false)} />;
  }

  if (isLoadingAuth || loadingUser) {
    return <FullScreenLoader />;
  }

  const handleWelcomeClose = async (updatedUser) => {
    if (updatedUser) setUser(updatedUser);
    setShowWelcomeModal(false);
  };

  return (
    <>
      <InitialWelcomeModal
        isOpen={showWelcomeModal}
        onClose={handleWelcomeClose}
        currentUsername={user?.user_metadata?.username}
      />
      {/* The three-Dailies pop-up — first three days of play. Waits for the
          Welcome modal (David: Welcome first, then this). It also opens only on
          the bare home launcher, which Layout reports to it (@/contest
          introStatus) — so never on /login, over gameplay or on a page without
          Layout. */}
      <ThreeDailiesIntroGate ready={!!user} blocked={showWelcomeModal} />
      <GlobalAdManager />
      {/* Web-only banner (no-op on native; AdMob owns native). It mirrors the
          native banner's PLACEMENT but not its routes — WebAdSlot allowlists the
          routes carrying real publisher content, per AdSense policy. The
          matching web interstitial was removed 2026-08-23: a full-screen ad over
          a contentless screen cannot be made compliant. Native interstitials are
          unchanged. */}
      <WebAdSlot />
      <Routes>
        <Route path="/login" element={<Suspense fallback={<FullScreenLoader />}><Login /></Suspense>} />
        {/* /signup removed — accounts are created via the welcome screen / Save
            Stats (username + password, optional email). Old links land on login. */}
        <Route path="/signup" element={<Suspense fallback={<FullScreenLoader />}><Login /></Suspense>} />
        <Route path="/" element={
          showWelcomeModal ? (
            <div className="fixed inset-0 bg-slate-900"></div>
          ) : isAuthenticated ? (
            <LayoutWrapper currentPageName={mainPageKey}>
              <MainPage />
            </LayoutWrapper>
          ) : (
            <FullScreenLoader />
          )
        } />
        {Object.entries(Pages)
          .filter(([path]) => path !== 'login')
          .map(([path, Page]) => (
            <Route
              key={path}
              path={`/${path}`}
              element={path === 'Sector73' ? (
                // Behind the master switch: OFF = the unknown-route page, as before Sector 73.
                <Sector73RouteGate pending={<FullScreenLoader />}>
                  <LayoutWrapper currentPageName={path}><Page /></LayoutWrapper>
                </Sector73RouteGate>
              ) : (
                <LayoutWrapper currentPageName={path}>
                  <Page />
                </LayoutWrapper>
              )}
            />
          ))}
        <Route path="*" element={<PageNotFound />} />
      </Routes>
    </>
  );
};

function App() {
  return (
    <AuthProvider>
      <QueryClientProvider client={queryClientInstance}>
        <Router>
          <NavigationTracker />
          <AuthenticatedApp />
        </Router>
        <Toaster />
      </QueryClientProvider>
    </AuthProvider>
  )
}

export default App
