import * as Sentry from '@sentry/capacitor';
import { init as sentryReactInit } from '@sentry/react';
import { Capacitor } from '@capacitor/core';

// Crash + error reporting. Wraps @sentry/capacitor (which routes JS errors
// through the native SDK so native Android/iOS crashes are captured too, and
// events survive offline). The whole module is a no-op when VITE_SENTRY_DSN is
// absent — so dev, tests, and any build without a configured DSN report nothing
// and pay no cost. See src/observability/README is not present; config lives in
// .env.local (VITE_SENTRY_DSN) and is documented in .env.example.

let initialized = false;

function appVersion() {
  // __APP_VERSION__ is injected by vite (see vite.config.js `define`). Guard the
  // reference so this module is safe to import in environments where the define
  // didn't run.
  return typeof __APP_VERSION__ === 'string' ? __APP_VERSION__ : '0.0.0';
}

/**
 * Strip obvious PII before an event leaves the device. We deliberately keep only
 * a Sentry user `id` (set via setSentryUser); emails/usernames are never sent.
 * This also defends against an email leaking in via a breadcrumb URL or message.
 */
function scrubPii(event) {
  if (event.user) {
    event.user = { id: event.user.id };
  }
  return event;
}

/**
 * Is this Sentry EVENT (not a raw caught error) an automatically-captured
 * benign AbortError? `isBenignAbort` below only filters the manual
 * `captureError` path — a cancelled network request or supabase-js's own
 * internal lock coordination that nobody catches reaches Sentry instead
 * through the SDK's global `onunhandledrejection`/`onerror` handlers, which
 * hand an event straight to `beforeSend` without ever calling `captureError`.
 * That gap is why 37-THE-MATH-PUZZLE-18/2Y kept recording this exact noise
 * (176+ events) after the manual-path fix shipped: the AbortError was real,
 * just never routed through the function meant to catch it.
 */
function isBenignAbortEvent(event) {
  const values = event?.exception?.values;
  return Array.isArray(values) && values.some((v) => v?.type === 'AbortError');
}

function beforeSend(event) {
  if (isBenignAbortEvent(event)) return null;
  return scrubPii(event);
}

/**
 * Initialize crash reporting. Idempotent and fail-safe: a missing DSN or any
 * thrown error during init leaves the app running normally with reporting off.
 * Returns true when Sentry was actually enabled.
 */
/**
 * Build the Sentry init options for a given DSN. Pure — no side effects — so a
 * smoke test can feed the exact same config into the real SDK with a capturing
 * transport and prove the capture pipeline works.
 */
export function buildSentryOptions(dsn) {
  return {
    dsn,
    // Sentry release convention is `name@version`; matches the git prod-*
    // tags and the auto-bumped package version so a crash maps to a build.
    release: `themathpuzzle37@${appVersion()}`,
    environment: import.meta.env?.MODE ?? 'production',
    // Errors only for now — no performance tracing (keeps us inside the
    // free tier; flip this on later if we want spans).
    tracesSampleRate: 0,
    // The Apple native SDK defaults this to true (unlike the JS Browser SDK,
    // which defaults it to false) — it auto-reports every failed native HTTP
    // request as an error event, including ones from third-party SDKs we
    // don't control (e.g. Google's own UMP consent endpoint returning a
    // transient 502). We already fail open around those calls; this stops
    // Sentry treating someone else's server hiccup as our crash.
    enableCaptureFailedRequests: false,
    attachStacktrace: true,
    beforeSend,
    initialScope: {
      tags: { platform: Capacitor.getPlatform() },
    },
  };
}

export function initSentry() {
  if (initialized) return true;

  const dsn = import.meta.env?.VITE_SENTRY_DSN;
  if (!dsn) return false;

  // Don't report from the local Vite dev server. Hot-reload churn there throws
  // dev-only errors (e.g. React Fast Refresh "Should have a queue") that flooded
  // the Sentry dashboard tagged environment=development, drowning out real
  // production crashes. Real builds (web, mobile, staging) run with a non-dev
  // MODE and still report. See docs/bugs.md.
  if (import.meta.env?.MODE === 'development') return false;

  try {
    Sentry.init(buildSentryOptions(dsn), sentryReactInit);
    initialized = true;
    return true;
  } catch (e) {
    console.error('Sentry init failed:', e);
    return false;
  }
}

/**
 * Attach the signed-in user's id to subsequent events (id only — no email).
 * Pass null on sign-out to clear it.
 */
export function setSentryUser(userId) {
  if (!initialized) return;
  Sentry.setUser(userId ? { id: userId } : null);
}

/**
 * A cancelled network request — navigating away, an unmounted screen, or
 * supabase-js's own internal lock coordination — throws AbortError
 * (DOMException code 20). It isn't a crash: every caller that can see one
 * already resolves to the same fallback it would for any other race. Reporting
 * it anyway flooded Sentry with cancelled-request noise (37-THE-MATH-PUZZLE-
 * 34/35/18/2H/2Y) crowding out real failures caught by the same catch. Only
 * the AbortError name is special-cased — any other DOMException (e.g. a denied
 * permission) still reports normally.
 */
function isBenignAbort(error) {
  return error?.name === 'AbortError';
}

/**
 * Coerce whatever a catch block handed us into a real Error before it reaches
 * Sentry. A plain object — e.g. the {code, details, hint, message} shape
 * Supabase's client rejects with on a failed fetch — reported via
 * Sentry.captureException as-is shows up as the generic, ungroupable "Object
 * captured as exception with keys: code, details, hint, message"
 * (37-THE-MATH-PUZZLE-2Z) instead of carrying its own message. Mirrors
 * solveFailure's asError for the same reason.
 */
function asReportableError(value) {
  if (value instanceof Error) return value;
  if (value && typeof value.message === 'string') return new Error(value.message);
  try {
    return new Error(typeof value === 'string' ? value : JSON.stringify(value));
  } catch {
    return new Error('unserialisable failure');
  }
}

/**
 * Manually report a caught error that wouldn't otherwise reach Sentry (e.g. an
 * error you swallow to keep the UI alive). No-op when reporting is off, or
 * when the error is a benign cancelled-request AbortError (see isBenignAbort).
 */
export function captureError(error, context) {
  if (!initialized || isBenignAbort(error)) return;
  const reportable = asReportableError(error);
  if (context) {
    Sentry.withScope((scope) => {
      scope.setContext('detail', context);
      Sentry.captureException(reportable);
    });
  } else {
    Sentry.captureException(reportable);
  }
}

/**
 * A `.catch()` handler that REPORTS the error, then resolves to the same
 * fallback the code used before. It replaces silent `.catch(() => null)`
 * calls: the player sees exactly what they saw before (an empty list, no
 * badges, no name), but the failure is no longer invisible (2026-10-04 sweep).
 *
 *   getCraftBadgeState(id).catch(reportedFallback('badges.craft'))
 *
 * @template T
 * @param {string} where short stable label; it becomes the Sentry 'detail.where'
 * @param {T} [fallback] what to resolve with instead (default null)
 * @returns {(error: unknown) => T}
 */
export function reportedFallback(where, fallback = null) {
  return (error) => {
    captureError(error, { where });
    return fallback;
  };
}

/**
 * Add one step to the trail Sentry attaches to the NEXT error (a breadcrumb).
 * No-op when reporting is off. Callers go through track() in ./track.js, which
 * decides what is safe to record.
 * @param {{ category: string, message: string, data?: object, level?: string }} crumb
 */
export function addBreadcrumb(crumb) {
  if (!initialized) return;
  Sentry.addBreadcrumb(/** @type {any} */ (crumb));
}

// Test-only reset so unit tests can exercise init from a clean slate.
export function __resetSentryForTests() {
  initialized = false;
}
