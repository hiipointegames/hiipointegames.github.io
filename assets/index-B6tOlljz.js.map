import { useToast } from "@/ui/primitives/use-toast";
import {
  Toast,
  ToastClose,
  ToastDescription,
  ToastProvider,
  ToastTitle,
  ToastViewport,
} from "@/ui/primitives/toast";

/**
 * The app-wide toast host, mounted once in routing/App.jsx.
 *
 * ⚠️ TWO THINGS HERE ARE LOAD-BEARING AND BOTH WERE MISSING (David, 2026-09-17:
 * "that red message box will not close or go away").
 *
 * This is shadcn's Toaster, but toast.jsx replaced the Radix primitives with
 * plain divs. Radix's <Toast> is what honoured `open`, and Radix's <Toast.Close>
 * is what made the X do something. Neither survived the swap, and nothing here
 * replaced them — so:
 *
 *   • every toast in state rendered, including ones already dismissed, and
 *   • <ToastClose /> was a bare <button> with no handler at all.
 *
 * Together those made a toast permanent until page reload. The reducer's
 * DISMISS_TOAST/REMOVE_TOAST machinery was all present and correct, which is
 * why this read as finished code; nothing ever dispatched into it.
 */
export function Toaster() {
  const { toasts, dismiss } = useToast();

  return (
    <ToastProvider>
      {toasts
        // `open: false` means dismissed — it stays in state briefly so the exit
        // animation can run (TOAST_REMOVE_DELAY), and must not be on screen for
        // that window.
        .filter((t) => t.open !== false)
        .map(function ({ id, title, description, action, open, onOpenChange, duration, ...props }) {
          // `open`/`onOpenChange`/`duration` are destructured out deliberately:
          // <Toast> is a plain <div> and spreading a function onto a DOM node is
          // a React warning, not a no-op.
          return (
            <Toast key={id} {...props}>
              <div className="grid gap-1">
                {title && <ToastTitle>{title}</ToastTitle>}
                {description && (
                  <ToastDescription>{description}</ToastDescription>
                )}
              </div>
              {action}
              <ToastClose onClick={() => dismiss(id)} aria-label="Dismiss" />
            </Toast>
          );
        })}
      <ToastViewport />
    </ToastProvider>
  );
}
