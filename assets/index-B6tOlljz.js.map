// head-to-head battle WRITE path — the persist complement of resolveBattle.js.
//
// resolveBattle.js owns the pure decisions (resolveBattleWinner /
// applyBattleOutcome) and deliberately left the side effects — the
// HeadToHeadChallenge.update + auth.updateMe writes — to callers. Those
// persist halves were hand-rolled identically in HeadToHeadGame's two
// finalize branches, and a third, drifted copy lived inline in
// ChallengeList's forfeit handler. This module owns the persistence so the
// decision + write live together on one path with tests.
//
// FROZEN — do NOT change here (see index.js "Pass 4.2-bis"):
//   The finalize is TWO parallel client-side mutations (challenge .update
//   then auth.updateMe) with NO rollback and NO idempotency guard. Both
//   players' clients can finalize the same battle; today neither short-
//   circuits on an already-completed status. That behavior is the deferred
//   server-side atomic submitBattleResult rework — these functions REPRODUCE
//   it exactly (no atomicity, no ledger, no early-return). The per-caller
//   "is the opponent done?" guard stays at the CALL SITE (the two callers use
//   different guard fields: 'forfeited' vs 'completed').
//
// Intentionally NOT here (different write shapes — would change behavior if
// unified): the ChallengeList expiry/orphan SWEEP writes (status 'forfeited'
// + their own finalized_date fallback chains), the two create-invite sites
// (different result seeds), and accept-invite. Those stay at their sites.

import { apiClient } from '@/transport';
import { nowET, todayET } from '@/daily-challenge';
import { resolveBattleWinner, applyBattleOutcome } from './resolveBattle';

/**
 * Finalize an in-game battle once the opponent is known to be done, from the
 * finishing player's perspective. Mirrors the byte-identical blocks in
 * HeadToHeadGame's saveResults (both-done) and endBattleEarly (opponent-
 * done early-exit): decide the winner, write { status, winner_id } on the
 * challenge (NO finalized_date — the in-game path has never set it; stableDate
 * derives from completed_date), then re-read the user FRESH and fold the
 * outcome into blitzStats. The fresh auth.me() re-read is load-bearing — the
 * component may have been mounted for the whole battle, so user.current is
 * stale by finalize time.
 *
 * Two parallel writes, challenge first, no rollback (see FROZEN note above).
 *
 * @param {object} p
 * @param {string} p.challengeId
 * @param {string} p.myId
 * @param {string} p.opponentId
 * @param {number} p.myScore
 * @param {number} p.opponentScore
 * @param {number} p.myFastestSolve
 * @param {number|null|undefined} p.opponentFastestSolve
 * @param {Array<{solve_time:number}>} [p.opponentSolutions]
 * @returns {Promise<string|null>} the winning player id (or null tie)
 */
export async function finalizeBattleFromGame({
  challengeId,
  myId,
  opponentId,
  myScore,
  opponentScore,
  myFastestSolve,
  opponentFastestSolve,
  opponentSolutions,
}) {
  const winner = resolveBattleWinner({
    myScore,
    opponentScore,
    myId,
    opponentId,
    myFastestSolve,
    opponentFastestSolve,
    opponentSolutions,
  });

  await apiClient.entities.HeadToHeadChallenge.update(challengeId, {
    status: 'completed',
    winner_id: winner,
  });

  const currentUser = await apiClient.auth.me();
  const blitzStats = applyBattleOutcome(currentUser['game_stats']?.blitzStats, {
    winnerId: winner,
    myId,
  });
  await apiClient.auth.updateMe({
    game_stats: {
      ...currentUser['game_stats'],
      blitzStats,
    },
  });

  return winner;
}

/**
 * Record the current player forfeiting an active/pending battle from the
 * challenge list. The forfeiter always loses, so the opponent is the winner.
 * Writes the forfeited result column + a completed/winner finalize (with
 * finalized_date — the sweep/list path DOES set it, unlike the in-game path)
 * in one update, then folds the loss into blitzStats via the shared
 * applyBattleOutcome — replacing the prior inline `totalBattles+1; losses+1`
 * math that had drifted from the pure function (it mutated in place and
 * carried two never-read high-score keys; the four counters are identical).
 *
 * Uses the caller's already-fresh user (the forfeit handler fetches it at
 * entry, ms before the writes) rather than a second re-read — matching the
 * site's existing behavior.
 *
 * @param {object} p
 * @param {object} p.currentUser - the forfeiting player (with id + game_stats)
 * @param {string} p.challengeId
 * @param {'challenger_result'|'opponent_result'} p.myResultKey
 * @param {object} p.myResult - my current result column (spread into the forfeit)
 * @param {string} p.opponentId - the winner
 * @returns {Promise<void>}
 */
export async function recordForfeit({
  currentUser,
  challengeId,
  myResultKey,
  myResult,
  opponentId,
}) {
  const forfeitedResult = {
    ...myResult,
    run_status: 'forfeited',
    completed: false,
    total_solved: 0,
    total_time_seconds: 0,
  };

  await apiClient.entities.HeadToHeadChallenge.update(challengeId, {
    [myResultKey]: forfeitedResult,
    status: 'completed',
    winner_id: opponentId,
    finalized_date: new Date().toISOString(),
  });

  const blitzStats = applyBattleOutcome(currentUser['game_stats']?.blitzStats, {
    winnerId: opponentId,
    myId: currentUser.id,
  });
  await apiClient.auth.updateMe({
    game_stats: {
      ...currentUser['game_stats'],
      blitzStats,
    },
  });
}

/**
 * Accept a pending battle invitation addressed to me: flip the challenge to
 * 'accepted', stamp today's ET date, and set a 7-day ET expiry. Extracted
 * verbatim from ChallengeList's `handleAcceptChallenge` so the SAME accept path
 * is reused by the Notifications inbox (action-center) and the Colosseum list —
 * one write shape, one place to test. Unlike the finalize writes above this is a
 * single, low-risk status transition (no stats fold, no rollback concern).
 *
 * @param {string} challengeId
 * @returns {Promise<void>}
 */
export async function acceptBattleInvite(challengeId) {
  await apiClient.entities.HeadToHeadChallenge.update(challengeId, {
    status: 'accepted',
    accepted_date: todayET(),
    expiry_date: nowET().add(7, 'days').format('YYYY-MM-DD'),
  });
}

/**
 * Decline a pending battle invitation: delete the challenge row. Extracted from
 * ChallengeList's `handleDeclineChallenge` for the same reuse-in-both-surfaces
 * reason as acceptBattleInvite.
 *
 * @param {string} challengeId
 * @returns {Promise<void>}
 */
export async function declineBattleInvite(challengeId) {
  await apiClient.entities.HeadToHeadChallenge.delete(challengeId);
}

/**
 * Cancel a pending battle invite I SENT (challenger-side). Same DB op as
 * declineBattleInvite — delete the pending row — but a distinct user intent
 * (the challenger retracting an unanswered invite vs. the recipient refusing
 * one), so it gets its own named write for the call site's clarity and in case
 * the two paths later diverge (e.g. only one clears an inbox notification).
 * Only ever call this on a `status: 'pending'` challenge where the current user
 * is the challenger.
 *
 * @param {string} challengeId
 * @returns {Promise<void>}
 */
export async function cancelBattleInvite(challengeId) {
  await apiClient.entities.HeadToHeadChallenge.delete(challengeId);
}
