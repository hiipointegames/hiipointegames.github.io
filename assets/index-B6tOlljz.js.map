import React, { useEffect, useRef, useState } from 'react';
import { Capacitor } from '@capacitor/core';
import { App as CapApp } from '@capacitor/app';

import { apiClient, withTimeout } from '@/transport';
import { recordOutcome, reportedFallback } from '@/observability';

import { contestToday } from './contestEntries';
import { useContestWeekEntries } from './useContestWeekEntries';
import {
  shouldShowThreeDailiesIntro,
  introDaysShown,
  introShownPatch,
  introOptInStep,
  introTicketsToday,
} from './threeDailiesIntroRules';
import { useHomeLauncherIdle, setIntroStatus } from './introStatus';
import { contestVisibility } from './contestVisibility';
import ThreeDailiesIntro from './ThreeDailiesIntro';

// Decides, ONCE PER ET DAY, whether today is one of this player's three pop-up
// days — and if so opens the pop-up and records the day.
//
// WHEN it decides (design D2/D3, David 2026-10-05):
//   * only while Layout reports the bare home LAUNCHER (see introStatus.js) —
//     never over gameplay, a modal, the login page or a page without Layout,
//     where the opt-in's Save Stats event would have no listener;
//   * again when the app comes back to the foreground on a NEW day
//     (visibilitychange, plus Capacitor `resume` on native). Phones resume far
//     more often than they cold-start, and a resume is an "entry into 37".
//
// It reports pending → open/done to introStatus so Layout's catch-up and secure
// prompt wait their turn (design D1).
//
// AFTER A HAND-OFF (E1): when the opt-in sends a guest to Save Stats (or an
// account to Add Email), the gate remembers it. Layout announces
// 'saveStatsClosed'; the gate re-reads the player and, if they are now fully
// entered, reopens straight into the gold "You're in" state with a welcome.
//
// MEASUREMENT (D6): shown / opt_in / dismissed / joined go to client_events as
// event 'three_dailies' (recordOutcome swallows failures; never blocks play).
//
// It re-reads the user rather than trusting App's copy, so the day list it
// extends is the stored one. Fails soft: a failed or timed-out read means no
// decision yet (the next trigger tries again); a failed write means the pop-up
// may show once more. Neither is worth interrupting the player over.

/**
 * @param {{ ready: boolean, blocked: boolean }} props
 *   ready   — App has resolved the signed-in user (guest or account)
 *   blocked — the Welcome modal owns the screen
 */
export default function ThreeDailiesIntroGate({ ready, blocked }) {
  const launcherIdle = useHomeLauncherIdle();
  // Still on the launcher NOW? The user read below is async; a player who leaves meanwhile (e.g.
  // taps the Sector 73 portal) must not get the pop-up on top of the next screen (2026-10-14).
  const idleNow = useRef(launcherIdle);
  idleNow.current = launcherIdle;
  /** The ET day the last completed decision was for. */
  const decidedDay = useRef(/** @type {string | null} */ (null));
  const inFlight = useRef(false);
  const [recheck, setRecheck] = useState(0);
  const [user, setUser] = useState(/** @type {Record<string, any> | null} */ (null));
  const [open, setOpen] = useState(false);
  const [justJoined, setJustJoined] = useState(false);
  /** The flow the opt-in handed off to, while that form is open. */
  const handoff = useRef(/** @type {null | 'openSaveStats' | 'openAddEmail'} */ (null));

  // Back from Save Stats / Add Email: entered now? Then say so.
  useEffect(() => {
    const onFormClosed = async () => {
      const flow = handoff.current;
      if (!flow) return;
      handoff.current = null;
      try {
        const fresh = await withTimeout(apiClient.auth.me(), null);
        if (!fresh || introOptInStep(fresh) !== 'in') return;
        setUser(fresh);
        setJustJoined(true);
        setOpen(true);
        setIntroStatus('open');
        recordOutcome('three_dailies', 'joined', { method: flow === 'openSaveStats' ? 'account' : 'email' });
      } catch {
        // Soft: the contest chip on Home already shows their new standing.
      }
    };
    window.addEventListener('saveStatsClosed', onFormClosed);
    return () => window.removeEventListener('saveStatsClosed', onFormClosed);
  }, []);

  // Back in the foreground on a new day → decide again.
  useEffect(() => {
    const onForeground = () => {
      if (typeof document !== 'undefined' && document.visibilityState === 'hidden') return;
      // Also covers "never decided" (null): a read that timed out earlier.
      if (decidedDay.current !== contestToday()) {
        setIntroStatus('pending');
        setRecheck((n) => n + 1);
      }
    };
    document.addEventListener('visibilitychange', onForeground);
    /** @type {{ remove?: () => void } | null} */
    let resumeHandle = null;
    let gone = false;
    if (Capacitor.isNativePlatform()) {
      Promise.resolve(CapApp.addListener('resume', onForeground))
        .then((h) => { if (gone) h?.remove?.(); else resumeHandle = h; })
        .catch(reportedFallback('contest.introResume'));
    }
    return () => {
      gone = true;
      document.removeEventListener('visibilitychange', onForeground);
      resumeHandle?.remove?.();
    };
  }, []);

  useEffect(() => {
    if (!ready || blocked || !launcherIdle || open || inFlight.current) return;
    const today = contestToday();
    if (decidedDay.current === today) return;
    inFlight.current = true;
    setIntroStatus('pending');
    (async () => {
      let shown = false;
      try {
        const fresh = await withTimeout(apiClient.auth.me(), null);
        // No user (timed out / failed): leave the day undecided so the next
        // trigger (return to the launcher, a resume) can try again.
        if (!fresh) return;
        // Left the launcher while reading: undecided, so coming back home tries again.
        if (!idleNow.current) return;
        decidedDay.current = today;
        if (!shouldShowThreeDailiesIntro(fresh, today)) return;
        setUser(fresh);
        setJustJoined(false);
        setOpen(true);
        shown = true;
        setIntroStatus('open');
        recordOutcome('three_dailies', 'shown', { day: introDaysShown(fresh).length + 1, step: introOptInStep(fresh) });
        await apiClient.auth.updateMe(introShownPatch(fresh, today));
      } catch {
        // See the header: soft on purpose.
      } finally {
        inFlight.current = false;
        if (!shown) setIntroStatus('done');
      }
    })();
  }, [ready, blocked, launcherIdle, open, recheck]);

  // Runs only for entered players (the hook skips everyone else), which is
  // exactly who sees the "Today: N of 3" line.
  const rows = useContestWeekEntries(open ? user : null);

  const step = user ? introOptInStep(user) : null;

  /** @param {'button'|'escape'|'back'|'handoff'} [how] */
  const close = (how = 'button') => {
    setOpen(false);
    setIntroStatus('done');
    if (how !== 'handoff') recordOutcome('three_dailies', 'dismissed', { step, method: how });
  };

  const openFlow = (flow) => {
    handoff.current = flow;
    window.dispatchEvent(new Event(flow));
  };

  if (!open || !user) return null;
  return (
    <ThreeDailiesIntro
      step={step}
      ticketsToday={introTicketsToday(rows, contestToday())}
      justJoined={justJoined}
      // A member who answered No sees the staircase without the giveaway.
      contest={contestVisibility(user) !== 'hidden'}
      onClose={close}
      onOpenFlow={openFlow}
      onEvent={(outcome, detail) => recordOutcome('three_dailies', outcome, detail)}
    />
  );
}
