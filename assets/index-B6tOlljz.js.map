import React, { useEffect, useRef, useState } from 'react';
import { createPortal } from 'react-dom';
import { motion, AnimatePresence, useReducedMotion } from 'framer-motion';
import { Capacitor } from '@capacitor/core';
import { App as CapApp } from '@capacitor/app';
import { Check, Ticket, Loader2 } from 'lucide-react';

import Starfield from '@/shell/Starfield';
import { apiClient } from '@/transport';
import { reportedFallback } from '@/observability';

import {
  CONTEST,
  CONTEST_ELIGIBILITY_META_KEY,
  CONTEST_LINK_LABEL,
  buildContestEligibilityAttestation,
} from './contest';
import { announceProfileChanged } from './announceProfileChanged';
import { INTRO_OPT_IN_LABEL } from './threeDailiesIntroRules';

// The "three Dailies, three entries" full-screen intro. Decisions live in
// threeDailiesIntroRules.js; this file only draws them.
//
// THE PICTURE (David picked "The Staircase", 2026-10-05): three rising steps —
// 1 Easy (green), 2 Challenge (cyan), 3 Expert (gold) — so the scale of
// difficulty reads at a glance and "climb all three" is the nudge, never said.
//
// THE ANIMATION IS THE EXPLANATION. Shown on opening the app, a player has
// usually finished nothing yet today, so a live ticket count would read 0 of 3
// — a dead number (David: "showing it early makes the tickets a moot thing").
// Instead each step completes in turn and drops a ticket into the bucket, 1 → 2
// → 3. It is a DEMO and is never presented as the player's own count; the real
// count is a separate, labelled line ("Today: N of 3 collected") for players who
// are entered.
//
// ⚠️ NO SVG FILTERS AND NO SCALE ON BIG GLOWING ELEMENTS. Animating transforms
// over a filtered SVG triggers the Android-webview compositing flicker (see the
// note in InitialWelcomeModal). Glows here are CSS box-shadows; the only scaled
// things are the small tickets.

const STEPS = [
  { n: 1, label: 'Easy', color: 'var(--u37-green)', height: 64 },
  { n: 2, label: 'Challenge', color: 'var(--u37-cyan)', height: 96 },
  { n: 3, label: 'Expert', color: 'var(--u37-gold)', height: 128 },
];

// ── The cosmic-neon idiom ───────────────────────────────────────────────────
// David, 2026-10-05: "it needs to match the cosmic neon theme". The first pass
// used solid gradient FILLS, which read as flat cards. The game never fills:
// every lit surface is the same recipe as DailyEntryButton — dark cosmic panel,
// an accent wash fading down from the top, a 3px neon border, an outer halo, an
// inset highlight, white text with an accent glow. These helpers ARE that
// recipe, so every surface here is lit the same way the home screen is.

/** A lit neon surface in `c`. */
const neonSurface = (c, wash = 30) => ({
  background: `linear-gradient(180deg, color-mix(in srgb, ${c} ${wash}%, transparent), transparent), var(--u37-panel-bg-cosmic)`,
  border: `3px solid ${c}`,
  boxShadow: `0 0 26px -6px ${c}, 0 10px 26px -10px ${c}, inset 0 1px 5px rgba(255,255,255,0.28)`,
});

/** White text glowing in `c`. */
const neonText = (c) => ({ color: 'white', textShadow: `0 0 10px ${c}, 0 0 2px ${c}` });

/** The diagonal light band the home buttons sweep across themselves. */
function Shimmer({ once = false, delay = 0 }) {
  return (
    <motion.span
      aria-hidden
      className="pointer-events-none absolute inset-y-0 -left-1/3 w-1/3 skew-x-[-18deg]"
      style={{ background: 'linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent)' }}
      initial={{ x: '0%' }}
      animate={{ x: ['0%', '460%'] }}
      transition={once
        ? { delay, duration: 0.9, ease: 'easeInOut' }
        : { delay, duration: 3.2, repeat: Infinity, ease: 'easeInOut', repeatDelay: 1.6 }}
    />
  );
}

// Stage geometry, in px. Steps stand on STEP_FLOOR; the bucket sits below.
const STEP_FLOOR = 150;
const BUCKET_TOP = 196;
const STAGE_HEIGHT = 262;
const COLUMN_X = ['16.667%', '50%', '83.333%'];

// When each step "completes" (seconds after open). The ticket lands DROP_TIME later.
const FIRST_AT = 0.7;
const GAP = 0.85;
const DROP_TIME = 0.75;

/**
 * @param {{
 *   step: 'account'|'email'|'age'|'declined'|'in',
 *   ticketsToday?: number | null,
 *   justJoined?: boolean,
 *   onClose: (how?: 'button'|'escape'|'back'|'handoff') => void,
 *   onOpenFlow?: (flow: 'openSaveStats'|'openAddEmail') => void,
 *   onEvent?: (outcome: 'opt_in'|'joined', detail: Record<string, string>) => void,
 *   contest?: boolean,
 * }} props
 *   step         — what the bottom offers, from introOptInStep
 *   ticketsToday — the player's REAL finished-today count (entered players only);
 *                  null = unknown, and then no number is shown
 *   justJoined   — reopened straight after the player became entered via Save
 *                  Stats / Add Email (E1): the "You're in" card says welcome
 *   onClose      — HOW it closed, so a hand-off to Save Stats is not counted as
 *                  the player dismissing it
 *   onOpenFlow   — opens the account/email flow; defaults to the window event
 *                  Layout already listens for
 *   onEvent      — measurement hook (the gate records it; design D6)
 */
export default function ThreeDailiesIntro({
  step, ticketsToday = null, justJoined = false, onClose, onOpenFlow, onEvent, contest = true,
}) {
  const prefersReduced = useReducedMotion();
  // Tap the staircase to skip the demo (David, 2026-10-05). A skip takes the
  // SAME path as reduced motion — "show the finished picture" — so there is
  // one still state, not two.
  const [skipped, setSkipped] = useState(false);
  const reduce = prefersReduced || skipped;
  // How many demo tickets have landed. Reduced motion → the finished picture.
  const [landed, setLanded] = useState(prefersReduced ? 3 : 0);
  // Local, so the confirm visibly takes effect without waiting for a re-read.
  const [joined, setJoined] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    if (reduce) { setLanded(3); return undefined; }
    const timers = STEPS.map((_, i) => setTimeout(
      () => setLanded((n) => Math.max(n, i + 1)),
      (FIRST_AT + i * GAP + DROP_TIME) * 1000,
    ));
    return () => timers.forEach(clearTimeout);
  }, [reduce]);

  // contest=false: a member who answered NO to 18+/US (David, 2026-10-10) — the
  // 1-2-3 staircase still teaches the three Dailies, but every giveaway part
  // (tickets, bucket, "3 entries", the opt-in, the gold card) is dropped. It is
  // shown like a declined player: no opt-in, just "Let's play".
  const shownStep = !contest ? 'declined' : joined ? 'in' : step;
  // Without the bucket the stage stops just under the step labels.
  const stageHeight = contest ? STAGE_HEIGHT : STEP_FLOOR + 30;

  // DISMISSAL (design D5). Android hardware back closes the pop-up: with no JS
  // listener, Capacitor calls webView.goBack(), which changed the page UNDER
  // the pop-up and left it on screen. Registered only while open, so the
  // default returns the moment it closes. Escape does the same on web, and
  // focus moves into the dialog so keyboard and screen-reader users land in it.
  const dialogRef = useRef(/** @type {HTMLDivElement | null} */ (null));
  const closeRef = useRef(onClose);
  closeRef.current = onClose;
  useEffect(() => {
    dialogRef.current?.focus?.();
    const onKey = (e) => { if (e.key === 'Escape') closeRef.current('escape'); };
    window.addEventListener('keydown', onKey);
    /** @type {{ remove?: () => void } | null} */
    let backHandle = null;
    let gone = false;
    if (Capacitor.isNativePlatform()) {
      Promise.resolve(CapApp.addListener('backButton', () => closeRef.current('back')))
        .then((h) => { if (gone) h?.remove?.(); else backHandle = h; })
        .catch(reportedFallback('contest.introBackButton'));
    }
    return () => {
      gone = true;
      window.removeEventListener('keydown', onKey);
      backHandle?.remove?.();
    };
  }, []);

  const skip = () => { if (!reduce) setSkipped(true); };

  const openFlow = (flow) => {
    onClose('handoff');
    if (onOpenFlow) onOpenFlow(flow);
    else window.dispatchEvent(new Event(flow));
  };

  // Same write, same guards and same surfaced error as ContestDetails'
  // confirmEligibility: a player told nothing on failure would believe they are
  // entered when they are not, which is the one harm this must never cause.
  const confirmEligibility = async () => {
    if (saving || joined) return;
    setSaving(true);
    setError('');
    try {
      await apiClient.auth.updateMe({
        [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(true),
      });
      setJoined(true);
      onEvent?.('joined', { method: 'age' });
      await announceProfileChanged();
    } catch {
      setError('Could not save that. Check your connection and try again.');
    } finally {
      setSaving(false);
    }
  };

  const onOptIn = () => {
    onEvent?.('opt_in', { step: shownStep });
    if (shownStep === 'account') openFlow('openSaveStats');
    else if (shownStep === 'email') openFlow('openAddEmail');
    else if (shownStep === 'age') confirmEligibility();
  };

  const dialog = (
    <motion.div
      role="dialog"
      aria-modal="true"
      aria-labelledby="three-dailies-title"
      data-testid="three-dailies-intro"
      ref={dialogRef}
      tabIndex={-1}
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      // z-[200]: the app's top layer, shared only with ExitWarningModal. Most
      // modals sit at z-50, but the home chrome reaches z-140 (bottom nav) and
      // celebrations z-150 — at z-50 the chrome drew OVER this and covered its
      // "Not now" button (seen at 360x800, 2026-10-05).
      className="fixed inset-0 z-[200] flex flex-col"
    >
      <div className="absolute inset-0 overflow-hidden" aria-hidden="true">
        <Starfield />
        <div className="absolute inset-0 bg-black/60 backdrop-blur-sm" />
      </div>

      <div
        className="relative z-10 flex flex-col h-full w-full max-w-md mx-auto px-5 overflow-y-auto"
        style={{
          paddingTop: 'calc(var(--safe-top) + 1.25rem)',
          paddingBottom: 'calc(var(--safe-bottom) + var(--ad-reserved-bottom) + 1rem)',
        }}
      >
        {/* ── Factor one: there are THREE Dailies ─────────────────────────── */}
        <div className="text-center">
          <div className="text-[11px] font-bold uppercase tracking-[0.3em] text-purple-100/70">
            Every day in 37
          </div>
          <h2
            id="three-dailies-title"
            className="text-3xl font-black tracking-tight leading-tight mt-1 bg-gradient-to-r from-emerald-300 via-cyan-300 to-amber-300 bg-clip-text text-transparent"
          >
            Three Dailies.
          </h2>
          <p className="text-sm text-purple-100/85 leading-snug mt-1.5 px-2">
            A fresh puzzle at every level — <span style={{ color: 'var(--u37-green)' }} className="font-bold">Easy</span>,{' '}
            <span style={{ color: 'var(--u37-cyan)' }} className="font-bold">Challenge</span> and{' '}
            <span style={{ color: 'var(--u37-gold)' }} className="font-bold">Expert</span>.
          </p>
        </div>

        {/* The violet-glow cosmic panel — the same frame InitialWelcomeModal
            uses, so the intro reads as part of that family. */}
        <div
          className="relative mt-4 rounded-3xl px-3 pt-4 pb-4 border-2 shrink-0"
          style={{
            background: 'var(--u37-panel-bg-cosmic)',
            borderColor: 'color-mix(in srgb, var(--u37-violet) 55%, transparent)',
            boxShadow: '0 0 44px -12px var(--u37-violet), 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)',
          }}
        >
        {/* ── The staircase + the bucket (the demo) ───────────────────────── */}
        {/* Keyed on the still/animated state: a skip REMOUNTS the stage in its
            finished form (initial=false everywhere) rather than trying to
            fast-forward a dozen in-flight animations. */}
        <div
          key={reduce ? 'still' : 'animated'}
          className="relative w-full max-w-[320px] mx-auto shrink-0 outline-none"
          style={{ height: stageHeight }}
          data-testid="three-dailies-stage"
          role={reduce ? undefined : 'button'}
          tabIndex={reduce ? undefined : 0}
          aria-label={reduce ? undefined : 'Skip the animation'}
          onClick={skip}
          onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); skip(); } }}
        >
          {STEPS.map((s, i) => {
            const done = landed > i || reduce;
            const completesAt = FIRST_AT + i * GAP;
            return (
              <div
                key={s.n}
                className="absolute flex flex-col items-center"
                style={{ left: COLUMN_X[i], transform: 'translateX(-50%)', bottom: stageHeight - STEP_FLOOR - 22, width: '30%' }}
              >
                <div
                  data-testid={`three-dailies-step-${s.n}`}
                  className="relative w-full rounded-2xl"
                  style={{ height: s.height }}
                >
                  {/* Unlit: dark glass, a faint outline, a dim numeral. */}
                  <div
                    className="absolute inset-0 rounded-2xl flex items-center justify-center"
                    style={{
                      background: 'var(--u37-panel-bg-cosmic)',
                      border: `3px solid color-mix(in srgb, ${s.color} 35%, transparent)`,
                    }}
                  >
                    <span
                      aria-hidden="true"
                      className="text-5xl font-black leading-none"
                      style={{ color: `color-mix(in srgb, ${s.color} 45%, transparent)` }}
                    >
                      {s.n}
                    </span>
                  </div>
                  {/* Lit: the neon recipe, faded in when the step completes. An
                      opacity crossfade rather than an animated background — CSS
                      cannot tween between two gradients, and opacity is the
                      cheapest thing a phone webview can animate. */}
                  <motion.div
                    className="absolute inset-0 rounded-2xl flex items-center justify-center overflow-hidden"
                    style={neonSurface(s.color, 34)}
                    initial={reduce ? false : { opacity: 0 }}
                    animate={{ opacity: 1 }}
                    transition={{ delay: reduce ? 0 : completesAt, duration: 0.35 }}
                  >
                    {!reduce && <Shimmer once delay={completesAt + 0.1} />}
                    <span className="relative text-5xl font-black leading-none" style={neonText(s.color)}>
                      {s.n}
                    </span>
                  </motion.div>
                  {/* The completion tick, top-right of the step. */}
                  <motion.span
                    aria-hidden="true"
                    className="absolute -top-2.5 -right-2.5 w-6 h-6 rounded-full flex items-center justify-center"
                    style={{ background: '#050310', border: `2px solid ${s.color}`, boxShadow: `0 0 10px -2px ${s.color}` }}
                    initial={reduce ? false : { opacity: 0, scale: 0.4 }}
                    animate={{ opacity: 1, scale: 1 }}
                    transition={{ delay: reduce ? 0 : completesAt + 0.15, type: 'spring', stiffness: 400, damping: 18 }}
                  >
                    <Check className="w-3.5 h-3.5" style={{ color: s.color }} strokeWidth={3.5} />
                  </motion.span>
                </div>
                <span
                  className="mt-1.5 text-[11px] font-black uppercase tracking-wider"
                  style={{ color: s.color, opacity: done ? 1 : 0.6, textShadow: done ? `0 0 8px color-mix(in srgb, ${s.color} 60%, transparent)` : 'none', transition: 'opacity 300ms' }}
                >
                  {s.label}
                </span>
              </div>
            );
          })}

          {/* The falling tickets — one per step, from its top into the bucket. */}
          {contest && !reduce && STEPS.map((s, i) => (
            <motion.div
              key={`ticket-${s.n}`}
              aria-hidden="true"
              className="absolute"
              style={{ x: '-50%', y: '-50%' }}
              initial={{ left: COLUMN_X[i], top: STEP_FLOOR - s.height, opacity: 0, scale: 0.5, rotate: 0 }}
              animate={{
                left: [COLUMN_X[i], COLUMN_X[i], '50%'],
                top: [STEP_FLOOR - s.height, STEP_FLOOR - s.height - 26, BUCKET_TOP + 26],
                opacity: [0, 1, 1, 0],
                scale: [0.5, 1.15, 0.8],
                rotate: [0, -12, i % 2 ? 18 : -18],
              }}
              transition={{ delay: FIRST_AT + i * GAP + 0.2, duration: DROP_TIME, ease: 'easeIn' }}
            >
              <Ticket className="w-7 h-7" style={{ color: s.color, filter: 'none' }} strokeWidth={2.5} />
            </motion.div>
          ))}

          {/* The bucket. Its number is the DEMO count, labelled as what three
              Dailies are worth — not as this player's entries. */}
          {contest && (
          <div
            className="absolute left-1/2 -translate-x-1/2 flex items-center justify-center gap-2 rounded-b-3xl rounded-t-md"
            style={{
              top: BUCKET_TOP,
              width: 132,
              height: STAGE_HEIGHT - BUCKET_TOP,
              ...neonSurface('var(--u37-gold)', 18 + landed * 6),
              borderTopWidth: 4,
              // The halo builds as tickets land and is full at three.
              boxShadow: `0 0 ${10 + landed * 8}px -6px var(--u37-gold), inset 0 1px 5px rgba(255,255,255,0.28)`,
              transition: 'box-shadow 300ms',
            }}
            data-testid="three-dailies-bucket"
          >
            <Ticket className="w-6 h-6" style={{ color: 'var(--u37-gold)' }} aria-hidden="true" />
            <motion.span
              key={landed}
              initial={reduce ? false : { y: -6, opacity: 0.4 }}
              animate={{ y: 0, opacity: 1 }}
              className="text-3xl font-black tabular-nums"
              style={neonText('var(--u37-gold)')}
              data-testid="three-dailies-bucket-count"
            >
              {landed}
            </motion.span>
          </div>
          )}
        </div>

        {/* ── Factor two: three Dailies = three entries ───────────────────── */}
        {!contest ? (
          <div className="text-center mt-3" data-testid="three-dailies-no-contest">
            <div className="text-lg font-black text-white">3 Dailies. A new set every day.</div>
            <p className="text-[13px] text-purple-100/80 leading-snug mt-1 px-3">
              Play all three — Easy, Challenge and Expert — and keep every streak alive.
            </p>
          </div>
        ) : (
        <div className="text-center mt-3">
          <div className="text-lg font-black text-white">
            3 Dailies <span className="text-purple-200/60">=</span>{' '}
            <span style={{ color: 'var(--u37-gold)', textShadow: '0 0 10px color-mix(in srgb, var(--u37-gold) 55%, transparent)' }}>3 entries</span>
          </div>
          <p className="text-[13px] text-purple-100/80 leading-snug mt-1 px-3">
            Every Daily you finish drops one entry into that week&apos;s{' '}
            <span className="font-black" style={{ color: 'var(--u37-gold)' }}>{CONTEST.prize}</span> giveaway.
            Your time doesn&apos;t matter — just finish.
          </p>
        </div>
        )}
        </div>

        {/* ── Bottom: opt in, or "you're in" ──────────────────────────────── */}
        <div className="mt-auto pt-5 space-y-2.5">
          <AnimatePresence mode="wait" initial={false}>
            {shownStep === 'in' ? (
              <motion.div
                key="in"
                initial={{ opacity: 0, y: 8 }}
                animate={{ opacity: 1, y: 0 }}
                className="rounded-2xl p-3.5 text-center"
                // GOLD, like the opt-in it replaces (David, 2026-10-05: "the you're
                // in or opt in should always be gold"). Gold is the prize colour;
                // that slot is the giveaway's, whichever state it is in.
                style={neonSurface('var(--u37-gold)', 22)}
                data-testid="three-dailies-in"
              >
                {justJoined && (
                  <div className="text-[12px] font-bold uppercase tracking-[0.2em] mb-1" style={{ color: 'var(--u37-gold)' }} data-testid="three-dailies-welcome">
                    Account saved — welcome aboard
                  </div>
                )}
                <div className="flex items-center justify-center gap-2 font-black" style={neonText('var(--u37-gold)')}>
                  <Check className="w-5 h-5" style={{ color: 'var(--u37-gold)' }} strokeWidth={3} />
                  You&apos;re in — collecting entries
                </div>
                {typeof ticketsToday === 'number' && (
                  <div className="mt-1.5 flex items-center justify-center gap-1.5 text-sm text-slate-200" data-testid="three-dailies-today">
                    <span className="flex gap-1" aria-hidden="true">
                      {STEPS.map((s, i) => (
                        <Ticket
                          key={s.n}
                          className="w-4 h-4"
                          style={{ color: i < ticketsToday ? s.color : 'rgba(255,255,255,0.25)' }}
                        />
                      ))}
                    </span>
                    Today: {ticketsToday} of 3 collected
                  </div>
                )}
                <div className="mt-1 text-[13px] text-purple-100/80">Remember: all three, every day.</div>
              </motion.div>
            ) : shownStep !== 'declined' ? (
              <motion.div key="opt-in" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <button
                  type="button"
                  onClick={onOptIn}
                  disabled={saving}
                  data-testid="three-dailies-opt-in"
                  className="relative overflow-hidden w-full font-black text-base min-h-[56px] rounded-2xl flex items-center justify-center gap-2 touch-manipulation active:scale-95 disabled:opacity-70"
                  // The Daily button's recipe in the prize colour, shimmer included.
                  style={neonSurface('var(--u37-gold)', 30)}
                >
                  {!reduce && <Shimmer delay={FIRST_AT + 3 * GAP} />}
                  <span className="relative flex items-center gap-2" style={neonText('var(--u37-gold)')}>
                    {saving ? <Loader2 className="w-5 h-5 animate-spin" /> : INTRO_OPT_IN_LABEL[shownStep]}
                  </span>
                </button>
                {error && (
                  <p role="alert" className="mt-1.5 text-center text-[12px] text-red-300">{error}</p>
                )}
                {/* Eligibility on the face, for the same reason the banner carries
                    it: a partial picture is worse than none (see CONTEST.eligibility). */}
                <p className="mt-1.5 text-center text-[11px] text-slate-400 leading-snug">
                  {CONTEST.eligibility} · No purchase necessary ·{' '}
                  <a href={CONTEST.rulesUrl} target="_blank" rel="noopener noreferrer" className="underline text-slate-300">
                    {CONTEST_LINK_LABEL}
                  </a>
                </p>
              </motion.div>
            ) : null}
          </AnimatePresence>

          <button
            type="button"
            onClick={() => onClose('button')}
            data-testid="three-dailies-close"
            className="relative overflow-hidden w-full min-h-[50px] rounded-2xl font-black text-base touch-manipulation active:scale-95"
            style={
              shownStep === 'in' || shownStep === 'declined'
                ? { ...neonSurface('var(--u37-green)', 30), ...neonText('var(--u37-green)') }
                : { color: 'rgb(203 213 225)', fontWeight: 700 }
            }
          >
            {(shownStep === 'in' || shownStep === 'declined') && !reduce && <Shimmer delay={FIRST_AT + 3 * GAP} />}
            <span className="relative">
              {shownStep === 'in' || shownStep === 'declined' ? "Let's play" : 'Not now — let me play'}
            </span>
          </button>
        </div>
      </div>
    </motion.div>
  );

  // Portal to <body>, like HowToOverlay and FriendsScreen. Rendered in place it
  // sits inside #root, whose `-webkit-overflow-scrolling: touch` makes its own
  // stacking context on iOS WebKit — so z-[200] only ranked it INSIDE #root, and
  // the body-portaled bottom nav (z-140) and home chrome drew over it: on iPhone
  // the pop-up showed with its buttons covered, taps landed on the chrome, and
  // with no back key the only way out was a hard close (2026-10-08). Android
  // makes no such context, which is why z-[200] alone worked there.
  return typeof document !== 'undefined'
    ? createPortal(dialog, document.body)
    : dialog;
}
