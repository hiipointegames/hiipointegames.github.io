// badgeFirstRunSeal — the QUIET badge catch-up (David, 2026-10-18).
//
// The badge family of the announced-record has a first run: until it is over,
// no surface pops a badge (a long-time player's whole history would otherwise
// arrive as a pop-up storm). It used to end ONLY when the Stats page showed its
// one-time "Your badge case" summary — so a player who never opened Stats, and
// every guest (Stats is soft-walled), never got a badge pop-up at all.
//
// Since the record became per ACCOUNT (2026-10-18), every existing player starts
// a fresh first run the day that ships. David chose a quiet catch-up over a
// summary: the first surface that holds this account's badge state simply
// records everything already earned as announced and ends the first run. No
// card, no Stats visit needed; any NEW badge from then on pops normally.
//
// Called by every badge surface — the post-solve planner and the Home catch-up
// (both via planSolveBadgeAwards) and the Stats page — so whichever runs first
// seals, and the rest see an ordinary record. Home's catch-up runs on app open,
// before any solve; on the rare path where a solve comes first, the badge that
// solve earned is sealed too (it is in the state being sealed).

import {
  readAnnouncedAwards,
  badgesAreFirstRun,
  writeAnnouncedAwards,
  markBadgeRetroShown,
  mergeAnnouncedAwards,
  badgeSnapshotAwards,
} from './announcedAwards';
import { planBadgeAnnouncement } from './badgeAnnouncements';

/**
 * If this account's badge family is still in its first run, record every badge
 * currently earned as announced and end the first run. Never throws.
 *
 * @param {Record<string, any>|null|undefined} stateById merged badge state for THIS account
 * @param {string|null|undefined} userId whose record (none → nothing happens)
 * @returns {boolean} true when it sealed (callers then show nothing this pass)
 */
export function sealBadgeFirstRun(stateById, userId) {
  if (!userId || !stateById) return false;
  try {
    const { record, isFirstRun } = readAnnouncedAwards(userId);
    if (!badgesAreFirstRun(record, isFirstRun)) return false;
    // `announced: null` = "first run": nextSnapshot is everything earned now.
    const { nextSnapshot } = planBadgeAnnouncement({ stateById, announced: null });
    return writeAnnouncedAwards(
      markBadgeRetroShown(mergeAnnouncedAwards(record, badgeSnapshotAwards(nextSnapshot))),
      userId,
    );
  } catch {
    return false;
  }
}
