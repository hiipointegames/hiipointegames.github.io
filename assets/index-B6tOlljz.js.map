import { edgeCall } from './edgeCallPort';

// Client port for the set-username edge function.
//
// This replaces a client-side write. Before 2026-09-06 the two username forms
// wrote `auth.users.user_metadata.username` via `apiClient.auth.updateMe` and
// `profiles.username` via `syncPublicProfile`, with the ONLY content check
// running in the browser — while `authenticated` holds UPDATE on
// `profiles.username`, so the check could be skipped by not being a browser.
//
// The write now goes through the server, which re-runs both the format rules and
// the moderation rule before touching anything, and cascades the new name onto
// historical `daily_challenge_times` rows.
//
// ⚠️ The client-side `validateUsername` call stays. It is not redundant: it is
// what gives immediate feedback and the appeal link without a round trip. The
// server is the authority; the client is the courtesy.

/**
 * Set the signed-in player's username (and optionally their country).
 *
 * WHOSE name is set is decided by the caller's session token, never by an
 * argument — the function takes no user id, deliberately.
 *
 * @param {string} username the name as typed; the server lowercases it
 * @param {string} [country] optional country code to save in the same call
 * @returns {Promise<import('./edgeCallPort').EdgeCallResult>} on success,
 *   `data.username` is the stored (lowercased) form and `data.cascaded` says
 *   whether historical leaderboard rows were repainted. A cascade failure is
 *   NOT an error: the name is saved either way, and reporting it as a failure
 *   would tell the player their change did not work when it did.
 */
export async function setUsername(username, country) {
  const handle = (username || '').trim();
  if (!handle) {
    return { success: false, error: { code: 'invalid_format', message: 'Username is required' } };
  }
  const payload = { username: handle };
  const trimmedCountry = (country || '').trim();
  if (trimmedCountry) payload.country = trimmedCountry;
  return edgeCall('set-username', payload);
}
