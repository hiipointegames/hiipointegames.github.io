import { useCallback, useEffect, useRef, useState } from 'react';

import { isGuest } from '@/auth';
import { appSwitchEnabled } from '@/shell';
import { onDailyResultsClosed } from './dailyResultsSignal';
import { todayET } from '@/daily-challenge';
import { getLeaderboard, getUserRank, getOwnDailyCompletions } from '@/stats-aggregation';
import { guestDigits } from '@/leaderboard';

import { shouldNudgeGuest, readLastShownDay, markShownDay, guestNudgeCopy } from './guestNudgeRules';

// Wires the guest placement nudge (see ./guestNudgeRules for the rules).
//
// Listens for the round's "results closed" signal, and only for a GUEST's
// FIRST finished Daily of the day. Then two small reads: did this guest finish
// a Daily on an earlier day (so this is day 2+), and where do they sit on
// today's board for that Daily. Every read fails SOFT — no nudge, never an
// error on screen, because this is an invitation, not a feature anyone needs.

/** Server switch (store build 2026-10-20 ships it OFF; missing row = off). */
export const GUEST_NUDGE_SWITCH = 'guest_nudge';

/** Far enough back to cover every Daily this app has ever had. */
const EARLIEST_DAILY = '2026-01-01';

/**
 * @param {Record<string, any> | null | undefined} user the current player
 * @param {boolean} [active] Home is free (no intro, catch-up, prompt or tip on
 *   screen). A nudge found while it is not WAITS and opens once it is — it never
 *   stacks on another pop-up (the Three Dailies intro shows on days 1–3 too).
 * @param {object} [deps] test seams
 * @returns {{ open: boolean, copy: ReturnType<typeof guestNudgeCopy> | null, close: () => void }}
 */
export function useGuestPlacementNudge(user, active = true, deps = {}) {
  const {
    onClosed = onDailyResultsClosed,
    today = todayET,
    readBoard = getLeaderboard,
    rankOf = getUserRank,
    readOwn = getOwnDailyCompletions,
    storage = globalThis.localStorage,
    enabled = () => appSwitchEnabled(GUEST_NUDGE_SWITCH),
  } = deps;

  const [copy, setCopy] = useState(/** @type {ReturnType<typeof guestNudgeCopy> | null} */ (null));
  const userRef = useRef(user);
  userRef.current = user;

  useEffect(() => onClosed(async (detail) => {
    const u = userRef.current;
    const userId = u?.id;
    if (!userId || !detail?.completed) return;
    const day = today();
    const guest = isGuest(u);
    if (!shouldNudgeGuest({
      isGuest: guest, firstToday: !!detail.firstToday, playedBeforeToday: true,
      lastShownDay: readLastShownDay(userId, storage), today: day,
    })) return;

    try {
      // Switched off (the default): no reads at all.
      if ((await enabled()) !== true) return;
      const earlier = await readOwn({ userId, since: EARLIEST_DAILY, before: day });
      if (!Array.isArray(earlier) || earlier.length === 0) return; // day one: leave them be
      const board = await readBoard({ date: day, mode: detail.mode });
      const rank = rankOf(board, userId);
      if (!(rank > 0)) return; // their row is not on the board (yet): say nothing rather than guess
      if (userRef.current?.id !== userId) return; // switched accounts meanwhile
      markShownDay(userId, day, storage);
      setCopy(guestNudgeCopy({ guestName: `Guest ${guestDigits(String(userId))}`, rank, mode: detail.mode }));
    } catch {
      // fail soft — see the note above
    }
  }), [onClosed, today, readBoard, rankOf, readOwn, storage, enabled]);

  // A different player (sign-up, sign-out, switch) drops an open nudge.
  useEffect(() => { setCopy(null); }, [user?.id]);

  const close = useCallback(() => setCopy(null), []);
  return { open: copy !== null && active === true, copy, close };
}
