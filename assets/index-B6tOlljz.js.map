import { useQuery } from '@tanstack/react-query';
import { apiClient } from '@/transport';
import { getFriendEdges, partitionPendingRequests } from '@/player';
import { todayET } from '@/daily-challenge';
import { pendingActionKind, isReadyBattle, isRecentResult, battleFinishedAtMs } from '@/head-to-head';

// The single source of truth for "what does this player need to act on right
// now" — the shared hook behind the Action Center on both Home and the Blitz
// Colosseum. It replaces three divergent, independently-polling predicates (the
// dead `NotificationBadges`, `Game.jsx`'s ⚔️ badge poll, and the friend Bell's
// count) with ONE query that classifies actionable items off the canonical
// `pendingActionKind` (battles, built on `perspectiveOf`) and
// `partitionPendingRequests` (friends).
//
// Actionable item types:
//   - friendRequests  : incoming friend requests I can accept  (sender ids)
//   - battleInvites   : pending battle invitations addressed to me (challenge rows)
//   - yourMoveBattles : accepted battles where the opponent finished + I haven't
//
// Sector 73 battle buckets (design-v2 B2) — derived from the SAME poll, no extra
// fetch. They are INFORMATIONAL and deliberately NOT counted in `total` (the
// badge/drawer count every existing surface shows stays exactly what it was):
//   - readyBattles  : accepted, unexpired battles I can play now (`isReadyBattle`
//                     — a superset of yourMoveBattles), in poll order
//   - recentResults : completed/forfeited battles that finished in the last
//                     24 h (`isRecentResult`), newest finish first
// "Recent" is the 24-h window itself (design-v2: "finished in the last 24 h");
// per-banner dismissal ("already shown") is a UI concern for the banner slice.
//
// One shared react-query key so multiple mounts (Home + Colosseum) dedupe to a
// single poll. Notifications don't need 3s freshness — a calmer interval keeps
// the surface responsive without hammering the backend.

export const PENDING_ACTIONS_QUERY_KEY = ['pendingActions'];
const REFETCH_MS = 15000;

const EMPTY = {
  friendRequests: [],
  battleInvites: [],
  yourMoveBattles: [],
  readyBattles: [],
  recentResults: [],
  total: 0,
  userId: null,
};

// Pure: turn the raw fetch (user + challenges + friend edges) into the
// classified buckets. Exported for direct unit testing without react-query.
// `today` (YYYY-MM-DD ET) and `nowMs` (epoch ms) are injectable for tests; left
// undefined they are read ONCE per call (todayET() / Date.now()) and shared by
// every row, not recomputed per row on each 15-s poll of the full table.
/**
 * @param {{ user: any, challenges: any, edges: any, today?: string, nowMs?: number }} input
 */
export function derivePendingActions({ user, challenges, edges, today, nowMs }) {
  if (!user || !user.id) return EMPTY;
  const me = user.id;
  const day = today ?? todayET();
  const now = nowMs ?? Date.now();

  const { incoming } = partitionPendingRequests(edges || [], me);

  const battleInvites = [];
  const yourMoveBattles = [];
  const readyBattles = [];
  const recentResults = [];
  for (const c of challenges || []) {
    const kind = pendingActionKind(c, me, day);
    if (kind === 'invite') battleInvites.push(c);
    else if (kind === 'your-move') yourMoveBattles.push(c);
    if (isReadyBattle(c, me, day)) readyBattles.push(c);
    else if (isRecentResult(c, me, now)) recentResults.push(c);
  }
  recentResults.sort((a, b) => (battleFinishedAtMs(b, now) ?? 0) - (battleFinishedAtMs(a, now) ?? 0));

  const friendRequests = incoming || [];
  return {
    friendRequests,
    battleInvites,
    yourMoveBattles,
    readyBattles,
    recentResults,
    total: friendRequests.length + battleInvites.length + yourMoveBattles.length,
    userId: me,
  };
}

async function fetchPendingActions() {
  const user = await apiClient.auth.me();
  if (!user || !user.id) return EMPTY;
  const [challenges, edges] = await Promise.all([
    apiClient.entities.HeadToHeadChallenge.list('-created_date'),
    getFriendEdges(user.id),
  ]);
  return derivePendingActions({ user, challenges, edges });
}

export function usePendingActions() {
  const { data } = useQuery({
    queryKey: PENDING_ACTIONS_QUERY_KEY,
    queryFn: fetchPendingActions,
    refetchInterval: REFETCH_MS,
    refetchIntervalInBackground: false,
    staleTime: 0,
  });
  return data || EMPTY;
}
