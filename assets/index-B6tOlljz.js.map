// badgeDeepLink — the `/Badges?mode=…&badge=…` address of a badge.
//
// The Badges page could only be opened at its default tab, so a "you just won
// this" pop-up had nowhere specific to send the player (CRISPY 2026-10-18 badge
// pop-up routing). This module is the ONE place that writes and reads that
// address, so the pop-ups (writers) and the page (reader) cannot drift.
//
//   mode   a SHOWCASE_MODES id (`easyDaily`, `colosseum`, …) — the tab to open.
//   badge  comma-separated registry badge ids — the cards to scroll to and glow.
//
// Reading is strict: an unknown mode or badge id is dropped, never trusted, so
// a stale link (a retired badge, a renamed tab) still lands on a working page.
// A link naming badges but no mode opens the FIRST badge's tab.

import { createPageUrl } from '@/routing/createPageUrl';
import { getBadge } from '@/game-mechanics';
import { SHOWCASE_MODES, showcaseMode } from './badgeShowcaseModel';

/**
 * The showcase tab that holds a registry badge, or null.
 *
 * @param {string} badgeId
 * @returns {string | null}
 */
export function showcaseModeIdForBadge(badgeId) {
  const badge = getBadge(badgeId);
  if (!badge) return null;
  return SHOWCASE_MODES.find((m) => m.modes.includes(badge.mode))?.id ?? null;
}

/**
 * Build the Badges page URL for a target.
 *
 * @param {{ modeId?: string | null, badgeIds?: string[] }} [target]
 * @returns {string}
 */
export function badgesUrl({ modeId, badgeIds = [] } = {}) {
  const params = new URLSearchParams();
  const ids = badgeIds.filter((id) => typeof id === 'string' && id);
  const mode = modeId ?? (ids[0] ? showcaseModeIdForBadge(ids[0]) : null);
  if (mode) params.set('mode', mode);
  if (ids.length) params.set('badge', [...new Set(ids)].join(','));
  const query = params.toString();
  return query ? `${createPageUrl('Badges')}?${query}` : createPageUrl('Badges');
}

/**
 * Read a target back off the page's search params.
 *
 * @param {URLSearchParams} searchParams
 * @returns {{ modeId: string | null, badgeIds: string[] }}
 */
export function parseBadgesTarget(searchParams) {
  const badgeIds = (searchParams.get('badge') ?? '')
    .split(',')
    .map((s) => s.trim())
    .filter((id) => id && getBadge(id));
  const rawMode = searchParams.get('mode');
  const modeId = rawMode && showcaseMode(rawMode)
    ? rawMode
    : (badgeIds[0] ? showcaseModeIdForBadge(badgeIds[0]) : null);
  return { modeId, badgeIds };
}
