// The text that travels WITH the share card picture.
//
// Four lines, in this order (David, 2026-09-29):
//   1. the result, written as if the player typed it
//   2. the prize line (only while the giveaway is promoted)
//   2b. the referral invite line (only while the referrals switch is on, 2026-10-20)
//   3. the rotating closing line, ending in 👇
//   4. the link
// The prize line sits ABOVE the closing line so the 👇 points at the link and not
// at the prize.
//
// The picture carries the dice; the text carries the dare and the ONLY tappable
// thing — a picture in a message cannot be tapped through, so the link here is
// the whole route into the app.

import { CONTEST, isContestPromoVisible } from '@/contest';
import { closingLineText } from './closingLines';

/**
 * "1:42" — minutes and whole seconds. Deliberately NOT formatSolveTime's
 * "01:42.37": a share is a boast, and hundredths make it read like a log line.
 * @param {number|null} seconds
 */
export function shareTime(seconds) {
  const s = Math.max(0, Math.floor(Number(seconds) || 0));
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
}

/** The landing page: open-in-app / store buttons, phone apps only. */
export const PLAY_URL = 'https://www.37themathpuzzle.com/play';

/**
 * The prize line. Uses CONTEST.eligibility VERBATIM: a shortened eligibility line
 * once told players they qualified when they did not (see contest.js).
 * @param {{ promo?: boolean }} [opts] promo overrides isContestPromoVisible() in tests
 * @returns {string|null}
 */
export function prizeLine({ promo } = {}) {
  const visible = promo === undefined ? isContestPromoVisible() : promo;
  return visible ? `🏆 ${CONTEST.prize} prize every week · ${CONTEST.eligibility}` : null;
}

/**
 * First line: what happened, in the player's voice.
 * @param {'easy'|'challenge'|'expert'} tier
 * @param {'perfect'|'solved'|'forfeit'} result
 * @param {number|null} seconds
 */
export function resultLine(tier, result, seconds) {
  const t = shareTime(seconds);
  if (result === 'forfeit') {
    if (tier === 'easy') return '37 beat me on Easy today 💀';
    if (tier === 'expert') return 'Expert 37 got me today 💀';
    return '37 beat me today 💀';
  }
  if (tier === 'easy') return `Got today's Easy 37 in ${t} 🎲`;
  // Expert only counts a Perfect, so an Expert win is always one. The rule itself
  // is left to the closing line (W9) so it is never said twice.
  if (tier === 'expert') return `Expert 37 done in ${t} ⚡ Perfect.`;
  return `Cracked today's 37 in ${t}${result === 'perfect' ? ' ⭐ Perfect.' : '.'}`;
}

/** The link, with the share's personal code when there is one. */
export function shareUrl(code) {
  return code ? `${PLAY_URL}/${code}` : PLAY_URL;
}

/**
 * The whole message.
 * @param {object} p
 * @param {'easy'|'challenge'|'expert'} p.tier
 * @param {'perfect'|'solved'|'forfeit'} p.result
 * @param {number|null} [p.seconds]
 * @param {string} p.closingLine a line id from ./closingLines
 * @param {string|null} [p.code] personal link code; null → plain /play link
 * @param {boolean} [p.promo] test override for the prize line
 * @param {string|null} [p.inviteLine] the referral line ("New to 37? Enter my username…"),
 *   made by the caller while the referrals switch is on; null → none
 * @returns {{ text: string, url: string }}
 */
export function buildShareMessage({ tier, result, seconds = null, closingLine, code = null, promo, inviteLine = null }) {
  const url = shareUrl(code);
  // The invite line sits with the prize line, above the closing line, so the
  // closing line's 👇 still points at the link.
  const lines = [resultLine(tier, result, seconds), prizeLine({ promo }), inviteLine, closingLineText(closingLine, result), url]
    .filter(Boolean);
  return { text: lines.join('\n'), url };
}
