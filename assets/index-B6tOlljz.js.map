// Canonical daily-challenge leaderboard fetch.
//
// Read path for every "what does the leaderboard look like for date X?"
// query in the app. Before extraction this logic was inlined in:
//   - Statistics.jsx        (today's leaderboard + N+1 PublicProfile.get
//                            enrichment — slow on big leaderboards)
//   - Game.jsx               (3 separate inline fetches: prefetch on mount,
//                            podium-rank check loop, parallel
//                            success-modal fetch)
//   - DailyChallengeModal.jsx (challenge-date fetch + batch-list
//                            PublicProfile enrichment)
//
// The N+1 path in Statistics.jsx was the slow one — large leaderboards
// triggered hundreds of PublicProfile.get calls. The batch-list pattern
// in DailyChallengeModal.jsx is the right shape and is the one this
// canonical function adopts.
//
// ─────────────────────────────────────────────────────────────────────────────
// ANTI-CHEAT: this read is now GATED SERVER-SIDE. Phase 1 of two.
// ─────────────────────────────────────────────────────────────────────────────
// This module used to read `daily_challenge_times` directly, selecting
// DAILY_TIME_PUBLIC_COLUMNS — which includes `equation`, `usedDiceIndices`,
// `diceColors` and `shuffledDice`, i.e. THE ANSWERS — for the whole of today with
// NO viewer gate. Every Daily sub-tab calls getLeaderboard on mount whether or not
// the board is locked, so a player who had not yet played today already held every
// solver's winning equation in their browser. `locked` only suppressed painting it.
//
// Moving the gate here, client-side, would have been worthless: the person who
// opens DevTools is exactly the person who would peek. So the decision moved to the
// `daily-board` edge function (supabase/functions/daily-board/), which withholds
// the four solution columns — and today's dice — from a viewer who has not
// completed or forfeited that date IN THAT MODE. Past days are never gated, and a
// viewer who has finished gets everything, exactly as before.
//
// ⚠️ PHASE 1 ONLY. The underlying table read is NOT tightened — that is Phase 2,
// after OTA adoption soaks, because revoking the direct read now would break every
// installed client that has not yet taken the update. Which is also why
// `getDailyBoard` falls back to the old direct read when the endpoint is
// unreachable (see below): this change must be safe to deploy in either order.

import { apiClient, edgeCall, DAILY_TIME_PUBLIC_COLUMNS } from '@/transport';
import { sortByPodiumOrder } from './podiumOrder';
import { canViewerSeeToday, todayET } from '@/daily-challenge';
import { getProfilesByIds } from '@/player';
import { reportedFallback } from '@/observability';
import { isWarpEquation } from '@/sector73';

// PostgREST returns at most ~1000 rows per select. A day's leaderboard read used
// a naive `select('*')` with NO order and NO pagination — so once a day has more
// than ~1000 solvers (very possible at tens of thousands of users) it silently
// truncated to an arbitrary, UNORDERED 1000: the genuinely fastest times past
// row 1000 vanished, and even the visible "top" was wrong. This fetches the full
// day server-side ORDERED by solve time, paging past the cap. See W2-F3.
export const LEADERBOARD_PAGE_SIZE = 1000;

/** Challenge's Daily — the legacy wire key. See src/game-modes/modeKeys.js. */
export const DEFAULT_DAILY_MODE = 'daily';

const DAILY_BOARD_FUNCTION = 'daily-board';

// ─────────────────────────────────────────────────────────────────────────────
// In-flight de-duplication
// ─────────────────────────────────────────────────────────────────────────────
// Every Daily sub-tab mounts DailyPuzzleDisplay (which wants the dice) alongside
// its own board fetch (which wants the rows) — two requests for the same
// (date, mode) in the same tick. This collapses them into one.
//
// It caches ONLY IN-FLIGHT promises, never settled results, and drops each entry
// the moment it settles. A TTL cache would be a bug here: the instant after a
// player solves, SuccessModal re-reads the board and MUST see the now-unlocked
// answer. Serving them a cached LOCKED board would look exactly like the leak
// this change exists to close, in reverse.
const inFlight = new Map();

function dedupe(key, run) {
  const existing = inFlight.get(key);
  if (existing) return existing;
  const promise = run().finally(() => inFlight.delete(key));
  inFlight.set(key, promise);
  return promise;
}

/**
 * @typedef {object} DailyBoard
 * @property {Array<object>} rows   the day's completions, fastest first. While
 *   `locked`, each row OMITS equation/usedDiceIndices/diceColors/shuffledDice and
 *   carries a server-derived `is_perfect_solve` boolean in their place.
 * @property {number[]|null} dice   the day's roll, or null while locked.
 * @property {boolean} locked       true when solutions were withheld.
 * @property {boolean} gated        true when this date is subject to the gate.
 * @property {boolean} degraded     true when the gated endpoint was unreachable
 *   and this fell back to the legacy direct read (see getDailyBoard).
 * @property {any} rowsError        the board query's error when the fallback's
 *   row read failed while its dice read succeeded, else null. Carried rather than
 *   thrown so one failing read cannot blank the other; getLeaderboard re-throws it.
 */

/**
 * A day's board, through the server-side anti-cheat gate.
 *
 * @param {{date: string, mode?: string, includeDice?: boolean}} args
 * @returns {Promise<DailyBoard>}
 */
export async function getDailyBoard({ date, mode = DEFAULT_DAILY_MODE, includeDice = false }) {
  if (!date) throw new Error('getDailyBoard requires a date');
  return dedupe(`${date}|${mode}`, async () => {
    let result;
    try {
      result = await edgeCall(DAILY_BOARD_FUNCTION, { date, mode, includeDice });
    } catch (error) {
      // edgeCall answers domain failure in-band, so a THROW means the port itself
      // could not run. Same meaning as an unreachable endpoint — fall through.
      result = { success: false, error: { code: 'edge_call_threw', message: String(error?.message || error) } };
    }
    if (result?.success && result.data && Array.isArray(result.data.rows)) {
      const { rows, dice, locked, gated } = result.data;
      return { rows, dice: dice ?? null, locked: !!locked, gated: !!gated, degraded: false, rowsError: null };
    }
    // PHASE 1 RESILIENCE, and the reason this commit is safe to deploy before the
    // edge function is. If `daily-board` is not deployed yet (or is briefly
    // failing), fall back to the read this replaced so no board ever goes blank.
    // The fallback is exactly today's behaviour — an ungated read plus the
    // client-side display gate — so it adds no exposure that is not already there
    // while the table is still world-readable. PHASE 2 DELETES THIS BRANCH along
    // with the direct read it depends on.
    console.warn(
      `[leaderboard] ${DAILY_BOARD_FUNCTION} unavailable (${result?.error?.code || 'unknown'}); ` +
      'falling back to the ungated direct read.',
    );
    return fetchBoardDirect({ date, mode, includeDice });
  });
}

// The legacy ungated read. Retained ONLY as the Phase 1 fallback above.
//
// The board read and the dice read are INDEPENDENT here, and a failure in one
// does not blank the other. That is deliberate and it restores what the app did
// before this change: DailyPuzzleDisplay fetched the day's roll for itself, so a
// leaderboard query error never took the puzzle block down with it, and vice
// versa. The rows failure is not swallowed — it is carried out as `rowsError` and
// re-thrown by getLeaderboard, which is the caller that actually needs the rows.
async function fetchBoardDirect({ date, mode = DEFAULT_DAILY_MODE, includeDice }) {
  const gated = date === todayET();
  const [rowsResult, canSee, dice] = await Promise.all([
    fetchDayTimesOrdered(date, mode).then(
      (rows) => ({ rows, error: null }),
      (error) => ({ rows: [], error }),
    ),
    gated ? viewerCanSee(date, mode) : Promise.resolve(true),
    includeDice ? fetchDice(date, mode) : Promise.resolve(null),
  ]);
  const locked = gated && !canSee;
  return {
    rows: rowsResult.rows,
    rowsError: rowsResult.error,
    dice: locked ? null : dice,
    locked,
    gated,
    degraded: true,
  };
}

async function viewerCanSee(date, mode = DEFAULT_DAILY_MODE) {
  try {
    const user = await apiClient.auth.me().catch(reportedFallback('leaderboard.me'));
    return await canViewerSeeToday(user, date, mode);
  } catch (error) {
    console.error('[leaderboard] viewer gate lookup failed; failing closed:', error);
    return false; // fail closed
  }
}

async function fetchDice(date, mode = DEFAULT_DAILY_MODE) {
  try {
    // C7: WHICH mode's roll. Unfiltered, this returned an arbitrary one of the
    // three rows for the date — and it is the roll every Daily sub-tab paints.
    const challenges = await apiClient.entities.DailyChallenge.filter({ date, mode });
    return challenges?.[0]?.dice || null;
  } catch (error) {
    console.error("[leaderboard] failed to load the day's dice:", error);
    return null;
  }
}

async function fetchDayTimesOrdered(date, mode = DEFAULT_DAILY_MODE) {
  const all = [];
  for (let from = 0; ; from += LEADERBOARD_PAGE_SIZE) {
    const { data, error } = await apiClient.supabase
      .from('daily_challenge_times')
      // Email-free display-column allowlist (NOT select('*')) — the public
      // leaderboard must never ship any player's user_email to the browser.
      // Typed as '*' so supabase-js keeps inferring the row shape (a runtime
      // string otherwise yields GenericStringError). Type-only; runtime unchanged.
      .select(/** @type {'*'} */ (DAILY_TIME_PUBLIC_COLUMNS))
      .eq('date', date)
      // C5: one board per (date, mode). Without this the three modes share one
      // list ordered by time, and Easy's times — the easiest puzzle of the three
      // — sort straight to the top of Challenge's and Expert's boards.
      .eq('mode', mode)
      // Order server-side so a capped page still holds the ACTUAL fastest, and so
      // pagination is stable: user_id is unique per date, a deterministic
      // tiebreak that guarantees no row is skipped or duplicated across pages.
      .order('solve_time_seconds', { ascending: true })
      .order('user_id', { ascending: true })
      .range(from, from + LEADERBOARD_PAGE_SIZE - 1);
    if (error) throw error;
    if (!data || data.length === 0) break;
    all.push(...data);
    if (data.length < LEADERBOARD_PAGE_SIZE) break;
  }
  return all;
}

// Returns the leaderboard array for a given date, sorted by solve time
// ascending. Each entry is a DailyChallengeTime row. When
// enrichProfiles=true, each entry is enriched with puzzle_points and
// battle_points pulled from the matching PublicProfile, fetched through the
// player read path (getProfilesByIds — one `.in(...)` query scoped to the
// date's participants, not a full-table PublicProfile.list() scan).
//
// The array contract is unchanged, which is what lets every existing caller stay
// as it is. What changed is where the rows come from: the gated endpoint above.
// On a LOCKED board the rows arrive without the four solution columns and with a
// server-derived `is_perfect_solve` flag instead — see getDailyBoard.
//
// `mode` selects WHICH daily board (Challenge's Daily by default, the legacy
// 'daily' key). It is gated per mode server-side: solving Easy's Daily does not
// earn you Expert's answers.
export async function getLeaderboard({ date, enrichProfiles = false, mode = DEFAULT_DAILY_MODE }) {
  if (!date) {
    throw new Error('getLeaderboard requires a date');
  }

  const { rows: boardRows, rowsError } = await getDailyBoard({ date, mode });
  // A failed board read must NOT return an empty leaderboard — a silently empty
  // board reads as "nobody solved today", which is a lie. The dice block tolerates
  // this failure (see fetchBoardDirect); the leaderboard cannot.
  if (rowsError) throw rowsError;
  // Sector 73: the server ships `warp` on every row; the direct-read fallback
  // does not, so derive it from the equation there.
  const dayTimes = boardRows.map((row) =>
    (typeof row.warp === 'boolean' ? row : { ...row, warp: isWarpEquation(row.equation) }));

  // PODIUM ORDER, not time order. Sorting by time alone left tied rows in the
  // order PostgREST paged them — `user_id`, a UUID — while the medal is credited
  // to the EARLIEST submission. Every caller that reads a rank out of this array
  // (the home podium banner, the stats page, the share card) was therefore able
  // to disagree with the medal the server granted. See ./podiumOrder.
  if (!enrichProfiles) {
    return sortByPodiumOrder(dayTimes);
  }

  const profileMap = await getProfilesByIds(dayTimes.map((t) => t.user_id));

  const enriched = dayTimes.map((entry) => ({
    ...entry,
    puzzle_points: profileMap.get(entry.user_id)?.puzzle_points || 0,
    battle_points: profileMap.get(entry.user_id)?.battle_points || 0,
  }));

  return sortByPodiumOrder(enriched);
}

/**
 * One player's OWN daily completions in a date window.
 *
 * The podium celebration needs to know which (date, mode) races this player
 * actually finished before it can ask how they placed in any of them — asking
 * the other way round would mean pulling a full board for every day in the
 * window whether they played it or not.
 *
 * Reads the table directly rather than through `getDailyBoard`'s gate, and that
 * is safe on both counts: the rows are the caller's own, and the three columns
 * are the board's date, its mode and a time — nothing that could reveal an
 * answer. All three are in DAILY_TIME_PUBLIC_COLUMNS, i.e. confirmed present on
 * prod; PostgREST 400s the whole read on a missing column.
 *
 * Rows with a non-positive or missing time are NOT completions — the same rule
 * `podiumFinishes.rankDate` applies server-side, so a forfeit can never be
 * mistaken for a race entered.
 *
 * @param {{userId: string, since: string, before: string}} p
 *   `since` inclusive, `before` EXCLUSIVE — pass today's ET date, because a
 *   day's podium is not decided until that day closes.
 * @returns {Promise<Array<{date: string, mode: string|null, solve_time_seconds: number}>>}
 */
export async function getOwnDailyCompletions({ userId, since, before }) {
  if (!userId || !since || !before) return [];
  const { data, error } = await apiClient.supabase
    .from('daily_challenge_times')
    // Typed as '*' so supabase-js keeps inferring the row shape — a runtime
    // string otherwise yields GenericStringError. Type-only; runtime unchanged.
    .select(/** @type {'*'} */ ('date,mode,solve_time_seconds'))
    .eq('user_id', userId)
    .gte('date', since)
    .lt('date', before);
  if (error) throw error;
  return /** @type {any[]} */ (data || []).filter(
    (row) => row && typeof row.solve_time_seconds === 'number' && row.solve_time_seconds > 0,
  );
}

// 1-indexed rank within a leaderboard array, or 0 if the user isn't
// present (matches the legacy `findIndex(...) + 1` idiom).
export function getUserRank(leaderboard, userId) {
  if (!Array.isArray(leaderboard) || !userId) return 0;
  return leaderboard.findIndex((entry) => entry.user_id === userId) + 1;
}

// The earliest daily-challenge date on record ('YYYY-MM-DD'), or null if there
// are no challenges yet. The historical date navigator (D2) uses this as the
// lower bound so a player can scroll back to the very first daily but no further.
// Additive read — does not change getLeaderboard's contract. Ungated on purpose:
// a date is not an answer.
export async function getFirstDailyDate(mode = DEFAULT_DAILY_MODE) {
  const { data, error } = await apiClient.supabase
    .from('daily_challenges')
    .select('date')
    // Per mode: Easy and Expert start the day they are first generated, which is
    // LATER than Challenge's first daily. An unfiltered earliest-date would let
    // the navigator scroll a new mode back to 2026-03-03, where it has no rows —
    // an empty board that looks like a bug rather than a mode that did not exist.
    //
    // `mode` is this function's only parameter, so it is positional by the
    // contract (3.4) rather than an options object; there is no trailing
    // argument for a refactor to silently drop.
    .eq('mode', mode)
    .order('date', { ascending: true })
    .limit(1);
  if (error) throw error;
  return data?.[0]?.date ?? null;
}
