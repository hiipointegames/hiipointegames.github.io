// The "three Dailies, three entries" intro — WHEN it shows and WHAT it offers.
//
// David, 2026-10-05: a full-screen pop-up on each player's first THREE DAYS of
// play that explains there are three Dailies (Easy, Challenge, Expert), that
// each one finished is one entry into the weekly giveaway, and offers an opt-in.
// Once a player is in, the opt-in is replaced by "you're in" on the days left.
//
// Decisions recorded from the interview (so nobody re-litigates them):
//   * "a day" = a distinct ET calendar day the player OPENS the app — gaps are
//     fine (Mon, Thu, Sat is three). ET because that is when the Daily rolls.
//   * shown on opening, before they play — it teaches the three BEFORE they pick.
//   * EVERY player, counted from the day this ships, existing players included.
//   * brand-new players see the Welcome screen first, then this.
//
// Pure on purpose: the component draws, this decides, and the decisions are the
// part worth testing without a DOM.

import { contestNudgeFor } from './contest';
import { MAX_ENTRIES_PER_DAY } from './contestEntries';

/** How many distinct days a player sees the intro. */
export const THREE_DAILIES_INTRO_DAYS = 3;

/** Where the shown-on days live: their OWN top-level `user_metadata` key.
 *
 *  Per ACCOUNT rather than per device (localStorage), so a player who plays on
 *  a phone and a laptop gets three showings, not six. Guests have metadata too
 *  (anonymous auth), so it works for them.
 *
 *  ⚠️ NOT INSIDE `game_stats`, AND THAT IS A FIX, NOT A STYLE CHOICE. The first
 *  version kept the days in game_stats beside `hasSeenInitialWelcomeModal`. On
 *  staging (2026-10-05) the intro opened, the write was sent, and minutes later
 *  the key was gone while the welcome flag survived. Game.jsx's saveGameState
 *  writes back the WHOLE game_stats copy it loaded at mount — so any key added
 *  after that page mounted is erased by its next save. `updateUser` merges
 *  metadata one level deep, so a top-level key cannot be touched by anything
 *  that rewrites game_stats. Same home as CONTEST_ELIGIBILITY_META_KEY. */
export const THREE_DAILIES_INTRO_META_KEY = 'three_dailies_intro_days';

/**
 * The days this player has already been shown the intro.
 *
 * Reads both the merged shape (`me()` spreads metadata onto the top level) and
 * the raw `user_metadata` shape. Anything malformed reads as "no days", which
 * fails toward SHOWING — the cost of an extra showing is one tap; the cost of a
 * read error silently hiding it forever is the whole feature.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {string[]} 'YYYY-MM-DD' ET days, oldest first
 */
export function introDaysShown(user) {
  const days = user?.user_metadata?.[THREE_DAILIES_INTRO_META_KEY] ?? user?.[THREE_DAILIES_INTRO_META_KEY];
  return Array.isArray(days) ? days.filter((d) => typeof d === 'string') : [];
}

/**
 * Should the intro open for this player today?
 *
 * @param {Record<string, any> | null | undefined} user
 * @param {string} today 'YYYY-MM-DD' in ET (contestToday())
 * @returns {boolean}
 */
export function shouldShowThreeDailiesIntro(user, today) {
  if (!user || !today) return false;
  const days = introDaysShown(user);
  if (days.includes(today)) return false;
  return days.length < THREE_DAILIES_INTRO_DAYS;
}

/**
 * The metadata patch to send once the intro has been shown today.
 *
 * Only our own key — `updateUser` merges top-level keys, so nothing else is
 * touched and there is nothing to spread (see THREE_DAILIES_INTRO_META_KEY).
 *
 * @param {Record<string, any> | null | undefined} user
 * @param {string} today
 * @returns {Record<string, string[]>}
 */
export function introShownPatch(user, today) {
  const days = introDaysShown(user);
  return { [THREE_DAILIES_INTRO_META_KEY]: days.includes(today) ? days : [...days, today] };
}

/**
 * What the bottom of the intro offers this player.
 *
 *   'account'  — guest: the button opens Save Stats (account + email + 18+ question)
 *   'email'    — account, no email: the button opens Add Email
 *   'age'      — account + email: the button IS the 18+/US affirmation
 *   'declined' — said they are not eligible: NO button. They answered, and the
 *                contest module's rule is that the app owes them not asking
 *                again. The three Dailies still show — they are the game.
 *   'in'       — eligible: "you're in — collecting entries"
 *
 * A thin mapping over contestNudgeFor rather than a second eligibility check, so
 * the intro can never disagree with the chip and the contest sheet about where a
 * player stands.
 *
 * @param {Record<string, any> | null | undefined} user
 * @returns {'account'|'email'|'age'|'declined'|'in'}
 */
export function introOptInStep(user) {
  return contestNudgeFor(user) ?? 'in';
}

/** The opt-in button's label per step. The words say what the tap DOES, because
 *  "Opt in" on a guest that then shows a password form reads as a bait-and-switch. */
export const INTRO_OPT_IN_LABEL = Object.freeze({
  account: 'Opt in — create your free account',
  email: 'Opt in — add your email',
  age: "Opt in — I'm 18+ and in the US",
});

/**
 * How many distinct Dailies this player has finished TODAY, from the week's rows.
 *
 * Distinct by mode: a duplicate row must not read as two entries. Returns null
 * when the rows are unknown, so the caller shows no number rather than a wrong
 * one (same rule as contestEntries: a confidently wrong count is worse than none).
 *
 * @param {{date?: string, mode?: string}[] | null | undefined} rows
 * @param {string} today
 * @returns {number | null}
 */
export function introTicketsToday(rows, today) {
  if (!Array.isArray(rows)) return null;
  const modes = new Set(rows.filter((r) => r?.date === today && r?.mode).map((r) => r.mode));
  return Math.min(modes.size, MAX_ENTRIES_PER_DAY);
}
