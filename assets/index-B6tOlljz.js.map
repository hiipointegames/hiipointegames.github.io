/**
 * @typedef {Object} HomeLauncherState
 * @property {boolean} dailyGameActive - the daily full-screen game surface
 *   (DailyChallengeGame via dc.showGame) is mounted.
 * @property {boolean} compactGameActive - the easy/challenge full-screen compact
 *   game surface (showCompactGame) is mounted.
 * @property {boolean} diceRolled - a puzzle is in play on the (legacy) inline path.
 * @property {boolean} showSuccess - the solve-results / celebration modal is open.
 * @property {number} pendingAwardCount - queued award celebrations (0 = none).
 * @property {boolean} showDailyStartWarning - the daily pre-game rules modal is open.
 * @property {boolean} showPlayWarning - the easy/challenge pre-game "Ready?" modal is open.
 */

/**
 * Whether the bare home launcher is the active, unobstructed surface — i.e.
 * whether the global home chrome (Notifications bell + hamburger drawer +
 * Save-Stats button) should show. That chrome belongs ONLY on a mode's home
 * launcher; the moment any game surface, modal, or celebration is layered on
 * top, it must hide until the player is back on the launcher.
 *
 * This gates directly on the full-screen game-surface flags
 * (`dailyGameActive` / `compactGameActive`) rather than inferring "in a game"
 * from `diceRolled` alone. Those states are set in different places in Game.jsx
 * and can desync — e.g. the success-modal "play again" path reopens the compact
 * game (`setShowCompactGame(true)`) WITHOUT re-setting `diceRolled`, which
 * leaked the home chrome on top of the in-game screen (David, 2026-07-11).
 * Keeping every gate here (surfaces + the inline diceRolled + success + awards +
 * both pre-game modals) means the launcher chrome shows only when truly nothing
 * is on top of it.
 *
 * @param {HomeLauncherState} state
 * @returns {boolean} true only when the unobstructed launcher is active.
 */
export function isHomeLauncherActive({
  dailyGameActive,
  compactGameActive,
  diceRolled,
  showSuccess,
  pendingAwardCount,
  showDailyStartWarning,
  showPlayWarning,
}) {
  return (
    !dailyGameActive &&
    !compactGameActive &&
    !diceRolled &&
    !showSuccess &&
    pendingAwardCount === 0 &&
    !showDailyStartWarning &&
    !showPlayWarning
  );
}

/**
 * Whether Layout should mount the top home chrome (Save-Stats pill +
 * Notifications bell + hamburger drawer) right now. The companion to
 * `isBottomNavVisible` / `isSiteFooterVisible`: same shape, same inputs, kept
 * pure so the rule is testable without a DOM.
 *
 * Two gates, both necessary:
 *  • `currentPageName === 'Game'` — the chrome belongs to the home launcher only.
 *  • `homeChromeVisible` — the launcher is unobstructed by anything the GAME page
 *    put on top (gameplay, results/celebration, pre-game modals). Game.jsx
 *    computes this with `isHomeLauncherActive` and broadcasts it.
 *
 * `overlayOpen` closes the remaining hole: modals owned by LAYOUT itself (Save
 * Stats / create account, Edit Profile, the guided secure-account prompt) are
 * invisible to Game.jsx, so `homeChromeVisible` stays true under them. The
 * chrome is portaled to <body> AFTER the modal in document order at the same
 * z-50, so it painted straight over the "Save Your Stats" screen — David saw a
 * live Save-Stats button and hamburger sitting on the modal that the Save-Stats
 * button had just opened (1.0.292). Feeding Layout's own modal state in here
 * fixes it with the same signal the rest of the chrome already rides, rather
 * than a second mechanism.
 *
 * @param {{ currentPageName: string, homeChromeVisible: boolean, overlayOpen?: boolean }} state
 * @returns {boolean}
 */
export function isHomeChromeVisible({ currentPageName, homeChromeVisible, overlayOpen = false }) {
  if (overlayOpen) return false;
  return currentPageName === 'Game' && homeChromeVisible;
}
