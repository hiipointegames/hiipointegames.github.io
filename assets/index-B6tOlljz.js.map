// badgeVisuals — the pure visual-language layer for the Badge System Redesign
// (Lane E, §9.4 of .workshop/badge-system-redesign-proposal-2026-07-30.md).
//
// This module is PURE: no React, no fetching, no badge-state computation. It
// turns a badge definition from the registry (`@/game-mechanics` — Lane C) plus
// a badge-state object (from Lanes B/D) into the strings and tokens the L3
// detail components paint with.
//
// Three hard rules it encodes:
//   1. FRAME/SHAPE encodes CATEGORY — flames = Streaks · hexagons = tiered
//      Milestones/Speed · shields = on-ramp first-times · cosmic orbs = Craft ·
//      laurels = Blitz Colosseum + podium. (§9.4)
//   2. THE CARD'S OUTLINE encodes the DIFFICULTY TIER — Easy green · Challenge
//      cyan · Expert gold · Solo Blitz blue · Blitz Battle magenta
//      (`modeAccentVar`). A
//      Challenge badge must read as a CHALLENGE badge on sight, which the old
//      rarity-only scheme could not do: every tier-1 badge in the catalog came
//      out the same green regardless of where you earned it.
//   3. RARITY lives on the INNER GLOW behind the art — still the six-stop neon
//      wheel in ui/theme/tokens.css via `rarityVar`, exactly like MilestoneBadge.
//
// Round 2 added a THIRD axis that this module does not own but must not fight:
// per-badge IDENTITY (@/game-mechanics/badgeIdentity).
//
// R2-G (David, 2026-08-02) then decided WHICH of identity and rarity gets the
// medal, per badge — see `badgeMedalAxis`. A TIERED badge's medal is painted in
// its TIER colour (the rung you're standing on is the thing worth seeing); a
// ONE-TIME badge, which has no rung, keeps its identity colour. Rule 2 above is
// unaffected either way: the card's OUTLINE is always the mode.
//
// Nothing here emits a colour literal — every colour is a `var(--u37-*)` token.
// (Identity is the one derived-arithmetic exception, and it lives in its own
// module with its anchors pinned back to those same tokens.)

import { rarityVar, badgeTiers, badgeTierCount, badgeIdentityColor } from '@/game-mechanics';

/**
 * @typedef {import('@/game-mechanics/badgeRegistry').Badge} Badge
 *
 * The state object Lanes B/D produce for one badge. Every field is optional —
 * these components must render safely on a partial/absent state (an unearned
 * badge legitimately has nothing but `earned: false`).
 * @typedef {Object} BadgeState
 * @property {boolean} [earned]
 * @property {number} [count]          How many times the feat was performed (×N).
 * @property {number} [tier]           0-based highest tier reached; -1/undefined = none.
 * @property {string} [earliestDate]   ISO date of the earliest qualifying solve.
 * @property {string|null} [tierReachedDate] ISO date the CURRENT tier was reached, where derivable.
 * @property {boolean} [retroactive]   Explicit stamp; otherwise derived vs `launchDate`.
 * @property {number} [durationSeconds] Battle length, for duration-scaled ladders.
 */

/** The five frame shapes. Consumed by BadgeFrame's SVG switch. */
export const BADGE_FRAME_SHAPES = ['flame', 'hexagon', 'shield', 'orb', 'laurel'];

// Registry categories → frame shape. The spec'd mappings are literal; the
// categories the spec didn't name are assigned by what they ARE: on-ramp badges
// are one-time first-times (shield), dojo badges are volume ladders (hexagon,
// like the other tiered milestones), and the podium "competition" badges are
// victory laurels alongside the arena.
//
// The `firsts` row is gone with the category itself (Round 2 § D3): its five
// shields moved to the mode they are earned in, so they now take that mode
// section's shape rather than a shape of their own.
const CATEGORY_FRAME = {
  streaks: 'flame',
  speed: 'hexagon',
  mastery: 'hexagon',
  dojo: 'hexagon',
  onRamp: 'shield',
  craft: 'orb',
  arena: 'laurel',
  competition: 'laurel',
};

/**
 * The frame shape for a badge category. Unknown/absent categories fall back to
 * the cosmic orb (the redesign's default badge silhouette).
 * @param {string} [category]
 * @returns {'flame'|'hexagon'|'shield'|'orb'|'laurel'}
 */
export function frameForCategory(category) {
  return CATEGORY_FRAME[category] ?? 'orb';
}

// Registry mode → the accent token its badges wear. This is the MODE axis: the
// grouped outline around a badge, not the badge's own colour (that is
// `identity`, see @/game-mechanics/badgeIdentity).
//
// `crossArena` (Arena Master) takes the Colosseum magenta — it is the Colosseum
// capstone and rides that section. `any` has no members since § D3 but keeps an
// entry so a future cross-mode badge is never unpainted.
//
// ⚠️ These MUST agree with the `[data-mode]` rules in ui/theme/tokens.css, which
// is what paints the filter chips and section headings. `badgeModeTokens.test.js`
// parses the stylesheet and fails if the two drift.
//
// COLOUR IS THE DIFFICULTY TIER (2026-09-04). Easy green · Challenge cyan ·
// Expert gold — the same palette the GAME screen paints those modes in, so a
// badge finally looks like the mode it came from. Round type (Daily vs
// Practice) is carried by the section heading, not by a second colour.
//
// `daily` (Challenge's Daily) moved off `--u37-violet`, which is the accident
// David called out. The violet was inherited when the tier-colour sweep moved
// Challenge onto cyan and dropped `daily` onto the violet it vacated; only
// Challenge's move was intended (see commit 0555490). With one section per
// Daily tier there is no single "Daily" arena for it to paint, so the badge
// screen simply stops reading it. `[data-mode="daily"]` STAYS in tokens.css —
// the game screen's slides still emit it — it just has no badge left using it.
const MODE_ACCENT = {
  dailyEasy: 'var(--u37-green)',
  daily: 'var(--u37-cyan)',
  dailyExpert: 'var(--u37-gold)',
  easy: 'var(--u37-green)',
  challenge: 'var(--u37-cyan)',
  expert: 'var(--u37-gold)',
  soloBlitz: 'var(--u37-blue)',
  blitzBattle: 'var(--u37-magenta)',
  crossArena: 'var(--u37-magenta)',
  any: 'var(--u37-cyan)',
};

/**
 * The frame accent token for a badge's mode. An unknown/absent mode falls back
 * to the inherited `--u37-mode-accent` slot rather than a literal, so a future
 * registry mode paints as whatever container it lands in instead of going blank.
 * @param {string} [mode]
 * @returns {string} A `var(--u37-*)` string.
 */
export function modeAccentVar(mode) {
  return MODE_ACCENT[mode] ?? 'var(--u37-mode-accent)';
}

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRY MODE  ->  `[data-mode]` THEME NAME
// ─────────────────────────────────────────────────────────────────────────────
// These are TWO VOCABULARIES and they are not the same one.
//
//   registry modes  dailyEasy · daily · dailyExpert · easy · challenge ·
//                   expert · soloBlitz · blitzBattle · crossArena · any
//                                               (badgeRegistry's BADGE_MODES)
//   theme names     daily · challenge · easy · solo-blitz · blitz-battle ·
//                   expert                      (the [data-mode] rules in
//                                                ui/theme/tokens.css)
//
// They overlap on the first three, which is the whole reason the confusion
// survived: `data-mode={badge.mode}` LOOKED correct on a Challenge badge and was
// simply wrong on a Solo Blitz one, where `data-mode="soloBlitz"` matches no rule
// and the element silently inherits whatever `--u37-mode-accent` is in scope --
// `:root`'s Challenge cyan outside the showcase, which sets the slot inline.
// This is the same class of mistake `modeThemeName` (src/game-flow/modeTheme.js)
// was written to end on the GAME side; badges needed their own map because the
// game's vocabulary has no `soloBlitz` and its `modeOf` would coerce one to Easy.
//
// `crossArena` rides the Colosseum chip, so it wears the Colosseum theme -- the
// same grouping SHOWCASE_MODES uses, pinned against it by badgeModeTokens.test.js.
// `any` has no members and no chip of its own, so it maps to NOTHING rather than
// to a guess: an absent `data-mode` inherits the container's mode, which is the
// correct behaviour for a badge that deliberately belongs to no single arena.
const MODE_THEME = {
  dailyEasy: 'easy',
  daily: 'challenge',
  dailyExpert: 'expert',
  easy: 'easy',
  challenge: 'challenge',
  expert: 'expert',
  soloBlitz: 'solo-blitz',
  blitzBattle: 'blitz-battle',
  crossArena: 'blitz-battle',
};

/**
 * The `[data-mode]` theme name for a badge's registry mode.
 *
 * Returns '' -- never the raw key -- for anything unmapped, so a registry mode
 * added later inherits its container's colour instead of leaking an internal
 * identifier into the DOM and resolving to the `:root` default.
 *
 * @param {string} [mode] a registry mode key
 * @returns {string} a theme name tokens.css defines, or ''
 */
export function badgeModeTheme(mode) {
  return MODE_THEME[mode] ?? '';
}

/** Human label for the mode chip in the detail header. */
const MODE_LABEL = {
  dailyEasy: 'Easy Daily',
  daily: 'Challenge Daily',
  dailyExpert: 'Expert Daily',
  easy: 'Easy Practice',
  challenge: 'Challenge Practice',
  expert: 'Expert Practice',
  soloBlitz: 'Solo Blitz',
  blitzBattle: 'Blitz Colosseum',
  crossArena: 'All Arenas',
  any: 'Any Mode',
};

/**
 * Display label for a badge's mode. Unknown modes echo back unchanged so a
 * future registry mode never renders as blank.
 * @param {string} [mode]
 * @returns {string}
 */
export function modeLabel(mode) {
  return MODE_LABEL[mode] ?? (mode || '');
}

// Cryptic hints for hidden badges. A hidden badge must never leak its criteria
// before it's earned (§9.4 — "the pop-up IS the reveal"), so the modal shows one
// of these instead of `criteriaText`.
const HIDDEN_HINTS = {
  echoOf37: 'Some numbers echo. Listen for 37 on the way to 37.',
  resonance: 'An echo, struck perfectly.',
  totalEclipse: 'Sometimes an opponent never gets going at all.',
  lookingGlass: 'Some numbers look better in a mirror.',
};

/**
 * The cryptic hint shown in place of the real criteria for an unearned hidden
 * badge. Falls back to a generic teaser so a newly-added hidden badge is never
 * blank.
 * @param {Badge | null | undefined} badge
 * @returns {string}
 */
export function hiddenHint(badge) {
  if (!badge) return 'A hidden feat. You will know it when it happens.';
  return HIDDEN_HINTS[badge.featId] ?? 'A hidden feat. You will know it when it happens.';
}

/**
 * Should this badge render as a locked silhouette? True only for hidden badges
 * the player has NOT earned — once earned, a hidden badge renders normally.
 * @param {Badge | null | undefined} badge
 * @param {BadgeState | null | undefined} state
 * @returns {boolean}
 */
export function isSilhouetted(badge, state) {
  return Boolean(badge?.hidden) && !state?.earned;
}

/**
 * Is this badge a PERFECT VARIANT — the prestige shadow of a base craft feat,
 * counting only the qualifying solves that were also perfect solves?
 *
 * Reads the registry's `perfectOf` field rather than matching ids, so adding a
 * variant needs no change here.
 *
 * @param {Badge | null | undefined} badge
 * @returns {boolean}
 */
export function isPerfectVariant(badge) {
  return Boolean(badge?.perfectOf);
}

/**
 * Which metal the perfect WREATH is struck in, or null for no wreath.
 *
 * WHY A WREATH AND NOT A COLOUR. The palette has no spare hue: `--u37-tier-1..6`
 * and the mode accents are the SAME six values under two names, so `--u37-gold`
 * is byte-for-byte `--u37-tier-6` (mythic). Painting "perfect" as a gold FILL
 * would therefore restate rarity — the exact defect Round 2 § C removed when it
 * retired gold as the twin marker. A wreath separates from rarity by FORM, so
 * gold keeps meaning "perfect" (as it already does on the calendar, the weekly
 * cards and the solved-equation dice) without touching the three-ring system:
 * the card outline is still MODE, the medal still IDENTITY, the halo still RARITY.
 *
 * WHY THE METAL VARIES BY MODE. Perfect solves happen in both modes, but the
 * Daily is the shared once-a-day event, so its variants stay the more special
 * one (David, 2026-08-02): gold on Daily, platinum on Challenge.
 *
 * Suppressed on a silhouette for the same reason the rarity glow is: a hidden
 * badge must leak nothing about itself before the reveal, and a wreath would
 * announce "this one is a perfect variant".
 *
 * NB `wreath`, not `laurel` — `SHAPE_PATHS.laurel` in BadgeFrame.jsx is already
 * the Blitz Colosseum CATEGORY frame. Different axis, different word.
 *
 * @param {Badge | null | undefined} badge
 * @param {BadgeState | null | undefined} [state]
 * @returns {'gold' | 'platinum' | null}
 */
export function perfectWreathMetal(badge, state) {
  if (!isPerfectVariant(badge) || isSilhouetted(badge, state)) return null;
  return badge?.mode === 'challenge' ? 'platinum' : 'gold';
}

/**
 * Is this badge stamped "Earned Retroactively"? Either the derivation lane said
 * so explicitly (`state.retroactive`), or the earliest qualifying solve predates
 * the feature launch. With no `launchDate` and no explicit flag, it is not
 * retroactive — we never guess a stamp onto a freshly-earned badge.
 * @param {BadgeState | null | undefined} state
 * @param {string} [launchDate] ISO date the badge system went live.
 * @returns {boolean}
 */
export function isRetroactive(state, launchDate) {
  if (!state?.earned) return false;
  if (typeof state.retroactive === 'boolean') return state.retroactive;
  if (!launchDate || !state.earliestDate) return false;
  return String(state.earliestDate) < String(launchDate);
}

/**
 * Human "earned on" line for an ISO date (`2026-07-30` → `July 30, 2026`).
 * Deliberately hand-rolled rather than moment-based: this is one format string
 * on a leaf component and the date is a plain `YYYY-MM-DD` from the log, so
 * parsing it as UTC-noon avoids the timezone-shift class of bug entirely.
 * @param {string} [isoDate]
 * @returns {string}
 */
export function formatEarnedDate(isoDate) {
  if (!isoDate) return '';
  const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(isoDate));
  if (!match) return '';
  const [, y, m, d] = match;
  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const monthName = months[Number(m) - 1];
  if (!monthName) return '';
  return `${monthName} ${Number(d)}, ${y}`;
}

/** `0:30`, `1:30`, `10:00` — the ladder format the speed records already use. */
function formatSeconds(value) {
  const mins = Math.floor(value / 60);
  const secs = Math.round(value % 60);
  return `${mins}:${String(secs).padStart(2, '0')}`;
}

/** `1,000` — thousands separators without pulling in a formatter dependency. */
function withThousands(value) {
  return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

/**
 * The headline label for one rung of a badge's ladder.
 *
 * Every ladder shape the registry declares is covered:
 *   - explicit `tierNames`      → the name ("Commander", "Gold", "Juggernaut")
 *   - `direction: 'descending'` → "Under 0:30" (speed records, fastest solves)
 *   - `unit`                    → "5 wins in a row", "15 puzzle margin"
 *   - `countLadder`             → "×10" (the existing repeat-count flourish)
 *   - plain `thresholdLadder`   → "1,000"
 *
 * @param {Badge | null | undefined} badge
 * @param {number} index 0-based tier position.
 * @param {number} [durationSeconds] Selects the row for duration-scaled ladders.
 * @returns {string}
 */
export function tierLabel(badge, index, durationSeconds) {
  if (!badge) return '';
  if (badge.scaling?.type === 'oneTime') return 'Earned';

  const tiers = badgeTiers(badge, durationSeconds);
  const value = tiers[index];
  if (value == null) return '';

  const named = badge.scaling?.tierNames?.[index];
  if (named) return named;

  if (badge.scaling?.direction === 'descending') {
    // Seconds ladders read as a clock; anything else descending is a bare number.
    return badge.scaling?.unit === 'seconds' ? `Under ${formatSeconds(value)}` : `Under ${withThousands(value)}`;
  }
  if (badge.scaling?.unit) return `${withThousands(value)} ${badge.scaling.unit}`;
  if (badge.scaling?.type === 'countLadder') return `×${withThousands(value)}`;
  return withThousands(value);
}

/**
 * The "how to earn it" sentence for ONE rung of a badge's ladder.
 *
 * The registry's `criteriaText` describes the badge as a WHOLE, so a laddered
 * badge's copy lists every rung at once ("past 100, then 1,000, 10,000 and
 * 100,000"). In the detail modal that is noise: the player is looking at one
 * tier in the carousel and wants that tier's bar. This narrows it.
 *
 * Three sources, in order:
 *   1. `badge.criteriaTemplate` — the registry's hand-written one-rung sentence.
 *      Placeholders: `{value}` (thousands-separated tier number), `{time}` (the
 *      tier's seconds as a clock), `{label}` (the carousel's headline label for
 *      the rung), `{s}` (plural "s", empty when the value is 1).
 *   2. A count ladder with no template repeats the SAME act, so the whole-badge
 *      sentence still describes it — the rung is just how many times.
 *   3. Anything else (one-time badges, single-rung ladders, an out-of-range
 *      index) falls back to `criteriaText` unchanged.
 *
 * @param {Badge | null | undefined} badge
 * @param {number} [index] 0-based tier position; defaults to the first rung.
 * @param {number} [durationSeconds] Selects the row for duration-scaled ladders.
 * @returns {string}
 */
export function tierCriteriaText(badge, index = 0, durationSeconds) {
  if (!badge) return '';
  const base = badge.criteriaText ?? '';
  if (badge.scaling?.type === 'oneTime') return base;

  const tiers = badgeTiers(badge, durationSeconds);
  if (tiers.length <= 1) return base;

  const safeIndex = Math.min(Math.max(Number.isFinite(index) ? index : 0, 0), tiers.length - 1);
  const value = tiers[safeIndex];
  if (value == null) return base;

  // A STAGE LADDER'S RUNGS ARE DIFFERENT REQUIREMENTS, so each carries its own
  // sentence rather than a shared template over a tier VALUE.
  //
  // This is the fix for the 88 circular rungs (2026-09-04). The craft twins used
  // `criteriaTemplate: 'Reach {label} — in the Daily Challenge.'`, and `{label}`
  // is the rung's own name — so the modal answered "How to earn Tier 1 of 6"
  // with "Reach One Cluster", which is the question restated. That was 44% of
  // the whole catalog and 100% of the craft badges, which are the marquee cards
  // on the Daily hero. `criteria` says what the player DOES; `criteriaScope`
  // says where.
  const stageCriteria = badge.scaling?.stages?.[safeIndex]?.criteria;
  if (stageCriteria) {
    return badge.criteriaScope ? `${stageCriteria} — ${badge.criteriaScope}.` : `${stageCriteria}.`;
  }

  if (badge.criteriaTemplate) {
    return badge.criteriaTemplate
      .replace(/\{value\}/g, withThousands(value))
      .replace(/\{time\}/g, formatSeconds(value))
      .replace(/\{label\}/g, tierLabel(badge, safeIndex, durationSeconds))
      .replace(/\{s\}/g, value === 1 ? '' : 's');
  }

  // A count ladder is "do the same thing N times", so the whole-badge sentence
  // is already the right description of the ACT — only the repeat count is
  // per-tier, and the first rung is the act done once.
  if (badge.scaling?.type === 'countLadder') {
    return value <= 1 ? base : `${base} Do it ${withThousands(value)} times in total.`;
  }

  return base;
}

/**
 * The rarity colour token for a tier — position on the six-stop wheel, so a
 * ladder flows weakest→strongest exactly like a MilestoneBadge row. Since the
 * mode-colour pass this paints the INNER GLOW behind the art (and the tier
 * label), not the frame: see `modeAccentVar` for what the frame wears.
 * @param {Badge | null | undefined} badge
 * @param {number} index
 * @returns {string} A `var(--u37-tier-N)` string.
 */
export function tierRarityVar(badge, index) {
  return rarityVar(index, badgeTierCount(badge));
}

/**
 * Does this badge have a LADDER — more than one rung to climb?
 *
 * The single source of the tiered/one-time distinction. Three separate presentation
 * decisions hang off it and they must never disagree:
 *   1. the tier CAPTION under the name (`BadgeCard`),
 *   2. the ×N count PILL, which a one-time badge must never show ("First Solve ×121"
 *      is self-contradictory — David, device testing of beta 1.0.289),
 *   3. which colour axis paints the MEDAL (`badgeMedalColor` below).
 *
 * Derived from `scaling.type` plus the real rung count, never from a list of badge
 * ids, so a one-time badge added tomorrow inherits all three behaviours for free.
 * The two conditions are belt-and-braces: today they agree exactly (the ten
 * `oneTime()` badges are precisely the ten with a single rung), but a laddered
 * badge whose scaling collapses to one rung should still not read as a ladder.
 *
 * @param {Badge | null | undefined} badge
 * @returns {boolean}
 */
export function isTieredBadge(badge) {
  return badge?.scaling?.type !== 'oneTime' && badgeTierCount(badge) > 1;
}

/**
 * Which colour axis owns a badge's MEDAL — `'tier'` or `'identity'`.
 *
 * ROUND 2 R2-G (David, 2026-08-02): *"the outline stays mode-specific coloured, but
 * the inner image is what changes to the tier colour to provide more contrast
 * between the various different badges and tiers."*
 *
 * Each badge uses the dimension that actually applies to it. A TIERED badge gains
 * far more from showing which rung you are standing on than from a per-badge hue,
 * so tier takes its image. A ONE-TIME badge has no rung, so tier colour would be
 * meaningless there — identity keeps those ten cards distinguishable.
 *
 * The MODE axis is untouched either way: it lives on the card's outline
 * (`modeAccentVar`), never on the medal.
 *
 * The knowingly-accepted cost: two tiered badges in the same mode at the same tier
 * now look alike, separated by glyph and label. That is the trade David asked for —
 * do not "fix" it by mixing identity back into the image.
 *
 * @param {Badge | null | undefined} badge
 * @returns {'tier' | 'identity'}
 */
/**
 * The three podium ladders wear their PLACE metal, not their rung colour.
 *
 * R2-H (David, 2026-08-05), from device review: with the tally row removed, the
 * badge cards became the only podium surface — and all three rendered the same
 * tier-1 green, so first, second and third were indistinguishable at a glance.
 * Gold/silver/bronze is not decoration here, it is the *meaning* of the thing;
 * a podium badge that does not carry its metal has lost its primary signal.
 *
 * This is the deliberate exception to the tier-owns-the-medal rule. It is safe
 * from R2-C's "gold quietly claims mythic rarity" problem for the same reason
 * the old struck medals were: these three carry a 1/2/3 numeral glyph, so the
 * metal reads as podium place, not as rarity. The rung is still visible — it is
 * the tier caption under the card and the ×N pill — it simply no longer owns
 * the fill.
 *
 * Keyed by badge id rather than category: `competition` also holds the one-time
 * First Podium shield, which has no place and must keep its identity colour.
 */
const PODIUM_PLACE_METAL = /** @type {const} */ ({
  podiumFirst: 'var(--u37-medal-gold)',
  podiumSecond: 'var(--u37-medal-silver)',
  podiumThird: 'var(--u37-medal-bronze)',
});

export function badgeMedalAxis(badge) {
  if (badge?.id && badge.id in PODIUM_PLACE_METAL) return 'medal';
  return isTieredBadge(badge) ? 'tier' : 'identity';
}

/**
 * The colour a badge's MEDAL is painted in — the tier hue for a laddered badge,
 * its own identity colour for a one-time one. See `badgeMedalAxis`.
 *
 * @param {Badge | null | undefined} badge
 * @param {number} index 0-based tier position (ignored for one-time badges).
 * @returns {string} A `var(--u37-tier-N)` token or an `hsl()` identity string.
 */
export function badgeMedalColor(badge, index) {
  const metal = badge?.id ? PODIUM_PLACE_METAL[badge.id] : undefined;
  if (metal) return metal;
  return isTieredBadge(badge) ? tierRarityVar(badge, index) : badgeIdentityColor(badge);
}

/**
 * The tier a badge card should show as "current": the highest tier reached, or
 * the first rung when nothing is earned yet. Always inside the ladder's bounds
 * so a stale/oversized `state.tier` can never index off the end.
 * @param {Badge | null | undefined} badge
 * @param {BadgeState | null | undefined} state
 * @returns {number}
 */
export function currentTierIndex(badge, state) {
  const total = badgeTierCount(badge);
  if (total <= 0) return 0;
  const raw = state?.tier;
  if (!Number.isFinite(raw) || /** @type {number} */ (raw) < 0) return 0;
  return Math.min(/** @type {number} */ (raw), total - 1);
}

/**
 * Is tier `index` lit (earned) for this state? A tier is lit when the player's
 * highest reached tier is at or above it AND the badge is earned at all.
 * @param {BadgeState | null | undefined} state
 * @param {number} index
 * @returns {boolean}
 */
export function isTierEarned(state, index) {
  if (!state?.earned) return false;
  const reached = state.tier;
  if (!Number.isFinite(reached)) return index === 0; // earned, tier unknown → first rung only
  return index <= /** @type {number} */ (reached);
}
