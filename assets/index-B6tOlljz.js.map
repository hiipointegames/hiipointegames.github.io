// Shared equation evaluation and validation utilities

import { hasPowerDice, requiresPerfectSolve } from '@/game-modes';

// Normalize Unicode operator symbols to ASCII equivalents
const normalizeEquation = (equation) => {
  return equation
    .replace(/×/g, '*')      // U+00D7 multiplication sign
    .replace(/−/g, '-')      // U+2212 minus sign
    .replace(/÷/g, '/')      // U+00F7 division sign
    .replace(/＋/g, '+');     // U+FF0B fullwidth plus sign
};

// Make the game's implicit multiplication explicit, so tokenize/eval see a
// well-formed binary expression. Juxtaposition is legal input in the builder
// (`operatorPairAllowed('4','(')` is true), so `4(3+2)`, `)(` and `)4` all mean
// "times". One home for the three rewrites, shared by evaluateEquation,
// getPowerDiceCorrectness and parseEquationAST — they must stay identical or
// the AST a predicate reads would differ from the AST the evaluator scored.
const insertImplicitMultiplication = (equation) =>
  equation
    .replace(/(\d)\(/g, '$1*(')   // 4( → 4*(
    .replace(/\)\(/g, ')*(')      // )( → )*(
    .replace(/\)(\d)/g, ')*$1');  // )4 → )*4

const OPERATOR_CHARS = new Set(['+', '-', '*', '/', '^', '(', ')']);

// The ONLY adjacent operator pairs the game permits. Anything else with two
// operators touching — two regular operators (`/+`, `*-`, `++`), or a
// paren/operator combo not listed here — is rejected. This is the single source
// of truth for "are these two operators allowed to sit next to each other",
// shared by the draft input guard (draftReducer INSERT_OPERATOR) and the
// evaluator below.
export const ALLOWED_OPERATOR_PAIRS = new Set([
  '^(', '((', '))', '+(', '-(', '*(', '/(', ')+', ')-', ')*', ')/', ')^', ')(',
]);

// True if `a` immediately followed by `b` is a legal adjacency. Non-operator
// chars (digits) are always fine; two operators are fine only if whitelisted.
export const operatorPairAllowed = (a, b) =>
  !(OPERATOR_CHARS.has(a) && OPERATOR_CHARS.has(b)) || ALLOWED_OPERATOR_PAIRS.has(a + b);

// True if the equation contains any disallowed adjacent-operator pair. Catches
// the unary-operator trap: JS Function() reads `1/+1` as `1/(+1)` = 1, so the
// evaluator would otherwise silently accept a malformed equation as a valid
// solve. See docs/bugs.md 2026-06-09.
export const hasDisallowedOperatorPair = (equation) => {
  for (let i = 0; i < equation.length - 1; i++) {
    if (!operatorPairAllowed(equation[i], equation[i + 1])) return true;
  }
  return false;
};

// A "touching issue" is anything that makes the visible equation ill-formed for
// the builder UI: two dice fused into one number (fewer numbers than dice used),
// or a disallowed adjacent-operator pair. Drives the result `?` display and the
// "resolve touching values or operators" banner in EquationBuilder. The
// operator-pair half shares the one whitelist above (no duplicate pattern list).
export const equationHasTouchingIssue = (equation, usedDiceIndices = []) => {
  if (!equation || equation.length === 0 || !usedDiceIndices) return false;
  const numbersInEquation = equation.match(/\d+/g) || [];
  if (numbersInEquation.length < usedDiceIndices.length) return true;
  return hasDisallowedOperatorPair(equation);
};

// Safe equation evaluator
// Now includes validation to prevent two dice numbers from touching
export const evaluateEquation = (equation, usedDiceIndices = [], shuffledDice = []) => {
  try {
    // Normalize Unicode symbols to ASCII
    equation = normalizeEquation(equation);

    // Reject malformed adjacent operators (e.g. '/+', '*-'). Without this the
    // JS evaluator treats the second operator as unary ('1/+1' -> 1) and a
    // malformed equation reads as a valid 37-solve. See docs/bugs.md 2026-06-09.
    if (hasDisallowedOperatorPair(equation)) {
      return { valid: false, result: null };
    }

    // Preprocess: Insert implicit multiplication operators
    const processedEquation = insertImplicitMultiplication(equation);

    let evalStr = processedEquation.replace(/\^/g, '**');

    if (!/^[\d+\-*/().^ **]+$/.test(evalStr)) {
      return { valid: false, result: null };
    }

    let parenCount = 0;
    for (const char of evalStr) {
      if (char === '(') parenCount++;
      if (char === ')') parenCount--;
      if (parenCount < 0) return { valid: false, result: null };
    }
    if (parenCount !== 0) return { valid: false, result: null };



    const result = Function('"use strict"; return (' + evalStr + ')')();

    if (typeof result !== 'number' || !isFinite(result)) {
      return { valid: false, result: null };
    }

    return { valid: true, result: Math.round(result * 1000) / 1000 };
  } catch {
    return { valid: false, result: null };
  }
};

// Issue-type codes for the draft validator below. Each issue carries a
// `severity`:
//   'error'      — a real mistake you must DELETE to fix (red in the UI)
//   'incomplete' — a not-yet-finished spot you'll RESOLVE by adding more (blue)
// Both keep Submit disabled, but only 'error' is presented as a mistake. The
// distinction is the "valid prefix" test: can this become valid by appending
// (incomplete), or must you go back and delete (error)?
// Do not rename without updating the builder.
export const DRAFT_ERROR = {
  TOUCHING_DICE: 'TOUCHING_DICE',           // error      — two dice fused (e.g. 55)
  OPERATORS_ADJACENT: 'OPERATORS_ADJACENT', // error      — two arithmetic operators jammed (÷+, ++)
  OPERATOR_INCOMPLETE: 'OPERATOR_INCOMPLETE', // incomplete — an operator missing a number on a side
  UNMATCHED_PARENS: 'UNMATCHED_PARENS',     // incomplete — a parenthesis with no partner
  INVALID: 'INVALID',                       // incomplete — generic backstop (empty parens, etc.)
};

// Arithmetic operators that require an operand on each side. Parens are
// operators too, but their balance is judged separately (UNBALANCED_PARENS), so
// they are not in this set.
const ARITHMETIC_OPS = new Set(['+', '-', '*', '/', '^']);
// A left operand for an arithmetic operator is a digit or a closing paren;
// a right operand is a digit or an opening paren.
const isLeftOperand = (ch) => ch != null && (/\d/.test(ch) || ch === ')');
const isRightOperand = (ch) => ch != null && (/\d/.test(ch) || ch === '(');

// Classify every structural problem in an in-progress draft into an ordered
// list of { type, severity, message, tokenIndices }. This is the single source
// of truth the UI uses for (a) per-token coloring (red for 'error', blue for
// 'incomplete') and (b) Submit gating — Submit is enabled only when this
// returns an empty array (no errors AND no incomplete spots).
//
// `tokenIndices` are character offsets into `equation`. Per the ADR-0003
// one-char-per-token invariant, a char offset equals the draft token index, so
// callers can use these directly as token / render-span indices.
//
// An empty draft has no issues — the initial state is incomplete, not wrong.
export const collectDraftErrors = (equation, usedDiceIndices = []) => {
  if (!equation || equation.length === 0) return [];
  const eq = normalizeEquation(equation);
  const issues = [];

  // ── ERRORS (red — a mistake you must DELETE to fix) ──────────────────────

  // Touching dice — two adjacent digits fuse into one number ('5','5' → 55).
  const touching = new Set();
  for (let i = 0; i < eq.length - 1; i++) {
    if (/\d/.test(eq[i]) && /\d/.test(eq[i + 1])) {
      touching.add(i);
      touching.add(i + 1);
    }
  }
  if (touching.size > 0) {
    issues.push({
      type: DRAFT_ERROR.TOUCHING_DICE,
      severity: 'error',
      message: 'Touching dice',
      tokenIndices: [...touching].sort((a, b) => a - b),
    });
  }

  // Operators out of order — two ARITHMETIC operators jammed together (÷+, ++,
  // ×−). This is the ÷+ unary-trap family (docs/bugs.md 2026-06-09): two
  // operators with no number between them. (Paren/operator combos like '(+' are
  // NOT this — they're an operator missing a number, handled as 'incomplete'.)
  const adjacentOps = new Set();
  for (let i = 0; i < eq.length - 1; i++) {
    if (ARITHMETIC_OPS.has(eq[i]) && ARITHMETIC_OPS.has(eq[i + 1])) {
      adjacentOps.add(i);
      adjacentOps.add(i + 1);
    }
  }
  if (adjacentOps.size > 0) {
    issues.push({
      type: DRAFT_ERROR.OPERATORS_ADJACENT,
      severity: 'error',
      message: 'Operators out of order',
      tokenIndices: [...adjacentOps].sort((a, b) => a - b),
    });
  }

  // ── INCOMPLETE (blue — a valid prefix you'll RESOLVE by adding more) ──────

  // An arithmetic operator missing a number on a side — a trailing '1÷', a
  // leading '÷5', or one against a paren edge ('(+', '+)'). Skip any operator
  // already flagged as an out-of-order ERROR above (red wins).
  const incompleteOps = new Set();
  for (let i = 0; i < eq.length; i++) {
    if (!ARITHMETIC_OPS.has(eq[i]) || adjacentOps.has(i)) continue;
    if (!isLeftOperand(eq[i - 1]) || !isRightOperand(eq[i + 1])) {
      incompleteOps.add(i);
    }
  }
  if (incompleteOps.size > 0) {
    issues.push({
      type: DRAFT_ERROR.OPERATOR_INCOMPLETE,
      severity: 'incomplete',
      message: 'Operator needs a number',
      tokenIndices: [...incompleteOps].sort((a, b) => a - b),
    });
  }

  // A parenthesis with no matching partner — an unclosed open OR an extra close.
  // An open paren is "incomplete" (you owe a ')'); an extra close is the same
  // family here (you'll add the open or delete it) — both are non-alarming blue.
  const unmatched = new Set();
  const openStack = [];
  for (let i = 0; i < eq.length; i++) {
    if (eq[i] === '(') {
      openStack.push(i);
    } else if (eq[i] === ')') {
      if (openStack.length === 0) unmatched.add(i); // close with no open
      else openStack.pop();
    }
  }
  for (const idx of openStack) unmatched.add(idx); // opens never closed
  if (unmatched.size > 0) {
    issues.push({
      type: DRAFT_ERROR.UNMATCHED_PARENS,
      severity: 'incomplete',
      message: 'Unmatched parentheses',
      tokenIndices: [...unmatched].sort((a, b) => a - b),
    });
  }

  // Generic backstop — anything else evaluateEquation still rejects (empty
  // parens '()', illegal chars, divide-by-zero) not explained above. Treated as
  // 'incomplete' (blocks Submit, no token highlight): the draft just isn't a
  // finished, valid equation yet.
  if (issues.length === 0) {
    const { valid } = evaluateEquation(eq, usedDiceIndices);
    if (!valid) {
      issues.push({ type: DRAFT_ERROR.INVALID, severity: 'incomplete', message: 'Finish the equation', tokenIndices: [] });
    }
  }

  return issues;
};

// Parse equation into tokens
const tokenize = (equation) => {
  const tokens = [];
  let i = 0;

  while (i < equation.length) {
    const char = equation[i];

    if (/\d/.test(char)) {
      let num = char;
      i++;
      while (i < equation.length && /\d/.test(equation[i])) {
        num += equation[i];
        i++;
      }
      tokens.push({ type: 'number', value: parseInt(num) });
    } else if ('+-*/^()'.includes(char)) {
      tokens.push({ type: 'operator', value: char });
      i++;
    } else {
      i++; // Skip unknown characters
    }
  }

  return tokens;
};

// Build AST using Pratt parsing (handles PEMDAS correctly)
// Now handles incomplete equations gracefully
const buildAST = (tokens) => {
  let pos = 0;

  const peek = () => tokens[pos];
  const consume = () => tokens[pos++];

  const parsePrimary = () => {
    const token = peek();

    // Handle incomplete equation (no more tokens)
    if (!token) {
      return { type: 'incomplete' };
    }

    consume();

    if (token.type === 'number') {
      return { type: 'number', value: token.value };
    }

    if (token.type === 'operator' && token.value === '(') {
      const expr = parseExpression(0);
      if (peek()?.value !== ')') {
        // Incomplete: missing closing paren, but return what we have
        return expr;
      }
      consume(); // consume ')'
      return expr;
    }

    // Unexpected token, treat as incomplete
    return { type: 'incomplete' };
  };

  const parseExpression = (minPrecedence) => {
    let left = parsePrimary();

    // If we got an incomplete node, return it
    if (left.type === 'incomplete') {
      return left;
    }

    while (pos < tokens.length) {
      const op = peek();
      if (!op || op.type !== 'operator' || op.value === ')') break;

      const precedence = { '^': 4, '*': 3, '/': 3, '+': 2, '-': 2 }[op.value];
      if (precedence === undefined || precedence < minPrecedence) break;

      consume();

      // Right-associative for ^
      const nextMinPrec = (op.value === '^') ? precedence : precedence + 1;
      const right = parseExpression(nextMinPrec);

      // If right side is incomplete, still create the binary node
      // This allows us to track what we've parsed so far
      if (right.type === 'incomplete') {
        // Operator without right operand - keep the left side structure
        // Don't create a binary node with incomplete right side
        return left;
      }

      left = {
        type: 'binary',
        operator: op.value,
        left,
        right
      };
    }

    return left;
  };

  return parseExpression(0);
};

/**
 * An equation AST node as produced by the Pratt parser above.
 * @typedef {{ type: 'number', value: number }
 *         | { type: 'binary', operator: string, left: EquationNode, right: EquationNode }
 *         | { type: 'incomplete' }} EquationNode
 */

/**
 * Parse a finished equation into its AST — the same tree `getPowerDiceCorrectness`
 * scores against, exposed for the badge/craft predicates in `craftPredicates.js`
 * (Lane A of the badge redesign) so they can read real per-node structure instead
 * of pattern-matching the string.
 *
 * Deliberately strict: only a **well-formed, evaluable** equation gets a tree.
 * A draft, an unbalanced paren, a `÷+` unary trap, or anything the evaluator
 * rejects returns `null`, so every predicate built on it degrades to its safe
 * default rather than reasoning about a half-parsed tree.
 *
 * Internal to `equation-engine` (not re-exported from `index.js`) — callers
 * outside the subsystem should use the predicates, not the raw AST.
 *
 * @param {string} equation - the player's equation, Unicode operators allowed
 * @returns {EquationNode | null} the root node, or null when not well-formed
 */
export const parseEquationAST = (equation) => {
  if (typeof equation !== 'string' || equation.length === 0) return null;

  const normalized = normalizeEquation(equation);

  // One gate for every malformed shape: disallowed adjacent operators, bad
  // characters, unbalanced parens, divide-by-zero, non-finite results. If the
  // evaluator won't score it, we don't describe it.
  if (!evaluateEquation(normalized).valid) return null;

  const ast = buildAST(tokenize(insertImplicitMultiplication(normalized)));
  if (!ast || ast.type === 'incomplete') return null;
  return /** @type {EquationNode} */ (ast);
};

// Walk the AST and assign each number's parent operator + exponent flag.
// Positional contract (ADR-0002): the Nth number in equation order maps to
// the dice at colors[usedIndices[N]].
const findFirstOperatorForNumbers = (ast, usedIndices, colors) => {
  const results = [];

  const collectNumbers = (node) => {
    if (node.type === 'number') {
      results.push({ operator: null, inExponent: false });
    } else if (node.type === 'binary') {
      collectNumbers(node.left);
      collectNumbers(node.right);
    }
  };

  collectNumbers(ast);

  let numberIndex = 0;
  const assignOperators = (node, parentIsExponent = false) => {
    if (node.type === 'number') {
      const result = results[numberIndex];
      if (result) {
        result.inExponent = parentIsExponent;
      }
      numberIndex++;
    } else if (node.type === 'binary') {
      const isExponentOp = node.operator === '^';

      if (node.left.type === 'number') {
        const result = results[numberIndex];
        if (result) {
          result.operator = node.operator;
          result.inExponent = isExponentOp;
        }
        numberIndex++;
      } else {
        assignOperators(node.left, false);
      }

      if (node.right.type === 'number') {
        const result = results[numberIndex];
        if (result) {
          result.operator = node.operator;
          result.inExponent = isExponentOp;
        }
        numberIndex++;
      } else {
        assignOperators(node.right, false);
      }
    }
  };

  assignOperators(ast);

  const numberOps = new Map();
  results.forEach((r, idx) => {
    const diceIdx = usedIndices[idx];
    const color = colors[diceIdx];
    if (color && color !== 'white') {
      numberOps.set(idx, { operator: r.operator, inExponent: r.inExponent });
    }
  });

  return numberOps;
};

// Get correctness info for each colored dice in equation (for UI highlighting
// and points calculation). Positional contract: colors[i] is the color of the
// die at position i in the player's dice array; usedIndices is the equation-
// order list of those positions. See ADR-0002.
export const getPowerDiceCorrectness = (equation, usedIndices, colors) => {
  if (!colors || colors.length < 7 || !usedIndices || !equation) {
    return new Map();
  }

  equation = normalizeEquation(equation);

  const processedEquation = insertImplicitMultiplication(equation);

  const tokens = tokenize(processedEquation);
  const ast = buildAST(tokens);

  if (!ast || ast.type === 'incomplete') {
    return getSimplePowerDiceCorrectness(equation, usedIndices, colors);
  }

  const numberOps = findFirstOperatorForNumbers(ast, usedIndices, colors);

  const correctnessMap = new Map();

  numberOps.forEach((info, numIdx) => {
    const diceColor = colors[usedIndices[numIdx]] || 'white';

    let isCorrect = false;

    if (diceColor === 'green') {
      isCorrect = (info.operator === '+' || info.operator === '-');
    } else if (diceColor === 'blue') {
      isCorrect = (info.operator === '*' || info.operator === '/');
    } else if (diceColor === 'red') {
      isCorrect = info.inExponent;
    }

    correctnessMap.set(numIdx, isCorrect);
  });

  return correctnessMap;
};

// Fallback for incomplete equations - uses simple pattern matching
const getSimplePowerDiceCorrectness = (equation, usedIndices, colors) => {
  const correctnessMap = new Map();

  let numberIndex = 0;
  let i = 0;

  while (i < equation.length) {
    const char = equation[i];

    if (/\d/.test(char)) {
      let j = i + 1;
      while (j < equation.length && /\d/.test(equation[j])) {
        j++;
      }

      const diceColor = colors[usedIndices[numberIndex]] || 'white';

      const afterOp = equation[j];
      let beforeOp = null;
      let k = i - 1;
      while (k >= 0 && equation[k] === ' ') k--;
      if (k >= 0) beforeOp = equation[k];

      const inExponent = beforeOp === '^';

      let primaryOp = beforeOp;
      if (!primaryOp || primaryOp === '(') {
        primaryOp = afterOp;
      }

      let isCorrect = false;
      if (diceColor === 'green') {
        isCorrect = (primaryOp === '+' || primaryOp === '-');
      } else if (diceColor === 'blue') {
        isCorrect = (primaryOp === '*' || primaryOp === '/');
      } else if (diceColor === 'red') {
        isCorrect = inExponent;
      }

      if (diceColor && diceColor !== 'white') {
        correctnessMap.set(numberIndex, isCorrect);
      }

      numberIndex++;
      i = j;
    } else {
      i++;
    }
  }

  return correctnessMap;
};

// Tally how many power dice were used correctly, given the per-die boolean
// map from getPowerDiceCorrectness. One home for the "count the correct power
// dice" idiom that was hand-rolled inline at ~13 call sites.
export const countPowerDiceCorrect = (correctnessMap) => {
  let count = 0;
  if (correctnessMap) {
    correctnessMap.forEach((isCorrect) => {
      if (isCorrect) count++;
    });
  }
  return count;
};

// A "perfect solve" is all 3 colored power dice used correctly. Pure verdict
// for callers that only need the yes/no, not the per-die map. Safe on bad
// input: getPowerDiceCorrectness returns an empty map for missing/short colors
// (so this is false then) — which is why call-site `colors.length >= 7` guards
// around it are redundant.
export const isPerfectSolve = (equation, usedIndices, colors) =>
  countPowerDiceCorrect(getPowerDiceCorrectness(equation, usedIndices, colors)) === 3;

// Validate colored dice usage in challenge modes using PEMDAS.
// The `dice` parameter is vestigial post-ADR-0002 — engine reads colors
// positionally now — but kept in the signature to avoid touching 10+ callers
// in a refactor scoped to power-dice correctness.
/**
 * How many power dice a solve in this mode must use CORRECTLY.
 *
 * Client mirror of `requiredPowerDiceCount` in
 * `supabase/functions/_shared/modeRules.ts` — the two MUST agree, because the
 * server is what actually accepts or rejects the solve.
 *
 *   Easy      0  — seven white dice; there is nothing to get right.
 *   Challenge 2  — unchanged.
 *   Expert    3  — a perfect solve is the ENTRY REQUIREMENT, not a decoration.
 *
 * An OMITTED mode answers 2, matching the server's legacy branch: every caller
 * predating three modes means Challenge and expects 2.
 *
 * @param {string} [mode] wire key (e.g. 'daily_expert'); omit for the legacy default
 * @returns {number}
 */
export const requiredPowerDiceCount = (mode) => {
  if (mode === undefined) return 2;
  if (requiresPerfectSolve(mode)) return 3;
  if (hasPowerDice(mode)) return 2;
  return 0;
};

/**
 * @param {string} [mode] wire key. WITHOUT it this asks for 2 correct power dice
 *   whatever the mode — which let an Expert solve through on 2 of 3 while the
 *   SERVER rejected it as invalid, so the player saw a win and silently got no
 *   leaderboard row and no stats.
 */
export const validateChallengeModeRules = (equation, usedIndices, dice, colors, mode) => {
  if (!usedIndices || usedIndices.length !== 7) {
    return false;
  }

  try {
    const correctnessMap = getPowerDiceCorrectness(equation, usedIndices, colors);
    const coloredDiceUsedCorrectly = countPowerDiceCorrect(correctnessMap);
    const required = requiredPowerDiceCount(mode);

    console.log('🎯 PEMDAS Validation:', coloredDiceUsedCorrectly, `power dice used correctly (need ${required})`);
    return coloredDiceUsedCorrectly >= required;

  } catch (error) {
    console.error('❌ VALIDATION ERROR:', error);
    return false;
  }
};

// The winning sum every mode targets. Single source of truth for the "37" win
// condition the play surfaces gate Submit on.
export const TARGET_SUM = 37;

// Canonical "is this a submittable winning solution?" gate, shared by every play
// surface (the in-play overlay `DailyChallengeGame` and the head-to-head host
// `HeadToHeadGame`), which previously each hand-rolled the identical boolean.
// It combines the engine outputs into the one win condition:
//   - the equation evaluates validly,
//   - it equals the target (TARGET_SUM),
//   - all seven dice are used,
//   - power-dice rules are met (the caller computes this per mode), and
//   - there are no structural draft errors.
//
// Liveness guards are deliberately EXCLUDED — each surface ANDs its own because
// they differ (overlay: `!solved`; head-to-head: `!roundComplete && isActive`).
// Keeping them out is what lets one helper serve both with NO behavior change.
export const isSubmittableSolution = ({ valid, result, usedDiceIndices, challengeRulesMet, draftErrors }) =>
  Boolean(
    valid &&
    result === TARGET_SUM &&
    Array.isArray(usedDiceIndices) && usedDiceIndices.length === 7 &&
    challengeRulesMet &&
    Array.isArray(draftErrors) && draftErrors.length === 0
  );