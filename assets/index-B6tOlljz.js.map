import React, { useRef, useEffect, useCallback } from 'react';
import { Capacitor } from '@capacitor/core';
import { SplashScreen } from '@capacitor/splash-screen';
import { isSoundMuted } from '@/ui/feedback';
// Bundled first frame of the intro video (≈42 KB). Shown instantly as the
// <video> poster so there's no gray placeholder while the remote video buffers —
// and because it IS frame 1, the handoff to playback is seamless.
import introPoster from './intro-poster.jpg';

// The intro video is BUNDLED in the app (public/intro-video.mp4) and played
// from the local web bundle — no network, so it starts instantly.
//
// History: it was briefly streamed from Supabase Storage to keep the OTA bundle
// small, because the master was ~13 MB (a too-large OTA blows Capgo's download
// timeout and rolls back — see bug log capgo-ota-bundle-too-large). Streaming it
// then cost ~17 s to start on the device. Re-encoding the master to ~2.2 MB
// (720×1280, ~1.7 Mbps, +faststart — see media/README.md) makes it small enough
// to bundle safely, which trades a swap-via-storage convenience for instant,
// offline, zero-latency playback. To change the video now: replace
// public/intro-video.mp4 and ship an OTA (no Supabase dependency).
export const INTRO_VIDEO_URL = '/intro-video.mp4';

// The bundled intro is ~10.4s. This is that plus enough headroom to absorb a
// slow first decode, so a healthy playthrough always ends via `onEnded` and this
// ceiling only ever fires when playback is genuinely stuck.
export const INTRO_MAX_MS = 15000;

export default function IntroVideoScreen({ onComplete }) {
  const videoRef = useRef(null);
  const hasFinished = useRef(false);

  // Single exit path: mark the intro as played and advance. Used by tap,
  // natural end, and load failure (offline / asset missing) so a network
  // problem can never trap the user on a black screen. Guarded so a tap that
  // races a pending play() rejection can't call onComplete twice.
  const finish = useCallback(() => {
    if (hasFinished.current) return;
    hasFinished.current = true;
    // The write is best-effort and must never be able to throw. It used to sit
    // between `hasFinished = true` and `onComplete()`, so a storage failure
    // (WKWebView with website data blocked, private browsing) threw AFTER the
    // guard was set: onComplete never ran, and every subsequent tap returned
    // early at the guard. That is a permanent black screen that ignores input —
    // precisely the 2.1(a) "unresponsive screen" App Review reported on 1.0.314.
    // Remembering the intro is a nicety; advancing past it is not.
    try {
      sessionStorage.setItem('introPlayed', 'true');
    } catch {
      /* intro simply replays next launch */
    }
    onComplete();
  }, [onComplete]);

  // Start playback imperatively. There is deliberately no autoPlay attribute: it
  // makes the browser evaluate autoplay policy at commit time and flags the
  // element as blocked before this effect runs, which poisons the explicit
  // play() calls below.
  //
  // iOS only: the native splash screen (launchAutoHide:false) covers the WebView
  // until auth resolves — which happens AFTER this effect runs. Playing while
  // the WebView is occluded by the splash gets the video rejected (or it plays
  // invisibly and ends), so the intro is never seen and finish() skips it. Hide
  // the splash FIRST so the WebView is visible, THEN play. The intro is itself a
  // full-screen black cover, so dismissing the splash early shows no spinner.
  // SplashScreen is an already-installed plugin (App.jsx calls it too) — calling
  // hide() here is pure JS, OTA-safe, and a no-op on web.
  //
  // Try UNMUTED first: the WebView is now visible and the native config sets
  // mediaTypesRequiringUserActionForPlayback = [], so iOS should allow autoplay
  // WITH sound. (We cannot start muted and unmute later — iOS blocks a
  // programmatic unmute without a user gesture, which is why a muted start plays
  // silently.) If iOS still refuses unmuted play, fall back to muted so the
  // intro is at least seen. Only skip if even muted play is impossible.
  //
  // Exception: if the player has muted sound (drawer "Mute Sound" / in-game
  // speaker — the shared localStorage['soundMuted'] preference), honour it and
  // start muted. That preference persists across launches, so the intro stays
  // silent on every open until they unmute.
  useEffect(() => {
    const video = videoRef.current;
    if (!video) return;
    let cancelled = false;

    const startPlayback = () => {
      if (cancelled || !videoRef.current) return;
      if (isSoundMuted()) {
        video.muted = true;
        video.play().catch(finish);
        return;
      }
      video.muted = false;
      video.play().catch(() => {
        if (cancelled || !videoRef.current) return;
        video.muted = true;
        video.play().catch(finish);
      });
    };

    if (Capacitor.isNativePlatform()) {
      // Deliberately ignored: hide() can reject if the splash is already gone;
      // playback must start either way.
      SplashScreen.hide().catch(() => {}).finally(startPlayback);
    } else {
      startPlayback();
    }

    // Hard ceiling on the intro. `onEnded` is the normal exit, but it never
    // fires if playback stalls or is INTERRUPTED — and this app interrupts
    // itself: AppDelegate raises the ATT permission alert 1s after launch, which
    // pauses the video, and iOS does not resume it afterwards. The result is a
    // frozen frame with no natural exit. A tap still advances, but a reviewer
    // who taps once on a video that visibly does nothing reasonably concludes
    // the app is broken. The timeout is the video's own length plus headroom,
    // so it never pre-empts a clean playthrough.
    const ceiling = setTimeout(finish, INTRO_MAX_MS);

    return () => { cancelled = true; clearTimeout(ceiling); };
  }, [finish]);

  return (
    <div
      className="fixed inset-0 bg-black z-50 flex items-center justify-center cursor-pointer"
      onClick={finish}
    >
      <video
        ref={videoRef}
        src={INTRO_VIDEO_URL}
        poster={introPoster}
        preload="auto"
        playsInline
        onEnded={finish}
        onError={finish}
        // object-contain (not cover): show the whole authored frame so the 37 is
        // never cropped or pushed under a top camera cutout/notch. The black
        // letterbox sits in the safe area on black; cover-fill cropped the 37.
        className="w-full h-full object-contain"
        style={{ objectFit: 'contain', backgroundColor: '#000' }}
      />
    </div>
  );
}
