// "Shuffle a fun name" — for the player who can't think of a username.
//
// Design research (2026-10-10): suggestion buttons only help if the name they
// offer is genuinely free — a suggestion that then fails at "Next" is worse than
// none. So `shuffleAvailableName` checks each candidate before offering it.
//
// Word lists are short, game-themed and hand-picked clean (the server's
// moderation still re-checks every name at set-username). Every combination fits
// the 3–20 character, letters/digits-only rule.

const ADJECTIVES = [
  'Swift', 'Lucky', 'Clever', 'Cosmic', 'Neon', 'Brave', 'Sly', 'Bold', 'Zippy',
  'Witty', 'Sharp', 'Mighty', 'Quick', 'Jolly', 'Sunny', 'Stellar', 'Nimble', 'Keen',
];
const NOUNS = [
  'Dice', 'Wizard', 'Comet', 'Falcon', 'Otter', 'Rocket', 'Puzzler', 'Ninja',
  'Panda', 'Fox', 'Tiger', 'Owl', 'Nova', 'Pixel', 'Ace', 'Badger', 'Rhino', 'Lynx',
];

/**
 * One random candidate, e.g. "CosmicOtter42".
 * @param {() => number} [random] test seam, returns [0, 1)
 */
export function randomFunName(random = Math.random) {
  const pick = (list) => list[Math.floor(random() * list.length) % list.length];
  const digits = String(Math.floor(random() * 90) + 10); // 10–99
  return `${pick(ADJECTIVES)}${pick(NOUNS)}${digits}`.slice(0, 20);
}

/**
 * A fun name that the availability check says is free.
 *
 * @param {(name: string) => Promise<{ status: string }>} check checkUsername-like
 * @param {{ random?: () => number, attempts?: number }} [opts]
 * @returns {Promise<string | null>} null when no free name was found (rare) —
 *   the caller keeps whatever the player had typed
 */
export async function shuffleAvailableName(check, { random = Math.random, attempts = 6 } = {}) {
  for (let i = 0; i < attempts; i += 1) {
    const name = randomFunName(random);
    const r = await check(name);
    if (r.status === 'available') return name;
  }
  return null;
}

export const __FUN_WORDS_FOR_TESTS = { ADJECTIVES, NOUNS };
