import React, { useState } from 'react';
import { AlertCircle } from 'lucide-react';

import { useAuth } from '@/auth';
import { apiClient } from '@/transport';
import { announceProfileChanged } from './announceProfileChanged';
import EmailCodeSheet from './EmailCodeSheet';
import { EMAIL_CODE_COPY } from './emailCodeCopy';
import { isDaily } from '@/game-modes';

import {
  CONTEST_GAPS_TITLE,
  CONTEST_GAPS_FOOTER,
  CONTEST_ELIGIBILITY_META_KEY,
  buildContestEligibilityAttestation,
  contestEligibilityGaps,
  hasDeclinedContestEligibility,
  isContestPromoVisible,
} from './contest';

// ContestEligibilityNotice — "that Daily did not earn an entry, and here is why".
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT EXISTS, AND WHY IT APPEARS HERE
// ─────────────────────────────────────────────────────────────────────────────
// On 2026-09-17 finishing a Daily became the whole entry bar. That made a quiet
// problem loud: most players are not eligible, and nothing ever told them.
// Roughly 97% of accounts are anonymous guests, the apps ship worldwide, and
// before this week nobody had ticked the 18+ box because it did not exist.
//
// Under the old rule that mattered less — entry was a podium prize almost nobody
// won anyway. Now a player finishes a Daily, has every reason to believe they
// just earned an entry, and is wrong. They can repeat that every day for 23
// weeks and never find out.
//
// David asked for something that tells an active player they are not eligible
// "because of x y or z reasons". This is it.
//
// ⚠️ THE TIMING IS THE FEATURE. It renders on the solve screen, immediately
// after a Daily, because that is the only moment the player is actually
// thinking about the entry they think they just earned. The same words on the
// contest sheet would be true and would be read by nobody who needed them —
// a player who does not know they are ineligible has no reason to go and look.
//
// It is also why the footer carries the not-retroactive rule: today is the day
// fixing it starts paying, and tomorrow's fix does not recover today.
//
// NOT A BLOCKING MODAL, on purpose. It is a panel inside the existing solve
// screen, so it costs no z-index layer, no extra dismiss, and cannot trap
// anyone. A player who ignores it loses nothing they had.

/** One gap: the reason, and the control that closes it. */
function Gap({ gap, onAct, busy }) {
  return (
    <li className="flex flex-col gap-1">
      <span className="text-[11px] leading-snug text-slate-300">{gap.reason}</span>
      <button
        type="button"
        data-testid={`contest-gap-cta-${gap.code}`}
        onClick={() => onAct(gap.code)}
        disabled={busy}
        className="self-start min-h-[32px] touch-manipulation text-[11px] font-black underline decoration-dotted underline-offset-4"
        style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)', WebkitTapHighlightColor: 'transparent' }}
      >
        {busy && gap.code === 'age' ? 'Saving…' : gap.cta}
      </button>
    </li>
  );
}

/**
 * @param {Object} props
 * @param {string} props.mode the mode just played — only Dailies earn entries
 * @param {() => void} [props.onLeave] called before a flow that navigates away,
 *   so the host screen can close itself first (same contract ContestDetails uses)
 * @param {boolean|'grace'|null} [props.emailVerified] the server's answer (from 25 Oct
 *   2026 a `false` adds the 'verify' gap); null/absent = unknown, adds nothing
 */
export default function ContestEligibilityNotice({ mode, onLeave, emailVerified = null }) {
  const { user } = useAuth();
  const [busy, setBusy] = useState(false);
  const [confirmed, setConfirmed] = useState(false);
  const [error, setError] = useState('');
  const [verifyOpen, setVerifyOpen] = useState(false);

  const gaps = contestEligibilityGaps(user, { emailVerified });

  // The code sheet outlives the notice: a successful verify closes the last
  // gap, and the player must still see "Verified" before it goes.
  const [verifiedHere, setVerifiedHere] = useState(false);
  const verifySheet = verifyOpen ? (
    <EmailCodeSheet
      user={user}
      onClose={() => setVerifyOpen(false)}
      onVerified={() => setVerifiedHere(true)}
      onLeave={onLeave}
    />
  ) : null;
  // Verifying closed the last gap: say so, rather than leave an empty sheet.
  const verifiedLine = verifiedHere ? (
    <p data-testid="contest-gap-verified" className="text-[12px] font-semibold mt-3" style={{ color: 'var(--u37-gold)' }}>
      {EMAIL_CODE_COPY.success}
    </p>
  ) : null;
  // ONE shape for every return, so the open code sheet keeps its place in the
  // tree (and its step) when the notice above it disappears.
  const withVerify = (panel) => <>{panel}{verifiedLine}{verifySheet}</>;
  const onlyAfterVerify = withVerify(null);

  // Four reasons to render nothing, all of them cheap to check:
  //   - the promo is not shown on this platform at all;
  //   - this was not a Daily, so no entry was ever on the table;
  //   - the player is already eligible — never nag someone who is fine;
  //   - they just fixed the last gap from here.
  if (!isContestPromoVisible()) return null;
  if (!isDaily(mode)) return null;
  // ⚠️ A PLAYER WHO ANSWERED NO IS NEVER SHOWN THIS. They decided, and this is
  // the surface that would otherwise repeat the question after every single
  // Daily for the rest of the season. Silencing it here is the entire reason
  // the three states exist — without it, 'declined' is just a slower 'not yet'.
  // They can still change their mind in Edit Profile (the 18+ question is
  // there, pre-filled). Since 2026-10-10 the contest sheet itself is hidden for
  // them — see contestVisibility.
  if (hasDeclinedContestEligibility(user)) return null;
  if (!gaps.length) return onlyAfterVerify;
  if (confirmed && gaps.length === 1 && gaps[0].code === 'age') return onlyAfterVerify;

  const act = async (code) => {
    if (code === 'verify') { setVerifyOpen(true); return; }
    if (code !== 'age') {
      // Account and email both need a form. Same window-event route the contest
      // sheet uses; the host closes first so the player lands ON the form
      // rather than behind this screen.
      onLeave?.();
      window.dispatchEvent(new Event(code === 'account' ? 'openSaveStats' : 'openAddEmail'));
      return;
    }
    if (busy) return;
    setBusy(true);
    setError('');
    try {
      await apiClient.auth.updateMe({
        [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(true),
      });
      setConfirmed(true);
      await announceProfileChanged();
    } catch {
      // Surfaced, never swallowed. A player told nothing went wrong will believe
      // they are now entered — which is the exact harm this component exists to
      // prevent, reintroduced one layer down.
      setError('Could not save that. Check your connection and try again.');
    } finally {
      setBusy(false);
    }
  };

  return withVerify(
    <div
      data-testid="contest-eligibility-notice"
      className="w-full rounded-xl border px-3 py-2.5 mt-3"
      style={{
        borderColor: 'color-mix(in srgb, var(--u37-gold) 40%, transparent)',
        background: 'color-mix(in srgb, var(--u37-gold) 10%, transparent)',
      }}
    >
      <p className="flex items-center gap-2 text-[12px] font-black" style={{ color: 'var(--u37-gold)' }}>
        <AlertCircle className="w-4 h-4 flex-shrink-0" aria-hidden="true" />
        {CONTEST_GAPS_TITLE}
      </p>

      <ul className="mt-2 flex flex-col gap-2">
        {gaps.map((gap) => (
          <Gap key={gap.code} gap={gap} onAct={act} busy={busy} />
        ))}
      </ul>

      {confirmed && (
        <p data-testid="contest-gap-age-confirmed" className="text-[11px] font-semibold mt-2" style={{ color: 'var(--u37-gold)' }}>
          ✓ Age and country confirmed.
        </p>
      )}
      {error && (
        <p data-testid="contest-gap-error" className="text-[11px] text-red-300 mt-2">{error}</p>
      )}

      {/* Condensed 2026-10-18: the old "The $37 draw is 18+, US only, account
          with email" tail repeated the gap rows above it. The not-retroactive
          rule stays — it is why this notice is worth showing right now. */}
      <p data-testid="contest-gaps-footer" className="text-[10px] leading-snug text-slate-400 mt-2">
        {CONTEST_GAPS_FOOTER}
      </p>
    </div>,
  );
}
