import { useEffect, useRef } from 'react';
import { maybeRequestReview as shellMaybeRequestReview } from '@/shell';

// useDailyWinReviewPrompt — WHEN the store review card may be asked for.
//
// The rules about WHETHER (wins, throttle, plugin, server switch) live in
// @/shell reviewPrompt. This hook owns the timing, so the card never lands on
// top of something else:
//
//   1. ARMED only by a Daily win the server accepted (useRoundSession's
//      handleSubmit). Practice, forfeits, time-outs and the "Today's Solve"
//      recap open the same results screen but never arm it.
//   2. CALM means the results screen is up AND the rocket has landed AND every
//      badge pop-up has been dismissed (usePostSolveCelebration's queue is empty).
//   3. Then it waits SETTLE_MS more, so the player has a moment with their result
//      before anything appears.
//   4. If the player leaves the results screen first, the chance is dropped for
//      this win. That matters: the "play the next Daily" buttons open a full-screen
//      ad right after the results close (enterPreGameScreen), and the card must
//      never race that ad. Leaving clears the timer, so nothing fires after.
//
// One request per arming; `onDone` disarms.

export const SETTLE_MS = 2500;

/**
 * @param {{ armed: boolean, resultsOpen: boolean, celebrating: boolean,
 *           onDone: () => void, delayMs?: number,
 *           request?: (deps: { stillCalm: () => boolean }) => Promise<unknown> }} args
 *   celebrating — the rocket is flying or a badge pop-up is queued/on screen
 */
export function useDailyWinReviewPrompt({
  armed, resultsOpen, celebrating, onDone, delayMs = SETTLE_MS, request = shellMaybeRequestReview,
}) {
  const sawResults = useRef(false);
  const onDoneRef = useRef(onDone);
  const requestRef = useRef(request);
  // Read by the request at the last moment (after its server-switch read, which
  // can take seconds): has the player left, or has a pop-up appeared, meanwhile?
  const calmRef = useRef(false);
  calmRef.current = Boolean(resultsOpen && !celebrating);
  useEffect(() => { onDoneRef.current = onDone; requestRef.current = request; });

  useEffect(() => {
    if (!armed) { sawResults.current = false; return undefined; }
    if (resultsOpen) sawResults.current = true;
    if (!resultsOpen) {
      // Armed in the same beat the results open, so "not open yet" is normal.
      // Closed AFTER being open = the player left: drop this win's chance.
      if (sawResults.current) { sawResults.current = false; onDoneRef.current?.(); }
      return undefined;
    }
    if (celebrating) return undefined;
    const t = setTimeout(() => {
      sawResults.current = false;
      onDoneRef.current?.();
      // maybeRequestReview never throws; the catch is belt-and-braces for an
      // injected request.
      Promise.resolve()
        .then(() => requestRef.current({ stillCalm: () => calmRef.current }))
        .catch(() => { /* the request reports its own errors */ });
    }, delayMs);
    return () => clearTimeout(t);
  }, [armed, resultsOpen, celebrating, delayMs]);
}
