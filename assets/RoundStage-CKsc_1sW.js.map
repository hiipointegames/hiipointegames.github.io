import React, { useEffect, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Share2, X, Home, BarChart3, Loader2, Orbit } from 'lucide-react';
import { nextChallengeNudge } from './nextChallengeNudge';
import NextChallengeNudgeCard from './NextChallengeNudgeCard';
import { Button } from '@/ui/primitives/button';
import { createPageUrl } from '@/routing/createPageUrl';
import { todayET } from '@/daily-challenge';
import { playSound } from '@/ui/feedback';
import { useViewerTier } from '@/soft-wall';
import { apiClient } from '@/transport';
import { getLeaderboard } from '@/stats-aggregation';
import { captureError, reportedFallback } from '@/observability';
import { shareOrCopy } from './dailyShare';
import { usePreparedDailyShare } from './usePreparedDailyShare';
import { targetForAwards, badgesUrlForAwards } from './badgeTargetForAward';
import { powerSquaresFrom } from '@/share-card';
import { isPerfectSolve, createDailySolver, DEFAULT_SLICE_OPS } from '@/equation-engine';
import { isDaily, hasPowerDice, hasPerfectConcept, modeShareLabel } from '@/game-modes';
import DailyWinResult, { neonFill } from './DailyWinResult';
import { modeThemeName } from './modeTheme';
import { SolvedEquation } from '@/equation-display';
import { Target37, WinMedallion } from '@/dice-visuals';
import DiceDisplay from '@/puzzle-input/DiceDisplay';
import { DAILY_LIMIT_LABEL } from '@/daily-challenge/dailyLimit';
import { resultExit, ExitLink, ORBIT_HOME_LABEL } from './resultExits';

/** @type {Array<Record<string, any>>} */
const NO_AWARDS = [];

// The `dailyStreak` prop is GONE (2026-09-03). It drove the SatelliteStreakModal
// and nothing else — this modal never displayed it. Both are deleted; the 7-day
// streak journey now lives on the launcher as @/home DailyStreakTrack, per-mode
// and always visible. See the game-flow barrel for the full rationale.

// `earnedAwards` (2026-10-18): the award queue that played just before this
// screen. When any of it is a card on the Badges page, a "New badge! See it"
// link deep-links there — the post-solve pop-ups have no such button so that
// nobody skips their result to go look.
//
// Sector 73 host props (slice 2b, session 2026-10-19-s73-37-inside) — all
// absent on 37's /Game, which renders exactly as before:
//   skin    'sector73' → data-skin / data-part on the scrim + card (cosmic CSS)
//   inWorld { exits } → Home reads "Back to orbit"; Stats / badges /
//           Leaderboards / battle show only for a given exit (./resultExits)
export default function SuccessModal({ isOpen, onClose, equation, onNewGame, onGoHome, onPlayMode, mode, dice, usedDiceIndices, diceColors, solveTime, forfeited, timedOut, statusByMode, earnedAwards = NO_AWARDS, skin, inWorld }) {
  const newBadgeCount = targetForAwards(earnedAwards).badgeIds.length;
  const statsExit = resultExit(inWorld, 'stats');
  // Soft wall (David, 2026-10-10): a GUEST's Daily result shows their time but
  // not where they placed — that is the account perk. Read without useAuth (it
  // throws outside an AuthProvider; see useViewerTier). Unknown = member view.
  const isGuestViewer = useViewerTier() === 'guest';
  const [closeLockedRef] = useState({ locked: false });
  const [newGameLockedRef] = useState({ locked: false });
  const [homeLockedRef] = useState({ locked: false });
  const [statsLockedRef] = useState({ locked: false });
  const [shareLockedRef] = useState({ locked: false });
  // 5B / V5: on a daily forfeit, compute a Valid + Perfect solve for THIS day's
  // dice (engine-verified) to show what was possible. The search can run to a
  // few million ops on hard days (~hundreds of ms), so it must NOT block the
  // forfeit screen's paint — the old synchronous useMemo froze the frame on
  // open. Instead we drive the PAUSABLE solver in tiny time-slices after first
  // paint (createDailySolver), reserving the box + showing a "Finding what was
  // possible…" placeholder, then fade the solves in with no layout jump.
  // The day's board + who the viewer is, captured from the Share card's prep
  // read below (getFacts) — the condensed win screen's member podium draws from
  // it, so placing the player costs no extra request.
  const [boardFacts, setBoardFacts] = useState(/** @type {{board: any[], userId: any} | null} */ (null));
  const [daySolutions, setDaySolutions] = useState(null);
  const [solvingDay, setSolvingDay] = useState(false);
  const diceKey = Array.isArray(dice) ? dice.join(',') : '';
  const canSolveDay = isOpen && forfeited && isDaily(mode)
    && Array.isArray(dice) && dice.length === 7 && !!diceColors;

  useEffect(() => {
    if (!canSolveDay) { setDaySolutions(null); setSolvingDay(false); return; }
    let cancelled = false;
    let timer = null;
    setDaySolutions(null);
    setSolvingDay(true);
    let solver;
    try {
      solver = createDailySolver([...dice], diceColors);
    } catch {
      setSolvingDay(false);
      return;
    }
    const runSlice = () => {
      if (cancelled) return;
      let res;
      try {
        res = solver.step(DEFAULT_SLICE_OPS);
      } catch {
        if (!cancelled) setSolvingDay(false);
        return;
      }
      if (res.done) {
        let result = null;
        try { result = solver.getResult(); } catch (e) { result = reportedFallback('solver.example')(e); }
        if (!cancelled) { setDaySolutions(result); setSolvingDay(false); }
        return;
      }
      timer = setTimeout(runSlice, 0); // yield to the event loop between slices
    };
    // Kick off after first paint so the modal's entrance frame is never blocked;
    // each slice then yields, keeping the screen fully interactive while solving.
    timer = setTimeout(runSlice, 0);
    return () => { cancelled = true; if (timer) clearTimeout(timer); };
    // diceKey stands in for `dice` so a fresh array identity each render doesn't
    // restart the search; diceColors is a stable module constant.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [canSolveDay, diceKey, diceColors]);

  // 5G / crispy slice C1: solve screens follow the home's per-mode neon accent
  // via the shared `--u37-mode-accent` slot (set by data-mode on the
  // card below → easy=green, challenge=cyan, daily=cyan). A FORFEIT reveal is
  // its own state: a FIXED violet/purple regardless of mode (David's finding-4
  // "purple"). This replaces the old fixed emerald/amber palette AND the previous
  // magenta-on-forfeit, which incorrectly painted a daily forfeit in Blitz's color.
  const accent = forfeited ? 'var(--u37-violet)' : 'var(--u37-mode-accent)';

  // The adaptive next-step buttons (see the block below for why they replaced
  // four hardcoded cards). Shown on a FORFEIT too since 2026-09-29 (David): a
  // forfeit closes that one Daily, and the other two are still waiting.
  const nudge = nextChallengeNudge({ playedMode: mode, statusByMode });

  // V3: the win-screen action buttons adopt the home screen's neon-FILLED look
  // (neonFill, now shared from DailyWinResult).

  // ⚠️ click, NOT pointerdown — see ExitWarningModal for the full reasoning.
  // This X sits top-right, and what it uncovers is the screen beneath: the home
  // chrome on Home, the status row in a game. Same shape as the "Not Now" loop
  // David hit on beta 1.0.312.
  const handleCloseClick = (e) => {
    if (closeLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();

    closeLockedRef.locked = true;
    onClose();

    setTimeout(() => {
      closeLockedRef.locked = false;
    }, 50);
  };

  const handleNewGameClick = (e) => {
    if (newGameLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();

    newGameLockedRef.locked = true;
    if (mode === 'easy' || mode === 'challenge') {
      playSound('shorterDiceRoll');
    }
    onNewGame();
    onClose();

    setTimeout(() => {
      newGameLockedRef.locked = false;
    }, 50);
  };

  // `targetMode` (optional): a mode-switch cross-promo button ("Try Challenge
  // Mode" → 'challenge', "Play Easy Mode" → 'easy') lands the launcher already
  // highlighting that mode. Plain Home buttons pass nothing (mode unchanged).
  // Fixes B4 — "Try Challenge Mode →" used to return home still in Easy.
  const handleHomeClick = (e, targetMode) => {
    if (homeLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();

    homeLockedRef.locked = true;
    onGoHome(targetMode);
    onClose();

    setTimeout(() => {
      homeLockedRef.locked = false;
    }, 50);
  };

  // F: the daily WIN nudge offers a one-tap jump straight into Easy or Challenge.
  // Unlike the plain Home button (onGoHome — lands the launcher), this routes to
  // that mode's PRE-GAME start screen so the player is one tap from playing (Game
  // wires onPlayMode). Shares the Home lock so a double-tap can't fire both.
  const handlePlayModeClick = (e, targetMode) => {
    if (homeLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();

    homeLockedRef.locked = true;
    onPlayMode?.(targetMode);
    onClose();

    setTimeout(() => {
      homeLockedRef.locked = false;
    }, 50);
  };

  // Prevent background scrolling when modal is open
  useEffect(() => {
    if (isOpen) {
      const scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';

      return () => {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollY);
      };
    }
  }, [isOpen]);

  // NOTE: the in-modal paper confetti was fully removed (2026-07-02). The solve
  // celebration is now the single cosmic burst fired over the board from Game.jsx
  // (mega tier on the daily). Only the cosmic celebration remains app-wide.

  const displayEquation = (
    <SolvedEquation
      equation={equation}
      usedIndices={usedDiceIndices}
      colors={diceColors}
      highlightAllWhenPerfect={hasPerfectConcept(mode)}
    />
  );
  const displayEquationText = equation
    .replace(/\*/g, '×')
    .replace(/\//g, '÷')
    .replace(/-/g, '−');

  // The Daily share is a PICTURE + message (@/share-card, 2026-09-29): the day's
  // dice (4 shown, 3 hidden), the result, a rotating dare and a personal /play
  // link. It is PREPARED as soon as the modal opens, so the Share tap opens the
  // sheet before the tap's user activation expires (usePreparedDailyShare).
  // Everything it needs is already a prop here except the board, which gives
  // the "faster than" percentile and the player's own row.
  const lost = !!(forfeited || timedOut);
  const shareDaily = usePreparedDailyShare({
    key: isOpen && isDaily(mode) ? [mode, lost, solveTime, equation].join('|') : null,
    getFacts: async () => {
      const user = await apiClient.auth.me();
      let leaderboard = [];
      try {
        // Paginated + server-ordered read (W2-F3).
        leaderboard = await getLeaderboard({ date: todayET(), mode });
      } catch (e) {
        // Fail open (the board only adds the "faster than" line), but say so:
        // this read failing used to be Sentry 37-THE-MATH-PUZZLE-23.
        captureError(e, { stage: 'success-modal-share-leaderboard', mode });
        leaderboard = [];
      }
      setBoardFacts({ board: leaderboard, userId: user?.id ?? null });
      return {
        mode,
        forfeited: lost,
        // THIS solve's time, which the modal already has as a prop.
        seconds: !lost && Number.isFinite(solveTime) ? solveTime : null,
        perfect: !lost && isPerfectSolve(equation, usedDiceIndices, diceColors),
        dice,
        squares: lost ? null : powerSquaresFrom(equation, usedDiceIndices, diceColors),
        board: leaderboard,
        userId: user?.id,
      };
    },
  });

  const handleShare = async (method) => {
    let text;

    if (isDaily(mode)) {
      // No await before this call: the fast path must reach the share sheet
      // inside the tap.
      await shareDaily((fallback) => shareOrCopy(method, fallback, { emailSubject: 'Check out my 37 Puzzle solve!' }));
      return;
    } else {
      // Practice solves: the tier badge, the dice and the equation.
      // Was a BINARY: challenge or else Easy. Expert is not challenge, so every
      // shared Expert solve announced itself as "🎲 Easy Mode" — on the mode the
      // $37 giveaway is won on, in the one artefact that leaves the app.
      const modeText = modeShareLabel(mode);

      // Format dice with colored circles for challenge mode
      let diceText = '';
      let coloredEquation = displayEquationText;

      if (mode === 'challenge' && dice) {
        diceText = dice.map((d, idx) => {
          if (idx === 4) return `Blue${d}`; // Blue dice (index 4)
          if (idx === 5) return `Red${d}`; // Red dice (index 5)
          if (idx === 6) return `Green${d}`; // Green dice (index 6)
          return `${d}`;
        }).join(' ');

        // Color the numbers in the equation
        const blueValue = dice[4];
        const redValue = dice[5];
        const greenValue = dice[6];

        coloredEquation = displayEquationText;
      } else {
        diceText = dice?.map(d => `⚀⚁⚂⚃⚄⚅`[d - 1]).join(' ') || dice?.join(' ') || '';
      }

      text = `🎲 37 Puzzle\n${modeText}\n\nDice: ${diceText}\nSolution: ${coloredEquation || displayEquationText} = 37 ✅\n\nAre you smart enough to reach 37?`;
    }

    await shareOrCopy(method, text, { emailSubject: 'Check out my 37 Puzzle solve!' });
  };

  // ONE tap → the device share sheet with the picture card + message
  // (@/share-card). The old Share… / Email / Text menu is gone: an sms: or
  // mailto: link can only carry text, so those two routes could never send the
  // card, and the share sheet already lists Messages and Mail. The lock is held
  // until the share resolves so a double tap cannot open two sheets.
  const handleShareClick = (e) => {
    if (shareLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();
    shareLockedRef.locked = true;
    Promise.resolve(handleShare('native'))
      .catch((err) => console.error('[share] daily share failed:', err))
      .finally(() => { shareLockedRef.locked = false; });
  };
  const canShare = isDaily(mode) && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

  // The condensed one-screen layout (DailyWinResult, Layout A 2026-10-18) is
  // the Daily WIN only; a forfeit and a practice win keep the layout below.
  const isDailyWin = isDaily(mode) && !lost;

  return (
    <AnimatePresence>
      {isOpen && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          data-skin={skin}
          data-part={skin ? 'scrim' : undefined}
          className="fixed inset-0 z-50 flex items-center justify-center p-4 u37-ad-safe-pb bg-black/70 backdrop-blur-sm"
        >
          <motion.div
            initial={{ scale: 0.7, opacity: 0, y: 40 }}
            animate={{ scale: 1, opacity: 1, y: 0 }}
            exit={{ scale: 0.7, opacity: 0, y: 40 }}
            transition={{ type: "spring", damping: 22, stiffness: 280 }}
            onClick={(e) => e.stopPropagation()}
            data-mode={modeThemeName(mode)}
            data-skin={skin}
            data-part={skin ? 'card' : undefined}
            className={`relative w-full max-w-sm rounded-3xl ${isDailyWin ? 'p-4' : 'p-6'} border-2 overflow-y-auto`}
            style={{
              maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
              background: 'var(--u37-panel-bg)',
              borderColor: `color-mix(in srgb, ${accent} 55%, transparent)`,
              boxShadow: `0 0 44px -12px ${accent}, 0 20px 70px rgba(0,0,0,0.6), inset 0 1px 4px rgba(255,255,255,0.06)`,
            }}
          >
            {/* Close button */}
            <button
              onClick={handleCloseClick}
              className="absolute top-4 right-4 text-slate-500 hover:text-slate-300 transition-colors touch-manipulation active:scale-95"
              style={{ WebkitTapHighlightColor: 'transparent' }}
            >
              <X className="w-5 h-5" />
            </button>

            {isDailyWin ? (
              <DailyWinResult
                mode={mode}
                accent={accent}
                dice={dice}
                diceColors={diceColors}
                equation={equation}
                usedDiceIndices={usedDiceIndices}
                solveTime={solveTime}
                isGuestViewer={isGuestViewer}
                board={boardFacts?.board}
                userId={boardFacts?.userId}
                nudge={nudge}
                statusByMode={statusByMode}
                earnedAwards={earnedAwards}
                newBadgeCount={newBadgeCount}
                canShare={canShare}
                onClose={onClose}
                onPlayModeClick={handlePlayModeClick}
                onHomeClick={handleHomeClick}
                onShareClick={handleShareClick}
                inWorld={inWorld}
              />
            ) : (
            <>

            {/* Win badge — WIN ONLY. E2: a forfeit is not a win, so it's suppressed
                there; the forfeit screen leads with the day's dice roll (the hero
                below) under a neutral "Today's Puzzle" header. 2026-07-13: replaced
                the amber wobbling 🏆 emoji with the compact on-theme WinMedallion
                (brand gold "37" in a daily-cyan ring; smaller, no wobble). */}
            {!forfeited && (
            <div className="flex justify-center mb-3">
              <WinMedallion size={72} />
            </div>
            )}

            {/* Title */}
            <motion.h2
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.4 }}
              className="text-3xl font-black text-center mb-2"
              style={{ color: accent, textShadow: `0 0 14px color-mix(in srgb, ${accent} 55%, transparent)` }}
            >
              {timedOut ? 'Time’s Up' : forfeited ? 'Today’s Puzzle' : '🎉 Puzzle Solved! 🎉'}
            </motion.h2>
            {/* A timeout and a voluntary forfeit both arrive here as `forfeited`,
                and until now both read "Here's the roll you faced today" — which
                tells a player whose clock quietly expired nothing about WHY their
                day ended. The time-limit rule is the single most surprising thing
                about the Daily (the clock keeps running with the app closed), and
                this is the screen where its consequence lands. */}
            {/* THE GREY SUB-HEADER IS GONE (David, 2026-09-12): "under the very
                top header of puzzle solved, there is a line of grey text
                underneath saying you solved todays daily 37 puzzle or something
                like that. remove that whole grey line of text from all three
                modes screens please."

                It restated the headline above it in smaller, dimmer type — the
                title already says the day was solved — and it cost a line of
                vertical space on a screen whose bottom buttons were being pushed
                out of view. Removed for every mode, solve and forfeit alike.

                ⚠️ THE TIMEOUT CASE MOVED, IT WAS NOT DELETED. This block also
                carried the "your 15:37 ran out" explanation, which is the one
                branch that said something the header does not — a player whose
                clock expired needs to know WHY their day ended. It is rendered
                below instead. Deleting it outright would have re-opened the gap
                that cost delaney-37 a day. */}
            {/* ⚠️ AND THE FORFEIT LABEL STAYED. David named the SOLVE screens —
                "saying you solved todays daily 37 puzzle" — and "all three modes"
                means Easy/Challenge/Expert, not all three outcomes. "Here's the
                roll you faced today" is a different sentence doing a different
                job: on a forfeit there is no equation below the dice, so without
                it the screen opens on an unlabelled board. Removing it would
                have been me widening the ask. */}
            {(timedOut || forfeited) && (
              <p className="text-slate-400 text-center text-sm mb-3" data-testid="outcome-reason">
                {timedOut
                  ? `Your ${DAILY_LIMIT_LABEL} ran out, so today’s Daily did not count — the clock keeps running even when the app is closed.`
                  : "Here's the roll you faced today"}
              </p>
            )}

            {/* THE DAY'S ROLL — now shown on the WIN path too, not just a forfeit.
                David, S21, beta 1.0.308: "on the post daily win screen, and the
                screen that appears when you click todays solve … can we include
                todays dice puzzle at the top of the screen?"

                E2 originally added this as a FORFEIT-ONLY hero, so the screen led
                with the puzzle rather than a "Bummer" + trophy. The same argument
                turns out to hold for a win: the equation below is the ANSWER, and
                an answer reads as arithmetic until you can see the question it
                answers. A player reviewing their own solve — or opening Today's
                Solve hours later — has usually forgotten the roll.

                One block for both paths rather than two: the forfeit and the win
                want the identical visual (the real board dice, static), and the
                only thing that ever differed was which outcome was allowed to
                render it.

                `usedIndices={[]}` deliberately, even on a win: this is the ROLL as
                it was dealt, and the used dice are already highlighted in the
                equation directly below. Tinting them here would say the same
                thing twice and make the roll harder to read as a roll.

                ⚠️ THIS MAKES THE MODAL TALLER. It is safe because this modal
                already carries `overflow-y-auto` plus the
                `--ad-reserved-bottom` max-height (line ~290), so it scrolls
                rather than hiding content under the ad banner — which is exactly
                the bug the contest sheet had on this same build. Do not copy this
                block into a modal lacking that constraint. */}
            {Array.isArray(dice) && dice.length === 7 && (
              <div data-testid="success-daily-roll" className={forfeited ? 'mb-3' : 'mb-2'}>
                <DiceDisplay dice={dice} usedIndices={[]} onDiceClick={() => {}} disabled mode={mode} colors={diceColors} compact />
              </div>
            )}

            {/* Equation display — solves only. The forfeit "Nice Try. Better Luck
                Tomorrow!" box was removed (July-2 prompt list item 16); the
                "Bummer! You'll Do Better Tomorrow!" header above already carries
                the forfeit message, and the possible-solves block below shows what
                was achievable — a duplicate consolation line was redundant. */}
            {!forfeited && (
              <div className={`bg-slate-700/60 rounded-xl p-4 mb-3 shadow-[inset_0_2px_8px_rgba(0,0,0,0.3)] ${hasPerfectConcept(mode) && isPerfectSolve(equation, usedDiceIndices, diceColors)
                ? 'border-2 border-amber-400 shadow-lg shadow-amber-500/50'
                : 'border border-slate-600/40'
                }`}>
                <p className="text-center text-lg font-mono font-bold">
                  {displayEquation} <span className="text-slate-200">= </span>
                  <Target37 className="font-black drop-shadow-[0_2px_8px_rgba(251,191,36,0.4)]" />
                </p>
              </div>
            )}

            {/* Colored dice explanation (only for challenge/daily WINS — it
                describes the player's own power-dice usage, which doesn't exist on
                a forfeit, so E2 suppresses it there). */}
            {hasPowerDice(mode) && !forfeited && (() => {
              const allThreeCorrect = isPerfectSolve(equation, usedDiceIndices, diceColors);

              return (
                <div className="mb-4 flex items-center justify-center gap-2 text-xs text-slate-300">
                  <span className="border-2 rounded w-5 h-5 inline-block" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }}></span>
                  {/* "Perfect Solve" is the phrase the calendar legend, the
                      profile legend, the badges and the stats slide all use. The
                      win screen was the one place a player earned one without
                      being told that is what it was called. */}
                  <span>= {allThreeCorrect ? 'Perfect Solve — all 3 Power Dice used correctly!' : 'Power Dice used with correct operation'}</span>
                </div>
              );
            })()}

            {/* ONE ADAPTIVE NUDGE, computed from today's REAL Daily state.
                ─────────────────────────────────────────────────────────────
                This was three hardcoded cross-promos plus a fourth card for
                Dailies: Easy said "Try Challenge Mode", Challenge said "Enter the
                Colosseum", Expert said NOTHING, and a Daily win offered a fixed
                four-button grid. Each was a guess about where the player was in an
                assumed easy → challenge → expert journey.

                David, 2026-09-12: "We assume easy to challenge to expert, but we
                can not guarantee that. Is there a way to have that particular
                nudge on each screen be adaptive and always point them towards any
                open and uncompleted dailies that remain ... and then once the
                third one is completed, whatever mode that may be, the nudge now
                turns to battle a friend."

                So `nextChallengeNudge` reads `statusByMode` — the same per-mode
                Daily state the launcher uses — and can never point at a Daily the
                player has finished, forfeited, or is already inside. The ladder
                and the copy live in that pure module, tested on its own; this is
                just the rendering. */}
            {!forfeited && (
              <NextChallengeNudgeCard nudge={nudge} onPlayMode={handlePlayModeClick} onClose={onClose} inWorld={inWorld} />
            )}

            {/* The Daily WIN's podium, leaderboard link and giveaway line live in
                DailyWinResult. A practice round is not ranked and earns no entry,
                and a forfeit is not the moment — so none of them render here. */}
            {/* 5B / V5: on a forfeit, SHOW what was possible on today's dice — a
                real Valid + Perfect solve (engine-verified). The search runs OFF
                the paint path (createDailySolver, sliced), so we reserve this box
                up front and show a "Finding what was possible…" placeholder while
                it runs, then fade the solves in — no layout jump, no frozen frame. */}
            {canSolveDay && (
              <div className="mb-5 space-y-2">
                <div className="text-center text-xs font-bold uppercase tracking-wider text-slate-400">Here's what was possible today</div>
                {/* Reserved min-height ≈ the two solve cards, so the placeholder →
                    results swap keeps the buttons below roughly in place (exact
                    height varies with each day's equation length, so this covers
                    the common 1–2-line case; the reveal only fades, never resizes). */}
                <div className="min-h-[150px]" aria-live="polite">
                  {solvingDay ? (
                    <div className="h-[150px] rounded-xl border border-white/10 bg-white/[0.03] flex flex-col items-center justify-center gap-2 text-slate-400">
                      <Loader2 className="w-5 h-5 animate-spin" />
                      <span className="text-sm">Finding what was possible…</span>
                    </div>
                  ) : daySolutions && (daySolutions.valid || daySolutions.perfect) ? (
                    <motion.div
                      initial={{ opacity: 0 }}
                      animate={{ opacity: 1 }}
                      transition={{ duration: 0.35 }}
                      className="space-y-2"
                    >
                      {daySolutions.valid && (
                        <div className="rounded-xl border bg-white/[0.03] p-3" style={{ borderColor: 'color-mix(in srgb, var(--u37-violet) 40%, transparent)' }}>
                          <div className="text-[10px] font-black uppercase tracking-wide text-center mb-1" style={{ color: 'var(--u37-violet)' }}>Valid Solve</div>
                          <div className="text-center text-base font-bold flex flex-wrap items-center justify-center gap-x-1">
                            <SolvedEquation equation={daySolutions.valid.equation} usedIndices={daySolutions.valid.usedIndices} colors={diceColors} />
                            <span className="text-slate-200"> = </span><Target37 className="font-black" />
                          </div>
                        </div>
                      )}
                      {daySolutions.perfect && (
                        <div className="rounded-xl border-2 p-3" style={{ borderColor: '#E9C45A', boxShadow: '0 0 18px -8px #E9C45A' }}>
                          <div className="text-[10px] font-black uppercase tracking-wide text-center mb-1" style={{ color: '#E9C45A' }}>Perfect Solve 🧩</div>
                          <div className="text-center text-base font-bold flex flex-wrap items-center justify-center gap-x-1">
                            <SolvedEquation equation={daySolutions.perfect.equation} usedIndices={daySolutions.perfect.usedIndices} colors={diceColors} highlightAllWhenPerfect />
                            <span className="text-slate-200"> = </span><Target37 className="font-black" />
                          </div>
                        </div>
                      )}
                    </motion.div>
                  ) : (
                    // Search finished but surfaced nothing (extremely rare for a
                    // real daily). Keep it gentle rather than showing an empty box.
                    <div className="h-[150px] rounded-xl border border-white/10 bg-white/[0.03] flex items-center justify-center text-center text-sm text-slate-400 px-4">
                      Today&apos;s dice didn&apos;t have a clean example solve to show.
                    </div>
                  )}
                  {/* A Valid Solve with NO Perfect Solve beside it used to render
                      as just… one card, with nothing saying why (Bryce, 1.0.287:
                      "did not show me an example of a Perfect Solve"). Say which
                      case it is. The solver reports whether it walked the whole
                      space or stopped at its op budget, so we never claim "no
                      perfect exists" when we only know "we didn't find one". */}
                  {!solvingDay && daySolutions?.valid && !daySolutions?.perfect && (
                    <div className="mt-2 rounded-xl border border-white/10 bg-white/[0.03] p-3 text-center text-xs text-slate-400">
                      {daySolutions.exhaustive
                        ? "No Perfect Solve was possible with today's dice — all 3 Power Dice used correctly couldn't reach 37."
                        : "We couldn't find a Perfect Solve to show for today's dice."}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* On a forfeit the Daily buttons sit BELOW the day's possible
                solves, where the old "Tomorrow's a fresh puzzle / Play Easy Mode"
                box was (removed 2026-09-29, David) — the solves are what that
                screen is for, so they keep the top. */}
            {forfeited && (
              <NextChallengeNudgeCard nudge={nudge} onPlayMode={handlePlayModeClick} onClose={onClose} inWorld={inWorld} />
            )}

            {/* Action buttons */}
            <div className="space-y-2">
              {/* ⚠️ ROLL NEW DICE WEARS THE MODE COLOUR; HOME IS ALWAYS CYAN.
                  This is the exact INVERSE of what shipped before, and it was
                  deliberate (David, 2026-09-12): "the easy screen needs to be the
                  roll new dice button being green and the home button being cyan
                  blue ... the expert needs a gold roll new dice and a cyan home
                  button."

                  It reads better because the two buttons answer different
                  questions. Roll New Dice keeps you in the tier you are playing,
                  so it should look like that tier. Home leaves it, and Home is the
                  same destination from every mode — so it should look the same
                  from every mode. Colouring Home by tier made the LEAVE button the
                  most tier-coloured thing on the screen. */}
              {newBadgeCount > 0 && (
                <ExitLink
                  exit={resultExit(inWorld, 'badges')}
                  goArgs={[earnedAwards]}
                  to={badgesUrlForAwards(earnedAwards)}
                  data-testid="success-see-badges"
                  className="block w-full rounded-xl py-3 text-center font-black border touch-manipulation active:scale-95"
                  style={{ color: 'var(--u37-gold)', borderColor: 'color-mix(in srgb, var(--u37-gold) 55%, transparent)' }}
                >
                  🏅 New badge{newBadgeCount > 1 ? 's' : ''}! See {newBadgeCount > 1 ? 'them' : 'it'} →
                </ExitLink>
              )}

              {!isDaily(mode) && (
                <Button
                  onClick={handleNewGameClick}
                  className="w-full font-black py-4 rounded-xl touch-manipulation active:scale-95"
                  style={neonFill(accent)}
                >
                  🎲 Roll New Dice
                </Button>
              )}

              <div className={statsExit.kind === 'hidden' ? 'grid grid-cols-1 gap-2' : 'grid grid-cols-2 gap-2'}>
                <Button
                  onClick={handleHomeClick}
                  className="w-full font-black py-4 rounded-xl border-0 touch-manipulation active:scale-95 flex items-center justify-center"
                  style={neonFill('var(--u37-cyan)')}
                >
                  {inWorld ? <Orbit className="w-5 h-5 mr-2" /> : <Home className="w-5 h-5 mr-2" />}
                  {inWorld ? ORBIT_HOME_LABEL : 'Home'}
                </Button>

                <ExitLink exit={statsExit} worldAs="div" to={createPageUrl('Statistics')} className="flex-1">
                  <Button
                    className="w-full font-black py-4 rounded-xl border-0 touch-manipulation active:scale-95 flex items-center justify-center"
                    style={neonFill('var(--u37-magenta)')}
                  >
                    <BarChart3 className="w-5 h-5 mr-2" />
                    Stats
                  </Button>
                </ExitLink>
              </div>

              {/* Share — Dailies only, mobile UA only (see handleShareClick). */}
              {canShare && (
                <Button
                  onClick={handleShareClick}
                  className="w-full font-black py-4 rounded-xl border-0 touch-manipulation active:scale-95"
                  style={neonFill('var(--u37-violet)')}
                >
                  <div className="flex items-center justify-center flex-1">
                    <Share2 className="w-5 h-5 mr-2" />
                    <span>Share</span>
                  </div>
                </Button>
              )}

            </div>
            </>
            )}
          </motion.div>
        </motion.div>
      )
      }
    </AnimatePresence >
  );
}