// Who should hear about the giveaway email check, and when?
//
// Pure, so every rule here is tested without rendering anything. The date
// itself lives in the leaf module emailVerifiedFrom.js.

import { contestToday } from './contestEntries';
import { hasDeclinedContestEligibility, meetsContestEligibility } from './contest';
import { emailVerificationRequired } from './emailVerifiedFrom';

export { EMAIL_VERIFIED_FROM, emailVerificationRequired } from './emailVerifiedFrom';

/**
 * Should this player see the "Verify your email to keep earning" heads-up?
 *
 * Only BEFORE the rule starts, only for a player who is otherwise eligible
 * (account, real email, said yes), and only when the server has said "not
 * verified". `null` (could not read) shows nothing: we never guess.
 *
 * @param {{ user: any, verified: boolean|'grace'|null, today?: string }} args
 */
export function showsVerifyHeadsUp({ user, verified, today = contestToday() }) {
  // In grace (unverified, not required yet): always the heads-up. A plain
  // `false` before the launch date is the pre-launch heads-up as before.
  if (verified !== 'grace' && (emailVerificationRequired(today) || verified !== false)) return false;
  if (hasDeclinedContestEligibility(user)) return false;
  return meetsContestEligibility(user);
}

/**
 * Is the missing verification costing this player entries right now?
 * The rule is live, the server said "not verified", and nothing else is missing.
 *
 * @param {{ user: any, verified: boolean|'grace'|null, today?: string }} args
 */
export function blocksEntryForVerification({ user, verified, today = contestToday() }) {
  return emailVerificationRequired(today) && verified === false && meetsContestEligibility(user);
}
