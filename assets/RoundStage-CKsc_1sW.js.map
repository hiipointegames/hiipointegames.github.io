// shell/reviewPrompt — ask the App Store / Google Play to show their built-in
// "Enjoying 37? Rate it" card, at a calm moment after a Daily WIN.
//
// WHY. Bryce's SEO email (2026-10-20): 25 iOS ratings and 11 on Play are too
// few to rank. The stores' own in-app review cards (Apple SKStoreReviewController,
// Google Play In-App Review) let a happy player rate without leaving the game.
//
// WHO DECIDES WHETHER THE CARD APPEARS. We only REQUEST it. The OS decides
// whether to actually show it (Apple: at most 3 times a year per app; Google: an
// unpublished quota), and neither tells us whether it did or what was rated.
// So this module's job is to ask rarely, and only at a good moment.
//
// OUR OWN RULES, on top of the OS limits (all must pass):
//   1. Native app only. Web: nothing (a store card makes no sense in a browser).
//   2. The AppReview plugin is compiled into THIS store build. CapGo OTA bundles
//      reach older store builds that do not have it; calling a missing plugin
//      throws, so `Capacitor.isPluginAvailable('AppReview')` is checked first and
//      those phones silently do nothing.
//   3. At least MIN_DAILY_WINS Daily wins on this phone (never the very first).
//   4. Not asked in the last MIN_DAYS_BETWEEN days, and never twice in one run.
//   5. The server switch app_settings.review_prompt is 'on' (or 'beta' and this
//      phone is on the beta channel). A missing row means OFF.
//   6. Right before asking: the caller says the results screen is still calm, and
//      no full-screen ad is open (adFreezeAlarm's "ad on screen" note).
// The caller (game-flow useDailyWinReviewPrompt) is responsible for WHEN: after
// the results screen has settled, with no badge pop-up or ad in the way.
//
// Members and guests both count: a store rating belongs to the player's Apple /
// Google account, not to their 37 account.
//
// NEVER THROWS. Storage blocked → no prompt (we cannot throttle, so we do not
// ask). Plugin error → reported to Sentry, swallowed.

import { Capacitor } from '@capacitor/core';
import { AppReview } from '@capawesome/capacitor-app-review';
import { captureError, recordOutcome } from '@/observability';
import { appSwitchAllows } from './appSwitch';
import { AD_OPEN_KEY } from './adFreezeAlarm';

export const REVIEW_SETTING_KEY = 'review_prompt';
export const REVIEW_PLUGIN = 'AppReview';
export const REVIEW_STORE_KEY = 'u37.reviewPrompt';
export const MIN_DAILY_WINS = 2;
export const MIN_DAYS_BETWEEN = 60;
const DAY_MS = 24 * 60 * 60 * 1000;

let askedThisRun = false;
const skipsLogged = new Set();

function store(deps) {
  if (deps.storage) return deps.storage;
  try { return window.localStorage; } catch { return null; }
}

/** @returns {{ wins: number, lastAskedAt: number|null }} throws if storage throws */
function readState(storage) {
  const raw = storage.getItem(REVIEW_STORE_KEY);
  let parsed = null;
  try {
    parsed = raw ? JSON.parse(raw) : null;
  } catch (e) {
    // Garbled state starts over at zero wins (the safe direction: it can only
    // delay a prompt). Reported, because only this module writes the key.
    captureError(asError(e), { where: 'review-prompt.state' });
    parsed = null;
  }
  const wins = Number.isFinite(parsed?.wins) && parsed.wins > 0 ? Math.floor(parsed.wins) : 0;
  const lastAskedAt = Number.isFinite(parsed?.lastAskedAt) ? parsed.lastAskedAt : null;
  return { wins, lastAskedAt };
}

/**
 * A Daily was won (the server accepted the solve). Counts toward MIN_DAILY_WINS.
 * Never throws.
 * @param {{ storage?: Storage }} [deps]
 * @returns {number|null} the new count, or null when storage is unavailable
 */
export function noteDailyWin(deps = {}) {
  try {
    const s = store(deps);
    if (!s) return null;
    const state = readState(s);
    const wins = state.wins + 1;
    s.setItem(REVIEW_STORE_KEY, JSON.stringify({ ...state, wins }));
    return wins;
  } catch {
    return null;
  }
}

/** Turn anything thrown into an Error so Sentry groups it properly. */
function asError(e) {
  if (e instanceof Error) return e;
  try { return new Error(typeof e === 'string' ? e : JSON.stringify(e)); } catch { return new Error(String(e)); }
}

/**
 * Ask the store for its review card if every rule passes. Never throws.
 *
 * Skips for routine reasons (web, too few wins, asked recently, asked this run)
 * are NOT logged: they happen on almost every win and would drown the table.
 * Skips at the last gate — the player qualified but something stopped us — are
 * logged, so client_events shows how many qualified players each one cost.
 *
 * @param {{ Capacitor?: any, plugin?: { requestReview: () => Promise<void> },
 *           storage?: Storage, now?: () => number, record?: Function,
 *           report?: Function, allows?: (key: string) => Promise<boolean>,
 *           stillCalm?: () => boolean }} [deps]
 *   stillCalm — from the caller: is the results screen still up with nothing on top?
 * @returns {Promise<{ requested: boolean, reason: string }>}
 */
export async function maybeRequestReview(deps = {}) {
  const record = deps.record || recordOutcome;
  const report = deps.report || captureError;
  try {
    const cap = deps.Capacitor || Capacitor;
    if (!cap.isNativePlatform?.()) return { requested: false, reason: 'web' };
    if (askedThisRun) return { requested: false, reason: 'this_run' };

    const s = store(deps);
    if (!s) return { requested: false, reason: 'storage' };
    let state;
    try { state = readState(s); } catch { return { requested: false, reason: 'storage' }; }
    if (state.wins < MIN_DAILY_WINS) return { requested: false, reason: 'too_few_wins' };
    const now = (deps.now || Date.now)();
    if (state.lastAskedAt != null && now - state.lastAskedAt < MIN_DAYS_BETWEEN * DAY_MS) {
      return { requested: false, reason: 'recently_asked' };
    }

    // From here the player qualifies, so a skip is worth counting.
    // Once per reason per app run: a switched-off prompt would otherwise log on
    // every single win.
    const skip = (reason) => {
      if (!skipsLogged.has(reason)) {
        skipsLogged.add(reason);
        record('review_prompt', 'skipped', { reason });
      }
      return { requested: false, reason };
    };
    if (!cap.isPluginAvailable?.(REVIEW_PLUGIN)) return skip('plugin_missing');
    if (!(await (deps.allows || appSwitchAllows)(REVIEW_SETTING_KEY))) return skip('switch_off');
    // Checked AFTER the switch read (which can take seconds), right before asking:
    // the player may have left the results screen, or an ad may have opened.
    if (deps.stillCalm && !deps.stillCalm()) return skip('left_screen');
    let adOpen = false;
    try { adOpen = Boolean(s.getItem(AD_OPEN_KEY)); } catch { adOpen = true; }
    if (adOpen) return skip('ad_open');

    // Write the throttle BEFORE asking: if the request hangs or the app dies
    // under the card, the next win must not ask again.
    try {
      s.setItem(REVIEW_STORE_KEY, JSON.stringify({ ...state, lastAskedAt: now }));
    } catch {
      return skip('storage');
    }
    askedThisRun = true;
    try {
      await (deps.plugin || AppReview).requestReview();
    } catch (e) {
      report(asError(e), { where: 'review-prompt.request' });
      record('review_prompt', 'failed', { code: e?.code != null ? String(e.code) : undefined });
      return { requested: false, reason: 'plugin_error' };
    }
    record('review_prompt', 'requested');
    return { requested: true, reason: 'ok' };
  } catch (e) {
    try { report(asError(e), { where: 'review-prompt' }); } catch { /* never break the game */ }
    return { requested: false, reason: 'error' };
  }
}

// Test-only reset of the once-per-run flag.
export function __resetReviewPromptForTests() { askedThisRun = false; skipsLogged.clear(); }
