import React from 'react';
import { Link } from 'react-router-dom';

// Where a results-card link goes — 37's route, a screen inside Sector 73, or
// nowhere (session 2026-10-19-s73-37-inside, design-v2 D9).
//
// The results card (SuccessModal, DailyWinResult, MemberPlacement,
// NextChallengeNudgeCard) has four links that LEAVE the page: Stats, the new-badge
// link, Leaderboards and the battle nudge. Inside Sector 73 the player must never
// leave the world (David, 2026-10-19), so the Sector 73 host passes
//
//   inWorld = { exits: { stats?, badges?, leaderboard?, battle? } }
//
// and each link then shows ONLY if its exit is a function — tapping it calls that
// function instead of changing the route. `inWorld` absent (37's /Game) = the
// original <Link>, unchanged. The info-screens session fills `exits` with its
// in-world screens; until then they are hidden (David's sign-off).
//
// An exit function is called on its own: the card does NOT close first. The
// host decides what opening its screen does to the round.

/** The Home button's label inside Sector 73: leaving the round means the world. */
export const ORBIT_HOME_LABEL = 'Back to orbit';

/**
 * @typedef {{ exits?: {
 *   stats?: () => void,
 *   badges?: (awards: any[]) => void,
 *   leaderboard?: () => void,
 *   battle?: () => void,
 * } }} InWorld
 */

/**
 * @param {InWorld | null | undefined} inWorld
 * @param {'stats'|'badges'|'leaderboard'|'battle'} name
 * @returns {{ kind: 'route' } | { kind: 'world', go: Function } | { kind: 'hidden' }}
 */
export function resultExit(inWorld, name) {
  if (!inWorld) return { kind: 'route' };
  const go = inWorld.exits?.[name];
  return typeof go === 'function' ? { kind: 'world', go } : { kind: 'hidden' };
}

/**
 * One results-card exit. `route` renders exactly the <Link> 37 always rendered
 * (same props, same order); `world` renders a `worldAs` element calling `go`
 * (`'div'` when the child is already a <Button>, so buttons never nest);
 * `hidden` renders nothing.
 *
 * @param {{ exit: ReturnType<typeof resultExit>, to: string, onClick?: any,
 *   goArgs?: any[], worldAs?: 'button'|'div', children?: React.ReactNode } & Record<string, any>} props
 */
export function ExitLink({ exit, to, onClick, goArgs = [], worldAs = 'button', children, ...rest }) {
  if (exit.kind === 'hidden') return null;
  if (exit.kind === 'world') {
    const Tag = worldAs;
    return (
      <Tag {...(Tag === 'button' ? { type: 'button' } : {})} {...rest} onClick={() => exit.go(...goArgs)}>
        {children}
      </Tag>
    );
  }
  return (
    <Link to={to} onClick={onClick} {...rest}>
      {children}
    </Link>
  );
}
