import React from 'react';
import DiceDisplay from '@/puzzle-input/DiceDisplay';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';
import { isPerfectSolve } from '@/equation-engine';
import { hasPowerDice, hasPerfectConcept } from '@/game-modes';
import { formatSolveTime } from '@/ui/feedback';

// The ONE result card on the condensed Daily win screen (Layout A, David
// 2026-10-18): the day's roll, then the equation and the solve time side by
// side, then the Perfect Solve / power-dice line where the mode has power dice.
//
// It used to be three stacked blocks in SuccessModal — the roll, a tall
// equation box, and a separate "Your Time" pill — which together pushed the
// buttons below the banner ad on an S21. Same facts, one card.
//
// ⚠️ THE DICE ARE THE REAL DICE. David: "you can not lose the actual dice
// graphics". This is the board's own DiceDisplay in its compact one-row mode,
// not a drawing of dice. `usedIndices={[]}` is deliberate: this is the ROLL as
// it was dealt; the used dice are already coloured in the equation beside it.

/**
 * The precise solve time, `M:SS.HH`.
 *
 * Delegates to the app's one formatter (@/ui/feedback formatSolveTime) rather
 * than its own copy. The copy carried the float bug fixed there on 2026-09-10:
 * `Math.floor((t % 1) * 100)` turns 144.92 into "2:24.91" because 144.92 % 1 is
 * 0.91999…, so the win screen under-reported times by a hundredth about half
 * the time and disagreed with the leaderboard (bug found 2026-10-18).
 *
 * @param {number} solveTime seconds, may carry hundredths
 * @returns {string}
 */
export function formatResultTime(solveTime) {
  return formatSolveTime(solveTime);
}

/**
 * @param {{
 *   mode: string,
 *   accent: string,
 *   dice?: number[] | null,
 *   diceColors?: string[] | null,
 *   equation: string,
 *   usedDiceIndices?: number[] | null,
 *   solveTime?: number | null,
 *   showTime?: boolean,
 * }} props
 *   showTime — false when the caller shows the time itself (the condensed win
 *   screen puts it in its header so the equation gets the full width; on a
 *   real S21 the equation wrapped beside the time — 2026-10-18 device check).
 */
export default function ResultCard({ mode, accent, dice, diceColors, equation, usedDiceIndices, solveTime, showTime = true }) {
  const perfect = isPerfectSolve(equation, usedDiceIndices, diceColors);
  const goldFrame = hasPerfectConcept(mode) && perfect;
  const hasRoll = Array.isArray(dice) && dice.length === 7;
  const hasTime = showTime && typeof solveTime === 'number' && Number.isFinite(solveTime);

  return (
    <div
      data-testid="result-card"
      className={`mt-2.5 rounded-2xl px-2.5 py-2 bg-slate-700/40 ${goldFrame
        ? 'border-2 border-amber-400 shadow-lg shadow-amber-500/40'
        : 'border border-slate-600/40'}`}
    >
      {hasRoll && (
        <div data-testid="success-daily-roll">
          <DiceDisplay dice={dice} usedIndices={[]} onDiceClick={() => {}} disabled mode={mode} colors={diceColors} compact />
        </div>
      )}

      <div className={`mt-1.5 flex items-center gap-2 ${hasTime ? 'justify-between' : 'justify-center'}`}>
        <p data-testid="result-equation" className={`min-w-0 text-base font-mono font-bold leading-snug ${hasTime ? '' : 'text-center'}`}>
          <SolvedEquation
            equation={equation}
            usedIndices={usedDiceIndices}
            colors={diceColors}
            highlightAllWhenPerfect={hasPerfectConcept(mode)}
          />
          {' '}<span className="text-slate-200">= </span>
          <Target37 className="font-black drop-shadow-[0_2px_8px_rgba(251,191,36,0.4)]" />
        </p>
        {hasTime && (
          <div data-testid="result-time" className="flex-shrink-0 text-right leading-none">
            <span className="block text-[9px] font-black uppercase tracking-wider text-slate-400">Your Time</span>
            <span
              className="block mt-0.5 text-xl font-black tabular-nums"
              style={{ color: accent, textShadow: `0 0 12px color-mix(in srgb, ${accent} 45%, transparent)` }}
            >
              {formatResultTime(solveTime)}
            </span>
          </div>
        )}
      </div>

      {/* "Perfect Solve" is the phrase the calendar legend, the profile legend,
          the badges and the stats slide all use. Easy has no power dice, so no
          line (ruling Q-G). */}
      {hasPowerDice(mode) && (
        <div data-testid="result-power-legend" className="mt-1.5 flex items-center justify-center gap-2 text-[11px] text-slate-300">
          <span className="border-2 rounded w-4 h-4 inline-block flex-shrink-0" style={{ borderColor: 'var(--u37-gold)', boxShadow: '0 0 6px var(--u37-gold)' }} />
          <span>= {perfect ? 'Perfect Solve — all 3 Power Dice used correctly!' : 'Power Dice used with correct operation'}</span>
        </div>
      )}
    </div>
  );
}
