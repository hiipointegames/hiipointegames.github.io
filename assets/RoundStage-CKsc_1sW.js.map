// The rejected-Power-Dice-submission feedback: shake the Submit button, show
// "try again", flag the colour-rule error, then clear all three three seconds
// later so the player can attempt the board again. Lifted out of Game.jsx's
// handleSubmit — Game.jsx is a grandfathered arch-ratchet blob that may only
// shrink (see gameEntryModel.js, useTodaysSolveRecap.js for the same rationale).

/**
 * @param {{
 *   setShakeButton: (v: boolean) => void,
 *   setShowTryAgain: (v: boolean) => void,
 *   setShowColorRuleError: (v: boolean) => void,
 * }} setters
 */
export function triggerPowerDiceShake({ setShakeButton, setShowTryAgain, setShowColorRuleError }) {
  setShakeButton(true);
  setShowTryAgain(true);
  setShowColorRuleError(true);
  setTimeout(() => {
    setShakeButton(false);
    setShowTryAgain(false);
    setShowColorRuleError(false);
  }, 3000);
}
