import React, { useLayoutEffect, useRef } from 'react';
import { Share2, Home, BarChart3, Orbit } from 'lucide-react';
import { createPageUrl } from '@/routing/createPageUrl';
import { formatSolveTime } from '@/ui/feedback';
import { LockedPlacement } from '@/soft-wall';
import { modeTierLabel } from '@/game-modes';
import { WinMedallion } from '@/dice-visuals';
import { Button } from '@/ui/primitives/button';
import ResultCard from './ResultCard';
import MemberPlacement from './MemberPlacement';
import GiveawayLine from './GiveawayLine';
import NextChallengeNudgeCard from './NextChallengeNudgeCard';
import { badgesUrlForAwards } from './badgeTargetForAward';
import { formatResultTime } from './ResultCard';
import { applyFitZoom, nearestScroller } from './fitToScreen';
import { resultExit, ExitLink, ORBIT_HOME_LABEL } from './resultExits';

// The condensed Daily WIN screen — "Layout A", approved by David 2026-10-18
// (.workshop/mockups/results-condensed-2026-10-18.html).
//
// The result screen had grown to well over one S21 screen: a 72px medallion and
// a 3xl title, the roll, a tall equation box, a separate time pill, the podium
// card, stacked next-Daily buttons, the full giveaway notice, then the buttons —
// so Share and Home sat under the banner ad. Every one of those facts is still
// here, top to bottom, inside one modal card:
//
//   1. one-line header: small 37 medallion + "<Mode> Daily solved"
//   2. ONE result card: the real dice, the equation beside the time, the
//      power-dice line (ResultCard)
//   3. today's podium — the centrepiece (LockedPlacement for a guest, the real
//      rows + Leaderboards link for a member)
//   4. up next — the adaptive Daily buttons, side by side
//   5. the giveaway as one line; its full checklist opens in a sheet
//   6. the "New badge!" link, one line
//   7. small Home + Stats, big Share
//
// Only the Daily WIN uses this. A forfeit and a practice win keep the original
// SuccessModal layout — they were not part of the ask.

/**
 * The home screen's neon-FILLED button look (V3): solid neon, near-black label,
 * soft glow and a top inset highlight. Shared with SuccessModal's other paths.
 *
 * @param {string} c a CSS colour
 */
export const neonFill = (c) => ({
  background: c,
  color: '#050310',
  boxShadow: `0 0 26px -7px ${c}, inset 0 1px 0 rgba(255,255,255,0.4)`,
});

/** A small all-caps section heading, as in the mockup. */
function SectionLabel({ children, testId }) {
  return (
    <div data-testid={testId} className="mt-2.5 mb-1 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
      {children}
    </div>
  );
}

/**
 * @param {{
 *   mode: string,
 *   accent: string,
 *   dice?: number[] | null,
 *   diceColors?: string[] | null,
 *   equation: string,
 *   usedDiceIndices?: number[] | null,
 *   solveTime?: number | null,
 *   isGuestViewer: boolean,
 *   board?: any[] | null,
 *   userId?: string | null,
 *   nudge: any,
 *   statusByMode?: Record<string, string> | null,
 *   earnedAwards: Array<Record<string, any>>,
 *   newBadgeCount: number,
 *   canShare: boolean,
 *   onClose: () => void,
 *   onPlayModeClick: (e: any, targetMode: string) => void,
 *   onHomeClick: (e: any) => void,
 *   onShareClick: (e: any) => void,
 *   inWorld?: import('./resultExits').InWorld,
 * }} props
 *   inWorld — the Sector 73 host (see ./resultExits): Home reads "Back to
 *   orbit" and Stats / Leaderboards / the badge link show only for a given exit.
 */
export default function DailyWinResult({
  mode, accent, dice, diceColors, equation, usedDiceIndices, solveTime,
  isGuestViewer, board, userId, nudge, statusByMode, earnedAwards, newBadgeCount,
  canShare, onClose, onPlayModeClick, onHomeClick, onShareClick, inWorld,
}) {
  const tier = modeTierLabel(mode);
  const timeLabel = Number.isFinite(solveTime) ? formatSolveTime(solveTime) : null;
  const smallBtn = canShare ? 'min-w-[76px] flex-shrink-0' : 'flex-1'; // grows with big phone text (2026-10-18)
  const hasTime = typeof solveTime === 'number' && Number.isFinite(solveTime);

  // ONE SCREEN, EVEN WITH BIG PHONE FONTS (David, 2026-10-18 device check). The
  // trims below fit a stock S21, but Android's font-size setting scales text in
  // the WebView, and larger text pushed Home/Stats/Share under the banner ad.
  // If the card still overflows its scroller, it shrinks to fit (never below
  // MIN_FIT_ZOOM in ./fitToScreen) — re-measured when the scroller resizes.
  const rootRef = useRef(/** @type {HTMLDivElement | null} */(null));
  useLayoutEffect(() => {
    const el = rootRef.current;
    const scroller = el && nearestScroller(el);
    if (!el || !scroller) return undefined;
    const fit = () => applyFitZoom(el, scroller);
    fit();
    const ro = typeof ResizeObserver === 'function' ? new ResizeObserver(fit) : null;
    ro?.observe(scroller);
    return () => ro?.disconnect();
  }, []);

  return (
    <div data-testid="daily-win-result" ref={rootRef}>
      {/* 1. Header — the X is SuccessModal's own close button, top-right. The
          time sits here (not beside the equation) so the equation gets the
          card's full width — it wrapped on a real S21. */}
      <div className="flex items-center gap-2 pr-8">
        <WinMedallion size={30} />
        <h2
          data-testid="daily-win-title"
          className="flex-1 min-w-0 text-lg font-black leading-tight"
          style={{ color: accent, textShadow: `0 0 12px color-mix(in srgb, ${accent} 50%, transparent)` }}
        >
          {tier} Daily solved
        </h2>
        {hasTime && (
          <div data-testid="result-time" className="flex-shrink-0 text-right leading-none">
            <span className="block text-[9px] font-black uppercase tracking-wider text-slate-400">Your Time</span>
            <span
              className="block mt-0.5 text-lg font-black tabular-nums"
              style={{ color: accent, textShadow: `0 0 12px color-mix(in srgb, ${accent} 45%, transparent)` }}
            >
              {formatResultTime(solveTime)}
            </span>
          </div>
        )}
      </div>

      {/* 2. The result */}
      <ResultCard
        mode={mode}
        accent={accent}
        dice={dice}
        diceColors={diceColors}
        equation={equation}
        usedDiceIndices={usedDiceIndices}
        solveTime={solveTime}
        showTime={false}
      />

      {/* 3. Today's podium. A guest sees their time but not where they placed —
          that is the account perk (soft wall, 2026-10-10). */}
      <SectionLabel testId="daily-win-podium-label">Today&apos;s {tier} Daily podium</SectionLabel>
      {isGuestViewer ? (
        <LockedPlacement
          compact
          timeLabel={timeLabel}
          onCreate={() => { onClose?.(); window.dispatchEvent(new Event('openSaveStats')); }}
        />
      ) : (
        <MemberPlacement board={board} userId={userId} timeLabel={timeLabel} accent={accent} onClose={onClose} inWorld={inWorld} />
      )}

      {/* 4. Up next — the adaptive nudge (nextChallengeNudge), side by side. */}
      <NextChallengeNudgeCard compact nudge={nudge} onPlayMode={onPlayModeClick} onClose={onClose} inWorld={inWorld} />

      {/* 5. The giveaway, one line; the whole notice is behind the tap. */}
      <GiveawayLine mode={mode} statusByMode={statusByMode} onLeave={onClose} />

      {/* 6. New badge */}
      {newBadgeCount > 0 && (
        <ExitLink
          exit={resultExit(inWorld, 'badges')}
          goArgs={[earnedAwards]}
          to={badgesUrlForAwards(earnedAwards)}
          data-testid="success-see-badges"
          className="mt-1.5 w-full min-h-[32px] rounded-xl border px-3 flex items-center gap-2 text-[13px] font-black touch-manipulation active:scale-[0.98]"
          style={{ color: 'var(--u37-gold)', borderColor: 'color-mix(in srgb, var(--u37-gold) 55%, transparent)' }}
        >
          <span className="flex-1">🏅 New badge{newBadgeCount > 1 ? 's' : ''}! See {newBadgeCount > 1 ? 'them' : 'it'}</span>
          <span aria-hidden="true">→</span>
        </ExitLink>
      )}

      {/* 7. Actions — Home is always cyan, Stats magenta, Share the big one. */}
      <div className="mt-2 flex gap-2" data-testid="daily-win-actions">
        <Button
          onClick={onHomeClick}
          className={`${smallBtn} h-11 px-2 font-black rounded-xl border-0 touch-manipulation active:scale-95 flex items-center justify-center text-xs`}
          style={neonFill('var(--u37-cyan)')}
        >
          {inWorld ? <Orbit className="w-4 h-4 mr-1" /> : <Home className="w-4 h-4 mr-1" />}
          {inWorld ? ORBIT_HOME_LABEL : 'Home'}
        </Button>
        <ExitLink exit={resultExit(inWorld, 'stats')} worldAs="div" to={createPageUrl('Statistics')} className={smallBtn}>
          <Button
            className="w-full h-11 px-2 font-black rounded-xl border-0 touch-manipulation active:scale-95 flex items-center justify-center text-xs"
            style={neonFill('var(--u37-magenta)')}
          >
            <BarChart3 className="w-4 h-4 mr-1" />
            Stats
          </Button>
        </ExitLink>
        {canShare && (
          <Button
            onClick={onShareClick}
            data-testid="success-share"
            className="flex-1 h-11 font-black rounded-xl border-0 touch-manipulation active:scale-95 text-lg"
            style={neonFill('var(--u37-violet)')}
          >
            <div className="flex items-center justify-center flex-1">
              <Share2 className="w-5 h-5 mr-2" />
              <span>Share</span>
            </div>
          </Button>
        )}
      </div>
    </div>
  );
}
