import { submitDailyLeaderboardTime, hasDailyTimeRow } from '@/daily-challenge';
import { reportSolveFailure, SOLVE_STAGE, recordOutcome } from '@/observability';

// leaderboardSubmit — submit the solve, and decide whether the player deserves
// to be ALARMED about the result.
//
// ─────────────────────────────────────────────────────────────────────────────
// 🔴 THE BUG THIS EXISTS TO KILL (Chandler, 2026-09-06)
// ─────────────────────────────────────────────────────────────────────────────
// A player solved Easy, saw a full win screen with their time — and a red banner
// reading "Your time was not saved to the leaderboard. Check your connection."
//
// Their time WAS saved. Verified on production: the `daily_easy` row exists for
// that date with the exact equation from the screenshot. The banner was a lie,
// and it is the worst kind: it tells someone their effort was lost while the
// screen behind it congratulates them.
//
// HOW. `submit-daily-time` answers domain rejections IN-BAND — `fail(code, …)`
// with HTTP **200** — for at least six conditions: `no_attempt`,
// `already_completed`, `already_forfeited`, `too_fast`, `expired`, and invalid
// input. The call site treated EVERY non-success as "the leaderboard write
// failed" and toasted. But two of those codes do not mean the row is missing:
//
//   • `already_completed` means the row is ALREADY THERE. It is the one code
//     that positively confirms the write the player is being told did not happen.
//   • And a rejection from this referee does not mean nothing was written at
//     all, because it is not the only writer: `daily-challenge-controller`'s
//     submit still performs a Phase-1 fallback insert right after this call.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE RULE
// ─────────────────────────────────────────────────────────────────────────────
// Never tell a player their solve was lost without KNOWING it was. So:
//
//   1. `already_completed` is a SUCCESS. The row exists; that is the whole claim.
//   2. Any other rejection is CHECKED against the table before the player is
//      told anything. If the row is there, the player sees nothing.
//   3. Sentry hears about all of it either way. Silence toward the player is not
//      silence toward us — the observability is what caught this, and losing it
//      would trade one blindness for another.
//
// ⚠️ (3) is the half worth defending. The obvious "fix" is to stop toasting on
// rejections, which would have hidden this bug rather than surfaced it. The
// report always fires; only the ALARM is gated on evidence.

/** Rejection codes that mean the leaderboard row exists. */
const ROW_EXISTS_CODES = new Set(['already_completed']);

const codeOf = (error) => (typeof error === 'string' ? error : error?.code) ?? null;

/**
 * Submit a finished daily solve and report the outcome honestly.
 *
 * @param {Object} args
 * @param {string} args.mode        the daily wire key — MUST be named, or the solve lands on Challenge's board
 * @param {string} args.equation
 * @param {number[]} args.usedDiceIndices
 * @param {string[]} args.diceColors
 * @param {number[]} args.shuffledDice
 * @param {number} [args.deviceTimeMs]
 * @param {string} [args.userId]    used only to check whether the row landed
 * @param {string} [args.date]      the ET date the row would carry
 * @param {Object} [deps] injected for tests; production passes nothing
 * @returns {Promise<{saved: boolean, alarmed: boolean, code: string|null}>}
 */
export async function submitAndReportDailyTime(args, deps = {}) {
  const out = await submitAndReport(args, deps);
  // Outcome COUNTS (client_events): every submit, not just the failures Sentry
  // hears about, so the lost-solve RATE is visible. Fire-and-forget.
  (deps.record || recordOutcome)('daily_submit', submitOutcome(out), { mode: args.mode, code: out.code });
  return out;
}

/** 'saved' | 'already-saved' | 'saved-checked' (rejected, but the row is there) | 'lost'. */
export function submitOutcome({ saved, code }) {
  if (!saved) return 'lost';
  if (!code) return 'saved';
  return code === 'already_completed' ? 'already-saved' : 'saved-checked';
}

/**
 * The submit + honest report itself; submitAndReportDailyTime wraps it to count
 * the outcome.
 * @param {Object} args
 * @param {string} args.mode
 * @param {string} args.equation
 * @param {number[]} args.usedDiceIndices
 * @param {string[]} args.diceColors
 * @param {number[]} args.shuffledDice
 * @param {number} [args.deviceTimeMs]
 * @param {string} [args.userId]
 * @param {string} [args.date]
 * @param {Object} [deps]
 * @returns {Promise<{saved: boolean, alarmed: boolean, code: string|null}>}
 */
async function submitAndReport({
  mode, equation, usedDiceIndices, diceColors, shuffledDice, deviceTimeMs, userId, date,
}, deps = {}) {
  const {
    submit = submitDailyLeaderboardTime,
    rowExists = hasDailyTimeRow,
    report = reportSolveFailure,
  } = deps;

  let result;
  try {
    result = await submit({ mode, equation, usedDiceIndices, diceColors, shuffledDice, deviceTimeMs });
  } catch (error) {
    // A THROW is a transport failure — the port could not run at all. There is
    // no result to interpret, so the row is checked the same way a rejection is.
    return finish({ error, code: null, rejected: false, mode, userId, date, rowExists, report });
  }

  if (result?.success) return { saved: true, alarmed: false, code: null };

  const code = codeOf(result?.error);

  // 1. The referee is telling us the row is already there. That is not a failure
  //    to write; it is a confirmation of a write.
  if (ROW_EXISTS_CODES.has(code)) {
    report(SOLVE_STAGE.leaderboardWrite, result?.error, {
      mode, code, rejected: true, alarmed: false, rowPresent: true,
    });
    return { saved: true, alarmed: false, code };
  }

  return finish({ error: result?.error, code, rejected: true, mode, userId, date, rowExists, report });
}

/**
 * Report, and alarm ONLY if the row is genuinely absent.
 *
 * A failed existence check counts as "cannot confirm", and cannot-confirm alarms
 * — the check exists to suppress a FALSE alarm, never to invent confidence. If
 * we cannot see the table we are back where we started, which is the honest
 * place to be.
 */
async function finish({ error, code, rejected, mode, userId, date, rowExists, report }) {
  let present = false;
  if (userId && date) {
    try {
      present = await rowExists({ userId, date, mode });
    } catch {
      present = false;
    }
  }
  // `code` is passed so the player gets the sentence that matches what actually
  // happened. The one line this used to always show — "your solve counted, but
  // it could not be added to today's board, check your connection" — is false in
  // both halves for an `expired` refusal: nothing counted, and the connection was
  // fine. See observability/solveFailure for the vocabulary.
  report(SOLVE_STAGE.leaderboardWrite, error, {
    mode, code, rejected, alarmed: !present, rowPresent: present,
  });
  return { saved: present, alarmed: !present, code };
}
