// Prepare the Daily share card as soon as a result is on screen, so the Share tap
// opens the share sheet straight away.
//
// WHY (2026-10-03): a browser — and iOS's WKWebView on an app build without the
// native Share plugin — only opens a share sheet while the tap's user activation
// is still live. Building the card after the tap (board + user + dice reads, the
// link save, the PNG conversion) outlived it, so the share was refused and the
// tap did nothing. Bryce hit it on an iPhone running the 1.0.318 OTA. See
// @/share-card prepareDailyResult.
//
// The native plugin route doesn't need user activation, but it gets the faster
// sheet too.

import { useCallback, useEffect, useRef } from 'react';
import { prepareDailyShareCard, sendPreparedShare, shareDailyCard } from './dailyShareCard';
import { shareResolvedDaily } from './dailyShare';
import { track } from '@/observability';

/**
 * The home result card's Share: shareResolvedDaily, with the card prepared as
 * soon as the Daily is resolved and its board has loaded.
 * @param {object} p same fields as shareResolvedDaily, minus `method`
 * @returns {(method: string) => Promise<void>}
 */
export function useResolvedDailyShare({ leaderboard = [], userId, mode, completed, forfeited, today }, deps = {}) {
  // Prepare only when shareResolvedDaily will actually use the card: a forfeit,
  // or a completion whose own timed row is on the board. A card prepared before
  // the row loads would have no time on it.
  const own = leaderboard.find((r) => r && r.user_id === userId);
  const resolved = !!userId && (!!forfeited || (!!completed && Number(own?.solve_time_seconds) > 0));
  const identity = resolved ? [mode, forfeited ? 'f' : 'c', userId].join('|') : null;
  const shareCard = usePreparedDailyShare({
    // A board refresh re-prepares (fresher percentile) under the SAME identity,
    // so the previous card stays usable meanwhile.
    key: identity && `${identity}|${leaderboard.length}`,
    identity,
    getFacts: async () => ({ mode: mode || 'daily', forfeited: !!forfeited, board: leaderboard, userId }),
  }, deps);
  return useCallback((method) => shareResolvedDaily(
    { method, leaderboard, userId, mode, completed, forfeited, today },
    { shareDailyCard: ({ fallbackText }) => shareCard(fallbackText) },
  ), [leaderboard, userId, mode, completed, forfeited, today, shareCard]);
}

/**
 * @param {object} p
 * @param {string|null} p.key identifies the result being shared; null = nothing
 *   resolved yet. A new key re-prepares (a different mode, a result that loaded).
 * @param {string|null} [p.identity] which result this is, without the refresh
 *   detail; defaults to `key`. While a new key with the SAME identity prepares,
 *   the previous card stays usable. Without this, every board refresh opened a
 *   window where a tap fell back to the slow path (37-THE-MATH-PUZZLE-2V).
 * @param {() => Promise<object>} p.getFacts resolves the shareDailyCard facts
 *   (mode, forfeited, seconds, perfect, dice, squares, board, userId).
 * @param {object} [deps] test seams: prepare, send, shareNow
 * @returns {(fallbackText: (text: string) => Promise<void>) => Promise<string>}
 *   the Share tap.
 */
export function usePreparedDailyShare({ key, identity = key, getFacts }, deps = {}) {
  const state = useRef({
    key: null, identity: null, prepared: null, pending: /** @type {Promise<any>|null} */ (null),
  });
  const latest = useRef(getFacts);
  latest.current = getFacts;
  const depsRef = useRef(deps);
  depsRef.current = deps;

  useEffect(() => {
    if (!key) return;
    const prepare = depsRef.current.prepare || prepareDailyShareCard;
    const prev = state.current;
    // Same result, just refreshed: keep the old card until the new one is ready.
    const carried = prev.identity === identity ? prev.prepared : null;
    const entry = { key, identity, prepared: carried, pending: null };
    entry.pending = Promise.resolve()
      .then(() => latest.current())
      .then((facts) => prepare(facts))
      .then((prepared) => { entry.prepared = prepared; return prepared; })
      .catch(() => carried); // keep the carried card; null → the one-shot flow
    state.current = entry;
  }, [key, identity]);

  return useCallback((fallbackText) => {
    const d = depsRef.current;
    const send = d.send || sendPreparedShare;
    const { prepared, pending } = state.current;
    // FAST PATH: no await before the share sheet opens.
    track('share.tap', { route: prepared ? 'prepared' : pending ? 'waited' : 'oneshot' });
    if (prepared) return send(prepared, fallbackText);
    // Tapped mid-preparation: wait for THAT preparation (not a second fetch).
    // Too late for a browser's user activation, but the native plugin route
    // doesn't need it, and it's what the old flow did on every tap.
    const oneShot = () => Promise.resolve(latest.current())
      .then((facts) => (d.shareNow || shareDailyCard)({ ...facts, fallbackText }));
    if (pending) return pending.then((ready) => (ready ? send(ready, fallbackText) : oneShot()));
    return oneShot();
  }, []);
}
