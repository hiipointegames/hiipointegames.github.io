import React, { useState } from 'react';
import { CONTEST_VOID, CONTEST_ODDS, CONTEST_EMAILS } from './contestLegal';
import { Trophy, ExternalLink, X } from 'lucide-react';

import { useAuth } from '@/auth';
import { apiClient } from '@/transport';
import { announceProfileChanged } from './announceProfileChanged';

import {
  CONTEST,
  CONTEST_HEADLINE,
  CONTEST_CLAIM,
  CONTEST_PAYMENT,
  CONTEST_SPONSOR_DISCLAIMER,
  CONTEST_LINK_LABEL,
  CONTEST_ACCOUNT_PROMPT,
  CONTEST_ACCOUNT_CTA,
  CONTEST_EMAIL_PROMPT,
  CONTEST_EMAIL_CTA,
  CONTEST_AGE_PROMPT,
  CONTEST_AGE_DECLINED_NOTE,
  CONTEST_AGE_UNDECLINE_CTA,
  CONTEST_AGE_WITHDRAW_CTA,
  hasConfirmedContestEligibility,
  CONTEST_AGE_WITHDRAWN_NOTE,
  CONTEST_AGE_CTA,
  CONTEST_ENTRY_RULE,
  CONTEST_NO_ENTRY,
  CONTEST_DRAW_SCHEDULE,
  CONTEST_ELIGIBILITY_META_KEY,
  buildContestEligibilityAttestation,
  contestNudgeFor,
} from './contest';
import { CONTEST_SHEET_FACE, CONTEST_FULL_RULES_LABEL } from './contestSheetFace';
import { useGiveawayEmailVerified } from './useGiveawayEmailVerified';
import EmailVerifyNotice from './EmailVerifyNotice';

// ContestDetails — everything about the $37 giveaway, on one sheet.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THE DETAIL LEFT THE HOME SCREEN
// ─────────────────────────────────────────────────────────────────────────────
// David asked for two things on 2026-09-11 that pull against each other: the
// sweepstakes facts ("correct dates, entry info, and competition windows") had
// to be in the app, and the home screen had to stop cutting off the podium. It
// was overrunning the nav band by 195px on Challenge — MEASURED on a 360x800
// viewport, not estimated — and the full promo was 196px of that.
//
// So the home screen keeps a one-bar chip (ContestBanner) and every fact that
// does not fit on it lives here, one tap away. The chip still carries the two
// things a player needs at a glance — that there is a $37 prize and that the
// week closes on Saturday — because a promo you have to open to learn anything
// from is a promo nobody opens.
//
// ⚠️ THE GUEST PROMPT MOVED HERE WITH IT, AND THAT IS THE PART TO WATCH. It is
// the only actionable control in the whole promo, and roughly 97% of accounts
// are anonymous guests who need it (1,540 of 1,576 on prod, 2026-09-05). On the
// home screen it was unmissable; here it needs a tap first. It is placed FIRST
// in the sheet, above the rules, for exactly that reason — if a guest opens
// this, the first thing they see is the one thing standing between them and
// being able to win.
//
// The rules themselves are deliberately NOT duplicated: this is the summary and
// the .com page is the source (see contest.js).

/** One labelled fact: a small caps LABEL over its value, hairline-separated.
 *
 *  Labelled rather than prose on purpose — a player opening this sheet has one
 *  specific question ("when is it drawn?", "can I even enter?") and a label is
 *  what lets them find the answer without reading the other three. */
function Fact({ label, children }) {
  return (
    <div className="flex flex-col gap-0.5 py-2 border-b border-white/5 last:border-b-0">
      <span className="text-[10px] font-black uppercase tracking-widest text-slate-500">
        {label}
      </span>
      <span className="text-[12px] font-semibold leading-snug text-slate-200">
        {children}
      </span>
    </div>
  );
}

/**
 * @param {Object} props
 * @param {() => void} props.onClose dismiss the sheet
 */
export default function ContestDetails({ onClose }) {
  const { user } = useAuth();
  const nudge = contestNudgeFor(user);
  // The email check (from 25 Oct 2026). null = unknown → EmailVerifyNotice shows nothing.
  const emailVerified = useGiveawayEmailVerified(user);

  // Both flows live at the Layout level and open by event — the same route the
  // Statistics page uses for Save-Stats. Closing first means the player lands on
  // the save form rather than on it behind this sheet.
  const openFlow = () => {
    onClose?.();
    window.dispatchEvent(new Event(nudge === 'account' ? 'openSaveStats' : 'openAddEmail'));
  };

  // The 'age' nudge is the one nudge that does NOT open another screen.
  //
  // The other two need a form — a password, an email address. This one needs
  // a single yes from someone who is already reading the giveaway terms, so
  // sending them to a separate modal to tick one box would be the longer,
  // worse version of a control that can just live here. It also keeps the
  // affirmation next to the terms it affirms, which is where it belongs.
  //
  // Local `confirmed` rather than re-reading the user: useAuth's object does
  // not necessarily re-render on a metadata write, and a tick that visibly
  // does nothing reads as broken and gets tapped again.
  const [confirming, setConfirming] = useState(false);
  const [confirmed, setConfirmed] = useState(false);
  const [confirmError, setConfirmError] = useState('');

  // The mirror of confirmEligibility. Same shape on purpose: same busy guard,
  // same surfaced error, same local flag — a player who withdraws and is not
  // told it failed will believe they are out when they are still in, which is
  // the same harm as the other direction and just as unacceptable.
  const [withdrawn, setWithdrawn] = useState(false);

  const withdrawEligibility = async () => {
    if (confirming || withdrawn) return;
    setConfirming(true);
    setConfirmError('');
    try {
      await apiClient.auth.updateMe({
        [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(false),
      });
      setWithdrawn(true);
      await announceProfileChanged();
    } catch {
      setConfirmError('Could not save that. Check your connection and try again.');
    } finally {
      setConfirming(false);
    }
  };

  const confirmEligibility = async () => {
    if (confirming || confirmed) return;
    setConfirming(true);
    setConfirmError('');
    try {
      await apiClient.auth.updateMe({
        [CONTEST_ELIGIBILITY_META_KEY]: buildContestEligibilityAttestation(true),
      });
      setConfirmed(true);
      await announceProfileChanged();
    } catch {
      // Surfaced rather than swallowed: a player who ticks this and is not
      // told it failed will believe they are entered when they are not —
      // which is the exact harm this whole change exists to prevent.
      setConfirmError('Could not save that. Check your connection and try again.');
    } finally {
      setConfirming(false);
    }
  };

  return (
    <div
      data-testid="contest-details"
      className="w-full max-w-sm mx-auto rounded-2xl border p-4 backdrop-blur overflow-y-auto"
      style={{
        background: 'var(--u37-panel-bg)',
        borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
        boxShadow: '0 18px 60px rgba(0,0,0,0.5), 0 0 34px -18px var(--u37-gold)',
        // ⚠️ THE AD BANNER SITS OVER THE BOTTOM OF THE WEBVIEW ON A PHONE.
        //
        // This sheet was the ONE modal in the app without this constraint — 18
        // other files carry it (AddEmailPrompt, SaveStatsModal, BadgeDetailModal,
        // InitialWelcomeModal, the drawer, …). It got away with it while it was
        // short enough not to matter.
        //
        // MEASURED 2026-09-12 at 360x800, on the live web build, after the claim
        // and payment rows landed: the sheet is 716px and ends 758px down. A
        // ~50-55dp adaptive banner plus its 55px Android margin eats past that,
        // so the last thing to be covered is the LAST THING ON THE SHEET — the
        // sponsor disclaimer, which is a contractual obligation under Apple PLA
        // §3.3.4(A)(vi), not decoration. Adding two rows of text is what pushed
        // it over; the fix is to stop the sheet running under the banner at all.
        //
        // `--ad-reserved-bottom` is set from the banner's REPORTED height
        // (BannerAdPluginEvents.SizeChanged in GlobalAdManager), so this never
        // guesses the size, and it is 0 on web and when ads are denied.
        maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
      }}
    >
      <div className="flex items-start justify-between gap-2 mb-2">
        <span
          className="flex items-center gap-2 font-black text-sm"
          style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)' }}
        >
          <Trophy className="w-4 h-4" aria-hidden="true" />
          {CONTEST_HEADLINE}
        </span>
        <button
          type="button"
          onClick={onClose}
          aria-label="Close"
          data-testid="contest-details-close"
          className="min-w-[44px] min-h-[44px] -mt-2 -mr-2 flex items-center justify-center text-slate-400"
        >
          <X className="w-5 h-5" aria-hidden="true" />
        </button>
      </div>

      {/* The guest prompt FIRST — see the header note. */}
      {(nudge === 'account' || nudge === 'email') && (
        <button
          type="button"
          data-testid="contest-guest-prompt"
          data-nudge={nudge}
          onClick={openFlow}
          className="w-full min-h-[44px] touch-manipulation text-left text-[11px] font-semibold leading-snug rounded-xl px-3 py-2 mb-2 border"
          style={{
            borderColor: 'color-mix(in srgb, var(--u37-gold) 40%, transparent)',
            background: 'color-mix(in srgb, var(--u37-gold) 10%, transparent)',
            color: 'rgb(203 213 225)',
            WebkitTapHighlightColor: 'transparent',
          }}
        >
          {nudge === 'account' ? CONTEST_ACCOUNT_PROMPT : CONTEST_EMAIL_PROMPT}{' '}
          <span
            className="underline decoration-dotted underline-offset-4"
            style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)' }}
          >
            {nudge === 'account' ? CONTEST_ACCOUNT_CTA : CONTEST_EMAIL_CTA}
          </span>
        </button>
      )}

      {/* Verify your email: a heads-up before 25 Oct, the gap from then on. */}
      <EmailVerifyNotice user={user} verified={emailVerified} onLeave={onClose} />

      {/* The affirmation, for a player who has everything else. Same slot, same
          styling as the other two nudges — a player should not have to notice
          that one of the three works differently. */}
      {/* THE WAY BACK. A player who answered no is not asked again anywhere —
          not on the solve screen, not on the home chip. This sheet is the one
          exception, and it has to be: people turn 18, people move, and people
          mis-tap a two-button question. Without a reversal the 'no' is a trap
          rather than a decision, and a trap is a worse product than the nagging
          it replaced. Stated as a NOTE plus an opt-in, never as a re-ask. */}
      {nudge === 'declined' && !confirmed && (
        <div className="mb-2">
          <p className="text-[11px] leading-snug text-slate-400 mb-1">
            {CONTEST_AGE_DECLINED_NOTE}
          </p>
          <button
            type="button"
            data-testid="contest-age-undecline"
            onClick={confirmEligibility}
            disabled={confirming}
            className="min-h-[32px] touch-manipulation text-[11px] font-black underline decoration-dotted underline-offset-4"
            style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)', WebkitTapHighlightColor: 'transparent' }}
          >
            {confirming ? 'Saving…' : CONTEST_AGE_UNDECLINE_CTA}
          </button>
        </div>
      )}

      {/* ⚠️ THE ONLY WAY OUT OF A "YES", anywhere in the app.
          `contestNudgeFor` returns null for a fully eligible player, so this
          block is keyed off the attestation directly rather than off the nudge —
          by definition there is no nudge to hang it on.

          Quiet by design: dotted underline, muted, sitting under the terms it
          relates to. A player who is happily entered should not meet a prominent
          "leave the giveaway" button after every solve; a player looking for it
          should find it where the rules are. */}
      {(hasConfirmedContestEligibility(user) || confirmed) && !withdrawn && (
        <div className="mb-2">
          <button
            type="button"
            data-testid="contest-age-withdraw"
            onClick={withdrawEligibility}
            disabled={confirming}
            className="min-h-[32px] touch-manipulation text-[11px] font-semibold underline decoration-dotted underline-offset-4 text-slate-400 hover:text-slate-200"
            style={{ WebkitTapHighlightColor: 'transparent' }}
          >
            {confirming ? 'Saving…' : CONTEST_AGE_WITHDRAW_CTA}
          </button>
        </div>
      )}

      {withdrawn && (
        <p data-testid="contest-age-withdrawn" className="text-[11px] leading-snug text-slate-400 mb-2">
          {CONTEST_AGE_WITHDRAWN_NOTE}
        </p>
      )}

      {nudge === 'age' && !confirmed && (
        <div className="mb-2">
          <button
            type="button"
            data-testid="contest-age-confirm"
            data-nudge="age"
            onClick={confirmEligibility}
            disabled={confirming}
            className="w-full min-h-[44px] touch-manipulation text-left text-[11px] font-semibold leading-snug rounded-xl px-3 py-2 border"
            style={{
              borderColor: 'color-mix(in srgb, var(--u37-gold) 40%, transparent)',
              background: 'color-mix(in srgb, var(--u37-gold) 10%, transparent)',
              color: 'rgb(203 213 225)',
              WebkitTapHighlightColor: 'transparent',
            }}
          >
            {CONTEST_AGE_PROMPT}{' '}
            <span
              className="underline decoration-dotted underline-offset-4"
              style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)' }}
            >
              {confirming ? 'Saving…' : CONTEST_AGE_CTA}
            </span>
          </button>
        </div>
      )}

      {/* ⚠️ HOISTED OUT OF THE 'age' BLOCK (2026-09-17). It used to render only
          inside the affirmative nudge, which was fine while that was the only
          control that wrote anything. The withdraw control added beside it
          shares `confirmError` — so a failed withdrawal SET the error and
          rendered nothing, leaving a player who had just tried to opt out
          believing they had, while the app kept entering them.

          Caught by its own test rather than in review: the assertion is the one
          that waits for the message, and it timed out. Rendering once, here,
          covers every writer in this component including the next one. */}
      {confirmError && (
        <p data-testid="contest-age-error" className="text-[11px] text-red-300 mt-1 ml-1">
          {confirmError}
        </p>
      )}

      {confirmed && (
        <p
          data-testid="contest-age-confirmed"
          className="text-[11px] font-semibold leading-snug mb-2 ml-1"
          style={{ color: 'var(--u37-gold)' }}
        >
          ✓ Confirmed — you are eligible for the weekly {CONTEST.prize} giveaway.
        </p>
      )}

      {/* THE FACE (copy-condense, David 2026-10-18): five short lines a player
          can read at a glance. Every fact the sheet used to state in full is
          still here, one tap deeper, in the "Full rules" expander below.

          ⚠️ THE EXPANDER IS A NATIVE <details>, NOT A CONDITIONAL MOUNT. Its
          content is in the DOM whether it is open or closed, so every rule is
          still "presented in the app" (Apple guideline 5.3.2), and this file's
          own principle — "if a fact is not on this sheet, it is nowhere in the
          app" — still holds. Do not "optimise" it into `{open && …}`.

          The claim and payment terms (what happens after you WIN, where being
          wrong costs a player $37) were the reason for that principle on
          2026-09-12; the face carries the claim deadline as a summary and the
          exact forfeiture term is in "If you win". */}
      <ul data-testid="contest-face" className="flex flex-col gap-1.5 py-1">
        {CONTEST_SHEET_FACE.map((line) => (
          <li key={line} className="flex gap-2 text-[12px] font-semibold leading-snug text-slate-200">
            <span aria-hidden="true" className="text-slate-500">•</span>
            <span>{line}</span>
          </li>
        ))}
      </ul>

      <details data-testid="contest-full-rules" className="group mt-1 rounded-xl border border-white/10 px-3">
        <summary
          className="min-h-[44px] flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden touch-manipulation text-[12px] font-black"
          style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)', WebkitTapHighlightColor: 'transparent' }}
        >
          {CONTEST_FULL_RULES_LABEL}
          <span aria-hidden="true" className="transition-transform group-open:rotate-180">▾</span>
        </summary>
        <div className="pb-1">
          {/* "Entries" first: the home chip shows a tally ("4 of 21 entries"),
              and what that number means is the likeliest reason this opens. */}
          <Fact label="Entries">{CONTEST_ENTRY_RULE}</Fact>
          <Fact label="No entry">{CONTEST_NO_ENTRY}</Fact>
          <Fact label="Drawings">{CONTEST_DRAW_SCHEDULE}</Fact>
          <Fact label="If you win">{CONTEST_CLAIM}</Fact>
          <Fact label="Payment">{CONTEST_PAYMENT}</Fact>
          <Fact label="Other emails">{CONTEST_EMAILS}</Fact>
        </div>
      </details>

      <a
        data-testid="contest-rules-link"
        href={CONTEST.rulesUrl}
        target="_blank"
        rel="noopener noreferrer"
        className="mt-3 w-full min-h-[44px] touch-manipulation flex items-center justify-center gap-2 rounded-xl px-4 py-2 border font-black text-[12px] no-underline"
        style={{
          color: 'color-mix(in srgb, var(--u37-gold) 35%, white)',
          borderColor: 'var(--u37-gold)',
          background: 'color-mix(in srgb, var(--u37-gold) 12%, transparent)',
          WebkitTapHighlightColor: 'transparent',
        }}
      >
        {CONTEST_LINK_LABEL}
        <ExternalLink className="w-3 h-3" aria-hidden="true" />
      </a>

      {/* VOID WHERE PROHIBITED + ODDS (audit 2026-09-17) — the two lines a US
          sweepstakes is expected to carry. VOID is the load-bearing one
          (sweepstakes law is STATE law); ODDS stops "3 a day, 21 a week" being
          read as a probability. Wording unchanged (contestLegal.js). */}
      <p
        data-testid="contest-legal-lines"
        className="mt-3 text-[10px] leading-snug text-slate-400"
      >
        {CONTEST_VOID}. {CONTEST_ODDS}
      </p>

      {/* THE PLATFORM SPONSOR DISCLAIMER — a contractual obligation under Apple
          PLA §3.3.4(A)(vi), not optional small print. On the FACE of the sheet,
          word-for-word, never behind the expander or the link: the requirement
          is that we state it. The .com official rules carry it too (verified
          2026-09-11) and that page is what the clause binds; this is the
          belt-and-braces half. 10px/slate-400 so it is legible, not decorative.
          It is the LAST thing on the sheet, which is why the sheet's maxHeight
          keeps it clear of the ad banner (see the style note above). */}
      <p
        data-testid="contest-sponsor-disclaimer"
        className="mt-1.5 pt-2 border-t border-white/10 text-[10px] leading-snug text-slate-400"
      >
        {CONTEST_SPONSOR_DISCLAIMER}
      </p>

      {/* NO CONTEST_TERMS LINE HERE. It is `startsOn – endsOn · eligibility`,
          which the Runs and Who-can-win facts above already state — and state
          better, because they are labelled. It stays exported and used by the
          chip's aria-label, where one flat sentence IS the right shape for a
          screen reader. Repeating it under the rules button only taught the
          reader that the sheet says things twice. */}
    </div>
  );
}
