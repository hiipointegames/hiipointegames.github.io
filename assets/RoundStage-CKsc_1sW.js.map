import React from 'react';
import { Lock } from 'lucide-react';

// What a GUEST sees on the Daily result screen where "See today's Leaderboards"
// would be (approved mockup screen 10). Their time is theirs and stays on the
// screen above; WHERE they placed is the account perk. Design research
// (2026-10-10): ask right after the first win, and word it as keeping something.

// COMPACT (2026-10-18, condensed Daily win — Layout A): David likes this card
// and it stays the centrepiece of the result screen, just TIGHTER so the whole
// win fits one S21 screen above the banner ad. Same rows, same words, same
// button; less padding, shorter rows, smaller type. Nothing is dropped.
const SIZES = Object.freeze({
  regular: { box: 'mb-3 p-4', title: 'text-lg', rows: 'mt-3 gap-2', row: 'h-[30px]', copy: 'mt-3 text-sm', btn: 'mt-3 min-h-[54px] text-[17px]' },
  compact: { box: 'p-2.5', title: 'text-base', rows: 'mt-1.5 gap-1', row: 'h-[22px]', copy: 'mt-1.5 text-xs', btn: 'mt-1.5 min-h-[40px] text-[15px]' },
});

/**
 * @param {{ timeLabel?: string | null, onCreate: () => void, compact?: boolean }} props
 *   timeLabel — the player's own formatted time, shown on their locked row
 *   compact   — the tightened variant for the condensed Daily win screen
 */
export default function LockedPlacement({ timeLabel = null, onCreate, compact = false }) {
  const z = compact ? SIZES.compact : SIZES.regular;
  return (
    <div
      className={`${z.box} rounded-[22px] text-left`}
      data-testid="locked-placement"
      style={{
        border: '3px solid var(--u37-green)',
        background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-green) 16%, transparent), transparent 70%), var(--u37-panel-bg-cosmic)',
        boxShadow: '0 0 28px -10px var(--u37-green)',
      }}
    >
      <div className="flex items-center gap-2.5">
        <Lock className="w-5 h-5" style={{ color: 'var(--u37-green)' }} aria-hidden="true" />
        <span className={`${z.title} font-black text-white`}>See where you placed</span>
      </div>
      <div className={`${z.rows} flex flex-col`} aria-hidden="true">
        <div className={`${z.row} rounded-[10px] bg-white/[0.07] flex items-center px-3 gap-2.5`}>
          <span className="w-4 font-black" style={{ color: 'var(--u37-gold)' }}>1</span>
          <span className="flex-1 h-2.5 rounded bg-white/[0.14]" />
        </div>
        <div className={`${z.row} rounded-[10px] bg-white/[0.07] flex items-center px-3 gap-2.5`}>
          <span className="w-4 font-black text-slate-300">2</span>
          <span className="flex-1 h-2.5 rounded bg-white/[0.14]" />
        </div>
        <div className={`${z.row} rounded-[10px] border-2 flex items-center px-3 gap-2.5`} style={{ borderColor: 'color-mix(in srgb, var(--u37-green) 60%, transparent)', background: 'color-mix(in srgb, var(--u37-green) 10%, transparent)' }}>
          <span className="w-4 font-black" style={{ color: 'var(--u37-green)' }}>?</span>
          <span className="text-[13px] font-extrabold text-emerald-100/90">You{timeLabel ? ` · ${timeLabel}` : ''}</span>
        </div>
      </div>
      {/* COMPACT copy is ONE short line (David, 2026-10-18): on a real S21 the
          full sentence took 3 lines and pushed the win screen past one screen.
          The title already says "see where you placed"; the regular size keeps
          the whole reassurance. */}
      <p className={`${z.copy} leading-relaxed text-purple-100/80`} data-testid="locked-placement-copy">
        {compact
          ? 'Your time is saved — sign up free to see your place.'
          : 'Your time is saved. Create a free account to see your place on today’s podium — your Dailies so far come with you.'}
      </p>
      <button
        type="button"
        data-testid="locked-placement-create"
        onClick={onCreate}
        className={`${z.btn} w-full rounded-2xl font-black touch-manipulation active:scale-95`}
        style={{
          color: 'white',
          textShadow: '0 0 10px var(--u37-green)',
          border: '3px solid var(--u37-green)',
          background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-green) 32%, transparent), transparent 70%), var(--u37-panel-bg-cosmic)',
        }}
      >
        Create free account
      </button>
    </div>
  );
}
