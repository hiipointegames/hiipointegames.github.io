import { isKnownModeKey } from '@/game-modes';

// sessionHomeMode — the home screen's mode, remembered for as long as the app
// stays open.
//
// David, 2026-09-29: "make sure that the main screen defaults to easy upon first
// open, and if the player ... navigated away from the main page (say goes into
// colosseum) when they return to the main page the game is still on the mode
// they were on before."
//
// WHY A MODULE VARIABLE, AND NOT localStorage / sessionStorage / user_metadata.
// Every route is its own element (routing/App.jsx), so leaving Home UNMOUNTS the
// Game page and coming back mounts a fresh one — its `useState` starts over.
// Something outside React has to carry the mode across that remount, and the
// lifetime David asked for is exactly a JS module's: it survives route changes
// and the app being backgrounded, and it is gone when the app is fully closed or
// the web page reloads — which is "first open", where Easy is the answer. Any
// persistent store would outlive that and turn "first open" into "last mode".
//
// Values are wire keys (tier AND round — Challenge Practice is remembered as
// Practice). An unknown key is refused, so a bad caller can never plant a mode
// the game cannot render.

let remembered = null;

/** @param {unknown} modeKey */
export function rememberHomeMode(modeKey) {
  if (isKnownModeKey(modeKey)) remembered = /** @type {string} */ (modeKey);
}

/** @returns {string|null} the last home mode this app session, or null on first open */
export function recallHomeMode() {
  return remembered;
}

/** Tests only: return to the first-open state. */
export function forgetHomeMode() {
  remembered = null;
}
