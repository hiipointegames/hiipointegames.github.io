// @ts-nocheck
// The player's record for a round host — who is playing, their stats blob, and
// the point totals the solve awards compare against. Moved verbatim out of
// src/pages/Game.jsx (slice 1b of session 2026-10-19-s73-37-inside) so a second
// host (Sector 73) can hold the same record. Pure move: same hooks, same deps.
//
// Its own hook (not part of useRoundSession) because a host may need `user`
// BEFORE it calls the session (the Mirror warp reads `user?.id`).
//
// `mountApply` is the setter bundle loadGameMount / useGameMount writes through.
import React, { useState, useCallback } from 'react';
import { emptyGameStats } from './initialGameStats';
import { rememberPuzzlePoints } from './solveCompletion';

export function usePlayerRecord() {
  const [user, setUser] = useState(null);
  const [stats, setStats] = useState(emptyGameStats);
  // The last RENDERED stats, readable from inside a callback. handleSubmit's
  // deps deliberately exclude `stats` (it changes on every roll), so the closure
  // would hold a stale blob — and the setStats-updater trick that used to stand
  // in for this silently produced null. See @/game-flow recordSolveLedger.
  const statsRef = React.useRef(stats);
  statsRef.current = stats;

  // The authoritative puzzle-piece and battle-point totals — the cached
  // PublicProfile columns, server-derived by getPlayerStats (same source the
  // Stats page reads). Used ONLY by the solve-award logic; the home stat ribbon
  // that used to display them went in the 2026-07-08 home-condense restructure.
  //
  // A REF, not state, and `null` until a fetch lands. Two reasons, both bugs:
  //   • `handleSubmit` reads this at CALL time. As state it read whatever the
  //     callback's closure captured, so a solve before the mount fetch landed
  //     compared the new total against 0 and lost the tier crossing.
  //   • BATTLE points were never held here at all, so the battle tier was handed
  //     `0 → 0` from Home and could never fire.
  // `null` ≠ 0: it means "never fetched", and a crossing is only ever claimed
  // from a known before-value.
  const knownPointsRef = React.useRef(/** @type {{puzzle:number, battle:number}|null} */(null));
  const setPuzzlePoints = useCallback((n) => rememberPuzzlePoints(knownPointsRef, n), []);

  const [statsLoaded, setStatsLoaded] = useState(false);

  // Every setter here is stable (useState setters + a [] callback), so this
  // bundle keeps one identity for the life of the host.
  const mountApply = React.useMemo(
    () => ({ setUser, setStats, setStatsLoaded, setPuzzlePoints }),
    [setPuzzlePoints],
  );

  return { user, setUser, stats, setStats, statsRef, statsLoaded, knownPointsRef, setPuzzlePoints, mountApply };
}
