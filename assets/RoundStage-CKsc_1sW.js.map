// The empty `game_stats` shape a brand-new player starts from.
//
// It existed TWICE in pages/Game.jsx as two hand-written literals — one seeding
// useState, one as the `|| { ... }` fallback when the fetched user has no
// game_stats — and the two had DRIFTED. The mount fallback was missing eight of
// the twenty-two fields the useState copy declared, including
// `dailyChallengeTimes`, which restore() reads to decide whether today is already
// solved. A player whose account genuinely had no game_stats got the short shape,
// so `game_stats.dailyChallengeTimes?.some(...)` read undefined rather than [].
// It happens to be harmless (optional chaining, and `some` on [] is false either
// way), but two copies of one shape that have already drifted once will drift
// again into something that is not harmless.
//
// One frozen source, deep-copied at each use.
//
// ── WHAT IS DELIBERATELY NOT HERE ──
// No per-mode Daily fields. Ruling Q-F puts the three Daily streaks at
// `game_stats.perMode.<key>.currentStreak` and NOWHERE ELSE, and `perMode` is
// DERIVED ON READ by get-player-stats from daily_challenge_times — never stored.
// `easyDailyStreak` and `challengeDailyStreak` below are NOT Daily streaks
// despite their names: they count PRACTICE streaks, on live player data, and
// repurposing them would silently merge a practice streak into a Daily one.

/** @type {Readonly<Record<string, any>>} */
export const INITIAL_GAME_STATS = Object.freeze({
  totalGamesPlayed: 0,
  totalSolved: 0,
  easySolved: 0,
  challengeSolved: 0,
  dailyChallengeSolved: 0,
  currentStreak: 0,
  bestStreak: 0,
  // PRACTICE streaks. Not the Daily streaks — see the header.
  easyDailyStreak: 0,
  challengeDailyStreak: 0,
  dailyChallengeStreak: 0,
  dailyChallengeTimes: [],
  lastEasyDate: null,
  lastChallengeDate: null,
  lastDailyChallengeDate: null,
  longestDailyChallengeStreak: 0,
  reachedMilestones: [],
  dailyChallengeSolutions: 0,
  timeMilestones: {},
  fastestTimeMilestones: {},
  podiumFinishes: 0,
  tutorialCompleted: false,
});

/**
 * A fresh, mutable copy. The frozen constant must never be handed to a caller
 * that will mutate it — `setStats(prev => ...)` and the award ledger both build
 * new objects, but the arrays and objects inside would otherwise be SHARED
 * across every consumer of the default, so one player's session pushing into
 * `dailyChallengeTimes` would mutate the module-level constant.
 * @returns {Record<string, any>}
 */
export const emptyGameStats = () => ({
  ...INITIAL_GAME_STATS,
  dailyChallengeTimes: [],
  reachedMilestones: [],
  timeMilestones: {},
  fastestTimeMilestones: {},
});
