import { useEffect, useState } from 'react';

import { apiClient } from '@/transport';
import { accountTier } from '@/auth';
import { reportedFallback } from '@/observability';

// Is the person looking at this screen a guest or a member — WITHOUT needing an
// AuthProvider above the component.
//
// Why not useAuth(): it throws outside an AuthProvider, and the result screen
// (SuccessModal) is rendered by Game.jsx in tests that mount no provider. The
// original design kept every auth read inside a child those tests stub out
// (ContestEligibilityNotice); this keeps that property for the soft wall too.
//
// null = not known yet → callers show the MEMBER view, so a member never sees a
// lock flash. A read that fails or returns no user stays null for the same
// reason: we never lock someone out on a guess.

/**
 * @param {{ me?: () => Promise<any> }} [deps]
 * @returns {'guest' | 'member' | null}
 */
export function useViewerTier(deps = {}) {
  const [tier, setTier] = useState(/** @type {'guest' | 'member' | null} */ (null));
  useEffect(() => {
    let live = true;
    Promise.resolve((deps.me || (() => apiClient.auth.me()))())
      .then((u) => { if (live && u?.id) setTier(accountTier(u)); })
      // Reported, then left null: a failed read shows the member view.
      .catch(reportedFallback('softWall.viewerTier'));
    return () => { live = false; };
  }, []);
  return tier;
}
