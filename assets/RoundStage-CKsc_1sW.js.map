import React from 'react';
import { ArrowRight } from 'lucide-react';
import { createPageUrl } from '@/routing/createPageUrl';
import { formatSolveTime } from '@/ui/feedback';
import { getUserRank } from '@/stats-aggregation';
import { rowDisplayName } from '@/leaderboard';
import { resultExit, ExitLink } from './resultExits';

// A signed-in player's "where did I place?" on the condensed Daily win screen
// (Layout A, David 2026-10-18). The member twin of the guest's LockedPlacement:
// the same three-row shape, but with the real names and times, the player's own
// row outlined, and the Leaderboards link on that row.
//
// ⚠️ NO NEW READ. The rows are the board the Share card already fetches when the
// modal opens (SuccessModal's getFacts), handed down here. Until they arrive —
// or if that read failed — only the player's own row shows, with no rank.
//
// ⚠️ A RANK IS SHOWN ONLY WHEN THE PLAYER'S ROW IS ON THE BOARD. The board can
// be read a moment before this solve's row lands. Guessing a rank from times
// alone could disagree with the medal the server credits on a tie (see
// stats-aggregation/podiumOrder), and a wrong place is worse than "–".

/**
 * Which rows to draw: the top two plus the player, or the top three when the
 * player is already among them.
 *
 * @param {any[] | null | undefined} board podium-ordered rows
 * @param {string | null | undefined} userId
 * @returns {{ rows: { rank: number, row: any, isYou: boolean }[], youRank: number }}
 */
export function placementRows(board, userId) {
  const rows = Array.isArray(board) ? board : [];
  const youRank = getUserRank(rows, userId);
  const top = youRank >= 1 && youRank <= 3 ? 3 : 2;
  const shown = rows.slice(0, top).map((row, i) => ({ rank: i + 1, row, isYou: i + 1 === youRank }));
  return { rows: shown, youRank };
}

/**
 * @param {{
 *   board?: any[] | null,
 *   userId?: string | null,
 *   timeLabel?: string | null,
 *   accent: string,
 *   onClose?: () => void,
 *   inWorld?: import('./resultExits').InWorld,
 * }} props
 *   timeLabel — the player's own formatted time, used when their row is not on
 *   the board yet
 *   inWorld — Sector 73 host: the Leaderboards link shows only for
 *   `exits.leaderboard` (./resultExits)
 */
export default function MemberPlacement({ board, userId, timeLabel = null, accent, onClose, inWorld }) {
  const { rows, youRank } = placementRows(board, userId);
  const youOnTop = youRank >= 1 && youRank <= 3;

  const link = (
    <ExitLink
      exit={resultExit(inWorld, 'leaderboard')}
      to={createPageUrl('Leaderboard')}
      onClick={onClose}
      data-testid="success-leaderboard-link"
      className="ml-auto flex-shrink-0 inline-flex items-center gap-1 rounded-lg px-2 py-1 text-[11px] font-black touch-manipulation active:scale-95"
      style={{ color: '#050310', background: accent }}
    >
      Leaderboards <ArrowRight className="w-3 h-3" />
    </ExitLink>
  );

  const youRow = (rank, label, time) => (
    <div
      key="you"
      data-testid="member-placement-you"
      className="h-[32px] rounded-[10px] border-2 flex items-center px-2.5 gap-2"
      style={{ borderColor: accent, background: `color-mix(in srgb, ${accent} 10%, transparent)` }}
    >
      <span className="w-5 font-black" style={{ color: accent }}>{rank || '–'}</span>
      <span className="min-w-0 truncate text-[13px] font-extrabold text-white">{label}</span>
      {time && <span className="text-[12px] tabular-nums text-slate-300">{time}</span>}
      {link}
    </div>
  );

  return (
    <div
      data-testid="member-placement"
      className="rounded-[18px] p-2 flex flex-col gap-1.5"
      style={{ border: `2px solid ${accent}`, boxShadow: `0 0 22px -12px ${accent}` }}
    >
      {rows.map(({ rank, row, isYou }) => (isYou
        ? youRow(rank, 'You', formatSolveTime(row.solve_time_seconds))
        : (
          <div key={row.user_id ?? rank} className="h-[30px] rounded-[10px] bg-white/[0.06] flex items-center px-2.5 gap-2">
            <span className="w-5 font-black" style={{ color: rank === 1 ? 'var(--u37-gold)' : undefined }}>{rank}</span>
            <span className="flex-1 min-w-0 truncate text-[13px] font-bold text-slate-200">{rowDisplayName(row)}</span>
            <span className="text-[12px] tabular-nums text-slate-400">{formatSolveTime(row.solve_time_seconds)}</span>
          </div>
        )))}
      {!youOnTop && youRow(youRank, 'You', timeLabel)}
    </div>
  );
}
