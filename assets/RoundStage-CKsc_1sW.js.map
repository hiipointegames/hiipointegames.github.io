import { DAILY_MODE_KEYS, MODE_TIER_LABELS, modeOf, isDaily } from '@/game-modes';

// What to nudge a player toward after they win — computed from today's REAL
// Daily state, not from an assumed progression.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS IS ADAPTIVE AND NOT A FIXED LADDER
// ─────────────────────────────────────────────────────────────────────────────
// The win screen used to carry three hardcoded cross-promos: Easy said "Try
// Challenge Mode", Challenge said "Enter the Colosseum", and Expert said
// nothing at all. Each was a guess about where the player was in an assumed
// easy → challenge → expert journey.
//
// David, 2026-09-12: "We assume easy to challenge to expert, but we can not
// guarantee that. Is there a way to have that particular nudge on each screen be
// adaptive and always point them towards any open and uncompleted dailies that
// remain ... and then once the third one is completed, whatever mode that may
// be, the nudge now turns to battle a friend."
//
// So the nudge reads `statusByMode` — the same per-mode Daily state the launcher
// already uses — and never points at a Daily the player cannot actually play.
//
// ⚠️ A DAILY IS PLAYABLE ONLY FROM 'not_started'. A forfeited Daily is over for
// the day just as surely as a completed one (David's ruling), so both are
// closed. 'in_progress' is also excluded: it is not a "next thing", it is the
// thing they are already inside, and Game.jsx bounces them back to it anyway.
// 'loading' is excluded because we do not yet know — suggesting a Daily that
// turns out to be finished is the dead end this whole module exists to avoid.

/** Difficulty order, easiest first. Indexes into the ladder below. */
const TIER_ORDER = Object.freeze(['easy', 'challenge', 'expert']);

/** The Daily wire key for a tier. Challenge's is the bare 'daily' (storage legacy). */
const DAILY_KEY_BY_TIER = Object.freeze({
  easy: 'daily_easy',
  challenge: 'daily',
  expert: 'daily_expert',
});

/**
 * A Daily is only suggestible when it has not been started.
 * @param {string|undefined} status
 */
const isOpen = (status) => status === 'not_started';

/**
 * The order to consider Dailies in, given the mode just played.
 *
 * David's rules, 2026-09-12, verbatim in effect:
 *
 *   PRACTICE win  → "point them to the daily of the same practice mode they just
 *                    completed". Then, if that one is closed, fall through to the
 *                    same ordering a Daily win would use from that tier — he did
 *                    not spell that case out, and falling back to the ladder he
 *                    DID specify beats inventing a second rule.
 *
 *   DAILY win     → "the next tier of difficulty up ... if they start with expert,
 *                    point them at challenge, and then easy ... if they start with
 *                    challenge, point them at expert daily, and then easy daily,
 *                    and if they start with easy go in order".
 *
 * All three of those collapse to one rule: tiers ABOVE, ascending, then tiers
 * BELOW, descending.
 *
 *   easy       → [challenge, expert]   (nothing below)
 *   challenge  → [expert] then [easy]
 *   expert     → (nothing above) then [challenge, easy]
 *
 * @param {string} playedKey a mode key, practice or daily
 * @returns {string[]} daily mode keys, most-preferred first
 */
export function nudgeOrderFor(playedKey) {
  const tier = modeOf(playedKey);
  const i = TIER_ORDER.indexOf(tier);
  const idx = i === -1 ? 0 : i;

  const above = TIER_ORDER.slice(idx + 1);                 // ascending
  const below = TIER_ORDER.slice(0, idx).reverse();        // descending
  const ladder = [...above, ...below];

  // A practice win puts its OWN tier's Daily first; a Daily win never suggests
  // itself (it was just played, so it is closed anyway — but being explicit
  // keeps the intent readable rather than relying on that).
  const ordered = isDaily(playedKey) ? ladder : [tier, ...ladder];

  return ordered.map((t) => DAILY_KEY_BY_TIER[t]);
}

/**
 * The nudge to show after a Daily solve, a Daily forfeit, or a practice win.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * EVERY OPEN DAILY GETS ITS OWN BUTTON (David, 2026-09-29)
 * ─────────────────────────────────────────────────────────────────────────────
 * This used to return ONE target wrapped in a text card — a headline, a line of
 * body copy and a single "Play the X Daily" CTA. David: remove the text box and
 * make it "very obviously clickable buttons ... start challenge daily and start
 * expert daily". So it now returns EVERY open Daily, in the ladder order above,
 * each as a button; the only copy left is a short label over them. It applies to
 * the forfeit screen too — a forfeit closes that one Daily, not the other two.
 *
 * @param {{ playedMode: string, statusByMode?: Record<string, string> }} args
 * @returns {{
 *   kind: 'daily'|'battle',
 *   label: string,
 *   targets?: { targetMode: string, tierLabel: string, cta: string }[],
 *   cta?: string,
 * }}
 */
export function nextChallengeNudge({ playedMode, statusByMode }) {
  const statuses = statusByMode || {};

  const targets = nudgeOrderFor(playedMode)
    .filter((key) => isOpen(statuses[key]))
    .map((targetMode) => {
      const tierLabel = MODE_TIER_LABELS[modeOf(targetMode)];
      return { targetMode, tierLabel, cta: `Start ${tierLabel} Daily` };
    });

  if (targets.length > 0) {
    return { kind: 'daily', label: 'Up next', targets };
  }

  // Every Daily is spoken for. There is nothing left to promote today except
  // the thing that is always available.
  return {
    kind: 'battle',
    label: 'All three Dailies done ⚔️',
    cta: 'Enter the Colosseum',
  };
}

/** Every Daily key, for tests and callers that want the full set. */
export const NUDGE_DAILY_KEYS = DAILY_MODE_KEYS;
