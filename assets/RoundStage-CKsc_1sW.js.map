// @ts-nocheck
// The three Daily attempt machines — one per Daily mode — and the two maps the
// launcher reads from them. Moved verbatim out of src/pages/Game.jsx (slice 1a of
// session 2026-10-19-s73-37-inside) so a second host (Sector 73) can mount the
// same machines with the same counting. Pure move: same hook order, same deps.
//
// The `dc` line ("which instance is the screen about") stays with its caller,
// because it reads the page's `mode`.
import React from 'react';
import { useDailyChallengeAttempt } from '@/daily-challenge';
import { DAILY_MODE_KEYS } from '@/game-modes';

export function useThreeDailies() {
  // ── ONE ATTEMPT MACHINE PER MODE (C14) ──────────────────────────────────
  // There used to be a single instance holding one status, one startedAt, one
  // session token and one dice cache. Playing a second mode in the same session
  // overwrote the first — and `deviceElapsedMs` below is measured from that
  // single startedAt, so the second mode's solve time would have been counted
  // from the FIRST mode's start.
  //
  // Three instances, one per Daily, mounted unconditionally because hooks may
  // not be conditional. Each keeps its own status/timer/token, and P3 keyed the
  // dice cache `${date}:${mode}` so no instance can serve another's dice.
  //
  // MODE-BLIND-RESTORE had to be closed before this line could exist: with a
  // mode-blind restore, three instances would all have answered "did this player
  // finish today?" about Challenge's rows and reported each other's state.
  const dcEasy = useDailyChallengeAttempt('daily_easy');
  const dcChallenge = useDailyChallengeAttempt('daily');
  const dcExpert = useDailyChallengeAttempt('daily_expert');
  const dailyByMode = React.useMemo(
    () => ({ daily_easy: dcEasy, daily: dcChallenge, daily_expert: dcExpert }),
    [dcEasy, dcChallenge, dcExpert],
  );
  // Per-mode status for the picker's glyphs and the round toggle.
  const statusByMode = React.useMemo(
    () => ({
      daily_easy: dcEasy.status,
      daily: dcChallenge.status,
      daily_expert: dcExpert.status,
    }),
    [dcEasy.status, dcChallenge.status, dcExpert.status],
  );
  // A live Daily is EXCLUSIVE. A player may play one, two or all three modes in a
  // day, but never two clocks at once — two running timers means two solve times
  // measured against one wall clock and at least one of them wrong.
  const liveDailyMode = DAILY_MODE_KEYS.find((k) => dailyByMode[k].status === 'in_progress');
  return { dcEasy, dcChallenge, dcExpert, dailyByMode, statusByMode, liveDailyMode };
}
