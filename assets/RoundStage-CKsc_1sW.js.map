import { modeThemeName, modeAccentToken } from './modeTheme';
import { modeOf, modeTierLabel } from '@/game-modes';
import React from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { HelpCircle } from 'lucide-react';
import { Button } from '@/ui/primitives/button';
import { playSound } from '@/ui/feedback';

// home-condense H2 — the light pre-game modal for a PRACTICE round.
//
// 🔴 IT USED TO GREET AN EXPERT PLAYER AS "Ready for Easy?", IN GREEN.
// Reported by David, 2026-09-11: "When you click on the roll dice button for
// expert practice game, the next window that pops up says are you ready to start
// an easy round, and it is green in color."
//
// The config was `mode === 'challenge' ? {Challenge, cyan} : {Easy, green}` —
// two branches for three tiers, so 'expert' fell to the else and took Easy's
// name AND Easy's colour. The same two-branch mistake as the battle surfaces
// fixed in 1.0.304, in the practice/daily mode family rather than the blitz one,
// which is why that sweep did not reach it.
//
// It is the THIRD time this family has bitten: `MODE_SHARE_LABELS` exists
// because the share text had it too ("EVERY shared Expert solve announced itself
// as 🎲 Easy Mode"), and `modeKeys.js` documents that fix. Each was patched
// where it was found; nobody swept. `practiceModeIdentity.test.js` does now.
//
// Practice rounds have no timer and no lockdown, so this is intentionally light:
// it appears on every roll AFTER the one-time forced how-to (the first roll of a
// mode routes straight through the forced-scroll how-to instead — see Game.jsx).
// It exists to carry the always-available "?" reopen and a clear Start, matching
// the pre-game affordance Daily/Blitz already have.
//
/**
 * The emoji each tier shows here.
 *
 * Keyed by TIER and complete, rather than a ternary with a default. Easy's 🎲
 * and Challenge's 🎯 are exactly what shipped, so nothing a returning player
 * recognises changes; ⚡ is Expert's, matching `MODE_SHARE_LABELS` in
 * game-modes so the modal and the shared solve agree on Expert's mark.
 */
const TIER_ICON = Object.freeze({ easy: '🎲', challenge: '🎯', expert: '⚡' });

// @param {{ isOpen: boolean, mode: string,
//           onStart: () => void, onCancel: () => void, onHowTo: () => void,
//           skin?: 'sector73' }} props   skin → data-skin/data-part (Sector 73 host)
export default function PlayStartModal({ isOpen, mode = 'easy', onStart, onCancel, onHowTo, skin }) {
  const [startLockedRef] = React.useState({ locked: false });

  // Asked as named questions rather than compared as strings — the thing
  // `@/game-modes` exists for. `modeOf` also coerces an unknown key to 'easy',
  // so a stale mode renders the gentlest tier instead of an empty modal.
  const tier = modeOf(mode);
  const config = {
    icon: TIER_ICON[tier],
    accent: modeAccentToken(tier),
    name: modeTierLabel(tier),
  };

  const handleStart = (e) => {
    if (startLockedRef.locked) return;
    e.preventDefault();
    e.stopPropagation();
    startLockedRef.locked = true;
    // The dice-roll sound is played by the roll action itself (doRoll) so it
    // isn't doubled; this modal just fires onStart.
    onStart();
    setTimeout(() => { startLockedRef.locked = false; }, 800);
  };

  return (
    <AnimatePresence>
      {isOpen && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          data-skin={skin}
          data-part={skin ? 'scrim' : undefined}
          className="fixed inset-0 z-[100] flex items-center justify-center p-4 u37-ad-safe-pb bg-black/80 backdrop-blur-sm"
        >
          <motion.div
            initial={{ scale: 0.9, y: 20 }}
            animate={{ scale: 1, y: 0 }}
            exit={{ scale: 0.9, y: 20 }}
            data-mode={modeThemeName(mode)}
            data-skin={skin}
            data-part={skin ? 'card' : undefined}
            className="w-full max-w-sm rounded-2xl p-6 border-2 text-center"
            style={{
              background: 'var(--u37-panel-bg)',
              borderColor: `color-mix(in srgb, ${config.accent} 60%, transparent)`,
              boxShadow: `0 0 40px -12px ${config.accent}, 0 18px 60px rgba(0,0,0,0.6), inset 0 1px 3px rgba(255,255,255,0.05)`,
            }}
          >
            <div className="text-4xl mb-2">{config.icon}</div>
            <h2 className="text-xl font-bold text-white mb-1">
              Ready for {config.name}?
            </h2>
            <p className="text-slate-400 text-sm mb-5">
              Build 37 with all seven dice. Need a refresher? Tap the <span className="font-bold" style={{ color: config.accent }}>?</span>.
            </p>

            <div className="flex flex-col gap-2.5">
              <Button
                onPointerDown={handleStart}
                disableDefaultSound={true}
                className="w-full py-5 text-base font-black touch-manipulation active:scale-95"
                style={{ background: config.accent, color: '#050310', boxShadow: `0 0 26px -7px ${config.accent}, inset 0 1px 0 rgba(255,255,255,0.4)` }}
              >
                🎲 Roll Dice
              </Button>

              <div className="flex gap-2.5">
                <button
                  type="button"
                  onClick={() => { playSound('buttonTap'); onHowTo(); }}
                  aria-label="How to play"
                  className="flex-1 min-h-[44px] rounded-xl border border-slate-600 text-slate-200 font-semibold text-sm flex items-center justify-center gap-1.5 hover:bg-slate-700 transition-colors touch-manipulation"
                >
                  <HelpCircle className="w-4 h-4" />
                  How to Play
                </button>
                <button
                  type="button"
                  onClick={() => { playSound('buttonTap'); onCancel(); }}
                  className="flex-1 min-h-[44px] rounded-xl border border-slate-600 text-slate-300 font-semibold text-sm hover:bg-slate-700 transition-colors touch-manipulation"
                >
                  Not Now
                </button>
              </div>
            </div>
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}
