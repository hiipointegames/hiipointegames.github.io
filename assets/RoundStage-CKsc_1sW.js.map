import React from 'react';
import ChallengeWarningModal from './ChallengeWarningModal';
import PlayStartModal from './PlayStartModal';
import ExitWarningModal from './ExitWarningModal';

// GamePreGameModals — the pre-game / exit gating overlays for the Game page,
// extracted verbatim from Game.jsx (blob decomposition). Groups the three gating
// modals + the in-place how-to overlay that reopens above them:
//   - ChallengeWarningModal — the Daily pre-game rules gate.
//   - PlayStartModal        — the Easy/Challenge light pre-game "Ready?" gate.
//   - {howToNode}           — the in-place how-to overlay (z-[140]) the pre-game
//                             modals' "?" reopens ABOVE them, closing back to them.
//   - ExitWarningModal      — the Daily "Forfeit & See Solves" exit gate.
//
// Purely presentational: Game.jsx still owns all the state + the callback bodies
// (the forfeit sequence, the roll trigger, the how-to reopen) and threads them in
// unchanged, so behaviour is identical to the old inline block. This is NOT the
// win/results/celebration cluster (SuccessModal / RocketLaunchScreen /
// AwardCelebrationSequence) — that stays in Game.jsx (a separate, device-gated
// decomposition slice).
//
// @param {{
//   showStartWarning: boolean,
//   dailyMode: string,     WHICH Daily the start gate is for (wire key)
//   onStartConfirm: () => void,
//   onStartCancel: () => void,
//   onStartHowTo: () => void,
//   showPlayWarning: boolean,
//   playMode: 'easy'|'challenge'|'expert',
//   onPlayStart: () => void,
//   onPlayCancel: () => void,
//   onPlayHowTo: () => void,
//   howToNode: React.ReactNode,
//   showExitWarning: boolean,
//   onExitConfirm: () => void,
//   onExitCancel: () => void,
//   skin?: 'sector73',     the Sector 73 host — forwarded to all three modals
// }} props
export default function GamePreGameModals({
  showStartWarning,
  dailyMode = 'daily',
  onStartConfirm,
  onStartCancel,
  onStartHowTo,
  showPlayWarning,
  playMode,
  onPlayStart,
  onPlayCancel,
  onPlayHowTo,
  howToNode,
  showExitWarning,
  onExitConfirm,
  onExitCancel,
  skin,
}) {
  return (
    <>
      {/* Daily Challenge Warning Modal.
          `mode` was the LITERAL 'daily' here. PR #65 taught this modal to state
          the Power Dice rule per mode -- Easy omits the row (seven white dice),
          Expert says all three must be correct -- and every bit of that logic was
          dead, because the only mode it was ever handed was Challenge's. Expert's
          Daily gate told the player "only two of the three need correct
          operators", which is the exact opposite of Expert's rule, on the last
          screen before the clock starts. */}
      <ChallengeWarningModal
        isOpen={showStartWarning}
        onConfirm={onStartConfirm}
        onCancel={onStartCancel}
        onHowTo={onStartHowTo}
        mode={dailyMode}
        skin={skin}
      />

      {/* home-condense H2 — Easy/Challenge light pre-game modal. Reached by every
          Easy/Challenge roll (first-run lands here after the forced how-to too).
          Start rolls; the "?" reopens the how-to in place (no gate). */}
      <PlayStartModal
        isOpen={showPlayWarning}
        mode={playMode}
        onStart={onPlayStart}
        onCancel={onPlayCancel}
        onHowTo={onPlayHowTo}
        skin={skin}
      />

      {/* In-place how-to overlay (z-[140]) for the pre-game modals' "?" reopen —
          renders ABOVE the modals and closes back to them (RC2). */}
      {howToNode}

      {/* Daily Challenge Exit Warning Modal. blitzDurationSeconds is a blitz-only
          prop (used only when isSoloBlitz/isBattleBlitz) — this is the daily exit,
          so it's unused; passed undefined to match the original inline call, which
          omitted it (Game.jsx imports the modal via the @/game-flow barrel, which
          hid the required prop; the direct import here surfaces it). */}
      <ExitWarningModal
        isOpen={showExitWarning}
        onConfirmExit={onExitConfirm}
        onCancel={onExitCancel}
        mode={dailyMode}
        blitzDurationSeconds={undefined}
        skin={skin}
      />
    </>
  );
}
