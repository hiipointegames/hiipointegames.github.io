// @ts-nocheck
// The round's on-screen parts — the in-play board, the results card, the
// post-solve celebration and the pre-game / exit gates. Moved verbatim out of
// src/pages/Game.jsx's JSX (slice 1b of session 2026-10-19-s73-37-inside).
//
// TWO parts, because Game.jsx renders the board BEFORE its page shell and the
// modals AFTER it: Game renders each part where the JSX used to be, so its DOM
// order is unchanged. The default export (both parts in one fragment) is for a
// host with no shell of its own (Sector 73).
//
// Sector 73 host props (slice 2b) — all absent on 37's /Game, which therefore
// renders exactly as before (pinned by hostProps.defaultMarkup.test.jsx):
//   skin     'sector73' → the board, results card and pre-game / exit gates
//            carry data-skin / data-part (the cosmic CSS keys on those)
//   inWorld  { exits } → the results card's Home reads "Back to orbit" and its
//            route links show only for a given exit (./resultExits)
//   hidesNav → PostSolveCelebration → AwardCelebrationSequence (default true)
// The board has no route exits, so `inWorld` is accepted there and unused.
import React from 'react';
import { DailyChallengeGame } from '@/daily-challenge';
import { isDaily, isPractice, isKnownModeKey } from '@/game-modes';
import { generateDailyDice, getDiceColors } from '@/dice';
import SuccessModal from './SuccessModal';
import PostSolveCelebration from './PostSolveCelebration';
import GamePreGameModals from './GamePreGameModals';
import { modeThemeName } from './modeTheme';
import { switchRound } from './gameEntryModel';
import { emitDailyResultsClosed } from './dailyResultsSignal';

export function RoundStageBoard({ session, skin, inWorld: _inWorld }) {
  const {
    mode, dc, dice, setDice, diceColors, setDiceColors,
    equation, usedDiceIndices, cursorPosition, setCursor, clearDraft,
    solved, setSolved, setDiceRolled,
    showDailyChallengeGame, dailyChallengeTimer, showCompactGame, setShowCompactGame,
    showColorRuleError, shakeButton, showTryAgain,
    handleDiceClick, handleOperatorClick, handleDelete, handleClear, handleSubmit, handleShuffle,
    sector73Mirror,
  } = session.stageProps;
  return (
    <>
      {/* Full-screen Compact Game (Daily Challenge, Easy Mode, or Challenge Mode) */}
      {((isDaily(mode) && showDailyChallengeGame) || (isPractice(mode) && showCompactGame)) && (
        <DailyChallengeGame
          dice={dice.map(d => d.value)}
          diceColors={diceColors}
          equation={equation}
          usedDiceIndices={usedDiceIndices}
          solved={solved}
          dailyChallengeTimer={dailyChallengeTimer}
          showCountdown={isDaily(mode) ? dc.showCountdown : false}
          remainingSeconds={isDaily(mode) ? dc.remainingSeconds : undefined}
          onDiceClick={handleDiceClick}
          onOperatorClick={handleOperatorClick}
          onDelete={handleDelete}
          onClear={handleClear}
          onSubmit={handleSubmit}
          showColorRuleError={showColorRuleError}
          shakeButton={shakeButton}
          showTryAgain={showTryAgain}
          mode={mode}
          // The board's neon accent. `mode` is a WIRE KEY and data-mode wants a
          // THEME name — they are two vocabularies, and `daily_easy` /
          // `daily_expert` are not theme names, so passing the key through
          // dropped both new modes onto the :root fallback.
          themeMode={modeThemeName(mode)}
          cursorPosition={cursorPosition}
          onCursorPositionChange={setCursor}
          onExit={isDaily(mode) ? () => {
            dc.openExitWarning();
          } : isPractice(mode) ? () => {
            setShowCompactGame(false);
            setDiceRolled(false);
            clearDraft();
            setSolved(false);
          } : undefined}
          onRollNewDice={isPractice(mode) ? () => {
            setDice(generateDailyDice());
            setDiceColors(getDiceColors(mode));
            clearDraft();
            setSolved(false);
          } : undefined}
          onShuffle={handleShuffle}
          sector73Mirror={sector73Mirror}
          skin={skin}
        />
      )}
    </>
  );
}

export function RoundStageModals({ session, howToNode, skin, inWorld, hidesNav }) {
  const {
    mode, dc, boardMode, statusByMode, openHowTo,
    dice, diceColors, equation, usedDiceIndices, clearDraft,
    setSolved, setDiceRolled, dailyChallengeForfeited,
    setShowCompactGame, showPlayWarning, setShowPlayWarning,
    showSuccess, setShowSuccess, celebration, modalDisplayData, setModalDisplayData, finalSolveTime,
    setMode, handleNewGame, handlePlayMode, startDailyChallenge, doRoll,
  } = session.stageProps;
  return (
    <>
      {/* Success Modal */}
      < SuccessModal
        isOpen={showSuccess}
        onClose={() => {
          // Tell the first-week tips (card 1 fires after the day's first Daily).
          emitDailyResultsClosed(mode, statusByMode);
          setShowSuccess(false);
          celebration.reset();
          setModalDisplayData(null);
          // For daily/easy/challenge mode, return to home screen
          if (isDaily(mode)) {
            setDiceRolled(false);
            clearDraft();
            setSolved(false);
            dc.reset();
          } else if (isPractice(mode)) {
            setDiceRolled(false);
            clearDraft();
            setSolved(false);
          }
        }
        }
        equation={modalDisplayData?.equation || equation}
        onNewGame={handleNewGame}
        onGoHome={(targetMode) => {
          emitDailyResultsClosed(mode, statusByMode);
          setShowSuccess(false);
          celebration.reset();
          setModalDisplayData(null);
          setDiceRolled(false);
          clearDraft();
          setSolved(false);
          // Reset daily challenge state — dc.reset() handles startedAt
          // + elapsed + showGame. For non-daily modes it's a no-op since
          // the hook owns no state machine outside daily.
          if (isDaily(mode)) dc.reset();
          // Reset compact game view
          setShowCompactGame(false);
          // B4: a mode-switch cross-promo ("Try Challenge Mode" / "Play Easy
          // Mode") lands the launcher already on that mode so ModeToggle
          // highlights it. Plain Home passes nothing → mode unchanged.
          if (isKnownModeKey(targetMode)) setMode(targetMode);
        }}
        onPlayMode={handlePlayMode}
        mode={mode} statusByMode={statusByMode}
        dice={modalDisplayData?.dice?.length ? modalDisplayData.dice.map(d => d.value) : dice.map(d => d.value)}
        usedDiceIndices={modalDisplayData?.usedDiceIndices || usedDiceIndices}
        diceColors={modalDisplayData?.diceColors || diceColors}
        solveTime={modalDisplayData?.solveTime ?? finalSolveTime}
        forfeited={isDaily(mode) ? dailyChallengeForfeited : false} timedOut={isDaily(mode) && dc.timedOut} earnedAwards={celebration.lastAwards}
        skin={skin} inWorld={inWorld}
      />

      {/* Rocket lift-off then badge awards, in that order — the interlock lives
          in @/game-flow PostSolveCelebration, where it is testable. */}
      <PostSolveCelebration mode={mode} {...celebration.overlayProps} hidesNav={hidesNav} />

      {/* Pre-game / exit gating overlays — extracted to @/game-flow
          GamePreGameModals. Game.jsx still owns the state + callback bodies (the
          forfeit sequence, the roll trigger, the how-to reopen); the wrapper just
          groups the JSX. The win/results/celebration modals below stay here. */}
      <GamePreGameModals
        showStartWarning={dc.showStartWarning}
        dailyMode={boardMode}  // was hard-coded 'daily' inside the wrapper
        onStartConfirm={startDailyChallenge}
        onStartCancel={dc.closeStartWarning}
        // THIS mode's how-to, not Challenge's. Hard-coding 'daily' here would
        // teach the power-dice rules in front of Easy's all-white Daily.
        onStartHowTo={() => openHowTo(mode, { context: 'go-back' })}
        showPlayWarning={showPlayWarning}
        // The pre-game modal for a PRACTICE round. It takes the real wire key
        // now: the old `mode === 'challenge' ? 'challenge' : 'easy'` collapsed
        // Expert onto Easy, so Expert practice showed Easy's copy.
        playMode={isPractice(mode) ? mode : switchRound(mode, 'practice')}
        onPlayStart={() => { setShowPlayWarning(false); doRoll(); }}
        onPlayCancel={() => setShowPlayWarning(false)}
        onPlayHowTo={() => openHowTo(mode, { context: 'go-back' })}
        howToNode={howToNode}
        showExitWarning={dc.showExitWarning}
        onExitConfirm={() => {
          // Hook owns the forfeit edge call + status flip + timer reset
          // + showGame=false + showExitWarning=false.
          dc.forfeit();
          // Game-side state (dice/equation/cursor/solved) is Game.jsx's concern.
          setDiceRolled(false);
          clearDraft();
          setSolved(false);
          // "Forfeit & See Solves": reveal today's valid + perfect solutions.
          // SuccessModal computes them for a forfeited daily; `dice` still holds
          // today's dice here (forfeit doesn't clear it).
          setShowSuccess(true);
        }}
        onExitCancel={dc.closeExitWarning}
        skin={skin}
      />

    </>
  );
}

// Both parts, board first — the order Game.jsx renders them in.
export default function RoundStage({ session, howToNode, skin, inWorld, hidesNav }) {
  return (
    <>
      <RoundStageBoard session={session} skin={skin} inWorld={inWorld} />
      <RoundStageModals session={session} howToNode={howToNode} skin={skin} inWorld={inWorld} hidesNav={hidesNav} />
    </>
  );
}
