import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { detectNewAwards } from './awards';
import { readAnnouncedAwards, filterUnannounced, recordAnnouncedAwards } from './announcedAwards';

// usePostSolveCelebration — the post-solve celebration ORCHESTRATION, lifted out
// of Game.jsx.
//
// WHAT IT OWNS. Three pieces of state that only ever move together:
//   • showRocket   — is the mode-coloured rocket flying?
//   • resultsReady — have the post-solve stats landed? (lets the rocket hand off
//                    before its 4s cap)
//   • pendingAwards — the badges this solve just earned, queued behind the rocket.
// Plus the one rule that couples them: a solve OPENS the rocket and QUEUES the
// awards in the same beat, and the awards do not play until the rocket is gone
// (that half of the interlock lives in PostSolveCelebration, its view).
//
// TWO PHASES, because half the ledger arrives late. `begin` runs on the solve
// with what is known locally; `settle` re-plans the queue once the server-derived
// numbers land (puzzle/battle point totals, and the registry badge state that is
// three network reads away). The split exists so the rocket never waits on a
// network read — and `settle` refuses to act once the player can see the awards,
// so it can never yank a sequence out from under them. See ./solveCompletion.
//
// WHY IT EXISTS. All of this was inline in Game.jsx — three useStates, a
// detectNewAwards call buried at the bottom of a 100-line handleSubmit, three
// scattered `setResultsReady(true)` calls in the stats-reload promise chain, and
// two exit paths that had to remember to reset both flags by hand. Game.jsx is a
// grandfathered arch-ratchet blob (may only shrink) that NO test mounts, so the
// celebration a player sees at the most rewarding moment in the game lived
// entirely in unreachable code. Here it is a hook with its own suite.
//
// WHAT IT DELIBERATELY DOES NOT OWN. `showSuccess`. The results modal has three
// other openers Game.jsx owns — the forfeit path, the 1-hour timeout reveal, and
// the "see today's stats" recap — none of which is a celebration. Pulling it in
// would make this hook the results-modal state machine, which it is not. The
// hook instead calls back when the award queue drains, and Game.jsx decides what
// that means.
//
/**
 * @param {{ onAwardsComplete?: () => void }} [options]
 *   `onAwardsComplete` fires once the LAST queued award is dismissed — Game.jsx
 *   uses it to re-open the results underneath.
 */
export function usePostSolveCelebration({ onAwardsComplete } = {}) {
  const [showRocket, setShowRocket] = useState(false);
  const [resultsReady, setResultsReady] = useState(false);
  const [pendingAwards, setPendingAwards] = useState([]);
  // The queue that just DRAINED (2026-10-18). The results screen opens right
  // after it, and its "New badge! See it" link deep-links to these — the
  // post-solve pop-ups themselves carry no such button, because leaving from
  // them would skip the results/share step. Cleared on a new solve and when the
  // results screen is left.
  const [lastAwards, setLastAwards] = useState(/** @type {Array<Record<string, any>>} */ ([]));

  // Callers pass an inline arrow, so `onAwardsComplete` is a new function on
  // every render of the page. Held in a ref and read at call time, exactly as
  // RocketLaunchScreen does with its own `onComplete`, so the handler below —
  // and therefore `overlayProps` — keeps a stable identity. Without this, a live
  // Daily's one-second timer tick would hand the overlays a fresh callback every
  // second for the whole attempt.
  const onAwardsCompleteRef = useRef(onAwardsComplete);
  useEffect(() => { onAwardsCompleteRef.current = onAwardsComplete; }, [onAwardsComplete]);

  // This solve's ledger, kept so `settle` can RE-RUN the same diff once the
  // server-derived numbers land. Two of the six award families are not knowable
  // at solve time: puzzle/battle point tiers are derived by `get-player-stats`,
  // and registry badges are three network reads away. `begin` therefore fires
  // with what is known locally (so the rocket launches instantly) and `settle`
  // corrects the queue behind it.
  //
  // `userId` rides along: the announced-record is PER ACCOUNT (2026-10-18), so
  // the filter and the drain's write must both name whose record they mean.
  const ledgerRef = useRef(/** @type {{prev: object, updated: object, points: object, userId?: string|null}} */ ({ prev: {}, updated: {}, points: {} }));

  // What the player can SEE right now, readable from inside a callback. `settle`
  // must never yank an award sequence that is already on screen, and state read
  // through a closure would be whatever it was when the callback was created.
  //
  // `awards` rides along because the drain handler has to RECORD the queue it
  // just finished, and it cannot read that out of a `setPendingAwards` updater:
  // an updater must stay pure, and StrictMode invokes it twice.
  const liveRef = useRef(/** @type {{flying: boolean, queued: number, awards: any[]}} */({
    flying: false, queued: 0, awards: [],
  }));
  useEffect(() => {
    liveRef.current = { flying: showRocket, queued: pendingAwards.length, awards: pendingAwards };
  }, [showRocket, pendingAwards]);

  // A solve landed. Diff the stats ledger for newly-earned awards, queue them,
  // and launch the rocket.
  //
  // The rocket is a LATENCY MASK for every mode (David, 2026-07-13): the results
  // mount underneath while it overlays on top, and any new awards are held back
  // (`!showRocket`) so they pop over the REVEALED results rather than over a bare
  // backdrop. This replaced easy/challenge's old cosmic-burst + fixed-setTimeout
  // sequencing, which fired the confetti canvas (z-9000) and raced the
  // results/how-to state — the source of the post-win lag and the how-to overlay
  // auto-opening.
  //
  // `resultsReady` is reset to false FIRST: a second solve in the same session
  // would otherwise inherit the previous solve's `true` and let the rocket hand
  // off instantly, skipping the mask it exists to provide.
  //
  /**
   * @param {{prev?: object, updated?: object, points?: object, badges?: object|null, userId?: string|null}} [ledger]
   * @returns {any[]} the awards queued, so a caller can assert/log them
   */
  const begin = useCallback((ledger = {}) => {
    setLastAwards([]);
    const held = {
      prev: ledger.prev || {},
      updated: ledger.updated || {},
      points: ledger.points || {},
      userId: ledger.userId ?? null,
    };
    ledgerRef.current = held;
    // Filtered through the announced-record, so a moment the player has already
    // been shown cannot replay. On a first run the record is empty and this is a
    // no-op — a brand-new player's first solve is not suppressed by an absent record.
    const awards = filterUnannounced(
      detectNewAwards({ prev: held.prev, updated: held.updated, points: held.points, badges: ledger.badges ?? null }),
      readAnnouncedAwards(held.userId).record,
    );
    setResultsReady(false);
    setPendingAwards(awards);
    setShowRocket(true);
    // `liveRef` is written by an effect, which has not run yet at this point in
    // the same tick. Seed it here so a `settle` that resolves before the next
    // commit still sees a rocket in flight rather than an empty, settle-able queue.
    liveRef.current = { flying: true, queued: awards.length, awards };
    return awards;
  }, []);

  /**
   * The server-derived half of the ledger arrived — re-plan the celebration.
   *
   * Recomputes the WHOLE queue from the same stat ledger plus the authoritative
   * point totals, then appends the badge awards. Recomputing rather than
   * appending is what preserves the family order the celebration depends on
   * (streak → puzzle → battle → perfect → time → badge): the medals keep their
   * precedence over registry badges however late the badge reads land.
   *
   * ⚠️ It is a NO-OP while an award sequence is on screen. `AwardCelebrationSequence`
   * restarts itself whenever the `awards` array identity changes, so replacing a
   * queue the player is halfway through would throw them back to screen 1. A
   * settle that arrives that late is simply dropped — catching it belongs to the
   * catch-up-on-Home path, not here.
   *
   * @param {{points?: object|null, badgeAwards?: Array, userId?: string|null}} [args]
   *   `userId` — whose record; falls back to the one `begin` was given.
   * @returns {Array|null} the new queue, or null when the settle was dropped
   */
  const settle = useCallback(({ points = null, badgeAwards = [], userId = undefined } = {}) => {
    const { flying, queued } = liveRef.current;
    if (!flying && queued > 0) return null;

    const held = ledgerRef.current;
    // `points: null` means "no authoritative totals" — keep whatever `begin`
    // provisionally computed rather than dropping a real medal on a failed read.
    const nextPoints = points || held.points || {};
    const owner = userId ?? held.userId ?? null;
    ledgerRef.current = { ...held, points: nextPoints, userId: owner };

    const awards = filterUnannounced([
      ...detectNewAwards({ prev: held.prev, updated: held.updated, points: nextPoints }),
      ...(Array.isArray(badgeAwards) ? badgeAwards : []),
    ], readAnnouncedAwards(owner).record);
    setPendingAwards(awards);
    liveRef.current = { flying, queued: awards.length, awards };
    return awards;
  }, []);

  // The post-solve stats reload landed (or failed — either way the player must
  // not be stranded staring at a rocket). Lets it hand off at its floor instead
  // of flying to its 4s cap.
  const markResultsReady = useCallback(() => setResultsReady(true), []);

  // Leaving the results screen by ANY route. Clears the rocket flags so a later
  // re-open (the recap, a forfeit reveal) never inherits a stale flight.
  // Deliberately does NOT clear `pendingAwards` — those are cleared when the
  // queue drains, which is the only moment they have actually been seen.
  const reset = useCallback(() => {
    setShowRocket(false);
    setResultsReady(false);
    setLastAwards([]);
  }, []);

  const handleRocketComplete = useCallback(() => setShowRocket(false), []);
  const handleAwardsComplete = useCallback(() => {
    // The queue drained: everything in it has now actually been seen, which is
    // the only point at which it is honest to record it as announced. ALL SIX
    // families, not just the badges — that is the whole point of the unified
    // record. Read from `liveRef` rather than a `setPendingAwards` updater so
    // the write stays outside React's render path.
    const drained = liveRef.current.awards;
    try { recordAnnouncedAwards(drained, ledgerRef.current.userId); } catch { /* storage must never eat the drain */ }
    setLastAwards(drained);
    setPendingAwards([]);
    liveRef.current = { ...liveRef.current, queued: 0, awards: [] };
    // Recorded BEFORE the caller's callback so a caller that unmounts us on the
    // spot (Game.jsx re-opens the results here) still gets the write.
    onAwardsCompleteRef.current?.();
  }, []);

  // Everything PostSolveCelebration needs, in one spreadable bag, so the caller's
  // JSX is one line rather than six props it could silently forget to pass.
  const overlayProps = useMemo(
    () => ({
      showRocket,
      resultsReady,
      pendingAwards,
      onRocketComplete: handleRocketComplete,
      onAwardsComplete: handleAwardsComplete,
    }),
    [showRocket, resultsReady, pendingAwards, handleRocketComplete, handleAwardsComplete],
  );

  return {
    overlayProps,
    // How many awards are still queued — the home chrome hides while any is up
    // (isHomeLauncherActive), so a celebration is never framed by nav chrome.
    pendingCount: pendingAwards.length,
    lastAwards,
    begin,
    settle,
    markResultsReady,
    reset,
  };
}
