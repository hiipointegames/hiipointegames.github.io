// gameEntryModel — the pure mode decisions Game.jsx makes on mount.
//
// WHY THIS IS ITS OWN MODULE. Game.jsx is router/supabase/context-bound and no
// test mounts it; everything that lives inside it can only be "tested" by reading
// its source as a string (see pages/gameHomeLauncher.test.js). These three
// decisions are exactly the kind that must be pinned by behaviour, not by grep —
// each of them was WRONG in a way that a source lock would happily have blessed.
// Extracting them is also the arch ratchet's intended escape valve: Game.jsx is
// grandfathered and may only shrink.
//
// Every mode question here goes through @/game-modes predicates. Raw string
// comparison against a wire key is the specific mistake this file exists to undo.

import {
  DAILY_MODE_KEYS,
  isKnownModeKey,
  normalizeModeKey,
  modeOf,
  roundOf,
  keyFor,
} from '@/game-modes';

// Easy's Daily — where the home screen opens on a day with nothing to resume.
//
// It was Challenge's Daily ('daily') until 2026-09-29. David: players were
// playing Challenge far more than Easy or Expert, and the app opening with
// Challenge pre-selected was the obvious reason. Landing on the gentlest Daily
// puts the easiest of the three in front of everyone first. A forfeited or
// in-progress Daily still claims the screen ahead of this (resolveLandingMode).
export const DEFAULT_HOME_MODE = 'daily_easy';

/**
 * C1 — the mode the player explicitly asked for via navigation state.
 *
 * Game.jsx carried this as a literal allowlist, twice:
 *
 *     ['easy', 'challenge', 'daily'].includes(location.state?.mode)
 *
 * which could never admit `expert`, `daily_easy` or `daily_expert` — it was the
 * first line of code the three-mode feature hit, and it silently dropped the
 * request on the floor.
 *
 * `isKnownModeKey` is the STRICT predicate and it is the right one here: this is
 * untrusted navigation state (anyone can push any object into history state), and
 * an unknown value must be REJECTED so the caller falls back, not coerced into a
 * real round. The coercing predicates would turn `mode: 'nonsense'` into a
 * playable board.
 *
 * @param {unknown} navState  react-router's location.state
 * @returns {string|null} a known wire key, or null to mean "no explicit request"
 */
export function resolveIncomingMode(navState) {
  const requested = /** @type {any} */ (navState)?.mode;
  return isKnownModeKey(requested) ? requested : null;
}

/**
 * Which mode should the launcher land on after mount?
 *
 * This runs on EVERY mount of the Game page, not just the app's first: every
 * route is its own element, so returning from the Colosseum or Stats mounts a
 * fresh page. The ladder (David, 2026-09-29):
 *
 *   1. An explicit request (How-To-Play's "Got it — Play <mode>") always wins.
 *   2. Otherwise a Daily IN PROGRESS takes the screen — a clock is running and
 *      the player needs its "Continue Daily". The only interruption kept.
 *   3. Otherwise the mode the player was on earlier THIS APP SESSION
 *      (./sessionHomeMode), so leaving Home and coming back keeps their place.
 *   4. Otherwise DEFAULT_HOME_MODE — Easy's Daily, i.e. every first open.
 *
 * ⚠️ TWO RULES WERE REMOVED HERE ON 2026-09-29, both at David's request.
 *
 *   • A FORFEITED Daily used to claim the screen too. That dated from when
 *     Challenge was the only Daily (`setMode('daily')` on forfeit, so the
 *     player saw "today is spent, here are the solutions"). Under three
 *     Dailies it meant a player who forfeited Challenge was yanked onto
 *     Challenge on every open, a beat after Easy had painted — exactly what
 *     David saw on beta 1.0.315 (`math-wiz` had forfeited Challenge). The
 *     solutions still show right after the forfeit, and the tier keeps its ✕.
 *   • A half-played PRACTICE board (`active_game`) used to be rehydrated and
 *     land on its own mode. Practice is untimed and unranked, so reopening on
 *     Easy costs the player nothing real; `shouldRestoreActiveGame` went with
 *     it. An interrupted DAILY never came back this way — it resumes through
 *     the hook's recoverable / "Continue Daily" path, which rule 2 surfaces.
 *
 * A COMPLETED Daily does not claim the screen either; it never did.
 *
 * @param {object} p
 * @param {string|null} [p.incomingMode]  from resolveIncomingMode
 * @param {Record<string,string>} [p.statusByMode] wire key -> restore() result
 * @param {string|null} [p.rememberedMode] from recallHomeMode — null on first open
 * @returns {string} a known wire key
 */
export function resolveLandingMode({
  incomingMode = null,
  statusByMode = {},
  rememberedMode = null,
} = {}) {
  if (incomingMode) return incomingMode;

  const live = DAILY_MODE_KEYS.find((k) => statusByMode[k] === 'in_progress');
  if (live) return live;

  if (isKnownModeKey(rememberedMode)) return /** @type {string} */ (rememberedMode);

  return DEFAULT_HOME_MODE;
}

/**
 * Switch the DIFFICULTY TIER while staying on the same round.
 *
 * The home picker selects a tier (Easy / Challenge / Expert); the round (Daily
 * vs Practice) is a separate axis. Both travel in ONE wire key, so a tier change
 * is `keyFor(tier, roundOf(current))` rather than a second vocabulary of tab ids.
 * The project has been bitten once by exactly that: 'daily' means Challenge's
 * Daily *because* two vocabularies merged.
 *
 * @param {string} currentMode
 * @param {string} tier  'easy' | 'challenge' | 'expert'
 * @returns {string} a known wire key
 */
export function switchTier(currentMode, tier) {
  return keyFor(/** @type {any} */ (tier), roundOf(currentMode)) || normalizeModeKey(currentMode);
}

/**
 * Switch the ROUND while staying on the same difficulty tier.
 * @param {string} currentMode
 * @param {'daily'|'practice'} round
 * @returns {string} a known wire key
 */
export function switchRound(currentMode, round) {
  return keyFor(modeOf(currentMode), /** @type {any} */ (round)) || normalizeModeKey(currentMode);
}
