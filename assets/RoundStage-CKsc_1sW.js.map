import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { Logo37 } from './Logo37';

// WinMedallion — the congratulatory badge for the daily-win results header
// (2026-07-13, David). Replaces the old amber, emoji-based 🏆 that wobbled on a
// loop and clashed with the neon theme. This presents the 37 brand mark (Logo37
// — beveled gold "37" in a delicate cyan neon hex) with a celebratory ONE-TIME
// entrance pop plus a subtle glow breathe (opacity only — no wobble, which was
// the complaint). Honours prefers-reduced-motion (static, no pop/breathe).
/**
 * @param {{ size?: number, className?: string }} props
 */
export function WinMedallion({ size = 64, className = '' }) {
  const reduce = useReducedMotion();
  return (
    <div
      className={`relative inline-grid place-items-center ${className}`}
      style={{ width: size, height: size }}
      data-testid="win-medallion"
    >
      {/* soft cyan glow breathe behind the mark — opacity only, no movement */}
      <motion.div
        aria-hidden
        className="absolute rounded-full"
        style={{ inset: '-8%', background: 'radial-gradient(circle, var(--u37-cyan) 0%, transparent 70%)', filter: 'blur(10px)' }}
        initial={{ opacity: 0.25 }}
        animate={reduce ? { opacity: 0.3 } : { opacity: [0.22, 0.45, 0.22] }}
        transition={reduce ? undefined : { duration: 2.4, repeat: Infinity, ease: 'easeInOut' }}
      />
      {/* the brand mark, with a one-time celebratory pop */}
      <motion.div
        className="relative"
        initial={reduce ? { scale: 1, opacity: 1 } : { scale: 0.6, opacity: 0 }}
        animate={{ scale: 1, opacity: 1 }}
        transition={reduce ? undefined : { type: 'spring', damping: 12, stiffness: 260, delay: 0.1 }}
      >
        <Logo37 size={size} />
      </motion.div>
    </div>
  );
}
