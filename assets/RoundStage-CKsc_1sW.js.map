import React from 'react';
import RocketLaunchScreen from './RocketLaunchScreen';
import AwardCelebrationSequence from './AwardCelebrationSequence';

// PostSolveCelebration — the two overlays that play after a solve on the Game
// surface, and the ORDERING RULE between them.
//
// They are extracted together because they are not independent: the awards
// sequence is gated behind the rocket. That interlock (`!showRocket`) is the
// whole reason this component exists — it was a bare boolean buried in Game.jsx's
// JSX, which is a poor home for a rule that decides what a player sees at the
// most rewarding moment in the game.
//
// THE SEQUENCE:
//   1. The player solves. `showRocket` opens the rocket, which masks the latency
//      while SuccessModal computes underneath (see rocketLaunchController for the
//      min/cap/ready timing policy).
//   2. The rocket lifts away, revealing the results.
//   3. ONLY THEN do badge awards pop, glyph-free, OVER the revealed results.
//
// Step 3 is why `isOpen` ANDs `!showRocket`: without it the awards would paint a
// glyph backdrop before the results existed, which is what easy/challenge used to
// do. Awards with no rocket in flight open immediately, which is the correct
// behaviour for the modes that do not fly one.
//
// ⚠️ NOT shared with head-to-head. HeadToHeadGame renders AwardCelebrationSequence
// on its own with no rocket, so it has no interlock to honour. Pulling it in here
// would invent a dependency it does not have.
//
// This component owns NO state. Game.jsx keeps the state and the callback bodies;
// this is the JSX plus the ordering rule, so the rule can be tested without
// mounting Game.jsx (which no test does — it is a 0%-coverage page).
//
// @param {object} props
// @param {boolean} props.showRocket        is the rocket flying?
// @param {boolean} props.resultsReady      have post-solve stats landed? (lets it hand off early)
// @param {string}  props.mode              wire key — drives the rocket's palette + anthem
// @param {any[]}   props.pendingAwards     awards queued by detectNewAwards
// @param {() => void} props.onRocketComplete
// @param {() => void} props.onAwardsComplete
// @param {boolean} [props.hidesNav]        forwarded to AwardCelebrationSequence
//                                          (its default: true). The Sector 73 host
//                                          passes false — it keeps the nav hidden itself.
export default function PostSolveCelebration({
  showRocket,
  resultsReady,
  mode,
  pendingAwards = [],
  onRocketComplete,
  onAwardsComplete,
  hidesNav,
}) {
  return (
    <>
      <RocketLaunchScreen
        isOpen={showRocket}
        ready={resultsReady}
        mode={mode}
        onComplete={onRocketComplete}
      />
      <AwardCelebrationSequence
        awards={pendingAwards}
        isOpen={pendingAwards.length > 0 && !showRocket}
        onComplete={onAwardsComplete}
        hidesNav={hidesNav}
      />
    </>
  );
}
