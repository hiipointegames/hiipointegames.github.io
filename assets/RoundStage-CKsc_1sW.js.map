import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { ArrowRight, Play } from 'lucide-react';
import { createPageUrl } from '@/routing/createPageUrl';
import { modeAccentToken } from './modeTheme';
import { resultExit, ExitLink } from './resultExits';

// The post-win "here's what to play next" card.
//
// Extracted from SuccessModal (2026-09-17) when making the CTA prominent pushed
// that file past the 800-line architecture cap. Extracting is the right answer
// rather than a way around the gate: the card is a self-contained presentational
// unit with two branches, and it now gets its own tests instead of being reached
// only through a 69-case modal suite.
//
// The DECISION of what to nudge toward lives in nextChallengeNudge.js, which is
// pure and tested on its own. This file is only the rendering.

// The CTA's look, shared by both branches (Daily and Colosseum) so the two
// cannot drift apart. Full width, real padding, a 48px tap target.
const NUDGE_CTA_CLASS =
  'mt-2 w-full inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 '
  + 'min-h-[48px] text-sm font-black touch-manipulation active:scale-[0.98] transition-transform';

/**
 * The fill is a SOLID colour with the gradient layered on top, not a gradient
 * alone. The text on this button is near-black for contrast against a bright
 * accent, so if the gradient is ever dropped — it uses color-mix() inside
 * linear-gradient(), which not every engine parses; happy-dom discards the whole
 * declaration — a gradient-only fill would leave black text on a transparent
 * button. The solid base means the worst case is a flat accent pill, which is
 * still perfectly legible.
 *
 * @param {string} accent
 */
const nudgeCtaStyle = (accent) => ({
  color: '#050310',
  backgroundColor: accent,
  backgroundImage: 'linear-gradient(180deg, color-mix(in srgb, white 22%, transparent), transparent)',
  border: `2px solid ${accent}`,
  boxShadow: `0 0 24px -6px ${accent}, inset 0 1px 0 rgba(255,255,255,0.45)`,
});

/**
 * The CTA's arrow, nudging in the direction it sends you. Motion is what turns a
 * button into an invitation; it is dropped entirely under reduced motion.
 */
function NudgeArrow() {
  const reduce = useReducedMotion();
  return (
    <motion.span
      aria-hidden
      className="inline-flex"
      animate={reduce ? undefined : { x: [0, 4, 0] }}
      transition={reduce ? undefined : { duration: 1.1, repeat: Infinity, repeatDelay: 1.2, ease: 'easeInOut' }}
    >
      <ArrowRight className="w-4 h-4" strokeWidth={3} />
    </motion.span>
  );
}

/**
 * @param {{
 *   nudge: {
 *     kind: 'daily'|'battle',
 *     label: string,
 *     targets?: { targetMode: string, tierLabel: string, cta: string }[],
 *     cta?: string,
 *   } | null,
 *   onPlayMode: (e: any, targetMode: string) => void,
 *   onClose?: () => void,
 *   compact?: boolean,
 *   inWorld?: import('./resultExits').InWorld,
 * }} props
 *   compact — the condensed Daily win screen (Layout A, 2026-10-18): the label
 *   becomes a small left-aligned section heading and two Daily buttons sit side
 *   by side at half width instead of stacking. Same buttons, same handlers.
 *   inWorld — Sector 73 host (./resultExits): the battle nudge (→ /HeadToHead)
 *   shows only for `exits.battle`; hidden, the whole card is. Daily nudges stay.
 */
export default function NextChallengeNudgeCard({ nudge, onPlayMode, onClose, compact = false, inWorld }) {
  if (!nudge) return null;
  const battleExit = resultExit(inWorld, 'battle');
  if (nudge.kind !== 'daily' && battleExit.kind === 'hidden') return null;
  const targets = nudge.kind === 'daily' ? (nudge.targets || []) : [];
  const sideBySide = compact && targets.length === 2;
  const ctaClass = compact ? NUDGE_CTA_CLASS.replace('px-4 py-3', 'px-2 py-2.5').replace('mt-2 ', 'mt-1.5 ') : NUDGE_CTA_CLASS;

  // BUTTONS, NOT A TEXT BOX (David, 2026-09-29). This was a bordered card with a
  // headline, a line of body copy and one CTA; before that (2026-09-17) the CTA
  // was an 11px text link. He asked for the box to go and for "very obviously
  // clickable buttons" — one per Daily still open, each in THAT Daily's tier
  // colour so it previews where it sends you. The only words left are the label.
  return (
    <div className={compact ? 'mt-2.5' : 'mb-3'} data-testid="success-nudge">
      <div
        data-testid="success-nudge-label"
        className={compact
          ? 'text-[10px] font-black uppercase tracking-[0.2em] text-slate-400'
          : 'text-[11px] font-black uppercase tracking-widest text-slate-300 text-center'}
      >
        {nudge.label}
      </div>
      {nudge.kind === 'daily' ? (
        <div className={sideBySide ? 'grid grid-cols-2 gap-2' : undefined} data-testid="success-nudge-buttons">
          {targets.map((t) => (
            <button
              key={t.targetMode}
              data-testid={`success-nudge-cta-${t.targetMode}`}
              onClick={(e) => onPlayMode(e, t.targetMode)}
              className={ctaClass}
              style={nudgeCtaStyle(modeAccentToken(t.targetMode))}
            >
              <Play aria-hidden className="w-4 h-4 flex-shrink-0" fill="currentColor" strokeWidth={0} />
              {/* Half width has no room for "Start "; the tier + "Daily" is the
                  whole message, and the play glyph already says start. */}
              <span>{sideBySide ? `${t.tierLabel} Daily` : t.cta}</span>
              {!sideBySide && <NudgeArrow />}
            </button>
          ))}
        </div>
      ) : (
        <ExitLink
          exit={battleExit}
          data-testid="success-nudge-cta"
          to={createPageUrl('HeadToHead')}
          onClick={onClose}
          className={ctaClass}
          style={nudgeCtaStyle('var(--u37-magenta)')}
        >
          <span>{nudge.cta}</span>
          <NudgeArrow />
        </ExitLink>
      )}
    </div>
  );
}
