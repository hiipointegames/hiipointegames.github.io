import React, { useState } from 'react';

import { contestToday } from './contestEntries';
import { EMAIL_CODE_COPY } from './emailCodeCopy';
import { blocksEntryForVerification, showsVerifyHeadsUp } from './emailVerificationRules';
import EmailCodeSheet from './EmailCodeSheet';

// The one line on the giveaway sheet (ContestDetails) about the email check.
//
//   before 25 Oct, and in a player's 7-day grace after it —
//                   "Verify your email to keep earning giveaway entries.
//                    It takes 30 seconds. [Verify now]"
//   from 25 Oct   — "Email not verified: we couldn't be sure a win reaches you.
//                    [Verify email]"
//
// Only when the server has SAID "not verified" (verified === false). Unknown
// (null) renders nothing, and so does a verified or not-otherwise-eligible
// player (their other gaps come first).
//
// Lives on the sheet rather than as a pop-up on Home: the sheet is where a
// player goes to read about the giveaway, and both the home chip and the
// results line open it.

/**
 * @param {{ user: any, verified: boolean|'grace'|null, today?: string, onLeave?: () => void, deps?: object }} props
 *   onLeave — closes the host sheet before the account form opens
 */
export default function EmailVerifyNotice({ user, verified, today = contestToday(), onLeave, deps }) {
  const [open, setOpen] = useState(false);
  const [done, setDone] = useState(false);

  const headsUp = showsVerifyHeadsUp({ user, verified, today });
  const blocking = blocksEntryForVerification({ user, verified, today });
  if (!open && (done || (!headsUp && !blocking))) return null;

  return (
    <>
      {!done && (headsUp || blocking) && (
        <div
          data-testid="email-verify-notice"
          data-kind={blocking ? 'gap' : 'heads_up'}
          className="w-full text-left text-[11px] font-semibold leading-snug rounded-xl px-3 py-2 mb-2 border"
          style={{
            borderColor: 'color-mix(in srgb, var(--u37-gold) 40%, transparent)',
            background: 'color-mix(in srgb, var(--u37-gold) 10%, transparent)',
            color: 'rgb(203 213 225)',
          }}
        >
          {blocking ? (
            <span>{EMAIL_CODE_COPY.gapReason}</span>
          ) : (
            <span>{EMAIL_CODE_COPY.noticeBody}</span>
          )}{' '}
          <button
            type="button"
            data-testid="email-verify-open"
            onClick={() => setOpen(true)}
            className="min-h-[32px] touch-manipulation font-black underline decoration-dotted underline-offset-4"
            style={{ color: 'color-mix(in srgb, var(--u37-gold) 35%, white)', WebkitTapHighlightColor: 'transparent' }}
          >
            {blocking ? EMAIL_CODE_COPY.gapCta : EMAIL_CODE_COPY.noticeCta}
          </button>
        </div>
      )}
      {open && (
        <EmailCodeSheet
          user={user}
          onClose={() => setOpen(false)}
          onVerified={() => setDone(true)}
          onLeave={onLeave}
          deps={deps}
        />
      )}
    </>
  );
}
