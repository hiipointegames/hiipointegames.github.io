// fitToScreen — keep a card on ONE screen when the phone's text is bigger
// than designed (David, 2026-10-18 device check).
//
// Android's font-size setting scales text inside the WebView, so a card that
// fits a stock S21 can still push its last buttons under the banner ad on a
// phone with larger text. `fitZoom` picks a CSS zoom that makes the content
// fit the room it has, never below MIN_FIT_ZOOM — past that, readability wins
// and the scroller takes over as before.

export const MIN_FIT_ZOOM = 0.85;

/**
 * @param {number} contentHeight natural (unzoomed) height of the content
 * @param {number} roomHeight height available to it
 * @param {number} [min]
 * @returns {number} 1 when it already fits; otherwise the shrink factor, ≥ min
 */
export function fitZoom(contentHeight, roomHeight, min = MIN_FIT_ZOOM) {
  if (!(contentHeight > 0) || !(roomHeight > 0) || contentHeight <= roomHeight) return 1;
  // Two decimals, rounded DOWN, so a rounding error can't leave 1px of overflow.
  return Math.max(min, Math.floor((roomHeight / contentHeight) * 100) / 100);
}

/**
 * The nearest ancestor that scrolls vertically, or null.
 * @param {Element} node
 * @returns {HTMLElement | null}
 */
export function nearestScroller(node) {
  for (let el = node.parentElement; el; el = el.parentElement) {
    const oy = getComputedStyle(el).overflowY;
    if (oy === 'auto' || oy === 'scroll') return el;
  }
  return null;
}

/**
 * Measure `el` at full size inside its scroller and apply the zoom that fits.
 * Imperative on purpose: the measurement must happen with zoom reset to 1.
 *
 * @param {HTMLElement} el
 * @param {HTMLElement} scroller
 * @returns {number} the zoom applied
 */
export function applyFitZoom(el, scroller) {
  el.style.zoom = '';
  const natural = el.getBoundingClientRect().height;
  const others = scroller.scrollHeight - natural; // padding + anything else in the scroller
  const zoom = fitZoom(natural, scroller.clientHeight - others);
  el.style.zoom = zoom < 1 ? String(zoom) : '';
  el.setAttribute('data-fit-zoom', String(zoom));
  return zoom;
}
