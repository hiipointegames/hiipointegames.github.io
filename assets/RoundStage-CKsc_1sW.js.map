import { isDaily } from '@/game-modes';

// enterPreGameScreen — open a mode's pre-game start screen, putting a Daily
// behind its interstitial ad first.
//
// WHY THIS IS ITS OWN FUNCTION. There were two ways into a Daily's start screen
// and only one of them played the ad. The launcher's Start button went through
// Game.jsx `doRoll` → showInterstitial → ChallengeWarningModal. The win screen's
// "play the next Daily" button went through `handlePlayMode`, which called
// `dc.openStartWarning()` directly — so every Daily entered from the win screen
// skipped its ad. David, 2026-09-29: tapping those buttons "should auto open the
// ad for that daily, play the ad and then take the person to the pre-daily
// beginning screen." One function now owns that rule, so the paths can't drift.
//
// ⚠️ IT OPENS THE **TARGET** MODE'S START SCREEN, NOT THE CURRENT ONE. Game.jsx
// runs one attempt hook per Daily (dcEasy / dcChallenge / dcExpert) and `dc` is
// whichever one the CURRENT mode points at. `handlePlayMode` is created while
// the player is still on the Daily they just finished, so its `dc` is THAT
// Daily's hook — and `dc.openStartWarning()` raised the flag on the wrong hook.
// The screen then re-rendered onto the target mode, whose flag was still false,
// so no start screen appeared at all: the player was dumped on the launcher, and
// the Daily they had just left was left with a hidden start screen armed.
// Found 2026-09-29 while verifying this change in the browser. Taking the
// per-mode map and indexing it by `targetMode` makes the right hook the only
// one reachable.
//
// `showAd` is the shell's `showInterstitial`, injected rather than imported: it
// already fails OPEN (on web, or if the ad cannot load, `onDismissed` fires
// immediately), so a missing ad never strands the player short of the start
// screen. Practice rounds have no ad and go straight to their start screen.
//
// @param {string} targetMode a wire key
// @param {{
//   showAd: (opts: { onDismissed: () => void }) => unknown,
//   dailyByMode: Record<string, { openStartWarning: () => void }>,
//   openPracticeStart: () => void,
// }} deps
export function enterPreGameScreen(targetMode, { showAd, dailyByMode, openPracticeStart }) {
  if (isDaily(targetMode)) {
    const target = dailyByMode[targetMode];
    showAd({ onDismissed: () => target?.openStartWarning() });
    return;
  }
  openPracticeStart();
}
