// shell/appSwitch — read one server switch from public.app_settings.
//
// WHY. adSwitch.js (2026-10-10) proved the idea: a row the server can flip in
// seconds beats a CapGo release when something misbehaves. That reader is
// hard-wired to `native_interstitials`. This is the same reader for ANY key, so a
// new feature gets a kill switch without copying it again. First user: the store
// review prompt (`review_prompt`, ./reviewPrompt.js). adSwitch.js is left as it is
// on purpose (it guards the ads, and this slice should not touch them).
//
// Values are the same three as the ad switch:
//   'off'  — feature off (the default)
//   'beta' — only phones on the CapGo beta channel (test on real phones, no release)
//   'on'   — everyone
//
// FAIL CLOSED: a missing row, an unknown value, a failed read or a slow read all
// mean 'off'. The server must say yes before a switched feature runs.
//
// Each key's answer is cached for SWITCH_CACHE_MS, so a flip on the server
// reaches a running app within about two minutes.

import { supabase, withTimeout } from '@/transport';
import { isOnBeta } from './betaChannel';

export const APP_SWITCH_MODES = Object.freeze(['off', 'beta', 'on']);
export const APP_SWITCH_CACHE_MS = 2 * 60 * 1000;
const READ_TIMEOUT_MS = 4000;

/** @type {Map<string, { mode: string, at: number }>} */
const cache = new Map();

/**
 * Read one switch. Never throws; anything unexpected is 'off'.
 * @param {string} key the app_settings key
 * @param {{ client?: any, timeoutMs?: number, now?: () => number }} [deps]
 * @returns {Promise<'off'|'beta'|'on'>}
 */
export async function readAppSwitch(key, deps = {}) {
  const now = (deps.now || Date.now)();
  const hit = cache.get(key);
  if (hit && now - hit.at <= APP_SWITCH_CACHE_MS) return /** @type {any} */ (hit.mode);
  let mode = 'off';
  try {
    const client = deps.client || supabase;
    const res = await withTimeout(
      client.from('app_settings').select('value').eq('key', key).maybeSingle(),
      { data: null, error: 'timeout' },
      deps.timeoutMs ?? READ_TIMEOUT_MS,
    );
    const value = res?.data?.value;
    if (APP_SWITCH_MODES.includes(value)) mode = value;
  } catch {
    mode = 'off';
  }
  cache.set(key, { mode, at: now });
  return /** @type {any} */ (mode);
}

/**
 * True when the switch lets this phone use the feature right now.
 * 'beta' asks the CapGo channel; a failed channel read means no.
 * @param {string} key
 * @param {{ client?: any, timeoutMs?: number, now?: () => number,
 *           isOnBeta?: () => Promise<boolean> }} [deps]
 * @returns {Promise<boolean>}
 */
export async function appSwitchAllows(key, deps = {}) {
  const mode = await readAppSwitch(key, deps);
  if (mode === 'on') return true;
  if (mode !== 'beta') return false;
  try {
    return Boolean(await (deps.isOnBeta || isOnBeta)());
  } catch {
    return false;
  }
}

// Test-only: forget every cached switch.
export function __resetAppSwitchForTests() { cache.clear(); }
