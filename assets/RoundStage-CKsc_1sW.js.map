import React, { useState } from 'react';
import { createPortal } from 'react-dom';
import { X } from 'lucide-react';
import { useAuth } from '@/auth';
import { isDaily } from '@/game-modes';
import {
  ContestDetails,
  ContestEligibilityNotice,
  MAX_ENTRIES_PER_DAY,
  MAX_ENTRIES_PER_WEEK,
  contestEligibilityGaps,
  contestEntryState,
  contestToday,
  hasDeclinedContestEligibility,
  isContestPromoVisible,
  useContestWeekEntries,
  useGiveawayEmailVerified,
} from '@/contest';
import { referralBonusSuffix, useMyWeekBonus, useReferralsOn } from '@/referrals';

// The giveaway, as ONE line on the condensed Daily win screen (Layout A, David
// 2026-10-18). Tapping it opens the full story in a bottom sheet.
//
// ─────────────────────────────────────────────────────────────────────────────
// NOTHING THE NOTICE SAID IS LOST — IT MOVED BEHIND THE TAP
// ─────────────────────────────────────────────────────────────────────────────
// The ContestEligibilityNotice ("That Daily did not earn an entry", every
// reason, the fix for each, the not-retroactive footer) used to sit open on the
// win screen and was the single tallest block on it. The line keeps the one fact
// that changes what a player does — "no entry, and N things fix it" — and the
// sheet renders the unchanged notice, controls and all.
//
// An ELIGIBLE player saw nothing here before (the notice renders to nothing for
// them). They now get the good news: "+1 entry · X of 21 this week", and the tap
// opens the existing giveaway details sheet.
//
// ⚠️ EVERY NUMBER HERE IS A CLAIM ABOUT A PRIZE (see @/contest contestEntries).
// The count comes from the same pure functions as the home chip. This solve is
// added to the week's rows before counting, because the read can land before
// this Daily's row does — and the solve just happened, so it is certain.
// countContestEntries de-dupes, so it can never be counted twice. When the week
// is not known, the line says only what is.

/**
 * What the line says, or null when it shows nothing.
 *
 * @param {{
 *   user?: Record<string, any> | null,
 *   rows?: Array<{date?: string, mode?: string}> | null,
 *   mode: string,
 *   statusByMode?: Record<string, string> | null,
 *   today?: string,
 *   emailVerified?: boolean|'grace'|null,
 *   bonus?: number,
 * }} args
 *   emailVerified — the server's answer. From 25 Oct 2026 a `false` is a gap,
 *   so the line never promises "+1 entry" the drawing will not hold.
 * @returns {{ kind: 'gaps' | 'entries', text: string } | null}
 */
export function giveawayLineState({ user, rows, mode, statusByMode, today = contestToday(), emailVerified = null, bonus = 0 }) {
  if (!isDaily(mode)) return null;
  // A player who answered No is never asked again here (same rule as the notice).
  if (hasDeclinedContestEligibility(user)) return null;

  const gaps = contestEligibilityGaps(user, { emailVerified, today });
  if (gaps.length) {
    const n = gaps.length;
    return { kind: 'gaps', text: `No giveaway entry · ${n} quick fix${n === 1 ? '' : 'es'}` };
  }

  const state = contestEntryState({
    user,
    rows: Array.isArray(rows) ? [...rows, { date: today, mode }] : null,
    statusByMode: { ...(statusByMode || {}), [mode]: 'completed' },
    today,
    emailVerified,
  });
  if (state.kind !== 'entries') return null;
  // " · +N from friends" (referrals, switch-gated by the caller: 0 = nothing).
  const tail = referralBonusSuffix(bonus);
  if (state.week != null) return { kind: 'entries', text: `+1 entry · ${state.week} of ${MAX_ENTRIES_PER_WEEK} this week${tail}` };
  // Today is always known here: this Daily is passed in as completed above.
  return { kind: 'entries', text: `+1 entry · ${state.today} of ${MAX_ENTRIES_PER_DAY} Dailies today${tail}` };
}

/**
 * The bottom sheet. Portaled to <body> at z-[200] — inside #root, iOS traps
 * z-index under the body-portaled nav (the iPhone stacking rule, 40a906f).
 *
 * @param {{ onClose: () => void, children: React.ReactNode }} props
 */
function GiveawaySheet({ onClose, children }) {
  const node = (
    <div className="fixed inset-0 z-[200] flex flex-col justify-end" data-testid="giveaway-sheet">
      <button
        type="button"
        aria-label="Close"
        data-testid="giveaway-sheet-backdrop"
        onClick={onClose}
        className="absolute inset-0 w-full h-full cursor-default"
        style={{ background: 'linear-gradient(180deg, rgba(5,3,17,0.55), rgba(5,3,17,0.85))' }}
      />
      <div
        role="dialog"
        aria-modal="true"
        aria-label="Weekly giveaway"
        className="relative w-full max-w-md mx-auto px-3"
        style={{ paddingBottom: 'calc(var(--safe-bottom) + var(--ad-reserved-bottom) + 0.75rem)' }}
      >
        {children}
      </div>
    </div>
  );
  return typeof document !== 'undefined' ? createPortal(node, document.body) : node;
}

/**
 * @param {{
 *   mode: string,
 *   statusByMode?: Record<string, string> | null,
 *   onLeave?: () => void,
 * }} props
 *   onLeave — closes the result screen before a flow that navigates away
 */
export default function GiveawayLine({ mode, statusByMode, onLeave }) {
  const { user } = useAuth();
  const rows = useContestWeekEntries(user);
  const emailVerified = useGiveawayEmailVerified(user);
  const referralsOn = useReferralsOn();
  const bonus = useMyWeekBonus(user, referralsOn);
  // The sheet keeps the face it opened with: verifying from inside the gaps
  // sheet flips the line to "+1 entry", and the sheet must not swap under the
  // player mid-flow (the code sheet's "Verified" lives inside the notice).
  const [open, setOpen] = useState(/** @type {null | 'gaps' | 'entries'} */ (null));

  if (!isContestPromoVisible()) return null;
  const state = giveawayLineState({ user, rows, mode, statusByMode, emailVerified, bonus });
  if (!state) return null;

  const close = () => setOpen(null);
  const leave = () => { setOpen(null); onLeave?.(); };

  return (
    <>
      <button
        type="button"
        data-testid="giveaway-line"
        data-kind={state.kind}
        onClick={() => setOpen(state.kind)}
        className="mt-2 w-full min-h-[36px] rounded-xl border px-3 flex items-center gap-2 text-left text-[13px] font-bold touch-manipulation active:scale-[0.98]"
        style={{
          color: 'var(--u37-gold)',
          borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
          background: 'color-mix(in srgb, var(--u37-gold) 7%, transparent)',
        }}
      >
        <span aria-hidden="true">🎟️</span>
        <span className="flex-1 min-w-0 truncate">{state.text}</span>
        <span aria-hidden="true" className="text-base">›</span>
      </button>

      {open && (
        <GiveawaySheet onClose={close}>
          {open === 'gaps' ? (
            <div
              className="rounded-2xl border p-3"
              style={{
                background: 'var(--u37-panel-bg)',
                borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
              }}
            >
              <div className="flex items-center justify-between">
                <span className="text-sm font-black" style={{ color: 'var(--u37-gold)' }}>🎟️ Weekly giveaway</span>
                <button
                  type="button"
                  aria-label="Close"
                  data-testid="giveaway-sheet-close"
                  onClick={close}
                  className="min-w-[44px] min-h-[44px] -mr-2 flex items-center justify-center text-slate-400"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>
              <ContestEligibilityNotice mode={mode} onLeave={leave} emailVerified={emailVerified} />
            </div>
          ) : (
            <ContestDetails onClose={close} />
          )}
        </GiveawaySheet>
      )}
    </>
  );
}
