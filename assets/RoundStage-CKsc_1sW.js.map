// Persist a completed easy/challenge practice solve as a durable row in
// practice_solves. Easy and challenge are practice modes (no leaderboard); the
// daily challenge has its own event log (daily_challenge_times). Storing every
// practice solve lets easySolved/challengeSolved be DERIVED by counting rows
// (see countSolvesByMode) instead of being hand-incremented in the game_stats
// blob — the counter a backend migration silently dropped (docs/bugs.md).

import { apiClient } from '@/transport';
import { isKnownModeKey, isPractice } from '@/game-modes';

// Deliberately NOT imported from `@/game-flow` (which owns the same rule in
// solveClock.js): this subsystem depends on transport + game-modes and nothing
// else, and the game-flow barrel drags head-to-head and profile in behind it.
// Four lines restated is cheaper than that edge, and the two are pinned by the
// test below asserting the identical 0-is-not-a-measurement behaviour.
/** A real measurement, or null. 0 means NOT RECORDED — see solveClock.js. */
const recordableSolveTime = (seconds) =>
  typeof seconds === 'number' && Number.isFinite(seconds) && seconds > 0 ? seconds : null;

// Was a local Set(['easy','challenge']). isPractice asks the same question from
// the one module that owns the vocabulary, and stays correct when an Expert
// practice mode is added — a local Set would have silently refused to record it.

/**
 * Record one practice solve. No-ops (returns null) for non-practice modes or a
 * missing user, so callers can fire it unconditionally on solve. Errors are
 * swallowed (logged) — a stats write must never block the win celebration.
 *
 * @param {{
 *   user: { id: string },
 *   mode: 'easy' | 'challenge',
 *   date: string,
 *   equation: string,
 *   usedDiceIndices: number[],
 *   diceColors: string[],
 *   shuffledDice: number[],
 *   solveTimeSeconds?: number|null,
 * }} solve
 * @returns {Promise<object|null>} the created row, or null if skipped/failed.
 */
export async function recordPracticeSolve({
  user, mode, date, equation, usedDiceIndices, diceColors, shuffledDice, solveTimeSeconds = null,
}) {
  // isKnownModeKey FIRST: this is a write gate on untrusted input, and the
  // predicates normalize, so isPractice('nonsense') would be true (it coerces to
  // 'easy'). An unrecognised mode must record nothing.
  if (!user?.id || !isKnownModeKey(mode) || !isPractice(mode)) return null;
  try {
    return await apiClient.entities.PracticeSolve.create({
      user_id: user.id,
      mode,
      date,
      equation,
      usedDiceIndices,
      diceColors,
      shuffledDice,
      // ⚠️ NULL, NOT 0, WHEN THE ROUND WAS NEVER MEASURED. This defaulted to 0
      // and Game.jsx passed 0 for every practice solve, so all 822 production
      // rows claim to have been solved instantly. 0 is the FASTEST POSSIBLE
      // value, not a missing one: `craftStages.divideFast` carries a defensive
      // `seconds > 0` clause purely to work around it, which is why the
      // Lightning Divide rung can never light from a practice solve. The column
      // is nullable; null is the honest answer, and readers already treat a
      // missing time as "not recorded". See src/game-flow/solveClock.js.
      solve_time_seconds: recordableSolveTime(solveTimeSeconds),
    });
  } catch (error) {
    console.warn('Failed to record practice solve, skipping:', error);
    return null;
  }
}
