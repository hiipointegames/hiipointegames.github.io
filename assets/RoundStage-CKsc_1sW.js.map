import { useEffect, useRef } from 'react';
import { apiClient } from '@/transport';
import { DAILY_MODE_KEYS } from '@/game-modes';
import { syncPublicProfile } from '@/player';
import { getPlayerStats, applyDerivedPlayerStats } from '@/stats-aggregation';
import { emptyGameStats } from './initialGameStats';
import { resolveIncomingMode, resolveLandingMode } from './gameEntryModel';
import { recallHomeMode, rememberHomeMode } from './sessionHomeMode';
import { rememberPlayerPoints } from './solveCompletion';
import { reportedFallback } from '@/observability';

// useGameMount — everything the Game page does ONCE, on cold start.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT MOVED OUT OF Game.jsx
// ─────────────────────────────────────────────────────────────────────────────
// `Game.jsx` is a grandfathered arch-ratchet blob, and a grandfathered blob by
// design has NO headroom: the gate lets it shrink and never grow, so every slice
// that needs a line in it is blocked until the file drops under the 800 cap and
// stops being grandfathered at all. This is 98 of the ~205 lines that takes.
//
// It also buys something the size number does not show. This is the app's
// COLD-START path — the first thing that runs when a player opens the game — and
// it lived inside a `useEffect(..., [])` on a page that only one smoke test
// mounts. The orchestration below could not be driven directly at all: not the
// "no user" branch, not a failed restore, not the ordering rule in §ORDER that
// three separate bugs have already been paid for. Now `loadGameMount` is an
// ordinary async function with injected dependencies and a suite.
//
// ─────────────────────────────────────────────────────────────────────────────
// §ORDER — the sequencing here is load-bearing, not incidental
// ─────────────────────────────────────────────────────────────────────────────
// The landing mode is decided ONCE, LAST. The code this replaced made that
// decision across three separate `setMode` calls that had to run in the right
// order, and the forfeit one named `'daily'` literally — so an interrupted Easy
// or Expert Daily landed on Challenge. `resolveLandingMode` takes every input at
// once and returns one answer, and it is called after the restores precisely so
// nothing can overwrite it.
//
// The three Dailies restore IN PARALLEL and each asks only about its own mode.
// That is what makes three independent streaks independent; a mode-blind restore
// is the bug class this shape closes.

/**
 * Everything the Game page needs to do before it can render a landing state.
 *
 * Dependencies are injected so every branch — no user, a failed restore, a dead
 * points read — is drivable without a network or a React tree. Production passes
 * nothing.
 *
 * @param {Object} args
 * @param {Record<string, {restore: Function}>} args.dailyByMode per-mode daily hooks
 * @param {any} args.locationState  react-router nav state (untrusted input)
 * @param {{current: any}} args.knownPointsRef  the BEFORE side of a point-tier crossing
 * @param {Object} args.apply  the page's setters, called as the load progresses
 * @param {string} [args.mode]  the page's current mode — read by useGameMount's
 *   remember effect, not by loadGameMount
 * @param {Object} [deps] injected for tests
 * @returns {Promise<{landedOn: string}|null>} null when there is no user to load
 */
export async function loadGameMount({ dailyByMode, locationState, knownPointsRef, apply }, deps = {}) {
  const {
    me = () => apiClient.auth.me(),
    syncProfile = syncPublicProfile,
    readPlayerStats = getPlayerStats,
    applyDerived = applyDerivedPlayerStats,
    recall = recallHomeMode,
  } = deps;

  // Read BEFORE the first await. useGameMount's remember effect runs right after
  // this one and records the page's INITIAL mode; reading here guarantees the
  // landing sees what the player had before this mount, never that echo.
  const rememberedMode = recall();

  try {
    const currentUser = await me();
    if (!currentUser) return null;

    apply.setUser(currentUser);

    // One shape, one place. This fallback used to be a SECOND hand-written
    // literal that had already drifted from the page's useState one by eight
    // fields — see ./initialGameStats.
    const gameStats = currentUser.game_stats || emptyGameStats();

    // The mode the player explicitly chose on the How-To-Play page ("Got it —
    // Play <mode>" / its back arrow), passed via navigation state. When present
    // it outranks every other landing rule, so each mode's How-To-Play returns
    // to THAT mode's home. Untrusted input: an unknown key is REJECTED, not
    // coerced.
    const incomingMode = resolveIncomingMode(locationState);

    // Restore all three Dailies IN PARALLEL. Each asks only about its own mode,
    // so the answers are independent — which is the whole point of three
    // independent streaks. See §ORDER.
    const userForRestore = { ...currentUser, game_stats: gameStats };
    const restored = await Promise.all(
      DAILY_MODE_KEYS.map((k) => dailyByMode[k].restore(userForRestore)),
    );
    const restoredByMode = Object.fromEntries(DAILY_MODE_KEYS.map((k, i) => [k, restored[i]]));

    // Streak is already calculated accurately by get-player-stats — do not
    // recalculate it here.
    await syncProfile(currentUser);

    apply.setStats(gameStats);
    apply.setStatsLoaded(true);

    // Authoritative point totals + the derived perMode block. Fire-and-forget:
    // nothing below depends on it, and a dead read must not cost the player
    // their landing screen.
    //
    // `rememberPlayerPoints` takes BOTH totals off the same envelope —
    // `applyDerivedPlayerStats` surfaces only the puzzle one, and the battle
    // total is the BEFORE side of a battle-tier crossing announced on Home.
    readPlayerStats(currentUser.id)
      .then((r) => {
        applyDerived(r, { setPuzzlePoints: apply.setPuzzlePoints, setStats: apply.setStats });
        rememberPlayerPoints(knownPointsRef, r);
      })
      .catch(reportedFallback('mount.stats'));

    // A half-played PRACTICE board (`active_game`) is NOT rehydrated any more
    // (David, 2026-09-29): the app opens on Easy, or on the mode remembered this
    // session, with a clean launcher. Practice is untimed and unranked, so
    // nothing real is lost. An interrupted DAILY never came back this way — it
    // resumes through the hook's recoverable / "Continue Daily" path.

    // ONE landing decision, made LAST so it cannot be overwritten by an earlier
    // setMode racing a later one. See §ORDER and ./gameEntryModel.
    const landedOn = resolveLandingMode({ incomingMode, statusByMode: restoredByMode, rememberedMode });
    apply.setMode(landedOn);
    return { landedOn };
  } catch (error) {
    // A cold start that throws must still leave the player on a usable launcher.
    console.error('Failed to load user:', error);
    return null;
  }
}

/**
 * The mount effect itself. Runs `loadGameMount` exactly once.
 *
 * Its arguments are read from a ref at call time rather than captured in the
 * effect's closure, so the empty dependency array stays honest: the effect truly
 * depends on nothing, and the values it uses are the ones current at mount.
 *
 * @param {Parameters<typeof loadGameMount>[0]} args
 */
export function useGameMount(args) {
  const argsRef = useRef(args);
  argsRef.current = args;
  useEffect(() => {
    loadGameMount(argsRef.current);
  }, []);
  // Keep the session memory current, so the NEXT mount (the player returning
  // from the Colosseum, Stats, …) lands where they were. Declared AFTER the
  // mount effect on purpose: effects run in order, and loadGameMount reads the
  // memory synchronously before this first records the page's initial mode.
  useEffect(() => {
    rememberHomeMode(args.mode);
  }, [args.mode]);
}
