// @ts-nocheck
// ONE ROUND of 37 — the board, the Daily/practice entry paths, the solve, the
// results hand-off and the autosave. Moved verbatim out of src/pages/Game.jsx
// (slice 1b of session 2026-10-19-s73-37-inside) so a second host (Sector 73)
// plays the SAME round with the same counting. Pure move: the moved hooks keep
// their relative order and every dependency array is byte-identical —
// handleSubmit's included (fixing it is its own slice).
//
// What differs per host comes in as arguments: `mode`/`setMode` (the host owns
// the mode), `record` (usePlayerRecord), `threeDailies` (useThreeDailies),
// `openHowTo` (the host's how-to overlay), `mirror` (Sector 73's Mirror warp —
// useMirrorWarp's return; the host calls the hook, it needs `user` first) and
// `showInterstitial` (defaults to the shell's — same name, so the moved lines
// did not change).
//
// `stageProps` is everything RoundStage's JSX reads; `surfaceUp`, `openRecap`
// and `resetBoard` are the small public surface a host drives the round with.
import React, { useState, useEffect, useCallback } from 'react';
import { apiClient } from '@/transport';

import { enterPreGameScreen } from './enterPreGameScreen';
import { usePostSolveCelebration } from './usePostSolveCelebration';
import { useDailyWinReviewPrompt } from './useDailyWinReviewPrompt';
import { recordSolveLedger, persistSolveOutcome, provisionalPoints } from './solveCompletion';
import { measureSolve } from './solveClock';
import { submitAndReportDailyTime } from './leaderboardSubmit';
import { triggerPowerDiceShake } from './powerDiceShake';
import { switchRound } from './gameEntryModel';
import { shuffleBoard } from './shuffleBoard';

import { useDailyBackGuard, todayET, yesterdayET } from '@/daily-challenge';
import { getSeen, markSeen } from '@/how-to-play';
import { isDaily, isPractice, isTimed, hasPowerDice } from '@/game-modes';
import { syncPublicProfile } from '@/player';
import { recordPracticeSolve } from '@/practice-solves';
import { playSound } from '@/ui/feedback';
import { generateDailyDice, getDiceColors } from '@/dice';
import { evaluateEquation, validateChallengeModeRules, collectDraftErrors } from '@/equation-engine';
import { useEquationDraft } from '@/equation-draft';
import { preservePerMode } from '@/stats-aggregation';
import { showInterstitial as shellShowInterstitial, noteDailyWin } from '@/shell';

export function useRoundSession({ mode, setMode, record, threeDailies, openHowTo, mirror, showInterstitial = shellShowInterstitial }) {
  const { user, setUser, stats, setStats, statsRef, statsLoaded, knownPointsRef, setPuzzlePoints } = record;
  const { dcChallenge, dailyByMode, statusByMode, liveDailyMode } = threeDailies;

  const [dice, setDice] = useState([]);
  const [diceColors, setDiceColors] = useState([]);
  const {
    equation,
    usedDiceIndices,
    usedDiceIds,
    cursorPosition,
    clickDie,
    insertOperator,
    deleteAtCursor,
    clear: clearDraft,
    setCursor,
    remapDiceReferences,
  } = useEquationDraft(dice);
  const [solved, setSolved] = useState(false);
  const [showSuccess, setShowSuccess] = useState(false);
  // The whole post-solve celebration — rocket, results-ready hand-off and the
  // award queue — lives in @/game-flow usePostSolveCelebration, where it has a
  // suite. Game.jsx keeps only `showSuccess`, which has three non-celebration
  // openers (forfeit, timeout reveal, today's-stats recap) the hook must not own.
  const celebration = usePostSolveCelebration({ onAwardsComplete: () => setShowSuccess(true) });
  // The store review card (2026-10-20): armed by a server-accepted Daily win in
  // handleSubmit, fired once the results screen is calm — never over the rocket,
  // a badge pop-up, or the ad the "next Daily" buttons open after the results.
  const [reviewArmed, setReviewArmed] = useState(false);
  useDailyWinReviewPrompt({
    armed: reviewArmed,
    resultsOpen: showSuccess,
    celebrating: celebration.overlayProps.showRocket || celebration.pendingCount > 0,
    onDone: () => setReviewArmed(false),
  });
  const [diceRolled, setDiceRolled] = useState(false);
  const [shakeButton, setShakeButton] = useState(false);
  const [showTryAgain, setShowTryAgain] = useState(false);
  const [showColorRuleError, setShowColorRuleError] = useState(false);
  // The instance the screen is currently about. Keyed on the TIER's Daily, not on
  // `mode`, so the launcher can show a tier's Daily state while the player is
  // looking at that tier's Practice round.
  const dc = dailyByMode[switchRound(mode, 'daily')] || dcChallenge;
  // WHICH board the leaderboard reads. Always a Daily key: practice rounds write
  // no leaderboard row, so while the player is on a practice screen the board
  // shown is still that tier's Daily.
  const boardMode = switchRound(mode, 'daily');
  // Derived aliases — keeps the JSX body using the same names it used
  // before the hook extraction. Read-only; writes go through dc methods.
  const dailyChallengeForfeited = dc.status === 'forfeited';
  const dailyChallengeTimer = dc.elapsedSeconds;
  const dailyChallengeStartTime = dc.startedAt;
  const showDailyChallengeGame = dc.showGame;

  // WHEN THE PRACTICE BOARD BECAME PLAYABLE. The Daily has `dc.startedAt`;
  // practice had nothing, so its solve time was written as a literal 0 — the
  // fastest possible value — on all 822 production rows. A ref, not state:
  // handleSubmit reads it at call time and it must never re-render the board.
  // `null` means "not measurable" (a rehydrated board, a mode switch) and is
  // written through as null, never coerced to 0. See @/game-flow solveClock.
  const practiceStartedAtRef = React.useRef(null);

  // Blocks a double-tap re-entering handleSubmit while it awaits the leaderboard
  // write — `solved` cannot guard that window, it is not set until after (Sentry
  // 37-THE-MATH-PUZZLE-2F; docs/bugs.md 2026-09-30).
  const isSubmittingRef = React.useRef(false);

  const [showCompactGame, setShowCompactGame] = useState(false);
  // home-condense H2 — the light Easy/Challenge pre-game modal (shown on rolls
  // AFTER the one-time forced how-to; carries the "?" reopen + Start).
  const [showPlayWarning, setShowPlayWarning] = useState(false);

  const [finalSolveTime, setFinalSolveTime] = useState(null);
  const [modalDisplayData, setModalDisplayData] = useState(null);

  // Autosave's 5-second throttle stamp.
  const lastSaveTime = React.useRef(0);

  // Save game state to user
  const saveGameState = useCallback(async (updatedStats, gameState) => {
    if (!user) return;

    try {
      await apiClient.auth.updateMe({
        game_stats: updatedStats,
        active_game: gameState
      });

      // Sync to public profile
      // Fetch fresh user data to ensure we have the latest metadata (like country)
      const freshUser = await apiClient.auth.me();
      const userToSync = freshUser ? { ...freshUser, game_stats: updatedStats } : { ...user, game_stats: updatedStats };
      await syncPublicProfile(userToSync);
    } catch (error) {
      console.error('Failed to save game state:', error);
    }
  }, [user]);

  // Auto-save when state changes (debounced to prevent excessive saves)
  useEffect(() => {
    // CRITICAL: Only save after stats have been loaded from server
    // OPTIMIZATION: Only save on meaningful changes (solved puzzle, mode switch)
    if (user && statsLoaded) {
      const now = Date.now();
      // Only save once every 5 seconds to prevent excessive API calls
      if (now - lastSaveTime.current < 5000) {
        return;
      }
      lastSaveTime.current = now;

      const gameState = {
        dice,
        diceColors,
        equation,
        usedDiceIndices,
        solved,
        diceRolled,
        mode
      };

      saveGameState(stats, gameState);
    }
  }, [stats, solved, mode, user, statsLoaded, saveGameState]); // Only save on solved/mode change, not every keystroke

  // Daily mode is now server-controlled - no client-side persistence



  const handleDiceClick = useCallback((index) => {
    if (solved) return;
    clickDie(index);
  }, [solved, clickDie]);

  const handleOperatorClick = useCallback((operator) => {
    if (solved) return;
    // Invalid operator insertions are rejected by the draft reducer; the shake
    // feedback lived on the old inline builder (removed). The in-play overlay
    // surfaces failures via its own Submit-button shake + "try again" copy.
    insertOperator(operator);
  }, [solved, insertOperator]);

  const handleDelete = useCallback(() => {
    if (solved) return;
    deleteAtCursor();
  }, [solved, deleteAtCursor]);

  const handleClear = useCallback(() => {
    clearDraft();
  }, [clearDraft]);

  const handleSubmit = useCallback(async () => {
    const diceValues = dice.map(d => d.value);
    const { valid, result } = evaluateEquation(equation, usedDiceIndices, diceValues);

    // Defense in depth: never accept a submit with a resting structural error
    // (e.g. touching dice), which `valid` alone does not catch.
    if (collectDraftErrors(equation, usedDiceIndices).length > 0) return;

    const warp = isDaily(mode) && mirror.canWarp({ valid, result, usedDiceIndices }); // a real, ranked solve
    if (valid && (result === 37 || warp) && usedDiceIndices.length === 7) {
      if (isSubmittingRef.current) return;
      isSubmittingRef.current = true;

      // In CHALLENGE MODE and DAILY MODE, validate Power Dice usage
      if (!warp && hasPowerDice(mode) && !validateChallengeModeRules(equation, usedDiceIndices, diceValues, diceColors, mode)) {
        isSubmittingRef.current = false;
        triggerPowerDiceShake({ setShakeButton, setShowTryAgain, setShowColorRuleError });
        return;
      }

      // Feature T: measure device elapsed ms ONCE so the displayed time and the
      // submitted device_time_ms match. The `: 0` this replaced was the practice
      // branch, and that zero was written to practice_solves as a measurement —
      // see @/game-flow solveClock for why null is the honest value and what it
      // cost (the Lightning Divide rung cannot light from a practice solve).
      const { deviceElapsedMs, solveTimeSeconds } = measureSolve({
        startedAt: isTimed(mode) ? dailyChallengeStartTime : practiceStartedAtRef.current,
      });

      // Whether the SERVER accepted this solve; null for practice (no referee).
      let submitOutcome = null;

      // For daily/easy/challenge mode: close full-screen game and prepare for success modal
      if (isDaily(mode)) {
        setFinalSolveTime(solveTimeSeconds);

        // ANTI-SPOOF (W4-HIGH). `mode` MUST be named — omitting it writes an
        // Easy/Expert solve onto Challenge's board (dailyChallenge.js:41). The
        // submit, the row check and the alarm decision are all in @/game-flow
        // leaderboardSubmit; its header is the canonical account of why.
        submitOutcome = await submitAndReportDailyTime({
          mode: boardMode,
          equation,
          usedDiceIndices,
          diceColors,
          shuffledDice: dice.map(d => d.value),
          deviceTimeMs: deviceElapsedMs,
          userId: user?.id,
          date: todayET(),
        });
        if (warp && !submitOutcome?.saved) { isSubmittingRef.current = false; mirror.recheck(); return; } // refused: keep playing

        // A Daily WIN the server accepted: count it toward the store review
        // card and arm the card for this results screen. useDailyWinReviewPrompt
        // (below) decides when — after the rocket and every badge pop-up.
        if (submitOutcome?.saved === true) {
          noteDailyWin();
          setReviewArmed(true);
        }

        // Secondary validation + status flip + showGame=false. Fire-and-forget.
        dc.submit({
          solveTimeSeconds,
          equation,
          usedDiceIndices,
          diceColors,
          shuffledDice: dice.map(d => d.value),
        });
      } else if (isPractice(mode)) {
        setShowCompactGame(false);

        // Durable record of the practice solve so easySolved/challengeSolved can
        // be DERIVED by counting rows (see @/practice-solves) instead of relying
        // on the hand-incremented blob counter a backend migration dropped.
        // Fire-and-forget — a stats write must never block the win celebration.
        recordPracticeSolve({
          user,
          mode,
          date: todayET(),
          equation,
          usedDiceIndices,
          diceColors,
          shuffledDice: dice.map(d => d.value),
          solveTimeSeconds,
        });
      }

      // Run the solve through the stats ledger. `prev` comes from the REF, not
      // from a setStats updater: the updater form only runs eagerly when nothing
      // else is pending on the fiber, and something always is by this line — so
      // every "captured" value was still null when the celebration read it. See
      // @/game-flow recordSolveLedger for the measurement.
      const ledger = recordSolveLedger({
        setStats, prev: statsRef.current,
        mode, solveTimeSeconds, equation, usedDiceIndices, usedDiceIds,
        diceColors: warp ? mirror.asWhite(diceColors) : diceColors, dice, today: todayET(), yesterday: yesterdayET(),
      });

      setSolved(true);
      isSubmittingRef.current = false;

      // Win celebration, PHASE ONE: only what is known locally, so the rocket
      // launches instantly. persistSolveOutcome settles the server-derived
      // points and badges into the queue behind it (@/game-flow solveCompletion).
      if (warp) mirror.start(); else celebration.begin({ // a warp's celebration IS the Mirror transition
        prev: ledger.prev, userId: user?.id, // whose announced-record (per account)
        updated: ledger.updated,
        // `boardMode`, not `mode`: the Piece rule is about which DAILY was
        // played, and a practice round earns nothing either way.
        points: provisionalPoints(knownPointsRef, ledger.isPerfect, {
          mode: isDaily(mode) ? boardMode : mode, solveTimeSeconds,
        }),
      });
      if (!warp) setShowSuccess(true);

      // Save → re-read → re-derive → settle. Fire-and-forget: a stats write must
      // never block the win celebration. GATED on `saved` for a daily: this used to write the blob whatever the
      // server said, so the page could durably record a solve the database
      // refused (delaney-37). Never on the raw response, and the celebration is
      // deliberately NOT gated — gameDailySubmitMode.test.js says why.
      const serverHasTheSolve = !isDaily(mode) || submitOutcome?.saved === true;
      if (serverHasTheSolve) {
        persistSolveOutcome({ user, ledger, mode, celebration, setUser, setStats, setPuzzlePoints, knownPointsRef });
      }
    }
  }, [equation, usedDiceIndices, mode, dice, user, mirror]);

  // Switch the launcher's mode. Both axes funnel through one function because
  // the two together are ONE wire key — a tier change keeps the round and a
  // round change keeps the tier (see @/game-flow switchTier / switchRound).
  // Resets an in-play unsolved streak, then clears the board back to the
  // launcher for the chosen mode.
  const handleSelectModeKey = useCallback((nextMode) => {
    if (nextMode === mode) return;
    if (diceRolled && !solved) {
      setStats(prev => ({ ...prev, currentStreak: 0 }));
    }
    playSound('buttonTap');
    setMode(nextMode);
    // The stamp belonged to the abandoned board. Clearing it means a solve that
    // somehow reaches handleSubmit without a roll records `null` — not a wildly
    // long "time" measured from a round the player walked away from.
    practiceStartedAtRef.current = null;
    setDiceRolled(false);
    clearDraft();
    setSolved(false);
  }, [mode, diceRolled, solved, clearDraft]);

  // The actual roll action — NO first-run gate, NO pre-game modal. Daily runs its
  // interstitial→warning flow; easy/challenge roll straight into the compact game.
  // Shared by enterStartScreen (post-modal for daily) and the PlayStartModal Start.
  const doRoll = useCallback(async () => {
    // Update games played count
    setStats(prev => ({
      ...prev,
      totalGamesPlayed: prev.totalGamesPlayed + 1
    }));

    // For daily challenge mode, show interstitial ad then warning. The
    // shell's showInterstitial() handles the platform check, dismiss
    // listener lifecycle, and fail-open behaviour — on web (or if the ad
    // fails to show), onDismissed fires immediately.
    if (isDaily(mode)) {
      await showInterstitial({ onDismissed: () => dc.openStartWarning() });
      return;
    }

    // For other modes
    setDice(generateDailyDice());

    setDiceColors(getDiceColors(mode));

    setDiceRolled(true);

    // Show compact game view for easy and challenge mode
    if (isPractice(mode)) {
      playSound('shorterDiceRoll');
      // The board is playable from HERE — the practice round's start of clock.
      practiceStartedAtRef.current = Date.now();
      setShowCompactGame(true);
    }
  }, [mode]);

  // Enter the mode's pre-game start screen — the "already seen" path. Easy/Challenge
  // show the light PlayStartModal (carries the "?" reopen + Start); Daily/Blitz run
  // their own interstitial→ChallengeWarningModal via doRoll. No dice roll ever
  // happens straight off the how-to.
  const enterStartScreen = useCallback(() => {
    if (isPractice(mode)) {
      setShowPlayWarning(true);
      return;
    }
    doRoll();
  }, [mode, doRoll]);

  // Roll Dice / Start entry point. home-condense H2 + occlusion Slice 3:
  //  1. FIRST roll of a mode (!getSeen) → open the forced-scroll how-to IN PLACE
  //     (no navigation). Its "Got it — continue" (onComplete) marks the mode seen
  //     and drops the player onto that mode's pre-game start screen — never an
  //     auto-roll. The back arrow closes without marking seen (re-gates next time).
  //  2. Already seen → straight to the pre-game start screen (enterStartScreen).
  const handleRollDice = useCallback(() => {
    // A live Daily is EXCLUSIVE. If another mode's clock is already running,
    // entering this one would start a second timer against the same wall clock
    // and at least one of the two solve times would be wrong. Send the player
    // back to the attempt they are actually inside instead — the only ways out
    // of it are solving it or the existing forfeit path.
    if (liveDailyMode && liveDailyMode !== mode) {
      playSound('buttonTap');
      setMode(liveDailyMode);
      return;
    }
    if (!getSeen(mode)) {
      openHowTo(mode, {
        context: 'first-run',
        requireScroll: true,
        onComplete: () => { markSeen(mode); enterStartScreen(); },
      });
      return;
    }
    enterStartScreen();
  }, [mode, openHowTo, enterStartScreen, liveDailyMode]);

  // F: from a win/forfeit screen's Daily buttons, jump to that mode's pre-game
  // start screen. Tear down the daily/success state, switch the mode, then enter
  // via enterPreGameScreen — a Daily plays its interstitial FIRST (it used to skip
  // it, 2026-09-29). Honors the first-run forced how-to gate, like handleRollDice.
  // setMode batches with the practice setShowPlayWarning, so it opens on the new mode.
  const handlePlayMode = useCallback((targetMode) => {
    const enterPreGame = (m) => enterPreGameScreen(m, { showAd: showInterstitial, dailyByMode, openPracticeStart: () => setShowPlayWarning(true) });
    setShowSuccess(false);
    setModalDisplayData(null);
    setDiceRolled(false);
    clearDraft();
    setSolved(false);
    if (isDaily(mode)) dc.reset();
    setShowCompactGame(false);
    setMode(targetMode);
    if (!getSeen(targetMode)) {
      openHowTo(targetMode, {
        context: 'first-run',
        requireScroll: true,
        onComplete: () => { markSeen(targetMode); enterPreGame(targetMode); },
      });
      return;
    }
    enterPreGame(targetMode);
  }, [mode, dc, dailyByMode, clearDraft, openHowTo]);

  // Apply the game-side board state (dice / colors / diceRolled / draft) after
  // the hook hands back today's dice — shared by start + recovery-resume.
  const enterDailyGame = (finalDice) => {
    setDice(finalDice);
    // Was an unconditional POWER_DICE_COLORS. Correct while 'daily' was the only
    // timed round; the moment daily_easy exists it would paint power colours onto
    // all-white Easy dice. Ask the one helper instead of assuming.
    setDiceColors(getDiceColors(mode));
    setDiceRolled(true);
    clearDraft();
  };

  // Start a fresh daily (pre-check + start + dice fetch live in dc.start()).
  const startDailyChallenge = async () => {
    const { ok, dice: finalDice } = await dc.start();
    // `ok: false` with reason 'no_puzzle' means this mode has no
    // daily_challenges row for today. The hook has already refused WITHOUT
    // creating an attempt, so the player's one shot at this mode is intact; it
    // has also set dc.puzzleMissing, which re-renders the entry button into its
    // disabled "Today's puzzle isn't ready" state. Nothing else to do here —
    // deliberately NOT entering the board on locally-rolled dice.
    if (ok) enterDailyGame(finalDice);
  };

  // "Continue Daily" — resume a recoverable (interrupted) attempt with the
  // correct elapsed time: no ad/warning gate (already agreed on the original
  // start), no new row, no forfeit. See useDailyChallengeAttempt.resumeRecovered.
  const handleContinueDaily = async () => {
    const { ok, dice: finalDice } = await dc.resumeRecovered();
    if (ok) enterDailyGame(finalDice);
  };

  // Android hardware-back guard (screen lockdown): on native, hardware Back
  // during a live daily opens the forfeit confirm instead of abandoning it.
  useDailyBackGuard(isDaily(mode) && showDailyChallengeGame, dc.openExitWarning);

  // Dice, their POSITIONAL colours and the draft's board indices must all move
  // together — see @/game-flow shuffleBoard for why each of the three matters.
  const handleShuffle = useCallback(() => {
    playSound('swosh');
    const next = shuffleBoard({ dice, diceColors });
    setDice(next.dice);
    setDiceColors(next.diceColors);
    remapDiceReferences(next.indexMap);
  }, [dice, diceColors, remapDiceReferences]);

  const handleNewGame = useCallback(async () => {
    // Reset streak if rolling new dice without solving current puzzle
    if (diceRolled && !solved) {
      setStats(prev => ({
        ...prev,
        currentStreak: 0,
        totalGamesPlayed: prev.totalGamesPlayed + 1
      }));
    } else {
      // Update games played count
      setStats(prev => ({
        ...prev,
        totalGamesPlayed: prev.totalGamesPlayed + 1
      }));
    }

    // For daily challenge mode, fetch today's dice (with caching).
    // The hook owns the cache + DB create-if-missing fallback.
    if (isDaily(mode)) {
      const todaysDice = await dc.fetchTodaysDice();
      setDice(todaysDice);
    } else {
      setDice(generateDailyDice());
    }

    setDiceColors(getDiceColors(mode));

    clearDraft();
    setSolved(false);
    setShowSuccess(false);

    // Keep compact game view open for easy/challenge modes when coming from success modal
    if (isPractice(mode)) {
      // Fresh dice = a fresh round = a fresh clock. Without this the second and
      // every later practice round in a session would measure from the first.
      practiceStartedAtRef.current = Date.now();
      setShowCompactGame(true);
    }
  }, [mode, diceRolled, solved]);



  // `valid` feeds the "clear error message when the equation becomes valid"
  // effect below. Submit gating (canSubmit / challenge-rule / draft-error checks)
  // now lives in the in-play overlay (DailyChallengeGame), which owns its own
  // derivation — the home screen no longer renders a board.
  const { valid } = evaluateEquation(equation, usedDiceIndices, dice.map(d => d.value));

  // Clear error messages when equation becomes valid
  useEffect(() => {
    if (valid || equation === '') {
      setShowTryAgain(false);
      setShowColorRuleError(false);
    }
  }, [equation, valid]);

  // Slice D — 1-hour timeout reveal. When the hook flips `timedOut`, it has
  // already run the forfeit path (edge call + status→forfeited + timer reset).
  // Game.jsx's only job is the UI side: clear the board and open SuccessModal,
  // which (forfeited daily) reveals today's valid + perfect solutions — the same
  // solve-reveal as the voluntary "Forfeit & See Solves" exit.
  useEffect(() => {
    if (!dc.timedOut) return;
    setDiceRolled(false);
    clearDraft();
    setSolved(false);
    setShowSuccess(true);
  }, [dc.timedOut, clearDraft]);

  // ── Public surface (new in slice 1b; Game.jsx does not use these) ──────────
  // Is ANY part of the round on screen: the board, the start / exit / play
  // warning, the results, or the rocket / award queue. False = the launcher.
  const surfaceUp = Boolean(
    (isDaily(mode) && showDailyChallengeGame) || (isPractice(mode) && showCompactGame)
    || dc.showStartWarning || dc.showExitWarning || showPlayWarning || showSuccess
    || celebration.overlayProps.showRocket || celebration.pendingCount > 0,
  );

  // "Today's Solve" recap → the results card. The host owns the leaderboard,
  // so it sets that itself; these are the round-side writes.
  const openRecap = (recap) => {
    setUser(recap.freshUser);
    setStats(prev => preservePerMode(recap.freshStats, prev));
    if (recap.displayData) setModalDisplayData(recap.displayData);
    setShowSuccess(true);
  };

  // Back to the launcher with nothing on screen — the results card's Home with
  // no target mode.
  const resetBoard = () => {
    setShowSuccess(false);
    celebration.reset();
    setModalDisplayData(null);
    setDiceRolled(false);
    clearDraft();
    setSolved(false);
    if (isDaily(mode)) dc.reset();
    setShowCompactGame(false);
  };

  // Everything RoundStage's (moved) JSX reads, under the names it reads them by.
  const stageProps = {
    mode, setMode, dc, boardMode, statusByMode, openHowTo,
    dice, setDice, diceColors, setDiceColors,
    equation, usedDiceIndices, cursorPosition, setCursor, clearDraft,
    solved, setSolved, setDiceRolled,
    showDailyChallengeGame, dailyChallengeTimer, dailyChallengeForfeited,
    showCompactGame, setShowCompactGame, showPlayWarning, setShowPlayWarning,
    showSuccess, setShowSuccess, celebration, modalDisplayData, setModalDisplayData, finalSolveTime,
    showColorRuleError, shakeButton, showTryAgain,
    handleDiceClick, handleOperatorClick, handleDelete, handleClear, handleSubmit,
    handleShuffle, handleNewGame, handlePlayMode, startDailyChallenge, doRoll,
    sector73Mirror: mirror.board, // what the Daily board does with a 73 ('open' | 'used' | 'off')
  };

  return {
    dice, solved, diceRolled, showCompactGame, showPlayWarning, showSuccess,
    dc, boardMode, celebration, surfaceUp,
    handleRollDice, handleContinueDaily, selectModeKey: handleSelectModeKey,
    openRecap, resetBoard, stageProps,
  };
}
