
import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { UserPlus, UserCheck, Clock, Trash2, Users } from 'lucide-react';
import { Link, useSearchParams } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';
import ProfileBackButton from './ProfileBackButton';
import { apiClient } from '@/transport';
import { getPlayerStats, currentWeekSolves, countPuzzlePointsFromTimes, getCraftBadgeState, getBlitzBadgeState, getExistingBadgeState } from '@/stats-aggregation';
import { startOfWeekET, todayET, canViewerSeeToday } from '@/daily-challenge';
import StreakCard from '@/components/stats/StreakCard';
import {
  readPerModeStats, solveCountsByMode, filterByMode,
  dailyModeLabel, dailyModeAccent, dailyModeFullLabel, dailyModeTheme,
} from '@/components/stats/dailyModeStats';
import { DAILY_MODE_KEYS } from '@/game-modes';
import StatsLoadError from '@/components/stats/StatsLoadError';
// Badge System Redesign (Lane H) — the SAME L1 teaser Statistics mounts. It is
// presentational and player-agnostic, so this page only has to resolve WHO is
// being viewed and hand over their merged badge state.
import FeaturedBadges from '@/components/stats/FeaturedBadges';
import { buildBadgeStateIndex } from '@/components/stats/badgeShowcaseModel';
import { sendFriendRequest, acceptFriendRequest, removeFriend, getFriendEdges, deriveFriendStatus, getProfileById } from '@/player';
import { useNotifications } from '@/notifications';
import { CreateChallenge } from '@/head-to-head';
import { PlayerBadges, FastestSolveCard, TotalSolvedCard, WeeklyDailyChallenges, ViewBlitzStats, ChallengeBattleCard } from '@/components/profile';
import { countryName } from '@/components/profile/countryName';
import { playSound } from '@/ui/feedback';
import { reportedFallback } from '@/observability';

export default function OtherProfile() {
  const [profileUser, setProfileUser] = useState(null);
  const [currentUser, setCurrentUser] = useState(null);
  const [loading, setLoading] = useState(true);
  // loadError: the player-stats edge call hard-failed (vs. a profile that
  // legitimately has only static stats). Drives the StatsLoadError card so a
  // backend outage shows an error instead of stale/empty numbers.
  const [loadError, setLoadError] = useState(false);
  const [reloadKey, setReloadKey] = useState(0);
  const [friendStatus, setFriendStatus] = useState('none'); // none, pending, friends
  const [showCreateChallenge, setShowCreateChallenge] = useState(false);

  const [battleMode, setBattleMode] = useState(null);
  const [puzzlePoints, setPuzzlePoints] = useState(0);
  const [battlePoints, setBattlePoints] = useState(0);
  // D8 — the gate is PER MODE, and it is a record rather than a boolean.
  // Mode-blind, completing Challenge revealed this player's Easy AND Expert
  // solutions for today: the cross-player leak the gate exists to stop.
  const [viewerCanSeeTodayByMode, setViewerCanSeeTodayByMode] = useState(
    /** @type {Record<string, boolean>} */({}),
  );
  // Which Daily this profile's Daily-stats card is showing.
  const [dailyMode, setDailyMode] = useState('daily');
  // Authoritative per-day completions (from daily_challenge_times) that the
  // weekly list derives from instead of the drift-prone dailyChallengeSolutions
  // blob — which could leave a long-streak player showing only today. See
  // currentWeekSolves.
  const [dailyTimes, setDailyTimes] = useState([]);
  // The VIEWED player's merged badge state (Lane B craft + Lane D Blitz), keyed
  // by registry badge id — what FeaturedBadges renders.
  const [badgeState, setBadgeState] = useState(/** @type {Record<string, any>} */({}));
  const [badgesLoading, setBadgesLoading] = useState(true);
  const { addNotification } = useNotifications();
  const [searchParams] = useSearchParams();
  // Read HERE, not inside the effect, so it can be a dependency. The effect used
  // to depend only on [reloadKey] while reading this, so a route that swapped
  // ?id without unmounting kept the previous player's data on screen.
  const idParam = searchParams.get('id');

  useEffect(() => {
    const loadProfile = async () => {
      try {
        setLoadError(false);

        if (!idParam) {
          setLoading(false);
          return;
        }

        const current = await apiClient.auth.me();

        // Authoritative per-day completions (weekly list + puzzle-points). Non-fatal.
        let profileTimes = [];
        try {
          const times = await apiClient.entities.DailyChallengeTime.filter({ user_id: idParam });
          // `daily_challenge_times` has no `time` column — DAILY_TIME_PUBLIC_COLUMNS
          // selects `solve_time_seconds` — and the entity client returns raw
          // PostgREST rows. Every consumer below wants `time`, so map it HERE,
          // once, exactly as Statistics.jsx:191 already does for the own-stats
          // page. Passing raw rows on is what made FastestSolveCard render
          // "NaN:NaN.NaN" for every player from 2026-08-26 to 2026-09-10.
          profileTimes = (Array.isArray(times) ? times : [])
            .map(t => ({ ...t, time: t.solve_time_seconds }));
          setDailyTimes(profileTimes);
        } catch (e) { console.error('Error fetching daily_challenge_times for profile', e); }

        // CANONICAL SOURCE: Fetch from PublicProfile (replacing broken Edge Function)
        let profileData = null;

        try {
          profileData = await getProfileById(idParam);
        } catch (e) { console.error('Error fetching by ID', e); }

        if (profileData) {
          let edgePuzzlePoints; // server-computed puzzle points, if the edge provides them
          // Prefer the dynamic Edge Function for the freshest stats/profile data.
          const dynamicResult = await getPlayerStats(profileData.id);
          if (dynamicResult.success && dynamicResult.data?.game_stats) {
            const dynamicData = dynamicResult.data;
            profileData.game_stats = dynamicData.game_stats;
            profileData.username = dynamicData.username || profileData.username;
            profileData.country = dynamicData.country || profileData.country;
            profileData.has_custom_username = dynamicData.has_custom_username ?? profileData.has_custom_username;
            if (dynamicData.puzzle_points !== undefined) { edgePuzzlePoints = dynamicData.puzzle_points; setPuzzlePoints(dynamicData.puzzle_points); }
            if (dynamicData.battle_points !== undefined) setBattlePoints(dynamicData.battle_points);
          } else if (!dynamicResult.success && 'error' in dynamicResult) {
            // Hard backend failure (e.g. a dead edge-function key) — surface an
            // error rather than falling through to stale static numbers.
            // (`'error' in` narrows the EdgeCallResult union to the failure shape.)
            console.error('Failed to fetch dynamic stats for OtherProfile:', dynamicResult.error);
            setLoadError(true);
          }

          // Fallback to static DB stats if Edge Function failed or returned nothing
          if (profileData.stats && !profileData.game_stats) {
            // syncPublicProfile writes snake_case keys; OtherProfile reads camelCase — remap them.
            // `per_mode` is deliberately NOT remapped: its INNER keys are snake too
            // (current_streak, avg_time…) and readPerModeStats reads camel, so a direct
            // map would claim tracked:true with every field but `solved` zeroed. Honest
            // "not tracked yet" beats a confident wrong number — pinned in dailyModeStats.test.
            const s = profileData.stats;
            profileData.game_stats = {
              totalSolved: s.total_solved ?? s.totalSolved ?? 0,
              dailyChallengeStreak: s.daily_challenge_streak ?? s.dailyChallengeStreak ?? 0,
              longestDailyChallengeStreak: s.longest_daily_streak ?? s.longestDailyChallengeStreak ?? 0,
              bestStreak: s.best_streak ?? s.bestStreak ?? 0,
              podiumFinishes: s.podium_finishes ?? s.podiumFinishes ?? { first: 0, second: 0, third: 0 },
              timeMilestones: s.time_milestones ?? s.timeMilestones ?? {},
              fastestTimeMilestones: s.fastest_time_milestones ?? s.fastestTimeMilestones ?? {},
              reachedMilestones: s.reached_milestones ?? s.reachedMilestones ?? [],
              dailyChallengeTimes: s.daily_challenge_times ?? s.dailyChallengeTimes ?? [],
              dailyChallengeSolutions: s.daily_challenge_solutions ?? s.dailyChallengeSolutions ?? [],
              perfectStreakMilestones: s.perfect_streak_milestones ?? s.perfectStreakMilestones ?? {}
            };
          }

          setProfileUser(profileData);
          setCurrentUser(current);

          // Determine if VIEWER has completed today's challenge (to allow seeing profile's equations)
          const todayCheck = todayET();
          try {
            const gates = await Promise.all(
              DAILY_MODE_KEYS.map(k => canViewerSeeToday(current, todayCheck, k)),
            );
            setViewerCanSeeTodayByMode(
              Object.fromEntries(DAILY_MODE_KEYS.map((k, i) => [k, gates[i] === true])),
            );
          } catch (err) {
            console.error('Failed to check viewer status in OtherProfile:', err);
            // Fail CLOSED in every mode. An errored gate must never become an
            // unlock — that is the shape of the bug this gate already had once.
            setViewerCanSeeTodayByMode({});
          }

          // Hydrate has_custom_username if it's missing (profiles table doesn't have it natively)
          // A user has a custom username if their username doesn't start with "Guest"
          if (profileData.has_custom_username === undefined && profileData.username) {
            profileData.has_custom_username = !profileData.username.startsWith('Guest');
          }

          // Puzzle points: trust the edge value; else derive from authoritative
          // times. (Old fallback gated on not-yet-updated state → always clobbered.)
          if (edgePuzzlePoints === undefined) {
            setPuzzlePoints(countPuzzlePointsFromTimes(profileTimes));
          }

          // Determine friend status from the one friend-edge read path
          const edges = await getFriendEdges(current.id);
          setFriendStatus(deriveFriendStatus(edges, current.id, profileData.id));
        }
      } catch (error) {
        console.error('Failed to load profile:', error);
        setLoadError(true);
      } finally {
        setLoading(false);
      }
    };

    loadProfile();
  }, [reloadKey, idParam]);

  // Badge System Redesign (Lane H) — derive the VIEWED player's badge state for
  // the L1 teaser on this card. Both derivations take a userId, and RLS lets any
  // player read another's badge sources, so the same fetch pair Statistics and
  // /Badges use works unchanged here.
  //
  // It runs off `profileUser` (not the raw `?id=`) so it can hand Lane D the
  // `game_stats` blob the profile load already fetched — that skips a second
  // get-player-stats edge call for the solo-Blitz half.
  //
  // NO CELEBRATION IS EVER PLANNED HERE. Pops belong to the signed-in player;
  // this page only ever shows someone else, so seeing their badges must stay
  // silent (Statistics gates its announcement on `isOwnStats` for the same
  // reason — here the answer is always "no").
  useEffect(() => {
    const targetId = profileUser?.id;
    if (!targetId) return undefined;
    let cancelled = false;

    const loadBadges = async () => {
      setBadgesLoading(true);
      try {
        // Degrade to "nothing earned" rather than an error: an unlit catalog on
        // someone's profile is a far better failure than a broken card.
        const [craft, blitz, existing] = await Promise.all([
          getCraftBadgeState(targetId).catch(reportedFallback('profile.badges.craft')),
          getBlitzBadgeState(targetId, { gameStats: profileUser?.game_stats ?? null }).catch(reportedFallback('profile.badges.blitz')),
          getExistingBadgeState(targetId).catch(reportedFallback('profile.badges.existing')),
        ]);
        if (cancelled) return;
        setBadgeState(buildBadgeStateIndex(craft, blitz, existing));
      } finally {
        if (!cancelled) setBadgesLoading(false);
      }
    };

    loadBadges();
    return () => { cancelled = true; };
  }, [profileUser?.id]);

  const handleSendFriendRequest = async () => {
    try {
      // Pass IDs to helper
      await sendFriendRequest(currentUser.id, profileUser.id);
      setFriendStatus('pending');

      addNotification({
        type: 'request',
        title: 'Friend Request Sent!',
        message: `Request sent to ${profileUser.username}`
      });
    } catch (error) {
      console.error('[SEND REQUEST ERROR]', error);
      addNotification({
        type: 'error',
        title: 'Error',
        message: error.message || 'Failed to send friend request'
      });
    }
  };

  const handleAcceptFriendRequest = async () => {
    try {
      await acceptFriendRequest(profileUser.id);
      setFriendStatus('friends');

      // Update local friend list if needed, or rely on reload
      // For now, just update status

      addNotification({
        type: 'success',
        title: 'Friend Request Accepted!',
        message: `You are now friends with ${profileUser.username}`
      });
    } catch (error) {
      console.error('[ACCEPT REQUEST ERROR]', error);
      addNotification({
        type: 'error',
        title: 'Error',
        message: error.message || 'Failed to accept friend request'
      });
    }
  };

  const handleRemoveFriend = async () => {
    try {
      // Remove the friend_connections edge (id-based) — the real friendship
      // source of truth, matching FriendsList. (Was a legacy currentUser.friends
      // email-array edit, which no longer works once profiles.email is dropped.)
      await removeFriend(profileUser.id);
      setFriendStatus('none');

      addNotification({
        type: 'success',
        title: 'Friend Removed',
        message: `${profileUser.username} removed from friends`
      });
    } catch (error) {
      console.error('[REMOVE FRIEND ERROR]', error);
      addNotification({
        type: 'error',
        title: 'Error',
        message: error.message || 'Failed to remove friend'
      });
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-white text-xl">Loading...</div>
      </div>
    );
  }

  if (loadError) {
    return (
      <div className="min-h-screen px-4 pt-[60px]">
        <StatsLoadError onRetry={() => setReloadKey(k => k + 1)} viewingOther />
      </div>
    );
  }

  if (!profileUser) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-white text-xl">User not found</div>
      </div>
    );
  }

  // Guest users don't have public profiles
  if (!profileUser.username) {
    return (
      <div className="min-h-screen flex items-center justify-center px-4">
        <div className="text-center max-w-md">
          <div className="text-6xl mb-4">👤</div>
          <h2 className="text-2xl font-bold text-white mb-2">Guest User</h2>
          <p className="text-slate-400">This user hasn't created a custom username yet and doesn't have a public profile.</p>
        </div>
      </div>
    );
  }

  // Extract stats from canonical source (User.game_stats)
  const stats = profileUser?.game_stats || null;
  const today = todayET();

  // Filter solutions to show current week (Monday to today)
  const startOfWeek = startOfWeekET(); // Monday of the current week (ISO; correct on Sundays)
  // Authoritative per-day completions, enriched with equations from the blob.
  // Rows now carry their mode and sort Easy -> Challenge -> Expert within a date.
  const filteredSolutions = currentWeekSolves(dailyTimes, stats?.dailyChallengeSolutions, startOfWeek, today);

  // `perMode` is ABSENT on an old server and W2-BOARDS may not have merged —
  // readPerModeStats tolerates that, falling back to the legacy top-level fields
  // for Challenge's Daily and reporting the other two as untracked (not zero).
  const perMode = readPerModeStats(stats).byMode;
  const dailySolvesByMode = solveCountsByMode(dailyTimes).byMode;
  const modeTimes = filterByMode(dailyTimes, dailyMode).filter(t => !t.forfeited);

  // Helper function to colorize equation with AST-based validation

  // AdMob Banner Effect was moved to top of component (before early returns) to comply with Rules of Hooks

  return (
    <div className="app-page-shell relative">
      {/* Decorative bottom shadow/buffer bars removed (2026-06-29, FU-1): ad
          clearance is reserved by the calc(100vh-130px) scroll region below. */}
      <div className="app-page-scroll pt-[60px] scroll-edge-fade-bottom">
        <div className="max-w-2xl mx-auto px-4 pb-10">
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          className="flex items-center gap-4 mb-8"
        >
          <ProfileBackButton />
          <h1 className="text-2xl font-black bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400 
            bg-clip-text text-transparent">
            Player Profile
          </h1>
        </motion.div>

        {/* Profile Header */}
        <motion.div
          initial={{ opacity: 0, scale: 0.95 }}
          animate={{ opacity: 1, scale: 1 }}
          className="rounded-2xl p-6 mb-6 bg-gradient-to-b from-slate-900 via-slate-900 to-indigo-950"
          style={{
            border: '2px solid',
            borderColor: '#10b981',
            borderRadius: '1rem'
          }}
        >
          <div className="flex flex-col gap-4 mb-4">
            <div className="flex items-center gap-3 sm:gap-4">
              <div className="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-br from-purple-500/50 to-pink-500/50 flex items-center justify-center border-2 border-purple-400/60 overflow-hidden flex-shrink-0">
                {profileUser.country ? (
                  <img
                    src={`https://flagcdn.com/w160/${profileUser.country?.toLowerCase()}.png`}
                    alt="Country flag"
                    className="w-full h-full object-cover"
                  />
                ) : (
                  <span className="text-3xl sm:text-4xl">❓</span>
                )}
              </div>
              <div>
                <div className="flex items-center gap-2 mb-1">
                  <h2 className="text-xl sm:text-2xl font-black text-slate-200 break-words">{profileUser.username}</h2>
                  <PlayerBadges
                    puzzlePoints={puzzlePoints}
                    battlePoints={battlePoints}
                    size="xl"
                  />
                </div>
                {profileUser.country && (
                  <p className="text-slate-400 text-xs sm:text-sm">
                    {countryName(profileUser.country)}
                  </p>
                )}
              </div>
            </div>

            {/* Friend Button */}
            {friendStatus === 'none' && (
              <Button
                onClick={handleSendFriendRequest}
                className="bg-emerald-600 hover:bg-emerald-700 min-h-[44px] touch-manipulation px-4"
              >
                <UserPlus className="w-4 h-4 mr-2" />
                Add Friend
              </Button>
            )}
            {friendStatus === 'pending' && (
              <Button disabled className="bg-slate-600 cursor-not-allowed min-h-[44px] px-4">
                <Clock className="w-4 h-4 mr-2" />
                Request Sent
              </Button>
            )}
            {friendStatus === 'incoming' && (
              <Button
                onClick={handleAcceptFriendRequest}
                className="bg-purple-600 hover:bg-purple-700 min-h-[44px] px-4"
              >
                <UserCheck className="w-4 h-4 mr-2" />
                Accept Request
              </Button>
            )}
            {friendStatus === 'friends' && (
              <div className="flex flex-col gap-2 w-full">
                <div className="flex items-center gap-2">
                  <div className="bg-emerald-600 min-h-[44px] touch-manipulation px-4 flex-1 rounded-md flex items-center justify-center">
                    <Users className="w-4 h-4 mr-2 text-green-400" />
                    <span className="text-white font-medium">Friends</span>
                  </div>
                  <button
                    onClick={() => {
                      playSound('buttonTap');
                      handleRemoveFriend();
                    }}
                    className="bg-gradient-to-r from-red-700 via-red-800 to-red-700 hover:from-red-800 hover:via-red-900 hover:to-red-800 p-2 rounded-md transition-colors min-h-[44px] flex items-center justify-center"
                  >
                    <Trash2 className="w-4 h-4 text-white" />
                  </button>
                </div>
                <div className="flex justify-center">
                  <Link
                    to={`${createPageUrl('Statistics')}?id=${profileUser.id}`}
                  >
                    <Button className="bg-gradient-to-r from-indigo-600 to-purple-700 hover:from-indigo-700 hover:to-purple-800 py-2 px-6 text-sm touch-manipulation font-semibold border border-purple-500/50 text-white"
                    >
                      <span className="text-base mr-1">📈</span>
                      View Full Stats
                    </Button>
                  </Link>
                </div>
              </div>
            )}
          </div>
        </motion.div>



        {/* Daily Challenge History - Current Week (extracted → WeeklyDailyChallenges) */}
        <WeeklyDailyChallenges
          solutions={filteredSolutions}
          today={today}
          viewerCanSeeTodayByMode={viewerCanSeeTodayByMode}
          perMode={perMode}
          mode={dailyMode}
          onModeChange={setDailyMode}
        />

        {/* Daily Challenge Stats - Combined Section */}
        <motion.div
          initial={{ opacity: 0, scale: 0.95 }}
          animate={{ opacity: 1, scale: 1 }}
          transition={{ delay: 0.1, duration: 0.5 }}
          className="bg-gradient-to-br from-purple-600/30 via-pink-600/30 to-orange-500/30 backdrop-blur rounded-2xl p-6 border-2 border-purple-400/50 mb-8 shadow-2xl shadow-purple-500/20"
        >
          <div className="w-full flex items-center mb-4">
            <div className="flex items-center gap-2 min-w-0">
              <span className="text-2xl flex-shrink-0">🎲</span>
              <span className="text-lg sm:text-xl font-black bg-gradient-to-r from-rose-200 via-pink-200 to-rose-200
                 bg-clip-text text-transparent truncate">
                Daily Challenge Stats
              </span>
            </div>
          </div>

          <div>
              {/* Streaks — ALL THREE (D4). Three independent streaks is a
                  headline fact, not a filter, so this row ignores the tabs below
                  it. Shared StreakCard so the palette matches the own-stats page
                  (both drive off getStreakStyles). (#5) */}
              <div
                role="group"
                aria-label="Choose which Daily these figures cover"
                className="grid grid-cols-3 gap-2 sm:gap-3 mb-4"
              >
                {DAILY_MODE_KEYS.map((key) => {
                  const m = perMode[key];
                  const isSelected = key === dailyMode;
                  const keyAccent = dailyModeAccent(key);
                  return (
                    <button
                      key={key}
                      type="button"
                      aria-pressed={isSelected}
                      data-testid="streak-mode-button"
                      data-mode-key={key}
                      data-selected={String(isSelected)}
                      onClick={() => setDailyMode(key)}
                      className={`min-h-[44px] rounded-xl sm:rounded-2xl transition-all duration-200
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-200/70
                        focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900
                        hover:-translate-y-0.5 active:translate-y-0
                        ${isSelected ? '' : 'opacity-80 hover:opacity-100'}`}
                      style={isSelected ? {
                        boxShadow: `0 0 0 2px color-mix(in srgb, ${keyAccent} 85%, transparent), 0 0 20px -8px ${keyAccent}`,
                      } : undefined}
                    >
                      <StreakCard
                        streak={m?.currentStreak ?? 0}
                        label={dailyModeLabel(key)}
                        sublabel={m?.longestStreak ? `Longest ${m.longestStreak}` : undefined}
                        accent={keyAccent}
                        tracked={m?.tracked === true}
                      />
                    </button>
                  );
                })}
              </div>

              {/* Fastest and total ARE per mode: they are per-day figures, and
                  Easy and Expert times are not commensurable. The cards
                  themselves are unchanged — they are simply handed rows and a
                  count that have already been scoped. */}
              <div data-mode={dailyModeTheme(dailyMode)} className="grid grid-cols-2 gap-3 sm:gap-4">
                {/* Fastest Solve */}
                <FastestSolveCard times={modeTimes} />

                {/* Total Solved */}
                <TotalSolvedCard count={dailySolvesByMode[dailyMode] || 0} />
              </div>
              <p
                data-mode={dailyModeTheme(dailyMode)}
                className="text-[10px] text-center mt-2 font-semibold"
                style={{ color: 'var(--u37-mode-accent)' }}
              >
                {dailyModeFullLabel(dailyMode)}
              </p>
            </div>
        </motion.div>

        {/* Guest User Notice for Blitz Battles */}
        {!currentUser?.has_custom_username && profileUser?.has_custom_username && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.15 }}
            className="mb-6 bg-amber-500/20 border-2 border-amber-400/50 rounded-2xl p-5 backdrop-blur"
          >
            <div className="text-center">
              <div className="text-4xl mb-3">🎮</div>
              <h3 className="text-lg font-bold text-amber-200 mb-2">Unlock Friend Blitz Battles!</h3>
              <p className="text-amber-100 text-sm mb-4">
                To challenge friends to Blitz Battles, you need to:
              </p>
              <ul className="text-left text-amber-100 text-sm space-y-1 mb-4 max-w-xs mx-auto">
                <li className="flex items-start gap-2">
                  <span className="text-amber-300">•</span>
                  <span>Create a custom username</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-amber-300">•</span>
                  <span>Send friend requests</span>
                </li>
              </ul>
              <Link to={createPageUrl('Game')}>
                <Button className="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 font-bold min-h-[48px] touch-manipulation">
                  Create Profile
                </Button>
              </Link>
            </div>
          </motion.div>
        )}

        {/* Blitz Battle Section. The doorway itself is @/components/profile
            ChallengeBattleCard — extracted 2026-09-11 because it was the last
            block on this page still wearing hand-picked Tailwind colours
            (emerald / orange / red) while everything around it had moved onto
            the tier tokens, and this file had no ratchet headroom to re-skin it
            in place. */}
        {currentUser?.has_custom_username && profileUser?.has_custom_username && friendStatus === 'friends' && (
          <ChallengeBattleCard
            username={profileUser.username}
            onChallenge={(mode) => { setBattleMode(mode); setShowCreateChallenge(true); }}
          />
        )}

        {/* The button AND its modal, together — see ViewBlitzStats for why that
            matters. Restored 2026-09-10: nothing had ever set the state that
            opened this, so it was unreachable while looking present.

            Deliberately OUTSIDE the friends-only battle block above. That gate
            guards battle CREATION, which reasonably needs a friendship; reading a
            player's public Blitz record does not. */}
        <ViewBlitzStats player={profileUser} />

        {/* Badges (Badge System Redesign, Lane H).
            REPLACES the old inline "Achievements" summary — podium cards plus
            the streak / perfect-streak / speed-record milestone rows. Every one
            of those is now a registry badge (podiumFirst/Second/Third,
            dailyStreak, perfectStreak, speedRecord), so keeping both would leave
            two competing achievement UIs on one card reading the same numbers.
            The exact counts are one tap deeper: a badge opens L3 with its
            progress, and "View all badges" opens L2 on THIS player.
            The tiered PlayerBadges next to their name are a separate, deliberate
            system (leaderboard badges) and are untouched. */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.2 }}
          className="rounded-2xl p-6 mb-8 bg-gradient-to-b from-slate-900 via-slate-900 to-indigo-950"
          style={{
            border: '2px solid',
            borderColor: '#fcd34d',
            borderRadius: '1rem'
          }}
        >
          <FeaturedBadges
            badgeState={badgeState}
            isOwnStats={false}
            playerId={profileUser.id}
            playerName={profileUser.username}
            loading={badgesLoading}
          />
        </motion.div>


        </div> {/* max-w-2xl */}
      </div> {/* h-calc scroll area */}

      {/* Create Challenge Modal */}
      {showCreateChallenge && (
        <CreateChallenge
          opponentId={profileUser.id}
          battleMode={battleMode}
          onClose={() => {
            setShowCreateChallenge(false);
            setBattleMode(null);
          }}
          onCreated={() => {
            setShowCreateChallenge(false);
            setBattleMode(null);
            addNotification({
              type: 'request',
              title: 'Challenge Sent!',
              message: `Head-to-head challenge sent to ${profileUser.username}`
            });
          }}
        />
      )}
    </div>
  );
}