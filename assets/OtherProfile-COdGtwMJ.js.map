// Derive a player's puzzle-point total from their daily_challenge_times rows.
//
// A puzzle point is one daily challenge completed with a *perfect solve* — all
// three colored power dice used correctly (isPerfectSolve). The authoritative
// source is the surviving daily_challenge_times event log. This replaces the
// pre-migration path that derived points from the fragile game_stats blob's
// `dailyChallengeSolutions` array, which a backend migration partially dropped
// (see docs/bugs.md — stale puzzle_points after migration).
//
// One point per DISTINCT date: the daily challenge is once-per-day, so a date is
// counted at most once even if the event log holds duplicate rows for it. That
// de-dup is now also what makes this function CORRECT rather than wrong under
// three modes: a perfect Challenge Daily and a perfect Expert Daily on one date
// are one date, and one Piece.
//
// ─────────────────────────────────────────────────────────────────────────────
// ⚠️ THIS IS THE LEGACY DERIVATION. IT IS NO LONGER THE LEDGER.
// ─────────────────────────────────────────────────────────────────────────────
// It used to be a WRITER'S input: syncPublicProfile called it and wrote the
// result absolutely into profiles.puzzle_points on every app open. That was the
// second of two absolute writers of one balance, and under David's ruling Q-A
// (existing balances grandfathered, new Pieces earned by a sub-30s Expert Daily)
// it would have erased a grandfathered balance the next time a player opened the
// app. Inventory A8. syncPublicProfile no longer writes the column at all.
//
// What this function still expresses is the HISTORICAL rule — "how many distinct
// dates did this player solve perfectly" — which is exactly what a grandfathered
// balance is. The authoritative running total is
// supabase/functions/_shared/puzzlePointsLedger.ts, computed server-side as
// max(stored, legacy + new) so a balance can rise and never fall.
//
// It reads no `mode` and no `solve_time_seconds`, so it cannot see the new rule.
// A caller that wants a player's CURRENT balance should read the stored
// profiles.puzzle_points column, not recompute it here — this answers a
// different, narrower question and will under-report once the new rule pays.

import { isPerfectSolve } from '@/equation-engine';

/**
 * Count puzzle points from a player's daily_challenge_times rows.
 *
 * @param {Array<{
 *   date: string,
 *   equation: string,
 *   usedDiceIndices: number[],
 *   diceColors: string[],
 * }>} rows - the player's daily_challenge_times rows (any extra columns ignored).
 * @returns {number} count of DISTINCT dates with a perfect solve (>= 0). Rows
 *   missing any of date/equation/usedDiceIndices/diceColors are skipped (legacy
 *   rows with null dice data can never score), as is a non-array input.
 */
export function countPuzzlePointsFromTimes(rows) {
  if (!Array.isArray(rows)) return 0;

  const perfectDates = new Set();
  for (const row of rows) {
    if (!row) continue;
    const { date, equation, usedDiceIndices, diceColors } = row;
    if (!date || !equation || !usedDiceIndices || !diceColors) continue;
    if (isPerfectSolve(equation, usedDiceIndices, diceColors)) {
      perfectDates.add(date);
    }
  }
  return perfectDates.size;
}
