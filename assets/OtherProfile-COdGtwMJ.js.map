import moment from 'moment';
import { DAILY_MODE_KEYS } from '@/game-modes';
import { rowModeKey, LEGACY_DAILY_MODE } from '@/components/stats/dailyModeStats';

/**
 * The player's daily-challenge solutions for the CURRENT week (Monday →
 * `today`, inclusive on both ends), newest first.
 *
 * Pure read-side derivation extracted from OtherProfile.jsx (it was an inline
 * filter+sort in the render body). Date-window comparison uses moment day
 * granularity so a same-day timestamp on either boundary is included.
 *
 * Solutions are loosely-typed API payloads (each carries at least a `date`,
 * plus render fields like `equation` / `usedDiceIndices` / `time`), so they're
 * typed `any[]` here to preserve the original untyped access at the call site.
 *
 * @param {any[]|null|undefined} solutions - the player's stored daily solutions
 *   (each carries a `date`).
 * @param {string} startOfWeek - the week's Monday, `YYYY-MM-DD`.
 * @param {string} today - today's date key (ET), `YYYY-MM-DD`.
 * @returns {any[]} the in-week solutions sorted newest→oldest.
 */
export function currentWeekSolutions(solutions, startOfWeek, today) {
  return (solutions || [])
    .filter(sol =>
      // Legacy accounts carry solution blobs with NO `date` (old-game format:
      // just equation/dice). `moment(undefined)` is *now*, so those rows would
      // otherwise all pass the window and render as bogus "today" entries with
      // NaN times. Require a genuinely present, valid date first.
      sol.date != null &&
      moment(sol.date, moment.ISO_8601, true).isValid() &&
      moment(sol.date).isSameOrAfter(startOfWeek, 'day') &&
      moment(sol.date).isSameOrBefore(today, 'day')
    )
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
}

const isValidDate = (d) => d != null && moment(d, moment.ISO_8601, true).isValid();

/**
 * The player's completed daily challenges for the CURRENT week, derived from the
 * AUTHORITATIVE `daily_challenge_times` rows (one per completed day) rather than
 * the client-maintained `dailyChallengeSolutions` blob — which drifts and
 * truncates, so a player with a long active streak could show only today.
 *
 * Every completed (non-forfeited) day in the week window is included, carrying
 * its authoritative date + solve time AND the equation/dice — which the
 * daily_challenge_times rows themselves carry (the same columns the leaderboard
 * displays: `equation, usedDiceIndices, diceColors`). The stored solutions blob
 * is only a fallback for a row that happens to lack them. A completed day with
 * no equation anywhere still lists (date + time). Newest first.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * PER MODE (D5, 2026-08-27)
 * ─────────────────────────────────────────────────────────────────────────────
 * A date no longer identifies a solve — up to three do, one per Daily mode. Two
 * consequences, and the second is the subtle one:
 *
 *   1. Each output row now CARRIES its `mode`, so the list can label the three
 *      rows for one date instead of showing three identical-looking entries.
 *      Ordering is date-descending, then DAILY_MODE_KEYS order within a date, so
 *      a day always reads Easy → Challenge → Expert.
 *
 *   2. ⚠️ THE BLOB FALLBACK IS SCOPED TO THE LEGACY MODE. `dailyChallengeSolutions`
 *      is the old client-maintained array; it is keyed by DATE ALONE and carries
 *      no mode, and it never will. Applied to every row it would paste
 *      Challenge's equation onto that date's Easy and Expert rows — showing a
 *      player an answer they never wrote, in a mode where it may not even be a
 *      legal solve. It is therefore offered ONLY to rows that are Challenge's
 *      Daily, which is the one mode every blob entry actually describes.
 *
 * @param {any[]|null|undefined} times - daily_challenge_times rows, each
 *   `{date, mode?, solve_time_seconds|time, forfeited?, equation?, usedDiceIndices?, diceColors?}`.
 * @param {any[]|null|undefined} solutions - stored dailyChallengeSolutions blob
 *   (fallback source for equation/dice, Challenge's Daily only), each optionally
 *   `{date, equation, usedDiceIndices, diceColors}`.
 * @param {string} startOfWeek - the week's Monday, `YYYY-MM-DD`.
 * @param {string} today - today's date key (ET), `YYYY-MM-DD`.
 * @returns {any[]} in-week completed solves, newest→oldest then by mode order.
 */
export function currentWeekSolves(times, solutions, startOfWeek, today) {
  // Index the blob by day key as a fallback for equation/dice.
  const byDate = new Map();
  for (const sol of solutions || []) {
    if (sol && isValidDate(sol.date)) {
      byDate.set(moment(sol.date).format('YYYY-MM-DD'), sol);
    }
  }
  const modeOrder = (key) => {
    const i = DAILY_MODE_KEYS.indexOf(key);
    return i === -1 ? DAILY_MODE_KEYS.length : i;
  };
  return (times || [])
    .filter(t =>
      t &&
      t.forfeited !== true &&
      isValidDate(t.date) &&
      moment(t.date).isSameOrAfter(startOfWeek, 'day') &&
      moment(t.date).isSameOrBefore(today, 'day'),
    )
    .map(t => {
      const dateKey = moment(t.date).format('YYYY-MM-DD');
      const mode = rowModeKey(t);
      // The blob describes Challenge's Daily and nothing else — see the header.
      const sol = (mode === LEGACY_DAILY_MODE ? byDate.get(dateKey) : null) || {};
      const time = Number.isFinite(t.time) ? t.time
        : Number.isFinite(t.solve_time_seconds) ? t.solve_time_seconds
          : (Number.isFinite(sol.time) ? sol.time : undefined);
      // Prefer the authoritative row's own equation/dice (complete); fall back
      // to the stored blob only when a row is missing them.
      return {
        date: dateKey,
        mode,
        time,
        equation: t.equation ?? sol.equation,
        usedDiceIndices: t.usedDiceIndices ?? sol.usedDiceIndices,
        diceColors: t.diceColors ?? sol.diceColors,
      };
    })
    .sort((a, b) => {
      const byDay = new Date(b.date).getTime() - new Date(a.date).getTime();
      return byDay !== 0 ? byDay : modeOrder(a.mode) - modeOrder(b.mode);
    });
}
