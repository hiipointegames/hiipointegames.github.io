import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { Button } from '@/ui/primitives/button';
import { createPageUrl } from '@/routing/createPageUrl';
import { HeadToHeadStats } from '@/head-to-head';

// ─────────────────────────────────────────────────────────────────────────────
// "View <player>'s Blitz Stats" — the button AND the modal it opens, together.
//
// Extracted from OtherProfile on 2026-09-10, in the same commit that made the
// feature reachable again. The extraction is not incidental to that fix; it is
// the fix for the thing that ALLOWED it.
//
// In OtherProfile the three pieces lived ~700 lines apart: `showHeadToHeadStats`
// was declared near the top, the modal was rendered at the very bottom, and the
// trigger that set the state to `true`... did not exist. Nothing about reading
// any one of those locations revealed that the chain was broken — the state
// looked used (the modal reads it), and the modal looked reachable (the state
// exists). Only holding all three at once showed the gap, and nothing in a
// 790-line file makes you do that.
//
// Here they are eleven lines apart and the component owns its own open/closed
// state, so a missing trigger is immediately visible: the state would have no
// setter call in a file you can read in one screen.
//
// This is also what keeps OtherProfile under the 800-line structural cap. The
// arch ratchet flagged the regression the moment the button landed; the rule is
// to EXTRACT rather than trim comments for room, and this was the extraction the
// change was asking for anyway.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * @param {object} props
 * @param {{ id: string, username: string }} props.player the profile being viewed
 */
export default function ViewBlitzStats({ player }) {
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);

  if (!player) return null;

  return (
    <>
      <Button
        data-testid="open-blitz-stats"
        onClick={() => setOpen(true)}
        className="w-full mb-6 min-h-[48px] touch-manipulation font-bold"
        style={{
          background: 'color-mix(in srgb, var(--u37-magenta) 14%, transparent)',
          border: '1px solid color-mix(in srgb, var(--u37-magenta) 45%, transparent)',
          color: 'var(--u37-text)',
        }}
      >
        <span className="mr-2" aria-hidden="true">🛡️</span>
        {`View ${player.username}'s Blitz Stats`}
      </Button>

      {/* The modal's "global leaderboard" action routes to the unified
          Leaderboard's Battle Points tab (the standalone BattlePointsLeaderboard
          modal is retired). */}
      {open && (
        <HeadToHeadStats
          onClose={() => setOpen(false)}
          opponentId={player.id}
          onOpenLeaderboard={() => {
            setOpen(false);
            navigate(`${createPageUrl('Leaderboard')}?tab=battle`);
          }}
        />
      )}
    </>
  );
}
