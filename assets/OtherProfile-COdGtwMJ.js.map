import React, { useState } from 'react';
import { motion } from 'framer-motion';
import moment from 'moment';
import { isPerfectSolve as isPerfectPowerDiceSolve } from '@/equation-engine';
import { SolvedEquation } from '@/equation-display';
import { Target37 } from '@/dice-visuals';
import { POWER_DICE_COLORS } from '@/dice';
import { formatSolveTime } from '@/ui/feedback';
import { hasPerfectConcept } from '@/game-modes';
import { rowModeKey, dailyModeLabel, dailyModeAccent, dailyModeFullLabel, groupByMode, dailyModeTheme, LEGACY_DAILY_MODE } from '@/components/stats/dailyModeStats';
import { DAILY_MODE_KEYS } from '@/game-modes';

// "This Week's Daily Challenges" — the current-week daily-solve list shown on
// another player's profile (extracted from OtherProfile.jsx, R6-Profile
// decomposition). Today's row is anti-peek gated: the viewer only sees the
// equation once they've finished today themselves; past days are always visible.
//
// ─────────────────────────────────────────────────────────────────────────────
// THREE ROWS CAN NOW SHARE A DATE (D5)
// ─────────────────────────────────────────────────────────────────────────────
// The list was one row per day, and the day was the only thing identifying it.
// With three Dailies, three rows carrying the same date and the same formatting
// sat on top of each other with nothing saying which game each was — and a
// 12-second Easy time next to a 200-second Expert one reads as a collapse in
// form rather than as two different puzzles. Every row now carries a mode chip
// in that mode's accent.
//
// ⚠️ THE ANTI-PEEK GATE IS PER MODE — `viewerCanSeeTodayByMode`, a record, not a
// boolean. Finishing Challenge must not reveal this player's Easy and Expert
// answers for today; un-scoped, one tap on the easiest mode unlocked the other
// two, which is exactly the leak the gate exists to close. A MISSING record
// reads as locked: an unresolved or errored gate must never become an unlock.
//
// ⚠️ NO GOLD ON EASY. The perfect-solve border is gated on `hasPerfectConcept`,
// not merely on the solve failing the check. Easy deals all-white dice, so
// `isPerfectSolve` could only ever return false there — but the legend below
// would still be promising a border that cannot happen, so the legend drops its
// perfect-solve lines when no listed row could earn one.
//
// @param {{ solutions: any[], today: string, viewerCanSeeTodayByMode?: Record<string, boolean> }} props
export default function WeeklyDailyChallenges({
  solutions, today, viewerCanSeeTodayByMode, perMode, mode: controlledMode, onModeChange,
}) {
  // CONDENSED (2026-09-10). This was a flat list of up to 21 rows — 7 days x 3
  // modes — each carrying a chip. One mode is chosen and only its rows are
  // listed, which is what makes a week readable again.
  //
  // CONTROLLED WHEN THE PAGE ASKS. OtherProfile already has a Daily-mode
  // selection driving its streak/fastest/solved cards. If this list kept a
  // SEPARATE one, the page could say "Expert" in one card and list Challenge
  // rows in another, and `data-mode` — the token slot the tier palette keys off
  // — would have two different answers on one screen. So the page hands its
  // selection down and both controls move together. Uncontrolled is kept for
  // tests and for any future caller that has no selection of its own.
  const [ownMode, setOwnMode] = useState(LEGACY_DAILY_MODE);
  const mode = controlledMode ?? ownMode;
  const setMode = onModeChange ?? setOwnMode;

  const allRows = solutions || [];
  const byMode = groupByMode(allRows);
  const rows = byMode[mode] || [];

  // TWO DIFFERENT NUMBERS, AND THEY ARE LABELLED AS SUCH.
  //
  // "N of 7" is week-scoped and counted from the rows in this list. The streak
  // is the player's LIVE current streak for this mode, which the server derives
  // from their whole history. A 72-day streak cannot be recomputed from 7 days
  // of rows, and a week-bounded number labelled "streak" would quietly
  // contradict the streak card further up this same page. Showing both, named,
  // is the only version where neither number lies.
  const daysThisWeek = new Set(rows.map(r => r.date)).size;
  const modeStats = perMode?.[mode];
  // `tracked` is the difference between "this player has a 0 streak" and
  // "nothing has ever tracked a streak for this mode". Rendering the second as
  // a 0 tells the player they failed at something that does not exist yet.
  const streakTracked = modeStats?.tracked === true;

  // Does any LISTED row belong to a mode where a perfect solve is possible?
  const anyPerfectPossible = rows.some(sol => hasPerfectConcept(rowModeKey(sol)));
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: 0.15 }}
      className="bg-gradient-to-br from-indigo-600/30 via-purple-600/30 to-pink-600/30 backdrop-blur rounded-2xl p-6 border-2 border-indigo-400/50 mb-8 shadow-2xl shadow-indigo-500/20"
    >
      <div className="w-full flex items-center mb-4">
        <div className="flex items-center gap-2 min-w-0">
          <span className="text-2xl flex-shrink-0">📆</span>
          <span className="text-xl font-black bg-gradient-to-r from-indigo-200 via-purple-200 to-pink-200 bg-clip-text text-transparent truncate">This Week's Daily Challenges</span>
        </div>
      </div>

      {/* Mode selector. Deliberately NOT DailyModeTabs: OtherProfile.modes.test
          asserts this page has no separate mode bar, so this reuses the page's
          own role="group" / aria-pressed idiom instead. */}
      <div role="group" aria-label="Choose which Daily to list" className="grid grid-cols-3 gap-2 mb-4">
        {DAILY_MODE_KEYS.map((key) => {
          const selected = key === mode;
          const count = (byMode[key] || []).length;
          return (
            <button
              key={key}
              type="button"
              onClick={() => setMode(key)}
              aria-pressed={selected}
              data-testid="weekly-mode-button"
              data-mode-key={key}
              data-selected={selected ? 'true' : 'false'}
              /* STACKED, and that is the fix (David, on the device 2026-09-11).
                 On one line "CHALLENGE (5)" needs ~113px at text-xs with
                 tracking-wider, and a 3-column grid inside a p-6 card gives each
                 button ~99px on a 360px viewport — so the count was clipped by
                 the selected ring. Only CHALLENGE is long enough to overflow,
                 which is why it looked like a styling glitch on one tab rather
                 than a sizing bug on all three.
                 Putting the count on its own line makes it fit at ANY width
                 instead of fitting until the next label grows. Two 14px lines
                 plus py-1 is 36px, inside the 44px tap target. */
              className="min-h-[44px] rounded-lg px-1 py-1 text-[11px] font-black uppercase
                tracking-wide transition-colors flex flex-col items-center justify-center leading-tight"
              style={{
                color: dailyModeAccent(key),
                background: `color-mix(in srgb, ${dailyModeAccent(key)} ${selected ? 22 : 8}%, transparent)`,
                boxShadow: selected ? `inset 0 0 0 2px ${dailyModeAccent(key)}` : 'none',
              }}
            >
              <span className="max-w-full truncate">{dailyModeLabel(key)}</span>
              <span className="opacity-70">({count})</span>
            </button>
          );
        })}
      </div>

      {/* The two numbers, named so neither can be read as the other. */}
      <div data-mode={dailyModeTheme(mode)} className="flex items-center justify-between mb-4 text-sm">
        <div className="text-purple-200">
          <span data-testid="weekly-days-count" className="font-black text-white">{daysThisWeek} of 7</span>
          <span className="ml-1 opacity-80">days this week</span>
        </div>
        <div className="text-purple-200 text-right">
          <span data-testid="weekly-mode-streak" className="font-black text-white">
            {streakTracked ? modeStats.currentStreak : '—'}
          </span>
          <span className="ml-1 opacity-80">
            {streakTracked ? `day ${dailyModeLabel(mode)} streak` : `${dailyModeLabel(mode)} streak not tracked yet`}
          </span>
        </div>
      </div>

      <div className="flex flex-col">
        {rows.length === 0 ? (
          <div className="text-center text-purple-300 py-8">
            No {dailyModeFullLabel(mode)} solves this week yet
          </div>
        ) : (
          <div className="space-y-3 overflow-y-auto max-h-[280px] pr-2">
            {rows.map((solution, idx) => {
              const isToday = solution.date === today;
              const modeKey = rowModeKey(solution);
              const solutionColors = Array.isArray(solution.diceColors) ? solution.diceColors : POWER_DICE_COLORS;
              const solutionUsedIndices = Array.isArray(solution.usedDiceIndices) ? solution.usedDiceIndices : [];

              // Past days are always visible. For TODAY, the viewer must have
              // finished today's SAME MODE — finishing Easy earns Easy's answers
              // and nothing else. An absent record is locked, never unlocked.
              const viewerCanSee = !isToday || viewerCanSeeTodayByMode?.[modeKey] === true;

              // Rows now derive from the authoritative daily_challenge_times, so a
              // completed day can appear with its date + time but NO equation
              // (the equation lives only in the drift-prone solutions blob, which
              // may not have this day). Render "✓ Completed" in that case rather
              // than an empty/broken equation.
              const hasEquation = typeof solution.equation === 'string' && solution.equation.length > 0;

              // Check for perfect solve (all 3 power dice correct). Gated on the
              // MODE first: Easy has no perfect-solve concept at all, so it must
              // never take the gold border even if a row somehow claims one.
              const isPerfectSolve = hasPerfectConcept(modeKey)
                && hasEquation
                && solutionUsedIndices.length >= 7
                && isPerfectPowerDiceSolve(solution.equation, solutionUsedIndices, solutionColors);

              return (
                <div key={`${solution.date}-${modeKey}-${idx}`} className={`rounded-lg p-4 bg-gradient-to-br from-blue-800/50 to-slate-800/50 ${isPerfectSolve && viewerCanSee ? 'border-2 border-amber-400/60 shadow-[0_0_12px_rgba(251,146,60,0.4)]' : 'border-2 border-blue-600/50'}`}>
                  <div className="flex justify-between items-start mb-2">
                    <div className="text-slate-400 text-sm">
                      {/* No per-row mode chip any more. The list is filtered to
                          ONE mode, so a chip on every row repeated the same word
                          down the column — the clutter this condensing removes.
                          Which Daily you are looking at is stated once, by the
                          selected button above. The anti-peek copy below still
                          names the mode, because there it is load-bearing. */}
                      {moment(solution.date).format('MMM D, YYYY')}
                      {isToday && <span className="ml-2 text-purple-400 font-semibold">(Today)</span>}
                    </div>
                    <div className="text-white font-bold">
                      {Number.isFinite(solution.time) ? formatSolveTime(solution.time) : ''}
                    </div>
                  </div>
                  {!viewerCanSee ? (
                    <div className="text-slate-400 font-semibold text-sm">
                      ✓ Completed — finish today&apos;s {dailyModeFullLabel(modeKey)} to see the equation
                    </div>
                  ) : !hasEquation ? (
                    <div className="text-slate-400 font-semibold text-sm">
                      ✓ Completed
                    </div>
                  ) : (
                    <div className="font-mono text-base sm:text-lg">
                      {<SolvedEquation equation={solution.equation} usedIndices={solution.usedDiceIndices} colors={solutionColors} highlightAllWhenPerfect />} <span className="font-black text-slate-300">= </span><Target37 className="font-black" />
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}
        {/* The gold keys are dropped when no listed row could ever earn one —
            an Easy-only week would otherwise explain a border that cannot
            appear, which reads as something the player is failing at. */}
        {rows.length > 0 && anyPerfectPossible && (
          <div className="mt-3 pt-3 border-t border-purple-600/30 text-xs text-purple-300 space-y-1">
            <div className="flex items-center gap-2">
              <div className="w-3 h-3 bg-slate-700 border-2 border-amber-400/80 rounded shadow-[0_0_6px_rgba(251,146,60,0.4)]"></div>
              <span>Gold Outline = Correct Power Dice</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-3 h-3 border-2 border-amber-400/60 rounded shadow-[0_0_6px_rgba(251,146,60,0.4)]"></div>
              <span>Gold Border = Perfect Solve (All 3 Power Dice Correct)</span>
            </div>
          </div>
        )}
      </div>
    </motion.div>
  );
}
