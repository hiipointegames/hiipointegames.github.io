import React from 'react';
import { motion } from 'framer-motion';
import moment from 'moment';
import { formatSolveTime } from '@/ui/feedback';

/**
 * The cyan "Fastest Solve" stat card on a player profile. Given the player's
 * daily-challenge time rows, shows their single fastest solve (time + date), or
 * a "--" placeholder when they have none. Leaf/presentation only — extracted
 * faithfully from OtherProfile.jsx.
 *
 * @param {{times?: Array<{time: number, date: string}>}} props
 */
export default function FastestSolveCard({ times }) {
  // Only rows that carry a usable time can win a min comparison. Without this
  // filter a row whose `time` is undefined makes EVERY `<` false, so `reduce`
  // returns rows[0] and the card prints `formatSolveTime(undefined)` — the
  // literal string "NaN:NaN.NaN" — over an arbitrary row's date. That shipped
  // between 2026-08-26 and 2026-09-10, because the caller switched from the
  // legacy blob (which has `time`) to raw `daily_challenge_times` rows (which
  // have `solve_time_seconds`) and the card kept reading `time`.
  //
  // The real fix is at the fetch seam, where the field is now mapped. This
  // filter is the presentation-side invariant: a caller that gets the shape
  // wrong degrades to the honest "--" placeholder instead of printing NaN.
  const rows = (times || []).filter(t => Number.isFinite(t?.time));
  const fastest = rows.length
    ? rows.reduce((min, t) => (t.time < min.time ? t : min), rows[0])
    : null;

  return (
    <motion.div
      whileHover={{ scale: 1.05, y: -5 }}
      className="relative rounded-xl sm:rounded-2xl p-4 sm:p-6 border-2 sm:border-3 overflow-hidden bg-gradient-to-br from-cyan-500/40 to-blue-600/40 border-cyan-400/60 shadow-[0_4px_16px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.2)]"
    >
      <div className="text-center relative z-10">
        {!fastest ? (
          <>
            <div className="flex items-center justify-center gap-2 mb-2">
              <span className="text-2xl sm:text-3xl">⚡</span>
              <motion.div
                className="text-2xl sm:text-3xl font-black text-cyan-200"
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ delay: 0.35, type: 'spring', stiffness: 200 }}
              >
                --
              </motion.div>
            </div>
            <div className="text-xs sm:text-base font-bold text-cyan-100 uppercase tracking-wider">
              Fastest Solve
            </div>
          </>
        ) : (
          <>
            <div className="flex items-center justify-center gap-2 mb-2">
              <span className="text-2xl sm:text-3xl">⚡</span>
              <motion.div
                className="text-2xl sm:text-3xl font-black text-cyan-200 break-words"
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ delay: 0.35, type: 'spring', stiffness: 200 }}
                key={formatSolveTime(fastest.time)}
              >
                {formatSolveTime(fastest.time)}
              </motion.div>
            </div>
            <div className="text-cyan-200 text-[10px] sm:text-xs font-semibold mb-2">
              {moment(fastest.date).format('MMM D, YYYY')}
            </div>
            <div className="text-xs sm:text-base font-bold text-cyan-100 uppercase tracking-wider text-center">
              Fastest Solve
            </div>
          </>
        )}
      </div>
    </motion.div>
  );
}
