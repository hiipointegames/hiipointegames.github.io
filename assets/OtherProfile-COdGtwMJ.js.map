import React from 'react';
import { motion } from 'framer-motion';

/**
 * The purple "Total Solved" stat card on a player profile — the count of daily
 * challenges the player has solved. Leaf/presentation only; extracted faithfully
 * from OtherProfile.jsx.
 *
 * @param {{count?: number}} props
 */
export default function TotalSolvedCard({ count }) {
  return (
    <motion.div
      whileHover={{ scale: 1.05, y: -5 }}
      className="relative rounded-xl sm:rounded-2xl p-4 sm:p-6 border-2 sm:border-3 overflow-hidden bg-gradient-to-br from-purple-600/40 to-pink-600/40 border-purple-400/60 shadow-[0_4px_16px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.2)]"
    >
      <div className="text-center relative z-10">
        <div className="flex items-center justify-center gap-1 sm:gap-2 mb-1 sm:mb-2">
          <motion.div
            animate={{ scale: [1, 1.2, 1] }}
            transition={{ duration: 2, repeat: Infinity }}
          >
            <span className="text-2xl sm:text-3xl">🎯</span>
          </motion.div>
          <motion.div
            className="text-3xl sm:text-4xl font-black bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text text-transparent"
            initial={{ scale: 0 }}
            animate={{ scale: 1 }}
            transition={{ delay: 0.2, type: 'spring', stiffness: 200 }}
            key={count || 0}
          >
            {count || 0}
          </motion.div>
        </div>
        <div className="text-xs sm:text-base font-bold text-purple-100 uppercase tracking-wider text-center">
          Total Solved
        </div>
      </div>
    </motion.div>
  );
}
