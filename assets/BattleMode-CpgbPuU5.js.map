import React, { useCallback, useEffect, useRef, useState } from 'react';
import { apiClient } from '@/transport';
import { getProfileById } from '@/player';
import { HeadToHeadGame, CreateChallenge, perspectiveOf, normalizeBlitzMode } from '@/head-to-head';
import { ModeBackdrop } from '../../fx/ModeBackdrop';
import { ModeHeader, PrimaryButton } from '../ui';
import { refreshStarBalance } from '../stars';
import BattleResultCard from './BattleResultCard';
import { openState, battleLabel, resultFromRun, resultFromRow } from './battleView';
import './battle.css';

// Sector 73 mode `battle` (design-v2 B3/B4, Slice 3): a Blitz battle played INSIDE Sector 73.
//
//   open(challengeId) → load the player + the row
//     ├─ load failed            → "Can't reach the battle" + Retry (F5: never a run without a user)
//     ├─ finished               → the result card straight away
//     ├─ my clock already ran out → "Time's up" + Finish run (F1) → ad → the game ends it, unseen
//     ├─ ready                  → ad (exactly as the Colosseum's Start) → HeadToHeadGame's warning → run
//     └─ pending / closed / not mine → a short "can't play this" card
//   run ends → HeadToHeadGame calls onFinished(payload) once → the result card
//   result card → Rematch (CreateChallenge, same mode + timer) / Back to orbit
//
// The game itself is the Colosseum's HeadToHeadGame, unforked: `embedded` keeps the Sector 73
// chrome (no See-Badges detour, no bottom-nav toggling), `player` hands it the user loaded
// here, `autoStart` ends a run whose clock is already over. battle.css re-skins its board.

/**
 * @param {{ params?: { challengeId?: string } | null, onExit: () => void, onReturnTo37: () => void,
 *   showAd?: () => Promise<void>, slowSaveMs?: number }} props
 */
export default function BattleMode({ params = null, onExit, onReturnTo37, showAd = async () => {}, slowSaveMs = 15000 }) {
  const challengeId = params?.challengeId ?? null;
  const [phase, setPhase] = useState('loading'); // loading | error | unavailable | timeUp | ad | play | result
  const [reason, setReason] = useState(null);
  const [row, setRow] = useState(null);
  const [player, setPlayer] = useState(null);
  const [opponentName, setOpponentName] = useState(null);
  const [result, setResult] = useState(null);
  const [autoStart, setAutoStart] = useState(false);
  const [rematch, setRematch] = useState(false);
  const [rematchSent, setRematchSent] = useState(false);
  const [attempt, setAttempt] = useState(0);
  const [slowSave, setSlowSave] = useState(false);
  const launching = useRef(false);
  // The host's show() changes identity when an ad finishes loading; read it through a ref so
  // that never re-runs the load below (which would yank a running battle back to "loading").
  const showAdRef = useRef(showAd);
  showAdRef.current = showAd;

  const launch = useCallback(async (finishOnly) => {
    if (launching.current) return; // one ad, one game, however many taps
    launching.current = true;
    setPhase('ad');
    // The Colosseum's Start: `await showInterstitialAd()` then the game. show() never throws
    // there; if it ever does here, the battle still starts (fail open, like every ad gate).
    try { await showAdRef.current(); } catch { /* fail open */ }
    setAutoStart(finishOnly);
    setPhase('play');
  }, []);

  useEffect(() => {
    let live = true;
    setPhase('loading');
    (async () => {
      try {
        const me = await apiClient.auth.me();
        if (!me?.id) throw new Error('no signed-in player');
        const rows = challengeId ? await apiClient.entities.HeadToHeadChallenge.filter({ id: challengeId }) : [];
        if (!live) return;
        const found = rows?.[0] ?? null;
        const state = openState(found, me.id);
        setPlayer(me);
        setRow(found);
        if (state !== 'missing') {
          getProfileById(perspectiveOf(found, me.id).opponentId)
            .then((p) => { if (live) setOpponentName(p?.username ?? null); })
            .catch(() => { /* the card says "your opponent" */ });
        }
        if (state === 'finished') { setResult(resultFromRow(found, me.id)); setPhase('result'); return; }
        if (state === 'timeUp') { setPhase('timeUp'); return; }
        if (state === 'ready') { launch(false); return; }
        setReason(state);
        setPhase('unavailable');
      } catch (error) {
        console.error('Sector 73 battle: load failed', error);
        if (live) setPhase('error');
      }
    })();
    return () => { live = false; };
  }, [challengeId, attempt, launch]);

  const onFinished = useCallback((payload) => {
    const next = resultFromRun(payload);
    setResult(next);
    setPhase('result');
    if (next.outcome === 'win') refreshStarBalance().catch(() => { /* the HUD catches up on the next read */ });
  }, []);

  // Re-open the battle from the server: a failed save leaves the row in_progress, so this lands on
  // Time's up → Finish run again (or a resume, if the run still has time).
  const reopen = useCallback(() => { launching.current = false; setResult(null); setAttempt((n) => n + 1); }, []);

  // A Finish-run save that hangs must not trap the player: after slowSaveMs offer Back to orbit.
  // Leaving loses nothing — the write either lands anyway or the row stays in_progress and the
  // next open shows Time's up again.
  const finishing = phase === 'play' && autoStart;
  useEffect(() => {
    setSlowSave(false);
    if (!finishing) return undefined;
    const t = setTimeout(() => setSlowSave(true), slowSaveMs);
    return () => clearTimeout(t);
  }, [finishing, slowSaveMs]);

  const label = row ? battleLabel(row) : null;
  const name = opponentName || 'your opponent';

  if (phase === 'play' && row && player) {
    return (
      <div className="s73-battle s73-battle-play relative isolate h-full w-full bg-[#04030d]" data-testid="battle-play">
        <ModeBackdrop theme="battle" />
        <HeadToHeadGame
          challenge={row}
          durationSeconds={row.time_limit_seconds ?? 600}
          embedded
          player={player}
          autoStart={autoStart}
          onFinished={onFinished}
          onCancel={onExit}
        />
        {autoStart && (
          <div className="grid h-full place-items-center px-4">
            <Notice testId="battle-finishing" title="Logging your run…" line={slowSave ? 'This is taking a while. You can leave: the run stays open and can be finished later.' : undefined}>
              {slowSave ? <OrbitButton onExit={onExit} /> : null}
            </Notice>
          </div>
        )}
      </div>
    );
  }

  return (
    <div className="s73-battle relative isolate flex h-full flex-col overflow-y-auto bg-[#04030d] pb-6" data-testid="battle-mode" data-phase={phase}>
      <ModeBackdrop theme="battle" />
      <ModeHeader title="Blitz Battle" subtitle="Sector 73" onExit={onExit} onReturnTo37={onReturnTo37} />
      <div className="flex flex-1 items-center px-4 pt-4">
        {(phase === 'loading' || phase === 'ad') && <Notice testId="battle-loading" title="Locking on to the battle…" />}
        {phase === 'error' && (
          <Notice testId="battle-error" title="Can't reach the battle" line="Check your connection. Nothing was started.">
            <PrimaryButton testId="battle-retry" onClick={reopen}>RETRY</PrimaryButton>
          </Notice>
        )}
        {phase === 'unavailable' && <Notice testId="battle-unavailable" title={UNAVAILABLE[reason]?.title ?? 'Battle unavailable'} line={UNAVAILABLE[reason]?.line(name)} />}
        {phase === 'timeUp' && (
          <Notice testId="battle-timeup" title="⏱ Time's up" line={`Your clock ran out while you were away. Finish the run to lock in your score against ${name}.`}>
            <PrimaryButton testId="battle-finish-run" tone="cyan" onClick={() => launch(true)}>FINISH RUN</PrimaryButton>
          </Notice>
        )}
        {phase === 'result' && result && (
          <BattleResultCard
            result={result}
            opponentName={opponentName}
            label={label}
            onRematch={() => setRematch(true)}
            rematchSent={rematchSent}
            onRetry={reopen}
            onExit={onExit}
          />
        )}
      </div>
      {rematch && row && player && (
        <CreateChallenge
          opponentId={perspectiveOf(row, player.id).opponentId}
          battleMode={normalizeBlitzMode(row.blitz_mode)}
          initialDurationSeconds={row.time_limit_seconds ?? 600}
          onClose={() => setRematch(false)}
          onCreated={() => { setRematch(false); setRematchSent(true); }}
        />
      )}
    </div>
  );
}

const UNAVAILABLE = Object.freeze({
  missing: { title: 'Battle not found', line: () => 'It may have been declined or removed.' },
  notAccepted: { title: 'Not accepted yet', line: (n) => `${n} hasn't accepted this battle yet.` },
  closed: { title: 'This battle is closed', line: () => 'It expired, or your run is already in.' },
});

function OrbitButton({ onExit }) {
  return (
    <button type="button" data-testid="battle-finishing-orbit" onClick={onExit}
      className="w-full rounded-xl border border-cyan-300/60 bg-black/40 py-3 text-sm font-black tracking-widest text-cyan-100 active:scale-95">
      BACK TO ORBIT ↑
    </button>
  );
}

function Notice({ testId, title, line = undefined, children = null }) {
  return (
    <div data-testid={testId} className="mx-auto w-full max-w-md rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white" style={{ boxShadow: '0 0 40px -14px #a855f7' }}>
      <div className="text-lg font-black">{title}</div>
      {line && <p className="mt-2 text-sm text-slate-300">{line}</p>}
      {children && <div className="mt-4">{children}</div>}
    </div>
  );
}
