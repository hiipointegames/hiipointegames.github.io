// Sector 73 battle overlay — the pure decisions (design-v2 B3/B4, Slice 3).
//
// Everything the overlay shows is decided here, so each branch is a plain unit test:
//   • openState  — what opening a battle row means for this player right now,
//   • resultFromRun / resultFromRow — the result card's view-model, from the run that
//     just ended (HeadToHeadGame's finish payload) or from a finished row (the inbox),
//   • battleLabel — "Expert · 5 min", the same tier + timer words the Colosseum uses,
//   • rewardsFor — what a win pays (battle point + ★), from the server's own rules.
//
// The battle RULES are not here: who can play, the clock arithmetic and the winner all
// come from @/head-to-head (isReadyBattle, runClockExpired, perspectiveOf), so this file
// can't drift from the Colosseum's idea of a battle.

import { involvesPlayer, isReadyBattle, perspectiveOf, runClockExpired, BLITZ_TIER_LABEL } from '@/head-to-head';
import { DERIVED } from '../starMarket/earnRules';

/** @typedef {'missing'|'finished'|'timeUp'|'ready'|'notAccepted'|'closed'} OpenState */

/**
 * What opening this battle means for `meId`:
 *   - 'missing'     no row, or a battle I am not in,
 *   - 'finished'    completed / forfeited → show its result,
 *   - 'timeUp'      ready, but my run's clock already ran out (F1) → end it, no warning,
 *   - 'ready'       ready to play → interstitial, then the game,
 *   - 'notAccepted' still a pending invite,
 *   - 'closed'      accepted but no longer playable (expired, my run done, opponent forfeited).
 * @param {any} row
 * @param {string} meId
 * @param {{ today?: string, nowMs?: number }} [at]
 * @returns {OpenState}
 */
export function openState(row, meId, { today = undefined, nowMs = Date.now() } = {}) {
  if (!row || !meId || !involvesPlayer(row, meId)) return 'missing';
  if (row.status === 'completed' || row.status === 'forfeited') return 'finished';
  if (row.status === 'pending') return 'notAccepted';
  if (!isReadyBattle(row, meId, today)) return 'closed';
  return runClockExpired(row, meId, nowMs) ? 'timeUp' : 'ready';
}

/** "Expert · 5 min" — tier label + the row's own timer (600 s when absent, as the game assumes). */
export function battleLabel(row) {
  const minutes = Math.round((row?.time_limit_seconds ?? 600) / 60);
  return `${BLITZ_TIER_LABEL(row?.blitz_mode)} · ${minutes} min`;
}

/**
 * `unsaved`: the run's result write failed (offline, rejected) — nothing is on the row yet.
 * @typedef {{ outcome: 'win'|'loss'|'draw'|'pending'|'expired'|'unsaved', myScore: number, theirScore: number|null,
 *   earlyExit: boolean, deckCleared: boolean, status: 'completed'|'forfeited'|null }} BattleResult
 */

const RUN_OUTCOME = Object.freeze({ win: 'win', loss: 'loss', tie: 'draw', unresolved: 'pending' });

/**
 * The card for the run that just ended — HeadToHeadGame's finish payload (buildBlitzRunPayload).
 * The opponent's score is shown only once they have finished: while the battle is pending it is
 * their run so far (or 0 before they start), which is not a score.
 * @param {any} payload
 * @returns {BattleResult}
 */
export function resultFromRun(payload) {
  // HeadToHeadGame's `saved: false` = the time-up write failed. Its outcome then reads
  // 'unresolved' because nothing is known — saying "Run logged" would be false.
  const outcome = payload?.saved === false ? 'unsaved' : (RUN_OUTCOME[payload?.outcome] ?? 'pending');
  return {
    outcome,
    myScore: payload?.equationsSolvedCorrectly ?? 0,
    theirScore: outcome === 'pending' || outcome === 'unsaved' ? null : (payload?.opponentScore ?? null),
    earlyExit: !!payload?.earlyExit,
    deckCleared: !!payload?.deckCleared,
    // A run-decided battle is finalized as 'completed' (finalizeBattleFromGame).
    status: outcome === 'pending' || outcome === 'unsaved' ? null : 'completed',
  };
}

/**
 * The card for a battle row that is already over (opened from the inbox's results).
 * @param {any} row
 * @param {string} meId
 * @returns {BattleResult}
 */
export function resultFromRow(row, meId) {
  const { myResult, opponentResult, opponentId } = perspectiveOf(row, meId);
  // A forfeit with no winner is the expiry sweep's "nobody finished in time", not a tie.
  const outcome = row.winner_id === meId ? 'win'
    : row.winner_id && row.winner_id === opponentId ? 'loss'
      : row.status === 'forfeited' ? 'expired' : 'draw';
  return {
    outcome,
    myScore: myResult?.total_solved ?? 0,
    theirScore: opponentResult?.total_solved ?? null,
    earlyExit: !!myResult?.early_exit,
    deckCleared: false,
    status: row.status === 'forfeited' ? 'forfeited' : 'completed',
  };
}

/**
 * What a battle paid this player. Both are derived on the server from `winner_id`:
 * `profiles.battle_points` counts COMPLETED wins only (a forfeit win pays no point),
 * `sector73_star_balance()` pays DERIVED.blitzWin ★ for a completed OR forfeited win.
 * @param {BattleResult} result
 * @returns {{ battlePoints: number, stars: number }}
 */
export function rewardsFor(result) {
  if (result?.outcome !== 'win') return { battlePoints: 0, stars: 0 };
  return { battlePoints: result.status === 'completed' ? 1 : 0, stars: DERIVED.blitzWin };
}
