import React from 'react';
import { motion } from 'framer-motion';
import { PrimaryButton } from '../ui';
import { usePrefersReducedMotion } from '../../fx';
import { rewardsFor } from './battleView';

// The space result card (design-v2 B4): win / loss / draw / expired / waiting for the
// opponent, both scores when known, what a win paid, then Rematch or Back to orbit.
// A run whose write failed ('unsaved') offers RETRY instead of Rematch, and says nothing was logged.

const HEAD = Object.freeze({
  win: { icon: '🏆', title: 'Victory', line: (n) => `You beat ${n}`, glow: '#fbbf24' },
  loss: { icon: '☄️', title: 'Defeated', line: (n) => `${n} took this one`, glow: '#fb7185' },
  draw: { icon: '⚖️', title: 'Dead heat', line: (n) => `You and ${n} tied`, glow: '#a5b4fc' },
  expired: { icon: '🕳️', title: 'Battle expired', line: () => 'Nobody finished in time', glow: '#94a3b8' },
  pending: { icon: '⏳', title: 'Run logged', line: (n) => `Waiting for ${n} to fly their run`, glow: '#22d3ee' },
  unsaved: { icon: '⚠️', title: 'Not saved — try again', line: () => "Couldn't reach the server, so your run isn't in yet.", glow: '#fbbf24' },
});

/**
 * @param {{ result: import('./battleView').BattleResult, opponentName?: string|null, label?: string|null,
 *   onRematch?: () => void, rematchSent?: boolean, onRetry?: () => void, onExit: () => void }} props
 */
export default function BattleResultCard({ result, opponentName = null, label = null, onRematch = undefined, rematchSent = false, onRetry = undefined, onExit }) {
  const reduce = usePrefersReducedMotion();
  const name = opponentName || 'your opponent';
  const head = HEAD[result.outcome] ?? HEAD.pending;
  const paid = rewardsFor(result);
  const pending = result.outcome === 'pending';
  const unsaved = result.outcome === 'unsaved';
  return (
    <motion.div
      data-testid="battle-result"
      data-outcome={result.outcome}
      initial={reduce ? false : { scale: 0.92, opacity: 0, y: 16 }}
      animate={{ scale: 1, opacity: 1, y: 0 }}
      className="mx-auto w-full max-w-md rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white"
      style={{ boxShadow: `0 0 44px -14px ${head.glow}` }}
    >
      {label && <div data-testid="battle-label" className="text-[10px] uppercase tracking-[0.3em] text-violet-300/80">⚔️ Blitz battle · {label}</div>}
      <div className="mt-2 text-5xl" aria-hidden="true">{head.icon}</div>
      <h2 data-testid="battle-outcome" className="mt-1 text-2xl font-black tracking-wide" style={{ color: head.glow, textShadow: `0 0 14px ${head.glow}` }}>
        {head.title}
      </h2>
      <p className="mt-1 text-sm text-slate-200">{head.line(name)}</p>

      <div className="mt-4 grid grid-cols-2 gap-2">
        <div className="rounded-xl bg-white/5 py-2">
          <div data-testid="battle-score-me" className="text-3xl font-black text-cyan-200">{result.myScore}</div>
          <div className="text-[11px] text-slate-400">You · solved</div>
        </div>
        <div className="rounded-xl bg-white/5 py-2">
          <div data-testid="battle-score-them" className="text-3xl font-black text-fuchsia-200">{result.theirScore ?? '—'}</div>
          <div className="truncate px-1 text-[11px] text-slate-400">{opponentName || 'Opponent'} · {pending || unsaved ? 'not in yet' : 'solved'}</div>
        </div>
      </div>

      {paid.stars > 0 && (
        <p data-testid="battle-rewards" className="mt-3 text-sm font-black text-amber-200" style={{ textShadow: '0 0 8px #f59e0b' }}>
          {paid.battlePoints > 0 ? `+${paid.battlePoints} Battle Point · ` : ''}+{paid.stars} ★
        </p>
      )}
      {pending && <p className="mt-3 text-xs text-slate-300">You'll see who won here in Sector 73 once they finish.</p>}
      {unsaved && <p data-testid="battle-unsaved" className="mt-3 text-xs text-amber-100">Nothing is lost: retry to finish the run and lock in your score.</p>}
      {result.earlyExit && <p className="mt-2 text-xs text-slate-400">You left early. Your solves still count.</p>}
      {result.deckCleared && <p className="mt-2 text-xs text-amber-200">You cleared every puzzle in the deck!</p>}

      <div className="mt-5 space-y-2">
        {rematchSent && <p data-testid="battle-rematch-sent" className="text-sm font-bold text-fuchsia-200">⚔️ Rematch sent to {name}</p>}
        {unsaved && onRetry && <PrimaryButton testId="battle-unsaved-retry" tone="cyan" onClick={onRetry}>RETRY</PrimaryButton>}
        {onRematch && !pending && !unsaved && !rematchSent && (
          <PrimaryButton testId="battle-rematch" tone="rose" onClick={onRematch}>⚔️ REMATCH</PrimaryButton>
        )}
        <button
          type="button"
          data-testid="battle-orbit"
          onClick={onExit}
          className="w-full rounded-xl border border-cyan-300/60 bg-black/40 py-3 text-sm font-black tracking-widest text-cyan-100 active:scale-95"
        >
          BACK TO ORBIT ↑
        </button>
      </div>
    </motion.div>
  );
}
