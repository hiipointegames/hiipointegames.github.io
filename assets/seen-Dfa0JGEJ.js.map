// how-to-play "seen" tracking (home-condense H2).
//
// First-run gating: the very first time a player rolls in a given mode, they are
// routed through the How-To-Play page in forced-scroll mode (they must read it to
// the end) before the game starts. After that, the how-to is optional (reopened
// via the "?" affordances). This module is the single source of truth for "has
// this player already seen the how-to for <mode>".
//
// Persistence: localStorage, one key per mode (`howToSeenVersion:<mode>`), storing
// the HOWTO_VERSION that was seen. Bumping HOWTO_VERSION re-gates every player
// once per mode (so a materially-changed how-to is shown again). Cross-device sync
// is intentionally deferred — localStorage is per-install.

export const HOWTO_VERSION = 1;

const keyFor = (mode) => `howToSeenVersion:${mode}`;

// Has this player already completed the current-version how-to for `mode`?
export function getSeen(mode) {
  try {
    const stored = Number(localStorage.getItem(keyFor(mode)));
    return Number.isFinite(stored) && stored >= HOWTO_VERSION;
  } catch {
    // Storage unavailable — treat as unseen (safe default: show the how-to).
    return false;
  }
}

// Record that this player has completed the current-version how-to for `mode`.
export function markSeen(mode) {
  try {
    localStorage.setItem(keyFor(mode), String(HOWTO_VERSION));
  } catch {
    /* storage unavailable — nothing to persist; they'll be re-gated next time */
  }
}
