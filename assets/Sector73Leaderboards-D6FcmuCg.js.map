// All-time boards for the four Sector 73 games (world lane 2026-10-22, David): each player's single best
// finished Daily ever, ranked by the same keys as today's board. Server: sector73_daily_board_alltime
// (migration 20261022120000). Until that is applied, the call fails and the board says it can't load.

import { supabase } from '@/transport/supabaseClient';

/**
 * @param {string} game
 * @param {{ rpc?: (fn: string, args: object) => PromiseLike<{ data: any, error: any }> }} [deps]
 * @returns {Promise<Array<{ place: number, user_id: string, username: string|null, country: string|null,
 *   score: any, ms: number, day: string, days_played: number, is_me: boolean, players: number }> | null>}
 *   null = could not load
 */
export async function fetchAllTimeBoard(game, { rpc = (fn, args) => supabase.rpc(fn, args) } = {}) {
  try {
    const { data, error } = await rpc('sector73_daily_board_alltime', { p_game: game });
    if (error) return null;
    return Array.isArray(data) ? data : [];
  } catch {
    return null;
  }
}
