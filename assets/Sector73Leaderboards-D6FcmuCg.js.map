import React, { useState } from 'react';
import { playSound } from '@/ui/feedback';
import GameBoard from './GameBoard';

// The Leaderboards page as Sector 73's Observatory shows it (world lane 2026-10-22, David): GAME TABS
// across the top — 37 · Star Chart · First Contact · Re-Entry · Hyperjump. 37 opens first, with its
// usual Easy / Challenge / Expert boards (the normal screen, passed in as `children`); the four
// Sector 73 games show Today + All-time (GameBoard).
//
// Only pages/Leaderboard.jsx renders this, and only when Sector 73 opened it (route state from73);
// the normal Leaderboards page is byte-for-byte unchanged (pages/Leaderboard.from73.test.jsx).

export const GAME_TABS = Object.freeze([
  { id: '37', label: '37' },
  { id: 'starChart', label: 'Star Chart' },
  { id: 'firstContact', label: 'First Contact' },
  { id: 'reEntry', label: 'Re-Entry' },
  { id: 'hyperjump', label: 'Hyperjump' },
]);

/** @param {{ children: React.ReactNode, initial?: string }} props */
export default function Sector73Leaderboards({ children, initial = '37' }) {
  const [game, setGame] = useState(GAME_TABS.some((t) => t.id === initial) ? initial : '37');
  return (
    <div data-testid="s73-leaderboards" className="pb-28" style={{ paddingTop: 'calc(var(--safe-top, 0px) + 12px)' }}>
      <div className="mx-auto flex w-full max-w-md flex-wrap justify-center gap-1.5 px-3" role="tablist" aria-label="Game">
        {GAME_TABS.map((t) => (
          <button key={t.id} type="button" role="tab" aria-selected={game === t.id} data-testid={`s73-game-${t.id}`}
            onClick={() => { playSound('buttonTap'); setGame(t.id); }}
            className={`min-h-[40px] rounded-full px-3.5 text-sm font-black ${game === t.id ? 'bg-violet-500 text-white' : 'border border-violet-300/40 text-violet-100'}`}>
            {t.label}
          </button>
        ))}
      </div>
      <div className="mt-3">
        {game === '37' ? children : <GameBoard key={game} game={game} />}
      </div>
    </div>
  );
}
