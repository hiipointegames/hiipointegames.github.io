import React, { useEffect, useState } from 'react';
import { fetchBoard, scoreText, formatMs, GAME_TITLE } from '../modes/dailyRuns';
import { fetchAllTimeBoard } from './allTimeBoard';

// One Sector 73 game's leaderboard inside the Leaderboards page (world lane 2026-10-22): TODAY (the
// Daily's board, top 37 + you) or ALL-TIME (everyone's best Daily ever, top 37 + you).

export const RANGES = Object.freeze([{ id: 'today', label: 'Today' }, { id: 'alltime', label: 'All-time' }]);

/** "Oct 20" from "2026-10-20" (read from the string: no time-zone shift). */
const shortDay = (d) => {
  const m = /^\d{4}-(\d{2})-(\d{2})$/.exec(String(d ?? ''));
  return m ? `${['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Number(m[1]) - 1]} ${Number(m[2])}` : '';
};

/**
 * @param {{ game: string, fetchToday?: typeof fetchBoard, fetchAllTime?: typeof fetchAllTimeBoard }} props
 */
export default function GameBoard({ game, fetchToday = fetchBoard, fetchAllTime = fetchAllTimeBoard }) {
  const [range, setRange] = useState('today');
  const [rows, setRows] = useState(/** @type {any[] | null | undefined} */ (undefined)); // undefined = loading
  useEffect(() => {
    let alive = true;
    setRows(undefined);
    const load = range === 'today' ? fetchToday(game) : fetchAllTime(game);
    Promise.resolve(load).then((r) => { if (alive) setRows(r); }).catch(() => { if (alive) setRows(null); });
    return () => { alive = false; };
  }, [game, range, fetchToday, fetchAllTime]);
  const players = rows?.[0]?.players ?? 0;
  return (
    <div data-testid={`s73-board-${game}`} className="mx-auto w-full max-w-md px-3">
      <div className="flex justify-center gap-2" role="tablist" aria-label="Range">
        {RANGES.map((r) => (
          <button key={r.id} type="button" role="tab" aria-selected={range === r.id} data-testid={`s73-range-${r.id}`} onClick={() => setRange(r.id)}
            className={`min-h-[40px] rounded-full px-4 text-sm font-bold ${range === r.id ? 'bg-amber-400 text-[#1a1200]' : 'border border-amber-300/40 text-amber-100'}`}>
            {r.label}
          </button>
        ))}
      </div>
      <div className="mt-3 rounded-2xl border border-amber-300/30 bg-[#0b0820]/80 p-3 text-white">
        <div className="text-lg font-black">🏆 {GAME_TITLE[game]} · {range === 'today' ? "Today's Daily" : 'All-time best'}</div>
        <div className="text-xs text-slate-400">
          {players ? `${players} pilot${players === 1 ? '' : 's'}${range === 'today' ? ' today' : ' ranked'}` : ''}
        </div>
        <div className="mt-2" data-testid="s73-board-rows">
          {rows === undefined && <p className="py-6 text-center text-sm text-slate-400">Loading…</p>}
          {rows === null && <p className="py-6 text-center text-sm text-slate-400">Can&apos;t reach the board right now.</p>}
          {rows && rows.length === 0 && (
            <p className="py-6 text-center text-sm text-slate-400">
              {range === 'today' ? "No one has finished today's Daily yet. Be the first." : 'No finished Dailies yet.'}
            </p>
          )}
          {rows && rows.map((r) => (
            <div key={r.user_id} data-me={r.is_me || undefined}
              className={`flex items-center gap-2 border-b border-white/5 py-2 text-sm ${r.is_me ? 'rounded-lg bg-amber-400/10 px-2' : ''}`}>
              <span className="w-8 text-right font-black text-amber-200">#{r.place}</span>
              <span className="min-w-0 flex-1">
                <span className="block truncate font-bold">{r.username || 'Pilot'}{r.is_me ? ' (you)' : ''}</span>
                {range === 'alltime' && (
                  <span className="block text-[11px] leading-tight text-slate-400">best on {shortDay(r.day)} · {r.days_played} {r.days_played === 1 ? 'Daily' : 'Dailies'}</span>
                )}
              </span>
              <span className="text-xs text-slate-300">{scoreText(game, r.score)}</span>
              <span className="w-14 text-right text-xs tabular-nums text-slate-400">{formatMs(r.ms)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
