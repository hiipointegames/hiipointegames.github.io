import React, { useState, useEffect } from 'react';
import { Capacitor } from '@capacitor/core';
import { motion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { X } from 'lucide-react';
import { apiClient } from '@/transport';
import { playSound } from '@/ui/feedback';
import { getProfileById } from '@/player';
import { getPlayerBattleStats } from './playerBattles';
import { BLITZ_MODES, BLITZ_TIER_LABEL, BLITZ_TIER_ACCENT } from './blitzMode';
import { BATTLE_EXPERT_ENABLED } from './battleConfig';
import { blitzIsTimedRound } from './blitzMode';
import BattlePointsCard from './BattlePointsCard';
import BattleModeStatsPanel from './BattleModeStatsPanel';
import SoloModeStatsPanel from './SoloModeStatsPanel';

// `inline` renders the stats body as an in-page card (no fixed overlay, no
// body-scroll lock, no close buttons) so the Stats page can host the player's
// own Blitz stats. Default (false) is the modal used for viewing an opponent's
// stats from OtherProfile / Statistics.
export default function HeadToHeadStats({ onClose = () => {}, opponentId = null, onOpenLeaderboard = () => {}, inline = false }) {
  // The initial shape defines the state's TYPE, so every tier the setter writes
  // must appear here — omitting `expert` is what made tsc reject the widened
  // setters, and it is the same shape error that would have dropped Expert
  // numbers at runtime if the state had been untyped.
  const emptyBattleTier = () => ({
    totalBattles: 0, wins: 0, losses: 0, ties: 0,
    winPercentage: 0, totalPuzzlesSolved: 0, avgPuzzlesPerBattle: 0, bestRun: 0,
  });
  const emptySoloTier = () => ({ totalRuns: 0, totalPuzzlesSolved: 0, bestRun: 0 });

  const [battleStats, setBattleStats] = useState({
    easy: emptyBattleTier(), challenge: emptyBattleTier(), expert: emptyBattleTier(),
  });
  const [soloStats, setSoloStats] = useState({
    easy: emptySoloTier(), challenge: emptySoloTier(), expert: emptySoloTier(),
  });
  const [loading, setLoading] = useState(true);
  // Distinct from `loading`: "we tried and could not" is a different statement to
  // "we have not finished trying", and both are different from "there is nothing
  // to show". Only the last of the three may render a zero.
  const [loadFailed, setLoadFailed] = useState(false);
  const [activeTab, setActiveTab] = useState('battleEasy');

  // Which tiers get a tab.
  //
  // Expert is filtered out until BATTLE_EXPERT_ENABLED, so the flag stays the ONE
  // switch: flipping it reveals the tabs and enables battle creation together.
  // Showing an Expert tab before then would advertise a mode nobody can play.
  //
  // The panels read `battleStats[tier]` / `soloStats[tier]`, which already carry
  // an `expert` bucket (widened in the same slice as the producers), so the data
  // is correct BEFORE the tab exists rather than after.
  const tiers = BLITZ_MODES.filter((m) => m !== 'expert' || BATTLE_EXPERT_ENABLED);

  // Selected-tab styling, derived from the tier's OWN accent.
  //
  // This was three hand-written Tailwind gradients that re-stated, in literals,
  // the mapping `BLITZ_TIER_ACCENT` already owns — emerald/green for Easy,
  // cyan/blue for Challenge, amber/yellow for Expert. The comment here said it
  // kept them deliberately because "moving to the tier tokens is the D6 stats
  // overhaul, which redesigns these panels wholesale". This IS that overhaul
  // (2026-09-10), so the preservation is lifted and the literals are gone: a tab
  // now asks the same function every other tier-coloured surface asks, and a
  // fourth tier would style itself.
  //
  // Expert still takes GOLD and never the Colosseum's magenta — that ruling lives
  // in blitzMode.js and is enforced by blitzTierAccent.test.js.
  //
  // All three selected tabs take DARK text. Two of them previously used white on
  // a mid-tone gradient; against the real accents — neon green, cyan and gold —
  // dark is the legible choice, and Expert already did exactly this.
  const tabSelectedStyle = (tier) => {
    const accent = BLITZ_TIER_ACCENT(tier);
    return {
      background: `linear-gradient(135deg, ${accent} 0%, color-mix(in srgb, ${accent} 55%, black) 100%)`,
      color: 'var(--u37-bg)',
      boxShadow: `0 0 18px -6px ${accent}`,
    };
  };
  const TAB_IDLE_STYLE = {
    background: 'var(--u37-surface-2)',
    color: 'var(--u37-muted)',
    border: '1px solid var(--u37-hair)',
  };
  const TAB_BASE = 'px-2.5 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all min-h-[36px] sm:min-h-[40px]';

  /** `kind` is 'solo' | 'battle'; the tab id is kind + capitalised tier. */
  const tabId = (kind, tier) => `${kind}${tier.charAt(0).toUpperCase()}${tier.slice(1)}`;

  const renderTab = (kind, tier) => {
    const id = tabId(kind, tier);
    return (
      <button
        key={id}
        data-testid={`tab-${id}`}
        onClick={() => { playSound('buttonTap'); setActiveTab(id); }}
        className={TAB_BASE}
        style={activeTab === id ? tabSelectedStyle(tier) : TAB_IDLE_STYLE}
      >
        {`${kind === 'solo' ? 'Solo' : 'Battle'} ${BLITZ_TIER_LABEL(tier)}`}
      </button>
    );
  };
  const [battlePoints, setBattlePoints] = useState(0);

  useEffect(() => {
    const loadStats = async () => {
      try {
        const currentUser = await apiClient.auth.me();
        const targetUserId = opponentId || currentUser.id;

        // Fetch opponent's stats from PublicProfile directly (more reliable than Edge Function)
        // Fetch opponent's stats from PublicProfile directly (more reliable than Edge Function)
        let opponentGameStats = {};
        let targetId = targetUserId;

        try {
          const profile = await getProfileById(targetUserId);
          if (profile) {
            // Use the stats JSON column
            opponentGameStats = profile.stats || {};
          } else {
            // Fallback to current user stats if profile not found (for self-view)
            if (!opponentId) {
              opponentGameStats = currentUser['game_stats'] || {};
            }
          }
        } catch (err) {
          console.warn('Failed to fetch profile stats, falling back:', err);
          if (!opponentId) {
            opponentGameStats = currentUser['game_stats'] || {};
          }
        }

        // Fetch this player's completed-battle record from the one read path.
        // Completed-only: forfeited/expired battles no longer pad the record.
        const battleRecord = await getPlayerBattleStats(targetId);

        const toDisplayStats = (m) => ({
          totalBattles: m.totalBattles,
          wins: m.wins,
          losses: m.losses,
          ties: m.ties,
          winPercentage: m.totalBattles > 0 ? Math.round((m.wins / m.totalBattles) * 100) : 0,
          totalPuzzlesSolved: m.totalPuzzlesSolved,
          avgPuzzlesPerBattle: m.totalBattles > 0
            ? parseFloat((m.totalPuzzlesSolved / m.totalBattles).toFixed(1))
            : 0,
          bestRun: m.bestRun,
        });

        // Expert reads the same shape as the other two. It is included here even
        // though BATTLE_EXPERT_ENABLED is false: a producer that emits a bucket no
        // reader knows about DROPS those numbers on the floor, which is strictly
        // worse than filing them in the wrong drawer — so producer and reader
        // widen in the same slice, never separately.
        setBattleStats({
          easy: toDisplayStats(battleRecord.byMode.easy),
          challenge: toDisplayStats(battleRecord.byMode.challenge),
          expert: toDisplayStats(battleRecord.byMode.expert),
        });

        // Load solo blitz stats from opponent's game_stats
        // solo_blitz is snake_case when read from PublicProfile.stats (other users)
        // soloBlitz is camelCase when read directly from currentUser.game_stats (self-view fallback)
        const soloBlitz = opponentGameStats.solo_blitz || opponentGameStats.soloBlitz
          || { easy: {}, challenge: {}, expert: {} };

        // Every tier reads the same three fields, so read them the same way rather
        // than repeating the block a third time.
        const soloTier = (tier) => ({
          totalRuns: soloBlitz[tier]?.totalRuns || 0,
          totalPuzzlesSolved: soloBlitz[tier]?.totalPuzzlesSolved || 0,
          bestRun: soloBlitz[tier]?.bestRun || 0,
        });

        setSoloStats({
          easy: soloTier('easy'),
          challenge: soloTier('challenge'),
          // Absent for every player until Expert solo runs exist — soloTier
          // returns zeros rather than undefined, so the tab renders empty rather
          // than crashing on a missing key.
          expert: soloTier('expert'),
        });

        // Battle points come from the same record (completed wins only).
        setBattlePoints(battleRecord.battlePoints);

        setLoading(false);
      } catch (error) {
        console.error('Failed to load stats:', error);
        // A FAILED LOAD IS NOT AN EMPTY ACCOUNT.
        //
        // This used to log and stop, leaving the zeroed initial state on screen —
        // so a network failure produced a complete, plausible, entirely fictional
        // record: 0 battles, 0 wins, 0%. The player had no way to tell "we could
        // not reach the server" from "you have never played". Saying nothing is
        // not the safe option when the thing you render instead is a claim.
        setLoadFailed(true);
        setLoading(false);
      }
    };

    setLoadFailed(false);
    loadStats();
  }, [opponentId]);

  // Prevent background scrolling — only when shown as a modal overlay.
  useEffect(() => {
    if (inline) return undefined;
    document.body.style.overflow = 'hidden';
    return () => {
      document.body.style.overflow = '';
    };
  }, [inline]);

  if (loadFailed) {
    const message = (
      <div className="text-center py-8 px-4">
        <div className="text-3xl mb-2" aria-hidden="true">⚠️</div>
        <div className="font-bold mb-1" style={{ color: 'var(--u37-danger)' }}>
          Could not load Blitz stats
        </div>
        <div className="text-sm" style={{ color: 'var(--u37-muted)' }}>
          Check your connection and try again — your record is safe.
        </div>
      </div>
    );
    return inline ? message : (
      <div
        className="fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm"
        style={{ background: 'var(--u37-scrim)' }}
      >
        {message}
      </div>
    );
  }

  if (loading) {
    return inline ? (
      <div className="flex items-center justify-center py-10" style={{ color: 'var(--u37-muted)' }}>Loading stats…</div>
    ) : (
      <div className="fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm" style={{ background: 'var(--u37-scrim)' }}>
        <div className="text-xl" style={{ color: 'var(--u37-text)' }}>Loading stats...</div>
      </div>
    );
  }

  const body = (
    <>
        {/* The 🛡️ "Blitz Modes Stats" heading is dropped in the inline (Blitz
            carousel / Stats-page) path — the carousel's own "Stats" label already
            names it, so an in-card title double-labels. The modal (opponent view
            from OtherProfile / Statistics) keeps the heading + its close button. */}
        {!inline && (
          <div className="flex items-center justify-center gap-2 sm:gap-3 mb-4 sm:mb-6 relative">
            <div className="text-xl sm:text-2xl">🛡️</div>
            <h2
              className="text-lg sm:text-2xl font-black"
              style={{ color: 'var(--u37-magenta)', textShadow: '0 0 12px color-mix(in srgb, var(--u37-magenta) 45%, transparent)' }}
            >
              Blitz Modes Stats
            </h2>
            <div className="text-xl sm:text-2xl">🛡️</div>
            <button onClick={() => {
              playSound('buttonTap');
              onClose();
            }} className="absolute right-0 transition-colors" style={{ color: 'var(--u37-muted)' }}>
              <X className="w-5 h-5 sm:w-6 sm:h-6" />
            </button>
          </div>
        )}

        {/* Battle Points Display */}
        <motion.div
          initial={{ opacity: 0, y: -10 }}
          animate={{ opacity: 1, y: 0 }}
          className="flex justify-center mb-4 sm:mb-6"
        >
          <BattlePointsCard points={battlePoints} compact={inline} />
        </motion.div>

        {/* Battle Points Leaderboard Button */}
        {onOpenLeaderboard && (
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            className="mb-4 sm:mb-6"
            whileHover={{ scale: 1.02 }}
          >
            <Button
              onClick={onOpenLeaderboard}
              className={`w-full font-black text-base sm:text-lg ${inline ? 'min-h-[48px]' : 'min-h-[56px]'} touch-manipulation shadow-xl border-2 active:scale-95 transition-all text-white`}
              style={{
                background: 'var(--u37-grad-blitz-battle)',
                borderColor: 'color-mix(in srgb, var(--u37-magenta) 55%, transparent)',
                boxShadow: '0 0 22px -8px var(--u37-magenta)',
              }}
            >
              <span className="text-2xl mr-2">🌍</span>
              <span className="text-white">
                Battle Points Global Leaderboard
              </span>
            </Button>
          </motion.div>
        )}

        {/* Tab Navigation */}
        <div className="grid grid-cols-2 gap-2 sm:gap-3 mb-4 sm:mb-6">
          {/* One column per arena, one row per tier. */}
          <div className="flex flex-col gap-2 sm:gap-3">
            {tiers.map((tier) => renderTab('solo', tier))}
          </div>
          <div className="flex flex-col gap-2 sm:gap-3">
            {tiers.map((tier) => renderTab('battle', tier))}
          </div>
        </div>

        {/* The panel for whichever tab is active, driven by the SAME tier list as
            the tabs — so a tier can never get a button with no panel behind it. */}
        {tiers.map((tier) => (activeTab === tabId('battle', tier) ? (
          <BattleModeStatsPanel
            key={`battle-${tier}`}
            stats={battleStats[tier]}
            modeLabel={BLITZ_TIER_LABEL(tier)}
            // Easy battles are untimed rounds; Challenge and Expert are timed
            // races and label their average per round. Preserved exactly as it
            // shipped rather than unified — which label is right is a copy
            // question the D6 overhaul answers.
            {...(blitzIsTimedRound(tier) ? { avgLabel: 'Avg Puzzles (per round)' } : {})}
          />
        ) : null))}

        {tiers.map((tier) => (activeTab === tabId('solo', tier) ? (
          <SoloModeStatsPanel
            key={`solo-${tier}`}
            stats={soloStats[tier]}
            modeLabel={BLITZ_TIER_LABEL(tier)}
          />
        ) : null))}

        {!inline && (
          <Button
            onClick={onClose}
            className="w-full mt-4 sm:mt-6 font-bold min-h-[44px] text-sm sm:text-base"
            style={{ background: 'linear-gradient(135deg, var(--u37-violet) 0%, var(--u37-magenta) 100%)', color: 'var(--u37-text)' }}
          >
            Close
          </Button>
        )}
        {/* Spacer reserving native iOS AdMob banner height. On web the banner
            placeholder (WebAdSlot) sits BEHIND this modal's z-50 backdrop, so
            the gap would be dead space — collapse it off-native. */}
        {!inline && Capacitor.isNativePlatform() && <div className="h-16 sm:h-0 flex-shrink-0" />}
    </>
  );

  // Inline: render the body as a plain card for embedding in the Stats page /
  // Blitz "Stats" carousel slide. The wrapper border + heavy padding are dropped
  // here (item 9 condense) because this card sits INSIDE the carousel's own card
  // — the double border + double padding wasted vertical space on phones. The
  // modal path below (opponent view) keeps its full border + p-4 sm:p-6.
  if (inline) {
    return (
      <div className="rounded-2xl sm:rounded-3xl p-2 sm:p-3 w-full" style={{ background: 'linear-gradient(135deg, var(--u37-bg) 0%, color-mix(in srgb, var(--u37-violet) 18%, var(--u37-bg)) 50%, var(--u37-bg) 100%)' }}>
        {body}
      </div>
    );
  }

  // Modal overlay (opponent view from OtherProfile / Statistics).
  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      className="fixed inset-0 z-[60] flex items-center justify-center backdrop-blur-sm p-4 u37-ad-safe-pb"
      style={{ background: 'var(--u37-scrim)' }}
    >
      {/* ⚠️ max-h-full, NOT a hand-computed viewport subtraction.
          Reported by David 2026-09-12: the Blitz stats screen "gets cut off at the
          top so that the title and the x are not fully visible".

          It was `max-h-[calc(100dvh-110px)]`. That 110px was a guess at the
          overlay's own padding, and it left out `--u37-nav-reserved` — the bottom
          nav bar — which `u37-ad-safe-pb` on the parent DOES reserve. Measured in a
          reproduction of this exact markup at 800px tall with a 60px ad banner and
          a 64px nav bar:

              container content box   652px
              panel (old max-h)       690px   <- 38px too tall
              panel top edge           -3px
              clipped off the top      19px   <- unreachable

          Half the overflow goes off the TOP because the parent centres with
          `items-center`, and an overflowing centred flex item is pushed out both
          ways — so the title and the ✕ end up above the viewport, where no amount
          of scrolling reaches them (the overlay is `fixed`; only the panel's own
          body scrolls).

          `max-h-full` is 100% of the parent's CONTENT box, which already has the
          padding subtracted — including whatever the ad banner and nav bar are at
          runtime. Same reproduction: panel 652px, top edge +16px, clipped 0px. */}
      <motion.div
        initial={{ scale: 0.9, y: 20 }}
        animate={{ scale: 1, y: 0 }}
        className="rounded-2xl sm:rounded-3xl p-4 sm:p-6 max-w-2xl w-full border-2 shadow-2xl max-h-full overflow-auto"
        style={{ background: 'linear-gradient(135deg, var(--u37-bg) 0%, color-mix(in srgb, var(--u37-violet) 18%, var(--u37-bg)) 50%, var(--u37-bg) 100%)', borderColor: 'color-mix(in srgb, var(--u37-violet) 30%, transparent)' }}
      >
        {body}
      </motion.div>
    </motion.div>
  );
}