import React from 'react';

// One labeled stat tile in the Blitz stats panels (Total Battles / Win Rate /
// Best Run …). Extracted from the ~16 byte-identical inline tiles across the
// four HeadToHeadStats tab bodies (R7 decomposition). `valueClassName` carries
// the per-stat accent color (emerald win-rate, amber best-run, etc.).
export default function BattleStatCard({ label, value, valueColor = 'var(--u37-text)' }) {
  return (
    <div
      className="rounded-lg sm:rounded-xl p-3 sm:p-4 border"
      style={{ background: 'var(--u37-surface-2)', borderColor: 'var(--u37-hair)' }}
    >
      <div className="text-xs sm:text-sm mb-0.5 sm:mb-1" style={{ color: 'var(--u37-muted)' }}>{label}</div>
      <div className="text-2xl sm:text-3xl font-black" style={{ color: valueColor }}>{value}</div>
    </div>
  );
}
