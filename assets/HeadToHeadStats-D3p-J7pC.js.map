import React from 'react';
import { Link } from 'react-router-dom';
import BattleStatCard from './BattleStatCard';
import { createPageUrl } from '@/routing/createPageUrl';

// The inline WIN_ACHIEVEMENTS emoji grid is GONE (device feedback, 2026-08-05).
//
// It was the pre-badge design: a flat 🏆/🥊/🎖️/⚔️/💪/👑 ladder at 1/5/10/25/50/100
// wins, hardcoded here. The badge registry already ships that EXACT ladder —
// same six thresholds, same six tier names — as the `blitzWinLadder` badge, so
// this grid was a second surface rendering one truth. That is the drift the
// badge system was built to end, and it is why deleting the grid removes no
// player progress: the wins are still tracked, still tiered, and now shown in
// badge language on the one surface that owns them.
//
// game-mechanics used to MIRROR this constant (it must not import a UI module)
// and pin the mirror with a source-text drift guard in badgeRegistry.test.js.
// With the constant deleted, the registry is the sole declaration — the guard
// is inverted to assert no rival ladder comes back here.
//
// NOTE: SoloModeStatsPanel's COMPLETION_ACHIEVEMENTS grid is deliberately NOT
// touched. It ladders solo RUN COUNT, which no badge covers (the soloBlitz
// badges track puzzles-per-run, all-time puzzles and speed). Deleting that one
// would destroy progress rather than de-duplicate it.

// One battle TIER's stats panel — Easy, Challenge or Expert. Collapses the
// byte-identical battle tab bodies from HeadToHeadStats into a single reused
// component (R7 decomposition). `avgLabel` differs by tier: Easy battles are
// untimed rounds and read "Avg Puzzles", while Challenge AND Expert are timed
// races and read "Avg Puzzles (per round)".
//
// Said "(Easy or Challenge)" until 2026-09-10. Like the solo panel, this has no
// tier logic of its own — the tier arrives as `modeLabel` — so it has always
// been correct for three.
export default function BattleModeStatsPanel({ stats, modeLabel, avgLabel = 'Avg Puzzles' }) {
  return (
    <div className="space-y-6">
      {/* Core Stats */}
      <div className="grid grid-cols-2 gap-2 sm:gap-4">
        <BattleStatCard label="Total Battles" value={stats.totalBattles} />
        <BattleStatCard label="Win Rate" value={`${stats.winPercentage}%`} valueColor="var(--u37-success)" />
        <BattleStatCard label={avgLabel} value={stats.avgPuzzlesPerBattle} valueColor="var(--u37-violet)" />
        <BattleStatCard label="Best Run" value={stats.bestRun} valueColor="var(--u37-gold)" />
      </div>

      {/* Record */}
      <div
        className="rounded-lg sm:rounded-xl p-4 sm:p-6 border"
        style={{
          background: 'linear-gradient(135deg, var(--u37-surface-2) 0%, color-mix(in srgb, var(--u37-violet) 14%, transparent) 100%)',
          borderColor: 'color-mix(in srgb, var(--u37-violet) 30%, transparent)',
        }}
      >
        <h3 className="text-base sm:text-lg font-bold mb-3 sm:mb-4" style={{ color: 'var(--u37-violet)' }}>Battle Record</h3>
        <div className="flex justify-around">
          <div className="text-center">
            <div className="text-2xl sm:text-3xl font-black" style={{ color: 'var(--u37-success)' }}>{stats.wins}</div>
            <div className="text-xs sm:text-sm" style={{ color: 'var(--u37-muted)' }}>Wins</div>
          </div>
          <div className="text-center">
            <div className="text-2xl sm:text-3xl font-black" style={{ color: 'var(--u37-danger)' }}>{stats.losses}</div>
            <div className="text-xs sm:text-sm" style={{ color: 'var(--u37-muted)' }}>Losses</div>
          </div>
        </div>
      </div>

      {/* Badges pointer — replaces the deleted emoji grid. Keeps win progress
          reachable from where players already look for it, without rendering a
          second copy of the ladder here. */}
      <div data-testid="battle-badges-pointer">
        <h3 className="text-base sm:text-lg font-bold mb-2 sm:mb-3" style={{ color: 'var(--u37-text)' }}>Achievements ({modeLabel})</h3>
        <p className="text-sm mb-2" style={{ color: 'var(--u37-muted)' }}>
          Battle wins are tracked as a badge that levels up as you win.
        </p>
        <Link
          to={createPageUrl('Badges')}
          className="block w-full rounded-xl border py-2.5 text-center text-sm font-black transition-transform active:scale-[0.98]"
          style={{
            borderColor: 'color-mix(in srgb, var(--u37-gold) 45%, transparent)',
            background: 'color-mix(in srgb, var(--u37-gold) 12%, transparent)',
            color: 'var(--u37-gold)',
          }}
        >
          View your badges →
        </Link>
      </div>
    </div>
  );
}
