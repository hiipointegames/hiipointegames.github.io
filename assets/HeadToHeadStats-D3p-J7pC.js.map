import React from 'react';
import BattleStatCard from './BattleStatCard';
import AchievementBadge from './AchievementBadge';

// Completion-count achievement ladder — identical across Solo Easy and Solo
// Challenge (was duplicated inline in both solo tab bodies).
const COMPLETION_ACHIEVEMENTS = [
  { label: 'First Completion', icon: '🎯', threshold: 1 },
  { label: '5 Completions', icon: '🔵', threshold: 5 },
  { label: '10 Completions', icon: '🟢', threshold: 10 },
  { label: '25 Completions', icon: '🟡', threshold: 25 },
  { label: '50 Completions', icon: '🟠', threshold: 50 },
  { label: '100 Completions', icon: '🔴', threshold: 100 },
];

// One solo blitz TIER's stats panel — Easy, Challenge or Expert. Collapses the
// byte-identical solo tab bodies from HeadToHeadStats into a single reused
// component (R7 decomposition).
//
// Said "(Easy or Challenge)" until 2026-09-10. It was rendered per-tier from a
// three-tier list even then; only BATTLE_EXPERT_ENABLED kept the Expert tab out
// of sight. The panel itself has no tier logic at all — the tier arrives as the
// `modeLabel` string — so it has always been correct for three.
export default function SoloModeStatsPanel({ stats, modeLabel }) {
  const avgPerRun = stats.totalRuns > 0
    ? (stats.totalPuzzlesSolved / stats.totalRuns).toFixed(1)
    : 0;

  return (
    <div className="space-y-6">
      {/* Core Stats */}
      <div className="grid grid-cols-2 gap-2 sm:gap-4">
        <BattleStatCard label="Total Runs" value={stats.totalRuns} />
        <BattleStatCard label="Total Solved" value={stats.totalPuzzlesSolved} valueColor="var(--u37-success)" />
        <BattleStatCard label="Avg Per Run" value={avgPerRun} valueColor="var(--u37-violet)" />
        <BattleStatCard label="Best Run" value={stats.bestRun} valueColor="var(--u37-gold)" />
      </div>

      {/* Achievement Badges */}
      <div>
        <h3 className="text-lg font-bold mb-3" style={{ color: 'var(--u37-text)' }}>Achievements ({modeLabel})</h3>
        <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {COMPLETION_ACHIEVEMENTS.map((a) => (
            <AchievementBadge
              key={a.label}
              label={a.label}
              icon={a.icon}
              achieved={stats.totalRuns >= a.threshold}
            />
          ))}
        </div>
      </div>
    </div>
  );
}
