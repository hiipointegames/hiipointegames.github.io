// Sector 73 Daily leaderboards — the app's side (David, 2026-10-14). The server is the referee
// (supabase/migrations/20261015000000_sector73_daily_boards.sql): it claims one attempt per account
// per game per day, ranks the results, and times them.
//
//   startDaily(game)        → { used, finished } from the server, or null when it can't be reached
//                             (offline / signed out): the phone's own one-attempt rule still applies.
//   finishDaily(game, score)→ 'posted' (the server has it) | 'queued' (server unreachable: it waits on the
//                             phone and flushPendingDailies() sends it next time) | 'dropped' (the
//                             server has no attempt to finish — e.g. START was offline).
//   fetchBoard(game)        → today's top 37 + the caller's place.
//
// A timed Daily in progress is announced on window as DAILY_RUN_EVENT { game } at START and
// { game: null } at FINISH, so the page can hold back a live-duel Accept that would yank the pilot out
// of it (live battles S6 review M5). The page also forgets it when the mode closes (an abandoned run).

import { supabase } from '@/transport/supabaseClient';

export const BOARD_GAMES = Object.freeze(['hyperjump', 'firstContact', 'reEntry', 'starChart']);
const PENDING_KEY = 'sector73.daily.pending';

export const DAILY_RUN_EVENT = 'sector73:daily-run';
const safe = (fn, fallback) => { try { return fn(); } catch { return fallback; } };
const announce = (game) => safe(() => globalThis.dispatchEvent?.(new CustomEvent(DAILY_RUN_EVENT, { detail: { game } })));
const readPending = () => safe(() => JSON.parse(globalThis.localStorage?.getItem(PENDING_KEY) ?? '[]'), []);
const writePending = (list) => safe(() => globalThis.localStorage?.setItem(PENDING_KEY, JSON.stringify(list.slice(-10))));

/** @returns {Promise<{ used: boolean, finished: boolean } | null>} */
export async function startDaily(game) {
  try {
    const { data, error } = await supabase.rpc('sector73_daily_start', { p_game: game });
    if (error || !data) { announce(game); return null; } // unreachable: the phone's own rule lets it run
    if (!data.used) announce(game);
    return { used: Boolean(data.used), finished: Boolean(data.finished) };
  } catch {
    announce(game);
    return null;
  }
}

/** Record a Daily result. @returns {Promise<'posted'|'queued'|'dropped'>} */
export async function finishDaily(game, score) {
  announce(null);
  try {
    const { error } = await supabase.rpc('sector73_daily_finish', { p_game: game, p_score: score });
    if (error) {
      // "no Daily attempt to finish" = never started on the server (offline START) or already
      // recorded: retrying cannot help, so it is dropped rather than queued.
      if (/no Daily attempt/.test(error.message || '')) return 'dropped';
      throw error;
    }
    return 'posted';
  } catch {
    writePending([...readPending().filter((p) => p.game !== game), { game, score }]);
    return 'queued';
  }
}

/**
 * Send the offline queues in the right order: Daily results FIRST, then stars — the Daily Core's 5★ is
 * paid only once the server holds that finished Daily (20261019000000), so sending stars first would be
 * refused and wait a whole launch.
 * @param {() => Promise<unknown>} flushStars  stars.js flushPendingStars (passed in: no import cycle)
 */
export async function flushSector73Queues(flushStars) {
  try { await flushPendingDailies(); } finally { await flushStars(); }
}

/** Send results that finished while the server couldn't be reached. */
export async function flushPendingDailies() {
  const list = readPending();
  if (!list.length) return;
  writePending([]);
  for (const p of list) await finishDaily(p.game, p.score);
}

/**
 * @returns {Promise<Array<{ place: number, user_id: string, username: string|null, country: string|null,
 *   score: any, ms: number, is_me: boolean, players: number }> | null>} null = could not load
 */
export async function fetchBoard(game, day = null) {
  try {
    const { data, error } = await supabase.rpc('sector73_daily_board', { p_game: game, p_day: day });
    if (error) return null;
    return data || [];
  } catch {
    return null;
  }
}

/** "1:05.3" from milliseconds. */
export function formatMs(ms) {
  const t = Math.max(0, Math.round((ms || 0) / 100));
  const m = Math.floor(t / 600); const s = Math.floor((t % 600) / 10);
  return `${m}:${String(s).padStart(2, '0')}.${t % 10}`;
}

/** One line describing a result, per game. */
export function scoreText(game, score) {
  if (!score) return '—';
  if (game === 'hyperjump') return `Cleared ${score.jump} ${score.jump === 1 ? 'jump' : 'jumps'} · ${Number(score.lightYears || 0).toLocaleString()} ly`;
  if (game === 'firstContact') return score.solved ? `${score.transmissions} transmission${score.transmissions === 1 ? '' : 's'}` : 'Not decoded';
  if (game === 'reEntry') return score.landed ? (score.undos ? `Landed · ${score.undos} undo${score.undos === 1 ? '' : 's'}` : 'Landed · no undos') : 'Gave up';
  if (game === 'starChart') { // seconds already include the +37 s hint/check penalties
    const s = Math.max(0, Math.round(score.seconds || 0));
    const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;
    const extras = [score.hints ? plural(score.hints, 'hint') : null, score.checks ? plural(score.checks, 'check') : null].filter(Boolean);
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')} · ${extras.length ? extras.join(' · ') : 'clean'}`;
  }
  return '—';
}

export const GAME_TITLE = Object.freeze({ hyperjump: 'Hyperjump', firstContact: 'First Contact', reEntry: 'Re-Entry', starChart: 'Star Chart' });
