import React from 'react';
import { createPortal } from 'react-dom';
import { mmss } from './reconnectClock';

// The in-world live-duel invites (slice S6 + the S8 minimum): an incoming invite toast with its
// countdown and Accept / Decline, my outgoing "Waiting for …" pill with Cancel, and a one-line note
// (declined, expired, busy…). Portaled to <body> on purpose: inside #root, iOS traps z-index under
// the body-portaled nav (memory: ios-overlays-must-portal), and the toast must sit above any mode.

export const STYLE_NAME = Object.freeze({ easy: 'Easy', challenge: 'Challenge', expert: 'Expert', mixed: 'Mixed race' });

const secsTo = (at, now) => Math.max(0, Math.ceil((at - now) / 1000));

/**
 * holdAccept: a timed Daily is running (S6 review M5) — the toast offers Decline only, and says why;
 * the invite stays (with its countdown) so it can still be accepted once the Daily is done.
 * inWorld (world lane 2026-10-22): over the world map the notices sit BELOW the FLY button (they used to
 * cover it, and the ★ line); inside a game they keep their place near the top.
 * @param {{ live: ReturnType<typeof import('./useDuelInvites').useDuelInvites>, holdAccept?: boolean, inWorld?: boolean }} props
 */
export const NOTICE_TOP = Object.freeze({ world: 112, mode: 64 }); // px under the safe area

export default function DuelInvites({ live, holdAccept = false, inWorld = false }) {
  if (!live?.enabled) return null;
  const { incoming, outgoing, note, clock } = live;
  if (!incoming.length && !outgoing && !note) return null;
  const inv = incoming[0];
  return createPortal(
    <div className="pointer-events-none fixed inset-x-0 z-[400] flex flex-col items-center gap-2 px-3"
      style={{ top: `calc(var(--safe-top, 0px) + ${inWorld ? NOTICE_TOP.world : NOTICE_TOP.mode}px)` }}
      data-testid="duel-invites" data-place={inWorld ? 'world' : 'mode'} data-top={inWorld ? NOTICE_TOP.world : NOTICE_TOP.mode}>
      {inv && (
        <div data-testid="duel-invite-toast" data-duel={inv.duelId}
          className="pointer-events-auto w-full max-w-sm rounded-2xl border border-fuchsia-300/60 bg-[#0b0820]/95 p-3 text-white"
          style={{ boxShadow: '0 0 30px -10px #e879f9' }}>
          <div className="text-[10px] font-bold uppercase tracking-[0.3em] text-fuchsia-300/90">⚔️ Live duel</div>
          <div className="mt-0.5 text-sm font-black">
            <span data-testid="duel-invite-from">{inv.name}</span> challenges you
          </div>
          <div className="text-xs text-slate-300">
            {STYLE_NAME[inv.style] ?? inv.style} · first to {inv.firstTo} · expires in <span data-testid="duel-invite-expires" className="tabular-nums">{mmss(secsTo(inv.expiresAt, clock))}</span>
          </div>
          <div className="mt-2 grid grid-cols-2 gap-2">
            <button type="button" data-testid="duel-invite-decline" onClick={() => live.decline(inv)}
              className="rounded-xl border border-white/25 bg-white/5 py-2 text-sm font-black text-slate-100 active:scale-95">Decline</button>
            {holdAccept ? (
              <div data-testid="duel-invite-held" className="grid place-items-center rounded-xl border border-white/15 px-1 text-center text-[11px] font-bold leading-tight text-slate-300">Finish your Daily first</div>
            ) : (
              <button type="button" data-testid="duel-invite-accept" onClick={() => live.accept(inv)}
                className="rounded-xl border border-fuchsia-300/70 bg-fuchsia-500/30 py-2 text-sm font-black text-fuchsia-50 active:scale-95">Accept</button>
            )}
          </div>
          {incoming.length > 1 && <div className="mt-1 text-center text-[10px] text-slate-400">+{incoming.length - 1} more</div>}
        </div>
      )}
      {outgoing && (
        <div data-testid="duel-outgoing" data-duel={outgoing.duelId}
          className="pointer-events-auto flex items-center gap-3 rounded-full border border-fuchsia-300/60 bg-black/80 px-4 py-2 text-sm text-fuchsia-100">
          <span>⚔️ Waiting for <b>{outgoing.name}</b>… <span className="tabular-nums" data-testid="duel-outgoing-expires">{mmss(secsTo(outgoing.expiresAt, clock))}</span></span>
          <button type="button" data-testid="duel-outgoing-cancel" onClick={() => live.cancelOutgoing()}
            className="rounded-full border border-white/25 px-2 py-0.5 text-xs font-bold text-slate-200">Cancel</button>
        </div>
      )}
      {note && (
        <div data-testid="duel-invite-note" className="rounded-full border border-white/20 bg-black/80 px-4 py-1.5 text-xs font-bold text-slate-100">{note}</div>
      )}
    </div>,
    document.body,
  );
}

const MODE_LABEL = Object.freeze({
  hyperjump: 'Hyperjump', firstContact: 'First Contact', starChart: 'Star Chart', reEntry: 'Re-Entry',
  starMarket: 'the Star Market', battle: 'this battle', duel: 'the practice duel',
  thirtySeven: 'this round of 37', // world lane 2026-10-22: it used to say "this game"
});

/**
 * A duel was accepted while another mode is open (S6 review M5): ask, never yank the pilot out of a
 * Daily in progress. Go opens the duel; Stay cancels it (it was not live yet: no forfeit, no ★).
 * @param {{ name: string, mode: string|null, onGo: () => void, onStay: () => void }} props
 */
export function LeaveForDuelPrompt({ name, mode, onGo, onStay }) {
  const what = MODE_LABEL[mode] ?? 'this game';
  return createPortal(
    <div className="fixed inset-0 z-[410] grid place-items-center bg-black/70 px-6" data-testid="duel-leave-mode-prompt">
      <div className="w-full max-w-sm rounded-2xl border border-fuchsia-300/60 bg-[#0b0820] p-5 text-center text-white">
        <div className="text-[10px] font-bold uppercase tracking-[0.3em] text-fuchsia-300/90">⚔️ Live duel</div>
        <div className="mt-1 text-lg font-black">{name} is ready to duel</div>
        <p className="mt-1 text-sm text-slate-300">Leave {what} for the duel?</p>
        <div className="mt-4 grid grid-cols-2 gap-2">
          <button type="button" data-testid="duel-leave-mode-stay" onClick={onStay}
            className="rounded-xl border border-white/25 bg-white/5 py-2.5 text-sm font-black">Stay</button>
          <button type="button" data-testid="duel-leave-mode-go" onClick={onGo}
            className="rounded-xl border border-fuchsia-300/70 bg-fuchsia-500/30 py-2.5 text-sm font-black">Go to the duel</button>
        </div>
      </div>
    </div>,
    document.body,
  );
}
