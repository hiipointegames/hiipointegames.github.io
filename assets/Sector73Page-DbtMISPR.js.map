import React from 'react';
import { motion } from 'framer-motion';

// Soft landing (W2, 2026-10-19): the portal entry ends on a white flash; the cockpit then fades in
// from that white over ~0.5 s, so the hand-over reads as one move instead of a hard cut. Only when
// the flash really reached white (state.entry === 'white', set by useMirrorWarp) and the phone
// isn't asking for less motion — after a skip or a reduced-motion entry the screen was dark, and a
// white fade there would ADD a flash.

export const ARRIVAL_FADE_S = 0.5;

/**
 * @param {{ entry?: string } | null | undefined} state  the route's location.state
 * @param {boolean} reduced  prefers-reduced-motion
 */
export const fadesFromWhite = (state, reduced) => state?.entry === 'white' && !reduced;

/** The white veil, fading out; onDone when it has gone. Never takes a tap. */
export default function ArrivalFade({ onDone }) {
  return (
    <motion.div
      data-testid="arrival-fade"
      aria-hidden="true"
      className="pointer-events-none absolute inset-0 z-[60] bg-white"
      initial={{ opacity: 1 }}
      animate={{ opacity: 0 }}
      transition={{ duration: ARRIVAL_FADE_S, ease: 'easeOut' }}
      onAnimationComplete={onDone}
    />
  );
}
