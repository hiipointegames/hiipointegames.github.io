import React, { useState } from 'react';
import { STYLE_NAME } from './DuelInvites';

// The pilot card's live challenge (slice S6): pick the dice and the match length, send the invite.
// The challenger picks (interview): Easy / Challenge / Expert / Mixed race; first to 3, 5 (default),
// 7 or 10. The server refuses what it must ("cannot invite that pilot", cooldowns, the switch) and
// the reason is shown here.

export const LIVE_STYLES = Object.freeze(['easy', 'challenge', 'expert', 'mixed']);
export const LIVE_FIRST_TO = Object.freeze([3, 5, 7, 10]);

/**
 * @param {{ pilotName: string, onSend: (opts: { style: string, firstTo: number }) => Promise<string|null>,
 *   onBack: () => void }} props
 */
export default function LiveChallengePicker({ pilotName, onSend, onBack }) {
  const [style, setStyle] = useState('easy');
  const [firstTo, setFirstTo] = useState(5);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState(/** @type {string|null} */ (null));
  const send = async () => {
    if (busy) return;
    setBusy(true);
    setError(null);
    const why = await onSend({ style, firstTo });
    setBusy(false);
    if (why) setError(why);
  };
  return (
    <div className="mt-3 space-y-3" data-testid="live-challenge">
      <p className="text-center text-xs text-slate-300">Live duel with {pilotName}: same dice, first correct 37 takes the round.</p>
      <div>
        <div className="mb-1 text-[10px] font-bold uppercase tracking-[0.25em] text-violet-300/80">Dice</div>
        <div className="grid grid-cols-4 gap-1.5">
          {LIVE_STYLES.map((id) => (
            <Pick key={id} testId={`live-style-${id}`} on={style === id} onPick={() => setStyle(id)}>{STYLE_NAME[id]}</Pick>
          ))}
        </div>
      </div>
      <div>
        <div className="mb-1 text-[10px] font-bold uppercase tracking-[0.25em] text-violet-300/80">First to</div>
        <div className="grid grid-cols-4 gap-1.5">
          {LIVE_FIRST_TO.map((n) => (
            <Pick key={n} testId={`live-first-to-${n}`} on={firstTo === n} onPick={() => setFirstTo(n)}>{n}</Pick>
          ))}
        </div>
      </div>
      {error && <p data-testid="live-challenge-error" className="text-center text-xs font-bold text-rose-300">{error}</p>}
      <button type="button" data-testid="live-challenge-send" disabled={busy} onClick={send}
        className="w-full rounded-xl border border-fuchsia-300/70 bg-fuchsia-500/25 py-3 text-sm font-black tracking-widest text-fuchsia-50 disabled:opacity-50 active:scale-95">
        {busy ? 'SENDING…' : '⚔️ SEND CHALLENGE'}
      </button>
      <button type="button" onClick={onBack} className="w-full text-center text-xs text-slate-400 underline">Back</button>
    </div>
  );
}

function Pick({ on, onPick, testId, children }) {
  return (
    <button type="button" data-testid={testId} aria-pressed={on} onClick={onPick}
      className={`rounded-lg border px-1 py-2 text-center text-xs font-black text-white active:scale-95 ${on ? 'border-fuchsia-300 bg-fuchsia-500/25' : 'border-white/15 bg-black/40'}`}>
      {children}
    </button>
  );
}
