// Sector 73's music (David, 2026-10-14: "some kind of cosmic ethereal music"). Generative, built
// from Web Audio like the sound effects — 0 KB of files, and never the same twice:
//
//   • a pad of slow, airy chords in D Lydian (the "dreamy" mode), one softly detuned voice per
//     note, fading from chord to chord every CHORD_SECONDS
//   • bell sparkles from a high pentatonic scale every few seconds
//   • a deep drone underneath
//   • everything through a long generated reverb, so it sounds like a big space
//
// Follows the same mute switch as the sound effects (the page starts/stops it). It plays while
// flying and dips under a mode (setLevel('dim')).
//
// LIGHT ON PURPOSE (S21 2026-10-14: "some static in the background music"). Static on a phone is
// usually the audio thread running out of time, not loudness — so the music has its own context
// with big buffers (synth.js musicContext), ONE oscillator per note (was two: up to 20 at once
// across a chord change), a short MONO reverb (was 5.5 s stereo, the costliest node), and a limiter
// at the end so overlapping notes can never clip.

import { musicContext } from './synth';

export const CHORD_SECONDS = 9;
export const LEVELS = Object.freeze({ fly: 0.16, dim: 0.05 });

const hz = (midi) => 440 * 2 ** ((midi - 69) / 12);
// D Lydian: D E F# G# A B C#. Each chord = MIDI notes (low to high).
export const CHORDS = Object.freeze([
  [50, 57, 64, 66, 73], // Dmaj9 (add #11 colour above)
  [47, 54, 61, 62, 68], // Bm(add9)
  [52, 59, 64, 68, 71], // E (add) — the Lydian II
  [45, 52, 57, 61, 64], // A sus/add9
]);
export const BELLS = Object.freeze([74, 76, 78, 81, 83, 86, 88]); // D E F# A B D E (pentatonic, high)

/** The chord playing at time t (seconds since the music began). */
export const chordAt = (t) => CHORDS[Math.floor(Math.max(0, t) / CHORD_SECONDS) % CHORDS.length];

export const REVERB_SECONDS = 2.8;
export const VOICES_PER_NOTE = 1;

function makeReverb(ac, seconds = REVERB_SECONDS) {
  const len = Math.floor(ac.sampleRate * seconds);
  const buf = ac.createBuffer(1, len, ac.sampleRate); // mono: half the work
  const d = buf.getChannelData(0);
  for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len) ** 2.6;
  const conv = ac.createConvolver();
  conv.buffer = buf;
  return conv;
}

/**
 * @returns {{ start: () => void, setLevel: (level: 'fly'|'dim') => void, stop: () => void }}
 */
export function createAmbience() {
  const noop = { start() {}, setLevel() {}, stop() {} };
  const ac = musicContext();
  if (!ac) return noop;
  try {
    const master = ac.createGain();
    master.gain.value = 0.0001;
    const reverb = makeReverb(ac);
    const wet = ac.createGain(); wet.gain.value = 0.7;
    const dry = ac.createGain(); dry.gain.value = 0.35;
    const bus = ac.createGain();
    bus.connect(dry).connect(master);
    bus.connect(reverb).connect(wet).connect(master);
    // A limiter last: however notes stack up, the output never clips.
    const limiter = ac.createDynamicsCompressor();
    limiter.threshold.value = -12; limiter.knee.value = 6; limiter.ratio.value = 12;
    limiter.attack.value = 0.005; limiter.release.value = 0.3;
    master.connect(limiter).connect(ac.destination);

    // Slow filter sweep over the whole pad: "breathing".
    const tone = ac.createBiquadFilter();
    tone.type = 'lowpass'; tone.frequency.value = 1400; tone.Q.value = 0.4;
    const sweep = ac.createOscillator(); sweep.frequency.value = 0.045;
    const sweepAmt = ac.createGain(); sweepAmt.gain.value = 700;
    sweep.connect(sweepAmt).connect(tone.frequency);
    tone.connect(bus);

    const timers = [];
    const live = [];
    let stopped = false;
    const t0 = ac.currentTime;

    const padChord = (notes, at) => {
      notes.forEach((n, k) => {
        {
          const g = 0.06; const detune = k % 2 ? 6 : -6; // alternate detune keeps the pad wide with one voice
          const osc = ac.createOscillator(); osc.type = 'sine'; osc.frequency.value = hz(n); osc.detune.value = detune;
          const amp = ac.createGain(); amp.gain.setValueAtTime(0.0001, at);
          amp.gain.linearRampToValueAtTime(g, at + 3.2); // slow swell in
          amp.gain.setValueAtTime(g, at + CHORD_SECONDS - 0.5);
          amp.gain.linearRampToValueAtTime(0.0001, at + CHORD_SECONDS + 3.5); // and out under the next chord
          osc.connect(amp).connect(tone);
          osc.start(at); osc.stop(at + CHORD_SECONDS + 3.6);
          live.push(osc);
        }
      });
    };
    const bell = (at) => {
      const n = BELLS[Math.floor(Math.random() * BELLS.length)];
      const osc = ac.createOscillator(); osc.type = 'sine'; osc.frequency.value = hz(n);
      const shimmer = ac.createOscillator(); shimmer.type = 'sine'; shimmer.frequency.value = hz(n) * 2.01;
      const amp = ac.createGain(); amp.gain.setValueAtTime(0.0001, at);
      amp.gain.exponentialRampToValueAtTime(0.045, at + 0.02);
      amp.gain.exponentialRampToValueAtTime(0.0001, at + 3.5);
      const amp2 = ac.createGain(); amp2.gain.value = 0.25;
      osc.connect(amp); shimmer.connect(amp2).connect(amp);
      amp.connect(bus);
      osc.start(at); shimmer.start(at); osc.stop(at + 3.6); shimmer.stop(at + 3.6);
    };
    const drone = ac.createOscillator(); drone.type = 'sine'; drone.frequency.value = hz(38); // D2
    const droneAmp = ac.createGain(); droneAmp.gain.value = 0.05;
    drone.connect(droneAmp).connect(bus);

    // Schedule a little ahead, chord by chord, so the timers never have to be precise.
    let chordN = 0;
    const scheduleChord = () => {
      if (stopped) return;
      const at = t0 + chordN * CHORD_SECONDS;
      padChord(CHORDS[chordN % CHORDS.length], Math.max(ac.currentTime, at));
      // 1–3 bells per chord at random moments.
      const bells = 1 + Math.floor(Math.random() * 3);
      for (let b = 0; b < bells; b++) bell(Math.max(ac.currentTime, at) + 1 + Math.random() * (CHORD_SECONDS - 2));
      chordN++;
      timers.push(setTimeout(scheduleChord, CHORD_SECONDS * 1000 - 1500));
    };

    return {
      start() {
        sweep.start(); drone.start();
        scheduleChord();
        master.gain.setTargetAtTime(LEVELS.fly, ac.currentTime, 2.5); // fade in
      },
      setLevel(level) {
        if (stopped) return;
        master.gain.setTargetAtTime(LEVELS[level] ?? LEVELS.fly, ac.currentTime, 1.2);
      },
      stop() {
        if (stopped) return;
        stopped = true;
        timers.forEach(clearTimeout);
        const now = ac.currentTime;
        master.gain.setTargetAtTime(0.0001, now, 0.6);
        try { sweep.stop(now + 3); drone.stop(now + 3); live.forEach((o) => { try { o.stop(now + 3); } catch { /* ended */ } }); } catch { /* already stopped */ }
        setTimeout(() => { try { master.disconnect(); limiter.disconnect(); } catch { /* gone */ } }, 3500);
      },
    };
  } catch {
    return noop;
  }
}
