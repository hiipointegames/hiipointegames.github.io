import React, { Suspense, lazy, useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { AnimatePresence } from 'framer-motion';
import { Volume2, VolumeX } from 'lucide-react';
import { useAuth, isMember } from '@/auth';
import { useSoundMute } from '@/ui/feedback';
import { createPageUrl } from '@/routing/createPageUrl';
import WorldCanvas from './world/WorldCanvas';
import Joystick from './world/Joystick';
import DockingCard from './world/DockingCard';
import ThirtySevenPlanetActions from './world/ThirtySevenPlanetActions';
import SectorDailyActions from './world/SectorDailyActions';
import { labelTag } from './world/dailyMarks';
import { fetchTodaysDailies, doneObjectIds } from './modes/dailyStatus';
import { todayET } from '@/daily-challenge';
import { reportedFallback } from '@/observability';
import WelcomeCard from './world/WelcomeCard';
import ArrivalFade from './world/ArrivalFade';
import { useCockpitArrival } from './world/useCockpitArrival';
import { useFreshDock } from './world/useFreshDock';
import QuickLaunch from './world/QuickLaunch';
import FlyButton from './world/FlyButton';
import { launchPlan } from './world/launchPlan';
import DevPanel from './world/DevPanel';
import { objectById, visibleObjects } from './world/worldObjects';
import { entryReady, devShowsAll } from './world/entryReady';
import MinimapLegend from './world/MinimapLegend';
import EarnSheet from './modes/starMarket/EarnSheet';
import { undockVelocity } from './world/flight';
import { useSector73Unlocked } from './useSector73Unlocked';
import { readCachedUnlock, welcomeSeenKey } from './mirror';
import { createEngineHum, playSynth } from './synth';
import { createAmbience } from './ambience';
import { readBest } from './modes/bests';
import { useStarBalance, flushPendingStars, fetchCatalog, fetchMyItems } from './modes/stars';
import { readSavedLook, saveLook, lookFrom, claimSavedLook, sameLook } from './world/shipArt';
import { ClickShield } from './modes/ui';
import { useSectorRoom } from './multiplayer/useSectorRoom';
import PilotCard from './multiplayer/PilotCard';
import { useDuelInvites } from './duel/useDuelInvites';
import DuelInvites, { LeaveForDuelPrompt } from './duel/DuelInvites';
import DailyBoard from './modes/DailyBoard';
import ModeErrorBoundary from './ModeErrorBoundary';
import { BOARD_GAMES, flushSector73Queues } from './modes/dailyRuns';
import { FxProvider, haptic } from './fx';
import { navBarBottomOffset } from '@/home';
import { useInterstitialAd } from '@/shell';
import { Capacitor } from '@capacitor/core';

// Mode screens end at the ad banner's top edge (same platform-aware maths as the
// main game's bottom nav), so no button sits under the banner (S21, 2026-10-05:
// Re-Entry's FIRE BURN was half hidden).
const MODE_BOTTOM = navBarBottomOffset(Capacitor.getPlatform());

// Where the ship was when the player left for a main-game screen (Terra, Observatory…),
// so coming back resumes there — docked at that planet — instead of at spawn. In-memory:
// it lasts for the app session, which is what a round trip needs.
const resumePoint = { ship: null, dockedId: null };

/** The saved resume point serves one round trip, not every later entry: cleared after mount. */
const readResumePoint = () => ({ ...resumePoint });
const clearResumePoint = () => { resumePoint.ship = null; resumePoint.dockedId = null; };

// The cockpit — Sector 73's open world (route: /Sector73, a lazy chunk).
// See .crispy/sessions/2026-10-04-sector-73/world-engine-design.md.

const MODES = {
  hyperjump: lazy(() => import('./modes/hyperjump/HyperjumpMode')),
  firstContact: lazy(() => import('./modes/firstContact/FirstContactMode')),
  starChart: lazy(() => import('./modes/starChart/StarChartMode')),
  reEntry: lazy(() => import('./modes/reEntry/ReEntryMode')),
  starMarket: lazy(() => import('./modes/starMarket/StarMarketMode')),
  // A Blitz battle played in Sector 73 (battles design-v2 B3): openMode('battle', { challengeId }).
  battle: lazy(() => import('./modes/battle/BattleMode')),
  // A round of 37 (practice or a Daily) played inside Sector 73: openMode('thirtySeven', { mode, entry }).
  thirtySeven: lazy(() => import('./modes/thirtySeven/ThirtySevenMode')),
  // The battle screen (live battles S4): a practice duel vs a computer pilot. Dev/staging DevPanel opens it until the inbox (S8).
  duel: lazy(() => import('./modes/duel/DuelMode')),
  // A LIVE duel (live battles S6): openMode('liveDuel', { duelId, opponentName, onRematch }) once an invite is accepted.
  liveDuel: lazy(() => import('./modes/duel/LiveDuelMode')),
};

// W1 frame-rate spike (dev/staging only) — throwaway, removed once the renderer is chosen.
const Spike3D = lazy(() => import('./world3d/Spike3D'));

const IS_DEV_BUILD = import.meta.env.DEV || import.meta.env.MODE === 'staging';

/** Each How to earn ★ row → the object where you earn it (a free run → that game's practice moon). */
export const EARN_PLACES = Object.freeze({
  daily37: 'terra',
  blitzWin: 'colosseum',
  re_landing: 're-entry',
  re_one_turn: 're-entry',
  hj_core: 'hyperjump',
  hj_core_free: 'hyperjump-practice',
  fc_bounty: 'first-contact',
  sc_bounty: 'star-chart',
});

/** What the map shows: every object, minus the practice moons of games not yet reading `entry`. */
const mapObjects = () => {
  const all = devShowsAll(IS_DEV_BUILD);
  return visibleObjects((mode) => entryReady(mode, { all }));
};

function ReturnTo37({ onReturn }) {
  return (
    <button
      type="button"
      data-testid="return-to-37"
      onPointerDown={(e) => { e.preventDefault(); e.stopPropagation(); onReturn(); }}
      className="absolute z-40 left-3 rounded-full border border-fuchsia-300/70 bg-black/60 px-4 py-2 text-sm font-black text-white backdrop-blur active:scale-95"
      style={{ top: 'calc(var(--safe-top, 0px) + 12px)', boxShadow: '0 0 18px -6px #e879f9' }}
    >
      ← Return to 37
    </button>
  );
}

/**
 * The route's door: members only (David, 2026-10-19 — "You have to be a player with a username
 * and password to get into Sector 73"). Layout's soft wall sends a guest home with the unlock
 * sheet (LOCKED_PAGES.Sector73); this second check means the cockpit never mounts for a guest
 * in the moment before Layout knows who they are — no room joined, no queues flushed, no world.
 */
export default function Sector73Page() {
  const { user } = useAuth();
  return isMember(user) ? <Cockpit /> : null;
}

function Cockpit() {
  const navigate = useNavigate();
  const location = useLocation();
  const { user } = useAuth();
  const unlocked = useSector73Unlocked(user?.id);
  // The first warp's arrival, read ONCE (world lane 2026-10-22): useCockpitArrival then clears it from
  // history, so it stays the unlock pass for this visit but a later Back is not a new arrival.
  const [arrival] = useState(() => location.state?.arrival === true);
  const { muted, toggleMute } = useSoundMute();
  const starBalance = useStarBalance();
  useEffect(() => { flushSector73Queues(flushPendingStars); }, []); // send Daily results, THEN stars earned offline
  // The pilot's look (Star Market): from the phone at once, then from the account; the hangar
  // announces changes on 'sector73:look'. The saved look is per phone, so another account's is
  // dropped first (claimSavedLook), and a loadout that differs from the saved look is announced
  // too, so a duel opened before it loaded switches to it.
  useEffect(() => {
    claimSavedLook(user?.id);
    sim.current.look = readSavedLook();
    const onLook = (e) => { sim.current.look = e.detail; };
    globalThis.addEventListener?.('sector73:look', onLook);
    Promise.all([fetchCatalog(), fetchMyItems()])
      .then(([cat, mine]) => {
        const look = lookFrom(cat, mine.loadout);
        // Announce only a real change: the room hook re-broadcasts every announcement (Realtime cost).
        const changed = !sameLook(look, readSavedLook());
        saveLook(look); sim.current.look = look;
        if (changed) globalThis.dispatchEvent?.(new CustomEvent('sector73:look', { detail: look }));
      })
      .catch(() => { /* offline: keep the saved look */ });
    return () => globalThis.removeEventListener?.('sector73:look', onLook);
  }, [user?.id]);

  const [resume] = useState(readResumePoint);
  useEffect(() => { clearResumePoint(); }, []);
  // Where the ship + camera start (W5 spawn scatter) and the soft landing from the portal's white
  // (W2) — one tested hook (world/useCockpitArrival).
  const { pose, fadeIn, fadeDone } = useCockpitArrival(resume);
  const sim = useRef({
    ship: pose.ship,
    cam: pose.cam,
    input: { joystick: null },
    autopilot: { targetId: null, point: null },
    dockedId: resume.dockedId,
    orbitTheta: 0,
    time: 0,
    hum: null,
    /** @type {import("./world/shipArt").Look | null} */ look: null,
    /** @type {Map<string, any> | null} */ remotes: null, // other pilots (multiplayer/useSectorRoom)
    /** @type {import("./world/edgeArrows").EdgeArrow[] | null} */ edgeArrows: null, // drawn this frame (WorldCanvas)
    /** @type {Set<string>} */ dailyDone: new Set(), // Daily objects played today (world/dailyMarks): read every frame
  });
  // Fixed for the visit, so the canvas loop never restarts (a new array would repaint everything).
  const [objects] = useState(mapObjects);
  const minimapRef = useRef(null);
  // Multiplayer (David, 2026-10-14): a room of up to 37 live pilots; tap a ship for its pilot card.
  const [pilotId, setPilotId] = useState(null);
  const [boardGame, setBoardGame] = useState(null); // a Daily leaderboard open from a docking card
  const [sentTo, setSentTo] = useState(null);
  useEffect(() => { if (!sentTo) return undefined; const t = setTimeout(() => setSentTo(null), 3500); return () => clearTimeout(t); }, [sentTo]);
  const [dockedId, setDockedId] = useState(resume.dockedId);
  // A restored dock (resume above) is never fresh; only onDock makes one (the DOCKED stamp, W6).
  const { freshId, markFresh, clearFresh } = useFreshDock();
  const [activeMode, setActiveMode] = useState(null);
  // A live duel takes the pilot out of the room channel (no ship traffic during a timed round, S6
  // review m8); closing it rejoins the same room.
  const room = useSectorRoom(sim, { user, away: activeMode === 'liveDuel' });
  const [modeParams, setModeParams] = useState(null); // e.g. { challengeId } for 'battle'
  /** Open a mode overlay, with what it needs to know (the battle inbox: openMode('battle', { challengeId })). */
  // Opening a mode also saves where the ship is (info-screens design-v2 D5): a mode can take the
  // player off the page (a link out, the app killed and re-opened) and the next mount should find
  // them docked where they were. Closing the mode, or going home, ends that round trip.
  const openMode = useCallback((name, params = null) => {
    const s = sim.current;
    resumePoint.ship = { x: s.ship.x, y: s.ship.y, angle: s.ship.angle };
    resumePoint.dockedId = s.dockedId;
    clearFresh(); // every way into a mode (dock, inbox, ?battle=): the card after it is a restored dock
    setModeParams(params);
    setActiveMode(name);
  }, [clearFresh]);
  // A timed Daily in progress (modes/dailyRuns announces 'sector73:daily-run' at START and FINISH):
  // while one runs, an invite toast offers no Accept (S6 review M5). Closing the mode forgets it.
  const [dailyRun, setDailyRun] = useState(/** @type {string|null} */ (null));
  useEffect(() => {
    const on = (e) => setDailyRun(e?.detail?.game ?? null);
    globalThis.addEventListener?.('sector73:daily-run', on);
    return () => globalThis.removeEventListener?.('sector73:daily-run', on);
  }, []);
  // Counts mode closes, so today's Dailies are read again on the way back from any game (a "next
  // Daily" on a results card can even play another tier), and a 37 planet card re-reads its own.
  const [modeVisits, setModeVisits] = useState(0);
  const closeMode = useCallback(() => {
    clearResumePoint(); setActiveMode(null); setModeParams(null); setDailyRun(null); setModeVisits((n) => n + 1);
  }, []);
  // Today's seven Dailies (modes/dailyStatus): the map's gold rings / DONE ✓ (read every frame from
  // sim.current.dailyDone), the FLY list and the four games' cards. Read on entry and after every game.
  const [todays, setTodays] = useState(/** @type {Record<string, import('./modes/dailyStatus').DailyInfo> | null} */ (null));
  useEffect(() => {
    let live = true;
    fetchTodaysDailies({ userId: user?.id, date: todayET() })
      .then((t) => {
        if (!live) return;
        setTodays(t);
        sim.current.dailyDone = doneObjectIds(objects, t);
      })
      .catch(reportedFallback('sector73.todaysDailies'));
    return () => { live = false; };
  }, [user?.id, modeVisits, objects]);
  // Live duels (S6): invites on my personal topic while I'm here, only when sector73_live_battles is on.
  // An accepted invite opens the battle screen on both phones; Rematch there sends a fresh invite.
  // A duel accepted while another mode is open (a Daily in progress…) never yanks the pilot out: it
  // asks first (S6 review M5). Stay cancels the accepted duel (no forfeit; it was not live yet).
  const [pendingDuel, setPendingDuel] = useState(/** @type {null | { duelId: string, opponentName: string }} */ (null));
  const openLiveDuel = (duelId, opponentName) => {
    setPendingDuel(null);
    setPilotId(null);
    setDailyRun(null); // "Go" leaves the Daily: its rematch toast must offer Accept (round-2 m4)
    openMode('liveDuel', {
      duelId,
      opponentName,
      onRematch: async ({ theirId, name, style, firstTo }) => {
        const why = await live.invite({ uid: theirId, name }, { style, firstTo, source: 'rematch' });
        if (!why) closeMode();
        return why;
      },
    });
  };
  // "Finish your Daily first": a duel accepted while a Daily runs is called off (onStart below).
  const [duelNote, setDuelNote] = useState(/** @type {string | null} */ (null));
  useEffect(() => { if (!duelNote) return undefined; const t = setTimeout(() => setDuelNote(null), 4000); return () => clearTimeout(t); }, [duelNote]);
  // The prompt lapses with the server's 60 s ready window.
  useEffect(() => { if (!pendingDuel) return undefined; const t = setTimeout(() => setPendingDuel(null), 60000); return () => clearTimeout(t); }, [pendingDuel]);
  const live = useDuelInvites({
    user,
    onStart: (duelId, opponentName) => {
      // A Daily running (a Sector 73 game's or a 37 round's): never offer "Go" (world lane 2026-10-22,
      // review B2). Leaving would end the round mid-clock with no forfeit saved while the server's
      // clock runs on. The accepted duel is called off (it was not live yet) and the pilot told why.
      if (activeMode && activeMode !== 'liveDuel' && dailyRun) {
        live.cancelDuel(duelId);
        setDuelNote(`${opponentName}'s duel was called off: finish your Daily first.`);
        return;
      }
      if (activeMode && activeMode !== 'liveDuel') setPendingDuel({ duelId, opponentName });
      else openLiveDuel(duelId, opponentName);
    },
  });
  /** A duel notice (invite, "Waiting for…", a note) is showing: over the map it takes the ★ line's place. */
  const duelNoticeUp = Boolean(live.enabled && (live.incoming?.length || live.outgoing || live.note)) && !activeMode;
  // The Colosseum's interstitial, with the Colosseum's rules: prepared while the page is open,
  // shown by a battle's start (useInterstitialAd: server switch, web placeholder, no-op unloaded).
  // It is mounted HERE, for the whole visit, on purpose: its Dismissed listener prepares the next
  // ad after EVERY interstitial, including the Sector 73 Dailies' (modes/dailyAd). David's rule is
  // an ad before every Daily attempt (2026-10-14: "for a daily, and all dailies within sector 73,
  // ads should be shown before the attempt"); without a hook here the 2nd Daily of a visit re-showed
  // a spent ad, got FailedToShow and silently skipped it. Decided 2026-10-19 (battles slice 3 review
  // M1): keep it. Pinned by Sector73Page.dailyAd.test.jsx.
  const { show: showBattleAd } = useInterstitialAd();
  // The FLY list — the one menu (W4, 2026-10-19): each row flies there or opens it straight away.
  const [showList, setShowList] = useState(false);
  // The welcome card: once per phone (D4-B), and the ? button brings it back. It is marked seen as soon
  // as it SHOWS (not only when closed), so a phone killed with the card up doesn't show it again.
  const [showWelcome, setShowWelcome] = useState(() => {
    try { return globalThis.localStorage?.getItem(welcomeSeenKey(user?.id)) !== '1'; } catch { return arrival; }
  });

  useEffect(() => {
    if (!showWelcome) return;
    try { globalThis.localStorage?.setItem(welcomeSeenKey(user?.id), '1'); } catch { /* private window */ }
  }, [showWelcome, user?.id]);
  const [showEarn, setShowEarn] = useState(false);
  /** Where each way to earn ★ is: its Daily object (or practice moon for a free run). */
  const earnTarget = (key) => {
    const id = EARN_PLACES[key];
    return id ? (objects.find((o) => o.id === id) ?? objects.find((o) => o.id === id.replace(/-practice$/, '')) ?? null) : null;
  };

  useEffect(() => { if (arrival) playSynth('arrive'); }, [arrival]);


  // Immersive: hide the app's bottom nav bar + web footer while in the cockpit
  // (the same signal a live battle and the How-To overlay use), restore on exit.
  // A LAYOUT effect, so the chrome is gone before the first paint: the page sits inside Layout's
  // z-[1] content wrapper, so the nav + footer paint over it until hidden — a plain effect let
  // them show for ~0.3 s over the arrival's white (W2 burst, 2026-10-19).
  useLayoutEffect(() => {
    window.dispatchEvent(new CustomEvent('bottomNavChanged', { detail: { hidden: true } }));
    return () => { window.dispatchEvent(new CustomEvent('bottomNavChanged', { detail: { hidden: false } })); };
  }, []);

  // Music (David, 2026-10-14: "cosmic ethereal music"): starts as soon as audio is allowed — at
  // once after the portal tap, or on the first touch — and dips under a mode. Same mute switch.
  const music = useRef(null);
  const ensureMusic = useCallback(() => {
    if (muted || music.current) return;
    music.current = createAmbience();
    music.current.start();
  }, [muted]);
  useEffect(() => { ensureMusic(); }, [ensureMusic]);
  useEffect(() => () => { music.current?.stop(); music.current = null; }, []);
  useEffect(() => {
    if (muted) { music.current?.stop(); music.current = null; return; }
    music.current?.setLevel(activeMode || showList ? 'dim' : 'fly');
  }, [muted, activeMode, showList]);

  // Engine hum: starts on the first touch (browsers block audio before a gesture).
  const ensureHum = useCallback(() => {
    if (!sim.current.hum) sim.current.hum = createEngineHum();
    ensureMusic();
  }, [ensureMusic]);
  useEffect(() => () => sim.current.hum?.stop(), []);
  useEffect(() => {
    if (muted || activeMode || showList) { sim.current.hum?.stop(); sim.current.hum = null; }
  }, [muted, activeMode, showList]);

  // No engine hum or music while the app is in the background; both restart on the next touch.
  useEffect(() => {
    const onVis = () => { if (document.hidden) { sim.current.hum?.stop(); sim.current.hum = null; music.current?.stop(); music.current = null; } };
    document.addEventListener('visibilitychange', onVis);
    return () => document.removeEventListener('visibilitychange', onVis);
  }, []);

  const goHome = useCallback(() => {
    clearResumePoint(); // back to 37: the next visit starts at spawn
    playSynth('blip');
    navigate(createPageUrl('Game'));
  }, [navigate]);

  const flyTo = useCallback((obj) => {
    ensureHum();
    const s = sim.current;
    if (s.dockedId === obj.id) { setDockedId(obj.id); return; }
    s.dockedId = null;
    setDockedId(null);
    s.autopilot = { targetId: obj.id, point: null };
  }, [ensureHum]);

  // Fly to another pilot: autopilot to where their ship is now, stopping just short of it.
  const flyToPilot = useCallback((uid) => {
    ensureHum();
    const s = sim.current;
    const r = s.remotes?.get(uid);
    if (!r) return;
    const dx = s.ship.x - r.ship.x; const dy = s.ship.y - r.ship.y; const d = Math.hypot(dx, dy) || 1;
    s.dockedId = null;
    setDockedId(null);
    s.autopilot = { targetId: null, point: { x: r.ship.x + (dx / d) * 90, y: r.ship.y + (dy / d) * 90 } };
  }, [ensureHum]);

  const onTap = useCallback((world, hit, ship) => {
    ensureHum();
    if (ship) { playSynth('blip'); setPilotId(ship.uid); return; }
    if (hit) { flyTo(hit); return; }
    const s = sim.current;
    s.dockedId = null;
    setDockedId(null);
    s.autopilot = { targetId: null, point: world };
  }, [ensureHum, flyTo]);

  const onDock = useCallback((id) => {
    playSynth('dock');
    haptic('light'); // the docking lock (silent until the haptics plugin ships)
    markFresh(id);
    setDockedId(id);
  }, [markFresh]);

  const undock = useCallback(() => {
    const s = sim.current;
    const obj = objectById(s.dockedId);
    s.dockedId = null;
    setDockedId(null);
    s.autopilot = { targetId: null, point: null };
    // Push straight away from the object so the ship visibly leaves orbit.
    if (obj) s.ship = { ...s.ship, ...undockVelocity(s.ship, obj) };
  }, []);

  const onStickStart = useCallback(() => {
    ensureHum();
    const s = sim.current;
    s.autopilot = { targetId: null, point: null };
    if (s.dockedId) { s.dockedId = null; setDockedId(null); }
  }, [ensureHum]);

  const launch = useCallback((obj) => {
    playSynth('blip');
    clearFresh(); // back from the mode, the card is a restored dock: no second stamp
    const plan = launchPlan(sim.current, obj);
    if (plan.kind === 'home') { goHome(); return; }
    if (plan.kind === 'route') {
      resumePoint.ship = plan.resume.ship;
      resumePoint.dockedId = plan.resume.dockedId;
      // from73: the page shows "← Back to Sector 73" instead of the 37 nav (boards/ReturnBar).
      navigate(plan.to, { state: { ...(plan.state ?? {}), from73: true } });
      return;
    }
    openMode(plan.mode, plan.params);
  }, [goHome, navigate, clearFresh, openMode]);

  // A Daily object's card buttons (world lane 2026-10-22): its Daily, with today's status, and its
  // practice moon's round. 37's planets read their own attempt machine (exact Continue / not-ready);
  // the four games use today's statuses from the page.
  const practiceMoonOf = (obj) => objects.find((o) => o.practiceOf === obj.id) ?? null;
  const dailyActionsFor = (obj) => {
    if (!obj.daily) return null;
    const moon = practiceMoonOf(obj);
    if (obj.launch.type === 'sector' && obj.launch.mode === 'thirtySeven') {
      return (
        <ThirtySevenPlanetActions
          key={modeVisits}
          dailyMode={obj.daily}
          user={user ?? null}
          onDaily={(state) => launch({ ...obj, launch: { ...obj.launch, params: { mode: obj.daily, entry: state === 'continue' ? 'continue' : 'daily' } } })}
          onPractice={(mode) => launch(moon ?? { ...obj, launch: { type: 'sector', mode: 'thirtySeven', params: { mode, entry: 'practice' } } })}
        />
      );
    }
    return (
      <SectorDailyActions
        state={todays?.[obj.daily]?.status ?? 'unknown'}
        onDaily={() => launch(obj)}
        onPractice={moon ? () => launch(moon) : undefined}
      />
    );
  };

  // Dev/staging only: /Sector73?battle=<id> opens that battle (two-browser checks before the inbox
  // lands). Production builds never read the param.
  const devBattle = IS_DEV_BUILD ? new URLSearchParams(location.search).get('battle') : null;
  useEffect(() => { if (devBattle) openMode('battle', { challengeId: devBattle }); }, [devBattle, openMode]);

  const docked = useMemo(() => objectById(dockedId), [dockedId]);
  const ActiveMode = activeMode ? MODES[activeMode] : null;

  // Secret stays secret: a locked player who types the URL is sent home. The
  // cached flag (written on the warp) lets a fresh arrival in immediately.
  const allowed = unlocked || arrival || readCachedUnlock(user?.id);
  if (IS_DEV_BUILD && new URLSearchParams(location.search).get('spike') === '3d') {
    return (
      <Suspense fallback={<div className="fixed inset-0 z-[260] grid place-items-center bg-black text-amber-200">Loading 3D spike…</div>}>
        <Spike3D onExit={() => navigate('/Sector73')} />
      </Suspense>
    );
  }
  if (!allowed) {
    return (
      <div className="fixed inset-0 z-[250] grid place-items-center bg-[#04030d] px-8 text-center">
        <div>
          <p className="text-violet-300 text-sm tracking-[0.3em] uppercase">Signal too faint</p>
          <p className="mt-3 text-slate-400 text-sm">Every road leads to 37… except one.</p>
          <button type="button" onClick={goHome} className="mt-6 rounded-full border border-violet-400/60 px-5 py-2 text-white">← Return to 37</button>
        </div>
      </div>
    );
  }

  return (
    <div className="fixed inset-0 z-[250] overflow-hidden bg-[#04030d] select-none" data-testid="sector73-page">
      <WorldCanvas
        sim={sim}
        objects={objects}
        paused={Boolean(activeMode) || showList}
        onDock={onDock}
        onTap={onTap}
        minimapRef={minimapRef}
      />

      {/* HUD */}
      <ReturnTo37 onReturn={goHome} />
      <div className="absolute z-40 right-3 flex items-center gap-2" style={{ top: 'calc(var(--safe-top, 0px) + 12px)' }}>
        <button
          type="button"
          data-testid="sector73-help"
          aria-label="How Sector 73 works"
          onPointerDown={(e) => { e.stopPropagation(); setShowWelcome(true); }}
          className="grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-black/50 text-base font-black text-slate-200"
        >
          ?
        </button>
        <button
          type="button"
          data-testid="sector73-mute"
          aria-label={muted ? 'Unmute sound' : 'Mute sound'}
          onPointerDown={(e) => { e.stopPropagation(); toggleMute(); }}
          className="grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-black/50 text-slate-200"
        >
          {muted ? <VolumeX className="h-5 w-5" /> : <Volume2 className="h-5 w-5" />}
        </button>
      </div>
      {/* FLY — always on screen, the headline way to get around (David, 2026-10-14). */}
      <FlyButton onOpen={() => { ensureHum(); setShowList(true); }} />
      {/* Hidden (not removed) while a duel notice sits in its place below FLY (world lane 2026-10-22). */}
      <div data-testid="sector73-hud-title" data-hidden={duelNoticeUp ? 'true' : undefined}
        className={`absolute z-20 left-1/2 -translate-x-1/2 text-center pointer-events-none ${duelNoticeUp ? 'invisible' : ''}`}
        style={{ top: 'calc(var(--safe-top, 0px) + 108px)' }}>
        <div className="text-[10px] tracking-[0.5em] text-violet-300/70">SECTOR 73</div>
        {/* The ★ balance is a button (world lane 2026-10-22): How to earn ★, from anywhere in the world. */}
        <button type="button" data-testid="sector73-stars" aria-label={`${starBalance} stars: how to earn more`}
          onPointerDown={(e) => { e.stopPropagation(); setShowEarn(true); }}
          className="pointer-events-auto -my-2 inline-flex min-h-[44px] items-center gap-1 rounded-full px-3 text-xs font-black text-amber-200"
          style={{ textShadow: '0 0 8px #f59e0b' }}>
          <span className="rounded-full border border-amber-300/50 bg-black/40 px-2 py-0.5">★ {starBalance} <span aria-hidden="true" className="text-amber-300/80">ⓘ</span></span>
        </button>
        {room.status === 'live' && (
          <div data-testid="sector73-room" className="mt-0.5 text-[10px] font-bold text-fuchsia-200/90">
            ROOM {room.room} · {room.count} {room.count === 1 ? 'PILOT' : 'PILOTS'}{room.watching ? ' · WATCHING' : ''}
          </div>
        )}
      </div>

      <canvas
        ref={minimapRef}
        aria-label="Minimap"
        className="absolute z-20 rounded-full pointer-events-none"
        style={{ width: 112, height: 112, right: 14, bottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 28px)', boxShadow: '0 0 20px -8px #a855f7' }}
      />
      <MinimapLegend userId={user?.id ?? null} />
      <Joystick sim={sim} onStart={onStickStart} />

      <AnimatePresence>
        {docked && !activeMode && (
          <DockingCard
            object={docked}
            best={docked.launch.type === 'sector' && !(docked.daily && docked.launch.mode === 'thirtySeven') ? readBest(docked.launch.mode) : null}
            onLaunch={launch}
            onUndock={undock}
            fresh={freshId === docked.id}
            tag={labelTag(docked, sim.current.dailyDone)}
            onBoard={docked.daily && BOARD_GAMES.includes(docked.daily) ? () => setBoardGame(docked.daily ?? null) : undefined}
            actions={dailyActionsFor(docked)}
          />
        )}
      </AnimatePresence>

      {IS_DEV_BUILD && <DevPanel onPracticeDuel={() => openMode('duel')} />}
      {boardGame && <DailyBoard game={boardGame} onClose={() => setBoardGame(null)} />}

      {pilotId && room.pilots.get(pilotId) && !activeMode && (
        <PilotCard
          pilot={room.pilots.get(pilotId)}
          canChallenge={!room.watching}
          onViewProfile={(id) => navigate(`${createPageUrl('OtherProfile')}?id=${encodeURIComponent(id)}`)}
          onClose={() => setPilotId(null)}
          onSent={(name) => setSentTo(name)}
          liveInvite={live.enabled ? live.invite : null}
        />
      )}
      {/* Blitz challenges only (sweep 2026-10-20): a live invite has its own "Waiting for … · Cancel" bar, */}
      {/* and the two stacked over the FLY button and the ★ line. Keyed on the switch, not the bar, so a */}
      {/* quick Cancel cannot make the pill pop up afterwards. */}
      {sentTo && !live.enabled && (
        <div data-testid="pilot-challenge-sent" className="absolute left-1/2 z-50 -translate-x-1/2 rounded-full border border-fuchsia-300/60 bg-black/70 px-4 py-2 text-sm font-bold text-fuchsia-100"
          style={{ top: 'calc(var(--safe-top, 0px) + 110px)' }}>
          ⚔️ Challenge sent to {sentTo}
        </div>
      )}

      {showList && (
        <QuickLaunch
          objects={objects}
          pilots={[...room.pilots.values()].filter((p) => sim.current.remotes?.has(p.uid))}
          todays={todays}
          onPick={(obj) => { setShowList(false); flyTo(obj); }}
          onPickPilot={(uid) => { setShowList(false); flyToPilot(uid); }}
          onLaunch={(obj) => { setShowList(false); launch(obj); }}
          onClose={() => setShowList(false)}
        />
      )}

      {showWelcome && <WelcomeCard onClose={() => setShowWelcome(false)} />}
      {showEarn && (
        <EarnSheet
          onClose={() => setShowEarn(false)}
          onFly={(key) => { const obj = earnTarget(key); if (obj) { setShowEarn(false); flyTo(obj); } }}
          canFly={(key) => Boolean(earnTarget(key))}
        />
      )}

      {fadeIn && <ArrivalFade onDone={fadeDone} />}
      <DuelInvites live={live} holdAccept={Boolean(dailyRun && activeMode)} inWorld={!activeMode} />
      {duelNote && (
        <div data-testid="duel-daily-note" role="status"
          className="absolute left-1/2 z-[60] -translate-x-1/2 rounded-full border border-fuchsia-300/60 bg-black/85 px-4 py-2 text-center text-xs font-bold text-fuchsia-100"
          style={{ top: 'calc(var(--safe-top, 0px) + 64px)', width: 'min(92vw, 360px)' }}>
          ⚔️ {duelNote}
        </div>
      )}
      {pendingDuel && (
        <LeaveForDuelPrompt
          name={pendingDuel.opponentName}
          mode={activeMode}
          onGo={() => openLiveDuel(pendingDuel.duelId, pendingDuel.opponentName)}
          onStay={() => { live.cancelDuel(pendingDuel.duelId); setPendingDuel(null); }}
        />
      )}

      {ActiveMode && (
        <ClickShield className="absolute inset-x-0 top-0 z-50 bg-[#04030d]" style={{ bottom: MODE_BOTTOM }}>
          <FxProvider className="h-full w-full">
            <Suspense fallback={<div className="grid h-full place-items-center text-violet-300">Charting course…</div>}>
              {/* Keyed by duel too: a rematch accepted on the result card is a FRESH live-duel screen (S6 review M1). */}
              <ModeErrorBoundary key={`${activeMode}:${modeParams?.duelId ?? ''}`} mode={activeMode} onClose={closeMode}>
                <ActiveMode onExit={closeMode} onReturnTo37={goHome} user={user ?? null} params={modeParams} showAd={showBattleAd} />
              </ModeErrorBoundary>
            </Suspense>
          </FxProvider>
        </ClickShield>
      )}
    </div>
  );
}
