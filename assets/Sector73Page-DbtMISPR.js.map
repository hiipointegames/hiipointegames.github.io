import React, { useEffect, useRef, useState } from 'react';
import { useDailyChallengeAttempt, todayET } from '@/daily-challenge';
import { isDaily, keyFor, modeOf, modeTierLabel } from '@/game-modes';
import { reportedFallback } from '@/observability';
import { puzzleExists, rememberStatus, terminalStatus } from './planetDailyCheck';

// The docking card's buttons for the three Daily planets — Terra, Ember, Titan (session
// 2026-10-19-s73-37-inside, design-v2 D7, slice 4a). David: "the player should always be able to
// choose between practice or daily", and one Daily attempt is shared between 37 and Sector 73.
//
//   Daily     Play <tier> Daily | Continue Daily | Done ✓ | Today's puzzle isn't ready | Checking…
//   Practice  always there
//
// The Daily's state comes from the SERVER on each dock (the card unmounts while you fly and while a
// mode is open): this holds ONE attempt machine — the same hook /Game uses — and runs its
// restore(player) on mount, which reads today's daily_challenge_times / attempts rows for this
// planet's mode. That is a read, with one exception it shares with /Game's mount: an attempt that
// is over an hour old has run out, and restore() WRITES its forfeit (once — the next read sees it
// forfeited). No clock starts and nothing is stored on the phone.
//
// To keep docking cheap (planetDailyCheck): a Done Daily is remembered for the rest of its ET day
// (no reads at all), and whether today's puzzle exists is asked once per mode and day by a plain
// read — not the hook's fetchTodaysDice, which logs and rolls local dice when the puzzle is missing.
// So a dock costs nothing once Done, and the two attempt reads otherwise.
//
// Ported by hand into the world lane (2026-10-22; 07a83c7 was never in the release branch): the Daily
// button now plays the Daily INSIDE Sector 73. The page opens mode thirtySeven with entry 'daily' (ad
// first, as in 37) or 'continue' (no ad, no start screen). It is the SAME Daily as 37's: the same
// attempt row and leaderboard, one try per tier per day. Done is a label (opening today's result
// from here is on the cut list).

/** @typedef {'loading' | 'play' | 'continue' | 'done' | 'missing'} PlanetDailyState */

/**
 * What the Daily button shows, from the attempt machine.
 * @param {{ checked: boolean, status?: string, recoverable?: boolean, puzzleMissing?: boolean | null }} a
 * @returns {PlanetDailyState}
 */
export function planetDailyState({ checked, status, recoverable, puzzleMissing }) {
  if (!checked || status === 'loading') return 'loading';
  if (status === 'completed' || status === 'forfeited') return 'done';
  if (recoverable) return 'continue';
  if (puzzleMissing === true) return 'missing';
  return 'play';
}

/** The practice round of a Daily's tier ('daily_easy' → 'easy'). */
export const practiceModeFor = (dailyMode) => keyFor(modeOf(dailyMode), 'practice') ?? 'easy';

const stop = (e) => { e.stopPropagation(); };

/**
 * @param {{
 *   dailyMode: string,
 *   user: Record<string, any> | null,   // the signed-in player (useAuth); its user_metadata holds game_stats
 *   accent?: string,   // the home system's cyan, as DockingCard paints a home-region card
 *   onDaily: (state: PlanetDailyState) => void,
 *   onPractice: (practiceMode: string) => void,
 *   readPuzzle?: (q: { date: string, mode: string }) => Promise<any[]>,
 * }} props
 */
export default function ThirtySevenPlanetActions({ dailyMode, user, accent = '#fcd34d', onDaily, onPractice, readPuzzle = undefined }) {
  const dc = useDailyChallengeAttempt(dailyMode);
  const [checked, setChecked] = useState(false);
  const [missing, setMissing] = useState(/** @type {boolean | null} */ (null));
  const date = todayET();
  const userId = user?.id ?? null;
  const known = userId ? terminalStatus(userId, date, dailyMode) : null;
  // Read once per dock (mount): what the check needs is taken from the first render.
  const first = useRef({ restore: dc.restore, user, date, known, readPuzzle });

  useEffect(() => {
    let live = true;
    const { restore, user: player, date: day, known: done, readPuzzle: read } = first.current;
    (async () => {
      if (!player?.id || done) return; // no player → Play (the start asks the server); Done → no reads
      // The same merged shape apiClient.auth.me() returns (game_stats lives in user_metadata), with
      // no extra network call: the page already has the player.
      const status = await restore({ ...player, ...(player.user_metadata ?? {}) });
      rememberStatus(player.id, day, dailyMode, status);
      // Only a Daily you could still start needs to know whether today's puzzle exists.
      if (status === 'not_started') {
        const exists = await puzzleExists(day, dailyMode, read ? { read } : undefined);
        if (live) setMissing(!exists);
      }
    })()
      // A failed check falls back to Play: the Daily's start asks the server again before it
      // spends anything, so a wrong "Play" can only be refused, never cost an attempt.
      .catch(reportedFallback('sector73.planetCard.check'))
      .then(() => { if (live) setChecked(true); });
    return () => { live = false; };
  }, [dailyMode]);

  const status = known ?? dc.status;
  const state = planetDailyState({ checked: checked || Boolean(known), status, recoverable: !known && dc.recoverable, puzzleMissing: missing });
  const tier = modeTierLabel(dailyMode);
  const practiceMode = practiceModeFor(dailyMode);
  const canPlay = state === 'play' || state === 'continue';

  let label = `Play ${tier} Daily ▶`;
  if (state === 'loading') label = 'Checking today’s Daily…';
  else if (state === 'continue') label = 'Continue Daily ▶';
  else if (state === 'done') label = 'Done ✓';
  else if (state === 'missing') label = 'Today’s puzzle isn’t ready';

  let note = null;
  if (state === 'done') note = status === 'forfeited' ? `Today’s ${tier} Daily is over. A new one comes tomorrow.` : `You’ve finished today’s ${tier} Daily.`;
  else if (state === 'continue') note = 'Your Daily is still running.';
  else if (state === 'missing') note = `No ${tier} Daily has been set for today.`;
  else if (state === 'play') note = 'Short ad first · counts on the 37 leaderboard.';

  return (
    <div data-testid="planet-actions" data-daily-mode={isDaily(dailyMode) ? dailyMode : undefined} className="mt-3 space-y-2">
      {canPlay ? (
        <button
          type="button"
          data-testid="planet-daily"
          data-state={state}
          onPointerDown={(e) => { stop(e); onDaily(state); }}
          className="w-full rounded-xl py-3 font-black tracking-widest text-[#0a0618] active:scale-95 transition-transform"
          style={{ background: accent, boxShadow: `0 0 22px -6px ${accent}` }}
        >
          {label.toUpperCase()}
        </button>
      ) : (
        <div
          data-testid="planet-daily"
          data-state={state}
          role="status"
          aria-live="polite"
          className="w-full rounded-xl border py-3 text-center font-black tracking-widest"
          style={{ borderColor: accent, color: accent, background: 'rgba(255,255,255,0.04)' }}
        >
          {label.toUpperCase()}
        </div>
      )}
      {note && <p data-testid="planet-daily-note" className="text-center text-xs text-slate-300">{note}</p>}
      <button
        type="button"
        data-testid="planet-practice"
        data-mode={practiceMode}
        onPointerDown={(e) => { stop(e); onPractice(practiceMode); }}
        className="w-full rounded-xl border border-white/25 bg-white/5 py-2.5 text-sm font-bold tracking-wider text-white active:scale-95 transition-transform"
      >
        ⚪ {tier} practice instead
      </button>
    </div>
  );
}
