// Sector 73 live duels — the Realtime topic names (slice S1, 2026-10-19).
//
// The server (supabase/migrations/20261019100000_s73_duels_core.sql) sends on these topics and its
// realtime.messages policies decide who may join them, so the phone must spell them EXACTLY the same
// way. topics.test.js reads the migration and fails if the two drift apart.
//
//   pilotTopic(uid)  — my personal inbox while I'm in Sector 73: invite / accepted / declined /
//                      cancelled. Only I may listen; nobody (not even me) may send.
//   duelTopic(id)    — one duel: the server's start / cancelled / round-void / round-result / finished messages, plus PRESENCE ("I'm here")
//                      from the two players. Players may not broadcast on it.
// Both are private channels: open them with supabase.channel(topic, { config: { private: true } }).

export const PILOT_TOPIC_PREFIX = 'sector73-pilot-';
export const DUEL_TOPIC_PREFIX = 'sector73-duel-';

/** Events the server sends (realtime.send): S1 lifecycle, S2 rounds, S3 results. Never any dice. */
export const DUEL_EVENTS = Object.freeze({
  invite: 'duel_invite',
  accepted: 'duel_accepted',
  declined: 'duel_declined',
  cancelled: 'duel_cancelled',
  start: 'duel_start',
  // S2 (20261019110000_s73_duel_rounds.sql): nobody won round n in 90 s → no point, next round at
  // next_starts_at. Payload { duel_id, n, next_starts_at }.
  roundVoid: 'duel_round_void',
  // S3 (20261019120000_s73_duel_referee.sql): round n closed → { duel_id, n, outcome, winner_id,
  // winning_equation, winner_duration_ms, challenger_score, opponent_score, first_to, status, finished,
  // closed_at, next_starts_at }. The equation is only sent once the round is over.
  roundResult: 'duel_round_result',
  // S3: the match is over → { duel_id, status, winner_id, end_reason, challenger_score, opponent_score, stars }.
  finished: 'duel_finished',
});

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;

function requireUuid(value, what) {
  if (typeof value !== 'string' || !UUID_RE.test(value)) throw new Error(`${what} must be a lowercase uuid`);
  return value;
}

/** @param {string} uid */
export const pilotTopic = (uid) => `${PILOT_TOPIC_PREFIX}${requireUuid(uid, 'uid')}`;

/** @param {string} duelId */
export const duelTopic = (duelId) => `${DUEL_TOPIC_PREFIX}${requireUuid(duelId, 'duel id')}`;

/** The duel id inside a duel topic, or null (mirrors the CASE in the migration's policies). */
export function duelIdFromTopic(topic) {
  if (typeof topic !== 'string' || !topic.startsWith(DUEL_TOPIC_PREFIX)) return null;
  const id = topic.slice(DUEL_TOPIC_PREFIX.length);
  return UUID_RE.test(id) ? id : null;
}
