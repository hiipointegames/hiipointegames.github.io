import React, { useEffect, useRef } from 'react';
import {
  stepShip, hasArrived, orbitPosition, approachPoint, dockRing, followCamera, cameraZoom,
  worldToScreen, screenToWorld, hitTest, shipSpeed, MAX_SPEED, pinchZoom, wheelZoom,
} from './flight';
import { brightStars, stepShooting, drifters, stepDrifters, drawBrightStars, drawShooting, drawDrifters } from './sky';
import { placeLabels, visualExtent } from './labels';
import { drawShip, readSavedLook, trailColor, DEFAULT_LOOK, shipScale } from './shipArt';
import { WORLD_HALF } from './worldObjects';
import { prefersReducedMotion } from '../fx/motionPrefs';
import { paintWorld, loadSprite } from './painter';
import { stepRemotes, shipAt } from '../multiplayer/rooms';
import { drawShipMark, PILOT_MARK, SELF_MARK } from './minimapMarks';
import { edgeArrows, arrowTargets, arrowAt, edgeInsets, ARROW_SIZE } from './edgeArrows';
import { dailyRing, labelTag, minimapDot } from './dailyMarks';

/** The gold ring of a Daily object (pulsing while open today; thin + ✓ once done). */
function drawDailyRing(g, o, p, r, s, time, still) {
  const ring = dailyRing(o, s.dailyDone, time, still);
  if (!ring) return;
  const rr = r * (o.paint?.rings ? 1.55 : 1.18) + 6;
  g.save();
  g.globalAlpha = ring.alpha;
  g.strokeStyle = ring.color;
  g.lineWidth = ring.width;
  g.shadowColor = ring.color;
  g.shadowBlur = ring.glow;
  g.beginPath(); g.arc(p.x, p.y, rr, 0, Math.PI * 2); g.stroke();
  if (ring.check) {
    const cx = p.x + rr * 0.72; const cy = p.y - rr * 0.72;
    g.globalAlpha = 0.95; g.shadowBlur = 0;
    g.fillStyle = '#3b2a05'; g.beginPath(); g.arc(cx, cy, 9, 0, Math.PI * 2); g.fill();
    g.lineWidth = 1.5; g.stroke();
    g.fillStyle = ring.color; g.font = '900 11px system-ui, sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillText('✓', cx, cy + 0.5);
  }
  g.restore();
}

/** Edge arrows (W5): a small disc with the place's icon, a pointer towards it. Semi-transparent. */
function drawEdgeArrows(g, arrows) {
  const r = ARROW_SIZE / 2;
  g.save();
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.font = '15px system-ui, sans-serif';
  for (const a of arrows) {
    g.globalAlpha = 0.78;
    // Pointer: a small triangle just outside the disc, towards the target.
    const ca = Math.cos(a.angle); const sa = Math.sin(a.angle);
    g.beginPath();
    g.moveTo(a.x + ca * (r + 7), a.y + sa * (r + 7));
    g.lineTo(a.x + ca * (r - 1) - sa * 6, a.y + sa * (r - 1) + ca * 6);
    g.lineTo(a.x + ca * (r - 1) + sa * 6, a.y + sa * (r - 1) - ca * 6);
    g.closePath();
    g.fillStyle = a.color;
    g.fill();
    g.beginPath(); g.arc(a.x, a.y, r, 0, Math.PI * 2);
    g.fillStyle = 'rgba(4, 3, 13, 0.7)';
    g.fill();
    g.lineWidth = 2;
    g.strokeStyle = a.color;
    g.stroke();
    g.globalAlpha = 0.95;
    g.fillStyle = a.color;
    g.fillText(a.icon, a.x, a.y + 1);
  }
  g.restore();
}

/** Other pilots' ships (multiplayer rooms): their own look, their name under them. */
function drawRemotes(g, s, cam, width, height, time) {
  if (!s.remotes?.size) return;
  const scale = shipScale(cam.zoom);
  g.textAlign = 'center';
  g.font = '700 11px system-ui, sans-serif';
  for (const r of s.remotes.values()) {
    const p = worldToScreen(r.ship, cam, width, height);
    if (p.x < -60 || p.x > width + 60 || p.y < -60 || p.y > height + 60) continue;
    g.save();
    g.translate(p.x, p.y);
    drawShip(g, r.ship, scale, time, r.meta?.look || DEFAULT_LOOK);
    g.restore();
    const name = r.meta?.name;
    if (!name) continue;
    const w = g.measureText(name).width + 8;
    const y = p.y + 26 * scale;
    g.fillStyle = 'rgba(4, 3, 13, 0.55)';
    const x = Math.max(w / 2 + 4, Math.min(width - w / 2 - 4, p.x)); // never cut off at the screen edge
    g.fillRect(x - w / 2, y - 10, w, 14);
    g.fillStyle = r.meta.look?.frame?.ring && r.meta.look.frame.ring !== '#000000' ? r.meta.look.frame.ring : '#e2e8f0';
    g.fillText(name, x, y + 1);
  }
}

// The cockpit's frame loop. React renders this <canvas> once; everything that
// moves lives in `sim` (a ref owned by the page) and is advanced + drawn here at
// display refresh rate, so flying never causes a React re-render. React only
// hears about DISCRETE events: onDock(id) when the ship settles into orbit.
//
// Pauses completely while `paused` (a mode is open) or the page is hidden.

// More, bigger and brighter stars (David, 2026-10-14: "the stars should be more visible").
const STAR_LAYERS = [
  { count: 300, parallax: 0.12, size: 1.1, alpha: 0.75 },
  { count: 170, parallax: 0.3, size: 1.6, alpha: 0.9 },
  { count: 90, parallax: 0.55, size: 2.3, alpha: 1 },
];
const STAR_TILE = 1400; // css px

const NEBULAE = [
  { x: -1500, y: -300, r: 1300, hue: 205 },
  { x: 1500, y: 650, r: 1400, hue: 285 },
  { x: 100, y: -1900, r: 1100, hue: 330 },
  { x: -2300, y: 1500, r: 1200, hue: 170 },
  { x: 2400, y: -1500, r: 1200, hue: 255 },
];

function seededStars() {
  let s = 73;
  const rnd = () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
  return STAR_LAYERS.map((layer) => ({
    ...layer,
    stars: Array.from({ length: layer.count }, () => ({ x: rnd(), y: rnd(), tw: rnd() * Math.PI * 2, warm: rnd() < 0.2 })),
  }));
}

const mod = (a, n) => ((a % n) + n) % n;

function drawWormhole(g, x, y, r, time) {
  for (let k = 0; k < 5; k++) {
    g.beginPath();
    const rr = r * (1 - k * 0.17);
    g.arc(x, y, rr, time * (1.2 + k * 0.4) + k, time * (1.2 + k * 0.4) + k + Math.PI * 1.3);
    g.strokeStyle = k % 2 ? `rgba(34, 211, 238, ${0.7 - k * 0.1})` : `rgba(168, 85, 247, ${0.85 - k * 0.1})`;
    g.lineWidth = Math.max(1.5, r * 0.09);
    g.shadowColor = '#a855f7';
    g.shadowBlur = 18;
    g.stroke();
  }
  g.shadowBlur = 0;
  const core = g.createRadialGradient(x, y, 0, x, y, r * 0.45);
  core.addColorStop(0, 'rgba(255,255,255,0.95)');
  core.addColorStop(0.4, 'rgba(196,181,253,0.6)');
  core.addColorStop(1, 'rgba(76,29,149,0)');
  g.fillStyle = core;
  g.beginPath(); g.arc(x, y, r * 0.45, 0, Math.PI * 2); g.fill();
}

function drawGateCore(g, x, y, r, time) {
  const pulse = 0.75 + Math.sin(time * 2.4) * 0.15;
  const core = g.createRadialGradient(x, y, 0, x, y, r * 0.8 * pulse);
  core.addColorStop(0, 'rgba(240, 220, 255, 0.85)');
  core.addColorStop(0.5, 'rgba(147, 51, 234, 0.35)');
  core.addColorStop(1, 'rgba(76, 29, 149, 0)');
  g.fillStyle = core;
  g.beginPath(); g.arc(x, y, r * 0.8, 0, Math.PI * 2); g.fill();
  g.save();
  g.translate(x, y);
  g.rotate(time * 0.8);
  for (let k = 0; k < 6; k++) {
    g.rotate(Math.PI / 3);
    g.beginPath(); g.moveTo(r * 0.2, 0); g.lineTo(r * 0.6, 0);
    g.strokeStyle = 'rgba(216, 180, 254, 0.5)';
    g.lineWidth = 1.5;
    g.stroke();
  }
  g.restore();
}

export default function WorldCanvas({ sim, objects, paused, onDock, onTap, minimapRef }) {
  const canvasRef = useRef(null);
  const pausedRef = useRef(paused);
  pausedRef.current = paused;
  const onDockRef = useRef(onDock);
  onDockRef.current = onDock;
  const onTapRef = useRef(onTap);
  onTapRef.current = onTap;

  useEffect(() => {
    const canvas = canvasRef.current;
    const g = canvas?.getContext?.('2d');
    if (!canvas || !g) return undefined;

    let width = 0; let height = 0; let dpr = 1; let baseZoom = 1;
    let sprites = new Map();
    let paintedZoom = 1; let zoomChangedAt = 0;
    // The on-screen controls, in canvas coordinates: labels stay out from under them.
    let hud = null;
    let arrowHud = null; // the HUD plus the mute button and the ★ line: edge arrows stay clear of these too
    let remeasureAt = -1; // a frame to measure again at (just after a dock, once the card has landed)
    // Labels avoid these; edge arrows avoid these AND the `arrowOnly` ones.
    /** @type {Array<[string, boolean]>} */
    const HUD = [
      ['[data-testid="sector73-joystick"]', false], ['[data-testid="return-to-37"]', false],
      ['[data-testid="fly-open"]', false], ['[data-testid="docking-card"]', false],
      ['[data-testid="sector73-mute"]', true], ['[data-testid="sector73-help"]', true], ['[data-testid="sector73-hud-title"]', true],
    ];
    // Safe areas + the native banner, read as px off a hidden probe (see edgeArrows.edgeInsets).
    const probe = document.createElement('div');
    probe.setAttribute('aria-hidden', 'true');
    probe.style.cssText = 'position:fixed;left:0;top:0;width:0;height:0;visibility:hidden;pointer-events:none;'
      + 'padding-top:var(--safe-top,0px);padding-bottom:calc(var(--safe-bottom,0px) + var(--ad-reserved-bottom,0px));';
    document.body.appendChild(probe);
    const targets = arrowTargets(objects);
    const viewport = { width: 0, height: 0, inset: edgeInsets(null), avoid: [] };
    /** One pass over the HUD: every control's rect read once, then split for labels and arrows. */
    const measureHud = () => {
      const c = canvas.getBoundingClientRect();
      const rect = (el) => { const r = el.getBoundingClientRect(); return { x: r.left - c.left, y: r.top - c.top, w: r.width, h: r.height }; };
      hud = []; arrowHud = [];
      for (const [sel, arrowOnly] of HUD) {
        const el = document.querySelector(sel);
        if (!el) continue;
        const r = rect(el);
        arrowHud.push(r);
        if (!arrowOnly) hud.push(r);
      }
      if (minimapRef?.current) { const r = rect(minimapRef.current); hud.push(r); arrowHud.push(r); }
      viewport.inset = edgeInsets(globalThis.getComputedStyle?.(probe));
    };
    const stars = seededStars();
    // The living sky: bright glinting stars, shooting stars, drifting bodies (./sky.js).
    let skyRnd = 7;
    const rnd = () => { skyRnd = (skyRnd * 16807) % 2147483647; return skyRnd / 2147483647; };
    const bright = brightStars();
    let shooting = { next: 1, active: [] };
    const drift = drifters(73, WORLD_HALF);
    const trail = [];
    const reducedMotion = prefersReducedMotion();

    const resize = () => {
      dpr = Math.min(2, globalThis.devicePixelRatio || 1);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      baseZoom = cameraZoom(width, height);
      sim.current.cam.zoom = baseZoom * (sim.current.userZoom ?? 1);
    };
    resize();
    // Paint once at the current zoom; swap in real art where an object has a sprite URL.
    sprites = paintWorld(objects, sim.current.cam.zoom * dpr);
    paintedZoom = sim.current.cam.zoom;
    objects.filter((o) => o.sprite).forEach((o) => {
      loadSprite(o.sprite).then((img) => {
        if (img) sprites.set(o.id, { canvas: img, worldSize: o.r * 2.4 });
      });
    });
    // Rotation / resize: re-measure the HUD and the insets on the very next frame.
    const onResize = () => { resize(); hud = null; };
    globalThis.addEventListener('resize', onResize);
    globalThis.addEventListener('orientationchange', onResize);

    let raf = 0;
    let last = performance.now();
    let frameNo = 0;

    const advance = (dt) => {
      const s = sim.current;
      s.time += dt;
      // Pinch / wheel zoom: follow the pilot's zoom; repaint the planets once it settles far from
      // the zoom they were painted at, so they stay crisp instead of blurring when magnified.
      const want = baseZoom * (s.userZoom ?? 1);
      if (Math.abs(want - s.cam.zoom) > 1e-6) { s.cam.zoom = want; zoomChangedAt = s.time; }
      const ratio = s.cam.zoom / paintedZoom;
      if ((ratio > 1.35 || ratio < 0.74) && s.time - zoomChangedAt > 0.25) {
        const keep = sprites;
        sprites = paintWorld(objects, s.cam.zoom * dpr);
        objects.filter((o) => o.sprite && keep.get(o.id)).forEach((o) => sprites.set(o.id, keep.get(o.id)));
        paintedZoom = s.cam.zoom;
      }
      shooting = stepShooting(shooting, dt, width, height, rnd);
      stepDrifters(drift, dt, WORLD_HALF);
      if (s.dockedId) {
        const obj = objects.find((o) => o.id === s.dockedId);
        if (obj) {
          s.orbitTheta += 0.32 * dt;
          const target = orbitPosition(obj, s.orbitTheta);
          // Ease into the orbit rather than snapping onto it.
          const k = Math.min(1, dt * 3);
          s.ship = {
            ...target,
            x: s.ship.x + (target.x - s.ship.x) * k,
            y: s.ship.y + (target.y - s.ship.y) * k,
          };
        }
      } else {
        const targetObj = s.autopilot.targetId ? objects.find((o) => o.id === s.autopilot.targetId) : null;
        const target = targetObj ? approachPoint(s.ship, targetObj) : s.autopilot.point;
        s.ship = stepShip(s.ship, { joystick: s.input.joystick, target }, dt);
        if (targetObj && hasArrived(s.ship, targetObj)) {
          s.dockedId = targetObj.id;
          s.autopilot.targetId = null;
          s.orbitTheta = Math.atan2(s.ship.y - targetObj.y, s.ship.x - targetObj.x);
          s.dockFxAt = s.time; // the docking-lock ring (dockRing)
          remeasureAt = frameNo + 24; // the docking card mounts now; measure it again once it has slid in
          onDockRef.current?.(targetObj.id);
        } else if (s.autopilot.point && Math.hypot(s.autopilot.point.x - s.ship.x, s.autopilot.point.y - s.ship.y) < 30) {
          s.autopilot.point = null;
        }
      }
      if (s.remotes?.size) stepRemotes(s.remotes, dt, objects, Date.now());
      s.cam = followCamera(s.cam, s.ship, dt);
      s.hum?.set(shipSpeed(s.ship) / MAX_SPEED * 0.8 + s.ship.thrust * 0.2);
      if (frameNo % 2 === 0) {
        trail.push({ x: s.ship.x, y: s.ship.y });
        if (trail.length > 40) trail.shift();
      }
    };

    const draw = () => {
      const s = sim.current;
      const { cam, time } = s;
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.fillStyle = '#04030d';
      g.fillRect(0, 0, width, height);

      // Nebula glow (parallax 0.5 so it drifts slower than the objects).
      const hues = (s.look ||= readSavedLook()).nebula; // world theme (Star Market)
      for (const [ni, n] of NEBULAE.entries()) {
        const p = worldToScreen({ x: n.x, y: n.y }, { ...cam, x: cam.x * 0.5, y: cam.y * 0.5 }, width, height);
        const r = n.r * cam.zoom;
        if (p.x + r < 0 || p.x - r > width || p.y + r < 0 || p.y - r > height) continue;
        const grad = g.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
        grad.addColorStop(0, `hsla(${hues[ni % hues.length] ?? n.hue}, 80%, 45%, 0.16)`);
        grad.addColorStop(1, 'hsla(0, 0%, 0%, 0)');
        g.fillStyle = grad;
        g.fillRect(p.x - r, p.y - r, r * 2, r * 2);
      }

      // Parallax star layers (tiled, so space never ends).
      for (const layer of stars) {
        const ox = -cam.x * cam.zoom * layer.parallax;
        const oy = -cam.y * cam.zoom * layer.parallax;
        for (const st of layer.stars) {
          const bx = mod(st.x * STAR_TILE + ox, STAR_TILE);
          const by = mod(st.y * STAR_TILE + oy, STAR_TILE);
          const a = layer.alpha * (0.7 + 0.3 * Math.sin(time * 1.5 + st.tw));
          g.fillStyle = st.warm ? `rgba(255, 228, 190, ${a})` : `rgba(220, 230, 255, ${a})`;
          for (let tx = bx; tx < width; tx += STAR_TILE) {
            for (let ty = by; ty < height; ty += STAR_TILE) {
              g.fillRect(tx, ty, layer.size, layer.size);
            }
          }
        }
      }

      drawBrightStars(g, bright, cam, width, height, time);
      drawShooting(g, shooting);
      drawDrifters(g, drift, (p) => worldToScreen(p, cam, width, height), cam.zoom, width, height);

      // World edge: a faint boundary so the map feels bounded but large.
      const tl = worldToScreen({ x: -WORLD_HALF, y: -WORLD_HALF }, cam, width, height);
      g.strokeStyle = 'rgba(168, 85, 247, 0.12)';
      g.setLineDash([10, 14]);
      g.lineWidth = 2;
      g.strokeRect(tl.x, tl.y, WORLD_HALF * 2 * cam.zoom, WORLD_HALF * 2 * cam.zoom);
      g.setLineDash([]);

      // Objects. Labels are collected and placed after, so none covers an object or another label.
      const labelItems = [];
      const nameSize = Math.max(10, Math.min(13, 11 * cam.zoom + 6));
      const tagSize = Math.max(9, Math.min(12, 10 * cam.zoom + 5));
      for (const o of objects) {
        const p = worldToScreen(o, cam, width, height);
        const reach = o.r * 1.6 * cam.zoom + 40;
        if (p.x < -reach || p.x > width + reach || p.y < -reach || p.y > height + reach) continue;
        const r = o.r * cam.zoom;
        if (o.paint.style === 'wormhole') {
          drawWormhole(g, p.x, p.y, r, time);
        } else {
          const spr = sprites.get(o.id);
          if (spr) {
            const size = spr.worldSize * cam.zoom;
            if (o.kind === 'beacon') {
              g.save(); g.translate(p.x, p.y); g.rotate(Math.sin(time * 0.6 + o.x) * 0.25);
              g.drawImage(spr.canvas, -size / 2, -size / 2, size, size);
              g.restore();
            } else {
              g.drawImage(spr.canvas, p.x - size / 2, p.y - size / 2, size, size);
            }
          }
          if (o.kind === 'gate') drawGateCore(g, p.x, p.y, r, time);
          if (o.kind === 'beacon') {
            const pulse = (Math.sin(time * 3 + o.y) + 1) / 2;
            g.beginPath(); g.arc(p.x, p.y - r * 0.7, 2 + pulse * 3, 0, Math.PI * 2);
            g.fillStyle = `hsla(${o.paint.hue}, 100%, 70%, ${0.5 + pulse * 0.5})`;
            g.shadowColor = `hsl(${o.paint.hue}, 100%, 60%)`; g.shadowBlur = 12; g.fill(); g.shadowBlur = 0;
          }
          if (o.paint.moons) {
            o.paint.moons.forEach((color, i) => {
              const a = time * (0.3 + i * 0.12) + i * 2.1;
              const d = r * (1.45 + i * 0.22);
              g.beginPath(); g.arc(p.x + Math.cos(a) * d, p.y + Math.sin(a) * d * 0.6, Math.max(2, r * 0.1), 0, Math.PI * 2);
              g.fillStyle = color; g.shadowColor = color; g.shadowBlur = 10; g.fill(); g.shadowBlur = 0;
            });
          }
        }
        drawDailyRing(g, o, p, r, s, time, reducedMotion);
        // Label: measured now, placed after every object is known.
        const tag = labelTag(o, s.dailyDone);
        g.font = `800 ${nameSize}px system-ui, sans-serif`;
        const nameW = g.measureText(o.name.toUpperCase()).width;
        g.font = `800 ${tagSize}px system-ui, sans-serif`;
        const tagW = tag ? g.measureText(tag).width : 0;
        const ext = visualExtent(o);
        labelItems.push({ id: o.id, o, tag, x: p.x, y: p.y, rx: r * ext.rx, ry: r * ext.ry, w: Math.max(nameW, tagW) + 8, h: nameSize + (tag ? tagSize + 3 : 0) + 4 });
      }
      if (frameNo % 30 === 0 || !hud || frameNo === remeasureAt) measureHud();
      const spots = placeLabels(labelItems, hud);
      g.textAlign = 'center';
      for (const it of labelItems) {
        const box = spots.get(it.id);
        if (!box) continue; // nowhere free: hidden rather than stacked
        const o = it.o;
        const cx = box.x + box.w / 2;
        g.fillStyle = 'rgba(4, 3, 13, 0.45)'; // a soft backing so busy space never swallows the text
        g.fillRect(box.x, box.y, box.w, box.h);
        g.font = `${s.dockedId === o.id ? 800 : 700} ${nameSize}px system-ui, sans-serif`;
        g.fillStyle = o.region === 'far' ? 'rgba(216, 180, 254, 0.95)' : 'rgba(226, 232, 240, 0.92)';
        g.fillText(o.name.toUpperCase(), cx, box.y + nameSize + 1);
        // What it IS, under the name (David: the daily planets "should show what each one is").
        if (it.tag) {
          g.font = `800 ${tagSize}px system-ui, sans-serif`;
          g.fillStyle = o.tagColor || '#fde68a';
          g.fillText(it.tag, cx, box.y + nameSize + 3 + tagSize);
        }
      }

      // Autopilot destination ring.
      const targetObj = s.autopilot.targetId ? objects.find((o) => o.id === s.autopilot.targetId) : null;
      if (targetObj) {
        const p = worldToScreen(targetObj, cam, width, height);
        g.save();
        g.translate(p.x, p.y);
        g.rotate(time * 0.6);
        g.setLineDash([8, 10]);
        g.beginPath(); g.arc(0, 0, targetObj.r * cam.zoom + 22, 0, Math.PI * 2);
        g.strokeStyle = 'rgba(34, 211, 238, 0.7)'; g.lineWidth = 2; g.stroke();
        g.restore();
        g.setLineDash([]);
      } else if (s.autopilot.point) {
        const p = worldToScreen(s.autopilot.point, cam, width, height);
        g.beginPath(); g.arc(p.x, p.y, 10 + Math.sin(time * 5) * 2, 0, Math.PI * 2);
        g.strokeStyle = 'rgba(34, 211, 238, 0.6)'; g.lineWidth = 1.5; g.stroke();
      }

      // Engine trail.
      if (trail.length > 1) {
        g.lineCap = 'round';
        for (let i = 1; i < trail.length; i++) {
          const a = worldToScreen(trail[i - 1], cam, width, height);
          const b = worldToScreen(trail[i], cam, width, height);
          g.beginPath(); g.moveTo(a.x, a.y); g.lineTo(b.x, b.y);
          g.globalAlpha = (i / trail.length) * 0.5; // the trail you bought (Star Market)
          g.strokeStyle = trailColor(s.look ||= readSavedLook(), i, trail.length);
          g.lineWidth = (i / trail.length) * 5;
          g.stroke();
        }
        g.globalAlpha = 1;
      }

      drawRemotes(g, s, cam, width, height, time);

      // Ship.
      const sp = worldToScreen(s.ship, cam, width, height);
      g.save();
      g.translate(sp.x, sp.y);
      drawShip(g, s.ship, shipScale(cam.zoom), time, s.look ||= readSavedLook());
      g.restore();

      // Docking lock: a tractor ring contracts onto the ship (skipped for reduced motion).
      const ring = s.dockFxAt != null && !reducedMotion ? dockRing(time - s.dockFxAt) : null;
      if (ring) {
        g.save();
        g.strokeStyle = `rgba(103, 232, 249, ${ring.alpha.toFixed(3)})`;
        g.lineWidth = 2.5;
        g.beginPath();
        g.arc(sp.x, sp.y, ring.radius * cam.zoom, 0, Math.PI * 2);
        g.stroke();
        g.restore();
      } else if (s.dockFxAt != null && time - s.dockFxAt > 1) {
        s.dockFxAt = null;
      }

      // Edge arrows to the games + Star Market that are off-screen (W5). Kept on the sim so a tap can
      // hit-test the ones on screen right now.
      viewport.width = width; viewport.height = height; viewport.avoid = arrowHud || [];
      s.edgeArrows = edgeArrows(cam, viewport, targets, s.edgeArrows || []);
      drawEdgeArrows(g, s.edgeArrows);
    };

    const drawMinimap = () => {
      const mm = minimapRef?.current;
      const mg = mm?.getContext?.('2d');
      if (!mg) return;
      const size = mm.clientWidth;
      if (mm.width !== size * dpr) { mm.width = size * dpr; mm.height = size * dpr; }
      mg.setTransform(dpr, 0, 0, dpr, 0, 0);
      mg.clearRect(0, 0, size, size);
      mg.fillStyle = 'rgba(8, 6, 24, 0.75)';
      mg.beginPath(); mg.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2); mg.fill();
      const k = (size / 2 - 6) / WORLD_HALF;
      const s = sim.current;
      const dotState = { dockedId: s.dockedId, targetId: s.autopilot.targetId, done: s.dailyDone };
      for (const o of objects) {
        const dot = minimapDot(o, dotState);
        mg.beginPath();
        mg.arc(size / 2 + o.x * k, size / 2 + o.y * k, Math.max(o.daily ? 3 : 2, o.r * k * 1.2), 0, Math.PI * 2);
        if (dot.hollow) { mg.strokeStyle = dot.color; mg.lineWidth = 1.5; mg.stroke(); } else { mg.fillStyle = dot.color; mg.fill(); }
      }
      // View rectangle.
      const vw = (width / s.cam.zoom) * k; const vh = (height / s.cam.zoom) * k;
      mg.strokeStyle = 'rgba(255,255,255,0.25)'; mg.lineWidth = 1;
      mg.strokeRect(size / 2 + s.cam.x * k - vw / 2, size / 2 + s.cam.y * k - vh / 2, vw, vh);
      // Ships are arrows, never dots (./minimapMarks.js): other pilots green, yours white, on top.
      for (const r of s.remotes?.values() || []) {
        drawShipMark(mg, size / 2 + r.ship.x * k, size / 2 + r.ship.y * k, r.ship.angle, PILOT_MARK);
      }
      drawShipMark(mg, size / 2 + s.ship.x * k, size / 2 + s.ship.y * k, s.ship.angle, SELF_MARK);
    };

    const frame = (now) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      frameNo++;
      if (!pausedRef.current && !(typeof document !== 'undefined' && document.hidden)) {
        advance(dt);
        draw();
        if (frameNo % 3 === 0) drawMinimap();
      }
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    return () => {
      cancelAnimationFrame(raf);
      globalThis.removeEventListener('resize', onResize);
      globalThis.removeEventListener('orientationchange', onResize);
      probe.remove();
    };
  }, [sim, objects, minimapRef]);

  // Tap = pointer down + up without much travel (a drag is not a tap). Two fingers = pinch zoom
  // (David, 2026-10-14), and a pinch never counts as a tap.
  const downRef = useRef(null);
  const pointers = useRef(new Map());
  const pinch = useRef(null);
  const spread = () => { const [a, b] = [...pointers.current.values()]; return Math.hypot(a.x - b.x, a.y - b.y); };
  const onPointerDown = (e) => {
    pointers.current.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.current.size === 2) {
      pinch.current = { startZoom: sim.current.userZoom ?? 1, startDist: spread() };
      downRef.current = null;
    } else if (pointers.current.size === 1) downRef.current = { x: e.clientX, y: e.clientY };
  };
  const onPointerMove = (e) => {
    if (!pointers.current.has(e.pointerId)) return;
    pointers.current.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinch.current && pointers.current.size >= 2) sim.current.userZoom = pinchZoom(pinch.current.startZoom, pinch.current.startDist, spread());
  };
  const onWheel = (e) => { sim.current.userZoom = wheelZoom(sim.current.userZoom ?? 1, e.deltaY); };
  const onPointerUp = (e) => {
    pointers.current.delete(e.pointerId);
    if (pinch.current) { if (pointers.current.size < 2) pinch.current = null; downRef.current = null; return; }
    const d = downRef.current;
    downRef.current = null;
    if (!d || Math.hypot(e.clientX - d.x, e.clientY - d.y) > 12) return;
    const canvas = canvasRef.current;
    const rect = canvas.getBoundingClientRect();
    const s = sim.current;
    const local = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    const world = screenToWorld(local, s.cam, rect.width, rect.height);
    // A tap on an edge arrow flies to the place it points at.
    const arrow = s.edgeArrows?.length ? arrowAt(s.edgeArrows, local.x, local.y) : null;
    if (arrow) { onTapRef.current?.(world, arrow.object, null); return; }
    // Another pilot's ship wins over the planet behind it: ~40 px of finger around it.
    const ship = s.remotes?.size ? shipAt(s.remotes, world, 50 / s.cam.zoom) : null;
    onTapRef.current?.(world, ship ? null : hitTest(objects, world), ship);
  };

  return (
    <canvas
      ref={canvasRef}
      data-testid="sector73-world"
      className="absolute inset-0 w-full h-full"
      style={{ touchAction: 'none' }}
      onPointerDown={onPointerDown}
      onPointerMove={onPointerMove}
      onPointerUp={onPointerUp}
      onPointerCancel={(e) => { pointers.current.delete(e.pointerId); if (pointers.current.size < 2) pinch.current = null; }}
      onWheel={onWheel}
    />
  );
}
