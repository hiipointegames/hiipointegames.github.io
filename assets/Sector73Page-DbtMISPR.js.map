import { useEffect, useState } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { useAuth } from '@/auth';
import { prefersReducedMotion } from '../fx/motionPrefs';
import { fadesFromWhite } from './ArrivalFade';
import { startPose } from './flight';

/**
 * How the cockpit opens (W2 + W5, 2026-10-19) — the page's arrival wiring in one tested hook.
 *
 *   pose     → where the ship and camera start: back where it left (a round trip), else the
 *              signed-in pilot's own seeded spot near the Mirror (flight.startPose). Read once.
 *   fadeIn   → fade in from white? Only when the portal's flash really reached white
 *              (location.state.entry === 'white') and the phone allows motion. Read once.
 *   fadeDone → call when the fade has finished.
 *
 * The entry flag is then removed from this history entry (replace, other state kept), so coming
 * Back here from a planet's screen doesn't flash white again. So is the first warp's `arrival` flag
 * (world lane 2026-10-22): the page reads it ONCE at mount (its unlock pass), and a Back onto this
 * entry must not count as a new arrival (it used to bring the welcome card back).
 *
 * @param {{ ship: {x:number,y:number,angle:number} | null }} resume
 */
export function useCockpitArrival(resume) {
  const location = useLocation();
  const navigate = useNavigate();
  const { user } = useAuth();
  const [pose] = useState(() => startPose(resume?.ship ?? null, user?.id));
  const [fadeIn, setFadeIn] = useState(() => fadesFromWhite(location.state, prefersReducedMotion()));

  useEffect(() => {
    if (location.state?.entry === undefined && location.state?.arrival === undefined) return;
    const { entry: _seen, arrival: _arrived, ...rest } = location.state;
    navigate(`${location.pathname}${location.search}`, { replace: true, state: Object.keys(rest).length ? rest : null });
  }, []); // once, on arrival: the flag is read at mount and cleared

  return { pose, fadeIn, fadeDone: () => setFadeIn(false) };
}
