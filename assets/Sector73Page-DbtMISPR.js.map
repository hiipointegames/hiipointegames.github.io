// Device-local personal bests for the Sector 73 modes (David's pick for the
// prototype: progress stays on the device; account saving comes with leaderboards).
//
// Each mode reports a numeric score + a direction ('high' = more is better,
// 'low' = less is better) and a formatter for the docking card line.

// Re-Entry's rules changed twice on 2026-10-14 (points → free descent → guided descent), so its
// best lives under a NEW name: an old number can never be misread as a landing time.
const STORE = { reEntry: 'reEntryV2' }; // v2 = fair-days generator (2026-10-18); v1 times are not comparable
const KEY = (mode) => `sector73.best.${STORE[mode] ?? mode}`;
const clock = (ms) => { const t = Math.floor(ms / 100); return `${Math.floor(t / 600)}:${String(Math.floor((t % 600) / 10)).padStart(2, '0')}.${t % 10}`; };

const FORMAT = {
  hyperjump: (v) => `Best run: ${v} ${v === 1 ? 'jump' : 'jumps'} cleared`,
  firstContact: (v) => `Best decode: ${v}/6 transmissions`,
  starChart: (v) => `Charts solved: ${v}`,
  // Re-Entry (Guided Descent, 2026-10-14): the fastest landing, in milliseconds.
  reEntry: (v) => `Best landing: ${clock(v)}`,
};

const DIRECTION = { hyperjump: 'high', firstContact: 'low', starChart: 'high', reEntry: 'low' };


/** @returns {number | null} */
export function readBestValue(mode) {
  try {
    const raw = globalThis.localStorage?.getItem(KEY(mode));
    if (raw == null) return null;
    const n = Number(raw);
    if (!Number.isFinite(n)) return null;
    return n;
  } catch {
    return null;
  }
}

/** Docking-card line for a mode's best, or null if never played. */
export function readBest(mode) {
  const v = readBestValue(mode);
  return v == null ? null : (FORMAT[mode] || String)(v);
}

/**
 * Record a result; keeps it only if it beats the stored best.
 * @returns {boolean} true if this is a new best
 */
export function recordBest(mode, value) {
  if (!Number.isFinite(value)) return false;
  const prev = readBestValue(mode);
  const better = prev == null
    || (DIRECTION[mode] === 'low' ? value < prev : value > prev);
  if (!better) return false;
  try {
    globalThis.localStorage?.setItem(KEY(mode), String(value));
  } catch {
    return false;
  }
  return true;
}

/** Counter-style modes (Star Chart: charts solved) add instead of compare. */
export function incrementBest(mode) {
  const next = (readBestValue(mode) || 0) + 1;
  try { globalThis.localStorage?.setItem(KEY(mode), String(next)); } catch { /* storage blocked */ }
  return next;
}
