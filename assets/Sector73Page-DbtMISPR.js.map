// Sector 73's living sky (David, 2026-10-14: "the stars should be more visible in the background,
// and more shooting stars and floating bodies should be present"). Drawn by WorldCanvas behind the
// objects; everything here is cheap 2D canvas work, and seeded, so the sky is the same every visit.
//
//   • bright stars  — the largest stars get a soft glow and a four-point glint that twinkles
//   • shooting stars — screen-space streaks, a new one every 1.2–3.5 s, sometimes two at once
//   • drifters      — asteroids, comets with tails, and old satellites drifting through the world

export const SHOOT_MIN_GAP = 1.2;
export const SHOOT_MAX_GAP = 3.5;
export const SHOOT_LIFE = 0.9; // seconds a shooting star is visible

const makeRnd = (seed) => {
  let s = seed;
  return () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
};

/** Bright stars on a tile (fractions of the tile), each with a twinkle phase and a tint. */
export function brightStars(count = 26, seed = 37) {
  const rnd = makeRnd(seed);
  return Array.from({ length: count }, () => ({ x: rnd(), y: rnd(), size: 1.6 + rnd() * 1.8, tw: rnd() * Math.PI * 2, hue: rnd() < 0.3 ? 40 : rnd() < 0.5 ? 200 : 260 }));
}

/**
 * Shooting stars: a small scheduler. `step(state, dt, w, h, rnd)` returns the next state:
 * { next: seconds until the next one, active: [{ x, y, vx, vy, age }] }.
 */
export function stepShooting(state, dt, w, h, rnd) {
  const active = state.active
    .map((s) => ({ ...s, x: s.x + s.vx * dt, y: s.y + s.vy * dt, age: s.age + dt }))
    .filter((s) => s.age < SHOOT_LIFE);
  let next = state.next - dt;
  if (next <= 0) {
    const n = rnd() < 0.25 ? 2 : 1;
    for (let i = 0; i < n; i++) {
      const fromLeft = rnd() < 0.5;
      const speed = 700 + rnd() * 600;
      const ang = (fromLeft ? 0.35 : Math.PI - 0.35) + (rnd() - 0.5) * 0.5;
      active.push({ x: fromLeft ? rnd() * w * 0.5 : w * (0.5 + rnd() * 0.5), y: rnd() * h * 0.55, vx: Math.cos(ang) * speed, vy: Math.sin(ang) * speed, age: 0 });
    }
    next = SHOOT_MIN_GAP + rnd() * (SHOOT_MAX_GAP - SHOOT_MIN_GAP);
  }
  return { next, active };
}

/** Drifting bodies in WORLD space: asteroids, comets and derelict satellites. */
export function drifters(seed = 73, half = 3000) {
  const rnd = makeRnd(seed);
  const kinds = ['asteroid', 'asteroid', 'asteroid', 'comet', 'satellite'];
  return Array.from({ length: 34 }, (_, i) => {
    const kind = kinds[i % kinds.length];
    return {
      kind,
      x: (rnd() * 2 - 1) * half, y: (rnd() * 2 - 1) * half,
      vx: (rnd() - 0.5) * (kind === 'comet' ? 90 : 26), vy: (rnd() - 0.5) * (kind === 'comet' ? 90 : 26),
      r: kind === 'comet' ? 10 + rnd() * 8 : kind === 'satellite' ? 14 : 8 + rnd() * 26,
      spin: (rnd() - 0.5) * 0.8, angle: rnd() * Math.PI * 2, shape: Array.from({ length: 9 }, () => 0.7 + rnd() * 0.3),
    };
  });
}

/** Move the drifters; they wrap around the world edge. */
export function stepDrifters(list, dt, half = 3000) {
  for (const d of list) {
    d.x += d.vx * dt; d.y += d.vy * dt; d.angle += d.spin * dt;
    if (d.x > half) d.x -= 2 * half; else if (d.x < -half) d.x += 2 * half;
    if (d.y > half) d.y -= 2 * half; else if (d.y < -half) d.y += 2 * half;
  }
  return list;
}

// ── Drawing ──────────────────────────────────────────────────────────────────

export function drawBrightStars(g, stars, cam, width, height, time, tile = 1400, parallax = 0.4) {
  const ox = -cam.x * cam.zoom * parallax; const oy = -cam.y * cam.zoom * parallax;
  const mod = (a, n) => ((a % n) + n) % n;
  for (const st of stars) {
    const bx = mod(st.x * tile + ox, tile); const by = mod(st.y * tile + oy, tile);
    const tw = 0.6 + 0.4 * Math.sin(time * 2 + st.tw);
    for (let x = bx; x < width; x += tile) {
      for (let y = by; y < height; y += tile) {
        const glow = g.createRadialGradient(x, y, 0, x, y, st.size * 5);
        glow.addColorStop(0, `hsla(${st.hue}, 90%, 92%, ${0.9 * tw})`);
        glow.addColorStop(1, 'hsla(0, 0%, 0%, 0)');
        g.fillStyle = glow; g.fillRect(x - st.size * 5, y - st.size * 5, st.size * 10, st.size * 10);
        g.strokeStyle = `hsla(${st.hue}, 90%, 95%, ${0.55 * tw})`; g.lineWidth = 0.8;
        const L = st.size * 4 * tw;
        g.beginPath(); g.moveTo(x - L, y); g.lineTo(x + L, y); g.moveTo(x, y - L); g.lineTo(x, y + L); g.stroke();
      }
    }
  }
}

export function drawShooting(g, state) {
  g.lineCap = 'round';
  for (const s of state.active) {
    const life = 1 - s.age / SHOOT_LIFE;
    const tail = 0.09;
    const grad = g.createLinearGradient(s.x, s.y, s.x - s.vx * tail, s.y - s.vy * tail);
    grad.addColorStop(0, `rgba(255,255,255,${life})`);
    grad.addColorStop(1, 'rgba(196,181,253,0)');
    g.strokeStyle = grad; g.lineWidth = 2;
    g.beginPath(); g.moveTo(s.x, s.y); g.lineTo(s.x - s.vx * tail, s.y - s.vy * tail); g.stroke();
  }
}

export function drawDrifters(g, list, toScreen, zoom, width, height) {
  for (const d of list) {
    const p = toScreen(d);
    const r = d.r * zoom;
    if (p.x < -200 || p.x > width + 200 || p.y < -200 || p.y > height + 200) continue;
    g.save(); g.translate(p.x, p.y);
    if (d.kind === 'comet') {
      const sp = Math.hypot(d.vx, d.vy) || 1;
      const tx = (-d.vx / sp) * r * 9; const ty = (-d.vy / sp) * r * 9;
      const tailG = g.createLinearGradient(0, 0, tx, ty);
      tailG.addColorStop(0, 'rgba(165,243,252,0.75)'); tailG.addColorStop(1, 'rgba(165,243,252,0)');
      g.strokeStyle = tailG; g.lineWidth = r * 1.2; g.lineCap = 'round';
      g.beginPath(); g.moveTo(0, 0); g.lineTo(tx, ty); g.stroke();
      g.fillStyle = '#ecfeff'; g.shadowColor = '#67e8f9'; g.shadowBlur = 14;
      g.beginPath(); g.arc(0, 0, r * 0.6, 0, Math.PI * 2); g.fill(); g.shadowBlur = 0;
    } else if (d.kind === 'satellite') {
      g.rotate(d.angle);
      g.fillStyle = '#94a3b8'; g.fillRect(-r * 0.35, -r * 0.35, r * 0.7, r * 0.7);
      g.fillStyle = '#1e3a8a'; g.fillRect(-r * 1.4, -r * 0.2, r * 0.9, r * 0.4); g.fillRect(r * 0.5, -r * 0.2, r * 0.9, r * 0.4);
      const blink = (Math.sin(d.angle * 6) + 1) / 2;
      g.fillStyle = `rgba(248,113,113,${blink})`; g.beginPath(); g.arc(0, -r * 0.5, Math.max(1, r * 0.12), 0, Math.PI * 2); g.fill();
    } else {
      g.rotate(d.angle);
      g.beginPath();
      d.shape.forEach((k, i) => {
        const a = (i / d.shape.length) * Math.PI * 2;
        const x = Math.cos(a) * r * k; const y = Math.sin(a) * r * k;
        if (i) g.lineTo(x, y); else g.moveTo(x, y);
      });
      g.closePath();
      const rock = g.createRadialGradient(-r * 0.3, -r * 0.3, 0, 0, 0, r);
      rock.addColorStop(0, '#a8a29e'); rock.addColorStop(1, '#44403c');
      g.fillStyle = rock; g.fill();
      g.strokeStyle = 'rgba(0,0,0,0.35)'; g.lineWidth = 1; g.stroke();
    }
    g.restore();
  }
}
