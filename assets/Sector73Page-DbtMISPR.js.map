// Procedural "painted" art for the cockpit world — the placeholder until David's
// AI-generated images arrive (then an object's `sprite` URL wins; see
// worldObjects.js). Everything here renders ONCE per object to an offscreen
// canvas, which the frame loop then just blits — so the per-pixel work below is a
// one-off cost of a few tens of milliseconds at world load, never per frame.
//
// Planets are lit spheres: for each pixel inside the disc we reconstruct the
// sphere's surface normal, sample 3-D value noise ON the sphere (so there is no
// seam), colour by style, then shade by a fixed sun direction. Stations, gates
// and dishes are vector drawings.

const LIGHT = (() => {
  const v = [-0.55, -0.6, 0.58];
  const l = Math.hypot(...v);
  return v.map((c) => c / l);
})();

// ── seeded value noise ──────────────────────────────────────────────────────
function mulberry32(seed) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export function makeNoise(seed = 1) {
  const rand = mulberry32(seed * 9973 + 17);
  const perm = new Uint8Array(512);
  const p = Array.from({ length: 256 }, (_, i) => i);
  for (let i = 255; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [p[i], p[j]] = [p[j], p[i]];
  }
  for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
  const vals = Float32Array.from({ length: 256 }, () => rand());
  const fade = (t) => t * t * (3 - 2 * t);
  const lerp = (a, b, t) => a + (b - a) * t;
  const v = (x, y, z) => vals[perm[perm[perm[x & 255] + (y & 255)] + (z & 255)]];
  const noise3 = (x, y, z) => {
    const xi = Math.floor(x); const yi = Math.floor(y); const zi = Math.floor(z);
    const xf = fade(x - xi); const yf = fade(y - yi); const zf = fade(z - zi);
    const x00 = lerp(v(xi, yi, zi), v(xi + 1, yi, zi), xf);
    const x10 = lerp(v(xi, yi + 1, zi), v(xi + 1, yi + 1, zi), xf);
    const x01 = lerp(v(xi, yi, zi + 1), v(xi + 1, yi, zi + 1), xf);
    const x11 = lerp(v(xi, yi + 1, zi + 1), v(xi + 1, yi + 1, zi + 1), xf);
    return lerp(lerp(x00, x10, yf), lerp(x01, x11, yf), zf);
  };
  const fbm = (x, y, z, octaves = 5) => {
    let sum = 0; let amp = 0.5; let freq = 1; let norm = 0;
    for (let o = 0; o < octaves; o++) {
      sum += amp * noise3(x * freq, y * freq, z * freq);
      norm += amp;
      amp *= 0.5;
      freq *= 2.03;
    }
    return sum / norm;
  };
  return { noise3, fbm };
}

// ── colour helpers ──────────────────────────────────────────────────────────
const mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
const clamp01 = (t) => Math.max(0, Math.min(1, t));
const smooth = (e0, e1, x) => { const t = clamp01((x - e0) / (e1 - e0)); return t * t * (3 - 2 * t); };
const hsl = (h, s, l) => `hsl(${h}, ${s}%, ${l}%)`;

/** Surface colour [r,g,b] (0..255) + emissive 0..1 for one sphere point. */
function surface(style, n, noise, seed) {
  const [x, y, z] = n;
  const s = seed * 1.7;
  switch (style) {
    case 'terran': {
      const h = noise.fbm(x * 1.8 + s, y * 1.8, z * 1.8);
      const cloud = noise.fbm(x * 3 + 40, y * 6 + s, z * 3, 4);
      let c;
      if (h < 0.5) c = mix([8, 30, 90], [30, 110, 170], smooth(0.3, 0.5, h));
      else if (h < 0.53) c = [194, 178, 128];
      else c = mix([40, 120, 60], [110, 95, 60], smooth(0.55, 0.72, h));
      const ice = smooth(0.78, 0.9, Math.abs(y));
      c = mix(c, [235, 245, 255], ice);
      c = mix(c, [250, 252, 255], smooth(0.55, 0.72, cloud) * 0.85);
      return { c, e: 0 };
    }
    case 'lava': {
      const h = noise.fbm(x * 2.2 + s, y * 2.2, z * 2.2);
      const crack = 1 - smooth(0.0, 0.035, Math.abs(h - 0.5));
      const c = mix([38, 14, 12], [70, 30, 22], h);
      return { c: mix(c, [255, 140, 40], crack), e: crack };
    }
    case 'gas': {
      const turb = noise.fbm(x * 2 + s, y * 2, z * 2, 4);
      const band = Math.sin((y * 9 + turb * 3.2) * 1.0);
      const c1 = [214, 170, 92]; const c2 = [150, 96, 50]; const c3 = [240, 220, 170];
      let c = mix(c1, c2, (band + 1) / 2);
      c = mix(c, c3, smooth(0.6, 0.75, noise.fbm(x * 4, y * 14 + s, z * 4, 3)) * 0.6);
      // A storm eye.
      const eye = Math.hypot(x - 0.35, y - 0.25);
      c = mix(c, [190, 70, 40], (1 - smooth(0.05, 0.13, eye)) * 0.8);
      return { c, e: 0 };
    }
    case 'ice': {
      const h = noise.fbm(x * 2.5 + s, y * 2.5, z * 2.5);
      const crater = smooth(0.62, 0.7, noise.fbm(x * 6 + 9, y * 6, z * 6 + s, 3));
      let c = mix([170, 200, 230], [235, 245, 255], h);
      c = mix(c, [110, 140, 180], crater * 0.6);
      const glow = 1 - smooth(0.0, 0.02, Math.abs(h - 0.47));
      return { c: mix(c, [120, 230, 255], glow), e: glow * 0.7 };
    }
    case 'desert': {
      const h = noise.fbm(x * 1.6 + s, y * 1.6, z * 1.6);
      const dunes = Math.sin((x * 14 + noise.fbm(x * 3, y * 3, z * 3 + s) * 6) * 1.0) * 0.5 + 0.5;
      let c = mix([150, 80, 40], [225, 160, 95], h);
      c = mix(c, [200, 120, 70], dunes * 0.25);
      c = mix(c, [110, 55, 35], smooth(0.62, 0.7, h));
      return { c, e: 0 };
    }
    case 'rocky':
    default: {
      const h = noise.fbm(x * 2.4 + s, y * 2.4, z * 2.4);
      const crater = smooth(0.6, 0.66, noise.fbm(x * 7, y * 7 + s, z * 7, 3));
      let c = mix([70, 80, 100], [150, 160, 180], h);
      c = mix(c, [45, 50, 65], crater * 0.7);
      return { c, e: 0 };
    }
  }
}

const ATMOSPHERE = {
  terran: 'rgba(110, 190, 255, 0.55)',
  lava: 'rgba(255, 110, 40, 0.5)',
  gas: 'rgba(255, 210, 140, 0.4)',
  ice: 'rgba(150, 220, 255, 0.5)',
  desert: 'rgba(255, 170, 110, 0.4)',
  rocky: 'rgba(150, 170, 220, 0.3)',
};

function makeCanvas(size) {
  if (typeof document === 'undefined') return null;
  const c = document.createElement('canvas');
  c.width = size;
  c.height = size;
  return c;
}

/** Render a lit planet disc of diameter `d` px into a new canvas. */
function paintSphere(style, seed, d) {
  const canvas = makeCanvas(d);
  const g = canvas?.getContext('2d');
  if (!g) return null;
  const img = g.createImageData(d, d);
  const noise = makeNoise(seed);
  const rad = d / 2;
  for (let py = 0; py < d; py++) {
    for (let px = 0; px < d; px++) {
      const x = (px + 0.5 - rad) / rad;
      const y = (py + 0.5 - rad) / rad;
      const r2 = x * x + y * y;
      if (r2 > 1) continue;
      const z = Math.sqrt(1 - r2);
      const { c, e } = surface(style, [x, y, z], noise, seed);
      const lambert = Math.max(0, x * LIGHT[0] + y * LIGHT[1] + z * LIGHT[2]);
      const shade = 0.12 + 0.88 * Math.pow(lambert, 0.85);
      const lit = Math.max(shade, e);
      // Anti-aliased edge.
      const edge = clamp01((1 - Math.sqrt(r2)) * rad * 1.5);
      const i = (py * d + px) * 4;
      img.data[i] = Math.min(255, c[0] * lit);
      img.data[i + 1] = Math.min(255, c[1] * lit);
      img.data[i + 2] = Math.min(255, c[2] * lit);
      img.data[i + 3] = 255 * edge;
    }
  }
  g.putImageData(img, 0, 0);
  return canvas;
}

/**
 * Paint a planet/moon sprite. The canvas is padded (×1.5) so the atmosphere
 * glow and rings fit; `scale` = canvas px per world unit at 1× zoom.
 */
function paintPlanet(obj, pixelsPerUnit) {
  const style = obj.paint.style;
  const d = Math.round(Math.max(96, Math.min(420, obj.r * 2 * pixelsPerUnit)));
  const sphere = paintSphere(style, obj.paint.seed || 1, d);
  if (!sphere) return null;
  const pad = obj.paint.rings ? 2.2 : 1.5;
  const size = Math.round(d * pad);
  const canvas = makeCanvas(size);
  const g = canvas.getContext('2d');
  const cx = size / 2;
  const rad = d / 2;

  const ring = (front) => {
    g.save();
    g.translate(cx, cx);
    g.rotate(-0.35);
    g.scale(1, 0.28);
    for (let k = 0; k < 6; k++) {
      g.beginPath();
      g.arc(0, 0, rad * (1.35 + k * 0.1), front ? 0 : Math.PI, front ? Math.PI : Math.PI * 2);
      g.strokeStyle = `rgba(${230 - k * 12}, ${200 - k * 15}, ${150 - k * 10}, ${0.55 - k * 0.06})`;
      g.lineWidth = rad * 0.07;
      g.stroke();
    }
    g.restore();
  };

  // Atmosphere glow behind the disc.
  const glow = g.createRadialGradient(cx, cx, rad * 0.9, cx, cx, rad * 1.35);
  glow.addColorStop(0, ATMOSPHERE[style] || ATMOSPHERE.rocky);
  glow.addColorStop(1, 'rgba(0,0,0,0)');
  g.fillStyle = glow;
  g.fillRect(0, 0, size, size);

  if (obj.paint.rings) ring(false);
  g.drawImage(sphere, cx - rad, cx - rad);
  // Rim light on the sunward edge.
  g.save();
  g.globalCompositeOperation = 'lighter';
  const rim = g.createRadialGradient(cx - rad * 0.3, cx - rad * 0.35, rad * 0.75, cx, cx, rad * 1.02);
  rim.addColorStop(0, 'rgba(0,0,0,0)');
  rim.addColorStop(1, ATMOSPHERE[style] || ATMOSPHERE.rocky);
  g.beginPath();
  g.arc(cx, cx, rad, 0, Math.PI * 2);
  g.fillStyle = rim;
  g.fill();
  g.restore();
  if (obj.paint.rings) ring(true);
  return { canvas };
}

/** Vector-drawn structures (stations, gate, array, beacon, nebula). */
function paintStructure(obj, pixelsPerUnit) {
  const size = Math.round(Math.max(96, Math.min(420, obj.r * 2.6 * pixelsPerUnit)));
  const canvas = makeCanvas(size);
  const g = canvas?.getContext('2d');
  if (!g) return null;
  const c = size / 2;
  const R = size / 2.6;
  const hue = obj.paint.hue ?? 200;
  g.lineCap = 'round';
  g.lineJoin = 'round';

  const glowStroke = (width, color, blur = 12) => {
    g.shadowColor = color;
    g.shadowBlur = blur;
    g.strokeStyle = color;
    g.lineWidth = width;
    g.stroke();
    g.shadowBlur = 0;
  };

  switch (obj.paint.style) {
    case 'station': {
      // Torus ring with spokes and a lit hub.
      g.save();
      g.translate(c, c);
      g.scale(1, 0.55);
      g.beginPath(); g.arc(0, 0, R, 0, Math.PI * 2);
      glowStroke(R * 0.16, hsl(hue, 30, 55), 4);
      g.beginPath(); g.arc(0, 0, R, 0, Math.PI * 2);
      glowStroke(R * 0.04, hsl(hue, 90, 70), 14);
      for (let k = 0; k < 6; k++) {
        const a = (k / 6) * Math.PI * 2;
        g.beginPath(); g.moveTo(0, 0); g.lineTo(Math.cos(a) * R, Math.sin(a) * R);
        glowStroke(R * 0.04, hsl(hue, 20, 60), 0);
      }
      g.restore();
      g.beginPath(); g.arc(c, c, R * 0.22, 0, Math.PI * 2);
      g.fillStyle = hsl(hue, 25, 40); g.fill();
      glowStroke(R * 0.04, hsl(hue, 90, 75), 16);
      for (let k = 0; k < 14; k++) {
        const a = (k / 14) * Math.PI * 2;
        g.beginPath();
        g.arc(c + Math.cos(a) * R, c + Math.sin(a) * R * 0.55, R * 0.025, 0, Math.PI * 2);
        g.fillStyle = k % 3 ? '#fde68a' : hsl(hue, 100, 75); g.fill();
      }
      break;
    }
    case 'observatory': {
      // A dome on a platform with a big dish pointed at the sky.
      g.fillStyle = hsl(hue, 15, 30);
      g.fillRect(c - R, c + R * 0.25, R * 2, R * 0.22);
      g.beginPath(); g.arc(c - R * 0.3, c + R * 0.25, R * 0.55, Math.PI, 0);
      g.fillStyle = hsl(hue, 20, 55); g.fill();
      glowStroke(R * 0.03, hsl(hue, 90, 70), 10);
      g.fillStyle = hsl(hue, 90, 70);
      g.fillRect(c - R * 0.36, c - R * 0.3, R * 0.12, R * 0.55);
      g.save(); g.translate(c + R * 0.55, c - R * 0.15); g.rotate(-0.6);
      g.beginPath(); g.ellipse(0, 0, R * 0.5, R * 0.18, 0, 0, Math.PI * 2);
      g.fillStyle = hsl(hue, 10, 80); g.fill();
      glowStroke(R * 0.03, hsl(hue, 90, 70), 10);
      g.restore();
      for (let k = 0; k < 7; k++) {
        g.beginPath(); g.arc(c - R + (k + 0.5) * (R * 2 / 7), c + R * 0.36, R * 0.03, 0, Math.PI * 2);
        g.fillStyle = '#fde68a'; g.fill();
      }
      break;
    }
    case 'array': {
      // Three radio dishes listening to the dark.
      [[-0.55, 0.1, 0.42], [0.1, -0.25, 0.55], [0.6, 0.2, 0.38]].forEach(([dx, dy, s]) => {
        const x = c + dx * R; const y = c + dy * R;
        g.beginPath(); g.moveTo(x, y); g.lineTo(x, y + R * 0.6);
        glowStroke(R * 0.05, hsl(hue, 15, 55), 0);
        g.save(); g.translate(x, y); g.rotate(-0.5);
        g.beginPath(); g.ellipse(0, 0, R * s, R * s * 0.45, 0, 0, Math.PI);
        g.fillStyle = hsl(hue, 10, 82); g.fill();
        glowStroke(R * 0.025, hsl(hue, 90, 65), 10);
        g.beginPath(); g.moveTo(0, 0); g.lineTo(0, -R * s * 0.6);
        glowStroke(R * 0.02, hsl(hue, 20, 70), 0);
        g.restore();
      });
      g.fillStyle = hsl(hue, 15, 25);
      g.fillRect(c - R, c + R * 0.62, R * 2, R * 0.16);
      break;
    }
    case 'gate': {
      // Segmented ring; the core is animated in the frame loop.
      for (let k = 0; k < 12; k++) {
        const a0 = (k / 12) * Math.PI * 2 + 0.06;
        const a1 = ((k + 1) / 12) * Math.PI * 2 - 0.06;
        g.beginPath(); g.arc(c, c, R, a0, a1);
        glowStroke(R * 0.14, hsl(hue, 25, 45), 0);
        g.beginPath(); g.arc(c, c, R, a0, a1);
        glowStroke(R * 0.035, hsl(hue, 95, 72), 16);
      }
      break;
    }
    case 'beacon': {
      // Small satellite: body, two solar panels, antenna.
      g.fillStyle = '#1e293b';
      g.fillRect(c - R * 0.95, c - R * 0.18, R * 0.6, R * 0.36);
      g.fillRect(c + R * 0.35, c - R * 0.18, R * 0.6, R * 0.36);
      g.strokeStyle = hsl(hue, 60, 60); g.lineWidth = R * 0.03;
      g.strokeRect(c - R * 0.95, c - R * 0.18, R * 0.6, R * 0.36);
      g.strokeRect(c + R * 0.35, c - R * 0.18, R * 0.6, R * 0.36);
      g.beginPath(); g.arc(c, c, R * 0.3, 0, Math.PI * 2);
      g.fillStyle = hsl(hue, 20, 70); g.fill();
      glowStroke(R * 0.04, hsl(hue, 90, 65), 10);
      g.beginPath(); g.moveTo(c, c - R * 0.3); g.lineTo(c, c - R * 0.75);
      glowStroke(R * 0.03, hsl(hue, 20, 75), 0);
      break;
    }
    case 'nebula': {
      for (let k = 0; k < 9; k++) {
        const a = k * 2.4;
        const x = c + Math.cos(a) * R * 0.5 * ((k % 3) / 2 + 0.3);
        const y = c + Math.sin(a) * R * 0.45 * ((k % 4) / 3 + 0.3);
        const grad = g.createRadialGradient(x, y, 0, x, y, R * 0.7);
        grad.addColorStop(0, `hsla(${hue + k * 12}, 90%, 65%, 0.35)`);
        grad.addColorStop(1, 'hsla(0, 0%, 0%, 0)');
        g.fillStyle = grad;
        g.fillRect(0, 0, size, size);
      }
      for (let k = 0; k < 40; k++) {
        const a = k * 1.7; const d = (k * 37 % 100) / 100;
        g.beginPath(); g.arc(c + Math.cos(a) * R * d, c + Math.sin(a) * R * d * 0.8, 1 + (k % 3), 0, Math.PI * 2);
        g.fillStyle = k % 4 ? '#fff7d6' : '#fde047'; g.fill();
      }
      break;
    }
    default:
      return null;
  }
  return { canvas, worldSize: obj.r * 2.6 };
}

const PLANET_STYLES = new Set(['terran', 'lava', 'gas', 'ice', 'desert', 'rocky']);

/**
 * Build the sprite cache for every object. `pixelsPerUnit` is how many device
 * pixels one world unit will occupy at normal zoom (so sprites are crisp, not
 * over-sized). Returns Map<id, { canvas | image, worldSize }>.
 */
export function paintWorld(objects, pixelsPerUnit) {
  const cache = new Map();
  for (const obj of objects) {
    let entry = null;
    if (PLANET_STYLES.has(obj.paint?.style)) {
      const d = Math.round(Math.max(96, Math.min(420, obj.r * 2 * pixelsPerUnit)));
      const res = paintPlanet(obj, pixelsPerUnit);
      if (res) entry = { canvas: res.canvas, worldSize: obj.r * 2 * (res.canvas.width / d) };
    } else if (obj.paint?.style !== 'wormhole') {
      entry = paintStructure(obj, pixelsPerUnit);
    }
    if (entry) cache.set(obj.id, entry);
  }
  return cache;
}

/** Load an image sprite (David's art). Resolves null on failure → painted fallback stays. */
export function loadSprite(url) {
  return new Promise((resolve) => {
    if (typeof Image === 'undefined' || !url) { resolve(null); return; }
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = () => resolve(null);
    img.src = url;
  });
}
