// Sector 73 multiplayer — the pure half (no network, no React; unit-tested).
//
// HOW IT WORKS (David, 2026-10-14: "each Sector 73 is its own world… see the other ships").
// A "server" is one Supabase Realtime channel, `sector73-room-N`, with up to ROOM_CAP live pilots.
// You join room 1; if it is full you move on to room 2, and so on, so pilots fill rooms together
// instead of scattering one per room.
//
// Ships do NOT stream their position every frame — that would cost 60 messages a second per pilot,
// times every pilot listening. Instead each phone sends its pilot's ORDERS (stick direction, the
// point or planet it is flying to, the planet it is orbiting) only when they change, and at most
// every sendInterval(); every other phone runs the same flight model (stepShip) on those orders, so
// the ship flies smoothly between messages. A periodic KEYFRAME carries the true position, and any
// drift is blended out over BLEND_S instead of snapping.
//
// Realtime bills every delivered message (one send + one per listener), so the interval stretches
// as the room fills: 2 pilots ≈ 2 orders a second each, a full room ≈ one every 5½ s.

import { stepShip, approachPoint, orbitPosition } from '../world/flight';

export const ROOM_CAP = 37;
export const MAX_ROOMS = 40;
export const KEYFRAME_MS = 5000;
export const STALE_MS = 20000; // no word from a ship for this long → it is gone
export const BLEND_S = 0.4;
export const SNAP_DIST = 700;  // further off than this → jump, don't glide

export const roomTopic = (n) => `sector73-room-${n}`;

/** Fewer sends per pilot as the room fills (ms between orders). */
export const sendInterval = (pilots) => Math.max(500, pilots * 150);

/**
 * The pilots in a room from a Realtime presence state, oldest arrival first, one per account.
 * @param {Record<string, Array<any>>} state
 * @returns {Array<{uid: string, joined: number}>}
 */
export function pilotsIn(state) {
  const byUid = new Map();
  for (const [key, metas] of Object.entries(state || {})) {
    for (const m of metas || []) {
      const uid = m?.uid || key;
      const joined = Number(m?.joined) || 0;
      const had = byUid.get(uid);
      if (!had || joined < had.joined) byUid.set(uid, { uid, joined });
    }
  }
  return [...byUid.values()].sort((a, b) => a.joined - b.joined || (a.uid < b.uid ? -1 : 1));
}

/** Did I arrive after the room was already full? (Two pilots can race into the 37th seat.) */
export function overflowed(state, uid) {
  const i = pilotsIn(state).findIndex((p) => p.uid === uid);
  return i >= ROOM_CAP;
}

const r1 = (v) => Math.round(v);
const r2 = (v) => Math.round(v * 100) / 100;

/**
 * The orders to send for my ship, from the cockpit's sim.
 * @returns {{u:string,x:number,y:number,vx:number,vy:number,a:number,j:number[]|null,t:number[]|null,o:string|null,d:string|null}}
 */
export function encodeOrder(uid, s) {
  const j = s.input?.joystick;
  const p = s.autopilot?.point;
  return {
    u: uid,
    x: r1(s.ship.x), y: r1(s.ship.y), vx: r1(s.ship.vx), vy: r1(s.ship.vy), a: r2(s.ship.angle),
    j: j && Math.hypot(j.x, j.y) > 0.08 ? [r2(j.x), r2(j.y)] : null,
    t: p ? [r1(p.x), r1(p.y)] : null,
    o: s.autopilot?.targetId || null,
    d: s.dockedId || null,
  };
}

/** What the pilot is DOING, coarse enough that small stick wobbles don't trigger a send. */
export function intentKey(order) {
  const q = (v) => Math.round(v * 4) / 4;
  return [order.j ? `${q(order.j[0])},${q(order.j[1])}` : '-', order.t ? `${Math.round(order.t[0] / 20)},${Math.round(order.t[1] / 20)}` : '-', order.o || '-', order.d || '-'].join('|');
}

/**
 * Send now? On a change of intent once the interval has passed, and always on the keyframe.
 * @param {{lastAt: number|null, lastKey: string|null}} sent
 */
export function shouldSend(sent, order, now, pilots) {
  if (sent.lastAt == null) return true;
  const elapsed = now - sent.lastAt;
  if (elapsed >= Math.max(KEYFRAME_MS, sendInterval(pilots))) return true;
  return intentKey(order) !== sent.lastKey && elapsed >= sendInterval(pilots);
}

/** Take in a ship's orders. `remotes` is a Map uid → remote ship, changed in place. */
export function applyOrder(remotes, order, now) {
  if (!order?.u || !Number.isFinite(order.x) || !Number.isFinite(order.y)) return;
  const fresh = { x: order.x, y: order.y, vx: order.vx || 0, vy: order.vy || 0, angle: order.a || 0, thrust: 0 };
  const had = remotes.get(order.u);
  const orders = { joystick: order.j ? { x: order.j[0], y: order.j[1] } : null, point: order.t ? { x: order.t[0], y: order.t[1] } : null, targetId: order.o || null, dockedId: order.d || null };
  if (!had) {
    remotes.set(order.u, { uid: order.u, ship: fresh, orders, err: { x: 0, y: 0 }, heard: now, theta: null, meta: null });
    return;
  }
  const dx = fresh.x - had.ship.x; const dy = fresh.y - had.ship.y;
  if (Math.hypot(dx, dy) > SNAP_DIST) { had.ship = fresh; had.err = { x: 0, y: 0 }; } else {
    had.ship = { ...had.ship, vx: fresh.vx, vy: fresh.vy };
    had.err = { x: dx, y: dy };
  }
  if (orders.dockedId !== had.orders.dockedId) had.theta = null;
  had.orders = orders;
  had.heard = now;
}

/** Fly every other ship one frame on its last orders, and forget ships that went quiet. */
export function stepRemotes(remotes, dt, objects, now) {
  for (const [uid, r] of remotes) {
    if (now - r.heard > STALE_MS) { remotes.delete(uid); continue; }
    const { orders } = r;
    const docked = orders.dockedId ? objects.find((o) => o.id === orders.dockedId) : null;
    if (docked) {
      if (r.theta == null) r.theta = Math.atan2(r.ship.y - docked.y, r.ship.x - docked.x);
      r.theta += 0.32 * dt;
      const p = orbitPosition(docked, r.theta);
      const k = Math.min(1, dt * 3);
      r.ship = { ...p, x: r.ship.x + (p.x - r.ship.x) * k, y: r.ship.y + (p.y - r.ship.y) * k };
    } else {
      const toward = orders.targetId ? objects.find((o) => o.id === orders.targetId) : null;
      const target = toward ? approachPoint(r.ship, toward) : orders.point;
      r.ship = stepShip(r.ship, { joystick: orders.joystick, target }, dt);
    }
    // Glide out the gap between where we guessed and where the keyframe said.
    const k = Math.min(1, dt / BLEND_S);
    r.ship.x += r.err.x * k; r.ship.y += r.err.y * k;
    r.err.x -= r.err.x * k; r.err.y -= r.err.y * k;
  }
}

/** The other ship under a tap (world coords), within `reach` world units, nearest first. */
export function shipAt(remotes, p, reach) {
  let best = null; let bestD = reach;
  for (const r of remotes.values()) {
    const d = Math.hypot(r.ship.x - p.x, r.ship.y - p.y);
    if (d <= bestD) { best = r; bestD = d; }
  }
  return best;
}
