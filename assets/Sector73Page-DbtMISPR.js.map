// "Mira reconnecting… 0:30" — the reconnect countdown of a live duel (design-v2 D7, slice S7 minimum).
//
// The countdown runs to the opponent's SERVER last_seen + 30 s (the moment s73_duel_claim_forfeit
// would be granted), converted to this phone's clock with the server offset. It is NOT started by a
// presence drop alone: on iOS a suspended socket sends no "leave", and a flaky socket can drop
// presence while the phone is still calling `here` every 10 s. So it is shown when presence is gone
// OR last_seen is older than 22 s, and it always counts from last_seen.

export const FORFEIT_AFTER_MS = 30000;
// Both phones report every 10 s, so a healthy opponent's last_seen as I see it can be up to ~20 s
// old (their 0–10 s phase + my 0–10 s since my last reply). 22 s = 2 × the 10 s cadence + 2 s, so a
// healthy opponent never shows the banner while their presence is up (S6 review M2).
export const SHOW_AFTER_MS = 22000;

/** Server ISO time → this phone's ms, given offset = serverMs − localMs. */
export const toLocalMs = (iso, offset) => {
  const t = Date.parse(String(iso ?? ''));
  return Number.isFinite(t) ? t - (Number(offset) || 0) : null;
};

/**
 * Whole seconds left before the opponent forfeits (0 = claim now), or null when no countdown shows.
 * @param {{ lastSeen: string|null, offset: number, present: boolean, now: number }} p
 */
export function secondsLeft({ lastSeen, offset, present, now }) {
  const seen = toLocalMs(lastSeen, offset);
  if (seen == null) return null;
  const quiet = now - seen;
  if (present && quiet < SHOW_AFTER_MS) return null;
  return Math.max(0, Math.ceil((seen + FORFEIT_AFTER_MS - now) / 1000));
}

/** "0:30" */
export const mmss = (secs) => `${Math.floor(Math.max(0, secs) / 60)}:${String(Math.max(0, secs) % 60).padStart(2, '0')}`;
