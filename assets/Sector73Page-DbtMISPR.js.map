// Pip layouts for Sector 73's neon glass dice (David, 2026-10-05: "all of the dice need
// to actually be dice with pips"). Same positions as the main game's DiceDisplay, on a
// 100×100 face, so a 5 reads as a 5 in both universes.

export const PIPS = Object.freeze({
  1: [[50, 50]],
  2: [[25, 25], [75, 75]],
  3: [[25, 25], [50, 50], [75, 75]],
  4: [[25, 25], [75, 25], [25, 75], [75, 75]],
  5: [[25, 25], [75, 25], [50, 50], [25, 75], [75, 75]],
  6: [[25, 25], [75, 25], [25, 50], [75, 50], [25, 75], [75, 75]],
});

/** Pip centres for a die value, or null when the value is not a die face (draw a numeral instead). */
export const pipsFor = (value) => (Number.isInteger(value) && PIPS[value] ? PIPS[value] : null);

// Neon palette per die colour: the glow colour of the rim + pips, and a lighter "core" for the
// hot centre of each pip. White dice glow starlight-lavender; power dice glow their colour.
// Feedback colours (First Contact) reuse the same shape.
export const NEON = Object.freeze({
  white: { glow: '#c7d2fe', core: '#ffffff' },
  blue: { glow: '#38bdf8', core: '#e0f2fe' },
  red: { glow: '#fb7185', core: '#ffe4e6' },
  green: { glow: '#34d399', core: '#d1fae5' },
  yellow: { glow: '#fbbf24', core: '#fef3c7' },
  grey: { glow: '#64748b', core: '#cbd5e1' },
  violet: { glow: '#a78bfa', core: '#ede9fe' },
  rose: { glow: '#fb7185', core: '#fff1f2' },
  amber: { glow: '#fbbf24', core: '#fffbeb' },
  lime: { glow: '#a3e635', core: '#f7fee7' },
  cyan: { glow: '#22d3ee', core: '#ecfeff' },
  fuchsia: { glow: '#e879f9', core: '#fdf4ff' },
  gold: { glow: '#facc15', core: '#fefce8' }, // Hyperjump's Tens Die (10–60)
});

export const neonFor = (color) => NEON[color] || NEON.white;

/**
 * Star Chart's number pad: each value is its own colour so 1–6 are told apart at a glance
 * (David, S21 2026-10-10: "each their own awesomely colored and uniquely visualed dice").
 */
export const PAD_COLORS = Object.freeze({ 1: 'rose', 2: 'amber', 3: 'lime', 4: 'cyan', 5: 'violet', 6: 'fuchsia' });
