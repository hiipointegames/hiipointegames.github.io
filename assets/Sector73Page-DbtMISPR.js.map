import React from 'react';
import { pipsFor, neonFor } from './pips';

// Sector 73's die: dark glass with glowing neon pips (David's pick, 2026-10-05).
//
// Performance: the glow is faked with SVG radial gradients (a hot core fading to the
// colour, then to transparent) instead of CSS/SVG blur filters — Re-Entry shows 21 dice
// at once and blur filters are expensive on Android WebView. One <defs> per die keeps
// each die self-contained; gradient ids are unique per colour so duplicates are harmless.

/** The die face as an SVG (no button) — used inside SpaceDie and for small read-only dice. */
export function NeonDieFace({ value, color = 'white', hidden = false, dim = false, size = 44, radius = 0.22 }) {
  const { glow, core } = neonFor(color);
  const pips = hidden ? null : pipsFor(value);
  const gid = `s73pip-${color}`;
  const fid = `s73face-${color}`;
  const r = 100 * radius;
  return (
    <svg
      viewBox="0 0 100 100"
      width={size}
      height={size}
      aria-hidden="true"
      data-die-face={hidden ? 'hidden' : value}
      style={{ display: 'block', opacity: dim ? 0.28 : 1, overflow: 'visible' }}
    >
      <defs>
        <radialGradient id={gid}>
          <stop offset="0%" stopColor={core} />
          <stop offset="45%" stopColor={glow} />
          <stop offset="100%" stopColor={glow} stopOpacity="0" />
        </radialGradient>
        <linearGradient id={fid} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stopColor="#3b3486" />
          <stop offset="55%" stopColor="#1c1850" />
          <stop offset="100%" stopColor="#0d0b2a" />
        </linearGradient>
      </defs>
      {/* Brighter against the dark backgrounds (David, S21 2026-10-10): a stronger halo, a glass
          body tinted with the die's colour, a full-strength rim, a clearer sheen, bigger pips. */}
      <rect x="-6" y="-6" width="112" height="112" rx={r + 6} fill={glow} opacity={dim ? 0 : 0.3} />
      <rect x="2" y="2" width="96" height="96" rx={r} fill={`url(#${fid})`} />
      <rect x="2" y="2" width="96" height="96" rx={r} fill={glow} opacity="0.16" />
      <rect x="2" y="2" width="96" height="96" rx={r} fill="none" stroke={glow} strokeWidth="4.5" />
      <path d={`M ${r} 6 H ${100 - r} Q 94 6 94 ${r} V 30 Q 50 22 6 30 V ${r} Q 6 6 ${r} 6 Z`} fill="#ffffff" opacity="0.14" />
      {pips && pips.map(([cx, cy], i) => (
        <g key={i}>
          <circle cx={cx} cy={cy} r="16" fill={`url(#${gid})`} opacity="0.75" />
          <circle data-pip="" cx={cx} cy={cy} r="9.5" fill={glow} />
          <circle cx={cx} cy={cy} r="5" fill={core} />
        </g>
      ))}
      {!pips && (
        <text x="50" y="52" textAnchor="middle" dominantBaseline="middle" fontSize="52" fontWeight="900" fill={core}
          style={{ paintOrder: 'stroke', stroke: glow, strokeWidth: 2 }}>
          {hidden ? '?' : value}
        </text>
      )}
    </svg>
  );
}
