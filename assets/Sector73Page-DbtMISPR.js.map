import React, { useEffect, useState } from 'react';
import { createPortal } from 'react-dom';
import { fetchBoard, scoreText, formatMs, GAME_TITLE } from './dailyRuns';

// Today's leaderboard for one Sector 73 Daily (David, 2026-10-14: "today, top 37 + you", shown on
// the finish screen and from the planet's docking card). Portaled to <body> so it sits above
// everything on iPhone too (memory: ios-overlays-must-portal).

/** `day` (YYYY-MM-DD, optional) = a Daily pinned before midnight; null = the server's today. */
function useBoard(game, refreshKey, day = null) {
  const [rows, setRows] = useState(/** @type {any[] | null | undefined} */ (undefined)); // undefined = loading
  useEffect(() => {
    let alive = true;
    setRows(undefined);
    fetchBoard(game, day).then((r) => { if (alive) setRows(r); });
    return () => { alive = false; };
  }, [game, refreshKey, day]);
  return rows;
}

/** The full board, as an overlay. */
export default function DailyBoard({ game, onClose, day = null }) {
  const rows = useBoard(game, 0, day);
  const players = rows?.[0]?.players ?? 0;
  return createPortal(
    <div className="fixed inset-0 z-[10001] flex items-center justify-center bg-black/70 px-3" data-testid="daily-board"
      style={{ paddingTop: 'calc(var(--safe-top, 0px) + 12px)', paddingBottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 12px)' }}
      onPointerDown={(e) => { e.stopPropagation(); if (e.target === e.currentTarget) onClose(); }}>
      <div className="flex max-h-full w-full max-w-md flex-col rounded-2xl border border-amber-300/40 bg-[#0b0820] p-4 text-white"
        style={{ boxShadow: '0 0 40px -12px #f59e0b' }}>
        <div className="flex items-center justify-between">
          <div>
            <div className="text-[10px] uppercase tracking-[0.3em] text-amber-200">Today&apos;s Daily · Sector 73</div>
            <div className="text-lg font-black">🏆 {GAME_TITLE[game]}</div>
          </div>
          <button type="button" onClick={onClose} aria-label="Close" className="rounded-full border border-white/20 px-3 py-1 text-sm">✕</button>
        </div>
        <div className="mt-1 text-xs text-slate-400">{players ? `${players} pilot${players === 1 ? '' : 's'} today` : ''}</div>
        <div className="mt-2 flex-1 overflow-y-auto" data-testid="daily-board-rows">
          {rows === undefined && <p className="py-6 text-center text-sm text-slate-400">Loading…</p>}
          {rows === null && <p className="py-6 text-center text-sm text-slate-400">Can&apos;t reach the board right now.</p>}
          {rows && rows.length === 0 && <p className="py-6 text-center text-sm text-slate-400">No one has finished today&apos;s Daily yet — be the first.</p>}
          {rows && rows.map((r) => (
            <div key={r.user_id} data-me={r.is_me || undefined}
              className={`flex items-center gap-2 border-b border-white/5 py-2 text-sm ${r.is_me ? 'rounded-lg bg-amber-400/10 px-2' : ''}`}>
              <span className="w-8 text-right font-black text-amber-200">#{r.place}</span>
              <span className="min-w-0 flex-1 truncate font-bold">{r.username || 'Pilot'}{r.is_me ? ' (you)' : ''}</span>
              <span className="text-xs text-slate-300">{scoreText(game, r.score)}</span>
              <span className="w-14 text-right text-xs tabular-nums text-slate-400">{formatMs(r.ms)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>,
    document.body,
  );
}

/** Re-Entry's lines for when your place can't be shown (opt-in via DailyPlace `status`). */
export const PLACE_LINES = Object.freeze({
  guest: 'Save your account to get on the board',
  signedOut: 'Sign in to be ranked',
  queued: 'Saved — it’s sent when you’re back online',
  dropped: "This run isn't on today's board",
  posted: "You're on today's board",
  pending: 'Sending…', // the result is on its way (before the server answers)
});

/**
 * "Today: #2 of 5 · See the board" — for a finish screen. Waits for the result to be recorded.
 * Opt-in `status` (Re-Entry): lead with "#2 of 5 today", or a line saying why it can't; `quiet`
 * shows the place small (a run that gave up).
 */
export function DailyPlace({ game, recorded, day = null, status = undefined, quiet = false }) {
  const rows = useBoard(game, recorded, day);
  const [open, setOpen] = useState(false);
  const me = rows?.find((r) => r.is_me);
  if (status !== undefined) {
    // Opt-in (Re-Entry): your place leads — "#2 of 5 today" — or a clear line saying why it can't.
    const line = me ? `#${me.place} of ${me.players} today` : PLACE_LINES[status] ?? PLACE_LINES.queued;
    return (
      <div className="mt-2 space-y-1 text-center" data-testid="daily-place">
        <div data-testid="daily-place-line" data-known={me ? 'true' : undefined} className={`font-black ${me && !quiet ? 'text-2xl text-amber-200' : 'text-sm text-slate-300'}`}>{line}</div>
        <button type="button" onClick={() => setOpen(true)} className="rounded-full border border-amber-300/50 bg-amber-400/10 px-4 py-1.5 text-sm font-bold text-amber-100">
          🏆 See the board
        </button>
        {open && <DailyBoard game={game} day={day} onClose={() => setOpen(false)} />}
      </div>
    );
  }
  return (
    <div className="mt-2 text-center" data-testid="daily-place">
      <button type="button" onClick={() => setOpen(true)} className="rounded-full border border-amber-300/50 bg-amber-400/10 px-4 py-1.5 text-sm font-bold text-amber-100">
        🏆 {me ? `Today: #${me.place} of ${me.players}` : "Today's board"} · See the board
      </button>
      {open && <DailyBoard game={game} day={day} onClose={() => setOpen(false)} />}
    </div>
  );
}
