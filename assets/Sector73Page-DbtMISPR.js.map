// How to earn ★ — the rows of the Star Market's "How to earn" sheet (audit 2026-10-18, M1).
//
// Built FROM the reward table the app sends to the server (REWARDS + REWARD_CAPS in ../rewards), so
// the sheet can't say something different from what pays. Two lines are not Sector 73 rewards at
// all: the server DERIVES them in sector73_star_balance() from the main 37 game — each 37 Daily
// finished (one per mode) and each Blitz battle win. A third kind the server PAYS by itself, with no
// request from the app: SERVER_REWARDS (a live duel win, paid when the match finishes).
// earnRules.drift.test.js reads the newest definition of each server function in
// supabase/migrations and fails if any number here drifts.

import { REWARDS, REWARD_CAPS, SERVER_REWARDS, capText } from '../rewards';
import { DAILY_MODES } from '../../mirror';

/** What each Sector 73 reward is called on the sheet (every REWARDS key needs one — a test checks). */
export const REWARD_INFO = Object.freeze({
  re_landing: { icon: '🪂', label: 'Re-Entry Daily landing' },
  re_one_turn: { icon: '✨', label: 'Re-Entry clean landing (no Undo, no power-ups)', bonus: true }, // Re-Entry lane 2026-10-22
  hj_core: { icon: '🌀', label: 'Hyperjump Core · Daily' },
  hj_core_free: { icon: '🌀', label: 'Hyperjump Core · Free' },
  fc_bounty: { icon: '👽', label: 'First Contact Daily bonus' },
  sc_bounty: { icon: '🗺️', label: 'Star Chart Bonus' },
});

/**
 * What each SERVER-paid reward is called on the sheet (every SERVER_REWARDS key needs one — a test
 * checks). These ★ are paid by the server when the thing happens; the app never asks for them.
 */
export const SERVER_REWARD_INFO = Object.freeze({
  s73_duel_win: { icon: '🛸', label: 'Live duel win (vs a pilot)' },
});

/** The main-game lines the server derives (not in REWARDS): ★ per 37 Daily, ★ per Blitz win. */
export const DERIVED = Object.freeze({ daily37: 1, blitzWin: 2 });

export { capText };

/**
 * The sheet's rows, in reading order.
 * @returns {Array<{ key: string, icon: string, label: string, stars: string, cap: string }>}
 */
export function earnRows() {
  const modes = DAILY_MODES.length;
  return [
    { key: 'daily37', icon: '🎲', label: 'Each 37 Daily you finish', stars: `${DERIVED.daily37}★`, cap: `one per mode, up to ${modes} a day` },
    { key: 'blitzWin', icon: '⚔️', label: 'Blitz battle win', stars: `${DERIVED.blitzWin}★`, cap: 'every win' },
    ...Object.entries(SERVER_REWARDS).map(([key, rule]) => {
      const info = SERVER_REWARD_INFO[key] || { icon: '★', label: key };
      return { key, icon: info.icon, label: info.label, stars: `${rule.amount}★`, cap: `${capText(rule.dailyCap)}, ${rule.perOpponentCap} per pilot` };
    }),
    ...Object.keys(REWARDS).sort((a, b) => order(a) - order(b)).map((key) => {
      const info = REWARD_INFO[key] || { icon: '★', label: key };
      return { key, icon: info.icon, label: info.label, stars: `${info.bonus ? '+' : ''}${REWARDS[key]}★`, cap: capText(REWARD_CAPS[key]) };
    }),
  ];
}

const ORDER = Object.keys(REWARD_INFO);
const order = (key) => (ORDER.includes(key) ? ORDER.indexOf(key) : ORDER.length);
