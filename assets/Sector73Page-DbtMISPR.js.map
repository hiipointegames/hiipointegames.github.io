// Today's Dailies, all seven, for the map, the FLY list and the docking cards (world lane, 2026-10-22,
// D3-A). One place that knows, BEFORE any ad, whether each Daily is still open:
//
//   the four Sector 73 games → RPC sector73_daily_status() (the caller's own rows today; migration
//                              20261022120000). Until that migration is applied the RPC fails and
//                              those four read 'unknown' (the card then offers Play; the game's own
//                              START still asks the server, as before).
//   37's three Dailies       → today's daily_challenge_times + daily_challenge_attempts rows for the
//                              player, the same tables 37's restore() reads, but READ-ONLY: no forfeit
//                              is written here (an attempt over an hour old reads 'started'; the
//                              planet card's restore() settles it, as /Game does).
//
// Statuses: 'open' (not played today) · 'started' (begun, not finished) · 'done' (finished or
// forfeited: nothing more today) · 'unknown' (could not ask).
// A 'done' Daily stays done for its Eastern day, so it is cached per player + day and never asked
// again; everything else is asked again on each refresh (the page refreshes on entry and after a
// game closes).

import { supabase } from '@/transport/supabaseClient';
import { apiClient } from '@/transport';
import { BOARD_GAMES } from './dailyRuns';

export const DAILY_KEYS_37 = Object.freeze(['daily_easy', 'daily', 'daily_expert']);
/** Every Daily, by the `daily` key the world objects carry. */
export const DAILY_KEYS = Object.freeze([...DAILY_KEYS_37, ...BOARD_GAMES]);

/** @typedef {'open' | 'started' | 'done' | 'unknown'} DailyState */
/** @typedef {{ status: DailyState, score?: any, ms?: number | null, forfeited?: boolean }} DailyInfo */

/** @type {Map<string, Map<string, DailyInfo>>} player:day → the Dailies known to be done */
const doneCache = new Map();

/** @returns {Promise<Record<string, DailyInfo> | null>} null = could not ask */
async function sectorStatus(rpc) {
  try {
    const { data, error } = await rpc('sector73_daily_status');
    if (error || !Array.isArray(data)) return null;
    /** @type {Record<string, DailyInfo>} */
    const out = Object.fromEntries(BOARD_GAMES.map((g) => [g, { status: /** @type {DailyState} */ ('open') }]));
    for (const row of data) {
      if (!BOARD_GAMES.includes(row?.game)) continue;
      out[row.game] = row.finished ? { status: 'done', score: row.score ?? null, ms: row.ms ?? null } : { status: 'started' };
    }
    return out;
  } catch {
    return null;
  }
}

/** @returns {Promise<Record<string, DailyInfo> | null>} */
async function status37(userId, date, entities) {
  try {
    const [times, attempts] = await Promise.all([
      entities.DailyChallengeTime.filter({ date, user_id: userId }),
      entities.DailyChallengeAttempt.filter({ date, user_id: userId }),
    ]);
    /** @type {Record<string, DailyInfo>} */
    const out = {};
    for (const mode of DAILY_KEYS_37) {
      const time = (times || []).find((t) => (t.mode ?? 'daily') === mode);
      const attempt = (attempts || []).find((a) => (a.mode ?? 'daily') === mode);
      if (time) out[mode] = { status: 'done', ms: time.solve_time_seconds != null ? Math.round(Number(time.solve_time_seconds) * 1000) : null };
      else if (attempt?.forfeited === true) out[mode] = { status: 'done', forfeited: true };
      else if (attempt) out[mode] = { status: 'started' };
      else out[mode] = { status: 'open' };
    }
    return out;
  } catch {
    return null;
  }
}

/**
 * Today's seven Dailies for this player.
 * @param {{ userId: string | null | undefined, date: string,
 *   rpc?: (fn: string) => PromiseLike<{ data: any, error: any }>, entities?: any }} args
 * @returns {Promise<Record<string, DailyInfo>>}
 */
export async function fetchTodaysDailies({ userId, date, rpc = (fn) => supabase.rpc(fn), entities = apiClient.entities }) {
  /** @type {Record<string, DailyInfo>} */
  const all = Object.fromEntries(DAILY_KEYS.map((k) => [k, { status: /** @type {DailyState} */ ('unknown') }]));
  if (!userId) return all;
  const key = `${userId}:${date}`;
  const known = doneCache.get(key) ?? new Map();
  const need = DAILY_KEYS.filter((k) => !known.has(k));
  const ask73 = need.some((k) => BOARD_GAMES.includes(k));
  const ask37 = need.some((k) => DAILY_KEYS_37.includes(k));
  const [s73, s37] = await Promise.all([ask73 ? sectorStatus(rpc) : null, ask37 ? status37(userId, date, entities) : null]);
  for (const k of DAILY_KEYS) {
    const info = known.get(k) ?? (BOARD_GAMES.includes(k) ? s73?.[k] : s37?.[k]);
    if (!info) continue;
    all[k] = info;
    if (info.status === 'done') known.set(k, info);
  }
  if (known.size) doneCache.set(key, known);
  return all;
}

/**
 * The Daily objects the map should mark done (their ids), from the world objects' `daily` keys.
 * @param {Array<{ id: string, daily?: string }>} objects  @param {Record<string, DailyInfo> | null} todays
 */
export function doneObjectIds(objects, todays) {
  return new Set(objects.filter((o) => o.daily && todays?.[o.daily]?.status === 'done').map((o) => o.id));
}

/**
 * "2/7": how many of today's Dailies are done (unknown counts as not done).
 * @param {Record<string, DailyInfo> | null} todays
 */
export function doneCount(todays) {
  const done = DAILY_KEYS.filter((k) => todays?.[k]?.status === 'done').length;
  return { done, total: DAILY_KEYS.length };
}

/** Tests only. */
export function resetDailyStatusCache() { doneCache.clear(); }
