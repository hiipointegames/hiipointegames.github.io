import React, { useEffect, useState } from 'react';
import { GOLD, MINI_PRACTICE, MINI_PLACE } from './dailyMarks';
import { PILOT_MARK } from './minimapMarks';

// What the minimap's colours mean (world lane, 2026-10-22). Shown beside the minimap the first
// time a pilot flies on this phone, for LEGEND_MS or until tapped; never again after that.

export const LEGEND_MS = 12_000;
export const legendSeenKey = (userId) => `sector73.minimapLegendSeen.${userId || 'guest'}`;

const readSeen = (key) => { try { return globalThis.localStorage?.getItem(key) === '1'; } catch { return false; } };
const writeSeen = (key) => { try { globalThis.localStorage?.setItem(key, '1'); } catch { /* private window */ } };

const ROWS = [
  { mark: '●', color: GOLD, text: "Today's Daily" },
  { mark: '○', color: GOLD, text: 'Daily done' },
  { mark: '●', color: MINI_PRACTICE, text: 'Practice' },
  { mark: '●', color: MINI_PLACE, text: 'Places' },
  { mark: '▲', color: PILOT_MARK.fill, text: 'Other pilots' },
];

/** @param {{ userId?: string | null, ms?: number }} props */
export default function MinimapLegend({ userId = null, ms = LEGEND_MS }) {
  const key = legendSeenKey(userId);
  const [show, setShow] = useState(() => !readSeen(key));
  useEffect(() => {
    if (!show) return undefined;
    writeSeen(key); // seen once it has been shown, even if the app closes before the timer
    const t = setTimeout(() => setShow(false), ms);
    return () => clearTimeout(t);
  }, [show, key, ms]);
  if (!show) return null;
  return (
    <button type="button" data-testid="minimap-legend" onClick={() => setShow(false)} aria-label="Minimap colours (tap to hide)"
      className="absolute z-20 rounded-xl border border-white/15 bg-black/70 px-2.5 py-1.5 text-left text-[10px] leading-[1.45] text-slate-200"
      style={{ right: 134, bottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 34px)' }}>
      {ROWS.map((r) => (
        <span key={r.text} className="block whitespace-nowrap"><span style={{ color: r.color }} aria-hidden="true">{r.mark}</span> {r.text}</span>
      ))}
    </button>
  );
}
