// The pilot's ship and its look (David, 2026-10-14: ship colours, trails and shapes bought with ★).
// One drawing used by the world AND the hangar, so what you buy is exactly what you fly. A "look"
// comes from the Star Market catalogue's `data` (supabase sector73_catalog), so new items need no
// app release; anything missing falls back to the free defaults below.

/** @typedef {{ hull: string[], glow: string, trim: string, shape: string, trail: { colors: string[], sparkle: boolean },
 *   portal: string[], nebula: number[], title: string|null, frame: object|null,
 *   sprite?: string|null, legendary?: boolean, aura?: string|null }} Look */

/** @type {Readonly<Look>} */
export const DEFAULT_LOOK = Object.freeze({
  hull: ['#94a3b8', '#f1f5f9', '#64748b'], glow: '#a855f7', trim: '#c4b5fd',
  shape: 'scout', trail: { colors: ['#8b5cf6'], sparkle: false },
  portal: ['#f97316', '#fde047', '#a855f7', '#22d3ee'], nebula: [205, 285, 330, 170, 255],
  title: null, frame: null, sprite: null, legendary: false, aura: null,
});

/** Sets you have COMPLETE and EQUIPPED: every catalogue item of that set is in your loadout. */
export function completeSets(catalog, loadout = {}) {
  const sets = new Map();
  for (const c of catalog || []) if (c.set_id) sets.set(c.set_id, [...(sets.get(c.set_id) || []), c]);
  const equipped = new Set(Object.values(loadout).filter(Boolean));
  return [...sets.entries()].filter(([, items]) => items.every((c) => equipped.has(c.item_id))).map(([id, items]) => ({ id, items }));
}

const LOOK_KEY = 'sector73.look';
export const SKIN_BUCKET = 'sector73-skins';

/**
 * A skin's image URL. The catalogue stores just the file name ("ship-void.webp") so the same rows
 * work on staging and production; this points it at THIS build's Supabase project. Full URLs pass
 * through unchanged.
 */
export function spriteUrl(sprite, base = import.meta.env?.VITE_SUPABASE_URL) {
  if (!sprite) return null;
  if (/^https?:\/\//.test(sprite)) return sprite;
  if (!base) return null;
  return `${String(base).replace(/\/$/, '')}/storage/v1/object/public/${SKIN_BUCKET}/${encodeURIComponent(sprite)}`;
}

/**
 * Turn a loadout (item ids per slot) into a drawable look, using the catalogue rows.
 * @param {Array<{ item_id: string, kind: string, name: string, data: any, rarity?: string, set_id?: string|null }>} catalog
 * @param {Record<string, string|null>} loadout
 */
export function lookFrom(catalog, loadout = {}) {
  const byId = new Map((catalog || []).map((c) => [c.item_id, c]));
  const pick = (slot) => (loadout[slot] ? byId.get(loadout[slot]) : null);
  const color = pick('ship_color')?.data; const trail = pick('trail')?.data; const shapeItem = pick('ship_shape'); const shape = shapeItem?.data;
  const sets = completeSets(catalog, loadout);
  const auraFrame = sets.length ? sets[0].items.find((c) => c.kind === 'frame')?.data?.ring : null;
  return {
    sprite: spriteUrl(shape?.sprite), // a ship skin's art (Star Market); drawn instead of the vector hull
    legendary: shapeItem?.rarity === 'legendary', // legendary ships pulse and sparkle
    aura: sets.length ? (auraFrame && auraFrame !== '#000000' ? auraFrame : '#a855f7') : null, // a whole set equipped
    hull: color?.hull ?? DEFAULT_LOOK.hull, glow: color?.glow ?? DEFAULT_LOOK.glow, trim: color?.trim ?? DEFAULT_LOOK.trim,
    shape: shape?.shape ?? DEFAULT_LOOK.shape,
    trail: trail ? { colors: trail.colors ?? DEFAULT_LOOK.trail.colors, sparkle: Boolean(trail.sparkle) } : DEFAULT_LOOK.trail,
    portal: pick('portal_theme')?.data?.disk ?? DEFAULT_LOOK.portal,
    nebula: pick('world_theme')?.data?.nebula ?? DEFAULT_LOOK.nebula,
    title: pick('title')?.name ?? null,
    frame: pick('frame')?.data ?? null,
  };
}

/** The last look, saved on the phone so the home portal and the world draw it at once. */
export const readSavedLook = () => {
  try { return { ...DEFAULT_LOOK, ...JSON.parse(globalThis.localStorage?.getItem(LOOK_KEY) ?? '{}') }; } catch { return DEFAULT_LOOK; }
};
/** Same look, whatever order the keys were written in (deep, key-sorted compare). */
export function sameLook(a, b) {
  const norm = (v) => (Array.isArray(v) ? v.map(norm) : v && typeof v === 'object'
    ? Object.fromEntries(Object.keys(v).sort().map((k) => [k, norm(v[k])])) : v);
  return JSON.stringify(norm({ ...DEFAULT_LOOK, ...a })) === JSON.stringify(norm({ ...DEFAULT_LOOK, ...b }));
}

const LOOK_OWNER_KEY = 'sector73.look.owner';
/**
 * The saved look is per phone, not per account. Call this with the signed-in user's id before
 * reading it: when a different account signs in on the same phone, the last account's look is
 * dropped (that pilot flies the free default until their own loadout loads). Returns true if it
 * cleared anything.
 */
export function claimSavedLook(uid) {
  if (!uid) return false;
  try {
    const ls = globalThis.localStorage;
    if (!ls || ls.getItem(LOOK_OWNER_KEY) === uid) return false;
    const had = ls.getItem(LOOK_KEY) != null;
    ls.removeItem(LOOK_KEY);
    ls.setItem(LOOK_OWNER_KEY, uid);
    return had;
  } catch { return false; } // storage blocked: nothing is cached either
}
export const saveLook = (look) => { try { globalThis.localStorage?.setItem(LOOK_KEY, JSON.stringify(look)); } catch { /* blocked */ } };

const HULLS = {
  // Each: a path in ship space (nose up, ~±14 wide, -22..15 long) and where the cockpit sits.
  scout: (g) => { g.moveTo(0, -22); g.lineTo(13, 12); g.lineTo(5, 9); g.lineTo(0, 15); g.lineTo(-5, 9); g.lineTo(-13, 12); g.closePath(); },
  arrow: (g) => { g.moveTo(0, -26); g.lineTo(6, -4); g.lineTo(16, 14); g.lineTo(4, 10); g.lineTo(0, 13); g.lineTo(-4, 10); g.lineTo(-16, 14); g.lineTo(-6, -4); g.closePath(); },
  saucer: (g) => { g.ellipse(0, 0, 17, 11, 0, 0, Math.PI * 2); },
  stingray: (g) => { g.moveTo(0, -18); g.quadraticCurveTo(19, -6, 17, 10); g.lineTo(6, 6); g.lineTo(0, 18); g.lineTo(-6, 6); g.lineTo(-17, 10); g.quadraticCurveTo(-19, -6, 0, -18); g.closePath(); },
};

/**
 * Draw the ship at the current origin (the caller translates to the ship's screen position).
 * @param {CanvasRenderingContext2D} g
 * @param {{ angle: number, thrust: number }} ship
 * @param {number} scale  screen px per ship unit
 * @param {number} time   seconds
 * @param {Look} [look]
 */
/**
 * How big ships are drawn for a camera zoom (David, 2026-10-14: a bought ship "is hard to see, it
 * should be larger and more defined … not overwhelmingly large"). ~1.55× the old size: on the S21
 * a ship went from ~29 to ~45 css px; the world was spread out to match (worldObjects SPREAD).
 */
export const SHIP_SCALE = 1.7;
export const shipScale = (zoom) => Math.max(0.6, zoom) * SHIP_SCALE;

/** A soft dark halo under a ship, so it reads against bright planets and nebulae. */
function backing(g, radius) {
  const halo = g.createRadialGradient(0, 0, radius * 0.2, 0, 0, radius);
  halo.addColorStop(0, 'rgba(2, 1, 10, 0.55)');
  halo.addColorStop(1, 'rgba(2, 1, 10, 0)');
  g.fillStyle = halo;
  g.beginPath(); g.arc(0, 0, radius, 0, Math.PI * 2); g.fill();
}

const sprites = new Map();
/** Ship-skin art, loaded once per URL; null until it has loaded (the vector ship stands in). */
function spriteFor(url) {
  if (!url || typeof Image === 'undefined') return null;
  let img = sprites.get(url);
  if (!img) { img = new Image(); img.crossOrigin = 'anonymous'; img.src = url; sprites.set(url, img); }
  return img.complete && img.naturalWidth ? img : null;
}

/**
 * @param {{ glow?: boolean }} [opts]  glow:false skips the shadow blur (the costly canvas op on
 *   Android Chrome) for small, frequently drawn ships (the duel strips on a slow phone).
 */
export function drawShip(g, ship, scale, time, look = DEFAULT_LOOK, opts = {}) {
  const { glow = true } = opts;
  g.save();
  g.rotate(ship.angle + Math.PI / 2);
  g.scale(scale, scale);
  // A whole set equipped: a slow aura ring. Legendary: a pulsing glow.
  if (look.aura) {
    g.globalAlpha = 0.35 + 0.2 * Math.sin(time * 2);
    g.strokeStyle = look.aura; g.lineWidth = 2.2;
    g.beginPath(); g.arc(0, 0, 27 + Math.sin(time * 2) * 1.5, 0, Math.PI * 2); g.stroke();
    g.globalAlpha = 1;
  }
  const pulse = look.legendary ? 10 + 8 * (0.5 + 0.5 * Math.sin(time * 3)) : 0;
  // Engine flame, in the trail's first colour.
  const flame = 0.25 + ship.thrust * 0.9 + Math.sin(time * 40) * 0.08;
  const tail = look.shape === 'saucer' ? 10 : 14;
  const grad = g.createLinearGradient(0, tail, 0, tail + 34 * flame);
  grad.addColorStop(0, 'rgba(220, 245, 255, 0.95)');
  grad.addColorStop(0.4, look.trail.colors[0]);
  grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
  g.fillStyle = grad;
  g.beginPath(); g.moveTo(-6, tail - 1); g.lineTo(0, tail + 34 * flame); g.lineTo(6, tail - 1); g.closePath(); g.fill();
  const art = spriteFor(look.sprite);
  if (art) {
    backing(g, 34);
    if (glow) { g.shadowColor = look.glow; g.shadowBlur = 10 + pulse; }
    g.drawImage(art, -24, -24, 48, 48);
    g.shadowBlur = 0;
    if (look.legendary) sparkles(g, time, look);
    g.restore();
    return;
  }
  // Hull.
  backing(g, 28);
  if (glow) { g.shadowColor = look.glow; g.shadowBlur = 14 + pulse; }
  g.beginPath(); (HULLS[look.shape] || HULLS.scout)(g);
  const hull = g.createLinearGradient(-15, 0, 15, 0);
  hull.addColorStop(0, look.hull[0]); hull.addColorStop(0.5, look.hull[1]); hull.addColorStop(1, look.hull[2]);
  g.fillStyle = hull; g.fill();
  g.shadowBlur = 0;
  g.strokeStyle = look.trim; g.lineWidth = 1.2; g.stroke();
  if (look.shape === 'saucer') {
    // A dome and a ring of running lights.
    g.beginPath(); g.ellipse(0, -2, 7, 5, 0, 0, Math.PI * 2); g.fillStyle = '#22d3ee'; g.fill();
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2 + time * 2;
      g.beginPath(); g.arc(Math.cos(a) * 14, Math.sin(a) * 8, 1.2, 0, Math.PI * 2);
      g.fillStyle = i % 2 ? look.trim : look.glow; g.fill();
    }
  } else {
    g.beginPath(); g.ellipse(0, -6, 2.6, 6, 0, 0, Math.PI * 2); g.fillStyle = '#22d3ee'; g.fill();
    g.fillStyle = look.glow; g.font = 'bold 6px system-ui, sans-serif'; g.textAlign = 'center';
    g.fillText('37', -7, 9); g.fillText('37', 7, 9);
  }
  if (look.legendary) sparkles(g, time, look);
  g.restore();
}

/** Legendary sparkle: three glints orbiting the hull. */
function sparkles(g, time, look) {
  for (let i = 0; i < 3; i++) {
    const a = time * 1.7 + (i * Math.PI * 2) / 3;
    const x = Math.cos(a) * 20; const y = Math.sin(a) * 20;
    const tw = 0.5 + 0.5 * Math.sin(time * 6 + i);
    g.fillStyle = look.trim; g.globalAlpha = tw;
    g.beginPath(); g.moveTo(x, y - 3); g.lineTo(x + 1, y); g.lineTo(x, y + 3); g.lineTo(x - 1, y); g.closePath(); g.fill();
  }
  g.globalAlpha = 1;
}

/** Colour of the engine trail at position i of n (cycles through the trail's colours). */
export const trailColor = (look, i, n) => {
  const cs = look.trail.colors;
  return cs[Math.floor((i / Math.max(1, n)) * cs.length) % cs.length];
};
