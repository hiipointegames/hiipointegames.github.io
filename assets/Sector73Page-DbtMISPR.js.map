import React from 'react';

// The docking card's buttons for a Sector 73 game's DAILY object (world lane, 2026-10-22): the same
// shape as 37's planets (ThirtySevenPlanetActions), so every Daily reads the same way.
//
//   open / unknown → ▶ PLAY TODAY'S DAILY   (short ad first, then the game's own briefing; when
//                                            unknown, the game's START asks the server, as before)
//   started        → ▶ CONTINUE TODAY'S DAILY  (the game resumes it, or says it was used elsewhere)
//   done           → DONE ✓ (a status, not a button) + the board button the card already has
//   Practice       → only when the game has its own practice moon (it reads params.entry); until
//                    then the game itself offers practice after its Daily.

/** @typedef {'open' | 'started' | 'done' | 'unknown'} DailyState */

const GOLD = '#fcd34d';
const stop = (e) => { e.stopPropagation(); };

/**
 * @param {{ state: DailyState, onDaily: () => void, onPractice?: () => void }} props
 */
export default function SectorDailyActions({ state, onDaily, onPractice = undefined }) {
  const done = state === 'done';
  const label = state === 'started' ? "Continue today's Daily ▶" : "▶ Play today's Daily";
  const note = done
    ? "You've played today's Daily. A new one comes at midnight Eastern."
    : state === 'started'
      ? 'You started it today. Finish it if you still can.'
      : 'One try a day · short ad first.';
  return (
    <div data-testid="sector-daily-actions" data-state={state} className="mt-3 space-y-2">
      {done ? (
        <div data-testid="sector-daily" data-state={state} role="status"
          className="w-full rounded-xl border py-3 text-center font-black tracking-widest"
          style={{ borderColor: GOLD, color: GOLD, background: 'rgba(255,255,255,0.04)' }}>
          DONE ✓
        </div>
      ) : (
        <button type="button" data-testid="sector-daily" data-state={state}
          onPointerDown={(e) => { stop(e); onDaily(); }}
          className="w-full rounded-xl py-3 font-black tracking-widest text-[#1a1200] active:scale-95 transition-transform"
          style={{ background: GOLD, boxShadow: `0 0 22px -6px ${GOLD}` }}>
          {label.toUpperCase()}
        </button>
      )}
      <p data-testid="sector-daily-note" className="text-center text-xs text-slate-300">{note}</p>
      {onPractice && (
        <button type="button" data-testid="sector-practice" onPointerDown={(e) => { stop(e); onPractice(); }}
          className="w-full rounded-xl border border-white/25 bg-white/5 py-2.5 text-sm font-bold tracking-wider text-white active:scale-95 transition-transform">
          ⚪ Practice instead
        </button>
      )}
    </div>
  );
}
