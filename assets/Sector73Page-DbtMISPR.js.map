// Sector 73 live duels — the phone's calls to the server (slice S6, 2026-10-20).
//
// Every lifecycle step is a Postgres RPC (supabase/migrations/20261019100000…130000_s73_duel_*.sql);
// an answer goes to the edge function s73-duel-submit (the referee). This module only names those
// calls and turns their replies into plain values, so the hooks above it can be tested with a fake
// client. The server decides everything; nothing here trusts the phone.
//
//   switch            app_settings.sector73_live_battles ('on' | 'off'; anything else = off)
//   invite            s73_duel_invite → the new duel id          (raises → { error })
//   accept/decline/cancel/ready/here/serve/tick/claimForfeit/leave → the RPC's jsonb reply
//   readDuel/readRound  the two players may read their rows (RLS); never dice
//   submit / ping     functions.invoke('s73-duel-submit', { region }) — the region pins the function
//                     next to the database (design-v2 D2.3)

import { supabase, withTimeout } from '@/transport';

export const LIVE_BATTLES_SETTING_KEY = 'sector73_live_battles';
export const SUBMIT_FUNCTION = 's73-duel-submit';

// The database region per project, for functions.invoke({ region }). Staging's is us-east-2
// (Management API, 2026-10-19). Prod's has not been read [assumed: unknown] — with no entry the call
// goes to the nearest edge region instead, which still works; it only costs fairness on one trip.
const DB_REGION_BY_REF = Object.freeze({ bbhowqlgtqzhrlebzwdx: 'us-east-2' });

/** The region to pin the referee to for this build's Supabase URL, or undefined. */
export function duelRegion(url = import.meta.env.VITE_SUPABASE_URL) {
  const ref = /^https:\/\/([a-z0-9]+)\.supabase\.co/.exec(String(url ?? ''))?.[1];
  return ref ? DB_REGION_BY_REF[ref] : undefined;
}

/** Are live battles switched on? Never throws; a missing, slow or failed read is OFF. */
export async function fetchLiveBattlesOn(/** @type {any} */ client = supabase) {
  try {
    const res = await withTimeout(
      client.from('app_settings').select('value').eq('key', LIVE_BATTLES_SETTING_KEY).maybeSingle(),
      { data: null, error: 'timeout' }, 4000,
    );
    return res?.data?.value === 'on';
  } catch {
    return false;
  }
}

/** The server's "s73_duel: <words>" → "<words>" (a sentence a player can read). */
export function duelErrorText(error) {
  const msg = String(error?.message ?? error ?? '');
  const m = /s73_duel:\s*([^\n]+)/.exec(msg);
  if (m) return m[1].trim().replace(/^./, (c) => c.toUpperCase());
  return 'Could not reach the duel server. Try again.';
}

const rpc = async (client, fn, args) => {
  const { data, error } = await client.rpc(fn, args);
  if (error) return { error: duelErrorText(error) };
  return { data };
};

/**
 * @param {any} [client] the supabase client (RPCs, reads, the session token)
 * @param {{ region?: string, baseUrl?: string, anonKey?: string, fetchImpl?: typeof fetch }} [opts]
 */
export function createDuelApi(client = supabase, {
  region = duelRegion(),
  baseUrl = import.meta.env.VITE_SUPABASE_URL,
  anonKey = import.meta.env.VITE_SUPABASE_ANON_KEY,
  fetchImpl = (...args) => globalThis.fetch(...args),
} = {}) {
  // A plain POST, NOT functions.invoke: supabase-js 2.93 adds an `x-supabase-client-platform` header
  // that the deployed s73-duel-submit's CORS list did not allow, so every browser/WebView call failed
  // its preflight ("Failed to send a request", found in the S6 two-browser run, 2026-10-20). Sending
  // only the headers the function lists works with every deployed version. Same region pinning as
  // invoke: the x-region header plus forceFunctionRegion.
  const invoke = async (body) => {
    let token = anonKey;
    try {
      const { data } = await client.auth.getSession();
      token = data?.session?.access_token ?? anonKey;
    } catch { /* signed out: the function answers 401 */ }
    const url = `${baseUrl}/functions/v1/${SUBMIT_FUNCTION}${region ? `?forceFunctionRegion=${encodeURIComponent(region)}` : ''}`;
    let res;
    try {
      res = await fetchImpl(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: anonKey,
          Authorization: `Bearer ${token}`,
          ...(region ? { 'x-region': region } : {}),
        },
        body: JSON.stringify(body),
      });
    } catch {
      return { error: 'The referee could not be reached. Try again.' };
    }
    let env = null;
    try { env = await res.json(); } catch { /* not JSON */ }
    if (env?.success === true) return { data: env.data };
    if (env?.error?.message) return { error: env.error.message, code: env.error.code };
    return { error: 'The referee could not be reached. Try again.' };
  };

  return {
    region,
    /** @returns {Promise<{ data?: string, error?: string }>} the new duel's id */
    invite: (opponentId, style, firstTo, source) => rpc(client, 's73_duel_invite', {
      p_opponent: opponentId, p_style: style, p_first_to: firstTo, p_source: source,
    }),
    accept: (duelId) => rpc(client, 's73_duel_accept', { p_duel: duelId }),
    decline: (duelId) => rpc(client, 's73_duel_decline', { p_duel: duelId }),
    cancel: (duelId) => rpc(client, 's73_duel_cancel', { p_duel: duelId }),
    ready: (duelId) => rpc(client, 's73_duel_ready', { p_duel: duelId }),
    here: (duelId) => rpc(client, 's73_duel_here', { p_duel: duelId }),
    serve: (duelId, n) => rpc(client, 's73_duel_serve_round', { p_duel: duelId, p_n: n }),
    tick: (duelId, n) => rpc(client, 's73_duel_round_tick', { p_duel: duelId, p_n: n }),
    claimForfeit: (duelId) => rpc(client, 's73_duel_claim_forfeit', { p_duel: duelId }),
    leave: (duelId) => rpc(client, 's73_duel_leave', { p_duel: duelId }),
    async readDuel(duelId) {
      const { data, error } = await client.from('s73_duels').select('*').eq('id', duelId).maybeSingle();
      if (error) return { error: duelErrorText(error) };
      return { data };
    },
    async readRound(duelId, n) {
      const { data, error } = await client.from('s73_duel_rounds')
        .select('n, style, starts_at, winner_id, winning_equation, winner_duration_ms, outcome, closed_at, next_starts_at')
        .eq('duel_id', duelId).eq('n', n).maybeSingle();
      if (error) return { error: duelErrorText(error) };
      return { data };
    },
    /** My pending incoming invites (the inbox re-read: Realtime may have missed one). */
    async readIncoming(uid) {
      const { data, error } = await client.from('s73_duels')
        .select('id, challenger_id, style, first_to, source, expires_at, status')
        .eq('opponent_id', uid).eq('status', 'invited').gt('expires_at', new Date().toISOString())
        .order('created_at', { ascending: false }).limit(5);
      if (error) return { error: duelErrorText(error) };
      return { data: data ?? [] };
    },
    /** The ★ this duel paid me (the ledger is readable by its owner). Null when it can't be read. */
    async myDuelStars(duelId, uid) {
      const { data, error } = await client.from('sector73_star_ledger').select('delta')
        .eq('user_id', uid).eq('reason', 's73_duel_win').like('ref', `s73_duel_win:${duelId}:%`);
      if (error) return null;
      return (data ?? []).reduce((sum, r) => sum + (Number(r.delta) || 0), 0);
    },
    /** One pilot's name (profiles is readable by any signed-in player). */
    async pilotName(uid) {
      const { data } = await client.from('profiles').select('username').eq('id', uid).maybeSingle();
      return data?.username || 'Pilot';
    },
    submit: (duelId, n, answer) => invoke({
      action: 'submit',
      duel_id: duelId,
      n,
      equation: answer.equation,
      used_dice_indices: answer.usedIndices,
      dice_colors: [...answer.colors],
      shuffled_dice: [...answer.dice],
    }),
    ping: () => invoke({ action: 'ping' }),
  };
}

/** @typedef {ReturnType<typeof createDuelApi>} DuelApi */
