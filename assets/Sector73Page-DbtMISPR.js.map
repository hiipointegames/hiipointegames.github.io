// Cockpit flight model — pure functions, no canvas, no React (unit-tested).
//
// The ship has position, velocity and a facing angle. Each frame `stepShip`
// applies ONE of three behaviours:
//   joystick  — the stick sets a desired velocity; the ship steers toward it
//   autopilot — "arrive" steering toward a target point, braking as it closes
//   coast     — drag only
// The stick always beats the autopilot (touching it cancels the autopilot in the
// caller). Steering is acceleration-limited so the ship drifts and banks rather
// than snapping — that is most of what makes it feel like flying.

import { WORLD_HALF, WORLD_OBJECTS } from './worldObjects';

export const MAX_SPEED = 900;      // world units / s
export const ACCEL = 1400;         // steering acceleration cap
export const DRAG = 0.9;           // fraction of velocity lost per second when coasting
export const ARRIVE_RADIUS = 380;  // start braking this far from the target
export const DOCK_MARGIN = 95;     // dock when within r + this
export const DOCK_SPEED = 170;     // ...and slower than this
export const ORBIT_GAP = 70;       // orbit this far outside the object's radius

export function createShip(x = 0, y = 170) {
  return { x, y, vx: 0, vy: 0, angle: -Math.PI / 2, thrust: 0 };
}

const len = (x, y) => Math.hypot(x, y);

// Where a pilot appears (W5, 2026-10-19): a seeded scatter on a ring around the Mirror, so ships
// in one room no longer stack on one spot. Seeded by the pilot's id: the same pilot always appears
// in the same place, two pilots almost always in different places. The ring (200–340 from the
// Mirror's centre, r 90) keeps every spawn off the Mirror; any spot too close to another object
// is turned on round the ring until it is clear.
export const SPAWN_RING = { min: 200, max: 340 }; // 340: the Mirror (r 90) stays fully in view (~450 half-width)
export const SPAWN_CLEARANCE = 60; // world units outside an object's radius

/** FNV-1a over the id's characters → an unsigned 32-bit seed. */
function seedOf(id) {
  let h = 2166136261;
  const str = String(id ?? '');
  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); }
  // murmur3's finaliser: plain FNV-1a barely changes its high bits between ids that differ only in
  // the last character ("user-01", "user-02"), which bunched those pilots together.
  h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b);
  h ^= h >>> 13; h = Math.imul(h, 0xc2b2ae35);
  h ^= h >>> 16;
  return h >>> 0;
}

/**
 * The spawn point for a pilot id (pure; deterministic).
 * @param {string | null | undefined} uid
 * @param {Array<{x:number,y:number,r:number}>} [objects]
 * @returns {{x:number,y:number}}
 */
export function spawnPoint(uid, objects = WORLD_OBJECTS) {
  const a = seedOf(uid);
  const b = seedOf(`${uid ?? ''}#r`);
  const radius = SPAWN_RING.min + (b / 4294967296) * (SPAWN_RING.max - SPAWN_RING.min);
  let angle = (a / 4294967296) * Math.PI * 2;
  for (let tries = 0; tries < 64; tries++) {
    const x = Math.round(Math.cos(angle) * radius);
    const y = Math.round(Math.sin(angle) * radius);
    if (objects.every((o) => len(o.x - x, o.y - y) >= o.r + SPAWN_CLEARANCE)) return { x, y };
    angle += 0.4; // ~23°: a step round the ring
  }
  return { x: 0, y: SPAWN_RING.max }; // unreachable with today's map
}

/**
 * Where the cockpit opens: the ship back where it left (a round trip to a planet screen), else at
 * the pilot's spawn — and the camera ON the ship, so the world doesn't sweep across on load.
 * @param {{x:number,y:number,angle:number} | null | undefined} resumeShip
 * @param {string | null | undefined} uid
 */
export function startPose(resumeShip, uid) {
  const at = resumeShip ?? spawnPoint(uid);
  const ship = { ...createShip(at.x, at.y), ...(resumeShip ? { angle: resumeShip.angle } : null) };
  return { ship, cam: { x: at.x, y: at.y, zoom: 1 } };
}

/** Clamp a vector's length. */
export function clampLength(x, y, max) {
  const l = len(x, y);
  if (l <= max || l === 0) return [x, y];
  return [(x / l) * max, (y / l) * max];
}

/**
 * Advance the ship by dt seconds. Returns a NEW ship (inputs are not mutated).
 * @param {{x:number,y:number,vx:number,vy:number,angle:number,thrust:number}} ship
 * @param {{ joystick?: {x:number,y:number} | null, target?: {x:number,y:number} | null }} input
 * @param {number} dt seconds (clamped to 0.05 so a backgrounded tab can't teleport the ship)
 */
export function stepShip(ship, input, dt) {
  const step = Math.min(Math.max(dt, 0), 0.05);
  let { vx, vy } = ship;
  let desired = null;

  const stick = input?.joystick;
  if (stick && len(stick.x, stick.y) > 0.08) {
    const [sx, sy] = clampLength(stick.x, stick.y, 1);
    desired = [sx * MAX_SPEED, sy * MAX_SPEED];
  } else if (input?.target) {
    const dx = input.target.x - ship.x;
    const dy = input.target.y - ship.y;
    const dist = len(dx, dy);
    if (dist > 1) {
      const speed = dist < ARRIVE_RADIUS ? MAX_SPEED * (dist / ARRIVE_RADIUS) : MAX_SPEED;
      desired = [(dx / dist) * speed, (dy / dist) * speed];
    } else {
      desired = [0, 0];
    }
  }

  let thrust = 0;
  if (desired) {
    const [ax, ay] = clampLength(desired[0] - vx, desired[1] - vy, ACCEL * step);
    vx += ax;
    vy += ay;
    thrust = Math.min(1, len(ax, ay) / (ACCEL * step || 1));
  } else {
    const keep = Math.pow(1 - DRAG, step);
    vx *= keep;
    vy *= keep;
  }
  [vx, vy] = clampLength(vx, vy, MAX_SPEED);

  let x = ship.x + vx * step;
  let y = ship.y + vy * step;
  // Soft walls: the edge of the map pushes you back rather than hard-stopping.
  if (Math.abs(x) > WORLD_HALF) { x = Math.sign(x) * WORLD_HALF; vx *= -0.4; }
  if (Math.abs(y) > WORLD_HALF) { y = Math.sign(y) * WORLD_HALF; vy *= -0.4; }

  const speed = len(vx, vy);
  const angle = speed > 20 ? turnToward(ship.angle, Math.atan2(vy, vx), 6 * step) : ship.angle;
  return { x, y, vx, vy, angle, thrust };
}

/** Rotate `from` toward `to` by at most `maxStep` radians, the short way round. */
export function turnToward(from, to, maxStep) {
  let diff = ((to - from + Math.PI) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2) - Math.PI;
  if (Math.abs(diff) <= maxStep) return to;
  return from + Math.sign(diff) * maxStep;
}

/** Ship speed in world units / s. */
export const shipSpeed = (ship) => len(ship.vx, ship.vy);

/**
 * Has the ship arrived at its autopilot object? (Within r + DOCK_MARGIN and slow.)
 * @returns {boolean}
 */
export function hasArrived(ship, object) {
  if (!object) return false;
  return len(object.x - ship.x, object.y - ship.y) < object.r + DOCK_MARGIN && shipSpeed(ship) < DOCK_SPEED;
}

/**
 * Where the autopilot aims for an object: the point on its ORBIT ring nearest the ship.
 * Aiming at the centre made the ship brake inside the planet and dock 66 units from its
 * middle (sweep review 2026-10-05).
 */
export function approachPoint(ship, object) {
  const dx = ship.x - object.x;
  const dy = ship.y - object.y;
  const d = len(dx, dy) || 1;
  const radius = object.r + ORBIT_GAP;
  return { x: object.x + (dx / d) * radius, y: object.y + (dy / d) * radius };
}

export const UNDOCK_SPEED = 260;

/**
 * The docking lock (sweep SW14d): a tractor ring contracts onto the ship over 300 ms, then
 * fades over 150 ms. Returns the ring's radius (world units) and opacity, or null when done.
 */
export const DOCK_RING_MS = 300;
export const DOCK_RING_FADE_MS = 150;
export function dockRing(elapsedSeconds, { from = 90, to = 26 } = {}) {
  const ms = elapsedSeconds * 1000;
  if (ms < 0 || ms > DOCK_RING_MS + DOCK_RING_FADE_MS) return null;
  if (ms <= DOCK_RING_MS) {
    const k = ms / DOCK_RING_MS;
    const ease = 1 - (1 - k) ** 3;
    return { radius: from + (to - from) * ease, alpha: 0.35 + 0.6 * ease };
  }
  return { radius: to, alpha: 0.95 * (1 - (ms - DOCK_RING_MS) / DOCK_RING_FADE_MS) };
}

/** Leaving orbit: a push straight away from the object, so the ship visibly departs. */
export function undockVelocity(ship, object) {
  const dx = ship.x - object.x;
  const dy = ship.y - object.y;
  const d = len(dx, dy) || 1;
  return { vx: (dx / d) * UNDOCK_SPEED, vy: (dy / d) * UNDOCK_SPEED };
}

/** Position on the orbit circle around `object` at angle `theta`; ship faces along the orbit. */
export function orbitPosition(object, theta) {
  const radius = object.r + ORBIT_GAP;
  return {
    x: object.x + Math.cos(theta) * radius,
    y: object.y + Math.sin(theta) * radius,
    vx: 0,
    vy: 0,
    angle: theta + Math.PI / 2,
    thrust: 0.15,
  };
}

/** Camera zoom for a viewport: ~900 world units across the short side. */
export const cameraZoom = (width, height) => Math.max(0.25, Math.min(width, height) / 900);

// Two-finger zoom (David, 2026-10-14): a multiplier on the viewport's zoom, kept in a range where
// the whole home system fits at the far end and a planet's surface fills the screen at the near.
export const ZOOM_MIN = 0.45;
export const ZOOM_MAX = 3.5;
export const clampUserZoom = (z) => Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, z));
/** Pinch: the zoom grows with the distance between the two fingers. */
export const pinchZoom = (startZoom, startDist, dist) => clampUserZoom(startZoom * (dist / Math.max(1, startDist)));
/** Mouse wheel / trackpad (the web version): scroll up to zoom in. */
export const wheelZoom = (zoom, deltaY) => clampUserZoom(zoom * Math.exp(-deltaY * 0.0015));

export function worldToScreen(p, cam, width, height) {
  return { x: (p.x - cam.x) * cam.zoom + width / 2, y: (p.y - cam.y) * cam.zoom + height / 2 };
}

export function screenToWorld(p, cam, width, height) {
  return { x: (p.x - width / 2) / cam.zoom + cam.x, y: (p.y - height / 2) / cam.zoom + cam.y };
}

/**
 * Which object (if any) did a tap at world point `p` hit? Forgiving: small
 * objects get a fixed touch margin so a beacon is as tappable as a gas giant.
 * The nearest qualifying object wins.
 */
export function hitTest(objects, p) {
  let best = null;
  let bestDist = Infinity;
  for (const o of objects) {
    const d = len(o.x - p.x, o.y - p.y);
    if (d < o.r * 1.15 + 45 && d < bestDist) {
      best = o;
      bestDist = d;
    }
  }
  return best;
}

/** Smoothly follow the ship (critically damped-ish lerp). */
export function followCamera(cam, ship, dt) {
  const k = 1 - Math.pow(0.0015, Math.min(dt, 0.05));
  // Look a little ahead of the ship in its direction of travel.
  const lead = 0.35;
  return {
    ...cam,
    x: cam.x + (ship.x + ship.vx * lead - cam.x) * k,
    y: cam.y + (ship.y + ship.vy * lead - cam.y) * k,
  };
}
