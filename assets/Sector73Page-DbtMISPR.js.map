// Text sharing for Sector 73 (unlock card, First Contact grid, Hyperjump run card).
//
// Order: native Share plugin (when compiled into this build) → Web Share API →
// clipboard. Mirrors the parity rule in CLAUDE.md: only call a native plugin when
// `Capacitor.isPluginAvailable` says it exists, so an OTA bundle on an older
// store build falls back instead of throwing.

import { Capacitor } from '@capacitor/core';
import { Share } from '@capacitor/share';

export const SECTOR_URL = 'https://37themathpuzzle.app';

/**
 * @param {string} text
 * @param {object} [deps] injected for tests
 * @returns {Promise<'native'|'web'|'copied'|'cancelled'|'failed'>}
 */
export async function shareText(text, deps = {}) {
  const cap = deps.Capacitor || Capacitor;
  const share = deps.Share || Share;
  const nav = deps.navigator || globalThis.navigator;
  const isCancel = (err) => /cancel|abort/i.test(String(err?.message || err?.name || err));

  if (cap?.isNativePlatform?.() && cap?.isPluginAvailable?.('Share')) {
    try {
      await share.share({ text, dialogTitle: 'Share from Sector 73' });
      return 'native';
    } catch (err) {
      if (isCancel(err)) return 'cancelled';
    }
  }
  if (nav?.share) {
    try {
      await nav.share({ text });
      return 'web';
    } catch (err) {
      if (isCancel(err)) return 'cancelled';
    }
  }
  try {
    await nav?.clipboard?.writeText(text);
    return 'copied';
  } catch {
    return 'failed';
  }
}

/** Unlock share — a cryptic hint, never the 73 trick itself. */
export const unlockShareText = () =>
  `🌀 I found Sector 73.\nEvery road leads to 37… except one.\n${SECTOR_URL}`;
