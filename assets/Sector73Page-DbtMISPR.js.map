// What "Open" (or the docking card's Launch) does to a place, as a plain decision the page carries out.
// Opening always cancels any autopilot first: otherwise, after you close a game you opened mid-flight,
// the ship would carry on toward the old target (WM slice 2 review, 2026-10-19).

/**
 * @param {{ ship: { x: number, y: number, angle: number }, dockedId: string | null, autopilot: object }} s  the live sim (mutated: autopilot cleared)
 * @param {{ launch: { type: 'return' } | { type: 'route', to: string, state?: object } | { type: 'sector', mode: string, params?: object } }} obj
 * @returns {{ kind: 'home' } | { kind: 'route', to: string, state?: object, resume: { ship: { x: number, y: number, angle: number }, dockedId: string | null } } | { kind: 'mode', mode: string, params: object | null }}
 */
export function launchPlan(s, obj) {
  s.autopilot = { targetId: null, point: null };
  const { launch } = obj;
  if (launch.type === 'return') return { kind: 'home' };
  if (launch.type === 'route') {
    return { kind: 'route', to: launch.to, state: launch.state, resume: { ship: { x: s.ship.x, y: s.ship.y, angle: s.ship.angle }, dockedId: s.dockedId } };
  }
  // A sector place may carry what its mode needs to open with (e.g. which Daily); none → null.
  return { kind: 'mode', mode: launch.mode, params: launch.params ?? null };
}
