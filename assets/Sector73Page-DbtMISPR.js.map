import React from 'react';
import { captureError } from '@/observability';

// Crash containment for one Sector 73 mode overlay (live battles S4 review, 2026-10-19).
//
// Without it, a throw inside a mode reached the app-wide AppErrorBoundary and wiped the
// whole app ("Something went wrong — Reload"). That happened once during the S4 browser run
// and could not be reproduced, and the stack was lost. Now a mode crash shows this card,
// which closes just that mode, and the world stays up. The error goes to Sentry (when
// reporting is on), and dev/staging builds also print it with its component stack to the
// console, so the next browser run has it on record.
//
// Keyed by the mode name in Sector73Page, so opening another mode starts fresh.

const IS_DEV_BUILD = import.meta.env.DEV || import.meta.env.MODE === 'staging';

/** @extends {React.Component<{ mode: string, onClose: () => void, children?: React.ReactNode, devLog?: boolean }, { failed: boolean }>} */
export default class ModeErrorBoundary extends React.Component {
  /** @param {{ mode: string, onClose: () => void, children?: React.ReactNode, devLog?: boolean }} props */
  constructor(props) {
    super(props);
    this.state = { failed: false };
  }

  static getDerivedStateFromError() {
    return { failed: true };
  }

  componentDidCatch(error, info) {
    captureError(error, { where: 'sector73.mode', mode: this.props.mode, componentStack: info?.componentStack ?? null });
    if (this.props.devLog ?? IS_DEV_BUILD) {
      console.error(`Sector 73 mode "${this.props.mode}" crashed:`, error, info?.componentStack);
    }
  }

  render() {
    if (!this.state.failed) return this.props.children;
    return (
      <div data-testid="mode-crashed" className="grid h-full place-items-center bg-[#04030d] px-6">
        <div className="w-full max-w-sm rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white" style={{ boxShadow: '0 0 40px -14px #a855f7' }}>
          <div className="text-[10px] uppercase tracking-[0.3em] text-violet-300/80">Signal lost</div>
          <div className="mt-1 text-lg font-black">Something went wrong</div>
          <p className="mt-2 text-sm text-slate-300">This screen hit an error. Your ship is fine.</p>
          <button type="button" data-testid="mode-crashed-orbit" onClick={this.props.onClose}
            className="mt-4 w-full rounded-xl border border-cyan-300/60 bg-black/40 py-3 text-sm font-black tracking-widest text-cyan-100 active:scale-95">
            BACK TO ORBIT ↑
          </button>
        </div>
      </div>
    );
  }
}
