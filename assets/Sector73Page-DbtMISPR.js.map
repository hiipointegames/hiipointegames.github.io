// Sector 73 ★ rewards — what each one pays and how often a day (a pure table, no server client, so
// any screen can quote it). It MIRRORS the newest sector73_star_award in supabase/migrations; the
// server decides. starMarket/earnRules.drift.test.js fails if the two drift apart.

/** The rewards the server knows, with what each pays. */
export const REWARDS = Object.freeze({ fc_bounty: 1, sc_bounty: 1, re_landing: 1, re_one_turn: 1, hj_core: 5, hj_core_free: 2 });
/** How many times a day each reward pays (the migration's daily_cap). */
export const REWARD_CAPS = Object.freeze({ fc_bounty: 1, sc_bounty: 3, re_landing: 1, re_one_turn: 1, hj_core: 1, hj_core_free: 1 });

/**
 * ★ the SERVER pays on its own: the app never asks for these, so they are NOT in REWARDS (an
 * earnStars() call naming one is refused by sector73_star_award as an unknown reward).
 *   s73_duel_win — a live Sector 73 duel won (supabase/migrations/20261019120000_s73_duel_referee.sql,
 *   _s73_duel_pay_win): 2★, at most 5 paid wins a day and 2 a day against the same pilot; both
 *   pilots must be members; never against the computer. earnRules.drift.test.js pins these numbers.
 */
export const SERVER_REWARDS = Object.freeze({
  s73_duel_win: Object.freeze({ amount: 2, dailyCap: 5, perOpponentCap: 2 }),
});

/** "once a day" / "up to 3 a day". */
export const capText = (cap) => (cap === 1 ? 'once a day' : `up to ${cap} a day`);
