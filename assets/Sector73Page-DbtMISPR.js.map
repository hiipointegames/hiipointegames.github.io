import React, { useCallback, useRef, useState } from 'react';
import { Delete, RotateCcw } from 'lucide-react';
import { evaluateTokens, DISPLAY, correctPowerDice } from './sectorMath';
import { playSynth } from '../synth';
import { shareText } from './share';
import { NeonDieFace } from './dice/NeonDie';

// Shared space-skinned building blocks for the Sector 73 modes: the header
// (Return to 37 + back to orbit), dice, operator keypad, live equation readout,
// a token-draft hook and a share button. "Same builder, space skin" (David):
// the dice → operators → equation → submit layout of the main game, restyled.

export function ModeHeader({ title, subtitle = undefined, onExit, onReturnTo37, right = null }) {
  return (
    <div className="flex items-center justify-between gap-2 px-3" style={{ paddingTop: 'calc(var(--safe-top, 0px) + 10px)' }}>
      <button
        type="button"
        data-testid="return-to-37"
        onClick={onReturnTo37}
        className="shrink-0 whitespace-nowrap rounded-full border border-fuchsia-300/70 bg-black/60 px-3 py-1.5 text-xs font-black text-white active:scale-95"
      >
        ← Return to 37
      </button>
      <div className="min-w-0 flex-1 text-center">
        <div className="truncate text-[9px] uppercase tracking-[0.25em] text-violet-300/80">{subtitle || 'Sector 73'}</div>
        <div className="truncate text-base font-black text-white">{title}</div>
      </div>
      <div className="flex shrink-0 items-center gap-1.5">
        {right}
        <button
          type="button"
          aria-label="Back to orbit"
          data-testid="back-to-orbit"
          onClick={onExit}
          className="whitespace-nowrap rounded-full border border-cyan-300/60 bg-black/60 px-3 py-1.5 text-xs font-bold text-cyan-100 active:scale-95"
        >
          Orbit ↑
        </button>
      </div>
    </div>
  );
}

// `used` = can't be tapped. `dim` = already in the equation (defaults to `used`). They differ
// under Twin Star: a used die goes dark but stays tappable, wearing `badge` (🌟) while the
// reuse is unspent — otherwise every die stayed bright and you lost track (S21, 2026-10-10).
// tag: a readable pill under the die, for a preview like "→24" (badge is a corner emoji; a
// multi-character badge crowded the next die on the S21, 2026-10-12).
export function SpaceDie({ value, color = 'white', used = false, dim = used, badge = null, tag = null, glow = false, hidden = false, onClick, size = 44, label = undefined }) {
  return (
    <button
      type="button"
      aria-label={label || (hidden ? 'hidden die' : `die ${value}`)}
      disabled={used || !onClick}
      onPointerDown={(e) => { e.preventDefault(); if (!used && onClick) { playSynth('blip'); onClick(); } }}
      data-value={hidden ? undefined : value}
      data-glow={glow || undefined}
      className={`relative grid place-items-center rounded-xl transition-transform touch-manipulation ${dim ? 'scale-90' : 'active:scale-90'} ${glow ? 'ring-2 ring-cyan-300 ring-offset-1 ring-offset-transparent' : ''}`}
      style={{ width: size, height: size, WebkitTapHighlightColor: 'transparent' }}
    >
      <NeonDieFace value={value} color={color} hidden={hidden} dim={dim} size={size} />
      {badge && <span data-testid="die-badge" className="pointer-events-none absolute -right-1 -top-1 text-sm leading-none" style={{ textShadow: '0 0 6px #fde047' }}>{badge}</span>}
      {tag && <span data-testid="die-tag" className="pointer-events-none absolute -bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-amber-300 px-1 text-[10px] font-black leading-[14px] text-[#04030d]">{tag}</span>}
    </button>
  );
}

/**
 * Operator keys tinted with the power die they satisfy (David, 2026-10-10: make the power
 * rule easier to understand) — green + −, blue × ÷, red ^. Pass to Keypad as `tints`.
 */
export const POWER_KEY_TINTS = Object.freeze({ '+': 'green', '-': 'green', '*': 'blue', '/': 'blue', '^': 'red' });
const TINT_STYLE = {
  green: { borderColor: '#34d399', color: '#a7f3d0', background: 'rgba(6,78,59,0.45)' },
  blue: { borderColor: '#38bdf8', color: '#bae6fd', background: 'rgba(12,74,110,0.45)' },
  red: { borderColor: '#fb7185', color: '#fecdd3', background: 'rgba(136,19,55,0.45)' },
};

export function Keypad({ ops = ['+', '-', '*', '/', '^', '(', ')'], onOp, onDelete, onClear, disabled = false, tints = null, burned = null }) {
  return (
    <div className="grid grid-cols-5 gap-1.5">
      {ops.map((op) => (
        <button
          key={op}
          type="button"
          disabled={disabled || op === burned}
          data-tint={tints?.[op] || undefined}
          data-burned={op === burned || undefined}
          aria-label={op === burned ? `${DISPLAY[op]} (burned out)` : undefined}
          onPointerDown={(e) => { e.preventDefault(); if (!disabled && op !== burned) { playSynth('blip'); onOp(op); } }}
          className="h-11 rounded-xl border border-violet-400/40 bg-violet-950/60 text-xl font-black text-violet-100 active:scale-90 disabled:opacity-40"
          style={tints?.[op] ? TINT_STYLE[tints[op]] : undefined}
        >
          {op === burned ? <span className="text-base">🔥</span> : DISPLAY[op]}
        </button>
      ))}
      <button type="button" aria-label="Delete" disabled={disabled} onPointerDown={(e) => { e.preventDefault(); onDelete(); }}
        className="grid h-11 place-items-center rounded-xl border border-white/15 bg-white/5 text-slate-200 active:scale-90">
        <Delete className="h-5 w-5" />
      </button>
      <button type="button" aria-label="Clear" disabled={disabled} onPointerDown={(e) => { e.preventDefault(); onClear(); }}
        className="grid h-11 place-items-center rounded-xl border border-white/15 bg-white/5 text-slate-200 active:scale-90">
        <RotateCcw className="h-5 w-5" />
      </button>
    </div>
  );
}

/** The editing cursor in the equation — the main game's pulsing amber bar. */
const Caret = () => <span data-testid="readout-caret" aria-hidden="true" className="inline-block h-7 w-0.5 animate-pulse rounded bg-amber-400" />;

/**
 * Pure cursor edits on a draft { tokens, cursor } — the main game's model (equation-draft,
 * ADR-0003): every edit happens AT the cursor, not only at the end of the equation.
 */
export function editDraft(state, action) {
  const { tokens, cursor } = state;
  switch (action.type) {
    case 'insert': {
      const next = tokens.slice();
      next.splice(cursor, 0, action.token);
      return { tokens: next, cursor: cursor + 1 };
    }
    case 'delete': // the piece BEFORE the cursor, like a keyboard's backspace
      if (cursor === 0) return state;
      return { tokens: [...tokens.slice(0, cursor - 1), ...tokens.slice(cursor)], cursor: cursor - 1 };
    case 'cursor':
      return { tokens, cursor: Math.max(0, Math.min(action.cursor, tokens.length)) };
    case 'set': // replace everything; the cursor goes to the end
      return { tokens: action.tokens, cursor: action.tokens.length };
    default:
      return state;
  }
}

/** The equation as tapped, coloured by die, with the live value against the target. */
/**
 * The equation being built and its live value.
 * - `hiddenIndex`: a die whose value stays secret (Hyperjump's Dark Matter) — it shows as "?",
 *   and so does the total while it is in the equation.
 * - `accepted`: when given, the total turns green only if the move would really be accepted
 *   (power dice, curses…), not merely because it equals the target.
 */
export function EquationReadout({ tokens, values, colors = [], result, target, targetLabel = 'Target', hiddenIndex = null, accepted = undefined, cursor = undefined, onCursor = undefined, lines = 1, showGap = false, powerRings = false, flat = false, dieSize = 30 }) {
  const showCaret = onCursor != null && tokens.length > 0;
  // Green ring round each power die used correctly so far (David, 2026-10-11; green, not gold —
  // gold is the Tens Die's own colour), so players see
  // their 1 / 2 / 3 of 3 build up while they type.
  const rings = powerRings ? correctPowerDice(tokens, values, colors, { flat }) : null;
  // "11 to go" / "8 over" next to the total (David, 2026-10-10): how far from the target.
  const gapValue = showGap && result?.ok && target != null && !(hiddenIndex != null && tokens.some((t) => t.t === 'die' && t.i === hiddenIndex))
    ? target - result.value : null;
  const gapText = (d) => { const n = Math.abs(d); return Number.isInteger(n) ? String(n) : String(Number(n.toFixed(2))); };
  const gap = gapValue == null || Math.abs(gapValue) < 1e-6 ? null : gapValue > 0 ? `${gapText(gapValue)} to go` : `${gapText(gapValue)} over`;
  const usesHidden = hiddenIndex != null && tokens.some((t) => t.t === 'die' && t.i === hiddenIndex);
  const equalsTarget = result?.ok && target != null && Math.abs(result.value - target) < 1e-6;
  const reached = !usesHidden && (accepted === undefined ? equalsTarget : accepted);
  const shown = usesHidden ? '?' : result?.ok
    ? (Number.isInteger(result.value) ? result.value : Number(result.value.toFixed(3)))
    : tokens.length ? '?' : '—';
  return (
    <div className="rounded-2xl border border-violet-400/30 bg-black/40 px-3 py-2">
      {/* Tap anywhere in the equation to move the cursor there (like the main game, David S21
          2026-10-10): a tap on a piece's left half puts the cursor before it, its right half
          after it; a tap on the empty space puts it at the end. Dice, operators and ⌫ act at it. */}
      <div
        data-testid="readout-equation"
        onClick={onCursor ? () => onCursor(tokens.length) : undefined}
        // `lines` reserves room for that many rows of dice, so a long equation wrapping onto a
        // second row never pushes the keypad and JUMP down mid-tap (S21 2026-10-10).
        data-lines={lines}
        className={`flex flex-wrap items-center gap-x-1 gap-y-1 text-2xl font-black ${lines >= 2 ? 'min-h-[76px]' : 'min-h-[40px]'}`}
      >
        {tokens.length === 0 && <span className="text-sm font-semibold text-slate-500">Tap dice and operators…</span>}
        {tokens.map((t, k) => {
          const pick = onCursor ? (e) => {
            e.stopPropagation();
            const r = e.currentTarget.getBoundingClientRect();
            onCursor(e.clientX > r.left + r.width / 2 ? k + 1 : k);
          } : undefined;
          const piece = t.t === 'die'
            // Dice appear as dice (David, S21 2026-10-10), in their own colour; Dark Matter stays "?".
            ? <span key={k} onClick={pick} data-testid="readout-die" data-correct={rings?.has(t.i) || undefined}
              className={`inline-flex rounded-lg ${rings?.has(t.i) ? 'ring-2 ring-emerald-300 shadow-[0_0_10px_1px_#6ee7b7]' : ''}`}><NeonDieFace value={values[t.i]} color={colors[t.i] || 'white'} hidden={t.i === hiddenIndex} size={dieSize} /></span>
            : <span key={k} onClick={pick} data-testid="readout-op" className="px-0.5 text-violet-300">{DISPLAY[t.v]}</span>;
          return showCaret && cursor === k ? [<Caret key={`c${k}`} />, piece] : piece;
        })}
        {showCaret && cursor === tokens.length && <Caret />}
      </div>
      <div className="mt-1 flex items-center justify-between text-sm">
        <span className="text-slate-400">= <span data-testid="readout-total" data-reached={reached || undefined} className={reached ? 'text-emerald-300 font-black' : 'text-white font-bold'}>{shown}</span>
          {gap && <span data-testid="readout-gap" className="ml-1.5 text-xs font-semibold text-amber-200">{gap}</span>}
        </span>
        {target != null && <span className="text-violet-200">{targetLabel}: <span className="font-black text-white">{target}</span></span>}
      </div>
    </div>
  );
}

/**
 * Token-list draft. `reuse` = how many extra times ANY one die may be reused
 * (Twin Star). Returns the tokens plus evaluation against `values`.
 */
export function useTokenDraft(values, { reuse = 0, flat = false } = {}) {
  const [draft, setDraft] = useState({ tokens: [], cursor: 0 });
  const { tokens, cursor } = draft;
  const run = useCallback((action) => setDraft((s) => editDraft(s, action)), []);
  const counts = {};
  tokens.forEach((t) => { if (t.t === 'die') counts[t.i] = (counts[t.i] || 0) + 1; });
  const reusesSpent = Object.values(counts).reduce((s, n) => s + Math.max(0, n - 1), 0);

  const canUse = (i) => !counts[i] || reusesSpent < reuse;
  const addDie = useCallback((i) => run({ type: 'insert', token: { t: 'die', i } }), [run]);
  const addOp = useCallback((v) => run({ type: 'insert', token: { t: 'op', v } }), [run]);
  const del = useCallback(() => run({ type: 'delete' }), [run]);
  const clear = useCallback(() => run({ type: 'set', tokens: [] }), [run]);
  const setCursor = useCallback((c) => run({ type: 'cursor', cursor: c }), [run]);
  const setTokens = useCallback((ts) => run({ type: 'set', tokens: ts }), [run]);
  const result = evaluateTokens(tokens, values, { flat });
  return { tokens, cursor, setCursor, setTokens, addDie, addOp, del, clear, result, counts, canUse };
}

export function ShareButton({ text, label = 'Share' }) {
  const [state, setState] = useState(null);
  return (
    <button
      type="button"
      data-testid="sector-share"
      onClick={async () => setState(await shareText(text()))}
      className="rounded-xl border border-cyan-300/60 bg-cyan-500/10 px-4 py-2.5 text-sm font-bold text-cyan-100 active:scale-95"
    >
      {state === 'copied' ? 'Copied ✓' : state === 'native' || state === 'web' ? 'Shared ✓' : label}
    </button>
  );
}

/**
 * Swallows clicks for a moment after a screen appears. A button that acts on
 * pointer-DOWN (the map's Launch) swaps the screen while the finger is still on the
 * glass; the click that follows on lift then lands on whatever is now underneath
 * (a "ghost click"). Found on the S21 2026-10-05.
 */
export function ClickShield({ ms = 350, now = () => performance.now(), children, className = undefined, style = undefined }) {
  const mountedAt = useRef(now());
  const swallow = (e) => {
    if (now() - mountedAt.current < ms) { e.stopPropagation(); e.preventDefault(); }
  };
  return <div className={className} style={style} onClickCapture={swallow}>{children}</div>;
}

/**
 * The row for a mode's main action (FIRE BURN, JUMP…). It used to be pinned (sticky) to the
 * bottom of the screen, but on a tall screen that pinned bar sat ON TOP of the keypad
 * (S21, 2026-10-10). It is now in normal flow under the keypad; the screens are laid out to
 * fit, and MessageLine reserves its line so nothing jumps.
 */
export function ActionDock({ children }) {
  return (
    <div data-testid="action-dock" className="pt-1">
      {children}
    </div>
  );
}

/** A one-line message slot that always takes its space, so the layout never jumps under a finger. */
export function MessageLine({ children, className = 'text-orange-200' }) {
  return <p className={`min-h-[20px] text-center text-sm leading-5 ${className}`} aria-live="polite">{children || ' '}</p>;
}

// Screen-changing buttons act on CLICK (finger lifted), never pointer-down: acting on
// pointer-down replaced the Hyperjump jump screen with the artifact draft mid-tap, and
// the lift then picked an artifact the player never chose (S21, 2026-10-05).
export function PrimaryButton({ children, onClick, disabled = false, tone = 'violet', testId = undefined }) {
  const bg = { violet: '#8b5cf6', emerald: '#10b981', rose: '#f43f5e', cyan: '#22d3ee' }[tone];
  return (
    <button
      type="button"
      data-testid={testId}
      disabled={disabled}
      onClick={() => { if (!disabled) onClick(); }}
      className="w-full rounded-xl py-3.5 text-base font-black tracking-widest text-white active:scale-95 disabled:opacity-40 disabled:active:scale-100"
      style={{ background: disabled ? '#334155' : bg, boxShadow: disabled ? 'none' : `0 0 22px -6px ${bg}` }}
    >
      {children}
    </button>
  );
}
