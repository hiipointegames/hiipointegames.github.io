import React from 'react';
import { motion } from 'framer-motion';
import { ShareButton } from '../modes/ui';
import { unlockShareText } from '../modes/share';

// First-arrival card (skippable): what the map's colours mean, how to move, what ★ are for — then
// out of the way (W3, 2026-10-19). World lane 2026-10-22 (D4-B): shown once per phone; the ? in the
// top bar brings it back any time.

export const WELCOME_LINES = [
  "🟡 Gold planets are today's Dailies.",
  '⚪ Grey moons are practice.',
  '🚀 Tap FLY to go anywhere.',
  '★ Earn ★, spend them in the Star Market.',
];

export default function WelcomeCard({ onClose }) {
  return (
    <div className="absolute inset-0 z-30 grid place-items-center bg-black/50 px-6" onPointerDown={(e) => { e.stopPropagation(); onClose(); }}>
      <motion.div
        data-testid="welcome-card"
        onPointerDown={(e) => e.stopPropagation()}
        initial={{ scale: 0.9, opacity: 0 }}
        animate={{ scale: 1, opacity: 1 }}
        className="w-full max-w-sm rounded-3xl border border-violet-400/60 p-6 text-center"
        style={{ background: 'linear-gradient(180deg, rgba(30,12,60,0.95), rgba(8,5,22,0.95))', boxShadow: '0 0 40px -12px #a855f7' }}
      >
        <div className="text-[10px] uppercase tracking-[0.4em] text-violet-300">Transmission received</div>
        <h2 className="mt-2 text-3xl font-black text-white">Welcome, Pilot.</h2>
        <ul data-testid="welcome-lines" className="mt-4 space-y-2 text-left text-base text-slate-100">
          {WELCOME_LINES.map((line) => <li key={line}>{line}</li>)}
        </ul>
        <div className="mt-4 flex justify-center" onPointerDown={(e) => e.stopPropagation()}>
          <ShareButton text={unlockShareText} label="Share: I found Sector 73" />
        </div>
        <button
          type="button"
          data-testid="welcome-start"
          onPointerDown={(e) => { e.stopPropagation(); onClose(); }}
          className="mt-5 w-full rounded-xl bg-violet-500 py-3 font-black tracking-widest text-white active:scale-95"
          style={{ boxShadow: '0 0 24px -6px #a855f7' }}
        >
          ENGAGE ▶
        </button>
      </motion.div>
    </div>
  );
}
