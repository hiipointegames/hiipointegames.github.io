// useSectorRoom — the live half of Sector 73 multiplayer (the pure half is ./rooms.js).
//
// Joins `sector73-room-N` (a PRIVATE Realtime channel — the policies are in
// supabase/migrations/20261014200000_sector73_rooms.sql), announces this pilot with presence,
// sends flight orders, and keeps `sim.current.remotes` (uid → other ship) up to date for the canvas.
//
// • Server switch: app_settings 'sector73_multiplayer' must be 'on'; missing / failed read = solo.
// • Guests (anonymous accounts) WATCH: they see ships but do not appear, so nobody can tap a guest
//   or challenge one — a guest has no profile and cannot battle.
// • A pilot's name, country and ship look are read from the SERVER (profiles, sector73_loadout),
//   never taken from what another phone says about itself, so nobody can wear a skin they do not own.
// • Live pilots only: the app going to the background leaves the room; coming back rejoins.
// • Away (a live duel is on, S6 review m8): leave the room channel while `away`, rejoin the SAME room
//   after — a duellist gets no ship traffic during a timed round and shows as gone to the room.
// • A new look reaches everyone (S21 + iPhone test, 2026-10-14: "when Bryce bought a ship, I do not
//   see the changes"): equipping announces a bare 'look' event (no look data — nothing to fake), and
//   every phone re-reads that pilot from the server. A pilot who leaves and returns is re-read too.

import { useEffect, useRef, useState } from 'react';
import { supabase, withTimeout } from '@/transport';
import { reportedFallback } from '@/observability';
import { fetchCatalog } from '../modes/stars';
import { lookFrom } from '../world/shipArt';
import {
  MAX_ROOMS, roomTopic, pilotsIn, overflowed, encodeOrder, intentKey, shouldSend, applyOrder,
} from './rooms';

export const MULTIPLAYER_SETTING_KEY = 'sector73_multiplayer';
const SEND_TICK_MS = 250;

/** Is multiplayer switched on? Never throws; anything unexpected is off. */
export async function fetchMultiplayerOn(/** @type {any} */ client = supabase) {
  try {
    const res = await withTimeout(
      client.from('app_settings').select('value').eq('key', MULTIPLAYER_SETTING_KEY).maybeSingle(),
      { data: null, error: 'timeout' }, 4000, // a slow read counts as off
    );
    return res?.data?.value === 'on';
  } catch {
    return false;
  }
}

/**
 * Names, countries and looks for pilots, from the server.
 * @returns {Promise<Map<string, {uid:string, name:string, country:string|null, stats:any, look:any, loadout:any}>>}
 */
export async function fetchPilots(uids, client = supabase) {
  const out = new Map();
  if (!uids.length) return out;
  const [profiles, loadouts, catalog] = await Promise.all([
    client.from('profiles').select('id, username, country, stats').in('id', uids),
    client.from('sector73_loadout').select('*').in('user_id', uids),
    fetchCatalog().catch(reportedFallback('sector73.catalog', [])),
  ]);
  const lo = new Map((loadouts.data || []).map((r) => [r.user_id, r]));
  for (const p of profiles.data || []) {
    const loadout = lo.get(p.id) || {};
    out.set(p.id, { uid: p.id, name: p.username || 'Pilot', country: p.country || null, stats: p.stats || null, loadout, look: lookFrom(catalog, loadout) });
  }
  return out;
}

/**
 * @param {{ current: any }} sim the cockpit's sim ref
 * @param {{ user: any, away?: boolean }} opts the signed-in user (null = solo); away = leave the room for now
 * @returns {{ status: string, room: number|null, count: number, pilots: Map<string, any>, watching: boolean }}
 */
export function useSectorRoom(sim, { user, away = false }) {
  const [state, setState] = useState({ status: 'off', room: null, count: 0, pilots: new Map(), watching: false });
  const awayRef = useRef(away);
  awayRef.current = away;
  const controls = useRef(/** @type {null | { join: () => void, leave: () => void, on: boolean }} */ (null));
  const uid = user?.id || null;
  const watching = Boolean(user?.is_anonymous);

  useEffect(() => {
    if (!uid) return undefined;
    let alive = true;
    let channel = null;
    let room = 1;
    let count = 1;
    let present = new Set();
    const sent = { lastAt: null, lastKey: null };
    const known = new Map();
    const remotes = new Map();
    sim.current.remotes = remotes;
    const canSend = !watching;

    const publish = (patch) => { if (alive) setState((s) => ({ ...s, ...patch })); };

    const loading = new Set();
    /** Read pilots from the server — new ones, or (force) ones whose look just changed. */
    const learn = (uids, { force = false } = {}) => {
      const need = uids.filter((u) => !loading.has(u) && (force || !known.has(u)));
      if (!need.length) return;
      need.forEach((u) => { loading.add(u); if (!known.has(u)) known.set(u, null); });
      fetchPilots(need).then((got) => {
        if (!alive) return;
        for (const [u, meta] of got) known.set(u, meta);
        for (const [u, r] of remotes) r.meta = known.get(u) || r.meta;
        publish({ pilots: new Map([...known].filter(([, m]) => m)) });
      }).catch(() => { need.forEach((u) => { if (!known.get(u)) known.delete(u); }); })
        .finally(() => need.forEach((u) => loading.delete(u)));
    };

    const leave = () => {
      if (!channel) return;
      const ch = channel; channel = null;
      supabase.removeChannel(ch);
      remotes.clear();
      present = new Set();
    };

    const join = () => {
      if (!alive || document.hidden || awayRef.current || channel) return;
      publish({ status: 'joining', room, watching });
      const ch = supabase.channel(roomTopic(room), {
        config: { private: true, presence: { key: uid }, broadcast: { self: false } },
      });
      channel = ch;
      ch.on('presence', { event: 'sync' }, () => {
        if (channel !== ch) return;
        const st = ch.presenceState();
        if (canSend && overflowed(st, uid) && room < MAX_ROOMS) { leave(); room += 1; join(); return; }
        const others = pilotsIn(st).filter((p) => p.uid !== uid);
        const before = present;
        present = new Set(others.map((p) => p.uid));
        for (const k of [...remotes.keys()]) if (!present.has(k)) remotes.delete(k);
        for (const k of [...known.keys()]) if (!present.has(k)) known.delete(k); // re-read when they return
        if (others.some((p) => !before.has(p.uid))) sent.lastAt = null; // a newcomer needs my position now
        count = others.length + (canSend ? 1 : 0);
        learn(others.map((p) => p.uid));
        publish({ status: 'live', room, count });
      });
      ch.on('broadcast', { event: 'o' }, ({ payload }) => {
        if (channel !== ch || !payload || payload.u === uid || !present.has(payload.u)) return;
        applyOrder(remotes, payload, Date.now());
        const r = remotes.get(payload.u);
        if (r && !r.meta) r.meta = known.get(payload.u) || null;
      });
      ch.on('broadcast', { event: 'look' }, ({ payload }) => {
        if (channel !== ch || !payload?.u || payload.u === uid || !present.has(payload.u)) return;
        learn([payload.u], { force: true });
      });
      ch.subscribe(async (status) => {
        if (channel !== ch) return;
        if (status === 'SUBSCRIBED' && canSend) await ch.track({ uid, joined: Date.now() });
        if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') publish({ status: 'error' });
      });
    };

    const tick = setInterval(() => {
      if (!channel || !canSend || count < 2 || document.hidden) return; // alone: nobody to tell
      const order = encodeOrder(uid, sim.current);
      const now = Date.now();
      if (!shouldSend(sent, order, now, count)) return;
      sent.lastAt = now; sent.lastKey = intentKey(order);
      channel.send({ type: 'broadcast', event: 'o', payload: order });
    }, SEND_TICK_MS);

    // My look changed (the Star Market announces it): tell the room to re-read me.
    const onLook = () => { if (channel && canSend) channel.send({ type: 'broadcast', event: 'look', payload: { u: uid } }); };
    globalThis.addEventListener?.('sector73:look', onLook);

    // Only rejoin on return to the foreground when the server switch said on; otherwise a
    // switched-off app would join the room the first time it is backgrounded and reopened.
    let switchedOn = false;
    const onVis = () => {
      if (!switchedOn) return;
      if (document.hidden) { leave(); publish({ status: 'joining' }); } else if (!channel) join();
    };
    document.addEventListener('visibilitychange', onVis);

    controls.current = { join, leave: () => { leave(); publish({ status: 'away' }); }, on: false };
    fetchMultiplayerOn().then((on) => { switchedOn = on; if (on && alive) { if (controls.current) controls.current.on = true; join(); } });

    return () => {
      alive = false;
      clearInterval(tick);
      document.removeEventListener('visibilitychange', onVis);
      globalThis.removeEventListener?.('sector73:look', onLook);
      leave();
      controls.current = null;
      if (sim.current.remotes === remotes) sim.current.remotes = null;
    };
  }, [sim, uid, watching]);

  // Away and back: leave the channel, then rejoin the same room (only if multiplayer was on).
  useEffect(() => {
    const c = controls.current;
    if (!c || !c.on) return;
    if (away) c.leave(); else c.join();
  }, [away]);

  return state;
}
