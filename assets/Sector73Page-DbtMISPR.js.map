import { useCallback, useState } from 'react';

/**
 * Which dock is FRESH — the one the ship just settled into (W6, 2026-10-19). The docking card's
 * DOCKED stamp plays only for a fresh dock, never for a restored one:
 *   - coming back from a planet's screen (the page remounts docked) → starts null, no stamp;
 *   - closing a mode (the card remounts) → launching cleared it, no stamp;
 *   - re-picking the object you're already docked at → nothing changes, no replay.
 *
 * @returns {{ freshId: string | null, markFresh: (id: string) => void, clearFresh: () => void }}
 */
export function useFreshDock() {
  const [freshId, setFreshId] = useState(/** @type {string | null} */ (null));
  const markFresh = useCallback((id) => setFreshId(id), []);
  const clearFresh = useCallback(() => setFreshId(null), []);
  return { freshId, markFresh, clearFresh };
}
