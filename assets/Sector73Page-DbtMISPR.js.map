import React, { useEffect } from 'react';

// The FLY list — the one menu (David, 2026-10-14: "the fly feature is great, we want to highlight it";
// W4, 2026-10-19: the ☰ menu folded in here). Since 2026-10-22 (world lane) it is TODAY'S TO-DO LIST:
//
//   Today's Dailies · n/7 ✓ — one row per game's Daily object, with its status (Play / Continue / ✓),
//       FLY ▶ (autopilot to it; its card shows the status and the Play button, so the ad and the status
//       always come first) and, when the game has its practice moon, a grey Practice chip that goes
//       straight into practice (no ad, nothing to lose).
//   Places — everything else: FLY ▶ + Open (straight in). The Mirror has no Open: opening it just
//       sends you home, and "Return to 37" already does that. Practice moons are not listed on their
//       own: they are the Practice chip on their Daily's row.
//
// Pilots in your room are listed too, so you can fly to a friend. Also the plain-list fallback for
// screen-reader users and anyone who gets lost.

const GOLD = '#fcd34d';
const PLACES_ACCENT = '#c084fc';

/** m:ss from ms, or ''. */
const clock = (ms) => {
  if (typeof ms !== 'number' || !Number.isFinite(ms) || ms <= 0) return '';
  const s = Math.round(ms / 1000);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
};

/**
 * The status chip of a Daily row.
 * @param {{ status?: string, ms?: number | null } | undefined} info
 * @returns {{ text: string, done: boolean }}
 */
export function dailyChip(info) {
  if (info?.status === 'done') { const t = clock(info.ms ?? undefined); return { text: t ? `✓ ${t}` : '✓', done: true }; }
  if (info?.status === 'started') return { text: 'CONTINUE', done: false };
  return { text: 'PLAY', done: false };
}

/**
 * @param {{ objects: any[], pilots?: Array<{ uid: string, name: string }>,
 *   todays?: Record<string, { status?: string, ms?: number | null }> | null,
 *   onPick?: (o: any) => void, onPickPilot?: (uid: string) => void, onLaunch?: (o: any) => void, onClose: () => void }} props
 */
export default function QuickLaunch({ objects, pilots = [], todays = null, onPick = () => {}, onPickPilot = () => {}, onLaunch = () => {}, onClose }) {
  // Escape closes the list (keyboard users; the × and a tap outside are the touch ways out).
  useEffect(() => {
    const onKey = (e) => { if (e.key === 'Escape') onClose(); };
    globalThis.addEventListener('keydown', onKey);
    return () => globalThis.removeEventListener('keydown', onKey);
  }, [onClose]);
  const dailies = objects.filter((o) => o.daily);
  const places = objects.filter((o) => !o.daily && !o.practiceOf);
  const moonOf = (d) => objects.find((o) => o.practiceOf === d.id) ?? null;
  const done = dailies.filter((d) => todays?.[d.daily]?.status === 'done').length;
  return (
    <div className="absolute inset-0 z-50 bg-black/70 backdrop-blur-sm" onPointerDown={(e) => { e.stopPropagation(); onClose(); }}>
      <div
        data-testid="fly-menu"
        role="dialog"
        aria-label="Fly to"
        onPointerDown={(e) => e.stopPropagation()}
        className="absolute inset-x-3 rounded-3xl border bg-[#0a0618]/95 p-4 overflow-y-auto"
        style={{
          top: 'calc(var(--safe-top, 0px) + 64px)', bottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 16px)',
          borderColor: 'rgba(34, 211, 238, 0.6)',
        }}
      >
        <div className="flex items-center justify-between">
          <h2 className="text-lg font-black text-white">🚀 Fly to…</h2>
          <button type="button" data-testid="fly-menu-close" onClick={onClose} className="-mr-2 -mt-1 grid h-11 w-11 shrink-0 place-items-center rounded-full text-slate-400 text-2xl leading-none" aria-label="Close">×</button>
        </div>

        {pilots.length > 0 && (
          <section className="mt-3">
            <h3 className="text-[10px] uppercase tracking-[0.3em] text-emerald-300">Pilots in your room</h3>
            <ul className="mt-2 space-y-2">
              {pilots.map((p) => (
                <li key={p.uid}>
                  <button type="button" data-testid="fly-pilot" onClick={() => onPickPilot(p.uid)}
                    className="flex w-full items-center gap-2 rounded-xl border border-emerald-300/40 bg-emerald-400/10 p-3 text-left">
                    <span className="text-lg">🛸</span>
                    <span className="flex-1 font-bold text-white text-sm">{p.name}</span>
                    <span className="text-xs font-black text-emerald-200">FLY ▶</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section className="mt-3" data-testid="fly-dailies">
          <h3 className="text-[10px] font-black uppercase tracking-[0.3em]" style={{ color: GOLD }}>
            Today&apos;s Dailies · <span data-testid="fly-done-count">{done}/{dailies.length}</span> ✓
          </h3>
          <ul className="mt-2 space-y-2">
            {dailies.map((o) => {
              const chip = dailyChip(todays?.[o.daily]);
              const moon = moonOf(o);
              return (
                <li key={o.id}>
                  <div data-testid="fly-row" data-id={o.id} className="flex items-stretch gap-1.5 rounded-xl border border-amber-300/20 bg-white/5 p-1">
                    <button type="button" data-testid="fly-destination" data-id={o.id} onClick={() => onPick(o)}
                      className="flex min-h-[44px] min-w-0 flex-1 items-center gap-2 rounded-lg px-2 py-1.5 text-left active:scale-[0.98]">
                      <div className="min-w-0 flex-1">
                        <div className="truncate font-bold text-white text-sm">{o.name}</div>
                        {o.tag && <div className="text-[10px] font-black" style={{ color: o.tagColor || GOLD }}>{o.tag}</div>}
                      </div>
                      <span data-testid={`fly-status-${o.id}`} data-done={chip.done ? 'true' : undefined}
                        className={`shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-black tracking-wider ${chip.done ? 'border-amber-300/40 text-amber-200/80' : 'border-amber-400 bg-amber-950 text-amber-300'}`}>
                        {chip.text}
                      </span>
                      <span className="shrink-0 text-xs font-black text-cyan-300">FLY ▶</span>
                    </button>
                    {moon && (
                      <button type="button" data-testid={`fly-practice-${o.id}`} onClick={() => onLaunch(moon)}
                        aria-label={`Practice ${o.name}`}
                        className="shrink-0 min-h-[44px] rounded-lg bg-slate-700 px-2.5 text-[11px] font-black text-slate-100 active:scale-95">
                        Practice
                      </button>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>

        <section className="mt-4">
          <h3 className="text-[10px] uppercase tracking-[0.3em]" style={{ color: PLACES_ACCENT }}>Places</h3>
          <ul className="mt-2 space-y-2">
            {places.map((o) => (
              <li key={o.id}>
                <div data-testid="fly-row" data-id={o.id} className="flex items-stretch gap-1.5 rounded-xl border border-white/10 bg-white/5 p-1">
                  <button type="button" data-testid="fly-destination" data-id={o.id} onClick={() => onPick(o)}
                    className="flex min-h-[44px] min-w-0 flex-1 items-center gap-2 rounded-lg px-2 py-1.5 text-left active:scale-[0.98]">
                    <div className="min-w-0 flex-1">
                      <div className="font-bold text-white text-sm">{o.name}{o.tag && <span className="ml-2 text-[10px] font-black" style={{ color: o.tagColor || '#fde68a' }}>{o.tag}</span>}</div>
                      <div className="text-[11px] leading-snug text-slate-400 line-clamp-2">{o.blurb}</div>
                    </div>
                    <span className="shrink-0 text-xs font-black" style={{ color: PLACES_ACCENT }}>FLY ▶</span>
                  </button>
                  {o.launch.type !== 'return' && (
                    <button type="button" data-testid={`fly-go-${o.id}`} onClick={() => onLaunch(o)}
                      aria-label={`Open ${o.name}`}
                      className="shrink-0 min-h-[44px] min-w-[60px] rounded-lg px-3 text-xs font-black text-[#0a0618] active:scale-95"
                      style={{ background: PLACES_ACCENT }}>
                      Open
                    </button>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  );
}
