// Map-style labels for the world (David, 2026-10-14: "some of the names are colliding with other
// objects or the object they are naming… make sure nothing is stacked"). Pure: the canvas passes
// each object's screen footprint and label size; this says where each label goes, or that it hides.
//
// Footprints are ELLIPSES (rx wide, ry tall): Titan's rings are wide but flat and Ember's moons
// orbit on a flattened path, so a label can sit right under the planet without touching them
// (David: with round footprints "the names are too far off of Titan and Ember").
//
// Rules: a label never covers its own object, another object, or another label. Bigger objects
// choose first. Each tries below, above, right, then left; if all four are blocked it hides.

export const LABEL_GAP = 6;

/** How far an object's drawing reaches, in multiples of its radius: { rx, ry }. */
export function visualExtent(o) {
  if (o.paint?.rings) return { rx: 2.05, ry: 1.05 }; // rings: wide, flattened to 0.28
  if (o.paint?.moons) {
    const reach = 1.45 + 0.22 * (o.paint.moons.length - 1) + 0.12;
    return { rx: reach, ry: Math.max(1.05, reach * 0.6) }; // moon orbits flattened to 0.6
  }
  if (o.kind === 'planet') return { rx: 1.08, ry: 1.08 };
  return { rx: 1.18, ry: 1.18 };
}

const overlaps = (a, b) => a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
const hitsEllipse = (box, e) => {
  const nx = Math.max(box.x, Math.min(e.x, box.x + box.w));
  const ny = Math.max(box.y, Math.min(e.y, box.y + box.h));
  return ((nx - e.x) / e.rx) ** 2 + ((ny - e.y) / e.ry) ** 2 < 1;
};

/**
 * @param {Array<{ id: string, x: number, y: number, rx: number, ry: number, w: number, h: number }>} items
 *   screen footprint (ellipse radii) + label box size, for every object on screen
 * @param {Array<{ x: number, y: number, w: number, h: number }>} [blocked] screen areas covered by
 *   the controls (joystick, minimap, buttons, the docking card) — a label there would be hidden
 * @returns {Map<string, { x: number, y: number, w: number, h: number, side: string } | null>}
 *   the label box's top-left corner, or null when it has nowhere free to go
 */
export function placeLabels(items, blocked = []) {
  const out = new Map();
  const placed = [];
  const order = [...items].sort((a, b) => b.rx - a.rx);
  for (const it of order) {
    const g = LABEL_GAP;
    const spots = [
      { side: 'below', x: it.x - it.w / 2, y: it.y + it.ry + g },
      { side: 'above', x: it.x - it.w / 2, y: it.y - it.ry - g - it.h },
      { side: 'right', x: it.x + it.rx + g, y: it.y - it.h / 2 },
      { side: 'left', x: it.x - it.rx - g - it.w, y: it.y - it.h / 2 },
    ];
    const free = spots.find((s) => {
      const box = { x: s.x, y: s.y, w: it.w, h: it.h };
      if (placed.some((p) => overlaps(box, p)) || blocked.some((b) => overlaps(box, b))) return false;
      return !items.some((other) => other.id !== it.id && hitsEllipse(box, other));
    });
    if (free) {
      const box = { x: free.x, y: free.y, w: it.w, h: it.h, side: free.side };
      placed.push(box);
      out.set(it.id, box);
    } else out.set(it.id, null);
  }
  return out;
}
