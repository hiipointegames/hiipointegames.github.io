import React from 'react';
import { createPortal } from 'react-dom';
import { earnRows } from './earnRules';

// The "How to earn ★" sheet (audit 2026-10-18, M1). Rows come from earnRules.js (the same table the
// server pays from). Opened from the Star Market header, and since 2026-10-22 (world lane) from the ★
// in the world's top bar too, where each row gets FLY ▶ to the place you earn it (onFly / canFly).
// Portaled to <body> like the other sheets (ios-overlays-must-portal); it used to sit inside its parent.

/**
 * @param {{ onClose: () => void, onFly?: (key: string) => void, canFly?: (key: string) => boolean }} props
 */
export default function EarnSheet({ onClose, onFly = undefined, canFly = () => false }) {
  const rows = earnRows();
  return createPortal(
    <div className="fixed inset-0 z-[10001] flex items-end bg-black/60" data-testid="earn-sheet-backdrop" onClick={onClose}
      onPointerDown={(e) => e.stopPropagation()}>
      <div role="dialog" aria-label="How to earn ★" data-testid="earn-sheet" onClick={(e) => e.stopPropagation()}
        aria-modal="true" className="max-h-[85%] w-full overflow-y-auto overscroll-contain rounded-t-2xl border-t border-amber-300/40 bg-[#0b0820] px-4"
        style={{ paddingBottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, env(safe-area-inset-bottom, 0px)) + 16px)' }}>
        {/* Sticky, so Close stays in reach when the list is taller than the screen (big font settings). */}
        <div className="sticky top-0 z-10 flex items-center justify-between bg-[#0b0820] pb-1 pt-3">
          <div className="text-base font-black text-white">How to earn ★</div>
          <button type="button" data-testid="earn-sheet-close" onClick={onClose} className="min-h-[44px] rounded-full border border-white/20 px-4 text-sm text-white">Close</button>
        </div>
        <ul className="mt-2 divide-y divide-white/10">
          {rows.map((r) => (
            <li key={r.key} data-testid={`earn-row-${r.key}`} className="flex items-center gap-3 py-2">
              <span className="w-6 shrink-0 text-center text-lg" aria-hidden="true">{r.icon}</span>
              <span className="min-w-0 flex-1">
                <span className="block text-sm font-bold text-white">{r.label}</span>
                <span className="block text-[11px] text-slate-400">{r.cap}</span>
              </span>
              <span className="shrink-0 text-sm font-black text-amber-200">{r.stars}</span>
              {onFly && canFly(r.key) && (
                <button type="button" data-testid={`earn-fly-${r.key}`} onClick={() => onFly(r.key)} aria-label={`Fly to: ${r.label}`}
                  className="shrink-0 min-h-[44px] rounded-lg border border-cyan-300/50 px-2.5 text-xs font-black text-cyan-200 active:scale-95">
                  FLY ▶
                </button>
              )}
            </li>
          ))}
        </ul>
        <p className="mt-1 text-center text-[10px] text-slate-500">Days reset at midnight Eastern.</p>
      </div>
    </div>,
    document.body,
  );
}
