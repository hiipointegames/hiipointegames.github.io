// Edge arrows (W5, 2026-10-19): when a game's Daily object or the Star Market is off-screen, a
// small arrow on the screen edge points the way, with that place's icon and colour.
//
// Pure maths, no drawing: WorldCanvas calls this every frame and draws what comes back. It is
// cheap on purpose: a handful of targets, and the arrows themselves are reused between frames (the
// caller passes the same `out` array back in). A few small temporaries per call remain (the inset
// and box objects, a closure per arrow) — trivial next to the rest of the frame.
//
// Where an arrow sits: on the ray from the screen centre towards the target, clamped to the
// screen inset by `inset`. If that spot is under a HUD control (the `avoid` rects: Return to 37,
// mute, FLY, the joystick, the minimap, the docking card), the arrow slides along its edge until
// it clears it; if it can't clear it, it is hidden (the control would cover it anyway).

export const EDGE_MARGIN = 22; // css px from the usable screen edge to an arrow's centre

/**
 * The arrows' insets: the margin PLUS the phone's safe areas (notch / status bar, gesture bar) and
 * the native ad banner (--safe-top, --safe-bottom, --ad-reserved-bottom; src/index.css and
 * shell/GlobalAdManager). WorldCanvas reads them off a hidden probe whose padding is
 * `var(--safe-top)` / `calc(var(--safe-bottom) + var(--ad-reserved-bottom))`, so env() and the
 * banner's live height arrive as plain px in its computed style.
 * @param {{ paddingTop?: string, paddingBottom?: string } | null | undefined} probeStyle
 */
export function edgeInsets(probeStyle, margin = EDGE_MARGIN) {
  const px = (v) => { const n = Number.parseFloat(v ?? ''); return Number.isFinite(n) && n > 0 ? n : 0; };
  return { top: margin + px(probeStyle?.paddingTop), bottom: margin + px(probeStyle?.paddingBottom), left: margin, right: margin };
}

/**
 * The world objects that get an edge arrow: the ones with an `icon`. Since 2026-10-22 (David: "they
 * point to every available object, just the daily version of it") that is each game's DAILY object
 * plus the Star Market; arrows stay when a Daily is done, so the player always sees where everything is.
 */
export const arrowTargets = (objects) => objects.filter((o) => o.icon);

/**
 * Objects sharing an `arrowGroup` (37's three Daily planets) get ONE arrow, to the one nearest the
 * camera. O(n²) over a handful of targets, no allocation: cheap enough for every frame.
 * @param {any} o  @param {any[]} targets  @param {{ x: number, y: number }} cam
 */
export function isNearestOfGroup(o, targets, cam) {
  if (!o.arrowGroup) return true;
  const d = Math.hypot(o.x - cam.x, o.y - cam.y);
  for (const p of targets) {
    if (p === o || p.arrowGroup !== o.arrowGroup) continue;
    const dp = Math.hypot(p.x - cam.x, p.y - cam.y);
    if (dp < d || (dp === d && targets.indexOf(p) < targets.indexOf(o))) return false;
  }
  return true;
}

/** Arrow colour: the object's own hue, bright enough to read on space. */
export const arrowColor = (o) => o.arrowColor || `hsl(${o.paint?.hue ?? 270}, 90%, 68%)`;

export const ARROW_SIZE = 28; // css px, the arrow's disc diameter
const R = ARROW_SIZE / 2;

/** @typedef {{ x: number, y: number, w: number, h: number }} Rect */
/** @typedef {{ id: string, x: number, y: number, angle: number, icon: string, color: string, side: 'top'|'bottom'|'left'|'right', object: any }} EdgeArrow */

const hits = (x, y, r) => x > r.x - R && x < r.x + r.w + R && y > r.y - R && y < r.y + r.h + R;

const GAP = 4; // px between two arrows that would otherwise overlap
// The arrows already placed this frame, as rects, so the next one steps aside (reused: no garbage).
/** @type {Rect[]} */
const placed = [];
let placedN = 0;

/**
 * Slide (x, y) along its edge out of every avoid rect and every arrow already placed. Returns false
 * if it can't get clear.
 * @param {EdgeArrow} a  @param {Rect[]} avoid  @param {{ x0: number, y0: number, x1: number, y1: number }} box
 */
function slideClear(a, avoid, box) {
  const alongX = a.side === 'top' || a.side === 'bottom';
  const total = avoid.length + placedN;
  const rectAt = (i) => (i < avoid.length ? avoid[i] : placed[i - avoid.length]);
  for (let pass = 0; pass < 4; pass++) {
    let moved = false;
    for (let i = 0; i < total; i++) {
      const r = rectAt(i);
      if (!hits(a.x, a.y, r)) continue;
      moved = true;
      if (alongX) {
        const left = r.x - R - 1; const right = r.x + r.w + R + 1;
        const pick = Math.abs(a.x - left) <= Math.abs(right - a.x) ? left : right;
        a.x = pick < box.x0 || pick > box.x1 ? (pick === left ? right : left) : pick;
      } else {
        const up = r.y - R - 1; const down = r.y + r.h + R + 1;
        const pick = Math.abs(a.y - up) <= Math.abs(down - a.y) ? up : down;
        a.y = pick < box.y0 || pick > box.y1 ? (pick === up ? down : up) : pick;
      }
    }
    if (!moved) break;
  }
  if (a.x < box.x0 || a.x > box.x1 || a.y < box.y0 || a.y > box.y1) return false; // slid off its edge
  for (let i = 0; i < total; i++) if (hits(a.x, a.y, rectAt(i))) return false;
  return true;
}

/** Remember a placed arrow as a rect the next arrows must clear. @param {EdgeArrow} a */
function place(a) {
  const r = placed[placedN] || (placed[placedN] = { x: 0, y: 0, w: 0, h: 0 });
  r.x = a.x - R - GAP; r.y = a.y - R - GAP; r.w = 2 * (R + GAP); r.h = 2 * (R + GAP);
  // hits() pads by R again, so two centres end up at least 2R + GAP apart.
  placedN++;
}

const DEFAULT_INSET = R + 6;

/** @param {number | { top?: number, right?: number, bottom?: number, left?: number } | undefined} inset */
function insets(inset) {
  if (typeof inset === 'number') return { top: inset, right: inset, bottom: inset, left: inset };
  const d = DEFAULT_INSET;
  return { top: inset?.top ?? d, right: inset?.right ?? d, bottom: inset?.bottom ?? d, left: inset?.left ?? d };
}

/**
 * @param {{ x: number, y: number, zoom: number }} cam
 * @param {{ width: number, height: number, inset?: number | { top?: number, right?: number, bottom?: number, left?: number }, avoid?: Rect[] }} viewport
 * @param {any[]} targets  world objects (x, y, id, icon, paint)
 * @param {EdgeArrow[]} [out]  reused between frames
 * @returns {EdgeArrow[]}
 */
export function edgeArrows(cam, viewport, targets, out = []) {
  const { width, height, avoid = [] } = viewport;
  const ins = insets(viewport.inset);
  const box = { x0: ins.left, y0: ins.top, x1: width - ins.right, y1: height - ins.bottom };
  const cx = width / 2; const cy = height / 2;
  let n = 0;
  placedN = 0;
  if (width <= 0 || height <= 0 || box.x1 <= box.x0 || box.y1 <= box.y0) { out.length = 0; return out; }
  for (const o of targets) {
    if (!isNearestOfGroup(o, targets, cam)) continue;
    const sx = (o.x - cam.x) * cam.zoom + cx;
    const sy = (o.y - cam.y) * cam.zoom + cy;
    if (sx >= 0 && sx <= width && sy >= 0 && sy <= height) continue; // on screen: no arrow
    const dx = sx - cx; const dy = sy - cy;
    // Where the centre→target ray meets the inset box.
    const tx = dx > 0 ? (box.x1 - cx) / dx : dx < 0 ? (box.x0 - cx) / dx : Infinity;
    const ty = dy > 0 ? (box.y1 - cy) / dy : dy < 0 ? (box.y0 - cy) / dy : Infinity;
    const t = Math.min(tx, ty);
    const a = out[n] || (out[n] = /** @type {EdgeArrow} */ ({}));
    a.x = Math.min(box.x1, Math.max(box.x0, cx + dx * t));
    a.y = Math.min(box.y1, Math.max(box.y0, cy + dy * t));
    a.side = tx <= ty ? (dx > 0 ? 'right' : 'left') : (dy > 0 ? 'bottom' : 'top');
    if (!slideClear(a, avoid, box)) continue;
    place(a);
    a.angle = Math.atan2(sy - a.y, sx - a.x); // from the arrow to the target
    a.id = o.id; a.icon = o.icon; a.color = arrowColor(o); a.object = o;
    n++;
  }
  out.length = n;
  return out;
}

/**
 * The arrow under a tap, if any (a tap on an arrow flies there).
 * @param {EdgeArrow[]} arrows  @param {number} x  @param {number} y  @param {number} [slop] extra finger room, px
 */
export function arrowAt(arrows, x, y, slop = 8) {
  for (const a of arrows) if (Math.hypot(a.x - x, a.y - y) <= R + slop) return a;
  return null;
}
