import { apiClient } from '@/transport';

// What a Daily planet's card remembers between docks (slice 4a review, 2026-10-20), so docking does
// not cost a round of server reads every time. Module-level: it lasts for the app session.
//
//   terminal  — a Daily that is completed or forfeited stays that way for the rest of its ET day, so
//               once the server has said so the card never asks again. Keyed per PLAYER + date + mode
//               (another account on the same phone must not inherit it).
//   puzzle    — does (date, mode) have a puzzle? A puzzle, once there, is there all day: cached for
//               good. "No puzzle" is re-asked after MISSING_TTL_MS, in case it is stocked later.
//
// Only these two are cached. Not-started / still-running is re-read from the server on every dock,
// because 37 can change it at any time.

export const MISSING_TTL_MS = 10 * 60 * 1000;

/** @type {Map<string, 'completed' | 'forfeited'>} */
const terminal = new Map();
/** @type {Map<string, { exists: boolean, at: number }>} */
const puzzle = new Map();

const tKey = (userId, date, mode) => `${userId}:${date}:${mode}`;
const pKey = (date, mode) => `${date}:${mode}`;

/** @returns {'completed' | 'forfeited' | null} */
export function terminalStatus(userId, date, mode) {
  return terminal.get(tKey(userId, date, mode)) ?? null;
}

/** Remember a terminal status; anything else is ignored. */
export function rememberStatus(userId, date, mode, status) {
  if (status === 'completed' || status === 'forfeited') terminal.set(tKey(userId, date, mode), status);
}

/**
 * Is there a puzzle for (date, mode)? A plain read of daily_challenges — no fallback dice, no logging
 * (unlike the attempt hook's fetchTodaysDice, which /Game keeps as it is). Throws if the read fails
 * (nothing is cached then).
 * @param {string} date  @param {string} mode
 * @param {{ read?: (q: { date: string, mode: string }) => Promise<any[]>, now?: () => number }} [deps]
 * @returns {Promise<boolean>}
 */
export async function puzzleExists(date, mode, { read = (q) => apiClient.entities.DailyChallenge.filter(q), now = Date.now } = {}) {
  const hit = puzzle.get(pKey(date, mode));
  if (hit && (hit.exists || now() - hit.at < MISSING_TTL_MS)) return hit.exists;
  const rows = await read({ date, mode });
  const exists = Array.isArray(rows) && rows.length > 0;
  puzzle.set(pKey(date, mode), { exists, at: now() });
  return exists;
}

/** Tests only. */
export function resetPlanetDailyCheck() {
  terminal.clear();
  puzzle.clear();
}
