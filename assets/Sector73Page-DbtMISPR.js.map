import React, { useState } from 'react';
import { motion } from 'framer-motion';
import ChallengeBattleCard from '@/components/profile/ChallengeBattleCard';
import CreateChallenge from '@/head-to-head/CreateChallenge';
import LiveChallengePicker from '../duel/LiveChallengePicker';

// The pilot card — tap another ship (David, 2026-10-14: "a pilot card, and within that you have
// options to see the whole profile, or challenge to a battle"). The Blitz flow is the SAME one
// a profile page uses (ChallengeBattleCard → CreateChallenge), so battles started here are
// ordinary battles: same rules, same notifications, same ★ for the winner.
//
// LIVE duels (slice S6, 2026-10-20): when the server switch sector73_live_battles is on, the page
// passes `liveInvite` and Challenge becomes a live duel invite instead (interview: new challenges
// made in Sector 73 are live). With the switch off there is no liveInvite and the Blitz flow stays.

/** The few numbers worth a glance, from profiles.stats (missing ones are left out). */
export function pilotStats(stats) {
  if (!stats) return [];
  const rows = [
    ['Daily streak', stats.daily_challenge_streak],
    ['Best streak', stats.longest_daily_streak ?? stats.best_streak],
    ['Solved', stats.total_solved],
  ];
  return rows.filter(([, v]) => Number.isFinite(v) && v > 0).map(([label, value]) => ({ label, value }));
}

/**
 * @param {{ pilot: { uid: string, name: string, country?: string|null, stats?: any, look?: any },
 *   canChallenge: boolean, onViewProfile: (uid: string) => void, onClose: () => void,
 *   onSent?: (name: string) => void,
 *   liveInvite?: ((pilot: any, opts: { style: string, firstTo: number }) => Promise<string|null>) | null }} props
 */
export default function PilotCard({ pilot, canChallenge, onViewProfile, onClose, onSent = undefined, liveInvite = null }) {
  const [step, setStep] = useState('card'); // card → tiers → confirm (CreateChallenge) · card → live (a live invite)
  const [tier, setTier] = useState(null);
  const ring = pilot.look?.frame?.ring;
  const stats = pilotStats(pilot.stats);

  if (step === 'confirm' && tier) {
    return (
      <CreateChallenge
        opponentId={pilot.uid}
        battleMode={tier}
        onClose={() => { setStep('tiers'); setTier(null); }}
        onCreated={() => { onSent?.(pilot.name); onClose(); }}
      />
    );
  }

  return (
    <div className="absolute inset-0 z-50 flex items-end justify-center bg-black/50 px-3" data-testid="pilot-card-backdrop"
      // Sits above the ad banner, like the minimap (S21: the buttons were hidden under it).
      // ...and below the status bar: the tier picker made it tall enough to slide under it.
      style={{ paddingTop: 'calc(var(--safe-top, 0px) + 12px)', paddingBottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 16px)' }}
      onPointerDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
      <motion.div
        initial={{ y: 40, opacity: 0 }} animate={{ y: 0, opacity: 1 }}
        data-testid="pilot-card"
        className="max-h-full w-full max-w-md overflow-y-auto rounded-2xl border border-violet-300/40 bg-[#0b0820]/95 p-4 text-white"
        style={{ boxShadow: '0 0 40px -12px #a855f7' }}
      >
        <div className="flex items-center gap-3">
          <span className="grid h-12 w-12 flex-none place-items-center rounded-full bg-violet-900 text-xl font-black"
            style={{ boxShadow: ring ? `0 0 0 3px ${ring}, 0 0 14px ${ring === '#000000' ? '#a855f7' : ring}` : 'none' }}>
            {pilot.name.slice(0, 1).toUpperCase()}
          </span>
          <div className="min-w-0 flex-1">
            <div className="truncate text-lg font-black" data-testid="pilot-name">{pilot.name}</div>
            <div className="text-xs text-slate-300">
              {pilot.look?.title && <span className="font-bold text-amber-200">{pilot.look.title}</span>}
              {pilot.look?.title && pilot.country ? ' · ' : ''}
              {pilot.country}
            </div>
          </div>
          <button type="button" onClick={onClose} aria-label="Close" className="rounded-full border border-white/20 px-3 py-1 text-sm">✕</button>
        </div>

        {stats.length > 0 && (
          <div className="mt-3 grid grid-cols-3 gap-2 text-center" data-testid="pilot-stats">
            {stats.map((s) => (
              <div key={s.label} className="rounded-lg bg-white/5 py-1.5">
                <div className="text-base font-black text-cyan-200">{s.value}</div>
                <div className="text-[10px] text-slate-400">{s.label}</div>
              </div>
            ))}
          </div>
        )}

        {step === 'live' && liveInvite ? (
          <LiveChallengePicker
            pilotName={pilot.name}
            onBack={() => setStep('card')}
            onSend={async (opts) => {
              const why = await liveInvite(pilot, opts);
              if (!why) { onSent?.(pilot.name); onClose(); }
              return why;
            }}
          />
        ) : step === 'tiers' ? (
          <div className="mt-3" data-testid="pilot-tiers">
            <ChallengeBattleCard username={pilot.name} onChallenge={(mode) => { setTier(mode); setStep('confirm'); }} />
            <button type="button" onClick={() => setStep('card')} className="w-full text-center text-xs text-slate-400 underline">Back</button>
          </div>
        ) : (
          <div className="mt-4 grid grid-cols-2 gap-2">
            <button type="button" data-testid="pilot-profile" onClick={() => onViewProfile(pilot.uid)}
              className="rounded-xl border border-cyan-300/50 bg-cyan-500/10 py-3 text-sm font-black text-cyan-100">
              👤 View profile
            </button>
            <button type="button" data-testid="pilot-challenge" disabled={!canChallenge} onClick={() => setStep(liveInvite ? 'live' : 'tiers')}
              className="rounded-xl border border-fuchsia-300/60 bg-fuchsia-500/15 py-3 text-sm font-black text-fuchsia-100 disabled:opacity-40">
              {liveInvite ? '⚔️ Live duel' : '⚔️ Challenge to Blitz'}
            </button>
            {!canChallenge && <p className="col-span-2 text-center text-[11px] text-slate-400">Save your account to challenge pilots.</p>}
          </div>
        )}
      </motion.div>
    </div>
  );
}
