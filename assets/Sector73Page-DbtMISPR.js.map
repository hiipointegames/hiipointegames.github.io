import React, { useRef } from 'react';

// The HUD's FLY button: always on screen, the headline way to get around (David, 2026-10-14), and since
// W4 (2026-10-19) the only door into the destination list. A touch opens on pointerdown, so it feels
// instant and the world under it never sees the press. A keyboard (Enter/Space) or a screen reader's
// activate only sends a click, so the click opens too. The click that follows a touch is ignored, so
// one tap opens the list once.
const CLICK_AFTER_POINTER_MS = 800;

/** @param {{ onOpen: () => void }} props */
export default function FlyButton({ onOpen }) {
  const pointerOpenedAt = useRef(-Infinity);
  return (
    <button
      type="button"
      data-testid="fly-open"
      onPointerDown={(e) => { e.stopPropagation(); pointerOpenedAt.current = Date.now(); onOpen(); }}
      onClick={() => { if (Date.now() - pointerOpenedAt.current < CLICK_AFTER_POINTER_MS) return; onOpen(); }}
      className="absolute z-40 left-1/2 -translate-x-1/2 flex items-center gap-2 rounded-full border-2 border-cyan-300/80 bg-cyan-500/20 px-7 py-2 text-base font-black tracking-[0.25em] text-white backdrop-blur active:scale-95"
      style={{ top: 'calc(var(--safe-top, 0px) + 60px)', boxShadow: '0 0 22px -4px #22d3ee, inset 0 0 12px -6px #67e8f9' }}
    >
      🚀 FLY
    </button>
  );
}
