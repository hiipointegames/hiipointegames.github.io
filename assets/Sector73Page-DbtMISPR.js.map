// ★ Stars — Sector 73's currency, kept on the ACCOUNT (David, 2026-10-14). The server is the
// referee (supabase/migrations/20261014000000_sector73_stars.sql): it derives stars from the main
// Dailies and Blitz wins, sets the amount of every Sector 73 reward, and checks every purchase.
//
// This module is the app's side of it:
//   • a cached balance (shown at once; refreshed from the server)
//   • earnStars(reason, ref) — asks the server to pay a reward; if it can't reach the server (offline,
//     signed out) the reward waits in a small queue on the phone and is sent next time
//   • the Star Market calls: catalogue, my items + loadout, buy, equip
// Every change of balance is announced on window ('sector73:stars') so any screen can show it.

import { useEffect, useState } from 'react';
import { supabase } from '@/transport/supabaseClient';
import { REWARDS, REWARD_CAPS } from './rewards';

const BALANCE_KEY = 'sector73.stars.balance';
const PENDING_KEY = 'sector73.stars.pending';
export const STAR_EVENT = 'sector73:stars';

/** The rewards the server knows, with what each pays and how often a day (see ./rewards.js). */
export { REWARDS, REWARD_CAPS };

const safe = (fn, fallback) => { try { return fn(); } catch { return fallback; } };

/** The last known balance (instant; may be a little stale). */
export const readStarBalance = () => safe(() => Number(globalThis.localStorage?.getItem(BALANCE_KEY) ?? 0) || 0, 0);

function setBalance(n) {
  if (!Number.isFinite(n)) return;
  safe(() => globalThis.localStorage?.setItem(BALANCE_KEY, String(n)));
  safe(() => globalThis.dispatchEvent?.(new CustomEvent(STAR_EVENT, { detail: n })));
}

const readPending = () => safe(() => JSON.parse(globalThis.localStorage?.getItem(PENDING_KEY) ?? '[]'), []);
const writePending = (list) => safe(() => globalThis.localStorage?.setItem(PENDING_KEY, JSON.stringify(list.slice(-50))));

/** Ask the server for the balance (signed-out players have 0). */
export async function refreshStarBalance() {
  const { data, error } = await supabase.rpc('sector73_star_balance');
  if (error) return readStarBalance();
  setBalance(data);
  return data;
}

/**
 * Earn a Sector 73 reward. Resolves to the new balance, or null when it was queued for later.
 * @param {keyof typeof REWARDS} reason
 * @param {string} ref  what it was for (a seed or date) — the server pays each (reason, ref) once
 */
export async function earnStars(reason, ref) {
  try {
    const { data, error } = await supabase.rpc('sector73_star_award', { p_reason: reason, p_ref: String(ref) });
    if (error) throw error;
    setBalance(data);
    return data;
  } catch {
    const list = readPending();
    if (!list.some((p) => p.reason === reason && p.ref === ref)) writePending([...list, { reason, ref: String(ref) }]);
    return null;
  }
}

/** Send any rewards that were earned while the server couldn't be reached. */
export async function flushPendingStars() {
  const list = readPending();
  if (!list.length) return refreshStarBalance();
  const left = [];
  let balance = null;
  for (const p of list) {
    const { data, error } = await supabase.rpc('sector73_star_award', { p_reason: p.reason, p_ref: p.ref });
    if (error) left.push(p); else balance = data;
  }
  writePending(left);
  if (balance != null) setBalance(balance);
  return balance ?? readStarBalance();
}

/** React: the balance, kept current. */
export function useStarBalance() {
  const [n, setN] = useState(readStarBalance);
  useEffect(() => {
    const on = (e) => setN(Number(e.detail) || 0);
    globalThis.addEventListener?.(STAR_EVENT, on);
    return () => globalThis.removeEventListener?.(STAR_EVENT, on);
  }, []);
  return n;
}

// ── The Star Market ─────────────────────────────────────────────────────────────────────────────
export async function fetchCatalog() {
  const { data, error } = await supabase.from('sector73_catalog').select('item_id,kind,name,price,data,sort,rarity,set_id,available_from,available_until').order('sort');
  if (error) throw error;
  return data;
}

/** { owned: Set<item_id>, loadout: { ship_color, trail, … } } for the signed-in pilot. */
export async function fetchMyItems() {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return { owned: new Set(), loadout: {} };
  const [{ data: inv }, { data: lo }] = await Promise.all([
    supabase.from('sector73_inventory').select('item_id').eq('user_id', user.id),
    supabase.from('sector73_loadout').select('*').eq('user_id', user.id).maybeSingle(),
  ]);
  return { owned: new Set((inv || []).map((r) => r.item_id)), loadout: lo || {} };
}

/** Buy an item; resolves to the new balance. Throws "not enough stars" etc. */
export async function buyItem(itemId) {
  const { data, error } = await supabase.rpc('sector73_buy', { p_item: itemId });
  if (error) throw new Error(error.message);
  setBalance(data);
  return data;
}

/** Equip (or, with null, unequip) an item in its slot. */
export async function equipItem(kind, itemId) {
  const { error } = await supabase.rpc('sector73_equip', { p_kind: kind, p_item: itemId });
  if (error) throw new Error(error.message);
}
