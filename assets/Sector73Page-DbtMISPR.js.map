import React from 'react';
import { motion } from 'framer-motion';
import { usePrefersReducedMotion } from '../fx/motionPrefs';

// Slides in when the ship settles into orbit around an object (David's pick:
// "docking card, then Launch" — prevents entering a mode by accident).
// It sits at the TOP, under the header row (David, S21 2026-10-10): the camera keeps the ship
// centred, and a mid-screen card hid the ship, its orbit and the docking-lock ring.

// The DOCKED stamp (W6, 2026-10-19): on a FRESH dock only (the page passes `fresh`; a restored dock —
// back from a planet's screen or a mode — has none). It thumps down in ~0.6 s and stays; with
// reduced motion it is simply there, no movement.
export const STAMP_SECONDS = 0.6;

function DockedStamp({ accent }) {
  const reduced = usePrefersReducedMotion();
  const className = 'pointer-events-none absolute top-1.5 right-10 rounded-md border-2 px-2 py-0.5 text-[11px] font-black tracking-[0.3em]';
  const style = { color: accent, borderColor: accent, background: 'rgba(10, 6, 28, 0.92)', boxShadow: `0 0 14px -4px ${accent}` };
  if (reduced) {
    return <div data-testid="docking-stamp" data-motion="static" aria-hidden="true" className={className} style={{ ...style, transform: 'rotate(-8deg)' }}>DOCKED</div>;
  }
  return (
    <motion.div
      data-testid="docking-stamp"
      data-motion="stamp"
      aria-hidden="true"
      className={className}
      style={style}
      initial={{ scale: 2.4, opacity: 0, rotate: -22 }}
      animate={{ scale: [2.4, 0.92, 1], opacity: [0, 1, 1], rotate: [-22, -6, -8] }}
      transition={{ duration: STAMP_SECONDS, times: [0, 0.6, 1], ease: 'easeOut' }}
    >
      DOCKED
    </motion.div>
  );
}

// `actions` (slice 4a 2026-10-20, ported 2026-10-22): a Daily object's own buttons (Daily status +
// Practice) take LAUNCH's place. `tag` (world lane 2026-10-22): the card names the object the way the
// map label does (EASY DAILY, DAILY, PRACTICE, DONE ✓…); it used to drop the tag.
export default function DockingCard({ object, best, onLaunch, onUndock, onBoard = undefined, fresh = false, actions = null, tag = undefined }) {
  if (!object) return null;
  const far = object.region === 'far';
  const accent = object.daily ? '#fcd34d' : far ? '#c084fc' : object.region === 'core' ? '#f0abfc' : '#67e8f9';
  const shownTag = tag ?? object.tag;
  const verb = object.launch.type === 'return' ? 'Return to 37' : 'Launch';
  return (
    <motion.div
      key={object.id}
      data-testid="docking-card"
      data-anchor="top"
      initial={{ y: -40, opacity: 0 }}
      animate={{ y: 0, opacity: 1 }}
      exit={{ y: -40, opacity: 0 }}
      className="absolute inset-x-0 mx-auto w-[min(92vw,380px)] rounded-2xl border p-4 backdrop-blur-md"
      style={{
        top: 'calc(var(--safe-top, 0px) + 160px)', // under the FLY button and the ★ / room line
        background: 'rgba(10, 6, 28, 0.82)',
        borderColor: accent,
        boxShadow: `0 0 30px -10px ${accent}`,
      }}
      onPointerDown={(e) => e.stopPropagation()}
    >
      {fresh && <DockedStamp accent={accent} />}
      <div className="flex items-start justify-between gap-3">
        <div className="min-w-0">
          <div className="text-[10px] uppercase tracking-[0.3em]" style={{ color: accent }}>
            {far ? 'Sector 73' : object.region === 'core' ? 'Wormhole' : 'Home system'} · in orbit
          </div>
          <div className="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
            <span className="truncate text-xl font-black text-white">{object.name}</span>
            {shownTag && (
              <span data-testid="docking-tag" className="shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-black tracking-wider"
                style={{ color: object.tagColor || accent, borderColor: `${object.tagColor || accent}88` }}>{shownTag}</span>
            )}
          </div>
        </div>
        <button
          type="button"
          aria-label="Leave orbit"
          onPointerDown={(e) => { e.stopPropagation(); onUndock(); }}
          className="text-slate-400 hover:text-white text-xl leading-none px-1"
        >
          ×
        </button>
      </div>
      <p className="mt-1 text-sm text-slate-300">{object.blurb}</p>
      {best && <p className="mt-1 text-xs font-semibold" style={{ color: accent }}>{best}</p>}
      {onBoard && (
        <button type="button" data-testid="docking-board" onPointerDown={(e) => { e.stopPropagation(); onBoard(object); }}
          className="mt-2 w-full rounded-xl border border-amber-300/50 bg-amber-400/10 py-2 text-sm font-bold text-amber-100">
          🏆 Today&apos;s Daily board
        </button>
      )}
      {actions ?? (
        <button
          type="button"
          data-testid="docking-launch"
          onPointerDown={(e) => { e.stopPropagation(); onLaunch(object); }}
          className="mt-3 w-full rounded-xl py-3 font-black tracking-widest text-[#0a0618] active:scale-95 transition-transform"
          style={{ background: accent, boxShadow: `0 0 22px -6px ${accent}` }}
        >
          {verb.toUpperCase()} ▶
        </button>
      )}
    </motion.div>
  );
}
