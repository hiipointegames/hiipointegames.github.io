// Minimap marks (David, 2026-10-14: ships need "their own special dot on the mini map so they are
// not confused with planets or other objects"). Planets and stations are round dots; every SHIP is
// an arrow pointing where it is heading — yours white, other pilots bright green with a dark
// outline, a colour no world object uses.

export const PILOT_MARK = Object.freeze({ fill: '#4ade80', outline: '#052e16' });
export const SELF_MARK = Object.freeze({ fill: '#ffffff', outline: '#1e1b4b' });

/**
 * Draw a ship arrow at (x, y), nose along `angle` (radians, the ship's own facing).
 * @param {CanvasRenderingContext2D} g
 * @param {{ fill: string, outline: string }} mark
 */
export function drawShipMark(g, x, y, angle, mark, size = 5) {
  g.save();
  g.translate(x, y);
  g.rotate(angle + Math.PI / 2); // ship angle 0 = pointing right; the arrow is drawn nose-up
  g.beginPath();
  g.moveTo(0, -size); g.lineTo(size * 0.75, size * 0.85); g.lineTo(0, size * 0.4); g.lineTo(-size * 0.75, size * 0.85);
  g.closePath();
  g.lineWidth = 1.5;
  g.strokeStyle = mark.outline;
  g.stroke();
  g.fillStyle = mark.fill;
  g.fill();
  g.restore();
}
