// How Daily and Practice objects LOOK on the map (world lane, 2026-10-22): pure rules, drawn by
// WorldCanvas every frame. "Done today" comes from the page as `sim.current.dailyDone` (a Set of
// object ids), read each frame, so a status change never restarts the canvas (contrarian M6).
//
//   Daily object, still open today → a gold ring that pulses softly; tag as registered.
//   Daily object, done today      → a thin still gold ring + ✓; the tag reads "DONE ✓".
//   Minimap: solid gold = open Daily, hollow gold = done, grey = practice, violet = other places,
//   pink = the Mirror. Green stays the other pilots' colour (minimapMarks.js), never an object's.

export const GOLD = '#fcd34d';
export const MINI_PRACTICE = '#94a3b8';
export const MINI_PLACE = '#c084fc';
export const MINI_CORE = '#f0abfc';
export const MINI_SELECTED = '#22d3ee';

/** @param {any} o  @param {Set<string> | null | undefined} done */
export const isDone = (o, done) => Boolean(o?.daily && done?.has(o.id));

/**
 * The tag under an object's name: a finished Daily says so.
 * @param {any} o  @param {Set<string> | null | undefined} done
 * @returns {string | undefined}
 */
export function labelTag(o, done) {
  return isDone(o, done) ? 'DONE ✓' : o?.tag;
}

/**
 * The ring around a Daily object, or null. `alpha` pulses between 0.45 and 0.95 while open.
 * @param {any} o  @param {Set<string> | null | undefined} done  @param {number} time seconds
 * @param {boolean} [still] reduced motion: no pulse
 * @returns {{ color: string, width: number, alpha: number, glow: number, check: boolean } | null}
 */
export function dailyRing(o, done, time, still = false) {
  if (!o?.daily) return null;
  if (isDone(o, done)) return { color: GOLD, width: 1.5, alpha: 0.6, glow: 0, check: true };
  const pulse = still ? 0.5 : (Math.sin(time * 2.2) + 1) / 2;
  return { color: GOLD, width: 3, alpha: 0.45 + pulse * 0.5, glow: 10 + pulse * 12, check: false };
}

/**
 * A minimap dot's look.
 * @param {any} o  @param {{ dockedId?: string | null, targetId?: string | null, done?: Set<string> | null }} s
 * @returns {{ color: string, hollow: boolean }}
 */
export function minimapDot(o, s) {
  if (o.id === s.dockedId || o.id === s.targetId) return { color: MINI_SELECTED, hollow: false };
  if (o.daily) return { color: GOLD, hollow: isDone(o, s.done) };
  if (o.practiceOf) return { color: MINI_PRACTICE, hollow: false };
  return { color: o.region === 'core' ? MINI_CORE : MINI_PLACE, hollow: false };
}
