import React, { useRef, useState } from 'react';

// Virtual thumb-stick. Writes a normalised vector (-1..1) straight into the sim
// ref — no React state per move, so dragging never re-renders the page. Only the
// knob's visual offset is React state.

const RADIUS = 52;

export default function Joystick({ sim, onStart }) {
  const baseRef = useRef(null);
  const [knob, setKnob] = useState({ x: 0, y: 0 });
  const activeRef = useRef(false);

  const update = (e) => {
    const rect = baseRef.current.getBoundingClientRect();
    let dx = e.clientX - (rect.left + rect.width / 2);
    let dy = e.clientY - (rect.top + rect.height / 2);
    const l = Math.hypot(dx, dy);
    if (l > RADIUS) { dx = (dx / l) * RADIUS; dy = (dy / l) * RADIUS; }
    setKnob({ x: dx, y: dy });
    sim.current.input.joystick = { x: dx / RADIUS, y: dy / RADIUS };
  };

  const down = (e) => {
    e.preventDefault();
    e.stopPropagation();
    activeRef.current = true;
    e.currentTarget.setPointerCapture?.(e.pointerId);
    onStart?.();
    update(e);
  };
  const move = (e) => { if (activeRef.current) update(e); };
  const up = () => {
    activeRef.current = false;
    setKnob({ x: 0, y: 0 });
    sim.current.input.joystick = null;
  };

  return (
    <div
      ref={baseRef}
      data-testid="sector73-joystick"
      aria-label="Flight stick"
      role="slider"
      aria-valuetext="drag to fly"
      onPointerDown={down}
      onPointerMove={move}
      onPointerUp={up}
      onPointerCancel={up}
      className="absolute rounded-full border border-violet-400/40 bg-violet-950/30 backdrop-blur-sm touch-none select-none"
      style={{
        width: RADIUS * 2 + 24,
        height: RADIUS * 2 + 24,
        left: 18,
        bottom: 'calc(var(--ad-reserved-bottom, 0px) + var(--safe-bottom, 0px) + 22px)',
        boxShadow: 'inset 0 0 24px -8px #a855f7',
      }}
    >
      <div
        className="absolute rounded-full"
        style={{
          width: 54,
          height: 54,
          left: '50%',
          top: '50%',
          transform: `translate(calc(-50% + ${knob.x}px), calc(-50% + ${knob.y}px))`,
          background: 'radial-gradient(circle at 35% 30%, #e9d5ff, #7c3aed 70%)',
          boxShadow: '0 0 18px -2px #a855f7',
        }}
      />
    </div>
  );
}
