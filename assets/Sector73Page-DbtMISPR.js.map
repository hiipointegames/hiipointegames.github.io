// Sector 73's equation engine — see .crispy/sessions/2026-10-04-sector-73/modes-design.md.
//
// Works on a TOKEN LIST built by tapping dice and operators:
//   { t: 'die', i }  — die at index i of the board (its value comes from `values`)
//   { t: 'op', v }   — one of + - * / ^ ( ) √ ! ²
// Same rules as the main 37 engine — no unary minus, implicit multiplication for
// `2(…)`, `)(` and `)2`, power-dice colours judged by the operator a die is
// attached to — plus what Sector 73 adds: any target, √, !, fused dice, and a
// flat left-to-right mode (the Entropy curse).

export const OPS = ['+', '-', '*', '/', '^', '(', ')', '√', '!', '²'];
export const DISPLAY = { '+': '+', '-': '−', '*': '×', '/': '÷', '^': '^', '(': '(', ')': ')', '√': '√', '!': '!', '²': 'x²' };
/** Postfix operators: they follow a number or a bracket (Hyperjump's Square adds ², 2026-10-11). */
const POSTFIX = new Set(['!', '²']);

const BINARY = { '+': 2, '-': 2, '*': 3, '/': 3, '^': 4 };
const EPS = 1e-9;

const FACT = [1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880, 3628800];

class ParseError extends Error {}

/** Merge adjacent dice into number tokens; count the fused pairs. */
function lex(tokens, values) {
  const out = [];
  let fusedPairs = 0;
  for (const tok of tokens) {
    if (tok.t === 'die') {
      const v = values[tok.i];
      const prev = out[out.length - 1];
      if (prev && prev.k === 'num') {
        prev.value = prev.value * 10 + v;
        prev.dice.push(tok.i);
        fusedPairs++;
      } else {
        out.push({ k: 'num', value: v, dice: [tok.i] });
      }
    } else {
      out.push({ k: 'op', v: tok.v });
    }
  }
  // Implicit multiplication: num( , )( , )num , !( , !num
  const withImplicit = [];
  for (let i = 0; i < out.length; i++) {
    const a = withImplicit[withImplicit.length - 1];
    const b = out[i];
    const aEnds = a && (a.k === 'num' || (a.k === 'op' && (a.v === ')' || POSTFIX.has(a.v))));
    const bStarts = b.k === 'num' || (b.k === 'op' && (b.v === '(' || b.v === '√'));
    if (aEnds && bStarts && !(a.k === 'num' && b.k === 'num')) {
      withImplicit.push({ k: 'op', v: '*', implicit: true });
    }
    withImplicit.push(b);
  }
  return { lexed: withImplicit, fusedPairs };
}

function parse(lexed, { flat = false } = {}) {
  let pos = 0;
  const peek = () => lexed[pos];
  const next = () => lexed[pos++];

  const parsePrimary = () => {
    const tok = next();
    if (!tok) throw new ParseError('incomplete');
    if (tok.k === 'num') return { type: 'num', value: tok.value, dice: tok.dice };
    if (tok.v === '(') {
      const inner = parseExpr(0);
      const close = next();
      if (!close || close.v !== ')') throw new ParseError('unclosed');
      return inner;
    }
    if (tok.v === '√') return { type: 'sqrt', arg: parseUnary() };
    throw new ParseError('unexpected');
  };

  const parsePostfix = () => {
    let node = parsePrimary();
    while (peek() && peek().k === 'op' && POSTFIX.has(peek().v)) {
      node = { type: next().v === '!' ? 'fact' : 'square', arg: node };
    }
    return node;
  };

  const parseUnary = () => parsePostfix();

  const parseExpr = (minPrec) => {
    let left = parseUnary();
    for (;;) {
      const op = peek();
      if (!op || op.k !== 'op' || !(op.v in BINARY)) break;
      const prec = flat ? 2 : BINARY[op.v];
      if (prec < minPrec) break;
      next();
      const rightAssoc = !flat && op.v === '^';
      const right = parseExpr(rightAssoc ? prec : prec + 1);
      left = { type: 'bin', op: op.v, left, right };
    }
    return left;
  };

  const tree = parseExpr(0);
  if (pos !== lexed.length) throw new ParseError('trailing');
  return tree;
}

function evalNode(node, intermediates) {
  let v;
  switch (node.type) {
    case 'num': return node.value;
    case 'sqrt': {
      const a = evalNode(node.arg, intermediates);
      if (a < -EPS) throw new ParseError('sqrt-negative');
      v = Math.sqrt(Math.max(0, a));
      break;
    }
    case 'fact': {
      const a = evalNode(node.arg, intermediates);
      const r = Math.round(a);
      if (Math.abs(a - r) > EPS || r < 0 || r > 10) throw new ParseError('factorial');
      v = FACT[r];
      break;
    }
    case 'square': {
      const a = evalNode(node.arg, intermediates);
      v = a * a;
      break;
    }
    case 'bin': {
      const a = evalNode(node.left, intermediates);
      const b = evalNode(node.right, intermediates);
      if (node.op === '+') v = a + b;
      else if (node.op === '-') v = a - b;
      else if (node.op === '*') v = a * b;
      else if (node.op === '/') {
        if (Math.abs(b) < EPS) throw new ParseError('divide-by-zero');
        v = a / b;
      } else v = Math.pow(a, b);
      break;
    }
    default: throw new ParseError('unknown');
  }
  if (!Number.isFinite(v)) throw new ParseError('non-finite');
  intermediates.push(v);
  return v;
}

/**
 * Every die leaf with the operator it is attached to (for power-dice colours), and
 * `right` = it is that operator's RIGHT operand (for ^ that means the exponent —
 * Hyperjump's Red Giant curse needs to tell base from exponent).
 */
function collectLeaves(node, parentOp = null, out = [], right = false) {
  if (node.type === 'num') {
    out.push({ dice: node.dice, op: parentOp, right });
  } else if (node.type === 'bin') {
    collectLeaves(node.left, node.op, out, false);
    collectLeaves(node.right, node.op, out, true);
  } else {
    collectLeaves(node.arg, node.type, out, false);
  }
  return out;
}

/**
 * Evaluate a token list.
 * @param {Array<{t:'die',i:number}|{t:'op',v:string}>} tokens
 * @param {number[]} values  die values by board index
 * @param {{ flat?: boolean }} [opts]  flat = Entropy curse (strict left-to-right)
 */
export function evaluateTokens(tokens, values, opts = {}) {
  const usedIndices = tokens.filter((t) => t.t === 'die').map((t) => t.i);
  const base = { ok: false, value: null, error: null, fusedPairs: 0, usedIndices, intermediates: [], leaves: [] };
  if (!tokens.length) return { ...base, error: 'empty' };
  // No two binary operators side by side, and no binary operator at the start
  // or right after '(' — the "no unary minus" rule of the main game.
  for (let k = 0; k < tokens.length; k++) {
    const a = tokens[k - 1];
    const b = tokens[k];
    if (b.t === 'op' && b.v in BINARY) {
      const leftOk = a && (a.t === 'die' || a.v === ')' || POSTFIX.has(a.v));
      if (!leftOk) return { ...base, error: 'operator-needs-number' };
    }
  }
  try {
    const { lexed, fusedPairs } = lex(tokens, values);
    const tree = parse(lexed, opts);
    const intermediates = [];
    const raw = evalNode(tree, intermediates);
    const value = Math.abs(raw - Math.round(raw)) < 1e-9 ? Math.round(raw) : raw;
    return { ...base, ok: true, value, fusedPairs, intermediates, leaves: collectLeaves(tree) };
  } catch (e) {
    return { ...base, error: e instanceof ParseError ? e.message : 'invalid' };
  }
}

/**
 * Does the equation multiply without a × key — a die or ")" or a postfix right before "(" or "√",
 * or ")" / a postfix right before a die (`6(…)`, `(…)(…)`, `3!2`)? The engine inserts a hidden ×
 * there, so Hyperjump's Solar Flare must treat it as pressing × (bypass found 2026-10-11).
 */
export function hasImplicitMultiply(tokens) {
  for (let k = 1; k < tokens.length; k++) {
    const a = tokens[k - 1];
    const b = tokens[k];
    const aEnds = a.t === 'die' || a.v === ')' || POSTFIX.has(a.v);
    const bStarts = b.v === '(' || b.v === '√' || (b.t === 'die' && a.t !== 'die');
    if (aEnds && bStarts) return true;
  }
  return false;
}

/** Does `value` equal `target` (tolerating float noise)? */
export const hits = (value, target) => value != null && Math.abs(value - target) < 1e-6;

/**
 * Power-dice correctness, same semantics as the main game: green attached to
 * + or −, blue to × or ÷, red to ^. A fused number made of several dice counts
 * for each of its dice.
 * @returns {number} how many coloured dice are used correctly
 */
export function powerDiceCorrect(leaves, colors) {
  return powerDiceCorrectSet(leaves, colors).size;
}

/** The board indices of the power dice used correctly (see powerDiceCorrect). */
export function powerDiceCorrectSet(leaves, colors) {
  // Counted per DIE, not per use: with Twin Star a blue die used twice is still one
  // power die (sweep review 2026-10-05 — it used to count as 2 of the 3 needed).
  const correct = new Set();
  for (const leaf of leaves) {
    for (const i of leaf.dice) {
      const c = colors[i];
      if ((c === 'green' && (leaf.op === '+' || leaf.op === '-'))
        || (c === 'blue' && (leaf.op === '*' || leaf.op === '/'))
        || (c === 'red' && leaf.op === '^')) correct.add(i);
    }
  }
  return correct;
}

/**
 * Which power dice are used correctly SO FAR, while the equation is still being built
 * (David, 2026-10-11: gold outlines in the equation builder). A half-built equation does not
 * parse, so: close any open brackets, and drop a dangling operator, until it does.
 */
export function correctPowerDice(tokens, values, colors, opts = {}) {
  let t = tokens.slice();
  for (let tries = 0; tries < 4 && t.length; tries++) {
    const open = t.reduce((n, x) => n + (x.t === 'op' && x.v === '(' ? 1 : x.t === 'op' && x.v === ')' ? -1 : 0), 0);
    const closed = open > 0 ? [...t, ...Array.from({ length: open }, () => ({ t: 'op', v: ')' }))] : t;
    const r = evaluateTokens(closed, values, opts);
    if (r.ok) return powerDiceCorrectSet(r.leaves, colors);
    t = t.slice(0, -1);
  }
  return new Set();
}

/** Pretty string for display/share: dice values + operator glyphs. */
export function tokensToString(tokens, values) {
  return tokens.map((t) => (t.t === 'die' ? String(values[t.i]) : DISPLAY[t.v])).join(' ').replace(/(\d) (?=\d)/g, '$1');
}

/** Reverse a positive integer's digits (Mirror Shard: 148 → 841). */
export const reverseDigits = (n) => Number(String(Math.abs(Math.trunc(n))).split('').reverse().join(''));
