// useDuelInvites — live-duel invites while the pilot is in Sector 73 (slice S6 + the S8 minimum,
// 2026-10-20).
//
//   • The switch first: app_settings.sector73_live_battles must read 'on' (re-read every 60 s). Off →
//     nothing here runs and the page shows no live Challenge and no invites (the Colosseum Blitz
//     challenge stays as it was).
//   • Incoming: the server tells me on my personal topic sector73-pilot-<uid> (listen-only; only the
//     server sends). Because a broadcast can be lost, my pending invites are also re-read on entry and
//     every 15 s. Each one shows as a toast with its countdown (room 3 min, friend 10 min) and
//     Accept / Decline.
//   • Outgoing: after I invite, a "Waiting for <pilot>… m:ss · Cancel" pill. The server's
//     accepted / declined / cancelled message ends it, with a 5 s re-read of the row as the safety net.
//   • When a duel is accepted (by me, or by the pilot I invited) `onStart(duelId, opponentName)` opens
//     the battle screen on both phones.
// Members only: Sector 73 is members-only already, and every RPC refuses guests anyway.

import { useCallback, useEffect, useRef, useState } from 'react';
import { supabase } from '@/transport';
import { pilotTopic, DUEL_EVENTS } from './topics';
import { createDuelApi, fetchLiveBattlesOn } from './duelApi';

export const SWITCH_REREAD_MS = 60000;
export const INCOMING_REREAD_MS = 15000;
export const OUTGOING_REREAD_MS = 5000;
const NOTE_MS = 4000;

const END_TEXT = Object.freeze({
  declined: 'declined the duel',
  cancelled: 'cancelled the duel',
  expired: "didn't answer in time",
});

/**
 * @param {{ user: any, onStart: (duelId: string, opponentName: string) => void, api?: import('./duelApi').DuelApi,
 *   client?: any, fetchOn?: () => Promise<boolean>, now?: () => number }} opts
 */
export function useDuelInvites({ user, onStart, api: apiIn, client = supabase, fetchOn = fetchLiveBattlesOn, now = Date.now }) {
  const api = useRef(apiIn ?? null);
  if (!api.current) api.current = createDuelApi(client);
  const uid = user?.id ?? null;
  const member = Boolean(uid) && !user?.is_anonymous;
  const [enabled, setEnabled] = useState(false);
  const [incoming, setIncoming] = useState(/** @type {any[]} */ ([]));
  const [outgoing, setOutgoing] = useState(/** @type {any} */ (null));
  const [note, setNote] = useState(/** @type {string|null} */ (null));
  const [clock, setClock] = useState(() => now());
  const names = useRef(new Map());
  const startRef = useRef(onStart);
  startRef.current = onStart;
  const outRef = useRef(outgoing);
  outRef.current = outgoing;

  const nameOf = useCallback(async (id) => {
    if (!names.current.has(id)) names.current.set(id, await api.current.pilotName(id));
    return names.current.get(id);
  }, []);

  // The switch (and members only).
  useEffect(() => {
    if (!member) { setEnabled(false); return undefined; }
    let alive = true;
    const read = () => fetchOn().then((on) => { if (alive) setEnabled(on); });
    read();
    const t = setInterval(read, SWITCH_REREAD_MS);
    return () => { alive = false; clearInterval(t); };
  }, [member, fetchOn]);

  const addIncoming = useCallback(async (inv) => {
    if (!inv?.duel_id && !inv?.id) return;
    const id = inv.duel_id ?? inv.id;
    const from = inv.from ?? inv.challenger_id;
    const name = await nameOf(from);
    setClock(now()); // the 1 s clock only runs while something shows: start it from now, not from mount
    setIncoming((list) => (list.some((x) => x.duelId === id) ? list : [...list, {
      duelId: id, from, name, style: inv.style, firstTo: inv.first_to, source: inv.source, expiresAt: Date.parse(inv.expires_at), addedAt: now(),
    }]));
  }, [nameOf, now]);
  const dropIncoming = useCallback((id) => setIncoming((list) => list.filter((x) => x.duelId !== id)), []);

  const endOutgoing = useCallback((reason) => {
    const out = outRef.current;
    if (!out) return;
    setOutgoing(null);
    if (reason && END_TEXT[reason]) setNote(`${out.name} ${END_TEXT[reason]}.`);
    else if (reason) setNote(`The duel with ${out.name} was called off.`);
  }, []);

  const startOutgoing = useCallback(() => {
    const out = outRef.current;
    if (!out) return;
    setOutgoing(null);
    startRef.current?.(out.duelId, out.name);
  }, []);

  // My personal topic + the incoming re-read.
  useEffect(() => {
    if (!enabled || !uid) return undefined;
    let alive = true;
    const reread = () => {
      const started = now();
      return api.current.readIncoming(uid).then((r) => {
      if (!alive || !r.data) return;
      const live = new Set(r.data.map((x) => x.id));
      // Drop what the server no longer lists — but not an invite that arrived while this read was in
      // flight (its row may not have been in the answer yet).
      setIncoming((list) => list.filter((x) => live.has(x.duelId) || x.addedAt >= started));
      r.data.forEach((x) => addIncoming(x));
      });
    };
    reread();
    const t = setInterval(reread, INCOMING_REREAD_MS);
    const ch = client.channel(pilotTopic(uid), { config: { private: true } });
    ch.on('broadcast', { event: DUEL_EVENTS.invite }, ({ payload }) => addIncoming(payload));
    ch.on('broadcast', { event: DUEL_EVENTS.accepted }, ({ payload }) => {
      if (outRef.current?.duelId === payload?.duel_id) startOutgoing();
    });
    ch.on('broadcast', { event: DUEL_EVENTS.declined }, ({ payload }) => {
      if (outRef.current?.duelId === payload?.duel_id) endOutgoing('declined');
    });
    ch.on('broadcast', { event: DUEL_EVENTS.cancelled }, ({ payload }) => {
      dropIncoming(payload?.duel_id);
      if (outRef.current?.duelId === payload?.duel_id) endOutgoing(payload?.reason === 'busy' || payload?.reason === 'superseded' ? 'off' : 'cancelled');
    });
    ch.subscribe((status) => { if (status === 'SUBSCRIBED') reread(); });
    return () => { alive = false; clearInterval(t); client.removeChannel(ch); };
  }, [enabled, uid, client, addIncoming, dropIncoming, endOutgoing, startOutgoing, now]);

  // The outgoing safety net: re-read my invite's row every 5 s.
  const outId = outgoing?.duelId ?? null;
  useEffect(() => {
    if (!outId) return undefined;
    const t = setInterval(() => {
      api.current.readDuel(outId).then((r) => {
        const st = r.data?.status;
        if (!st || outRef.current?.duelId !== outId) return;
        if (st === 'accepted' || st === 'live') startOutgoing();
        else if (st !== 'invited') endOutgoing(r.data.end_reason === 'superseded' || r.data.end_reason === 'busy' ? 'off' : st);
      });
    }, OUTGOING_REREAD_MS);
    return () => clearInterval(t);
  }, [outId, startOutgoing, endOutgoing]);

  // Countdowns: a 1 s clock while anything is on screen; expired invites drop out.
  const showing = incoming.length > 0 || Boolean(outgoing);
  useEffect(() => {
    if (!showing) return undefined;
    const t = setInterval(() => {
      const t0 = now();
      setClock(t0);
      setIncoming((list) => (list.some((x) => x.expiresAt <= t0) ? list.filter((x) => x.expiresAt > t0) : list));
      if (outRef.current && outRef.current.expiresAt <= t0) endOutgoing('expired');
    }, 1000);
    return () => clearInterval(t);
  }, [showing, now, endOutgoing]);

  useEffect(() => {
    if (!note) return undefined;
    const t = setTimeout(() => setNote(null), NOTE_MS);
    return () => clearTimeout(t);
  }, [note]);

  /** Invite a pilot. Resolves to null on success, or the reason it was refused. */
  const invite = useCallback(async (pilot, { style, firstTo, source = 'room' }) => {
    const r = await api.current.invite(pilot.uid, style, firstTo, source);
    if (r.error) return r.error;
    names.current.set(pilot.uid, pilot.name);
    const expiresAt = now() + (source === 'friend' ? 10 * 60000 : 3 * 60000);
    setClock(now());
    setOutgoing({ duelId: r.data, uid: pilot.uid, name: pilot.name, style, firstTo, expiresAt });
    return null;
  }, [now]);

  const accept = useCallback(async (inv) => {
    dropIncoming(inv.duelId);
    const r = await api.current.accept(inv.duelId);
    if (r.error) { setNote(r.error); return; }
    if (r.data?.ok) { startRef.current?.(inv.duelId, inv.name); return; }
    setNote(r.data?.status === 'expired' ? 'That invite has expired.' : 'That duel is no longer open.');
  }, [dropIncoming]);

  const decline = useCallback(async (inv) => {
    dropIncoming(inv.duelId);
    await api.current.decline(inv.duelId);
  }, [dropIncoming]);

  const cancelOutgoing = useCallback(async () => {
    const out = outRef.current;
    if (!out) return;
    setOutgoing(null);
    await api.current.cancel(out.duelId);
  }, []);

  /** Back out of an ACCEPTED duel that never went live (the pilot chose to stay in a mode). */
  const cancelDuel = useCallback((duelId) => api.current.cancel(duelId), []);

  return { enabled, incoming, outgoing, note, clock, invite, accept, decline, cancelOutgoing, cancelDuel };
}
