// Which games read `params.entry` ('daily' | 'practice'), the launch contract of the world lane's
// framework (2026-10-22, .workshop/s73-redesign-2026-10/world/framework-tips-powerups.md §D).
//
// A game's grey PRACTICE moon appears on the map ONLY once its game is ready here. Until then the
// game keeps its one object and decides Daily-or-practice by itself, as before. A "no ads,
// practice" moon must never be able to use up a Daily (contrarian review B1).
//
// Flipping a game to `true` is part of merging that game's lane: its mode file must also export
// `ACCEPTS_ENTRY = true`, and world/dailyPairs.test.js checks the two agree.

export const ENTRY_READY = Object.freeze({
  thirtySeven: true, // the 37 round inside Sector 73 reads { mode, entry } since 2026-10-20
  hyperjump: true, // hyperjump lane, merged 2026-10-22
  firstContact: true, // first-contact lane, merged 2026-10-22
  starChart: true, // star-chart lane, merged 2026-10-22
  reEntry: true, // re-entry lane, merged 2026-10-22
});

const DEV_KEY = 'sector73.dev.entryReady';

/**
 * Dev/staging only: localStorage `sector73.dev.entryReady` = 'all' shows every practice moon, so
 * the map can be checked before the game lanes merge. Production builds never read it.
 * @param {boolean} devBuild
 */
export function devShowsAll(devBuild) {
  if (!devBuild) return false;
  try { return globalThis.localStorage?.getItem(DEV_KEY) === 'all'; } catch { return false; }
}

/**
 * Is this game ready for a separate practice object?
 * @param {string | undefined} mode  the Sector 73 mode id
 * @param {{ ready?: Record<string, boolean>, all?: boolean }} [opts]
 */
export function entryReady(mode, { ready = ENTRY_READY, all = false } = {}) {
  if (all) return true;
  return Boolean(mode && ready[mode]);
}
