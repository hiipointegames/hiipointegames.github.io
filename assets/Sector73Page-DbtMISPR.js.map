import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { clearCachedUnlocks } from '../mirror';

// DEV / STAGING BUILDS ONLY (Sector73Page renders it behind IS_DEV_BUILD).
// Re-locking for real needs the 73 row deleted, which a player cannot do (RLS),
// so the full re-lock is `node scripts/staging.mjs relock <email>`; this panel
// clears this device's cache and shows that command.

/** @param {{ onPracticeDuel?: () => void }} props */
export default function DevPanel({ onPracticeDuel = undefined } = {}) {
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);
  const [done, setDone] = useState(false);
  return (
    <div className="absolute z-40 right-3" style={{ top: 'calc(var(--safe-top, 0px) + 62px)' }} onPointerDown={(e) => e.stopPropagation()}>
      <button type="button" onClick={() => setOpen((v) => !v)} className="rounded-md bg-amber-500/80 px-2 py-0.5 text-[10px] font-black text-black">DEV</button>
      {open && (
        <div className="mt-2 w-64 rounded-xl border border-amber-400/60 bg-black/90 p-3 text-[11px] text-amber-100">
          <p className="font-bold">Replay the Mirror unlock</p>
          <ol className="mt-1 list-decimal pl-4 space-y-1">
            <li>Run <code className="text-amber-300">node scripts/staging.mjs relock &lt;email&gt;</code> (deletes your 73 row + today&apos;s attempt).</li>
            <li>Tap below to clear this device&apos;s cached unlock.</li>
          </ol>
          <button
            type="button"
            onClick={() => { clearCachedUnlocks(); setDone(true); }}
            className="mt-2 w-full rounded-md bg-amber-500 py-1 font-bold text-black"
          >
            Clear local unlock cache
          </button>
          {done && <p className="mt-1 text-emerald-300">Cleared. Return to 37 and reload.</p>}
          <button
            type="button"
            data-testid="dev-spike-3d"
            onClick={() => navigate('/Sector73?spike=3d')}
            className="mt-2 w-full rounded-md border border-amber-400 py-1 font-bold text-amber-200"
          >
            Run 3D frame-rate spike (W1)
          </button>
          {onPracticeDuel && (
            <button
              type="button"
              data-testid="dev-practice-duel"
              onClick={() => { setOpen(false); onPracticeDuel(); }}
              className="mt-2 w-full rounded-md border border-fuchsia-400 py-1 font-bold text-fuchsia-200"
            >
              Practice duel vs computer (live battles S4)
            </button>
          )}
        </div>
      )}
    </div>
  );
}
