/** @type {WorldObject[]} */
export const WORLD_OBJECTS = LAYOUT.map((o) => ({ ...o, x: Math.round(o.x * SPREAD), y: Math.round(o.y * SPREAD) }));

/** Look up an object by id. */
export const objectById = (id) => WORLD_OBJECTS.find((o) => o.id === id) || null;

/** The mode an object opens (a practice moon's game), or undefined for routes / the Mirror. */
const modeOf = (o) => (o.launch.type === 'sector' ? o.launch.mode : undefined);

/**
 * The objects the map shows: every object, except a practice moon whose game doesn't read
 * `params.entry` yet (./entryReady.js). Computed once per page, so the canvas never restarts.
 * @param {(mode: string | undefined) => boolean} isReady
 * @param {WorldObject[]} [objects]
 */
export const visibleObjects = (isReady, objects = WORLD_OBJECTS) =>
  objects.filter((o) => !o.practiceOf || isReady(modeOf(o)));

/** Sector 73 mode ids that a registry entry can launch. */
export const SECTOR_MODES = ['hyperjump', 'firstContact', 'starChart', 'reEntry', 'starMarket', 'thirtySeven'];
