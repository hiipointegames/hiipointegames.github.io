import React from 'react';
import { SolvedEquation } from '@/equation-display';
import { formatDuelTime } from './formatDuelTime';

// Between rounds (interview: "the winning equation shown after each round"): who took the
// round, how fast, and the equation that won it, power dice in their colours.

/** @param {{ last: import('./duelReducer').RoundResult, colors: readonly string[], opponentName: string }} props */
export default function RoundReveal({ last, colors, opponentName }) {
  const who = last.by === 'me' ? 'You take it' : last.by === 'cpu' ? `${opponentName} takes it` : 'Void round';
  const time = last.ms != null ? ` in ${formatDuelTime(last.ms)}` : '';
  return (
    <div data-testid="duel-reveal" data-by={last.by ?? 'none'} className="mx-auto w-full max-w-md rounded-2xl border border-violet-300/40 bg-[#0b0820]/90 p-5 text-center text-white" style={{ boxShadow: '0 0 40px -14px #a855f7' }}>
      <div className="text-[10px] font-bold uppercase tracking-[0.3em] text-violet-300/80">Round {last.round}</div>
      <div className={`mt-1 text-xl font-black ${last.by === 'me' ? 'text-emerald-300' : last.by === 'cpu' ? 'text-rose-300' : 'text-slate-200'}`}>{who}{time}</div>
      {last.equation ? (
        <div data-testid="duel-reveal-equation" className="mt-3 break-words text-2xl font-black tracking-wide">
          <SolvedEquation equation={last.equation} usedIndices={last.usedIndices} colors={colors} />
          <span className="whitespace-nowrap text-amber-300"> = 37</span>
        </div>
      ) : (
        <p className="mt-2 text-sm text-slate-300">Nobody cracked it in 90 s. Fresh dice next.</p>
      )}
    </div>
  );
}
