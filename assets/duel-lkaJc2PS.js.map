import React, { useEffect, useRef, useState } from 'react';
import { drawShip, readSavedLook, DEFAULT_LOOK } from '../../world/shipArt';
import { createShake } from '../../fx';

// The real ships on the battle screen (live battles S5): the same drawShip the world and the
// Star Market hangar use, so a pilot duels in exactly the ship they fly.
//
//   • You: your own look (Star Market loadout). Sector73Page saves it on the phone the moment the
//     account's loadout loads (saveLook), and the hangar announces changes on 'sector73:look', so
//     this reads the saved look and follows that event — no extra fetch. A bought skin's image
//     loads from Storage; until it has (or offline) drawShip draws the vector hull instead.
//   • The computer pilots: fixed looks, one per speed, vector only (no image, so they work offline).
//
// The losing ship's hit: the shared trauma shake (fx/shake.js) moves the ship inside its canvas,
// with a red flash behind it (duel.css). Under reduced motion there is no movement at all, only
// the flash. The vibration is DuelMode's (fx/haptics.js; a no-op on web).
//
// Cost (S5 review): each ship is one timer loop at 30 fps (4 fps under reduced motion) that is
// paused while the page is hidden and stopped on unmount; the canvas size is cached; and a ship
// whose paint is slow on this phone drops its glow (shadowBlur).

/** @typedef {import('../../world/shipArt').Look} Look */

const cpuLook = (patch) => Object.freeze({ ...DEFAULT_LOOK, ...patch, trail: Object.freeze({ colors: patch.trail, sparkle: false }) });

/** The computer pilots' fixed looks: Cadet a green scout, Ace an amber arrow, Legend a crimson stingray that pulses. */
export const CPU_LOOKS = Object.freeze({
  cadet: cpuLook({ shape: 'scout', hull: ['#166534', '#86efac', '#14532d'], glow: '#22c55e', trim: '#bbf7d0', trail: ['#4ade80'] }),
  ace: cpuLook({ shape: 'arrow', hull: ['#9a3412', '#fdba74', '#7c2d12'], glow: '#f97316', trim: '#fed7aa', trail: ['#fb923c'] }),
  legend: cpuLook({ shape: 'stingray', hull: ['#881337', '#fda4af', '#4c0519'], glow: '#e11d48', trim: '#fecdd3', trail: ['#f43f5e'], legendary: true }),
});

/** Which way each side points: you (bottom-left) nose up and toward the opponent; they (top-right) nose down toward you. */
export const SHIP_ANGLE = Object.freeze({ me: -Math.PI / 2 + 0.35, cpu: Math.PI / 2 + 0.35 });

/**
 * The canvas is OVERSCAN × the ship box and centred on it, so the engine flame, the Legend's pulse
 * and the shake never clip at the box edge (S5 review: the Legend's tail was cut off at 64 px).
 * The ship itself stays the same size: VIEW_UNITS ship units span the whole (bigger) canvas.
 * The biggest reach from the centre is the flame, ~36 units at full thrust (shipArt drawShip).
 */
export const OVERSCAN = 1.5;
export const VIEW_UNITS = 96;
/** How hard a hit shakes the losing ship (trauma 0..1; the visible shake is trauma²). */
export const HIT_TRAUMA = 0.9;
/** The shake inside the ship box is smaller than the screen-shake default. */
export const SHIP_SHAKE = Object.freeze({ maxOffset: 5, maxRotate: 8, decay: 1.4 });

/** Frame spacing: ~30 fps normally, 4 fps under reduced motion (nothing moves; it only picks up a
 *  skin image once it has loaded). The loop is a timer at this rate, not a display-rate rAF. */
export const FRAME_MS = 33;
export const FRAME_MS_STILL = 250;
/** If a ship's paint averages more than this (ms), its glow (shadowBlur, the costly canvas op on
 *  Android Chrome) is switched off for the rest of the duel. Judged after GLOW_SAMPLE frames. */
export const GLOW_BUDGET_MS = 2.5;
export const GLOW_SAMPLE = 8;

/** Your look: the saved Star Market look (defaults if nothing is saved). */
export const myLook = () => readSavedLook();

/**
 * Paint one frame. Pure over the canvas context, so it is testable with a fake one.
 * @param {CanvasRenderingContext2D} g
 * @param {{ size: number, dpr: number, side: 'me' | 'cpu', look: Look, time: number, glow?: boolean,
 *   offset?: { x: number, y: number, rotate: number } }} frame
 */
export function paintDuelShip(g, { size, dpr, side, look, time, glow = true, offset = { x: 0, y: 0, rotate: 0 } }) {
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
  g.clearRect(0, 0, size, size);
  g.save();
  g.translate(size / 2 + offset.x, size / 2 + offset.y);
  g.rotate((offset.rotate * Math.PI) / 180);
  drawShip(g, { angle: SHIP_ANGLE[side], thrust: 0.4 + Math.sin(time * 3) * 0.12 }, size / VIEW_UNITS, time, look, { glow });
  g.restore();
}

/** Start the hit: returns true if the ship shakes (false under reduced motion: flash only). */
export function startHit(shake, reducedMotion) {
  if (reducedMotion) return false;
  shake.add(HIT_TRAUMA);
  return true;
}

/**
 * The frame loop: a timer at `every` ms (so it wakes only when it will draw), paused while the
 * page is hidden, stopped for good by the returned function (unmount).
 * @param {{ every: number, frame: (dt: number) => void, doc?: Document,
 *   schedule?: (fn: () => void, ms: number) => any, cancel?: (h: any) => void, now?: () => number }} opts
 * @returns {() => void} stop
 */
export function runShipLoop({
  every, frame, doc = globalThis.document,
  schedule = (fn, ms) => setTimeout(fn, ms), cancel = (h) => clearTimeout(h), now = () => globalThis.performance?.now?.() ?? Date.now(),
}) {
  let handle = null;
  let last = 0;
  let stopped = false;
  const tick = () => {
    handle = null;
    if (stopped || doc?.hidden) return;
    const t = now();
    const dt = last ? Math.min(0.05, (t - last) / 1000) : 0;
    last = t;
    frame(dt);
    if (!stopped) handle = schedule(tick, every);
  };
  const onVis = () => {
    if (doc.hidden) { if (handle != null) cancel(handle); handle = null; last = 0; }
    else if (handle == null && !stopped) handle = schedule(tick, 0);
  };
  doc?.addEventListener?.('visibilitychange', onVis);
  handle = schedule(tick, 0);
  return () => {
    stopped = true;
    if (handle != null) cancel(handle);
    handle = null;
    doc?.removeEventListener?.('visibilitychange', onVis);
  };
}

/** Tracks paint cost; turns the glow off (for good) once the average is over budget. */
export function createGlowBudget({ budgetMs = GLOW_BUDGET_MS, sample = GLOW_SAMPLE } = {}) {
  let n = 0; let total = 0; let glow = true;
  return {
    get glow() { return glow; },
    record(ms) {
      if (!glow) return;
      n += 1; total += ms;
      if (n >= sample && total / n > budgetMs) glow = false;
    },
  };
}

/**
 * @param {{ side: 'me' | 'cpu', look: Look, lookId: string, hit?: boolean, reducedMotion?: boolean,
 *   paint?: typeof paintDuelShip, loop?: typeof runShipLoop, now?: () => number }} props
 */
export function DuelShip({ side, look, lookId, hit = false, reducedMotion = false, paint = paintDuelShip, loop = runShipLoop, now = undefined }) {
  const ref = useRef(null);
  const state = useRef({ look, shake: createShake(SHIP_SHAKE), t: 0, size: 0, budget: createGlowBudget() });
  state.current.look = look;

  useEffect(() => {
    if (hit) startHit(state.current.shake, reducedMotion);
  }, [hit, reducedMotion]);

  // The canvas size, cached: read once, then kept up to date by a ResizeObserver (never read per frame).
  useEffect(() => {
    const c = ref.current;
    if (!c) return undefined;
    const s = state.current;
    s.size = c.clientWidth || 0;
    if (typeof ResizeObserver === 'undefined') return undefined;
    const ro = new ResizeObserver((entries) => { s.size = entries[0]?.contentRect?.width || s.size; });
    ro.observe(c);
    return () => ro.disconnect();
  }, []);

  useEffect(() => {
    const c = ref.current;
    const g = c?.getContext?.('2d');
    if (!c || !g) return undefined; // no canvas (tests): the box and its flash still render
    const s = state.current;
    const clock = now ?? (() => globalThis.performance?.now?.() ?? Date.now());
    return loop({
      every: reducedMotion ? FRAME_MS_STILL : FRAME_MS,
      now: clock,
      frame: (dt) => {
        s.t += dt;
        const size = s.size || 96;
        const dpr = Math.min(2, globalThis.devicePixelRatio || 1);
        const px = Math.round(size * dpr);
        if (c.width !== px) { c.width = px; c.height = px; }
        const off = s.shake.step(s.t, dt);
        const t0 = clock();
        paint(g, { size, dpr, side, look: s.look, time: reducedMotion ? 0 : s.t, glow: s.budget.glow, offset: off });
        s.budget.record(clock() - t0);
        c.dataset.glow = s.budget.glow ? 'on' : 'off';
      },
    });
  }, [side, reducedMotion, paint, loop, now]);

  return <canvas ref={ref} data-testid={`duel-ship-canvas-${side}`} data-look={lookId} aria-hidden="true" className="s73-duel-ship-canvas" />;
}

/** Your saved look, following the hangar's 'sector73:look' event while the duel is open. */
export function useMyLook() {
  const [look, setLook] = useState(myLook);
  useEffect(() => {
    const onLook = (e) => { if (e?.detail) setLook({ ...DEFAULT_LOOK, ...e.detail }); };
    globalThis.addEventListener?.('sector73:look', onLook);
    return () => globalThis.removeEventListener?.('sector73:look', onLook);
  }, []);
  return look;
}
