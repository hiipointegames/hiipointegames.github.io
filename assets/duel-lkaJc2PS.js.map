// The one formatter for every time shown in the duel flow after the round clock (David,
// 2026-10-20: "live-battle times in hundredths everywhere"): the round reveal ("You take it in
// 9.12 s", "<pilot> takes it in …") and the result card's fastest round.
//
// Why not the 37 game's formatSolveTime (@/ui/feedback)? Its default style TRUNCATES hundredths
// into M:SS.HH (documented policy for daily solve times), and its 'suffix' style rounds with a
// bare toFixed, which inherits binary-float error: (1.005).toFixed(2) is "1.00". The duel wants
// seconds with a unit, rounded half-up, so 9005 ms is "9.01 s", never "9.00" or "9.0".
//
// Rounds void at 90 s, so a time never needs minutes: 75500 ms is "75.50 s".

/**
 * Milliseconds → "S.HH s", rounded half-up to the hundredth.
 * The ms value is snapped to 6 decimals of hundredths first so float noise from a
 * performance.now() difference cannot push a half one way or the other.
 * @param {number} ms
 * @returns {string} '' for a missing or non-finite time; negatives clamp to 0.
 */
export function formatDuelTime(ms) {
  if (ms == null || !Number.isFinite(ms)) return '';
  const hundredths = Math.floor(Number((Math.max(0, ms) / 10).toFixed(6)) + 0.5);
  const secs = Math.floor(hundredths / 100);
  return `${secs}.${String(hundredths % 100).padStart(2, '0')} s`;
}
