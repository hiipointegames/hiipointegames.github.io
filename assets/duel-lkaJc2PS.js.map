// The phone's pre-check (design-v2 D2.1): the main game's own win gate, asked before an answer
// is offered to the referee. Against the computer it IS the check; in a live duel (S6) only an
// answer that passes is sent to the server, which re-checks it. A typo never costs a call.
//
// The power-dice rule takes the style as its mode, so Challenge needs 2 of 3 power dice used
// correctly — the same mode argument HeadToHeadGame passes (an omitted mode is the legacy rule).

import { evaluateEquation, collectDraftErrors, isSubmittableSolution, validateChallengeModeRules } from '@/equation-engine';

/**
 * @param {{ equation: string, usedDiceIndices: number[], dice: number[], colors: readonly string[], style: string }} answer
 * @returns {{ ok: boolean, reason: null | 'incomplete' | 'draft' | 'not37' | 'power' }}
 */
export function precheck({ equation, usedDiceIndices, dice, colors, style }) {
  const board = dice.map((value, idx) => ({ value, color: colors[idx] || 'white', originalIndex: idx, id: idx }));
  const { valid, result } = evaluateEquation(equation, usedDiceIndices, board);
  const draftErrors = collectDraftErrors(equation, usedDiceIndices);
  const challengeRulesMet = style === 'easy' ? true : validateChallengeModeRules(equation, usedDiceIndices, dice, [...colors], style);
  if (isSubmittableSolution({ valid, result, usedDiceIndices, challengeRulesMet, draftErrors })) return { ok: true, reason: null };
  if (usedDiceIndices.length !== 7) return { ok: false, reason: 'incomplete' };
  if (draftErrors.length > 0 || !valid) return { ok: false, reason: 'draft' };
  if (result !== 37) return { ok: false, reason: 'not37' };
  return { ok: false, reason: 'power' };
}
