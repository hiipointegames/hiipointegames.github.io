import React, { useCallback, useState } from 'react';
import { DailyChallengeGame } from '@/daily-challenge';
import { useEquationDraft } from '@/equation-draft';
import { precheck } from './precheck';

// The duel's dice board: the main game's board (DailyChallengeGame) UNCHANGED, fully controlled
// from here — the same composition HeadToHeadGame uses (useEquationDraft), without its clock,
// its writes or its 800-line file (structure-v2 §S4).
//
// No Roll New Dice and no Shuffle: everyone races the same dice in the same order. No onExit
// either — leaving lives on the battle screen's strip, which also keeps the board's practice
// "Solved" counter off. `themeMode="blitz-battle"` gives the "Easy Battle" / "Challenge Battle"
// label and the magenta accent duel.css re-skins.
//
// Mount it with key={round}: a new round is a fresh draft.
//
// Submit goes through the pre-check first; only a passing answer reaches onSolve. The board's
// own Submit button is already gated on the same rule, so this is defence in depth.

/**
 * `label` (world lane 2026-10-22, D6-A): a practice duel against the computer names its opponent and
 * the dice ("VS ACE · EASY DICE") instead of 37's Blitz label ("EASY BATTLE" read as if the OPPONENT
 * were easy). Only the label's text changes, by CSS on this board (duel.css); the main game's board
 * is untouched, and a live duel passes no label, so it keeps its own.
 * @param {{ dice: number[], colors: readonly string[], style: 'easy' | 'challenge' | 'expert', elapsedSeconds: number,
 *   onSolve: (answer: { equation: string, usedIndices: number[] }) => void, label?: string }} props
 */
export default function DuelBoard({ dice, colors, style, elapsedSeconds, onSolve, label = undefined }) {
  const { equation, usedDiceIndices, cursorPosition, clickDie, insertOperator, deleteAtCursor, clear, setCursor } = useEquationDraft(dice);
  const [ruleError, setRuleError] = useState(false);

  const onOperatorClick = useCallback((op) => { insertOperator(op); }, [insertOperator]);

  // The pre-check (design-v2 D2.1). In a live duel (S6) this is the gate in front of the server call.
  const onSubmit = useCallback(() => {
    const check = precheck({ equation, usedDiceIndices, dice, colors, style });
    if (!check.ok) {
      if (check.reason === 'power') { setRuleError(true); setTimeout(() => setRuleError(false), 3000); }
      return;
    }
    onSolve({ equation, usedIndices: [...usedDiceIndices] });
  }, [equation, usedDiceIndices, dice, colors, style, onSolve]);

  return (
    <div className="s73-duel-board" data-testid="duel-board" data-style={style} data-dice={dice.join(',')}
      data-duel-kind={label ? 'practice' : undefined} data-duel-label={label}
      style={label ? /** @type {any} */ ({ '--duel-label': JSON.stringify(label) }) : undefined}>
      <DailyChallengeGame
        dice={dice}
        diceColors={colors}
        equation={equation}
        usedDiceIndices={usedDiceIndices}
        solved={false}
        dailyChallengeTimer={elapsedSeconds}
        onDiceClick={clickDie}
        onOperatorClick={onOperatorClick}
        onDelete={deleteAtCursor}
        onClear={clear}
        onSubmit={onSubmit}
        showColorRuleError={ruleError}
        shakeButton={false}
        showTryAgain={ruleError}
        mode={style}
        themeMode="blitz-battle"
        cursorPosition={cursorPosition}
        onCursorPositionChange={setCursor}
        onExit={undefined}
        onRollNewDice={undefined}
        onShuffle={undefined}
        shuffledDice={undefined}
      />
    </div>
  );
}
