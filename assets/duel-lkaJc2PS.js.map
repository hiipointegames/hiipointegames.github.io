import React from 'react';
import ScorePips from './ScorePips';
import { DuelShip } from './DuelShips';
import { DEFAULT_LOOK } from '../../world/shipArt';

// One side of the battle screen: the pilot's ship, name and round pips. The opponent sits at
// the top with its ship on the right pointing down; you sit at the bottom with your ship on
// the left pointing up — the two ships face each other across the dice (interview: "ships
// facing each other, dice in the middle").
//
// The ship is the pilot's real ship (DuelShips.jsx over drawShip; S5). `hit` plays the losing
// ship's hit: the shared trauma shake inside the canvas + a red flash behind it, or under reduced
// motion the flash only (no movement at all).

/** @param {{ side: 'me' | 'cpu', name: string, caption?: string, wins: number, firstTo: number, hit?: boolean, reducedMotion?: boolean,
 *   look?: import('../../world/shipArt').Look, lookId?: string, children?: React.ReactNode }} props */
export default function PilotStrip({ side, name, caption = undefined, wins, firstTo, hit = false, reducedMotion = false, look = DEFAULT_LOOK, lookId = 'default', children = null }) {
  const hitClass = hit ? (reducedMotion ? ' is-hit-still' : ' is-hit') : '';
  const ship = (
    <div data-testid={`duel-ship-${side}`} data-hit={hit ? 'true' : 'false'} className={`s73-duel-ship s73-duel-ship--${side}${hitClass}`}>
      <DuelShip side={side} look={look} lookId={lookId} hit={hit} reducedMotion={reducedMotion} />
    </div>
  );
  const label = (
    <div className={`min-w-0 flex-1 ${side === 'cpu' ? 'text-right' : ''}`}>
      <div className="truncate text-sm font-black text-white" data-testid={`duel-name-${side}`}>{name}</div>
      {caption && <div className="s73-duel-caption truncate text-[10px] uppercase tracking-[0.2em] text-violet-300/80">{caption}</div>}
      <div className={`mt-1 flex ${side === 'cpu' ? 'justify-end' : ''}`}>
        <ScorePips wins={wins} firstTo={firstTo} tone={side} testId={`duel-pips-${side}`} />
      </div>
    </div>
  );
  return (
    <div data-testid={`duel-strip-${side}`} className={`s73-duel-strip s73-duel-strip--${side} flex items-center gap-3 px-3 py-2`}>
      {side === 'me' ? <>{ship}{label}{children}</> : <>{children}{label}{ship}</>}
    </div>
  );
}

