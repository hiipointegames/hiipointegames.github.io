import React from 'react';

// Round-win pips (interview: "round-win pips / score bar"): one pip per win needed, filled as
// the pilot takes rounds. First to 10 still fits a 360 px strip (10 × 10 px + gaps).

/** @param {{ wins: number, firstTo: number, tone?: 'me' | 'cpu', testId?: string }} props */
export default function ScorePips({ wins, firstTo, tone = 'me', testId = undefined }) {
  const filled = Math.max(0, Math.min(wins, firstTo));
  return (
    <div className="flex items-center gap-1" data-testid={testId} data-wins={filled} role="img" aria-label={`${filled} of ${firstTo} rounds won`}>
      {Array.from({ length: firstTo }, (_, i) => (
        <span key={i} data-filled={i < filled ? 'true' : 'false'} className={`s73-duel-pip s73-duel-pip--${tone}${i < filled ? ' is-filled' : ''}`} />
      ))}
    </div>
  );
}
