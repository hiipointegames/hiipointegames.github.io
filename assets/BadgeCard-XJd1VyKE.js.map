import React from 'react';

import BadgeFrame from './BadgeFrame';
import BadgeProgressBar from './BadgeProgressBar';
import { tierLabel, modeAccentVar, badgeModeTheme, tierRarityVar, currentTierIndex, isSilhouetted, isTieredBadge } from './badgeVisuals';
import { badgeProgress, badgeRungSummary, isBadgeEarned } from './badgeShowcaseModel';

// BadgeCard — one tile in the L2 showcase grid (Lane F, §9.2).
//
// The enhanced descendant of MilestoneBadge: same earned-glow / locked-ghost
// colour language (full neon vs the same hue deeply dimmed — never grey), plus
// a category-encoding frame (BadgeFrame, Lane E) and a progress rail so a locked
// card reads as a GOAL.
//
// COLOUR — THE OUTLINE IS ALWAYS MODE (Round 2 § D1, unchanged since). The card
// is the OUTER ring and it belongs to MODE: border, background ramp and glow all
// take the badge's mode accent (Daily cyan · Challenge cyan · Easy green ·
// Solo Blitz blue · Blitz Battle magenta), which is the "grouped theme outline"
// that makes a tab read as one family.
//
// What the medal INSIDE that outline wears is decided per badge by R2-G (David,
// 2026-08-02): a TIERED badge's medal is its TIER colour, so the rung you are
// standing on is visible at a glance across a whole grid; a ONE-TIME badge, which
// has no rung, keeps its own identity colour. `badgeMedalAxis` in ./badgeVisuals
// owns that rule and BadgeFrame paints it. The card's own job is unchanged: the
// outline stays mode, and the tier CAPTION below the name stays rarity.
//
// NO DAILY/PRACTICE TREATMENT (removed Round 2, David 2026-08-01). A craft feat
// is still two collectibles, but since Badges Phase 2 the twins live on separate
// mode TABS — so a gold DAILY ribbon and a muted PRACTICE tag were re-stating
// what the tab already said. The tab and the mode outline carry it now. That
// also freed gold, which was only ever the twin marker; gold is now reserved for
// `--u37-tier-6`, the top RARITY stop, where it means something.
//
// A LADDERED badge renders as ONE card showing the tier the player is standing
// on — tapping opens the L3 detail modal with the full tier carousel (Lane E).
//
// PROPS-ONLY and PLAYER-AGNOSTIC. It never reads the signed-in user: the same
// card renders on your stats page and on another player's.

/**
 * @param {Object} props
 * @param {import('@/game-mechanics/badgeRegistry').Badge} props.badge
 * @param {import('./badgeVisuals').BadgeState} [props.state] Derived state (Lanes B/D); absent = unearned.
 * @param {(badge: import('@/game-mechanics/badgeRegistry').Badge) => void} [props.onSelect]
 */
export default function BadgeCard({ badge, state, onSelect }) {
  if (!badge) return null;

  const earned = isBadgeEarned(state);
  const silhouette = isSilhouetted(badge, state);
  const tierIdx = currentTierIndex(badge, state);
  const rarityHue = tierRarityVar(badge, tierIdx);
  // ONE flag for "this badge has rungs", shared with BadgeFrame's medal-colour
  // decision (see `isTieredBadge`). It gates BOTH the tier caption and the ×N
  // count pill — they are the same question asked twice, and letting them drift
  // apart is exactly what produced the "First Solve ×121" bug.
  const laddered = isTieredBadge(badge);
  const count = Number.isFinite(state?.count) ? /** @type {number} */ (state?.count) : 0;

  // THE PROGRESS RAIL IS NOT GATED ON `earned` (fixed 2026-09-04).
  //
  // It used to read `earned ? null : badgeProgress(...)`, which meant EARNING a
  // badge DELETED the only thing on the card that said where you stood. Measured
  // on staging: all six earned cards rendered zero progress and all ten unearned
  // cards rendered it, so an earned badge told you strictly LESS than a locked
  // one. That is precisely backwards, and it is the mechanical half of David's
  // "I cant tell what i have accomplished for most of them".
  //
  // `badgeProgress` already returns null for the two cases where a rail would be
  // a lie — one-time badges, and a ladder with nothing left to chase — so the
  // gate was never what kept those clean. A maxed ladder is captioned "Complete"
  // below instead of falling back to a blank.
  const progress = badgeProgress(badge, state);
  const rung = badgeRungSummary(badge, state);

  // The badge's own MODE drives the card's OUTLINE — read from `badge.mode`
  // rather than the active tab so a card is the right colour anywhere it renders
  // (a tab, the hero, a featured strip). The ramp is deliberately restrained
  // (20%→8%): it is a backdrop for the identity-coloured medal, not a second
  // thing competing for attention. Locked cards keep the accent at a whisper so
  // a section still reads as one flow of colour.
  const accent = modeAccentVar(badge.mode);
  const cardStyle = earned
    ? {
        background: `linear-gradient(160deg, color-mix(in srgb, ${accent} 20%, #05030f) 0%, color-mix(in srgb, ${accent} 8%, #05030f) 100%)`,
        borderColor: `color-mix(in srgb, ${accent} 60%, transparent)`,
        boxShadow: `0 0 22px -10px ${accent}, 0 4px 12px rgba(0,0,0,0.35)`,
      }
    : {
        background: `color-mix(in srgb, ${accent} 6%, #0b0b18)`,
        borderColor: `color-mix(in srgb, ${accent} 18%, transparent)`,
        boxShadow: '0 2px 8px rgba(0,0,0,0.25)',
      };

  // THE LABEL CARRIES THE ACHIEVEMENT, not just the fact of it (2026-09-04).
  //
  // It used to be `${name}, earned` — which is the same sentence for a player on
  // rung 1 of 7 and a player who has finished all seven. Anyone reading the card
  // through the label rather than the pixels (a screen reader, an assertion, a
  // snapshot) got no answer at all to "what have I done here".
  const label = (() => {
    if (silhouette) return 'Hidden badge, not yet earned';
    const state_ = earned ? 'earned' : 'not earned yet';
    const parts = [`${badge.name}, ${state_}`];
    if (rung.laddered && rung.position > 0) {
      parts.push(rung.maxed
        ? `all ${rung.total} rungs complete`
        : `rung ${rung.position} of ${rung.total}, ${tierLabel(badge, tierIdx, state?.durationSeconds)}`);
    }
    if (progress) parts.push(`next: ${progress.nextLabel}`);
    return parts.join(', ');
  })();

  // `data-accent` / `data-identity` / `data-rarity` state all THREE colour axis
  // VALUES on the element: which mode painted the card's outline, the badge's own
  // identity colour, and which rarity stop the caption sits on. `data-accent` is
  // the only one the CARD itself paints with — it mirrors the inline styles
  // exactly, which matters because the style string is not assertable (the test
  // DOM's CSS parser drops any declaration containing `color-mix()`). Which of
  // identity/rarity actually reaches the MEDAL is BadgeFrame's call and is
  // reported there as `data-medal-axis`.
  return (
    <button
      type="button"
      data-testid="badge-card"
      data-badge-id={badge.id}
      // THE THEME NAME, not the registry key. `data-mode` is the theming
      // attribute tokens.css keys `--u37-mode-accent` off, and its vocabulary is
      // THEME NAMES; `badge.mode` is a REGISTRY key. The two agree on 'easy',
      // 'challenge' and 'daily' and disagree everywhere else, so passing the raw
      // key straight through both leaked an internal identifier into the DOM and
      // put `data-mode="soloBlitz"` -- which matches no rule -- on every Solo
      // Blitz card. See `badgeModeTheme`.
      data-mode={badgeModeTheme(badge.mode)}
      data-accent={accent}
      data-identity={badge.identity?.css ?? ''}
      data-rarity={rarityHue}
      data-earned={earned ? 'true' : 'false'}
      aria-label={label}
      onClick={() => onSelect?.(badge)}
      style={cardStyle}
      className="relative flex flex-col items-center text-center rounded-2xl border-2 p-2.5 pt-3 transition-transform active:scale-[0.97]"
    >
      {/* No DAILY ribbon / PRACTICE tag here any more — the mode TAB a card sits
          on already says which of a twin pair it is, so the badges wore a label
          restating their own address. Removed Round 2 (David, 2026-08-01). */}

      <BadgeFrame badge={badge} state={state} size="sm" />

      <p
        data-testid="badge-card-name"
        className="mt-1.5 text-[11px] font-black leading-tight line-clamp-2"
        style={{ color: silhouette ? 'var(--u37-muted)' : earned ? 'var(--u37-text)' : 'var(--u37-muted)' }}
      >
        {silhouette ? '???' : badge.name}
      </p>

      {/* WHICH RUNG YOU'RE STANDING ON, AND OUT OF HOW MANY.
          The denominator is the addition: "Spark" alone does not tell a player
          they are 1 of 7 up a ladder, so the card looked identical whether they
          had just started Full Spectrum or nearly finished it. Captioned in the
          RARITY hue — frame = mode, this + the frame's inner glow = rarity. */}
      {earned && laddered && !silhouette && (
        <p data-testid="badge-card-tier" className="mt-0.5 text-[9px] font-bold uppercase tracking-wide" style={{ color: rarityHue }}>
          {tierLabel(badge, tierIdx, state?.durationSeconds)} · {rung.position} of {rung.total}
        </p>
      )}

      {progress && !silhouette && <BadgeProgressBar progress={progress} hue={accent} className="mt-1.5" />}

      {/* A FINISHED LADDER SAYS SO. `badgeProgress` returns null once there is
          nothing left to chase, which under the old `earned ? null` gate was
          indistinguishable from the blank every earned card rendered. Stating it
          is the difference between "this card is done" and "this card is
          broken". */}
      {earned && rung.maxed && !silhouette && (
        <p data-testid="badge-card-complete" className="mt-1.5 text-[10px] font-black uppercase tracking-wide" style={{ color: rarityHue }}>
          Complete
        </p>
      )}

      {/* THE ×N PILL — laddered badges only (R2-G, David's device testing of beta
          1.0.289). A one-time badge counting its repeats is self-contradictory:
          the Easy tab was showing "First Solve ×121", and awarding a FIRST solve
          121 times says the opposite of what the badge is for. The same card
          already computed `laddered` and used it for the tier caption; the pill
          simply did not consult it.

          Gated on the derived `isTieredBadge`, never on a list of badge ids, so
          a one-time badge added later inherits the rule. `BadgeCard.test.jsx`
          walks the WHOLE catalog and asserts no one-time badge can render this
          pill at any count. */}
      {earned && laddered && count > 1 && (
        <span
          data-testid="badge-card-count"
          className="absolute -top-1.5 -right-1.5 min-w-[22px] h-[22px] px-1 rounded-full flex items-center justify-center text-[10px] font-black border-2"
          style={{ background: accent, color: '#050310', borderColor: 'rgba(255,255,255,0.35)' }}
        >
          ×{count}
        </span>
      )}
    </button>
  );
}
