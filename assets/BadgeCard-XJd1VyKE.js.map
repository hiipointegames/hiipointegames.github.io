import React, { useCallback, useEffect, useRef, useState } from 'react';
import { createPortal } from 'react-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { X, HelpCircle } from 'lucide-react';

import { badgeTierCount } from '@/game-mechanics';
import BadgeFrame from './BadgeFrame';
import BadgeTierCarousel from './BadgeTierCarousel';
import {
  modeLabel,
  hiddenHint,
  isSilhouetted,
  isRetroactive,
  formatEarnedDate,
  tierLabel,
  tierCriteriaText,
  tierRarityVar,
  currentTierIndex,
} from './badgeVisuals';

// BadgeDetailModal — L3 of the badge drill-down (Lane E, §9.3).
//
// Tap any badge in the showcase → this. Big cosmic art, the earned date OR the
// "Earned Retroactively" ribbon with its `?` explainer, the exact criteria in
// plain English, and the tier carousel for laddered badges.
//
// The criteria are TIER-SPECIFIC: this component owns the viewed rung and feeds
// it to both the carousel (controlled) and `tierCriteriaText`, so "How to earn
// Tier 2 of 4" reads "past 1,000" rather than dumping the whole ladder at once.
//
// PROPS-ONLY. It takes the registry definition (Lane C) + the derived state
// object (Lanes B/D) and renders. It does not fetch, and it does not decide
// whether a badge is earned — that is the derivation lane's job. Every prop is
// optional so a partial state (or a badge with no state yet) renders safely.
//
// CROSS-PLAYER, like its two hosts. BadgeShowcase and FeaturedBadges both render
// another player's case, so this modal opens over someone else's badge just as
// often as your own. It takes `isOwnStats` / `playerName` from whichever host
// mounted it and never reads the signed-in user; the one piece of copy written
// in the second person (the retroactive explainer) switches voice off that.
//
// A11y: portalled to <body>, `role="dialog"` + `aria-modal`, labelled by the
// badge name, Escape closes, backdrop click closes, focus moves in on open and
// is trapped inside while open, and returns to the trigger on close. The app's
// other overlays do Escape (FriendsScreen) and body-scroll lock
// (DailyChallengeModal) but not focus management — this adds it here rather than
// editing those (Lane E is new-files-only).

const FOCUSABLE = 'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

/**
 * The "Earned Retroactively" `?` explainer, in the voice of whoever is being
 * VIEWED. The showcase is player-parameterized — the same modal opens over
 * another player's badges from `Statistics?id=` and the OtherProfile card — so
 * the second-person copy this shipped with told a viewer "You earned this"
 * about a stranger's achievement. The ribbon LABEL is a fact about the badge and
 * stays put; only this body changes voice.
 *
 * Third person uses they/them: the app stores no pronouns, and a display name is
 * not one.
 *
 * @param {boolean} isOwnStats
 * @param {string} [playerName] The viewed player's name, when the host page has it.
 * @returns {string}
 */
export function retroactiveExplainerText(isOwnStats, playerName) {
  if (isOwnStats) {
    return 'You earned this before badges existed. We looked back through your solve '
      + 'history and awarded it for play you had already done.';
  }
  const who = playerName || 'This player';
  return `${who} earned this before badges existed. We looked back through their solve `
    + 'history and awarded it for play they had already done.';
}

/**
 * @param {Object} props
 * @param {boolean} [props.isOpen]
 * @param {() => void} [props.onClose]
 * @param {import('@/game-mechanics/badgeRegistry').Badge} [props.badge] Registry def (Lane C).
 * @param {import('./badgeVisuals').BadgeState} [props.state] Derived state (Lanes B/D).
 * @param {string} [props.launchDate] ISO launch date; earlier earns stamp "Earned Retroactively".
 * @param {boolean} [props.isOwnStats] False when viewing another player — swaps the
 *   retroactive explainer out of the second person. Defaults to true, matching the
 *   own-stats default every host in this subtree already carries.
 * @param {string} [props.playerName] The viewed player's name (other-player copy).
 */
export default function BadgeDetailModal({
  isOpen = false,
  onClose,
  badge,
  state,
  launchDate,
  isOwnStats = true,
  playerName,
}) {
  const panelRef = useRef(/** @type {HTMLDivElement | null} */(null));
  const restoreFocusRef = useRef(/** @type {Element | null} */(null));
  const [showRetroExplainer, setShowRetroExplainer] = useState(false);
  // The modal — not the carousel — owns the viewed rung, so the big art and the
  // "How to earn it" sentence can never disagree about which tier is on screen.
  const [viewedTier, setViewedTier] = useState(() => currentTierIndex(badge, state));

  const close = useCallback(() => { onClose?.(); }, [onClose]);

  // Escape to close + a Tab focus trap, both live only while open.
  useEffect(() => {
    if (!isOpen) return undefined;

    restoreFocusRef.current = document.activeElement;
    document.body.style.overflow = 'hidden';

    const onKeyDown = (/** @type {KeyboardEvent} */ e) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const panel = panelRef.current;
      if (!panel) return;
      const items = Array.from(panel.querySelectorAll(FOCUSABLE));
      if (items.length === 0) return;
      const first = /** @type {HTMLElement} */ (items[0]);
      const last = /** @type {HTMLElement} */ (items[items.length - 1]);
      // Wrap at both ends so Tab can never walk out to the page behind.
      if (e.shiftKey && (document.activeElement === first || !panel.contains(document.activeElement))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    window.addEventListener('keydown', onKeyDown);
    return () => {
      window.removeEventListener('keydown', onKeyDown);
      document.body.style.overflow = '';
      const restore = restoreFocusRef.current;
      if (restore && typeof (/** @type {HTMLElement} */ (restore).focus) === 'function') {
        /** @type {HTMLElement} */ (restore).focus();
      }
    };
  }, [isOpen, close]);

  // Move focus into the panel once it exists (after the portal mounts).
  useEffect(() => {
    if (!isOpen) return;
    const panel = panelRef.current;
    const firstFocusable = /** @type {HTMLElement | null} */ (panel?.querySelector(FOCUSABLE));
    firstFocusable?.focus();
  }, [isOpen, badge]);

  // A new badge resets the transient explainer disclosure, and re-anchors the
  // carousel on the rung the player is standing on.
  useEffect(() => { setShowRetroExplainer(false); }, [badge, isOpen]);
  useEffect(() => { setViewedTier(currentTierIndex(badge, state)); }, [badge, state, isOpen]);

  if (!isOpen || !badge) return null;

  const earned = Boolean(state?.earned);
  const silhouette = isSilhouetted(badge, state);
  const retroactive = isRetroactive(state, launchDate);
  const earnedDate = formatEarnedDate(state?.earliestDate);
  const total = badgeTierCount(badge);
  const tierIdx = currentTierIndex(badge, state);
  const hue = tierRarityVar(badge, tierIdx);
  const count = Number.isFinite(state?.count) ? /** @type {number} */ (state?.count) : 0;
  const laddered = badge.scaling?.type !== 'oneTime' && total > 1;
  // The rung the carousel is parked on — clamped, because `badge` can change a
  // render before the re-anchoring effect runs.
  const shownTier = Math.min(Math.max(viewedTier, 0), Math.max(total - 1, 0));

  const titleId = `badge-detail-title-${badge.id}`;

  return createPortal((
    <AnimatePresence>
      <motion.div
        key="badge-detail-backdrop"
        data-testid="badge-detail-backdrop"
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 z-[140] flex flex-col items-center justify-start pt-12 px-4 u37-ad-safe-pb bg-black/75 backdrop-blur-sm"
        onClick={close}
      >
        <motion.div
          ref={panelRef}
          role="dialog"
          aria-modal="true"
          aria-labelledby={titleId}
          initial={{ scale: 0.92, opacity: 0, y: 20 }}
          animate={{ scale: 1, opacity: 1, y: 0 }}
          exit={{ scale: 0.92, opacity: 0, y: 20 }}
          onClick={(e) => e.stopPropagation()}
          className="w-full max-w-sm rounded-3xl p-5 pb-6 border-2 shadow-2xl relative overflow-y-auto"
          style={{
            background: 'var(--u37-panel-bg-cosmic)',
            borderColor: silhouette ? 'var(--u37-hair)' : `color-mix(in srgb, ${hue} 40%, transparent)`,
            boxShadow: silhouette ? '0 20px 60px rgba(0,0,0,0.6)' : `0 0 46px -18px ${hue}, 0 20px 60px rgba(0,0,0,0.6)`,
            maxHeight: 'calc(100dvh - 48px - var(--safe-bottom) - var(--ad-reserved-bottom) - 1rem)',
          }}
        >
          <button
            type="button"
            aria-label="Close badge details"
            onClick={close}
            className="absolute top-4 right-4 z-10 transition-colors"
            style={{ color: 'var(--u37-muted)' }}
          >
            <X className="w-5 h-5" />
          </button>

          {/* Big cosmic badge art */}
          <div className="flex justify-center pt-2 pb-3">
            <BadgeFrame badge={badge} state={state} size="lg" />
          </div>

          {/* Name + the ×N flourish for repeated feats */}
          <div className="text-center mb-1">
            <h2
              id={titleId}
              data-testid="badge-detail-name"
              className="text-xl font-black tracking-wide"
              style={{ color: silhouette ? 'var(--u37-muted)' : 'var(--u37-text)' }}
            >
              {silhouette ? '???' : badge.name}
            </h2>
            {earned && count > 1 && (
              <span
                data-testid="badge-detail-count"
                className="inline-block mt-1 px-2 py-0.5 rounded-full text-[11px] font-black"
                style={{ background: `color-mix(in srgb, ${hue} 24%, transparent)`, color: hue }}
              >
                ×{count}
              </span>
            )}
          </div>

          {/* Mode + category chips */}
          <div className="flex items-center justify-center gap-2 mb-3 flex-wrap">
            <span
              data-testid="badge-detail-mode"
              className="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider"
              style={{ background: 'var(--u37-surface)', color: 'var(--u37-muted)', border: '1px solid var(--u37-hair)' }}
            >
              {modeLabel(badge.mode)}
            </span>
            {/* Tier chip is suppressed while silhouetted — even "5 tiers" is a
                detail about a badge the player is not supposed to know yet. */}
            {laddered && !silhouette && (
              <span
                className="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider"
                style={{ background: 'var(--u37-surface)', color: 'var(--u37-muted)', border: '1px solid var(--u37-hair)' }}
              >
                {earned ? `${tierLabel(badge, tierIdx, state?.durationSeconds)} · Tier ${tierIdx + 1}/${total}` : `${total} tiers`}
              </span>
            )}
          </div>

          {/* Earned state — the retroactive ribbon (§9.3), a plain earned date, or locked */}
          <div className="mb-4">
            {retroactive ? (
              <div className="flex flex-col items-center gap-1">
                <div className="flex items-center gap-1.5">
                  <span
                    data-testid="badge-retroactive-ribbon"
                    className="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-[0.15em]"
                    style={{
                      background: `linear-gradient(135deg, color-mix(in srgb, ${hue} 55%, #05030f) 0%, color-mix(in srgb, ${hue} 25%, #05030f) 100%)`,
                      color: 'var(--u37-text)',
                      border: `1px solid color-mix(in srgb, ${hue} 60%, transparent)`,
                    }}
                  >
                    Earned Retroactively
                  </span>
                  <button
                    type="button"
                    aria-label="What does Earned Retroactively mean?"
                    aria-expanded={showRetroExplainer}
                    onClick={() => setShowRetroExplainer((v) => !v)}
                    style={{ color: 'var(--u37-muted)' }}
                  >
                    <HelpCircle className="w-4 h-4" />
                  </button>
                </div>
                {showRetroExplainer && (
                  <p
                    data-testid="badge-retroactive-explainer"
                    className="text-[11px] leading-snug text-center px-2 mt-1"
                    style={{ color: 'var(--u37-muted)' }}
                  >
                    {retroactiveExplainerText(isOwnStats, playerName)}
                  </p>
                )}
                {earnedDate && (
                  <p className="text-[11px] font-semibold" style={{ color: 'var(--u37-muted)' }}>
                    First earned {earnedDate}
                  </p>
                )}
              </div>
            ) : earned ? (
              <p data-testid="badge-earned-date" className="text-center text-xs font-semibold" style={{ color: hue }}>
                {earnedDate ? `Earned ${earnedDate}` : 'Earned'}
              </p>
            ) : (
              <p data-testid="badge-locked-note" className="text-center text-xs font-semibold" style={{ color: 'var(--u37-muted)' }}>
                Not earned yet
              </p>
            )}
          </div>

          {/* The exact criteria in plain English — or, for an unearned hidden
              badge, a cryptic hint. Never leak a hidden badge's criteria.

              For a laddered badge this is the sentence for the rung the carousel
              is showing, NOT the whole ladder: "past 1,000", not "past 100, then
              1,000, 10,000 and 100,000". The heading names the rung so the two
              are unambiguously about the same tier. */}
          <div
            className="rounded-2xl p-3 mb-4 border"
            style={{ background: 'var(--u37-surface)', borderColor: 'var(--u37-hair)' }}
          >
            <p
              data-testid="badge-criteria-heading"
              className="text-[10px] font-bold uppercase tracking-[0.2em] mb-1 text-center"
              style={{ color: 'var(--u37-muted)' }}
            >
              {silhouette ? 'Hidden Badge' : laddered ? `How to earn Tier ${shownTier + 1} of ${total}` : 'How to earn it'}
            </p>
            <p
              data-testid={silhouette ? 'badge-hidden-hint' : 'badge-criteria-text'}
              className="text-sm leading-snug text-center"
              style={{ color: silhouette ? 'var(--u37-muted)' : 'var(--u37-text)', fontStyle: silhouette ? 'italic' : 'normal' }}
            >
              {silhouette ? hiddenHint(badge) : tierCriteriaText(badge, shownTier, state?.durationSeconds)}
            </p>

            {/* THE CLIMB — the whole-badge sentence, which the UI could not
                reach for any laddered badge before 2026-09-04.
                `tierCriteriaText` returns the per-RUNG sentence whenever a badge
                has more than one tier, so `criteriaText` — the one line that
                explains what the badge is ABOUT ("Climb the operator ladder —
                use an exponent, then all four operations…") — was written,
                maintained, and never displayed. A player could read the rung and
                still not know what the badge was for. */}
            {!silhouette && laddered && badge.criteriaText && (
              <p
                data-testid="badge-criteria-climb"
                className="text-[11px] leading-snug text-center mt-2 pt-2"
                style={{ color: 'var(--u37-muted)', borderTop: '1px solid var(--u37-hair)' }}
              >
                {badge.criteriaText}
              </p>
            )}
          </div>

          {/* Tier carousel — laddered badges only, and never for a badge still
              hidden (its ladder would spell out the criteria). Controlled from
              here so moving it rewrites the criteria sentence above. */}
          {!silhouette && (
            <BadgeTierCarousel
              badge={badge}
              state={state}
              tierIndex={shownTier}
              onTierChange={setViewedTier}
              className="mb-4"
            />
          )}

          <button
            type="button"
            onClick={close}
            className="w-full py-3 rounded-xl font-bold transition-transform active:scale-[0.98]"
            style={{ background: 'var(--u37-mode-grad)', color: 'var(--u37-text)' }}
          >
            Close
          </button>
        </motion.div>
      </motion.div>
    </AnimatePresence>
  ), document.body);
}
