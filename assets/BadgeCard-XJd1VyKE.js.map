import React from 'react';

import { badgeIdentityColor } from '@/game-mechanics';
import BadgeIcon, { badgeIconKey, LOCKED_BADGE_ICON } from './badgeIcons';
import {
  frameForCategory,
  tierRarityVar,
  currentTierIndex,
  isSilhouetted,
  perfectWreathMetal,
  badgeMedalColor,
  badgeMedalAxis,
  badgeModeTheme,
} from './badgeVisuals';

// BadgeFrame — the badge ART primitive for the Badge System Redesign (Lane E).
//
// One presentational leaf shared by the L3 detail modal (big) and the tier
// carousel (small). It paints the category-encoding SHAPE (§9.4: flames =
// Streaks · hexagons = Milestones/Speed · shields = on-ramp first-times · cosmic
// orbs = Craft · laurels = Blitz Colosseum) in the same earned-glow / locked-ghost
// language MilestoneBadge established: earned = full neon + glow, locked = the
// SAME hue deeply dimmed and desaturated (never grey), so a section still reads
// as one flow of colour.
//
// ROUND 2 — THE FRAME IS THE MEDAL, and the medal is where the OTHER TWO axes
// resolve. It used to be filled with the badge's MODE accent, which meant every
// Daily badge was the same colour and a tab read as one flat block. Mode moved
// OUTWARD onto the card's border, background ramp and glow (BadgeCard) — the
// "grouped theme outline around them" David asked for — and it has stayed there
// through every pass since. The card says WHICH MODE; this element says the rest.
//
// R2-G (David, 2026-08-02) decided what "the rest" is, PER BADGE:
//
//   TIERED badge   → the medal is the TIER colour.     One-time badge → identity.
//   (`badgeMedalAxis` in ./badgeVisuals owns the rule; this file only paints it.)
//
//   *"the outline stays mode-specific coloured, but the inner image is what
//     changes to the tier colour to provide more contrast between the various
//     different badges and tiers. Currently we have just a glow around them that
//     changes by tier — let's change the whole image colour."*
//
// Before this, tier lived only in a bloom BEHIND the medal, turned down to 46%
// by R2-C because at 58% it swamped the identity colour underneath. On a real
// phone that left tier barely legible. Handing tier the image outright fixes the
// legibility; a one-time badge has no tier to show, so it keeps identity, which
// is what keeps those ten cards distinguishable from each other.
//
// WHAT HAPPENED TO THE BLOOM (the R2-G call, and its reasoning). The bloom
// existed to signal tier. With the medal now BEING the tier colour on every
// laddered badge, a separately-hued bloom is redundant at best and mud at worst,
// so it stops being an independent colour and becomes a HALO of whatever the
// medal is painted in. That is a deliberate demotion, not a deletion — the soft
// lift off the card background is doing real work (it is what makes an earned
// badge sit forward of a locked one), and dropping it flattened the grid.
//
// Two hard-won facts, both now structurally unreachable rather than tuned around:
//   1. At 58% the old bloom SWAMPED the medal (a tier-4 rung rendered a cyan
//      Daily badge visibly purple). A halo that is the medal's own colour has
//      nothing left to swamp.
//   2. A raw tier hue far from the badge's colour read as DIRT, which is why the
//      bloom was `color-mix(hue 60%, accent)`. With one colour instead of two
//      there is no mix, so there is no mud — that 60% constant is SUPERSEDED and
//      gone. The remaining tuned numbers are pinned in MEDAL_TUNING below.
//
// RARITY is still reported as its own axis (`data-rarity` on the glow, and the
// tier caption on the card), so what the axis MEANS stays assertable even where
// it now shares a surface with the medal.
//
// Props-only. It renders what it is given and computes no badge state.

// The tuned constants of the medal, in ONE place with their provenance.
//
// `fillLit` is the only one derived rather than eyeballed, and it is the one that
// moved in R2-G: at the old 72% the *painted* tier-4 violet came out at 2.93:1 on
// `--u37-bg`, just under the WCAG 1.4.11 graphical-object bar, because the fill is
// a mix down toward near-black rather than the raw token (which clears at 4.81:1).
// 76% puts the worst tier at 3.15:1 with margin. `badgeMedalContrast.test.js`
// recomputes this from tokens.css and fails if either the mix or a token drifts —
// so this number is now DERIVED and guarded, not a taste call.
//
// The other three are EYEBALL-TUNED and have no maths behind them; they are
// asserted only so a future pass has to change the test on purpose. In particular
// `bloomLit: 46` was 58 until R2-C found it swamping the medal — nothing but this
// pin stops it being rounded back up.
const MEDAL_TUNING = {
  fillLit: 76,     // % of the medal colour in the earned fill — contrast-derived, guarded
  fillUnlit: 8,    // % in the locked fill: the same hue, deeply dimmed — never grey
  bloomLit: 46,    // % opacity of the earned halo — eyeball-tuned (was 58, too strong)
  bloomUnlit: 16,  // % opacity of the locked halo — eyeball-tuned
  bloomStop: 56,   // % radius where the halo fades out — eyeball-tuned
};

// The five silhouettes, as viewBox-100 paths. Deliberately simple geometry: at
// badge sizes the read is shape-at-a-glance, and a path keeps the frame a single
// paint (no nested elements per badge) — the same compositing lesson that
// flattened MilestoneBadge for the Android webview.
const SHAPE_PATHS = {
  // Teardrop flame — streaks.
  flame: 'M50 4 C64 26 82 36 82 58 A32 32 0 0 1 18 58 C18 36 36 26 50 4 Z',
  // Point-up hexagon — tiered milestones + speed.
  hexagon: 'M50 4 L91 27 L91 73 L50 96 L9 73 L9 27 Z',
  // Heater shield — one-time firsts.
  shield: 'M50 5 L88 18 V50 C88 74 70 88 50 96 C30 88 12 74 12 50 V18 Z',
  // Cosmic orb — the craft catalog.
  orb: 'M50 6 A44 44 0 1 1 49.9 6 Z',
  // Laurel wreath ring — Blitz Colosseum + podium competition.
  laurel: 'M50 6 C74 6 94 26 94 50 C94 74 74 94 50 94 C26 94 6 74 6 50 C6 26 26 6 50 6 Z M50 20 C33 20 20 33 20 50 C20 67 33 80 50 80 C67 80 80 67 80 50 C80 33 67 20 50 20 Z',
};

// The PERFECT WREATH — the fourth, additive layer (2026-08-02).
//
// Two arcs with four leaves each, hugging the medal. It is struck in a METAL
// (gold on Daily variants, platinum on Challenge ones) rather than in a palette
// hue, because the palette has none to spare: `--u37-gold` IS `--u37-tier-6`, so
// a hue-based marker would restate rarity. Form carries the meaning instead, and
// the three R2-C rings underneath are untouched.
//
// Drawn on the same viewBox-100 grid as SHAPE_PATHS so it lines up with every
// frame shape at every size.
const WREATH_METALS = {
  gold: { from: '#ffe9a3', mid: '#ffcf3a', to: '#c9971f' },
  platinum: { from: '#ffffff', mid: '#cfd8e6', to: '#8b94a7' },
};

const WREATH_LEAVES = [0, 1, 2, 3];

/**
 * @param {Object} props
 * @param {'gold'|'platinum'} props.metal
 */
function PerfectWreath({ metal }) {
  const stops = WREATH_METALS[metal] ?? WREATH_METALS.gold;
  // Gradient ids must be unique per metal or two wreaths on one page would share
  // the first one's stops (SVG defs are document-global).
  const gradientId = `u37-wreath-${metal}`;
  return (
    <svg
      data-testid="badge-frame-wreath"
      data-wreath-metal={metal}
      viewBox="0 0 100 100"
      className="absolute inset-0 w-full h-full pointer-events-none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor={stops.from} stopOpacity="0.95" />
          <stop offset="50%" stopColor={stops.mid} stopOpacity="0.8" />
          <stop offset="100%" stopColor={stops.to} stopOpacity="0.65" />
        </linearGradient>
      </defs>
      <path d="M30 22 A26 26 0 0 0 30 60" fill="none" stroke={`url(#${gradientId})`} strokeWidth="2.5" strokeLinecap="round" />
      <path d="M70 22 A26 26 0 0 1 70 60" fill="none" stroke={`url(#${gradientId})`} strokeWidth="2.5" strokeLinecap="round" />
      {WREATH_LEAVES.map((i) => (
        <g key={i}>
          <ellipse
            cx={27 - i * 0.5} cy={30 + i * 8} rx="3.2" ry="1.7" fill={`url(#${gradientId})`}
            transform={`rotate(${-35 + i * 12} ${27 - i * 0.5} ${30 + i * 8})`}
          />
          <ellipse
            cx={73 + i * 0.5} cy={30 + i * 8} rx="3.2" ry="1.7" fill={`url(#${gradientId})`}
            transform={`rotate(${35 - i * 12} ${73 + i * 0.5} ${30 + i * 8})`}
          />
        </g>
      ))}
    </svg>
  );
}

/**
 * @param {Object} props
 * @param {import('@/game-mechanics/badgeRegistry').Badge} [props.badge] Registry def (Lane C).
 * @param {import('./badgeVisuals').BadgeState} [props.state] Derived state (Lanes B/D).
 * @param {number} [props.tierIndex] Which rung to colour; defaults to the state's current tier.
 * @param {boolean} [props.earned] Override the lit/dim decision (the carousel passes per-tier).
 * @param {'sm'|'md'|'lg'} [props.size]
 * @param {string} [props.className]
 */
export default function BadgeFrame({ badge, state, tierIndex, earned, size = 'lg', className = '' }) {
  const shape = frameForCategory(badge?.category);
  const path = SHAPE_PATHS[shape] ?? SHAPE_PATHS.orb;

  const index = Number.isFinite(tierIndex) ? /** @type {number} */ (tierIndex) : currentTierIndex(badge, state);
  // `accent` is WHAT THE MEDAL IS PAINTED IN — the tier colour on a laddered
  // badge, the badge's own identity colour on a one-time one. Everything the
  // medal wears (fill, stroke, glyph tint, outer drop-shadow, halo) derives from
  // this one value, which is what stops any two of them disagreeing.
  const accent = badgeMedalColor(badge, index);
  const medalAxis = badgeMedalAxis(badge);
  const identity = badgeIdentityColor(badge); // the identity AXIS value, reported below
  const hue = tierRarityVar(badge, index);    // the rarity AXIS value, reported below

  const silhouette = isSilhouetted(badge, state);
  const lit = earned ?? Boolean(state?.earned);
  // The fourth layer. Null for every non-variant and for any silhouette, so this
  // is a no-op for the whole catalog except the perfect variants.
  const wreathMetal = perfectWreathMetal(badge, state);

  const box = { sm: 'w-14 h-14', md: 'w-20 h-20', lg: 'w-32 h-32 sm:w-40 sm:h-40' }[size] ?? 'w-32 h-32';
  // The art is an SVG now, not a text glyph, so its size is a BOX (half the
  // frame at every breakpoint) rather than a font size.
  const artSize = { sm: 'w-7 h-7', md: 'w-10 h-10', lg: 'w-16 h-16 sm:w-20 sm:h-20' }[size] ?? 'w-16 h-16';

  // Which drawing from the curated set. A silhouette shows the lock instead —
  // the icon is as much of a giveaway as the emoji was.
  const iconKey = silhouette ? LOCKED_BADGE_ICON : badgeIconKey(badge);

  // Earned: neon medal fill + outer glow. Locked: the same colour at ~8%,
  // desaturated and dimmed — the SAME hue, never grey, so a section still reads
  // as one flow of colour. Silhouetted (hidden + unearned): near-flat
  // near-black, no hue at all — the shape is all the player gets until the
  // reveal, and a colour would already narrow down the feat.
  const fill = silhouette
    ? 'color-mix(in srgb, #ffffff 6%, #0b0b18)'
    : lit
      ? `color-mix(in srgb, ${accent} ${MEDAL_TUNING.fillLit}%, #05030f)`
      : `color-mix(in srgb, ${accent} ${MEDAL_TUNING.fillUnlit}%, #0b0b18)`;
  const stroke = silhouette
    ? 'rgba(255,255,255,0.16)'
    : lit
      ? `color-mix(in srgb, ${accent} 85%, transparent)`
      : `color-mix(in srgb, ${accent} 24%, transparent)`;

  // The GLYPH's colour (the SVG icon inherits it through `currentColor`). It is
  // derived from the same MEDAL colour the frame wears so the art reads as part
  // of the badge — but pushed toward white, because the icon sits ON TOP of the
  // frame's deep fill and a colour-on-itself glyph would vanish. Since R2-G that
  // means the glyph climbs the tier wheel with the medal on a laddered badge,
  // and stays on identity for the one-time ones.
  const iconColor = silhouette
    ? 'rgba(255,255,255,0.62)'
    : lit
      ? `color-mix(in srgb, ${accent} 26%, #ffffff)`
      : `color-mix(in srgb, ${accent} 45%, #cbd0e4)`;

  const wrapperStyle = lit && !silhouette
    ? { filter: `drop-shadow(0 0 18px color-mix(in srgb, ${accent} 55%, transparent))` }
    : { filter: 'saturate(0.5)', opacity: silhouette ? 0.85 : 0.55 };

  // THE HALO — the medal's own colour, softly, behind it (R2-G; see the header).
  //
  // This used to be `color-mix(in srgb, ${hue} 60%, ${accent})`: rarity mixed
  // INTO identity, because a raw tier hue far from the badge's colour read as
  // dirt. That whole problem was a consequence of two different colours sharing
  // one small area. Now that the medal IS the tier colour on every laddered
  // badge, there is one colour, so the mix — and the mud it was compensating for
  // — is gone. What is left is a lift: a halo that makes an earned badge sit
  // forward of the card behind it.
  const bloom = accent;

  return (
    <div
      data-testid="badge-frame"
      data-shape={shape}
      // The `[data-mode]` THEME name, not the raw registry key -- see
      // `badgeModeTheme`. The frame had the same leak the card did.
      data-mode={badgeModeTheme(badge?.mode)}
      // `data-accent` / `data-medal` mirror WHAT THIS ELEMENT PAINTED WITH — the
      // medal colour. Mirrored as attributes because the test DOM's CSS parser
      // drops any declaration containing `color-mix()`, so the inline style is
      // not assertable. `data-medal-axis` says WHICH axis that colour came from,
      // which is the R2-G rule itself and the thing worth pinning.
      //
      // `data-identity` and the glow's `data-rarity` report the two AXIS VALUES
      // regardless of which one won the medal, so "what is this badge's identity
      // colour" and "which rung is it on" both stay answerable from the DOM.
      data-accent={silhouette ? '' : accent}
      data-medal={silhouette ? '' : accent}
      data-medal-axis={silhouette ? '' : medalAxis}
      data-identity={silhouette ? '' : identity}
      data-earned={lit ? 'true' : 'false'}
      data-silhouette={silhouette ? 'true' : 'false'}
      className={`relative ${box} ${className}`}
      style={wrapperStyle}
    >
      <svg viewBox="0 0 100 100" className="w-full h-full" aria-hidden="true" focusable="false">
        <path
          d={path}
          fill={fill}
          stroke={stroke}
          strokeWidth="3"
          fillRule="evenodd"
        />
      </svg>

      {/* THE HALO — a soft radial lift in the medal's own colour, directly behind
          the art. One absolutely-positioned gradient, no extra paint per badge.
          Suppressed on a silhouette, which must leak nothing.

          It kept its `badge-frame-rarity-glow` testid and its `data-rarity`
          attribute deliberately: the element is the same element, and rarity is
          still the axis being REPORTED here even though R2-G moved the axis's
          paint onto the medal itself. Renaming it would have broken every
          existing assertion for no gain. */}
      {!silhouette && (
        <div
          data-testid="badge-frame-rarity-glow"
          data-rarity-tier={index}
          data-rarity={hue}
          // The halo's colour and strength, mirrored for the same reason
          // `data-accent` is: the `background` below is a `radial-gradient`
          // containing `color-mix()`, and the test DOM's CSS parser drops the
          // whole declaration, so the style attribute arrives empty. Without
          // these the R2-C tuning would be unassertable — which is how it came to
          // be guarded by nothing in the first place.
          data-halo={bloom}
          data-halo-opacity={lit ? MEDAL_TUNING.bloomLit : MEDAL_TUNING.bloomUnlit}
          data-halo-stop={MEDAL_TUNING.bloomStop}
          aria-hidden="true"
          className="absolute inset-0 rounded-full pointer-events-none"
          style={{
            background: `radial-gradient(circle at 50% 50%, color-mix(in srgb, ${bloom} ${lit ? MEDAL_TUNING.bloomLit : MEDAL_TUNING.bloomUnlit}%, transparent) 0%, transparent ${MEDAL_TUNING.bloomStop}%)`,
          }}
        />
      )}

      {/* PERFECT VARIANT — the wreath, above the frame and rarity bloom but below
          the art, so the glyph stays the thing you read first. It paints none of
          the three R2-C axes: no `data-accent`, no `data-identity`, no
          `data-rarity` is touched by it. */}
      {wreathMetal && <PerfectWreath metal={wreathMetal} />}

      {/* The art itself sits centred inside the frame. Hidden-and-unearned badges
          show a lock instead of the icon — the art would give the feat away.

          The glyph is a vendored SVG from the curated set (./badgeIcons), not an
          emoji: emoji draw differently on every platform, carry colours that
          fight the palette, and had half the catalog wearing a stock office
          glyph (a chart, a speaker, a camera) for a feat about mathematics. The
          icon paints itself entirely in `currentColor`, so the `color` set here
          — an accent-tinted white that reads against the frame's deep accent
          fill — is the ONLY place the glyph's hue is decided. */}
      <div className="absolute inset-0 flex items-center justify-center">
        <span
          data-testid="badge-frame-art"
          data-icon={iconKey}
          // Mirrored as an attribute for the same reason `data-accent` is: a
          // `color-mix()` value is invisible to the test environment's CSSOM, so
          // the tint the glyph inherits would otherwise be unassertable.
          data-icon-color={iconColor}
          className={`${artSize} ${lit ? '' : 'opacity-60'} inline-flex items-center justify-center leading-none select-none`}
          style={{
            color: iconColor,
            ...(silhouette
              ? { filter: 'grayscale(1) brightness(0.5)' }
              : lit
                ? { filter: `drop-shadow(0 0 7px color-mix(in srgb, ${bloom} 55%, transparent))` }
                : {}),
          }}
        >
          <BadgeIcon name={iconKey} className="w-full h-full" />
        </span>
      </div>
    </div>
  );
}

export { SHAPE_PATHS, MEDAL_TUNING };
