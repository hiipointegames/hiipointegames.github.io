import React, { useEffect, useState } from 'react';
import { ChevronLeft, ChevronRight } from 'lucide-react';

import { badgeTiers, badgeTierCount } from '@/game-mechanics';
import BadgeFrame from './BadgeFrame';
import { tierLabel, tierRarityVar, isTierEarned, currentTierIndex } from './badgeVisuals';

// BadgeTierCarousel — prev/next through a laddered badge's tiers (Lane E, §9.3).
//
// The NYT Genius 25→50→75→100 pattern: ONE badge that levels up, with every rung
// preserved in the detail view. Earned rungs render lit (full neon rarity hue +
// glow); future rungs render dimmed in the same hue, so the ladder still reads
// as one flow of colour weakest→strongest.
//
// Every ladder shape the registry declares is supported, because the labels come
// from `tierLabel` and the values from the registry's own `badgeTiers` selector:
//   - countLadder      (×1 → ×10 → ×37 → ×100)
//   - thresholdLadder  (100 → 1,000 → 10,000 → 100,000)
//   - descending       (Under 0:30 → Under 0:20 → Under 0:10)
//   - named tiers      (Cadet → Pilot → Commander; Bronze/Silver/Gold)
//   - duration-scaled  (Meteor Shower — pass `state.durationSeconds`)
//
// Props-only: it renders the badge def (Lane C) + badge state (Lanes B/D). It
// never computes whether a tier was earned from raw solve data — `state.tier`
// (the highest rung reached) is the input.
//
// The viewed rung is self-managed by default and CONTROLLED when the parent
// passes `tierIndex` + `onTierChange` — that is how the detail modal keeps its
// per-tier "How to earn it" sentence in lockstep with the art on screen.

/**
 * Uncontrolled by default. Pass `tierIndex` + `onTierChange` to CONTROL the
 * viewed rung from the parent — the detail modal does that so the criteria
 * sentence ("How to earn Tier 2 of 4") and the carousel art always agree on
 * which rung the player is looking at.
 *
 * @param {Object} props
 * @param {import('@/game-mechanics/badgeRegistry').Badge} [props.badge]
 * @param {import('./badgeVisuals').BadgeState} [props.state]
 * @param {number} [props.tierIndex] Controlled viewed rung. Omit for self-managed.
 * @param {(index: number) => void} [props.onTierChange] Fires with the clamped new rung.
 * @param {string} [props.className]
 */
export default function BadgeTierCarousel({ badge, state, tierIndex, onTierChange, className = '' }) {
  const total = badgeTierCount(badge);
  const laddered = Boolean(badge) && badge.scaling?.type !== 'oneTime' && total > 1;
  const controlled = Number.isFinite(tierIndex);

  // Open on the rung the player is standing on — their current tier — so the
  // carousel answers "where am I?" before "what's next?".
  const [ownIndex, setOwnIndex] = useState(() => currentTierIndex(badge, state));

  // A different badge (or a refreshed state) re-anchors the carousel; without
  // this, reusing the mounted modal for a second badge would keep a stale rung.
  // A controlled carousel gets its anchor from the parent instead.
  useEffect(() => {
    if (controlled) return;
    setOwnIndex(currentTierIndex(badge, state));
  }, [badge, state, controlled]);

  if (!laddered) return null;

  const tiers = badgeTiers(badge, state?.durationSeconds);
  const index = controlled ? /** @type {number} */ (tierIndex) : ownIndex;
  const safeIndex = Math.min(Math.max(index, 0), total - 1);
  const earnedHere = isTierEarned(state, safeIndex);
  const hue = tierRarityVar(badge, safeIndex);

  const setIndex = (next) => {
    const clamped = Math.min(Math.max(next, 0), total - 1);
    if (!controlled) setOwnIndex(clamped);
    onTierChange?.(clamped);
  };
  const go = (delta) => setIndex(safeIndex + delta);

  return (
    <div data-testid="badge-tier-carousel" className={`w-full ${className}`}>
      <p className="text-[10px] font-bold uppercase tracking-[0.2em] text-center mb-2" style={{ color: 'var(--u37-muted)' }}>
        Tiers
      </p>

      <div className="flex items-center justify-between gap-2">
        <button
          type="button"
          aria-label="Previous tier"
          onClick={() => go(-1)}
          disabled={safeIndex === 0}
          className="shrink-0 w-9 h-9 rounded-full flex items-center justify-center border transition-opacity disabled:opacity-25"
          style={{ borderColor: 'var(--u37-hair)', background: 'var(--u37-surface)', color: 'var(--u37-text)' }}
        >
          <ChevronLeft className="w-5 h-5" />
        </button>

        <div className="flex-1 flex flex-col items-center gap-2 min-w-0">
          <BadgeFrame badge={badge} state={state} tierIndex={safeIndex} earned={earnedHere} size="md" />
          <p
            data-testid="badge-tier-label"
            className="text-sm font-black uppercase tracking-wide text-center truncate w-full"
            style={{ color: earnedHere ? hue : 'var(--u37-muted)', opacity: earnedHere ? 1 : 0.6 }}
          >
            {tierLabel(badge, safeIndex, state?.durationSeconds)}
          </p>
          <p className="text-[11px] font-semibold" style={{ color: 'var(--u37-muted)' }}>
            {earnedHere ? 'Earned' : 'Locked'} · Tier {safeIndex + 1} of {total}
          </p>
        </div>

        <button
          type="button"
          aria-label="Next tier"
          onClick={() => go(1)}
          disabled={safeIndex === total - 1}
          className="shrink-0 w-9 h-9 rounded-full flex items-center justify-center border transition-opacity disabled:opacity-25"
          style={{ borderColor: 'var(--u37-hair)', background: 'var(--u37-surface)', color: 'var(--u37-text)' }}
        >
          <ChevronRight className="w-5 h-5" />
        </button>
      </div>

      {/* Ladder rail — every rung at once, lit vs dimmed, tappable. This is the
          "nothing is lost" half of the tiered-ladder model (§9.2a): the carousel
          shows one rung big, the rail shows the whole climb. */}
      <div data-testid="badge-tier-rail" className="flex items-center justify-center gap-1.5 flex-wrap mt-3">
        {tiers.map((value, i) => {
          const lit = isTierEarned(state, i);
          const rungHue = tierRarityVar(badge, i);
          return (
            <button
              key={`${value}-${i}`}
              type="button"
              data-testid="badge-tier-rung"
              data-tier-earned={lit ? 'true' : 'false'}
              data-tier-current={i === safeIndex ? 'true' : 'false'}
              aria-label={`Tier ${i + 1}: ${tierLabel(badge, i, state?.durationSeconds)}${lit ? ' (earned)' : ' (locked)'}`}
              aria-current={i === safeIndex ? 'true' : undefined}
              onClick={() => setIndex(i)}
              className="h-2.5 rounded-full transition-all"
              style={{
                width: i === safeIndex ? '26px' : '14px',
                background: lit ? rungHue : `color-mix(in srgb, ${rungHue} 22%, #0b0b18)`,
                boxShadow: lit ? `0 0 10px -2px ${rungHue}` : 'none',
                opacity: lit ? 1 : 0.6,
              }}
            />
          );
        })}
      </div>
    </div>
  );
}
