import React from 'react';

import { formatProgressValue } from './badgeShowcaseModel';

// BadgeProgressBar — the "this locked badge is a GOAL" rail (Lane F, §9.2).
//
// An unearned card without a number is a dead end; with `120 / 125` it becomes
// the next thing to chase. Purely presentational: it renders a progress object
// from `badgeProgress()` and computes nothing itself.
//
// Two shapes, because a single fraction cannot honestly describe both:
//   - ASCENDING ladders (counts, magnitudes, streaks) get a filled bar plus the
//     `current / target` numerals.
//   - DESCENDING ladders (fastest solve times) get the target only — "Next:
//     Under 0:10" — since being 12 seconds off a 10-second target is not "120%
//     complete". `progress.ratio` is null in that case, and for any badge with
//     no recorded value yet.

/**
 * @param {Object} props
 * @param {ReturnType<typeof import('./badgeShowcaseModel').badgeProgress>} [props.progress]
 * @param {string} [props.hue] Rarity colour token for the fill (`var(--u37-tier-N)`).
 * @param {string} [props.className]
 */
export default function BadgeProgressBar({ progress, hue = 'var(--u37-tier-1)', className = '' }) {
  if (!progress) return null;

  const { current, target, ratio, nextLabel } = progress;
  const pct = ratio === null ? 0 : Math.round(ratio * 100);

  return (
    <div data-testid="badge-progress" data-ratio={ratio === null ? 'none' : String(pct)} className={`w-full ${className}`}>
      <div
        className="h-1.5 w-full rounded-full overflow-hidden"
        style={{ background: 'color-mix(in srgb, #ffffff 9%, transparent)' }}
        role={ratio === null ? undefined : 'progressbar'}
        aria-valuemin={ratio === null ? undefined : 0}
        aria-valuemax={ratio === null ? undefined : 100}
        aria-valuenow={ratio === null ? undefined : pct}
        aria-label={ratio === null ? undefined : `Progress toward ${nextLabel}`}
      >
        {ratio !== null && (
          <div
            data-testid="badge-progress-fill"
            className="h-full rounded-full"
            style={{ width: `${pct}%`, background: hue, boxShadow: `0 0 8px -2px ${hue}` }}
          />
        )}
      </div>

      <p
        data-testid="badge-progress-label"
        className="mt-1 text-[10px] font-bold tracking-wide text-center"
        style={{ color: 'var(--u37-muted)' }}
      >
        {ratio === null
          ? `Next: ${nextLabel}`
          : `${formatProgressValue(current)} / ${formatProgressValue(target)}`}
      </p>
    </div>
  );
}
