import { useCallback, useMemo, useRef } from 'react';
import { getLeaderboard } from '@/stats-aggregation';

// useTodaysLeaderboard — the cached, rate-limited, PER-MODE read of a day's board.
//
// ── THE BUG THIS FIXES ───────────────────────────────────────────────────────
// pages/Game.jsx read the board twice — the home prefetch and the "Today's
// Stats" recap — and BOTH called `getLeaderboard({ date: today })` with no mode.
// It also cached the result under the bare date.
//
// With one Daily that is correct. With three it is wrong twice over:
//
//   1. The rows come back MIXED. Every mode writes to daily_challenge_times, so
//      a mode-blind read returns Easy's, Challenge's and Expert's solves in one
//      list sorted by time. Easy is the fastest mode by construction, so
//      Challenge's podium would fill with Easy players, and the rank quoted in a
//      player's share card would be their position among people who did not play
//      their puzzle.
//   2. The DATE-ONLY CACHE KEY serves whichever mode asked first to every other
//      mode for the rest of the session — the same shape of bug P3 fixed in the
//      dice cache by keying it `${date}:${mode}`.
//
// So the mode is a required argument here, never an optional tail parameter that
// can silently go missing, and it is part of the cache key.
//
// The 10-second throttle is carried over from the inline version: it exists to
// stop a re-render storm hammering PostgREST, and it is per (date, mode) rather
// than global so switching modes is never throttled behind another mode's fetch.

const THROTTLE_MS = 10000;

export function useTodaysLeaderboard() {
  // key `${date}:${mode}` -> rows
  const cacheRef = useRef({});
  // key -> last fetch timestamp
  const lastFetchRef = useRef({});

  /**
   * Cache-first read of one (date, mode) board. Never throws — a failed read
   * yields the cached rows if there are any, else an empty board, because a
   * leaderboard fetch must never break the screen that is only decorating with it.
   *
   * @param {{date: string, mode: string, force?: boolean}} p
   * @returns {Promise<any[]>}
   */
  const read = useCallback(async ({ date, mode, force = false }) => {
    const key = `${date}:${mode}`;
    const cached = cacheRef.current[key];
    const last = lastFetchRef.current[key] || 0;
    if (!force && cached && Date.now() - last < THROTTLE_MS) return cached;

    try {
      const rows = await getLeaderboard({ date, mode });
      cacheRef.current[key] = rows;
      lastFetchRef.current[key] = Date.now();
      return rows;
    } catch (error) {
      console.error(`Failed to load the ${mode} leaderboard for ${date}:`, error);
      return cached || [];
    }
  }, []);

  /** Whatever is already cached for (date, mode), without a fetch. */
  const peek = useCallback(
    (date, mode) => cacheRef.current[`${date}:${mode}`] || null,
    [],
  );

  // Memoised so the returned handle is REFERENTIALLY STABLE. Both `read` and
  // `peek` are useCallback([]) and never change, but returning a bare object
  // literal handed every caller a new identity each render. Game.jsx keeps this
  // handle in the dep array of its today's-leaderboard effect, so an unstable
  // identity re-fired that effect on EVERY render of Game — i.e. on every
  // keystroke of equation entry. The 10 s throttle above capped the real network
  // cost, but the effect, its promise, and its setState still ran each time.
  return useMemo(() => ({ read, peek }), [read, peek]);
}
