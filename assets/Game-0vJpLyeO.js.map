import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { Share2 } from 'lucide-react';

// The post-completion / post-forfeit daily card shown on the home launcher when
// today's daily is already resolved and no puzzle is in play. Presentational:
// Game.jsx owns the data loading (onShowStats / onShare) and the display flags;
// this component just renders the card and wires the caller's callbacks. Kept a
// pure display piece so the home route stays light (see src/home/index.js).
//
// Beta-2 device feedback (2026-07-26): the flanking Stats/Leaderboard neon
// buttons were REMOVED — those destinations now live in the app-wide bottom nav
// bar, so the in-card copies were redundant. The congrats/better-luck line + the
// Today's Solve and Share actions stay (Today's Solve removed 2026-10-05, below).
//
// SHARE ONLY (David, 2026-10-05): "remove todays solve and increase the size
// and attraction of share button." Today's Solve is gone; Share is now the one
// full-width action, with a pulsing glow and a shimmer (still under reduced
// motion). `loadingStats` / `onShowStats` are still passed by Game.jsx and are
// accepted and ignored, the same way the old share-menu props are, so neither
// caller has to change.
//
// Beta-2 REFINEMENT (2026-07-26, second device pass): the card can host a
// `middleSlot` (the live podium) BETWEEN the congrats line and the actions row,
// so on the finished-daily screen the order reads congrats → podium → Today's
// Solve + Share.
//
// THE STATUS GLYPH IS GONE (David, 2026-09-04): "the game page… needs to have
// the trophy (if success) or red X (if fail or forfeit) removed from the screen
// and only contain the line of text." It was added in that same Beta-2 pass and
// has now been ruled out — the line of text already says which outcome this was,
// in the outcome's own colour, so the glyph was a second copy of one fact and the
// ❌ in particular greeted a player with a failure mark. The `accent` it used to
// tint is kept: the copy still reads cyan on a solve and magenta otherwise.
//
/**
 * The post-solve congratulations line, with the player's real streak in it.
 *
 * David, 2026-09-03: "come back tomorrow to continue your 80 day streak" — the
 * number names the streak for THE MODE THEY JUST PLAYED, because the three
 * Dailies are independent and a Challenge number on an Expert screen would be a
 * lie dressed as encouragement.
 *
 * Falls back to the unnumbered sentence whenever the number is not KNOWN to be
 * real — absent, non-finite, or below 1. That covers the honest cases: a tier
 * `readPerModeStats` reports as untracked (no `perMode` block has arrived yet)
 * reads as 0, and "your 0 day streak" told to someone who just solved would be
 * both wrong and deflating. Saying less is the correct failure.
 *
 * "80 day streak" keeps `day` singular — it is a compound adjective, so this
 * reads correctly at 1 and at 80 without a plural branch.
 *
 * @param {number|null|undefined} streak the mode's current streak, today included
 * @returns {string}
 */
export function streakCongrats(streak) {
  const n = Number(streak);
  if (!Number.isFinite(n) || n < 1) {
    return 'Congrats — come back tomorrow to continue your streak';
  }
  return `Congrats — come back tomorrow to continue your ${n} day streak`;
}

// @param {{
//   completed: boolean, forfeited: boolean,
//   onShare: (method: 'native') => void|Promise<void>,
//   (loadingStats / onShowStats belonged to the removed Today's Solve button;
//    still passed by Game.jsx and ignored)
//   (showShareMenu / onToggleShareMenu / onCloseShareMenu are still passed by
//    Game.jsx from the old share menu and are ignored — see the Share button)
//   middleSlot?: React.ReactNode,   // rendered between the congrats line and the
//                                   // actions row (the finished-daily podium)
//   streak?: number|null,           // the JUST-PLAYED mode's current streak,
//                                   // today included; omitted → unnumbered copy
// }} props
export default function DailyResultPanel({
  completed,
  forfeited,
  // The removed Today's Solve button's props — accepted and ignored (see header).
  loadingStats: _loadingStats,
  onShowStats: _onShowStats,
  onShare,
  // Still passed by HomeLauncher/Game.jsx from the old Share menu; accepted and
  // ignored so neither caller has to change (Game.jsx belongs to another lane).
  showShareMenu: _showShareMenu,
  onToggleShareMenu: _onToggleShareMenu,
  onCloseShareMenu: _onCloseShareMenu,
  middleSlot,
  streak = null,
}) {
  const accent = completed ? 'var(--u37-cyan)' : 'var(--u37-magenta)';
  const [sharing, setSharing] = React.useState(false);
  const still = useReducedMotion();

  return (
    <div className="flex justify-center items-center p-3">
      <div className="text-center max-w-md w-full">
        {/* Compact post-completion card: ONE themed line, then the two actions
            (now just Share — Today's Solve was removed 2026-10-05). The flanking Stats/Leaderboard buttons were
            removed in the Beta-2 pass (the bottom nav bar owns those destinations
            now) and the 🏆/❌ status glyph was removed 2026-09-04 — see the
            header. Kept small so the screen needs no scroll. */}
        <p
          className="text-sm font-bold mb-2.5"
          style={{
            color: accent,
            textShadow: `0 0 8px color-mix(in srgb, ${accent} 45%, transparent)`,
          }}
        >
          {completed
            ? streakCongrats(streak)
            : 'Better luck tomorrow — new puzzle at midnight ET'}
        </p>

        {/* Finished-daily reflow (Beta-2 refinement): the live podium sits HERE,
            between the congrats line and the actions, so the order reads
            congrats → podium → Share. Absent (null) on
            every non-daily-complete caller, so the card is unchanged there.
            Item 6 (2026-07-26): the caller now frames this slot with the grander
            PodiumShowcase treatment so it matches the easy/challenge home podium. */}
        {middleSlot}

        {/* Item 6 (2026-07-26, David): a modest breathing-room gap between the
            podium showcase and the Share action — one step up
            from the prior ~8px so the podium doesn't crowd the buttons. Present
            ONLY when a podium (middleSlot) is, so the compact non-daily-complete
            card keeps its tight spacing. Pure spacer — aria-hidden, no motion. */}
        {middleSlot && (
          <div data-testid="daily-podium-actions-gap" aria-hidden="true" className="h-3" />
        )}

        {/* ONE tap → the device share sheet with the picture card + message
            (@/share-card, 2026-09-29). The old Share… / Email / Text menu is gone:
            sms: and mailto: links can only carry text, so they could never send
            the card, and the share sheet already lists Messages and Mail.
            `sharing` blocks a second tap until the sheet resolves.

            The hero action since 2026-10-05: full width, taller, a magenta→violet
            fill whose glow breathes, and a shimmer that sweeps across it. */}
        <motion.button
          data-testid="daily-share"
          onClick={() => {
            if (sharing) return;
            setSharing(true);
            Promise.resolve(onShare('native'))
              .catch((err) => console.error('[share] daily share failed:', err))
              .finally(() => setSharing(false));
          }}
          aria-busy={sharing}
          whileTap={still ? undefined : { scale: 0.97 }}
          animate={still ? undefined : {
            boxShadow: [
              '0 0 18px -4px var(--u37-magenta), 0 6px 18px rgba(0,0,0,0.45)',
              '0 0 34px 2px var(--u37-magenta), 0 6px 18px rgba(0,0,0,0.45)',
              '0 0 18px -4px var(--u37-magenta), 0 6px 18px rgba(0,0,0,0.45)',
            ],
          }}
          transition={still ? undefined : { duration: 2.4, repeat: Infinity, ease: 'easeInOut' }}
          className="relative overflow-hidden w-full min-h-[60px] rounded-2xl border-2 font-black text-lg tracking-wide flex items-center justify-center gap-2.5 touch-manipulation"
          style={{
            color: '#ffffff',
            borderColor: 'color-mix(in srgb, var(--u37-magenta) 70%, white)',
            background: 'linear-gradient(100deg, var(--u37-magenta), var(--u37-violet))',
            boxShadow: '0 0 18px -4px var(--u37-magenta), 0 6px 18px rgba(0,0,0,0.45)',
            textShadow: '0 1px 2px rgba(0,0,0,0.35)',
          }}
        >
          {/* the shimmer: a soft band of light sweeping across every few seconds */}
          {!still && (
            <motion.span
              aria-hidden="true"
              data-testid="daily-share-shimmer"
              className="absolute inset-y-0 -left-1/3 w-1/3 pointer-events-none"
              style={{ background: 'linear-gradient(100deg, transparent, rgba(255,255,255,0.45), transparent)', transform: 'skewX(-20deg)' }}
              animate={{ x: ['0%', '450%'] }}
              transition={{ duration: 1.4, repeat: Infinity, repeatDelay: 2.2, ease: 'easeInOut' }}
            />
          )}
          <Share2 className="relative w-6 h-6" />
          <span className="relative">Share</span>
        </motion.button>

        {/* (home-condense H1) The post-completion How-To pill was removed — the
            launcher's top utility row "?" is the single always-available how-to
            entry, including in the resolved daily state. */}
      </div>
    </div>
  );
}
