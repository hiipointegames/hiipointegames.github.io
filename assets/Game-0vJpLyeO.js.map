import React from 'react';
import { motion } from 'framer-motion';
import { HelpCircle } from 'lucide-react';

// The launcher's how-to entry — a full "How to Play & Win" button that opens the
// mode-aware How-To-Play overlay IN PLACE (Game.jsx wires onClick to openHowTo,
// so closing returns to the launcher; it never navigates away). This restores the
// standalone how-to button on the Easy/Challenge/Daily launchers and replaces the
// corner "?"+mute chrome cluster, both removed in the 2026-07-08 home-condense H3
// restructure. Secondary to the primary Roll Dice / Start button above it, so it's
// a tinted outline in the active mode's neon accent (--u37-mode-accent, driven by
// the launcher's data-mode) rather than a solid fill. Presentational — Game.jsx
// owns the handler.
export default function HowToWinButton({ onClick }) {
  return (
    <div className="flex justify-center px-4 pt-0.5">
      <motion.button
        type="button"
        onClick={onClick}
        whileHover={{ scale: 1.02 }}
        whileTap={{ scale: 0.98 }}
        aria-label="How to play and winning examples"
        // One step in from the primary above it: the three stacked launcher
        // buttons taper downward into an inverted pyramid, so the hierarchy is
        // carried by width as well as by fill (David, 2026-07-31, from Bryce's
        // 1.0.287 note). Battle Friends steps in again below.
        //
        // The width is a PERCENTAGE, not just a smaller max-w rung. On a phone the
        // row is ~358px wide, which is under every max-w cap — so max-w-sm alone
        // would render this button exactly as wide as the max-w-md primary and
        // flatten the pyramid on the one device it's for (measured: 180/180/180 at
        // phone width vs 180/166/151 with percentages). max-w-sm still caps it on
        // a wide screen.
        className="w-[92%] max-w-sm min-h-[48px] touch-manipulation flex items-center justify-center gap-2 rounded-2xl px-6 py-3 font-black text-sm border backdrop-blur-sm transition-colors"
        style={{
          // Brighter label (light tint of the accent) for readability; the border
          // + glow stay the saturated accent for the neon look.
          color: 'color-mix(in srgb, var(--u37-mode-accent) 35%, white)',
          borderColor: 'var(--u37-mode-accent)',
          background: 'color-mix(in srgb, var(--u37-mode-accent) 12%, transparent)',
          boxShadow: '0 0 18px -8px var(--u37-mode-accent), inset 0 0 18px -14px var(--u37-mode-accent)',
          textShadow: '0 0 8px color-mix(in srgb, var(--u37-mode-accent) 45%, transparent)',
          WebkitTapHighlightColor: 'transparent',
        }}
      >
        <HelpCircle className="w-4 h-4" />
        How to Play &amp; Win
      </motion.button>
    </div>
  );
}
