import React from 'react';
import { modeOf, keyFor } from '@/game-modes';

// The home launcher's DIFFICULTY TIER picker — Easy / Challenge / Expert.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT CHANGED, AND WHY IT HAD TO (C15)
// ─────────────────────────────────────────────────────────────────────────────
// This row used to read EASY · DAILY · CHALLENGE, which flattened TWO different
// axes into one strip of three: two of those pills named a difficulty tier and
// the middle one named a round type. That worked while exactly one tier had a
// Daily. Under three modes x two rounds it cannot express the product at all —
// there is no pill you could add for "Expert's Daily" that would not make the
// row mean two things at once.
//
// So the axes are separated. This picks the TIER; RoundToggle picks Daily vs
// Practice; the two together make one wire key via `keyFor(tier, round)`. There
// is deliberately no second vocabulary of tab ids: the project has been bitten
// once by exactly that — 'daily' means Challenge's Daily *because* two
// vocabularies merged and the merge was never undone.
//
// The three pills are equal in size. They used to flank an emphasised centre
// because DAILY was the headline action; now they are three siblings and the
// emphasis belongs to the primary CTA below, not to one tier.
//
// STATUS GLYPHS. Each pill can carry the state of THAT TIER'S DAILY, because the
// whole point of three independent Dailies is that a player may do one, two or
// all three — and they cannot decide which to play without seeing which are
// already spent. A player who solved Easy and forfeited Challenge should be able
// to read that off the picker rather than by tapping each one.
//
// @param {{
//   tier: 'easy'|'challenge'|'expert',
//   statusByMode?: Record<string, string>,   // wire key -> restore()/attempt status
//   onSelectTier: (tier: string) => void,
// }} props

// 8-direction text outline in a given colour (keeps filled neon labels legible).
const outline8 = (color) =>
  ['-1px -1px', '1px -1px', '-1px 1px', '1px 1px', '0 -1px', '0 1px', '-1px 0', '1px 0']
    .map((o) => `${o} 0 ${color}`)
    .join(', ');

// Per-tier styling — the SELECTED segment takes the same cosmic-panel treatment
// as the Roll Dice button, in its own tier accent (easy=green, challenge=cyan,
// expert=gold): a subtle accent tint over the cosmic panel bg + a neon accent
// outline + glow, white label with the deep-shade text outline.
//
// Gold for Expert: in Expert a perfect solve is not a decoration on top of
// winning, it IS winning — so the mode wears the colour the perfect highlight
// uses everywhere else.
const TIER_PILL = {
  easy: { accent: 'var(--u37-green)', outline: outline8('var(--u37-green-deep)') },
  challenge: { accent: 'var(--u37-cyan)', outline: outline8('var(--u37-cyan-deep)') },
  expert: { accent: 'var(--u37-gold)', outline: outline8('var(--u37-gold-deep)') },
};

const activePillStyle = (accent, outline) => ({
  background: `linear-gradient(180deg, color-mix(in srgb, ${accent} 22%, transparent), transparent), var(--u37-panel-bg-cosmic)`,
  borderColor: accent,
  boxShadow: `0 0 16px -5px ${accent}, inset 0 1px 2px rgba(255,255,255,0.18)`,
  textShadow: outline,
});

// The UNSELECTED pills wear a MUTED version of their own tier colour (David,
// 2026-09-29). They used to be plain slate text on the track with no border and
// no fill, so only the selected pill looked like a button — players read the
// other two as labels and played Challenge (the old default landing) instead of
// discovering Easy and Expert. Now each idle pill gets a thin accent border, a
// faint accent wash and accent-tinted text: clearly a tappable button, clearly
// quieter than the selected one. The line it must not cross is the GLOW — no
// box-shadow and no text outline here; those belong to the selected pill alone.
export const idlePillStyle = (accent) => ({
  background: `color-mix(in srgb, ${accent} 10%, transparent)`,
  borderColor: `color-mix(in srgb, ${accent} 40%, transparent)`,
  color: `color-mix(in srgb, ${accent} 70%, white)`,
});

const TIERS = [
  { id: 'easy', label: 'EASY' },
  { id: 'challenge', label: 'CHALLENGE' },
  { id: 'expert', label: 'EXPERT' },
];

// How a tier's Daily reads at a glance. `null` renders nothing — an unplayed
// Daily gets no glyph, because a marker on every pill is a marker on none.
const STATUS_GLYPH = {
  completed: { glyph: '✓', label: 'solved today', color: 'var(--u37-green)' },
  forfeited: { glyph: '✕', label: 'forfeited today', color: 'var(--u37-violet)' },
  in_progress: { glyph: '●', label: 'in progress', color: 'var(--u37-cyan)' },
};

export default function ModeToggle({ tier, statusByMode = {}, onSelectTier }) {
  return (
    <div className="flex items-center justify-center bg-gradient-to-r from-slate-800 via-indigo-950 to-slate-800 backdrop-blur-md rounded-full p-1 border border-indigo-900/40 gap-1 w-full max-w-2xl shadow-[0_4px_16px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.2)]">
      {TIERS.map((t) => {
        const selected = tier === t.id;
        const dailyKey = keyFor(/** @type {any} */ (t.id), 'daily');
        const status = STATUS_GLYPH[statusByMode[dailyKey]];
        return (
          <button
            key={t.id}
            data-testid={`tier-${t.id}`}
            data-selected={String(selected)}
            data-daily-status={statusByMode[dailyKey] || ''}
            onClick={() => onSelectTier(t.id)}
            aria-label={status ? `${t.label} — ${status.label}` : t.label}
            // border-2 border-transparent on every segment reserves the outline's
            // space so selecting a tier never shifts the row; the active style
            // fills in the accent border + cosmic bg + glow.
            className={`relative px-3 py-1.5 min-h-[38px] flex-1 rounded-full border-2 border-transparent text-[10px] sm:text-xs font-bold transition-all duration-200 touch-manipulation ${selected ? 'text-white' : 'hover:brightness-125'}`}
            style={selected
              ? activePillStyle(TIER_PILL[t.id].accent, TIER_PILL[t.id].outline)
              : idlePillStyle(TIER_PILL[t.id].accent)}
          >
            {t.label}
            {status && (
              <span
                aria-hidden
                data-testid={`tier-${t.id}-status`}
                className="ml-1 text-[10px] align-middle"
                style={{ color: status.color, textShadow: `0 0 6px ${status.color}` }}
              >
                {status.glyph}
              </span>
            )}
          </button>
        );
      })}
    </div>
  );
}

// Convenience for callers that hold a full wire key rather than a tier.
export const tierOf = modeOf;
