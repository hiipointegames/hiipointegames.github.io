import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { PodiumBanner } from '@/leaderboard';
import { DAILY_MODE_KEYS, modeOf, keyFor } from '@/game-modes';
import { modeThemeName } from '@/game-flow';

// The ladder arrows.
//
// They were a bare 20px chevron in the accent colour with no background — easy
// to read as decoration rather than as a control, which is why players were
// missing that the other two tiers' podiums are one tap away (David,
// 2026-09-17: "make those arrows larger and more eye-catching").
//
// Now a filled neon disc: bigger glyph, a solid accent ring, a halo, and a slow
// looping nudge in the direction it travels. The nudge is the part that reads as
// "this moves you somewhere" rather than "this is a corner ornament".
//
// HEIGHT IS THE CONSTRAINT. The home launcher must not grow — it is a
// deliberately zero-scroll screen — so the tap target goes up from 36px to a
// properly tappable 44px while `-my-1` pulls the extra 8px back out of the flex
// row. The row is the same height it was; only the control inside it is bigger.
function LadderArrow({ direction, disabled, label, onClick, testId }) {
  const reduce = useReducedMotion();
  const Icon = direction === 'prev' ? ChevronLeft : ChevronRight;
  const dx = direction === 'prev' ? -2.5 : 2.5;

  return (
    <button
      type="button"
      data-testid={testId}
      aria-label={label}
      disabled={disabled}
      onClick={onClick}
      // ⚠️ THE 44px HIT AREA AND THE VISIBLE CIRCLE ARE DELIBERATELY DIFFERENT
      // SIZES (2026-09-17). David asked for the arrows to be "ever so slightly"
      // smaller, and the obvious edit — shrinking the button — would have taken
      // the tap target under the 44px minimum these were raised to in the first
      // place. So the BUTTON keeps 44x44 and the ring moved onto the inner span
      // at 38px. It looks smaller and is exactly as easy to hit.
      className="shrink-0 -my-1 rounded-full transition-opacity disabled:opacity-0 disabled:pointer-events-none touch-manipulation min-h-[44px] min-w-[44px] flex items-center justify-center active:scale-95"
      style={{ color: 'var(--u37-mode-accent)' }}
    >
      <motion.span
        aria-hidden
        className="inline-flex items-center justify-center rounded-full w-[38px] h-[38px]"
        style={{
          background: 'color-mix(in srgb, var(--u37-mode-accent) 16%, transparent)',
          border: '2px solid var(--u37-mode-accent)',
          boxShadow: '0 0 16px -4px var(--u37-mode-accent), inset 0 0 14px -10px var(--u37-mode-accent)',
        }}
        animate={reduce || disabled ? undefined : { x: [0, dx, 0] }}
        transition={reduce || disabled ? undefined : { duration: 1.1, repeat: Infinity, repeatDelay: 1.4, ease: 'easeInOut' }}
      >
        <Icon className="w-5 h-5" strokeWidth={3} />
      </motion.span>
    </button>
  );
}

// PodiumShowcase — the home launcher's "Tighten + elevate" treatment for the live
// daily podium (David, 2026-07-26). The podium is a DISTINCT, elevated showcase
// block: a home-scoped pedestal frames it in a soft gold spotlight with generous
// breathing room, so it reads as the featured element of the home screen.
//
// It deliberately does NOT edit the shared <PodiumBanner> (that component is part
// of the @/leaderboard subsystem surface): the "grander" treatment is applied
// entirely via this home-scoped wrapper, so the leaderboard is unaffected.
//
// Static by design — two reasons, both device-driven:
//   1. No transform on the podium. Its trophies are filtered SVGs, and a transform
//      on a filtered SVG re-rasterizes the filter on the Android WebView (the
//      documented GameHeader/logo flicker). The pedestal grows the *frame*, not
//      the SVGs, so nothing re-rasterizes.
//   2. No added motion, so there is no reduced-motion branch to gate — the
//      elevation is pure static color/space (gold-tinted, never a white/bright
//      surface), keeping the dark cosmic-neon theme coherent.
//
// ─────────────────────────────────────────────────────────────────────────────
// ONE PODIUM AT A TIME (David, 2026-08-31)
// ─────────────────────────────────────────────────────────────────────────────
// This block used to stack all THREE Dailies' podiums at once (C16 / ruling Q-D),
// which is what made the home screen materially taller — the open concern the
// 08-27 decision record flagged for David's eyes on a real phone. His ruling:
//
//   "i do not want all three podiums viewable on any one page - so the challenge
//    should only see challenge, and the podiums can have clickable arrows that
//    will swipe to the next page (left arrow on challenge takes to easy, right
//    arrow on challenge podium takes to expert.)"
//
// So exactly one podium renders — the one for the SELECTED tier — and the arrows
// step along the Easy → Challenge → Expert ladder.
//
// ⚠️ THE ARROWS MOVE THE WHOLE TIER SELECTION, not just the podium (David's call,
// 2026-08-31). They call `onSelectTier` — the SAME callback ModeToggle's tabs
// call — so the tab, the podium and the Start button can never disagree about
// which tier you are on: there is ONE selected-tier state, not two. Routing
// through the shared setter (rather than composing a wire key here) is also what
// keeps the ROUND handling in one place: the parent's switchTier preserves it, so
// arrowing while on Practice keeps you on Practice.
//
// The podium always shows the DAILY board for the selected tier, in both rounds:
// it is "today's board for this tier", which is a fact about the tier rather than
// about which round you happen to be about to play.
//
// Arrows STOP at the ends rather than wrapping (David's call): Easy has no left
// arrow and Expert has no right one, so the missing arrow tells you where you are
// on the difficulty ladder. Wrapping would erase that ordering cue.
//
// Colour follows the TIER via `data-mode` — Easy green, Challenge cyan, Expert
// gold.
//
// ⚠️ THE PEDESTAL FOLLOWS THE TIER TOO, AS OF 2026-09-17, REVERSING THE RULING
// BELOW. It used to be gold-rimmed on purpose: that gold was the trophy/medal
// metaphor (matching --u37-medal-gold) rather than Expert's mode colour, and the
// argument was that recolouring the whole plinth per tier would read as three
// different components rather than one showcase holding three boards.
//
// David overruled it from the phone: "we have too much gold on every screen
// otherwise." In practice the argument did not survive contact — on a Challenge
// board the cyan arrows and cyan label sat inside a gold frame around a gold
// card, so the one element telling you which tier you were on was outvoted by
// the chrome around it. The medals inside the card are still gold/silver/bronze;
// that is where the trophy metaphor actually lives.
//
// Purely presentational.
const TIER_LABEL = { easy: 'Easy', challenge: 'Challenge', expert: 'Expert' };

/** The daily wire key for whichever tier `mode` is on. */
const dailyKeyOf = (mode) => keyFor(modeOf(mode), 'daily');

/**
 * @param {object} props
 * @param {string} [props.mode] the selected wire key (either round)
 * @param {(tier: string) => void} [props.onSelectTier] the SAME setter ModeToggle uses
 */
export default function PodiumShowcase({ mode = 'daily', onSelectTier }) {
  // `modeOf` already coerces anything unrecognised to 'easy' (its documented safe
  // failure, the same one modeTheme relies on), so `dailyKeyOf` always returns a
  // real DAILY_MODE_KEYS member and this index is never -1. An extra "unknown ->
  // Challenge" guard here would be unreachable code, not defence.
  const safeIndex = DAILY_MODE_KEYS.indexOf(dailyKeyOf(mode));

  const step = (delta) => {
    const next = DAILY_MODE_KEYS[safeIndex + delta];
    if (!next || !onSelectTier) return;
    // A TIER, exactly as ModeToggle emits — the parent owns turning it into a
    // wire key, so the arrows and the tabs cannot drift apart.
    onSelectTier(modeOf(next));
  };

  const canPrev = safeIndex > 0;
  const canNext = safeIndex < DAILY_MODE_KEYS.length - 1;
  const shownKey = DAILY_MODE_KEYS[safeIndex];

  return (
    <div
      data-testid="podium-showcase"
      data-mode={modeThemeName(shownKey)}
      data-podium-mode={shownKey}
      // pt-5/pb-4 → pt-3/pb-2 (2026-09-11): 14px of the ~195px the launcher
      // needed back on Challenge, taken from padding rather than from anything
      // a player can see — the pedestal, the spotlight frame and all three
      // places are untouched.
      className="relative w-full max-w-md mx-auto px-3 pt-3 pb-2 rounded-3xl"
      style={{
        // Elevated pedestal: a faint translucent dark platform (cosmic, not white)
        // that lifts the podium off the starfield as its own block, with a soft
        // gold rim so the showcase reads as distinct without competing with the
        // podium card's own gold border.
        // `var(--u37-mode-accent)` is safe HERE, unlike in PodiumBanner: this
        // element sets data-mode from `modeThemeName`, which is the TIER name the
        // token slot is keyed by.
        background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-mode-accent) 5%, transparent), rgba(6,10,18,0.35))',
        border: '1px solid color-mix(in srgb, var(--u37-mode-accent) 22%, transparent)',
        boxShadow: '0 10px 34px -18px rgba(0,0,0,0.75), inset 0 1px 0 color-mix(in srgb, var(--u37-mode-accent) 14%, transparent)',
      }}
    >
      {/* Soft tier-coloured spotlight behind the podium — a pure CSS radial gradient (no SVG
          filter, so it can never trigger the filtered-SVG re-raster), gold-tinted
          to stay cosmic-coherent. Elevates the podium as the featured block. */}
      <div
        aria-hidden="true"
        data-testid="podium-spotlight"
        className="pointer-events-none absolute inset-0 rounded-3xl"
        style={{
          background:
            'radial-gradient(120% 88% at 50% 40%, color-mix(in srgb, var(--u37-mode-accent) 18%, transparent), transparent 68%)',
        }}
      />
      <div className="relative">
        {/* Tier label flanked by the ladder arrows. The label wears the tier
            accent so the colour and the word agree at a glance. */}
        <div className="mb-1 flex items-center justify-between gap-2">
          <LadderArrow
            direction="prev"
            testId="podium-prev"
            label={canPrev ? `Show ${TIER_LABEL[modeOf(DAILY_MODE_KEYS[safeIndex - 1])]} podium` : 'No easier tier'}
            disabled={!canPrev}
            onClick={() => step(-1)}
          />

          <div
            data-testid="podium-tier-label"
            className="text-center text-[10px] font-black tracking-widest uppercase"
            style={{ color: 'var(--u37-mode-accent)' }}
          >
            {TIER_LABEL[modeOf(shownKey)]}
          </div>

          <LadderArrow
            direction="next"
            testId="podium-next"
            label={canNext ? `Show ${TIER_LABEL[modeOf(DAILY_MODE_KEYS[safeIndex + 1])]} podium` : 'No harder tier'}
            disabled={!canNext}
            onClick={() => step(1)}
          />
        </div>

        <div data-testid={`podium-${shownKey}`}>
          {/* The frozen C16 seam. `mode` is W2-BOARDS' prop and does not
              exist on PodiumBanner's signature until that lane merges, so the
              cast is what lets this build against the contract as written.
              Delete the cast once W2-BOARDS has landed. */}
          <PodiumBanner {.../** @type {any} */ ({ mode: shownKey })} />
        </div>
      </div>
    </div>
  );
}
