import React from 'react';
import { MiniDice } from '@/puzzle-input';
import { modeOf, keyFor } from '@/game-modes';
import { modeThemeName } from '@/game-flow';
import { readPerModeStats, dailyModeFullLabel } from '@/components/stats/dailyModeStats';

// DailyStreakTrack — the seven-day streak track for ONE Daily tier (David,
// 2026-08-31), replacing the throttled Challenge-only satellite pop-up as the way
// a player sees where they are in a week.
//
//   "every daily challenge should have its own 7 day satellite counter ... but
//    color coded to each specific daily and relevant to each specific modes
//    streak, appearing constantly until the first time a player achieves a 7 day
//    streak in the given modes daily"
//
//   "go 1 through 6 die values and just make the 7th day a greyed out trophy"
//
// So: SIX real dice showing faces 1-6 — the die's face IS the day number, which
// is why the values are fixed rather than decorative — then a seventh slot that
// is a trophy rather than an impossible seven-pip die. Each won day is engulfed
// in flame with the die still visible underneath, so a full week reads as six
// burning dice and a claimed trophy.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT RETIRES, AND THE ONE SUBTLETY IN "UNTIL"
// ─────────────────────────────────────────────────────────────────────────────
// It disappears for good once the player has ever hit a 7-day streak in THIS
// mode. That fact is `longestStreak >= 7` — a server-derived number from the
// `perMode` blob, deliberately NOT a localStorage flag like the old satellite
// throttle used, because a device-local flag loses the retirement on a second
// device and would resurrect a track the player has already finished.
//
// ⚠️ Retiring on `longestStreak >= 7` ALONE would mean the player never sees the
// payoff: the same solve that lights the trophy also sets longestStreak to 7, so
// the completed track would vanish in the very render that earned it. So the
// rule is "has hit 7 AND is not currently sitting on that completion":
//
//   hidden  <=>  longestStreak >= 7 && currentStreak !== 7
//
// which shows the full lit track on the day it is completed and is gone from the
// next day onward. The comparison is `!==`, not `<`: with `<`, a streak of 8
// would read as "not yet past the payoff" and the track would never retire at
// all for a player who simply kept going. A player who breaks the streak after a
// past 7 stays hidden, which is the ruling.
//
// `tracked: false` renders NOTHING rather than an empty track. "This player has
// a zero Easy streak" and "nothing has ever tracked an Easy streak" are
// different facts, and a row of seven cold dice would tell a player they failed
// at something that does not exist yet — the distinction the lane contract calls
// out explicitly. Until `get-player-stats` ships `perMode`, Easy and Expert are
// untracked and simply render nothing here.
//
// Colour follows the TIER via `data-mode`, like every other surface. The DICE
// stay white — they are real 37 dice, and MiniDice's palette is the power-die
// vocabulary (red/blue/green), which would say something untrue here. The tier
// colour is carried by the frame, the caption and the lit glow instead.
//
// Purely presentational; all state arrives as props.

/** Days 1-6 are dice whose FACE is the day number. Day 7 is the trophy. */
export const DICE_DAYS = Object.freeze([1, 2, 3, 4, 5, 6]);
export const STREAK_TARGET = 7;

/**
 * Whether the track should render at all for this mode.
 *
 * @param {{currentStreak: number, longestStreak: number, tracked: boolean}} s
 * @returns {boolean}
 */
export function shouldShowStreakTrack(s) {
  if (!s || !s.tracked) return false;
  // Retired once a 7 has ever been reached — except while sitting EXACTLY on that
  // completion, so the finished track is actually seen the day it is earned.
  // `!==`, not `<`: a streak of 8 is past the payoff and must hide, which a `<`
  // comparison silently kept visible forever.
  if (s.longestStreak >= STREAK_TARGET && s.currentStreak !== STREAK_TARGET) return false;
  return true;
}

/**
 * @param {object} props
 * @param {string} [props.mode] the selected wire key (either round)
 * @param {any} [props.gameStats] the player's game_stats blob
 */
export default function DailyStreakTrack({ mode = 'daily', gameStats }) {
  const dailyKey = keyFor(modeOf(mode), 'daily');
  const stats = readPerModeStats(gameStats).byMode[dailyKey];

  if (!shouldShowStreakTrack(stats)) return null;

  const streak = Math.max(0, Math.min(stats.currentStreak, STREAK_TARGET));
  const trophyWon = streak >= STREAK_TARGET;

  return (
    <div
      data-testid="daily-streak-track"
      data-mode={modeThemeName(dailyKey)}
      data-streak={streak}
      // py-2 → py-1 and the label's mb-1.5 → mb-1 (2026-09-11): this track is
      // the reason CHALLENGE is the tallest of the three launchers (+78px over
      // Easy/Expert, which show no track), and it was the last 3px standing
      // between Challenge and a podium that fits. Padding only — every pip, the
      // label and the flame are untouched.
      className="w-full max-w-md mx-auto px-3 py-1 rounded-2xl"
      style={{
        border: '1px solid color-mix(in srgb, var(--u37-mode-accent) 22%, transparent)',
        background: 'color-mix(in srgb, var(--u37-mode-accent) 6%, transparent)',
      }}
    >
      <div
        data-testid="streak-caption"
        className="mb-1 text-center text-[10px] font-black tracking-widest uppercase"
        style={{ color: 'var(--u37-mode-accent)' }}
      >
        {dailyModeFullLabel(dailyKey)} streak — {streak} of {STREAK_TARGET}
      </div>

      <div className="flex items-center justify-center gap-1 sm:gap-1.5">
        {DICE_DAYS.map((day) => {
          const won = streak >= day;
          return (
            <div
              key={day}
              data-testid={`streak-day-${day}`}
              data-won={won ? 'true' : 'false'}
              className="relative shrink-0"
              // The lit glow is the tier's colour; unwon days sit dim and flat so
              // the burning ones are the only thing that draws the eye.
              style={{
                opacity: won ? 1 : 0.35,
                filter: won ? 'drop-shadow(0 0 6px var(--u37-mode-accent))' : 'none',
              }}
            >
              <MiniDice value={day} color="white" />
              {won && (
                // Engulfed, not replaced: the flame sits ON the die so a full
                // week still reads as a row of DICE (David's call).
                <span
                  aria-hidden="true"
                  data-testid={`streak-flame-${day}`}
                  className="pointer-events-none absolute inset-0 flex items-center justify-center text-lg leading-none"
                >
                  🔥
                </span>
              )}
            </div>
          );
        })}

        {/* Day 7 is a trophy, not an impossible seven-pip die. Greyed out until
            the week is complete, then gold. */}
        <div
          data-testid="streak-day-7"
          data-won={trophyWon ? 'true' : 'false'}
          className="relative shrink-0 w-8 h-8 flex items-center justify-center text-xl leading-none"
          style={{
            opacity: trophyWon ? 1 : 0.35,
            filter: trophyWon ? 'drop-shadow(0 0 8px var(--u37-gold))' : 'grayscale(1)',
          }}
        >
          🏆
        </div>
      </div>
    </div>
  );
}
