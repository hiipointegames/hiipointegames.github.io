/**
 * Build an 8-direction 1px text outline (a `text-shadow` value) in a given
 * colour. Keeps filled neon-button labels legible without per-mode hardcoded
 * hexes — pass a CSS custom property (e.g. `var(--u37-mode-accent-deep)`) and
 * the outline resolves per theme/mode.
 *
 * Pure — extracted from a module-scope helper in Game.jsx.
 *
 * @param {string} color - any CSS colour (a hex, rgb(), or a CSS var()).
 * @returns {string} a comma-joined `text-shadow` covering all 8 neighbours.
 */
export function outline8(color) {
  return ['-1px -1px', '1px -1px', '-1px 1px', '1px 1px', '0 -1px', '0 1px', '-1px 0', '1px 0']
    .map((o) => `${o} 0 ${color}`)
    .join(', ');
}
