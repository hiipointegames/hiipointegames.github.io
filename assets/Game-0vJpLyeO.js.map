import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { Button } from '@/ui/primitives/button';
import { isDaily, modeTierLabel } from '@/game-modes';
import { DAILY_LIMIT_LABEL } from '@/daily-challenge/dailyLimit';

// The launcher's primary action button, plus — for a recoverable daily — a kind
// reassurance line above it. Labels:
//   • "Roll Dice & Play Now"  — easy / challenge (Beta-2 refinement 2026-07-26:
//                               was "Roll Dice"; the fuller CTA nudges the tap)
//   • "Start Easy/Challenge/Expert Daily" — a fresh daily, NAMED BY TIER
//                               (David, 2026-09-12). It used to read "Start
//                               Daily Challenge" for all three, which was both
//                               ambiguous — three Dailies exist and the button
//                               did not say which one it would start — and
//                               actively wrong on Easy and Expert, where the word
//                               "Challenge" names a DIFFERENT tier.
//   • "Continue Daily"        — a daily attempt that was interrupted mid-play
//                               (reload / crash / phone-lock) and is still
//                               recoverable (< 1h). Tapping it resumes the SAME
//                               attempt with the correct elapsed time.
// The leading 🎲 glyph is split into its own element and given a subtle looping
// wiggle (Beta-2 refinement) to draw the eye to the primary action — disabled
// under prefers-reduced-motion. Presentational — Game.jsx owns the handlers and
// passes the `recoverable` signal from useDailyChallengeAttempt.
//
//   • "Today's puzzle isn't ready" — a Daily whose mode has NO daily_challenges
//                               row for today. This is now the DEFENSIVE case
//                               rather than the everyday one: production banks
//                               all three modes for every date (verified
//                               2026-09-05 — 3 of 3 modes on every date from
//                               2026-09-03 through 2026-09-11). It stays because
//                               a missing row is still possible if the cron
//                               fails, and that is exactly when the player must
//                               not be sent into a dead board.
//                               The button is DISABLED rather than hidden:
//                               a mode that vanishes from the picker reads as a
//                               bug, and a mode that starts and then fails spends
//                               the player's one attempt of the day on a board no
//                               other player is playing.
//
// @param {{
//   mode: 'easy'|'challenge'|'expert'|'daily_easy'|'daily'|'daily_expert',
//   recoverable: boolean,
//   puzzleMissing?: boolean|null,   // null = we have not looked yet
//   labelOutline: string, onRoll: () => void, onContinue: () => void,
// }} props
export default function DailyEntryButton({ mode, recoverable, puzzleMissing = null, labelOutline, onRoll, onContinue }) {
  const reduce = useReducedMotion();
  const isContinue = isDaily(mode) && recoverable;
  // Only a DAILY can be missing a puzzle — practice rolls its own dice locally.
  // `null` means unasked, so the button never flashes unavailable before we know.
  const unavailable = isDaily(mode) && puzzleMissing === true;
  // Text label WITHOUT the die (the die is rendered + animated separately).
  const label = unavailable
    ? "Today's puzzle isn't ready"
    : isDaily(mode)
      // `modeTierLabel` maps the wire key to the word a player knows: 'daily' is
      // Challenge's Daily (a storage legacy), never the label.
      ? (recoverable ? 'Continue Daily' : `Start ${modeTierLabel(mode)} Daily`)
      : 'Roll Dice & Play Now';

  return (
    <>
      {unavailable && (
        <div className="flex justify-center px-4 pt-1">
          <p className="text-center text-xs font-semibold max-w-md text-slate-400">
            No puzzle has been set for this mode today. Try another mode — each
            one has its own puzzle, its own leaderboard and its own streak.
          </p>
        </div>
      )}
      {isContinue && (
        <div className="flex justify-center px-4 pt-1">
          <p
            className="text-center text-xs font-semibold max-w-md"
            style={{
              color: 'var(--u37-cyan)',
              textShadow: '0 0 8px color-mix(in srgb, var(--u37-cyan) 40%, transparent)',
            }}
          >
            {/* NOT "jump back in to continue where you left off" (David,
                2026-09-11, from the device). That apologises and then implies the
                clock waited for you — which is the one thing that is not true.
                The attempt is timed from the server-written start and keeps
                running while the app is closed, so a resumed Daily has LESS
                time left, not the same amount. Same class of untruth as the
                refusal toast and the rules modal, both corrected this week. */}
            Your clock is still running — jump back in before {DAILY_LIMIT_LABEL} is up.
          </p>
        </div>
      )}
      <div className="flex justify-center items-center py-1 px-4">
        <motion.div whileHover={{ scale: 1.02 }} whileTap={{ scale: 0.98 }} className="w-full max-w-md">
          {/* Cosmic-panel-pill treatment (David, 2026-07-10) — BOLD primary: the
              cosmic panel bg under a subtle per-mode-accent tint, a thick bright
              accent border + strong neon halo, and a slow shimmer sweep. Keeps the
              mode identity via `--u37-mode-accent` and clearly outranks the thin
              outlined How-to button below it. */}
          <Button
            data-testid="daily-entry-button"
            data-unavailable={String(unavailable)}
            disabled={unavailable}
            onClick={unavailable ? undefined : (isContinue ? onContinue : onRoll)}
            style={{
              // Bolder primary (David, 2026-07-31, from Bryce's 1.0.287 note that
              // this button didn't stand out enough against How to Play & Win and
              // Battle Friends): a stronger accent wash, a thicker border and a
              // real outer halo instead of the previous near-flat one. Still keyed
              // to --u37-mode-accent, so ALL THREE primaries get the identical
              // treatment in their own colour — Start Daily Challenge (cyan) and
              // Roll Dice & Play Now in challenge (cyan) and easy (green) — they
              // are one component. Width stays max-w-md: it is the widest of the
              // three stacked buttons, and the two below taper in under it.
              background: 'linear-gradient(180deg, color-mix(in srgb, var(--u37-mode-accent) 30%, transparent), transparent), var(--u37-panel-bg-cosmic)',
              border: '3px solid var(--u37-mode-accent)',
              boxShadow: '0 0 26px -6px var(--u37-mode-accent), 0 10px 26px -10px var(--u37-mode-accent), inset 0 1px 5px rgba(255,255,255,0.28)',
            }}
            className={`relative w-full overflow-hidden text-white font-black text-lg px-6 py-4 rounded-2xl min-h-[56px] touch-manipulation transition-all duration-300 ${unavailable ? 'opacity-60 cursor-not-allowed' : 'hover:brightness-110'}`}
          >
            {/* Slow shimmer sweep — a soft diagonal light band crossing the pill. */}
            <motion.span
              aria-hidden
              className="pointer-events-none absolute inset-y-0 -left-1/3 w-1/3 skew-x-[-18deg]"
              style={{ background: 'linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent)' }}
              animate={{ x: ['0%', '460%'] }}
              transition={{ duration: 3.2, repeat: Infinity, ease: 'easeInOut', repeatDelay: 1.6 }}
            />
            <span className="relative flex items-center justify-center gap-2">
              {/* Attention wiggle on the die glyph (Beta-2 refinement) — a small
                  periodic shake + rotate to pull the eye to the primary action.
                  Tasteful, not frantic: a short shake then a ~1.9s rest. Disabled
                  entirely under prefers-reduced-motion (renders a still die). */}
              <motion.span
                aria-hidden
                data-testid="roll-die-glyph"
                className="inline-block"
                style={{ transformOrigin: '50% 60%' }}
                animate={reduce || unavailable ? undefined : { rotate: [0, -16, 13, -9, 6, 0], x: [0, -1.5, 1.5, -1, 1, 0] }}
                transition={reduce || unavailable ? undefined : { duration: 0.9, repeat: Infinity, repeatDelay: 1.9, ease: 'easeInOut' }}
              >
                🎲
              </motion.span>
              <span style={{ color: 'white', textShadow: labelOutline }}>{label}</span>
            </span>
          </Button>
        </motion.div>
      </div>
    </>
  );
}
