// Podium derivation — who finished 1st / 2nd / 3rd on a given date.
//
// Read path for the podium-finish badge awarding logic in Game.jsx,
// which used to inline a sort + findIndex(...) + 1 to decide whether
// the current user landed on the podium for past unawarded dates.

import { getLeaderboard, getUserRank, DEFAULT_DAILY_MODE } from './leaderboard';

// Returns { first, second, third } — each is the leaderboard entry (or
// null if the leaderboard has fewer entries). Same date contract as
// getLeaderboard.
//
// `mode` selects WHICH Daily's podium — Challenge's by default (the legacy
// 'daily' key). Each mode has its own podium: Q-D rules all boards and podiums
// per mode, and a podium is a pure function of that mode's completion rows.
export async function getPodium({ date, mode = DEFAULT_DAILY_MODE }) {
  const leaderboard = await getLeaderboard({ date, mode });
  return {
    first: leaderboard[0] || null,
    second: leaderboard[1] || null,
    third: leaderboard[2] || null,
  };
}

// Returns the podium slot the user finished in for the given date, as
// one of 'first' | 'second' | 'third' | null (no podium finish).
// Caller can also pass a pre-fetched leaderboard via the second arg to
// avoid a re-fetch when both leaderboard and podium are needed.
// A pre-fetched `leaderboard` (second arg) is trusted to be THIS mode's board —
// the caller fetched it; re-fetching to check would defeat the point of passing
// it. Pass the board you got from the same mode you name here.
export async function getUserPodiumFinish({ date, mode = DEFAULT_DAILY_MODE, userId }, leaderboard = null) {
  if (!userId) return null;
  const lb = leaderboard || await getLeaderboard({ date, mode });
  const rank = getUserRank(lb, userId);
  if (rank === 1) return 'first';
  if (rank === 2) return 'second';
  if (rank === 3) return 'third';
  return null;
}
