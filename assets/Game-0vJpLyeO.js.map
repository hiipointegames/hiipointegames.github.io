import React, { useCallback, useEffect, useState } from 'react';
import { dailyModeAccent } from "./modeAccent";
import { Link } from 'react-router-dom';
import { DiceLoader } from '@/dice-visuals';
import { createPageUrl } from '@/routing/createPageUrl';
import { getPodium } from '@/stats-aggregation';
import { todayET } from '@/daily-challenge';
import { dailyModeLabel, DEFAULT_DAILY_MODE } from './dailyModeTabs';
import { formatSolveTime, playSound } from '@/ui/feedback';
import { rowDisplayName, isLinkableRow } from './guestName';

// Live top-3 podium for TODAY's daily challenge, shown on the home launcher.
// Polls (~45s) + refetches on window focus — no realtime infra (CapGo-clean).
// Metallic trophy SVGs (gold/silver/bronze), real country flags, 1st enlarged +
// glowing. Tapping a named (non-guest) player → their public profile.

// Per-position metallic palette: [light, mid, dark] stops + a glow color.
const METAL = {
  first: { light: '#fff4c2', mid: '#fbbf24', dark: '#b45309', glow: 'rgba(251,191,36,0.65)', ring: 'var(--u37-gold)' },
  second: { light: '#f8fafc', mid: '#cbd5e1', dark: '#64748b', glow: 'rgba(203,213,225,0.55)', ring: '#cbd5e1' },
  third: { light: '#fcd9b6', mid: '#d97706', dark: '#7c2d12', glow: 'rgba(217,119,6,0.5)', ring: '#d97706' },
};

// A crafted metallic trophy. `size` is the cup width in px; the gradient id must
// be unique per render so multiple trophies don't share one <defs> stop set.
function Trophy({ position, size }) {
  const m = METAL[position];
  const gid = `trophy-${position}`;
  return (
    <svg
      width={size}
      height={size * 1.15}
      viewBox="0 0 48 56"
      fill="none"
      aria-hidden="true"
      style={{ filter: `drop-shadow(0 0 ${position === 'first' ? 10 : 5}px ${m.glow})` }}
    >
      <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor={m.light} />
          <stop offset="45%" stopColor={m.mid} />
          <stop offset="100%" stopColor={m.dark} />
        </linearGradient>
      </defs>
      {/* handles */}
      <path d="M9 10 Q1 10 1 19 Q1 28 12 29" stroke={`url(#${gid})`} strokeWidth="3" fill="none" />
      <path d="M39 10 Q47 10 47 19 Q47 28 36 29" stroke={`url(#${gid})`} strokeWidth="3" fill="none" />
      {/* cup */}
      <path d="M11 6 H37 V18 Q37 31 24 33 Q11 31 11 18 Z" fill={`url(#${gid})`} />
      {/* sheen */}
      <path d="M15 9 H20 V18 Q20 25 17 27 Q15 24 15 18 Z" fill="rgba(255,255,255,0.35)" />
      {/* stem + base */}
      <rect x="21.5" y="33" width="5" height="8" fill={`url(#${gid})`} />
      <rect x="14" y="41" width="20" height="4" rx="1.5" fill={`url(#${gid})`} />
      <rect x="11" y="45" width="26" height="5" rx="2" fill={`url(#${gid})`} />
    </svg>
  );
}

// A guest (no real username) isn't linkable to a public profile.
// One rule for every board (case-insensitive, like the server) — @/leaderboard guestName.
const isLinkable = (entry) => isLinkableRow(entry);

function PodiumColumn({ position, entry, heightStep }) {
  const m = METAL[position];
  const first = position === 'first';
  const trophySize = first ? 44 : 34;

  const nameNode = (() => {
    const cls = 'text-xs font-bold text-slate-100 truncate max-w-[88px] text-center';
    if (!entry) return <span className={`${cls} text-slate-500`}>—</span>;
    const label = rowDisplayName(entry);
    if (isLinkable(entry) && entry.user_id) {
      return (
        <Link
          to={`${createPageUrl('OtherProfile')}?id=${entry.user_id}&returnTo=Game`}
          onClick={() => playSound('buttonTap')}
          className={`${cls} hover:text-[var(--u37-gold)] transition-colors`}
        >
          {label}
        </Link>
      );
    }
    return <span className={cls}>{label}</span>;
  })();

  // Item 10: tapping a trophy jumps to today's Global daily board, scrolled to
  // that player's row. The name still links to their public profile (above), so
  // the two targets stay distinct. Empty podium slots aren't tappable.
  const trophyNode = <Trophy position={position} size={trophySize} />;

  return (
    <div className="flex flex-col items-center gap-1 flex-1 min-w-0" style={{ marginTop: heightStep }}>
      {entry?.user_id ? (
        <Link
          to={`${createPageUrl('Leaderboard')}?tab=daily&focus=${entry.user_id}`}
          onClick={() => playSound('buttonTap')}
          aria-label={`View ${entry.user_name || 'this player'} on the leaderboard`}
          className="transition-transform hover:scale-110 active:scale-95"
        >
          {trophyNode}
        </Link>
      ) : (
        trophyNode
      )}
      {entry?.user_country && (
        <img
          src={`https://flagcdn.com/w40/${String(entry.user_country).toLowerCase()}.png`}
          alt=""
          className="w-6 h-4 object-cover rounded"
        />
      )}
      {nameNode}
      <span
        className="text-[11px] font-black"
        style={{ color: entry ? m.ring : 'rgba(148,163,184,0.6)' }}
      >
        {entry ? formatSolveTime(entry.solve_time_seconds) : '·'}
      </span>
    </div>
  );
}

/**
 * ONE mode's live top-3 for today.
 *
 * C16 — THE SEAM. The home launcher renders three of these, one per key in
 * DAILY_MODE_KEYS. `mode` is the entire contract: the home page never reaches
 * into src/leaderboard/ for anything else, and this component never learns how
 * many podiums are on screen or in what order. Defaulting to Challenge's Daily
 * keeps every existing `<PodiumBanner />` call site correct with no edit.
 *
 * @param {{mode?: string}} props daily wire key — 'daily_easy' | 'daily' | 'daily_expert'
 */
export default function PodiumBanner({ mode = DEFAULT_DAILY_MODE }) {
  const [podium, setPodium] = useState(null);
  const [loading, setLoading] = useState(true);

  const load = useCallback(async () => {
    try {
      const result = await getPodium({ date: todayET(), mode });
      setPodium(result);
    } catch (error) {
      console.error('Failed to load podium:', error);
    } finally {
      setLoading(false);
    }
  }, [mode]);

  useEffect(() => {
    let cancelled = false;
    // A mode switch must clear the previous mode's three players rather than
    // leave them on screen under the new heading while the refetch runs.
    setPodium(null);
    setLoading(true);
    const run = () => { if (!cancelled) load(); };
    run();
    const interval = setInterval(run, 45000);
    window.addEventListener('focus', run);
    return () => {
      cancelled = true;
      clearInterval(interval);
      window.removeEventListener('focus', run);
    };
  }, [load]);

  // THE CARD WEARS ITS TIER, NOT GOLD (David, 2026-09-17): "lets also make the
  // outline and background that is on the podium display on the main game page
  // be mode specific coloring please. we have too much gold on every screen
  // otherwise… gold for expert, cyan for challenge, and green for easy."
  //
  // `dailyModeAccent` already answers exactly that — easy green, challenge cyan,
  // expert gold — so this is the existing tier palette reaching one more surface,
  // not a new colour decision.
  //
  // ⚠️ NOT `var(--u37-mode-accent)`. This element sets `data-mode={mode}` with a
  // WIRE key, and the token slot is keyed by TIER: [data-mode="daily"] resolves
  // to violet, so painting from the slot here would have turned the Challenge
  // board purple. The JS map takes the key through `modeOf` and cannot make that
  // mistake. (modeAccent.js documents why both mechanisms exist.)
  //
  // ⚠️ THE MEDALS STAY GOLD/SILVER/BRONZE. Those are the trophy metaphor, not the
  // mode colour — see POSITION_STYLES at the top of this file. Recolouring them
  // per tier would say a first place on Easy is a different KIND of first place.
  const ACCENT = dailyModeAccent(mode);
  const headerStyle = {
    color: ACCENT,
    background: `color-mix(in srgb, ${ACCENT} 14%, transparent)`,
    borderColor: ACCENT,
    boxShadow: `0 0 16px -5px ${ACCENT}, inset 0 0 18px -11px ${ACCENT}`,
    textShadow: `0 0 8px color-mix(in srgb, ${ACCENT} 55%, transparent)`,
  };

  const hasAny = podium && (podium.first || podium.second || podium.third);

  return (
    <div
      data-testid="podium-banner"
      data-mode={mode}
      className="w-full max-w-md mx-auto rounded-2xl border px-3 py-1.5 mb-1.5 backdrop-blur-sm"
      style={headerStyle}
    >
      {/* Names the MODE, because three of these can sit on the home page at
          once and "Today's Daily Challenge Podium" three times over says
          nothing. `dailyModeLabel` translates the wire key ('daily' is
          Challenge's) into the word a player recognises. */}
      <div className="text-center text-[10px] font-black uppercase tracking-widest mb-1">
        Today's {dailyModeLabel(mode)} Daily Podium
      </div>

      {loading ? (
        <div className="flex items-center justify-center py-4">
          <DiceLoader size={30} label="" />
        </div>
      ) : hasAny ? (
        // Standard podium order: 2nd · 1st · 3rd, with a modest height step.
        <div className="flex items-end justify-center gap-2">
          <PodiumColumn position="second" entry={podium.second} heightStep={8} />
          <PodiumColumn position="first" entry={podium.first} heightStep={0} />
          <PodiumColumn position="third" entry={podium.third} heightStep={12} />
        </div>
      ) : (
        <div className="text-center py-3 text-xs text-slate-300">
          No finishers yet today —{' '}
          <span style={{ color: ACCENT }}>be the first on the podium.</span>
        </div>
      )}
    </div>
  );
}
