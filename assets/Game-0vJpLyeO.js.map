import React from 'react';

// The home launcher's ROUND picker — The Daily vs Practice, for whichever tier
// ModeToggle has selected.
//
// The second half of separating the two axes the old EASY · DAILY · CHALLENGE
// strip had flattened together (C15). A tier plus a round is exactly one wire
// key, resolved through `keyFor(tier, round)` in @/game-modes — this component
// never invents an id of its own.
//
// It is deliberately quieter than the tier row: smaller, lower contrast, and
// styled as a segmented sub-control rather than a second row of headline pills.
// The visual hierarchy on the home screen is tier -> round -> the primary CTA,
// and two equally loud rows above the CTA would fight it.
//
// The Daily is listed FIRST and is the default. It is the once-a-day, ranked,
// streak-bearing round — the thing the product is for — and Practice is where
// you go to warm up for it.
//
// @param {{
//   round: 'daily'|'practice',
//   dailyStatus?: string,          // this tier's Daily: completed / forfeited / ...
//   onSelectRound: (round: 'daily'|'practice') => void,
// }} props

const ROUNDS = [
  { id: 'daily', label: 'The Daily', glyph: '📅' },
  { id: 'practice', label: 'Practice', glyph: '🎲' },
];

// A spent Daily still shows its round — the resolved card lives there — but the
// label says so, because "The Daily" on a day you already solved reads as an
// invitation to a round you cannot play.
const DAILY_SUFFIX = {
  completed: ' ✓',
  forfeited: ' ✕',
};

export default function RoundToggle({ round, dailyStatus, onSelectRound }) {
  return (
    <div
      data-testid="round-toggle"
      className="flex items-center justify-center gap-1 w-full max-w-xs mx-auto rounded-full p-0.5 border border-white/10 bg-white/[0.03]"
    >
      {ROUNDS.map((r) => {
        const selected = round === r.id;
        return (
          <button
            key={r.id}
            data-testid={`round-${r.id}`}
            data-selected={String(selected)}
            onClick={() => onSelectRound(r.id)}
            className={`flex-1 rounded-full px-3 py-1 text-[11px] font-bold transition-colors duration-200 touch-manipulation ${
              selected ? 'text-white' : 'text-slate-400 hover:text-slate-200'
            }`}
            style={selected
              ? {
                background: 'color-mix(in srgb, var(--u37-mode-accent) 18%, transparent)',
                boxShadow: 'inset 0 0 0 1px color-mix(in srgb, var(--u37-mode-accent) 55%, transparent)',
              }
              : {}}
          >
            <span aria-hidden className="mr-1">{r.glyph}</span>
            {r.label}
            {r.id === 'daily' && (DAILY_SUFFIX[dailyStatus] || '')}
          </button>
        );
      })}
    </div>
  );
}
