import React from 'react';
import { motion } from 'framer-motion';
import { Trophy, Sparkles } from 'lucide-react';
import { Logo37 } from '@/dice-visuals';

export default function GameHeader() {
  // The brand mark is a Logo37 SVG whose glow is an feDropShadow filter. On the
  // Android webview, ANY transform on a filtered SVG (a mount scale-in OR a
  // continuous wobble) re-rasterizes that filter every frame — which shows as
  // the logo flickering on load. The 1.0.259 attempt (drop the redundant CSS
  // drop-shadow + hold the wobble one frame) wasn't enough. Fix (David, 1.0.260):
  // the logo fades in and stays STILL — no scale/translate entrance, no idle
  // wobble, i.e. ZERO transforms on the filtered SVG. Only the blurred glow layer
  // BEHIND it still pulses (it carries no SVG filter), and that's held until
  // after the first paint so it never composites during the initial mount.
  const [animate, setAnimate] = React.useState(false);
  React.useEffect(() => {
    const id = requestAnimationFrame(() => setAnimate(true));
    return () => cancelAnimationFrame(id);
  }, []);

  return (
    <div className="w-full px-4 pt-0 pb-0 relative">
      {/* Title — opacity-only fade (no transform on the filtered logo below) */}
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ duration: 0.4, delay: 0.1 }}
        className="text-center relative"
      >
        {/* The pulse David asked for on 2026-09-12 lives HERE, on the blurred
            backdrop — never on the mark itself.

            ⚠️ THIS IS THE WHOLE REASON THE LOGO STOPPED FLICKERING. The mark is a
            filtered SVG (feDropShadow); ANY transform over it re-rasterizes that
            filter every frame on the Android WebView, which is the bug that took
            two attempts to kill (docs/bugs.md 2026-07-13, fixed in 1.0.260 by
            removing the logo's motion entirely). This layer carries no SVG filter,
            so animating it is safe — and its opacity is what breathes, which is
            composited rather than repainted.

            Amplitude raised (0.45 -> 0.62 flood, static 40% -> a 34-70% opacity
            breath) so the pulse actually reads on a phone. Still nothing moves. */}
        <motion.div
          className="absolute inset-0 blur-[80px] pointer-events-none"
          style={{ opacity: 0.4 }}
          animate={animate ? {
            opacity: [0.34, 0.7, 0.34],
            background: [
              "radial-gradient(circle, rgba(31, 240, 255, 0.62) 0%, transparent 70%)",
              "radial-gradient(circle, rgba(47, 123, 255, 0.62) 0%, transparent 70%)",
              "radial-gradient(circle, rgba(31, 240, 255, 0.62) 0%, transparent 70%)"
            ]
          } : undefined}
          transition={{ duration: 3, repeat: Infinity, ease: "easeInOut" }}
        />
        {/* Static brand mark (2026-07-13): the hex-framed Logo37, same as the
            results header. Responsive — compact on mobile for the zero-scroll
            launcher, larger on desktop. Its glow comes from Logo37's own SVG
            feDropShadow, so this wrapper carries NO transform and NO extra CSS
            filter — that's what stops the Android webview from re-rasterizing
            (flickering) the glow.

            w-24 → w-16 ON MOBILE ONLY (2026-09-11, David's call). Measured on a
            360x800 S21 the launcher overran the nav band by 195px on Challenge
            and the podium was cut off on all three tiers — "zero-scroll launcher"
            was an intention in this comment rather than a fact on the device.
            32px of logo is the cheapest brand-preserving slice of that: the mark
            is still the first thing on the screen and still the largest, and
            `sm:w-36` means nothing changes on desktop or the web build.

            w-16 → w-20 (2026-09-12, David: "there's some space available", asked
            for the mark to be larger and more attention-grabbing, and accepted
            that he re-checks the S21). That gave back 16px of the 32px the
            2026-09-11 pass reclaimed — HALF of it, deliberately, rather than a
            full revert of a fix made against a real measurement.

            🔴 w-20 → w-16, REVERTED SAME DAY (2026-09-12, David on the S21 running
            beta 1.0.308: "with the increase in size of the 37 logo at the top of
            the main game page, we introduced a scroll"). THE PREVIOUS REVISION OF
            THIS COMMENT PREDICTED THIS EXACT OUTCOME, one paragraph down, and
            named w-16 as the known-good value. It was right.

            ⚠️ AND THE MEASUREMENT THAT SAID IT WAS SAFE WAS TAKEN ON THE WRONG
            SURFACE. w-20 was measured in a browser, where the launcher overflow
            came out identical at 64, 80 and 96px — a true result about a viewport
            that has NO AD BANNER. The phone has one, and it is the banner that
            makes the last 16px decide whether the page scrolls. A web measurement
            cannot clear a native layout question; only the device can.

            DO NOT RAISE THIS AGAIN WITHOUT A DEVICE MEASUREMENT. Re-measure on the
            S21, not in a browser:
              document.scrollingElement.scrollHeight - window.innerHeight
              (and check the podium is not clipped on Challenge) */}
        <div className="relative inline-block">
          <h1 className="leading-tight m-0">
            <Logo37 className="block mx-auto w-16 h-16 sm:w-36 sm:h-36" />
          </h1>
        </div>
        <motion.p
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.3 }}
          className="text-slate-300 text-[10px] sm:text-base -mt-3 sm:-mt-2 tracking-[0.35em] uppercase font-bold"
        >
          The Math Puzzle
        </motion.p>
        {/* THE BYLINE IS ABSOLUTE ON MOBILE, IN NORMAL FLOW ON DESKTOP.
            It was a third stacked line costing ~14px of a launcher that had none
            to give. Deleting it was not an option: `__APP_VERSION__` is how
            David reads which build a phone is actually running during a beta
            soak, and a version you cannot see on the device is a version you
            cannot report a bug against. So on mobile it is pinned to the bottom
            of the header block — still on screen, still legible, costing ZERO
            layout height — and `sm:` restores the original stacked line. */}
        <motion.p
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.5 }}
          className="absolute inset-x-0 -bottom-3 sm:static text-slate-400 text-[9px] sm:text-sm mt-0 sm:mt-2 font-medium tracking-wide pointer-events-none sm:pointer-events-auto"
        >
          by HiiPointe Games LLC v{typeof __APP_VERSION__ !== 'undefined' ? __APP_VERSION__ : '—'}
        </motion.p>
      </motion.div>
    </div>
  );
}