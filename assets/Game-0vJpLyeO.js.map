import { useEffect, useRef } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import { isDaily } from '@/game-modes';

// useArrivalAutoStart — arriving from a Sector 73 planet goes straight to that mode's START
// SCREEN, not the 37 home launcher (David, 2026-10-14: "should not take you to the main game
// screen, but instead take you to an ad and then immediately to the start screen").
//
// Sector 73's planets navigate to /Game with state { mode, autoRoll: true }. Once the page has
// restored all three Dailies (`ready`) and settled on that mode, this presses Start for the player
// exactly once — the SAME handleRollDice the launcher's Start button calls, so a Daily plays its
// interstitial first and practice opens its start screen with no ad, and the first-run how-to gate
// still applies. It then clears the state, so going back or reloading never starts it again.
//
// A Daily that is not 'not_started' is left alone: in progress shows the launcher's Continue,
// completed / forfeited show today's result — never a second attempt.
//
// @param {{ mode: string, ready: boolean, status?: string, start: () => void }} args
export function shouldAutoStart({ state, mode, ready, status }) {
  if (!state?.autoRoll || !ready || state.mode !== mode) return false;
  return isDaily(mode) ? status === 'not_started' : true;
}

export function useArrivalAutoStart({ mode, ready, status, start }) {
  const location = useLocation();
  const navigate = useNavigate();
  const done = useRef(false);
  useEffect(() => {
    const state = location.state;
    if (done.current || !state?.autoRoll || !ready || state.mode !== mode) return;
    done.current = true;
    navigate(location.pathname, { replace: true, state: { mode } }); // consumed: never twice
    if (shouldAutoStart({ state, mode, ready, status })) start();
  }, [location, navigate, mode, ready, status, start]);
}
