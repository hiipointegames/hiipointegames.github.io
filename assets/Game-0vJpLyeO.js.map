// "Today's Solve" — the post-resolution recap the home result card opens.
//
// Lifted out of Game.jsx's `handleShowTodaysStats`, which was ~35 lines of
// sequential data loading wrapped in four setState calls. What is here is the
// LOADING; the component keeps the setState calls, so this stays a plain async
// function with no React in it and gets a suite of its own.
//
// It is unrelated to the live-solve celebration path (handleSubmit →
// usePostSolveCelebration → AwardCelebrationSequence → SuccessModal). This one
// runs later, from a card, about a Daily that is already resolved.

import { apiClient } from '@/transport';
import { buildTodaysSolveDisplay, todayET } from '@/daily-challenge';
import { getDiceColors } from '@/dice';
import { reportedFallback } from '@/observability';

/**
 * Load everything the "Today's Solve" recap modal needs, for ONE mode.
 *
 * @param {{
 *   boardMode: string,
 *   readBoard: (q: {date: string, mode: string}) => Promise<Array<any>>,
 *   fetchTodaysDice: () => Promise<any>,
 * }} deps
 * @returns {Promise<{
 *   freshUser: any, freshStats: any, leaderboard: Array<any>, displayData: any|null,
 * }>}
 * @throws whatever the underlying reads throw — the caller owns the error UI.
 */
export async function loadTodaysStatsRecap({ boardMode, readBoard, fetchTodaysDice }) {
  // CRITICAL: refresh the user first so the stats are current.
  //
  // Cast because `auth.me()` is typed as the raw Supabase `User`, which has no
  // `game_stats` — the app stores it in user_metadata and the transport layer
  // flattens it onto the object. Game.jsx read the same field for years behind a
  // file-level `@ts-nocheck`; this module has no such blanket, so the assumption
  // is stated here instead of being invisible.
  const freshUser = /** @type {any} */ (await apiClient.auth.me());
  const freshStats = freshUser.game_stats || {};

  const today = todayET();

  // THIS mode's board and today's dice, in parallel. A recap after a FORFEIT has
  // no solve to read dice from, so that read is allowed to fail on its own.
  const [leaderboard, todaysDice] = await Promise.all([
    readBoard({ date: today, mode: boardMode }),
    fetchTodaysDice().catch(reportedFallback('recap.dice')),
  ]);

  // Own solve time = the authoritative leaderboard row, NOT the drift-prone
  // dailyChallengeSolutions blob (docs/bugs.md 2026-07-26, own-time 0:00.00).
  const displayData = buildTodaysSolveDisplay({
    solutions: freshStats.dailyChallengeSolutions,
    leaderboard,
    userId: freshUser.id,
    today,
    todaysDice,
    mode: boardMode,
    // The board's OWN colours — POWER_DICE_COLORS unconditionally would paint
    // three power dice onto Easy's all-white recap.
    defaultColors: getDiceColors(boardMode),
  });

  return { freshUser, freshStats, leaderboard, displayData: displayData || null };
}
