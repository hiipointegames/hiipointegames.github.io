import React from 'react';
import { playSynth } from './synth';

// The home-screen portal into Sector 73. Rendered ONLY for players who have crossed the Mirror
// (the parent decides) — locked players never see it, which keeps the secret a secret.
//
// A black hole, not a swirl (David, 2026-10-14: "it should look more like a portal that says TO
// SECTOR 73 near it"): a dark event horizon, a thin photon ring, an accretion disk turning around
// it, a lensing glow that breathes, and sparks spiralling in. Pure CSS — no image file. Tapping it
// passes its centre on screen, so the entry warp opens the black hole right where it was.

const SPARKS = [0, 1, 2, 3, 4];

export default function WormholeButton({ onEnter, className = '' }) {
  const handle = (e) => {
    e.preventDefault();
    e.stopPropagation();
    playSynth('blip');
    const r = e.currentTarget.getBoundingClientRect?.();
    onEnter(r ? { x: r.left + r.width / 2, y: r.top + r.width / 2 } : null);
  };
  return (
    <button
      type="button"
      data-testid="sector73-wormhole"
      aria-label="Enter Sector 73"
      onPointerDown={handle}
      className={`flex flex-col items-center touch-manipulation active:scale-90 transition-transform ${className}`}
      style={{ WebkitTapHighlightColor: 'transparent' }}
    >
      <span className="relative block h-14 w-14">
        <style>{`
          @keyframes s73-breathe { 0%,100% { transform: scale(1); opacity: .55 } 50% { transform: scale(1.18); opacity: .9 } }
          @keyframes s73-spiral { 0% { transform: rotate(0deg) translateX(30px) scale(1); opacity: 0 } 15% { opacity: 1 } 100% { transform: rotate(-300deg) translateX(4px) scale(.3); opacity: 0 } }
          @media (prefers-reduced-motion: reduce) { .s73-anim { animation: none !important } }
        `}</style>
        {/* Lensing glow that breathes. */}
        <span aria-hidden="true" className="s73-anim absolute -inset-2 rounded-full"
          style={{ background: 'radial-gradient(circle, rgba(168,85,247,0.55) 30%, rgba(34,211,238,0.22) 55%, transparent 72%)', animation: 's73-breathe 2.4s ease-in-out infinite' }} />
        {/* Accretion disk. */}
        <span aria-hidden="true" className="s73-anim absolute inset-0 rounded-full animate-spin"
          style={{
            animationDuration: '1.8s',
            background: 'conic-gradient(from 0deg, #f97316, #fde047, #a855f7, #22d3ee, #f97316)',
            maskImage: 'radial-gradient(circle, transparent 40%, #000 46%, #000 60%, transparent 70%)',
            WebkitMaskImage: 'radial-gradient(circle, transparent 40%, #000 46%, #000 60%, transparent 70%)',
            filter: 'blur(0.8px)',
          }} />
        {/* Photon ring + event horizon. */}
        <span aria-hidden="true" className="absolute inset-[30%] rounded-full bg-black" style={{ boxShadow: '0 0 0 1.5px rgba(255,255,255,0.9), 0 0 10px 2px #a855f7' }} />
        {/* Sparks spiralling in. */}
        {SPARKS.map((i) => (
          <span key={i} aria-hidden="true" className="s73-anim absolute left-1/2 top-1/2 h-1 w-1 rounded-full bg-amber-200"
            style={{ marginLeft: -2, marginTop: -2, animation: `s73-spiral 2.2s ${i * 0.44}s linear infinite`, boxShadow: '0 0 4px #fde047' }} />
        ))}
      </span>
      <span className="mt-0.5 whitespace-nowrap text-[8px] font-black uppercase tracking-[0.18em] text-violet-200" style={{ textShadow: '0 0 6px #a855f7' }}>
        To Sector 73
      </span>
    </button>
  );
}
