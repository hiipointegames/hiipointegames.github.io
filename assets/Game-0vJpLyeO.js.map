import React from 'react';
import { createPortal } from 'react-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { Sparkles, X } from 'lucide-react';

// The guest's answer to "Today's Solve".
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS EXISTS — it replaces a SPINNER THAT NEVER STOPPED
// ─────────────────────────────────────────────────────────────────────────────
// Reported by David on the S21 running beta 1.0.308: a guest who finishes a
// Daily and taps "Today's Solve" gets a button that "just spins and spins".
//
// The recap loader (`loadTodaysStatsRecap`) is built for an account: it refreshes
// the user, reads their leaderboard row, and reconstructs the solve from stats
// that a guest does not have server-side. So the honest fix is not to make that
// load faster or fail louder — it is to NOT START IT. A guest has no historical
// data to recap; asking the server for it is the wrong question.
//
// David's copy, near-verbatim: "Trying to view your stats? Create an account by
// clicking on the Save Stats button to gain access to historical data."
//
// ⚠️ THE CTA OPENS THE FLOW, IT DOES NOT POINT AT IT. The button dispatches
// `openSaveStats`, the same app-wide event ContestDetails and the Statistics
// page use, so Layout opens the real account flow directly.
//
// It was NAMED "Save Stats" to match the blue home-screen pill. That pill was
// removed (David, 2026-10-10), so the button now says what it does: "Create
// free account" — the same words as the drawer entry.

/**
 * OWNS ITS OWN OVERLAY — backdrop, portal and all.
 *
 * The first version took only `onClose` and left `Game.jsx` to render the fixed
 * backdrop around it. That added ~20 lines of modal chrome to a file the arch
 * ratchet grandfathers as a blob (it may only shrink), and the ratchet refused
 * the commit. Moving the chrome here is the fix the ratchet was asking for
 * rather than a workaround: the backdrop is part of this modal, and `Game.jsx`'s
 * job is to say WHEN it opens, not to re-describe HOW a modal looks.
 *
 * Portalled to `<body>` for the same reason `ContestBanner` is: the launcher
 * sits inside a scrolling column under framer-motion ancestors, and a
 * `position: fixed` overlay inside a transformed ancestor is positioned against
 * THAT ancestor rather than the viewport.
 *
 * @param {Object} props
 * @param {boolean} props.open whether the prompt is showing
 * @param {() => void} props.onClose dismiss the prompt
 */
export default function TodaysSolveGuestPrompt({ open, onClose }) {
  const openSaveStats = () => {
    // Close FIRST so the player lands on the save form rather than on it behind
    // this modal — the same ordering ContestDetails uses for its guest nudge.
    onClose?.();
    window.dispatchEvent(new Event('openSaveStats'));
  };

  if (typeof document === 'undefined') return null;

  return createPortal(
    <AnimatePresence>
      {open && (
        <motion.div
          data-testid="todays-solve-guest-overlay"
          className="fixed inset-0 z-[60] flex items-center justify-center p-4"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
        >
          <button
            type="button"
            aria-label="Close"
            data-testid="todays-solve-guest-backdrop"
            onClick={onClose}
            className="absolute inset-0 bg-black/80 backdrop-blur-sm"
          />

          <div
            data-testid="todays-solve-guest-prompt"
            role="dialog"
            aria-modal="true"
            aria-labelledby="todays-solve-guest-title"
            className="relative w-full max-w-sm mx-auto rounded-2xl border p-5 text-center backdrop-blur overflow-y-auto"
            style={{
              background: 'var(--u37-panel-bg)',
              borderColor: 'color-mix(in srgb, var(--u37-cyan) 45%, transparent)',
              boxShadow: '0 18px 60px rgba(0,0,0,0.5), 0 0 34px -18px var(--u37-cyan)',
              // The house pattern — see ContestDetails for the full reasoning.
              // On a phone the ad banner sits over the bottom of the webview, and
              // `--ad-reserved-bottom` is set from its REPORTED height, so this
              // never guesses and resolves to 0 on web.
              maxHeight: 'calc(100dvh - var(--safe-bottom) - var(--ad-reserved-bottom) - 2rem)',
            }}
          >
            <div className="flex justify-end -mt-2 -mr-2">
              <button
                type="button"
                onClick={onClose}
                aria-label="Close"
                data-testid="todays-solve-guest-close"
                className="min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-400"
              >
                <X className="w-5 h-5" aria-hidden="true" />
              </button>
            </div>

            <div className="flex justify-center mb-3">
              <Sparkles className="w-9 h-9" style={{ color: 'var(--u37-cyan)' }} aria-hidden="true" />
            </div>

            <h2 id="todays-solve-guest-title" className="text-lg font-black text-white mb-2">
              Trying to view your stats?
            </h2>

            <p className="text-slate-300 text-sm mb-5 leading-snug">
              You&apos;re playing as a guest, so nothing is saved yet. Create an
              account to gain access to your historical data — your solves,
              streaks and podium finishes will all show up here.
            </p>

            <motion.button
              type="button"
              onClick={openSaveStats}
              whileTap={{ scale: 0.97 }}
              data-testid="todays-solve-guest-cta"
              className="w-full min-h-[48px] touch-manipulation rounded-xl px-6 font-black text-sm border"
              style={{
                color: '#ffffff',
                borderColor: 'var(--u37-blue)',
                background: 'color-mix(in srgb, var(--u37-blue) 26%, transparent)',
                boxShadow: '0 0 16px -6px var(--u37-blue)',
                WebkitTapHighlightColor: 'transparent',
              }}
            >
              Create free account
            </motion.button>
          </div>
        </motion.div>
      )}
    </AnimatePresence>,
    document.body,
  );
}
