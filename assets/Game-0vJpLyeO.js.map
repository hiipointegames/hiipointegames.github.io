import React, { useCallback, useRef, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useSector73Portal } from './useSector73PortalVisible';
import { isWarpSubmittable, writeCachedUnlock } from './mirror';
import MirrorWarpOverlay from './MirrorWarpOverlay';
import PortalEntryOverlay from './PortalEntryOverlay';
import { preloadSector73Page } from './preloadPage';

/**
 * Everything the Game page needs for Sector 73's Mirror, in one hook — so the
 * page (a grandfathered blob the arch-ratchet will not let grow) only carries
 * one-line calls into it.
 *
 *   board           → what the Daily board does with a 73: 'open' (a first 73 submits),
 *                     'used' (refused with the "already logged" line) or 'off' (a guest — a 73
 *                     is just another wrong total, no clue, no copy)
 *   canWarp(board)  → is this board a submittable FIRST 73? (false once unlocked, false for a guest)
 *   asWhite(colors) → a 73 is never "perfect": score it as seven white dice
 *   recheck()       → re-read the unlock (after the server refuses a repeat 73)
 *   start()         → the warp: cache the unlock and play the Mirror transition
 *   enter(origin)   → fly in from the home portal — the black-hole entry, every time
 *                     (David, 2026-10-14), opening where the portal was. It starts loading the
 *                     page's chunk at the tap (3 s head start), and lands with
 *                     state.entry = 'white' | 'dark' so the page fades from white only after a
 *                     flash the player actually saw. The overlay stays up (white, or dark after
 *                     a skip) until that chunk has arrived — at most PAGE_WAIT_MS — so a slow
 *                     network never shows the route spinner and app chrome between the white and
 *                     the world (review M2, 2026-10-19: a chunk held 5 s showed both for ~3 s).
 *   overlay         → the transition element to render (or null)
 *
 * GUESTS NEVER WARP (David, 2026-10-19): "You have to be a player with a username and password
 * to get into Sector 73." A guest — isMember from the auth module, the soft wall's one rule — gets no warp, no
 * unlock written (not even the local cache), no portal and no "repeat 73" copy, even if this
 * device holds a cached unlock or the server holds an old 73 row. The guard lives HERE, not in
 * Game.jsx (at its arch-ratchet cap), so the page's one-line calls stay as they are.
 *
 * @param {Record<string, any> | null | undefined} user the signed-in player (raw auth user or me() shape)
 */
/** Longest the entry waits on a slow page chunk before navigating anyway (then the route spinner shows). */
export const PAGE_WAIT_MS = 8000;

/** Resolves when `pending` settles (either way), or after `ms` — whichever is first. */
export function settleWithin(pending, ms) {
  return new Promise((resolve) => {
    const t = setTimeout(resolve, ms);
    Promise.resolve(pending).catch(() => undefined).then(() => { clearTimeout(t); resolve(undefined); });
  });
}

export function useMirrorWarp(user) {
  const navigate = useNavigate();
  // THE MASTER SWITCH (2026-10-20): with Sector 73 switched OFF a member is treated exactly
  // like a guest here — no warp, no unlock read or write, no portal, no "repeat 73" copy — so
  // the Daily is the 37 game as it was before Sector 73. The switch is OFF until its read
  // settles, so the unlock-check query never fires before the answer is known. A guest never
  // even asks the switch.
  // The rule itself (member && switch ON && unlocked) lives in useSector73Portal, shared with
  // the Layout's bell/menu swap so the two can never disagree about whether the portal shows.
  const [check, setCheck] = useState(0);
  const { active: member, userId, unlocked } = useSector73Portal(user, check); // a guest never reads, fetches or writes an unlock
  const [warping, setWarping] = useState(false);
  const [entering, setEntering] = useState(null); // { origin } while the entry plays
  const pagePending = useRef(/** @type {Promise<unknown> | null} */ (null)); // the page chunk, loading since the tap

  const canWarp = useCallback(
    ({ valid, result, usedDiceIndices }) => member && !unlocked && isWarpSubmittable({ valid, result, usedDiceIndices, draftErrors: [] }),
    [member, unlocked],
  );
  const arrive = useCallback(() => navigate('/Sector73', { state: { arrival: true } }), [navigate]);

  return {
    unlocked,
    board: !member ? 'off' : unlocked ? 'used' : 'open',
    canWarp,
    asWhite: (colors) => colors.map(() => 'white'),
    recheck: () => setCheck((n) => n + 1),
    start: () => { if (!member) return; writeCachedUnlock(userId, true); setWarping(true); },
    enter: unlocked ? (origin = null) => { pagePending.current = preloadSector73Page(); setEntering({ origin }); } : undefined,
    overlay: warping ? <MirrorWarpOverlay onDone={arrive} />
      : entering ? (
        <PortalEntryOverlay origin={entering.origin} onDone={({ entry }) => {
          settleWithin(pagePending.current, PAGE_WAIT_MS).then(() => { setEntering(null); navigate('/Sector73', { state: { entry } }); });
        }} />
      )
        : null,
  };
}
