import { useState, useCallback } from 'react';

import { isGuest } from '@/auth';

import { loadTodaysStatsRecap } from './todaysStatsRecap';

/**
 * The "Today's Solve" button's whole behaviour: the guest branch, the loading
 * flag, the load, and the error path.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * WHY THIS IS A HOOK AND NOT TWENTY LINES IN Game.jsx
 * ─────────────────────────────────────────────────────────────────────────────
 * `Game.jsx` is a grandfathered blob: the arch ratchet allows it to shrink and
 * refuses to let it grow. Adding the guest branch inline pushed it 900 → 916 and
 * the gate correctly blocked the commit. Trimming comments got it to 907, which
 * is still a regression — the right answer to "this file may not grow" is to
 * take something OUT, not to write the addition more tersely.
 *
 * `loadTodaysStatsRecap` already owns the data loading. What lived in the page
 * was the orchestration around it — a re-entrancy guard, a loading flag, a
 * try/catch, and five setState calls — which is the same shape every other
 * extracted hook in this module has. So this is the decomposition slice that was
 * always implied, taken now because a real change needed the room.
 *
 * ⚠️ THE GUEST BRANCH IS FIRST AND RETURNS EARLY, BY DESIGN. `loadTodaysStatsRecap`
 * is built for an account: it refreshes the user, reads their leaderboard row,
 * and reconstructs the solve from server-side stats a guest does not have. For a
 * guest it spun forever (David, S21, beta 1.0.308). The fix is not a faster
 * failure — it is not asking a question the player cannot have an answer to.
 *
 * The caller supplies what to DO in each case; this hook owns only when.
 *
 * @param {{
 *   user: any,
 *   boardMode: string,
 *   readBoard: (q: {date: string, mode: string}) => Promise<Array<any>>,
 *   fetchTodaysDice: () => Promise<any>,
 *   onGuest: () => void,
 *   onRecap: (recap: {freshUser: any, freshStats: any, leaderboard: Array<any>, displayData: any|null}) => void,
 * }} deps
 * @returns {{ loading: boolean, show: () => Promise<void> }}
 */
export function useTodaysSolveRecap({
  user, boardMode, readBoard, fetchTodaysDice, onGuest, onRecap,
}) {
  const [loading, setLoading] = useState(false);

  const show = useCallback(async () => {
    // Re-entrancy guard: the button stays mounted while it spins, and a double
    // tap would otherwise run two loads and race their setState calls.
    if (loading) return;

    if (isGuest(user)) {
      onGuest();
      return;
    }

    setLoading(true);
    try {
      onRecap(await loadTodaysStatsRecap({ boardMode, readBoard, fetchTodaysDice }));
    } catch (error) {
      console.error('Failed to load stats:', error);
      // Kept as-is from the page. A credentialed player hitting this has a real
      // failure worth surfacing — unlike the guest case above, which is not an
      // error at all and is why it never reaches here.
      alert('Failed to load stats. Please try again.');
    } finally {
      setLoading(false);
    }
  }, [loading, user, boardMode, readBoard, fetchTodaysDice, onGuest, onRecap]);

  return { loading, show };
}
