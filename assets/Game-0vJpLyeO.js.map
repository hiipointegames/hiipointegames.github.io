import React from 'react';
import { GameHeader } from '@/puzzle-input';
import { isDaily, modeOf, roundOf, keyFor } from '@/game-modes';
import { readPerModeStats } from '@/components/stats/dailyModeStats';
import { modeThemeName } from '@/game-flow';
import ModeToggle from './ModeToggle';
import RoundToggle from './RoundToggle';
import DailyResultPanel from './DailyResultPanel';
import DailyEntryButton from './DailyEntryButton';
import HowToWinButton from './HowToWinButton';
import {
  ContestBanner, contestEntryState, contestVisibility, useContestWeekEntries, useGiveawayEmailVerified,
} from '@/contest';
import { referralBonusSuffix, useMyWeekBonus, useReferralsOn } from '@/referrals';
import { StoreBadgeRow } from '@/shell/StoreBadges';
import PodiumShowcase from './PodiumShowcase';
import DailyStreakTrack from './DailyStreakTrack';
import { accountTier } from '@/auth';
import { LockedPodium } from '@/soft-wall';
import { useLauncherVisibilityCheck } from './launcherVisibility';
import { WormholeButton } from '@/sector73';

// HomeLauncher — the home-screen launcher. Purely presentational: Game.jsx owns
// all the state + handlers and feeds them in, so this component has no fetches or
// app-state of its own.
//
// Home redesign "Option A" (2026-07-26): the four destination entry points that
// used to live in this body — Blitz, Stats, Leaderboard, Friends — moved into the
// app-wide bottom nav bar (see @/home BottomNavBar, mounted in routing/Layout.jsx).
//
// "Unified centered stack" layout (David, 2026-07-30 — from Bryce's 1.0.285 iOS
// device feedback): the previous "Tighten + elevate" layout top-anchored the
// action cluster and bottom-anchored the podium with a `flex-1` spacer between
// them, which ballooned into an awkward empty void on a tall phone. It's replaced
// by ONE vertically-centered group with even, comfortable gaps:
//   GameHeader → ModeToggle → DailyEntryButton (Roll/Start) → HowToWinButton →
//   ContestBanner ($37 giveaway) → PodiumShowcase
// floated to the vertical MIDDLE of the available height so there is NO chasm and
// all three modes read as siblings. On the FINISHED-daily screen the roll-only
// bars (entry / how-to / blitz / standalone podium) are swapped for the
// DailyResultPanel, which carries the podium INSIDE its middleSlot — so the
// podium still renders exactly once.
//
// Layout mechanics: the outer `min-h-full flex flex-col` + an inner
// `flex-1 flex flex-col` column hosts a SINGLE group given `my-auto`. Auto
// margins in a flex column center the group vertically when there's spare room,
// and COLLAPSE to 0 when the group is taller than the track — so a tall stack
// flows from the TOP and scrolls WITHOUT clipping (no `justify-center` clip trap).
// Because the shell height (`.app-min-h-shell`) already subtracts the reserved
// nav/ad band, the group sits ABOVE the band and never runs under it.
//
// @param {{
//   mode: 'easy'|'daily'|'challenge',
//   gameStats: object|null,        // player's game_stats blob — feeds the
//                                  // seven-day streak track's per-mode streaks.
//                                  // Passed on Game.jsx's `mode={mode}` LINE
//                                  // rather than its own, because Game.jsx is a
//                                  // grandfathered arch-ratchet blob that may
//                                  // only shrink; a second line there fails the
//                                  // gate, and resetting the baseline to absorb
//                                  // growth is what the baseline is NOT for.
//   diceRolled: boolean,
//   dailyChallengeCompleted: boolean,
//   dailyChallengeForfeited: boolean,
//   loadingStats: boolean,
//   showCompletionShareMenu: boolean,
//   recoverable: boolean,          // dc.recoverable — a resumable daily attempt
//   labelOutline: object,          // MODE_LABEL_OUTLINE (per-mode text outline)
//   onSelectMode: (mode: string) => void,
//   onShowTodaysStats: () => void,
//   onToggleCompletionShareMenu: () => void,
//   onCloseCompletionShareMenu: () => void,
//   onCompletionShare: (target: string) => void,
//   onRoll: () => void,
//   onContinue: () => void,
//   onHowTo: () => void,
//   (onBlitz was the Battle Friends handler. Game.jsx still passes it and that
//    is fine — it is no longer destructured here, and an unread prop costs
//    nothing. See the removal note in the body for why the button went.)
// }} props
// (onNavStats / onNavLeaderboard were dropped in the Beta-2 pass — the
// resolved-daily card no longer carries in-page Stats/Leaderboard buttons now
// that the bottom nav bar owns those destinations. Game.jsx may still pass them;
// unknown props are harmlessly ignored.)
export default function HomeLauncher({
  mode,
  gameStats = null,
  user = null,
  statusByMode = {},
  puzzleMissing = null,
  onSelectRound,
  diceRolled,
  dailyChallengeCompleted,
  dailyChallengeForfeited,
  loadingStats,
  showCompletionShareMenu,
  recoverable,
  labelOutline,
  onSelectTier,
  onShowTodaysStats,
  onToggleCompletionShareMenu,
  onCloseCompletionShareMenu,
  onCompletionShare,
  onRoll,
  onContinue,
  onHowTo,
  onEnterSector73 = undefined,
}) {
  // The week's finished Dailies, for the "x of 21 entries" count on the contest
  // chip. Returns null for anyone who is not already eligible — which is almost
  // everyone — and the chip then says what it can stand behind instead. See
  // useContestWeekEntries for why this query is cheap enough to sit on Home.
  const contestWeekRows = useContestWeekEntries(user);
  // From 25 Oct 2026 an unverified email earns nothing; the chip says so.
  const emailVerified = useGiveawayEmailVerified(user);
  // Referrals (switch-gated): " · +N from friends" on the entries line.
  const referralsOn = useReferralsOn();
  const friendsBonus = useMyWeekBonus(user, referralsOn);
  // The soft wall (David, 2026-10-10): a guest gets the locked podium card and
  // no streaks. Only once the user is known, so a member never sees a lock
  // flash while loading.
  const guestTier = user != null && accountTier(user) === 'guest';
  const dailyResolved = isDaily(mode) && (dailyChallengeCompleted || dailyChallengeForfeited);

  // Silent diagnostic for the rare "only the tier pill shows" launch — reports
  // to Sentry, changes nothing on screen. See ./launcherVisibility.
  const launcherRef = React.useRef(null);
  useLauncherVisibilityCheck(launcherRef, { active: !diceRolled, mode });

  return (
    <div ref={launcherRef} data-mode={modeThemeName(mode)} className="w-full max-w-lg mx-auto px-3 sm:px-4 min-h-full flex flex-col">
    <div className="w-full flex-1 flex flex-col py-1">
      {/* ── UNIFIED CENTERED STACK (David, 2026-07-30) ───────────────────────
          ONE group floated to the vertical MIDDLE via `my-auto`: the auto
          margins center it when there's spare room and collapse to 0 when the
          content overflows, so a tall stack flows from the top and scrolls
          WITHOUT clipping. Even `gap-3` spacing between every bar — no more
          top-cluster + `flex-1` chasm + bottom-podium — so all three modes read
          as one balanced group.

          gap-3 → gap-2 and py-2 → py-1 on 2026-09-11, and the podium lost its
          mb-2: on a 360x800 phone the podium was being cut off by the nav band
          on all three tiers, and five inter-bar gaps are the cheapest 20px on
          the screen. Measured, not guessed — see the numbers in the PR. */}
      <div className="w-full flex flex-col gap-2 my-auto">
        {/* home-condense H1: the launcher utility cluster ("?" how-to + mute)
            now lives in the TOP-LEFT corner chrome with the Save-Stats button
            (see routing/Layout.jsx) — the current mode is broadcast to it via
            the homeChromeChanged event below. NOTE: the home launcher has NO
            top-left back button (item E, 2026-07-26): it is the root surface and
            the bottom nav bar is the primary navigation, so there is nothing to
            go "back" to. The only top-left chrome is Save-Stats + notifications,
            owned by routing/Layout.jsx. */}
        {/* Store download badges, centred directly ABOVE the 37 logo (David,
            2026-09-14). WEB ONLY — StoreBadgeRow returns null on native, and it
            is rendered here as a DIRECT child of the gap-2 flex column rather
            than inside a wrapper <div>, so on native it contributes no element
            and therefore no stray 8px gap above the logo.

            The compact size is not cosmetic: this row is in normal flow at the
            head of the column, so its height pushes the logo and everything
            below it — down to the daily podium, which was already being cut off
            on a 360x800 phone (2026-09-11) — further down. Compact roughly
            halves that cost while staying above the 44px touch target. */}
        <StoreBadgeRow compact />

        {/* `relative` only for the wormhole (Sector 73 on + unlocked) — off, this is main's markup. */}
        <div className={onEnterSector73 ? 'py-0.5 relative' : 'py-0.5'} data-health="logo">
          <GameHeader />
          {/* Sector 73 wormhole — only for players who crossed the Mirror. */}
          {onEnterSector73 && (
            <WormholeButton onEnter={onEnterSector73} className="absolute left-1 top-1/2 -translate-y-1/2" />
          )}
        </div>

        {/* C15 — the entry surface is TWO axes, not one flattened row of three.
            The old EASY · DAILY · CHALLENGE strip mixed a difficulty tier with a
            round type, which cannot express three modes x two rounds: there is
            no pill you could add for "Expert's Daily" that would not make the
            row mean two things at once. Tier above, round below; the two
            together resolve to exactly one wire key via keyFor(). */}
        <div className="flex flex-col items-center gap-1.5 px-4">
          <ModeToggle
            tier={modeOf(mode)}
            statusByMode={statusByMode}
            onSelectTier={onSelectTier}
          />
          <RoundToggle
            round={roundOf(mode)}
            dailyStatus={statusByMode[/** @type {string} */ (keyFor(modeOf(mode), 'daily'))]}
            onSelectRound={onSelectRound}
          />
          {/* Seven-day streak track for the SELECTED tier (David, 2026-08-31).
              Sits directly under the pickers because the streak is a property of
              the tier you just chose. It renders NOTHING once that tier's first
              7-day streak is behind the player, and nothing at all for a tier
              nothing has tracked yet — so this slot is often empty by design. */}
          {/* Guests see no streaks (soft wall, David 2026-10-10). */}
          {!guestTier && <DailyStreakTrack mode={mode} gameStats={gameStats} />}
        </div>

        {/* Primary launcher action — Roll Dice / Start Daily / Continue Daily
            (the last when a daily attempt was interrupted mid-play and is still
            recoverable). See @/home DailyEntryButton. */}
        {!diceRolled && !dailyResolved && (
          <DailyEntryButton
            mode={mode}
            recoverable={recoverable}
            puzzleMissing={puzzleMissing}
            labelOutline={labelOutline}
            onRoll={onRoll}
            onContinue={onContinue}
          />
        )}

        {/* Launcher how-to entry — the full "How to Play & Win" button, directly
            under Roll Dice (home-condense H3). Opens the mode-aware how-to overlay
            IN PLACE (openHowTo → closes back to the launcher; never navigates).
            Shown exactly when the Roll Dice / Start action is. */}
        {!diceRolled && !dailyResolved && (
          <HowToWinButton onClick={onHowTo} />
        )}

        {/* ── THE BATTLE FRIENDS BUTTON USED TO BE HERE ───────────────────
            Removed 2026-09-11 (David): "we do not want this to clutter the main
            game page for any mode, so lets remove the battle friends button from
            the home page, and insert the sweepstakes info there."

            IT COSTS THE COLOSSEUM NOTHING. Blitz is a permanent tab in the
            app-wide bottom nav (see BottomNavBar — `{ id: 'blitz', page:
            'HeadToHead' }`), so the Colosseum is still exactly one tap from this
            screen; what went away was a SECOND door to the same room, sitting in
            the vertical budget the podium needed. `BlitzHomeButton` is kept
            (component + tests) rather than deleted — it is a styled launcher bar
            with no other caller, and re-adding it is an import away if the nav
            tab turns out to under-serve the Colosseum.

            Game.jsx still PASSES `onBlitz`; this component no longer reads it.
            Chasing the prop out of Game.jsx would be a second, unrelated change
            to a grandfathered arch-ratchet blob that this slice has no business
            touching, and an unread prop is inert. */}

        {/* $37 weekly giveaway promo — now the third bar on the roll screen,
            in the slot Battle Friends vacated (David, 2026-09-11).
            NATIVE AS WELL AS WEB since the same day: it used to return null in
            the iOS/Android apps, so this line genuinely changes what ships to a
            phone — see contest.js NATIVE_ENABLED for the store-policy trade.
            Links out to the official rules on the .com site; the rules are
            deliberately NOT duplicated in the app.

            ⚠️ IT STAYS ON THE RESOLVED-DAILY SCREEN TOO (David, 2026-09-11: "i
            want the sweepstakes text box to stay present on the main game page
            even after the daily is complete"). It is the one bar here that does
            NOT follow the "keep the finished screen focused" rule, and
            deliberately so: finishing a Daily is the moment a player has just
            earned a possible entry, which makes it the single best moment to
            tell them the entry exists. Still hidden while a puzzle is in play —
            `!diceRolled` — because the launcher chrome must not sit behind the
            gameplay overlay. */}
        {/* The chip's second line carries the player's entry standing — see
            contestEntries.contestChipLine for why this rides on the EXISTING
            line rather than becoming a row of its own. The home launcher is a
            zero-scroll screen; a new row is a regression. */}
        {!diceRolled && (
          <ContestBanner
            entryState={contestEntryState({ user, rows: contestWeekRows, statusByMode, emailVerified })}
            visibility={contestVisibility(user)}
            lineSuffix={referralBonusSuffix(friendsBonus)}
          />
        )}

        {/* Daily Challenge Completed or Forfeited card — the post-resolution home
            card (see @/home DailyResultPanel). Shows only AFTER today's daily is
            resolved and no puzzle is in play; it is NOT the solve celebration
            (cosmic burst + AwardCelebrationSequence + SuccessModal), which is
            separate and lives below the shell. It sits in the same centered group,
            so the resolved screen stays balanced (no top-clustered void). */}
        {dailyResolved && !diceRolled && (
          <DailyResultPanel
            completed={dailyChallengeCompleted}
            forfeited={dailyChallengeForfeited}
            loadingStats={loadingStats}
            showShareMenu={showCompletionShareMenu}
            onShowStats={onShowTodaysStats}
            onToggleShareMenu={onToggleCompletionShareMenu}
            onCloseShareMenu={onCloseCompletionShareMenu}
            onShare={onCompletionShare}
            // Beta-2 refinement (2026-07-26): on the FINISHED-daily screen only,
            // the podium moves INTO the card, between the congrats line and the
            // actions — so the order is congrats+glyph → podium → Today's Solve +
            // Share. The standalone PodiumShowcase below is skipped in this state
            // (gated on !dailyResolved) so the podium renders exactly once.
            //
            // Item 6 (2026-07-26, David): the finished-daily podium now uses the
            // SAME grander PodiumShowcase treatment as the easy/challenge home
            // podium — the gold pedestal + spotlight frame — so the two screens
            // match. Reuses the home-scoped wrapper (no duplicated styling); the
            // breathing room BELOW it (before the Solve/Share row) is added inside
            // DailyResultPanel so the compact non-daily callers are unaffected.
            middleSlot={<div className="mt-2">{guestTier
              ? <LockedPodium tier={modeOf(mode)} />
              : <PodiumShowcase mode={mode} onSelectTier={onSelectTier} />}</div>}
            // The congrats line names THIS tier's streak (David, 2026-09-03).
            // Read the same way DailyStreakTrack reads it — the derived per-mode
            // block, keyed by the selected tier's Daily — and NOT the legacy
            // top-level `dailyChallengeStreak`, which has only ever meant
            // Challenge and would print Challenge's number on an Expert screen.
            // An untracked tier yields 0, which the panel renders as the
            // unnumbered sentence rather than "your 0 day streak".
            streak={guestTier ? null : (readPerModeStats(gameStats).byMode[keyFor(modeOf(mode), 'daily')]?.currentStreak ?? null)}
          />
        )}

        {/* ── GRANDER PODIUM SHOWCASE ──
            The live top-3 podium as its own distinct, elevated block (see @/home
            PodiumShowcase), closing the centered stack. On the FINISHED-daily
            screen the podium instead lives INSIDE DailyResultPanel above (its
            middleSlot), so it's skipped here — hence the !dailyResolved gate.
            Hidden once a puzzle is in play so the launcher chrome doesn't sit
            behind the gameplay overlay. */}
        {!diceRolled && !dailyResolved && (
          <div>
            {guestTier
              ? <LockedPodium tier={modeOf(mode)} />
              : <PodiumShowcase mode={mode} onSelectTier={onSelectTier} />}
          </div>
        )}

        {/* The dice tray, equation builder, operator pad, and Submit now live
            ONLY in the in-play overlay (DailyChallengeGame). The home screen is
            a launcher: mode selector + Roll Dice + How To Play + the $37 promo +
            podium. Rolling opens the overlay (see DailyChallengeGame in Game.jsx). */}
      </div>
    </div>
    </div>
  );
}
