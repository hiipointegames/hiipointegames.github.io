// Start loading the Sector 73 page's chunk ahead of the route change (the page is a lazy route,
// routing/pages.config.js). Called on the portal tap, so the chunk gets the ~3 s entry as a head
// start. Same module id as the route's lazy() import, so the bundler shares one chunk.
// A failed load (offline) is swallowed here so the portal still plays; the route's own lazy()
// import then makes its own request on navigation — but the browser may have cached the failed
// module, so it can fail the same way (there is no chunk-error recovery in the app today).
export function preloadSector73Page() {
  return import('./Sector73Page').catch(() => undefined);
}
