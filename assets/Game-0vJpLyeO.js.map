// buildTodaysSolveDisplay — derive the display payload for the "Today's Solve"
// recap: the daily SuccessModal opened from the home DailyResultPanel button.
//
// Extracted from pages/Game.jsx (handleShowTodaysStats) so the "which solve time
// do we show?" decision is a pure, testable unit rather than inline modal wiring.
//
// THE BUG THIS FIXES (docs/bugs.md 2026-07-26): the recap read the player's own
// solve time SOLELY from the client-maintained game_stats.dailyChallengeSolutions
// blob (`solutions[0].time`). That blob can be stale or missing today's entry (a
// cross-build write gap, or the JWT-strip fallback path in apiClient.auth.me)
// even though the solve is durably recorded server-side in daily_challenge_times
// — the SAME table the leaderboard/podium reads. When the blob lacked today's
// time the recap rendered 0:00.00 for the player's OWN solve while every OTHER
// player's time showed correctly on the podium.
//
// FIX (derived-not-stored, per the project stats principle): source the OWN
// displayed time from the authoritative leaderboard row for this user, falling
// back to the stored blob time only when no server row is present. Equation /
// dice / colors prefer the richer stored solution but fall back to the server
// row's copy (daily_challenge_times carries equation/usedDiceIndices/diceColors/
// shuffledDice), so even a total write-gap still renders a correct recap.

/**
 * @param {object} args
 * @param {any[]|null|undefined} args.solutions    game_stats.dailyChallengeSolutions
 * @param {any[]|null|undefined} args.leaderboard   today's daily_challenge_times rows (getLeaderboard)
 * @param {string|null|undefined} args.userId       the current player's id
 * @param {string} args.today                       'YYYY-MM-DD'
 * @param {any} args.defaultColors                  fallback dice colors (POWER_DICE_COLORS)
 * @param {number[]|null|undefined} [args.todaysDice] today's daily-challenge dice values
 * @param {string} [args.mode] WHICH Daily this recap is about (wire key). Defaults
 *   to Challenge's Daily, so every pre-modes caller is unchanged.
 * @returns {null | { equation: string, usedDiceIndices: number[], diceColors: any, dice: any[], solveTime: number }}
 */
/**
 * One die, whatever shape it arrived in.
 *
 * ⚠️ THE DICE REACH THIS FILE IN BOTH SHAPES, FROM DIFFERENT SOURCES, AND
 * GETTING IT WRONG RENDERS SEVEN BLANK FACES.
 *
 *   solution.diceData   objects {id,value,originalIndex} on some paths, a plain
 *                       value array on others
 *   ownRow.shuffledDice always a plain value array
 *   todaysDice          OBJECTS — it comes straight from fetchTodaysDice()
 *
 * A wrong assumption in either direction produces `{ value: undefined }` or
 * `{ value: {…} }`, and `DiceDisplay` looks up `dotPositions[value]`, which is
 * undefined for both — so the die renders with no pips and the day-solver, fed
 * the same thing, correctly reports that it found no equations. Blank dice AND
 * "no clean example solve" are one symptom, not two.
 *
 * ⚠️ THIS IS THE SECOND TIME. The forfeit branch below was WRITTEN to fix
 * "seven blank white dice" (Bryce, 1.0.287) and reintroduced them by mapping
 * `todaysDice` as if it were values. One normaliser for every source is the
 * only version of this that stays fixed.
 */
const toDie = (d) => (d && typeof d === 'object' ? { ...d, value: d.value } : { value: d });

export function buildTodaysSolveDisplay({
  solutions, leaderboard, userId, today, defaultColors, todaysDice = null, mode = 'daily',
}) {
  // C18 — "today's solve" is no longer singular. With three Dailies a player can
  // have up to THREE solves on one date, so matching by date alone would show
  // whichever the blob happened to list first: Easy's equation under Expert's
  // recap, with Expert's time beside it.
  //
  // game_stats.dailyChallengeSolutions is the LEGACY blob and legacy entries
  // carry no `mode` at all — the key has always meant Challenge's Daily (lane
  // contract 3.5). So an entry with no mode counts as Challenge's and only as
  // Challenge's: an unmoded row must never be offered to Easy or Expert, and
  // requiring an exact match there would break every historical Challenge recap.
  const matchesMode = (entry) => (
    entry.mode != null ? entry.mode === mode : mode === 'daily'
  );

  // Match today's stored solution BY DATE AND MODE (not index 0) — a write-gap
  // could leave an older day at [0], which must never be shown as "today's solve".
  const solution = Array.isArray(solutions)
    ? solutions.find((s) => s && s.date === today && matchesMode(s))
    : null;

  // The current player's authoritative server row for today.
  const ownRow = Array.isArray(leaderboard) && userId
    ? leaderboard.find((e) => e && e.user_id === userId)
    : null;

  // No solve of our own — the normal case after a FORFEIT, which writes neither a
  // stored solution nor a daily_challenge_times row. Falling through to null used
  // to leave the recap on the caller's live game state, which after a forfeit has
  // been reset: the player got seven blank white dice instead of the day's actual
  // 4 white + 3 power dice (Bryce, 1.0.287). The dice are public knowledge — it's
  // the same puzzle everyone played — so show the real ones. There is no equation
  // and no time to report; the modal already knows it's rendering a forfeit.
  if (!solution && !ownRow) {
    if (!Array.isArray(todaysDice) || todaysDice.length === 0) return null;
    return {
      equation: '',
      usedDiceIndices: [],
      diceColors: defaultColors,
      // ⚠️ todaysDice are OBJECTS from fetchTodaysDice, not values. Mapping them
      // as `({ value: v })` nested the whole object inside `value` — which is
      // what David hit on 1.0.313: "clicking todays solve after a forfeit shows
      // dice with no pips and produces no equations".
      dice: todaysDice.map(toDie),
      solveTime: 0,
    };
  }

  const serverTime = ownRow ? Number(ownRow.solve_time_seconds) : NaN;
  const storedTime = solution ? Number(solution.time) : NaN;

  // Authoritative server time wins; the client blob is only the fallback.
  const solveTime = Number.isFinite(serverTime) && serverTime > 0
    ? serverTime
    : (Number.isFinite(storedTime) ? storedTime : 0);

  // Prefer the richer stored solution for the cosmetic fields; otherwise
  // reconstruct from the server row (shuffledDice is a plain value array).
  // ⚠️ diceData ARRIVES IN BOTH SHAPES, AND ONE OF THEM RENDERED BLANK DICE.
  //
  // David, beta 1.0.312, forfeiting the Challenge Daily: seven dice with no pips
  // and "Today's dice didn't have a clean example solve to show."
  //
  // Both symptoms, one cause. This used to be `({ ...d, value: d.value })`,
  // which assumes every entry is an OBJECT. When diceData is a plain value array
  // — which is how it is persisted on some paths, exactly as `shuffledDice` is
  // on the line below — spreading a number gives `{}` and `d.value` is
  // undefined. Seven `{ value: undefined }` objects then render as seven blank
  // faces AND feed the day-solver seven undefineds, so it correctly reports that
  // it found nothing. The "no clean example solve" message was telling the
  // truth about garbage input.
  //
  // Normalising both shapes here rather than at the call sites: this function is
  // the seam where the stored solution becomes something the UI renders, and the
  // line below already had to do exactly this for shuffledDice.
  const dice = solution?.diceData?.map(toDie)
    // shuffledDice IS a plain value array, so this one was never wrong — it
    // goes through the same normaliser anyway. Three sources answering one
    // question in three ways is how this file shipped blank dice twice.
    || (Array.isArray(ownRow?.shuffledDice) ? ownRow.shuffledDice.map(toDie) : []);

  return {
    equation: solution?.equation || ownRow?.equation || '',
    usedDiceIndices: solution?.usedDiceIndices || ownRow?.usedDiceIndices || [],
    diceColors: solution?.diceColors || ownRow?.diceColors || defaultColors,
    dice,
    solveTime,
  };
}
