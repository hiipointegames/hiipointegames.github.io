// @ts-nocheck
import React, { useState, useEffect, useCallback } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { createPageUrl } from '@/routing/createPageUrl';

import { useRoundSession, RoundStageBoard, RoundStageModals, useArrivalAutoStart } from '@/game-flow';

import {
  nowET,
  todayET,
} from '@/daily-challenge';

import {
  resolveIncomingMode, recallHomeMode, DEFAULT_HOME_MODE,
  switchTier, switchRound,
  useTodaysLeaderboard, useGameMount, useThreeDailies, usePlayerRecord,
} from '@/game-flow';
import { useHowToOverlay } from '@/how-to-play';
import { useResolvedDailyShare, TodaysSolveGuestPrompt, useTodaysSolveRecap, useDailyShareMenuRequest } from '@/game-flow';
import { playSound } from '@/ui/feedback';
import { isHomeLauncherActive, HomeLauncher } from '@/home';
import { useMirrorWarp } from '@/sector73';

import { useInterstitialAd } from '@/shell';
import { outline8 } from '@/ui/text-outline';

// The active-mode outline (resolves per [data-mode] on the launcher container).
const MODE_LABEL_OUTLINE = outline8('var(--u37-mode-accent-deep)');

export default function Game() {
  const navigate = useNavigate();
  const location = useLocation();

  // Interstitial ads — listeners + lifecycle live in the shell subsystem.
  // We don't currently call .show() anywhere in Game; the ad just loads in
  // the background. Preserving existing semantics — see src/shell/interstitialAd.js.
  useInterstitialAd();

  // Initialize the mode SYNCHRONOUSLY from the How-To-Play nav state (if present)
  // so the FIRST paint is already the chosen mode — no flash of Daily before
  // loadUser catches up. Else this session's remembered mode, else DEFAULT_HOME_MODE.
  // The literal allowlist that used to live here could not admit `expert`,
  // `daily_easy` or `daily_expert` — see @/game-flow gameEntryModel (C1).
  const [mode, setMode] = useState(
    () => resolveIncomingMode(location.state) || recallHomeMode() || DEFAULT_HOME_MODE,
  );
  // In-place how-to overlay for the pre-game modals' "?" reopen. Opening it
  // overlays the modal (which stays mounted) and closes back to it — never
  // navigates to /Game (which abandoned the Daily flow and replayed the ad).
  // RC2 fix, 2026-07-08 occlusion audit.
  const { openHowTo, howToNode } = useHowToOverlay();
  // The player's record (user, stats, statsRef, point totals, statsLoaded) lives
  // in @/game-flow usePlayerRecord (moved verbatim, slice 1b).
  const record = usePlayerRecord();
  const { user, setUser, stats, setStats, statsLoaded, knownPointsRef, setPuzzlePoints } = record;
  const { setStatsLoaded } = record.mountApply;
  // ONE ATTEMPT MACHINE PER MODE (C14) — the three Daily machines and their
  // maps live in @/game-flow useThreeDailies (moved verbatim, same hook order).
  const threeDailies = useThreeDailies();
  const { dailyByMode, statusByMode } = threeDailies;
  const mirror = useMirrorWarp(user); // Sector 73's Mirror: a member's first 73 in a Daily (@/sector73)

  const [showCompletionShareMenu, setShowCompletionShareMenu] = useState(false);
  useDailyShareMenuRequest(setShowCompletionShareMenu); // first-week tip card 1's Share
  const [leaderboard, setLeaderboard] = useState([]);
  const [showGuestStatsPrompt, setShowGuestStatsPrompt] = useState(false);

  // Daily-challenge dice cache is now inside the useDailyChallengeAttempt hook
  // (see fetchTodaysDice). The leaderboard cache moved to @/game-flow
  // useTodaysLeaderboard, which keys it `${date}:${mode}` — a date-only key
  // served whichever mode asked first to every other mode, and the read itself
  // named no mode at all, so three modes' solves came back in one list.
  const todaysBoard = useTodaysLeaderboard();

  // Load user and game state
  // Cold start — read the player, restore all three Dailies, and decide the ONE
  // landing mode. Extracted to @/game-flow useGameMount: it is the first thing
  // that runs when a player opens the game and it lived in a `useEffect(…, [])`
  // on a page no test could drive, so none of its branches were reachable. The
  // ordering rule it enforces (landing mode decided once, LAST) has already cost
  // three bugs; it is stated and tested there now.
  useGameMount({
    dailyByMode, mode,
    locationState: location.state,
    knownPointsRef,
    apply: {
      setUser, setStats, setStatsLoaded, setPuzzlePoints, setMode,
    },
  });

  // ONE ROUND — board, entry paths, solve, results, autosave — lives in
  // @/game-flow useRoundSession (moved verbatim, slice 1b); its JSX is
  // @/game-flow RoundStage. Game keeps the launcher and the page chrome.
  const session = useRoundSession({ mode, setMode, record, threeDailies, openHowTo, mirror });
  const {
    diceRolled, showCompactGame, showPlayWarning, showSuccess, dc, boardMode, celebration,
    handleRollDice, handleContinueDaily, selectModeKey: handleSelectModeKey, openRecap,
  } = session;
  const dailyChallengeCompleted = dc.status === 'completed';
  const dailyChallengeForfeited = dc.status === 'forfeited';
  const showDailyChallengeGame = dc.showGame;
  useArrivalAutoStart({ mode, ready: statsLoaded, status: dailyByMode[mode]?.status, start: handleRollDice }); // from a Sector 73 planet: straight to the start screen

  // Prefetch THIS mode's board once the user + stats are in.
  useEffect(() => {
    if (!user || !statsLoaded) return;
    todaysBoard
      .read({ date: todayET(), mode: boardMode })
      .then((rows) => setLeaderboard(rows));
  }, [user, statsLoaded, boardMode, todaysBoard]);

  // Outcome ladder + board lookup: @/game-flow shareResolvedDaily. The card is
  // prepared BEFORE the tap so the share sheet opens inside it (useResolvedDailyShare).
  const handleCompletionShare = useResolvedDailyShare({
    leaderboard, userId: user?.id, mode: boardMode,
    completed: dailyChallengeCompleted, forfeited: dailyChallengeForfeited,
    today: nowET().format('MMMM D, YYYY'),
  });

  // Post-resolution "Today's Solve" loader for the home result card
  // (DailyResultPanel). The LOADING lives in @/game-flow loadTodaysStatsRecap;
  // what stays here is the four setState calls and the error UI.
  const { loading: loadingStats, show: handleShowTodaysStats } = useTodaysSolveRecap({
    user, boardMode, readBoard: todaysBoard.read, fetchTodaysDice: dc.fetchTodaysDice,
    onGuest: () => setShowGuestStatsPrompt(true),
    onRecap: (recap) => {
      setLeaderboard(recap.leaderboard);
      openRecap(recap);
    },
  });

  const handleSelectTier = useCallback(
    (tier) => handleSelectModeKey(switchTier(mode, tier)),
    [mode, handleSelectModeKey],
  );
  const handleSelectRound = useCallback(
    (round) => handleSelectModeKey(switchRound(mode, round)),
    [mode, handleSelectModeKey],
  );

  // Tell Layout whether the bare home launcher is the active surface, so the
  // home chrome (Notifications + hamburger + Save-Stats) shows ONLY there. The
  // decision lives in the pure isHomeLauncherActive helper — it gates on the
  // full-screen game-surface flags (daily/compact) directly, not just on
  // diceRolled, because those states can desync (the success "play again" path
  // reopens the compact game without re-setting diceRolled, which leaked the
  // chrome on top of the in-game screen — David, 2026-07-11).
  useEffect(() => {
    const visible = isHomeLauncherActive({
      dailyGameActive: showDailyChallengeGame,
      compactGameActive: showCompactGame,
      diceRolled,
      showSuccess,
      pendingAwardCount: celebration.pendingCount,
      showDailyStartWarning: dc.showStartWarning,
      showPlayWarning,
    });
    // Carry the current mode so Layout's corner "?" opens THIS mode's how-to.
    window.dispatchEvent(new CustomEvent('homeChromeChanged', { detail: { visible, mode } }));
  }, [showDailyChallengeGame, showCompactGame, diceRolled, showSuccess, celebration.pendingCount, dc.showStartWarning, showPlayWarning, mode]);

  return (
    <>
      <RoundStageBoard session={session} />

      {/* Starfield is now mounted once app-wide in Layout (no per-page copy). */}
      <div className="app-page-shell w-full relative z-[1]">
        {/* Ad-safe space is reserved ONCE on #root (--ad-reserved-bottom, the live
            banner height) — the scroll region just fills what's left via
            .app-page-scroll. The old hardcoded calc(100vh-130px) double-counted the
            ad and left a ~130px dead band below content (the "extra scrollable
            space"); pb-10 keeps the last control above the fade + ad. */}
        <div className="app-page-scroll pt-[60px] pb-2 scroll-edge-fade-bottom">
        {/* Home launcher — extracted to @/home HomeLauncher. Game.jsx owns the
            state/handlers; the launcher is presentational. The Blitz / Stats /
            Leaderboard / Friends destinations moved to the app-wide bottom nav
            bar (home redesign "Option A", @/home BottomNavBar in Layout.jsx). */}
        <HomeLauncher
          mode={mode} gameStats={stats} user={user}
          // Per-mode Daily state for the tier picker's glyphs, and whether THIS
          // mode has a puzzle today (null until something has looked).
          statusByMode={statusByMode}
          puzzleMissing={dc.puzzleMissing}
          diceRolled={diceRolled}
          dailyChallengeCompleted={dailyChallengeCompleted}
          dailyChallengeForfeited={dailyChallengeForfeited}
          loadingStats={loadingStats}
          showCompletionShareMenu={showCompletionShareMenu}
          recoverable={dc.recoverable}
          labelOutline={MODE_LABEL_OUTLINE}
          onSelectTier={handleSelectTier}
          onSelectRound={handleSelectRound}
          onShowTodaysStats={handleShowTodaysStats}
          onToggleCompletionShareMenu={() => setShowCompletionShareMenu((v) => !v)}
          onCloseCompletionShareMenu={() => setShowCompletionShareMenu(false)}
          onCompletionShare={handleCompletionShare}
          onRoll={handleRollDice}
          onContinue={handleContinueDaily}
          onHowTo={() => openHowTo(mode, { context: 'go-back' })}
          onEnterSector73={mirror.enter}
          onBlitz={() => { playSound('buttonTap'); navigate(createPageUrl('HeadToHead')); }}
          onNavStats={() => { playSound('buttonTap'); navigate(createPageUrl('Statistics')); }}
          onNavLeaderboard={() => { playSound('buttonTap'); navigate(createPageUrl('Leaderboard')); }}
        />
      </div>
      </div>

      <TodaysSolveGuestPrompt open={showGuestStatsPrompt} onClose={() => setShowGuestStatsPrompt(false)} />
      <RoundStageModals session={session} howToNode={howToNode} />
      {mirror.overlay}

    </>
  );
}