// launcherVisibility — catch the "home shows only the tier buttons" bug in the wild.
//
// THE REPORT (David, 2026-09-29). Rarely — usually on the first cold launch of
// the day, on BOTH iOS and Android — the home launcher shows ONLY the
// Easy/Challenge/Expert pill. The 37 logo, the Practice/Daily toggle, Roll Dice
// and the podium are all gone. Tapping a tier brings everything back.
//
// WHAT WE ALREADY KNOW. It is not React state. GameHeader (the logo) and
// RoundToggle (Practice/Daily) render UNCONDITIONALLY, and RoundToggle is a
// sibling of ModeToggle in the same <div> — no prop can remove one and keep the
// other. So the pieces are in the DOM but not visible: zero-sized, pushed out of
// view, faded, clipped, or covered. We could not reproduce it and found no cause
// in the code, so David ruled: no speculative fix — collect evidence first.
//
// WHAT THIS DOES. A few seconds after the launcher mounts, it measures the logo,
// the round toggle and the tier pill. If the tier pill is visible but the logo
// AND the round toggle are not — the exact shape of the report — it measures
// again a few seconds later (a real occurrence persists until the player taps;
// a transient entrance frame does not) and, if it is still broken, sends ONE
// Sentry event per session carrying every measurement. Players see nothing.
//
// ⚠️ ITS BLIND SPOT, STATED UP FRONT. JavaScript can see LAYOUT (sizes,
// positions, opacity, what sits on top of what) but not PIXELS. If the cause is
// a pure paint failure — elements laid out correctly but never drawn — every
// check here passes and nothing is sent. So "no reports while players still see
// it" is itself evidence: it points at painting, not layout.
//
// This module must NEVER throw into the launcher. A diagnostic that can break
// the home screen is worse than no diagnostic.

import { useEffect } from 'react';
import { captureError } from '@/observability';

/** How the three probed pieces are found inside the launcher root. */
export const PROBE_SELECTORS = Object.freeze({
  // ModeToggle's pill has no test id of its own; its first tier button does,
  // and the pill is that button's parent.
  mode: '[data-testid="tier-easy"]',
  round: '[data-testid="round-toggle"]',
  logo: '[data-health="logo"]',
  entry: '[data-testid="daily-entry-button"]',
  podium: '[data-testid="podium-showcase"]',
});

export const FIRST_CHECK_MS = 3000;
export const CONFIRM_CHECK_MS = 5000;

// A near-zero opacity is invisible to a player even though it is not 0.
const MIN_VISIBLE_OPACITY = 0.05;

let reportedThisSession = false;

/**
 * Measure one element. Every browser call goes through `env` so tests can feed
 * exact geometry (happy-dom does no layout — every rect it returns is zeros).
 *
 * @param {Element|null} el
 * @param {{ rect: Function, style: Function, hit: Function, viewport: {w:number,h:number} }} env
 */
export function measureElement(el, env) {
  if (!el) return { present: false, visible: false };

  const r = env.rect(el);
  const rect = { x: Math.round(r.left), y: Math.round(r.top), w: Math.round(r.width), h: Math.round(r.height) };
  const sized = r.width > 0 && r.height > 0;
  const inViewport = sized
    && r.bottom > 0 && r.top < env.viewport.h
    && r.right > 0 && r.left < env.viewport.w;

  // Opacity multiplies down the tree, so walk every ancestor.
  let opacity = 1;
  let hiddenBy = null;
  for (let node = el; node && node.nodeType === 1; node = node.parentElement) {
    const s = env.style(node);
    const o = parseFloat(s.opacity);
    if (Number.isFinite(o)) opacity *= o;
    if (!hiddenBy && (s.display === 'none' || s.visibility === 'hidden')) hiddenBy = describe(node);
  }

  let covered = false;
  let topElement = null;
  if (inViewport) {
    const cx = r.left + r.width / 2;
    const cy = r.top + r.height / 2;
    const top = env.hit(cx, cy);
    covered = !(top && (top === el || el.contains(top)));
    if (covered) topElement = describe(top);
  }

  const visible = sized && inViewport && !hiddenBy && opacity > MIN_VISIBLE_OPACITY && !covered;
  return {
    present: true,
    visible,
    rect,
    inViewport,
    opacity: Math.round(opacity * 100) / 100,
    hiddenBy,
    covered,
    topElement,
  };
}

/**
 * The bug's exact shape: the tier pill shows, the logo and the round toggle
 * (which always render) do not. Anything else — including everything hidden
 * at once, which is just an overlay being open — is not this bug.
 */
export function isLauncherBroken(probes) {
  return Boolean(
    probes?.mode?.visible
    && probes.logo?.present && !probes.logo.visible
    && probes.round?.present && !probes.round.visible,
  );
}

/** Measure every probe inside the launcher root. */
export function measureLauncher(root, env) {
  const find = (sel) => root.querySelector(sel);
  const modeButton = find(PROBE_SELECTORS.mode);
  return {
    mode: measureElement(modeButton ? modeButton.parentElement : null, env),
    logo: measureElement(find(PROBE_SELECTORS.logo), env),
    round: measureElement(find(PROBE_SELECTORS.round), env),
    entry: measureElement(find(PROBE_SELECTORS.entry), env),
    podium: measureElement(find(PROBE_SELECTORS.podium), env),
  };
}

/** Page-level facts worth having beside the probes when a report lands. */
export function collectContext(root, win = window, doc = document) {
  const scroller = root.closest('.app-page-scroll');
  const rootStyle = win.getComputedStyle(doc.documentElement);
  const appRoot = doc.getElementById('root');
  const appRootStyle = appRoot ? win.getComputedStyle(appRoot) : null;
  const cssVar = (name) => (rootStyle.getPropertyValue(name) || (appRootStyle && appRootStyle.getPropertyValue(name)) || '').trim();
  return {
    viewport: { w: win.innerWidth, h: win.innerHeight, dpr: win.devicePixelRatio },
    visibilityState: doc.visibilityState,
    msSinceLoad: Math.round(win.performance?.now?.() ?? -1),
    scroller: scroller
      ? { clientHeight: scroller.clientHeight, scrollHeight: scroller.scrollHeight, scrollTop: scroller.scrollTop }
      : null,
    cssVars: {
      adReservedBottom: cssVar('--ad-reserved-bottom'),
      navReserved: cssVar('--u37-nav-reserved'),
      bottomReserved: cssVar('--u37-bottom-reserved'),
      safeBottom: cssVar('--safe-bottom'),
    },
  };
}

function describe(node) {
  if (!node || node.nodeType !== 1) return null;
  const id = node.id ? `#${node.id}` : '';
  const testId = node.getAttribute?.('data-testid');
  const classes = typeof node.className === 'string' ? node.className.trim().split(/\s+/).filter(Boolean) : [];
  const cls = classes.length ? `.${classes.slice(0, 4).join('.')}` : '';
  return `${node.tagName.toLowerCase()}${id}${testId ? `[${testId}]` : ''}${cls}`.slice(0, 160);
}

function browserEnv(win = window, doc = document) {
  return {
    rect: (el) => el.getBoundingClientRect(),
    style: (el) => win.getComputedStyle(el),
    hit: (x, y) => doc.elementFromPoint(x, y),
    viewport: { w: win.innerWidth, h: win.innerHeight },
  };
}

/**
 * Run the two-step check once for this mount. Returns a cancel function.
 * `deps` is for tests; production passes nothing.
 */
export function scheduleLauncherCheck(root, context = {}, deps = {}) {
  const {
    env = () => browserEnv(),
    report = (err, detail) => captureError(err, detail),
    gather = (el) => collectContext(el),
    setTimer = (fn, ms) => setTimeout(fn, ms),
    clearTimer = (id) => clearTimeout(id),
    isHidden = () => typeof document !== 'undefined' && document.visibilityState === 'hidden',
  } = deps;

  let timer = null;
  let cancelled = false;

  const safeMeasure = () => {
    try {
      // A backgrounded app is not showing anything to anyone.
      if (isHidden()) return null;
      return measureLauncher(root, env());
    } catch {
      return null;
    }
  };

  timer = setTimer(() => {
    if (cancelled || reportedThisSession) return;
    const first = safeMeasure();
    if (!first || !isLauncherBroken(first)) return;
    timer = setTimer(() => {
      if (cancelled || reportedThisSession) return;
      const second = safeMeasure();
      if (!second || !isLauncherBroken(second)) return;
      reportedThisSession = true;
      try {
        let page = null;
        // Deliberately ignored: this IS the diagnostic; a failed page read is
        // reported below as page=null rather than masking the original report.
        try { page = gather(root); } catch { page = null; }
        report(new Error('Home launcher content not visible'), {
          ...context,
          first,
          second,
          page,
        });
      } catch {
        // Never let a reporting failure reach the launcher.
      }
    }, CONFIRM_CHECK_MS);
  }, FIRST_CHECK_MS);

  return () => {
    cancelled = true;
    if (timer != null) clearTimer(timer);
  };
}

/**
 * React hook: check the launcher each time it becomes the live screen.
 * `active` is false while a puzzle is in play (the gameplay overlay covers the
 * launcher on purpose — that is not the bug).
 */
export function useLauncherVisibilityCheck(rootRef, { active, mode }) {
  useEffect(() => {
    if (!active || !rootRef.current) return undefined;
    return scheduleLauncherCheck(rootRef.current, { mode });
  }, [active, mode, rootRef]);
}

// Test-only: the one-report-per-session latch is module state.
export function __resetLauncherCheckForTests() {
  reportedThisSession = false;
}
