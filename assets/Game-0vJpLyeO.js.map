import React from 'react';
import { createPortal } from 'react-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { Trophy, ChevronRight } from 'lucide-react';

import {
  CONTEST,
  CONTEST_HEADLINE,
  CONTEST_CHIP_LINE,
  CONTEST_BLURB,
  CONTEST_WINDOW,
  CONTEST_TERMS,
  CONTEST_SPONSOR_DISCLAIMER,
  CONTEST_LINK_LABEL,
  isContestPromoVisible,
} from './contest';
import { contestChipLine } from './contestEntries';
import ContestDetails from './ContestDetails';

// The home-screen promo for the $37 weekly giveaway — a ONE-BAR CHIP that opens
// the full detail sheet.
//
// WEB AND NATIVE since 2026-09-11 (see contest.js NATIVE_ENABLED). It still asks
// `isContestPromoVisible()` rather than rendering unconditionally, because that
// flag is the one place the store-policy decision is recorded.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY IT IS A CHIP NOW AND NOT A FOUR-LINE BANNER
// ─────────────────────────────────────────────────────────────────────────────
// It was a 196px block carrying headline, blurb, window, terms and the guest
// prompt. Measured on a 360x800 viewport (David's S21) the home launcher was
// overrunning the nav band by 195px on Challenge and 116px on Easy/Expert — the
// podium was cut off on ALL THREE tiers — and this was the single largest
// non-podium item on the screen.
//
// David's call on 2026-09-11, given those numbers: compact chip on the home
// screen, full detail one tap away. ~56px instead of 196px.
//
// WHAT STAYS ON THE FACE, AND WHY THESE TWO THINGS. The prize, and the fact that
// the week closes on Saturday. A player who reads nothing else learns that there
// is $37 to win and that their entry has a deadline — which is the whole job of
// a promo. Everything that answers a question they have not asked yet (exact run
// dates, eligibility, how the drawing works) is in ContestDetails.
//
// ⚠️ IT IS A BUTTON NOW, NOT AN <a>. The old element was a real anchor so a
// crawler could follow it to the .com rules page — the inbound link is worth
// something. A button that opens a sheet cannot do that, so the anchor survives
// as an `sr-only` sibling: zero layout height, still in the markup, still
// followable. Delete it and the web build quietly loses that link.
//
// It no longer needs `useAuth`: the guest prompt moved INTO the sheet, which is
// also the only place it can be acted on. That means this component renders the
// same for every viewer, and the tests that stub '@/contest' wholesale no longer
// need an AuthProvider for the chip itself.
/**
 * @param {{entryState?: {kind: 'account'|'confirm'|'declined'|'entries', week: number|null, today: number|null}|null}} props
 *   entryState — this player's standing in the draw, from contestEntryState.
 *   Optional: without it the chip keeps its original schedule line, which is
 *   what every non-launcher caller and every logged-out viewer sees.
 */
/**
 * What a declined player sees instead of the promo. Factual, not persuasive —
 * it states where they stand and offers the way back, and nothing else.
 *
 * Deliberately says neither "$37" nor "under 18": the first is the advertising
 * being removed, and the second is wrong for the non-US adults who also answer
 * No to "18 or older AND living in the United States".
 */
const DECLINED_CHIP_HEADLINE = 'Giveaway — not eligible';
const DECLINED_CHIP_LINE = "Tap if that's not right";

/** The guest teaser (David, 2026-10-10): a guest cannot enter without an
 *  account, so the chip sells the account instead of opening the rules. */
const TEASER_HEADLINE = 'Win $37 every week';
const TEASER_LINE = 'Create a free account to enter';

/**
 * @param {{
 *   entryState?: any,
 *   visibility?: 'teaser' | 'full' | 'hidden' | 'ask',
 *   lineSuffix?: string,
 * }} props
 *   visibility — from contestVisibility(user) in this module. Defaults to 'full' so a
 *   caller that does not know the viewer keeps the old behaviour.
 *
 * ⚠️ 'hidden' (a member who answered No) now renders NOTHING — David,
 * 2026-10-10: "if they select no on that, we do not run contest info in the
 * app". This REVERSES the 2026-09-17 neutral "Giveaway — not eligible" chip
 * below, which existed only because it was the sole way back from a mis-tapped
 * No. That way back now lives in Edit Profile (CreateAccountForm still asks the
 * 18+ question, pre-filled), and the signup + one-time question both say "You
 * can change this any time in your profile." 'ask' also renders nothing: the
 * one-time question (AskOnceQuestion) asks first.
 */
export default function ContestBanner({ entryState = null, visibility = 'full', lineSuffix = '' }) {
  const [open, setOpen] = React.useState(false);

  // Hide the bottom nav while the sheet is up — the established lever Layout
  // already listens for. Cleanup runs even if this unmounts mid-gesture, so the
  // bar can never stay stuck hidden.
  React.useEffect(() => {
    if (!open) return undefined;
    const setNavHidden = (hidden) => {
      window.dispatchEvent(new CustomEvent('bottomNavChanged', { detail: { hidden } }));
    };
    setNavHidden(true);
    return () => setNavHidden(false);
  }, [open]);

  if (!isContestPromoVisible()) return null;
  if (visibility === 'hidden' || visibility === 'ask') return null;

  if (visibility === 'teaser') {
    return (
      <div className="flex flex-col items-center px-4">
        <button
          type="button"
          data-testid="contest-teaser"
          onClick={() => window.dispatchEvent(new Event('openSaveStats'))}
          aria-label={`${TEASER_HEADLINE}. ${TEASER_LINE}. ${CONTEST_TERMS}. Opens account creation.`}
          className="w-[88%] max-w-sm min-h-[48px] touch-manipulation flex items-center justify-center gap-2 rounded-2xl px-4 py-2 border backdrop-blur-sm"
          style={{
            color: 'color-mix(in srgb, var(--u37-gold) 35%, white)',
            borderColor: 'var(--u37-gold)',
            background: 'color-mix(in srgb, var(--u37-gold) 10%, transparent)',
            boxShadow: '0 0 18px -8px var(--u37-gold)',
            WebkitTapHighlightColor: 'transparent',
          }}
        >
          <Trophy className="w-4 h-4 flex-shrink-0" aria-hidden="true" />
          <span className="flex-1 min-w-0 flex flex-col items-center leading-tight">
            <span className="font-black text-sm">{TEASER_HEADLINE}</span>
            <span className="text-[11px] font-bold opacity-90">{TEASER_LINE}</span>
          </span>
          <ChevronRight className="w-4 h-4 flex-shrink-0" aria-hidden="true" />
        </button>
      </div>
    );
  }

  // ⚠️ THIS REPLACES THE SECOND LINE, IT DOES NOT ADD ONE (David, 2026-09-17).
  //
  // He asked for two things on the home screen — that players notice all THREE
  // Dailies, and that they can see "x of 21 entries earned this week" — with the
  // explicit constraint that home must not get taller or start scrolling. That
  // constraint is not a style preference: this chip was cut from 196px to ~56px
  // in September precisely because the launcher was overrunning the nav band by
  // 195px and cutting off the podium on all three tiers.
  //
  // So the standing rides on the line that is already here. Zero added height,
  // and the two facts reinforce each other — the reason to play all three is
  // that each one is an entry. When we have nothing trustworthy to say,
  // contestChipLine returns null and the schedule line stays.
  // `lineSuffix` (" · +4 from friends", referrals) rides on the ENTRIES line
  // only — never on an invitation to fix something.
  const chipLine = contestChipLine(entryState);
  const statusLine = chipLine && entryState?.kind === 'entries' && lineSuffix ? `${chipLine}${lineSuffix}` : chipLine;

  // ⚠️ A PLAYER WHO SAID THEY ARE NOT ELIGIBLE IS NOT ADVERTISED TO.
  //
  // David, 2026-09-17: "when a player declares that they are under 18, it should
  // then remove the promotional text from within the game. since they are
  // excluded."
  //
  // This is the app acting on a self-declaration rather than just recording it,
  // and it is the strongest mitigation available for the standing gap that the
  // store rating is 13+ with no age gate while the promotion is 18+/US-only.
  //
  // ⚠️ NEUTRALISED, NOT REMOVED, AND THE REASON MATTERS. The only way back from
  // a mis-tapped "No" is this chip: it opens the sheet carrying "I am 18+ and in
  // the US after all". Hiding the chip would permanently cost a legitimate adult
  // their entries over one fat-fingered tap, with no recourse inside the app.
  // So the promotional LANGUAGE goes — no prize, no "Win", no gold — and the
  // control stays, quiet and factual.
  //
  // ⚠️ AND THE COPY DOES NOT SAY "UNDER 18". The question is "18 or older AND
  // living in the United States", so a No is also every adult outside the US.
  // Telling them they are under 18 would be wrong for most of them.
  const declined = entryState?.kind === 'declined';

  return (
    <div className="flex flex-col items-center px-4">
      <motion.button
        type="button"
        data-testid="contest-banner"
        data-open={String(open)}
        onClick={() => setOpen(true)}
        whileHover={{ scale: 1.02 }}
        whileTap={{ scale: 0.98 }}
        aria-haspopup="dialog"
        aria-expanded={open}
        // The accessible name carries the WHOLE promo, disclaimer included. A
        // sighted player can open the sheet to read the sponsor notice; a
        // screen-reader user meeting this chip should not have to, because the
        // chip is the only part of the promo that is unconditionally present.
        // ⚠️ THE ACCESSIBLE NAME CARRIES THE ENTIRE PROMO, disclaimer and all —
        // so for a declined player it is the single biggest piece of
        // advertising on the screen, and removing only the visible text would
        // have left a screen-reader user hearing the full pitch.
        aria-label={declined
          ? `${DECLINED_CHIP_HEADLINE}. ${DECLINED_CHIP_LINE}. Opens your giveaway eligibility.`
          : `${CONTEST_HEADLINE}. ${CONTEST_BLURB} ${CONTEST_WINDOW}. ${CONTEST_TERMS}. ${CONTEST_SPONSOR_DISCLAIMER} Opens the full giveaway details.`}
        // Narrower than How-To above it, continuing the launcher's inverted
        // pyramid (see HowToWinButton for why this is a percentage).
        className="w-[88%] max-w-sm min-h-[48px] touch-manipulation flex items-center justify-center gap-2 rounded-2xl px-4 py-2 border backdrop-blur-sm transition-colors"
        // Gold is the PRIZE's colour here, not the app's — so a declined player
        // gets none of it. No glow either: the chip should read as a setting
        // they can revisit, not as something competing for a tap.
        // ⚠️ LEGIBLE, BUT STILL NOT PROMOTIONAL (David, beta 1.0.312: "the
        // greyed out should be a little more visible but nothing like what it is
        // during the in contest version").
        //
        // The first pass went too far the other way: a control nobody can find is
        // as bad as the advertising it replaced, because this chip is the ONLY
        // route back from a mis-tapped "No". Lifted to slate-300 with a visible
        // border — readable at a glance, and still carrying no gold, no glow and
        // no prize.
        style={declined ? {
          color: 'rgb(203 213 225)',
          borderColor: 'rgba(255,255,255,0.28)',
          background: 'rgba(255,255,255,0.07)',
          WebkitTapHighlightColor: 'transparent',
        } : {
          color: 'color-mix(in srgb, var(--u37-gold) 35%, white)',
          borderColor: 'var(--u37-gold)',
          background: 'color-mix(in srgb, var(--u37-gold) 12%, transparent)',
          boxShadow: '0 0 18px -8px var(--u37-gold), inset 0 0 18px -14px var(--u37-gold)',
          textShadow: '0 0 8px color-mix(in srgb, var(--u37-gold) 45%, transparent)',
          WebkitTapHighlightColor: 'transparent',
        }}
      >
        {/* ⚠️ THE TEXT IS CENTRED BY `flex-1`, NOT BY THE BUTTON'S `justify-center`.
            Reported left-offset by David (2026-09-12). The chevron used to carry
            `ml-auto`, which absorbs ALL the row's free space — that is what
            `ml-auto` is for — so `justify-center` on the button had nothing left
            to distribute and the icon+text cluster sat hard left.

            Instead the middle column takes the free space (`flex-1`) and centres
            its own contents. Because the two icons are the same width (`w-4`),
            the text lands on the button's true centre rather than merely between
            the icons, and the chevron still sits at the right edge. */}
        <Trophy className="w-4 h-4 flex-shrink-0" aria-hidden="true" />
        <span className="flex-1 min-w-0 flex flex-col items-center text-center leading-tight">
          <span className="font-black text-sm">
            {declined ? DECLINED_CHIP_HEADLINE : CONTEST_HEADLINE}
          </span>
          <span
            data-testid="contest-window"
            className="text-[10px] font-semibold text-slate-300/90"
          >
            {declined ? DECLINED_CHIP_LINE : (statusLine ?? CONTEST_CHIP_LINE)}
          </span>
        </span>
        <ChevronRight className="w-4 h-4 flex-shrink-0" aria-hidden="true" />
      </motion.button>

      {/* The crawlable link the chip can no longer be. Zero height, real href. */}
      <a
        className="sr-only"
        href={CONTEST.rulesUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-testid="contest-rules-seo-link"
      >
        {CONTEST_LINK_LABEL}
      </a>

      {/* Portalled to <body>: the launcher lives inside a scrolling column and
          under framer-motion ancestors, and a `position: fixed` overlay inside a
          transformed ancestor is positioned against THAT ancestor rather than
          the viewport. Same reason HowToOverlay portals. */}
      {typeof document !== 'undefined' && createPortal(
        <AnimatePresence>
          {open && (
            <motion.div
              data-testid="contest-details-overlay"
              // ⚠️ z-[150], NOT z-[60]. The bottom nav bar sits at z-140, so this
              // sheet was rendering UNDERNEATH it — David, beta 1.0.312: the legal
              // lines are "blocked by navigation bar". The sheet's max-height
              // already reserved for the AD banner; nothing reserved for the app's
              // own nav, and the thing at the bottom of this sheet is the sponsor
              // disclaimer plus "Void where prohibited", which are obligations
              // rather than decoration.
              //
              // Same two belts HowToOverlay uses for the same collision: the nav
              // is suppressed while this is open (below), AND this sits above it
              // so a timing race cannot let the nav capture a tap either.
              className="fixed inset-0 z-[150] flex items-center justify-center p-4"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
            >
              <button
                type="button"
                aria-label="Close"
                data-testid="contest-details-backdrop"
                onClick={() => setOpen(false)}
                className="absolute inset-0 bg-black/80 backdrop-blur-sm"
              />
              <div className="relative w-full">
                <ContestDetails onClose={() => setOpen(false)} />
              </div>
            </motion.div>
          )}
        </AnimatePresence>,
        document.body,
      )}
    </div>
  );
}
