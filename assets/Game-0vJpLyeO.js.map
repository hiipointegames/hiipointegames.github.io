import React from 'react';
import { Lock } from 'lucide-react';

import { openUnlockSheet } from './softWall';

// What a guest sees where today's podium would be (approved mockup screen 8):
// a faint outline of the real thing with one lock card on top — lock-in-place,
// not a heavy blur (design research 2026-10-10). Tapping opens the unlock sheet.
//
// ⚠️ HEIGHT IS BUDGETED. Home is a no-scroll screen; the first version (~250px)
// was taller than the real empty podium it replaces (~140px) and pushed the
// launcher into scrolling at 360x800 (seen on staging 2026-10-10). Keep it
// compact: re-measure document.scrollingElement scroll at 360x800 after changes.

const TIER_COLOR = Object.freeze({
  easy: 'var(--u37-green)',
  challenge: 'var(--u37-cyan)',
  expert: 'var(--u37-gold)',
});

/** @param {{ tier?: 'easy' | 'challenge' | 'expert' }} props */
export default function LockedPodium({ tier = 'easy' }) {
  const c = TIER_COLOR[tier] || TIER_COLOR.easy;
  return (
    <div className="px-4" data-testid="locked-podium">
      <div
        className="relative mx-auto max-w-md rounded-[22px] border-2 border-dashed px-4 pt-3 pb-3 min-h-[132px] flex flex-col items-center"
        style={{ borderColor: `color-mix(in srgb, ${c} 35%, transparent)` }}
      >
        <div className="text-xs font-black tracking-[0.2em] uppercase" style={{ color: `color-mix(in srgb, ${c} 55%, transparent)` }}>
          Today’s {tier} Daily podium
        </div>
        <div className="mt-3 flex items-end gap-3.5 opacity-20" aria-hidden="true">
          <div className="w-[70px] h-[46px] rounded-t-xl bg-slate-300" />
          <div className="w-[70px] h-[66px] rounded-t-xl" style={{ background: 'var(--u37-gold)' }} />
          <div className="w-[70px] h-[34px] rounded-t-xl bg-orange-400" />
        </div>
        <button
          type="button"
          data-testid="locked-podium-unlock"
          onClick={() => openUnlockSheet('podium')}
          className="absolute left-1/2 top-9 -translate-x-1/2 w-[252px] rounded-[16px] border-2 px-3 py-2.5 flex flex-col items-center gap-1 text-center"
          style={{ borderColor: c, background: 'rgba(8,10,30,0.92)', boxShadow: `0 0 26px -10px ${c}` }}
        >
          <Lock className="w-5 h-5" style={{ color: c }} aria-hidden="true" />
          <span className="text-[15px] font-black text-white">See today’s podium</span>
          <span className="text-xs font-bold text-emerald-100/80">Create a free account to unlock</span>
        </button>
      </div>
    </div>
  );
}
