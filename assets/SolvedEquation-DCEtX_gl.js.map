// SolvedEquation — the read-only render face of a finished equation.
//
// The third member of the equation trio: [[equation engine]] computes whether
// power dice are used correctly, [[equation draft]] owns the in-progress
// composition, and SolvedEquation draws a completed equation with per-die
// coloring, exponent superscripts, and the white-outline on correctly-used
// [[power dice]]. Consolidates ~6 copies of an identical char-walking renderer
// that previously lived inline in stats/profile/head-to-head/success surfaces.
//
// Props:
//   equation   — ASCII-operator equation string (e.g. "5+6*1^2")
//   usedIndices— dice-array indices in equation order
//   colors     — flat color array, positionally aligned with the dice array
//   highlightAllWhenPerfect — when all three power dice are correct, outline
//                 every colored die (the SuccessModal / friends-leaderboard
//                 "perfect solve" treatment) instead of only the correct ones.

import { getPowerDiceCorrectness, countPowerDiceCorrect } from '@/equation-engine';
import { POWER_DIE_GOLD, POWER_DIE_GOLD_GLOW } from '@/dice-visuals';

const COLOR_CLASS = {
  white: 'text-slate-200',
  blue: 'text-blue-400',
  red: 'text-red-400',
  green: 'text-green-400',
};

// Display substitution: ASCII operators -> the symbols players see.
const toDisplay = (equation) =>
  equation.replace(/\*/g, '×').replace(/\//g, '÷').replace(/-/g, '−');

export function SolvedEquation({ equation, usedIndices, colors, highlightAllWhenPerfect = false }) {
  if (!equation || !usedIndices || !colors) {
    return <>{toDisplay(equation || '')}</>;
  }

  const correctnessMap = colors.length >= 7
    ? getPowerDiceCorrectness(equation, usedIndices, colors)
    : new Map();

  const allColoredCorrect =
    highlightAllWhenPerfect && countPowerDiceCorrect(correctnessMap) === 3;

  const formattedEq = toDisplay(equation);
  const spans = [];
  let diceIndex = 0;
  let inSuperscript = false;
  let parenDepth = 0;

  for (let i = 0; i < formattedEq.length; i++) {
    const char = formattedEq[i];
    const prevChar = i > 0 ? formattedEq[i - 1] : '';

    if (prevChar === '^' && !inSuperscript) {
      inSuperscript = true;
      parenDepth = 0;
    }

    if (/\d/.test(char)) {
      let numStr = char;
      let j = i + 1;
      while (j < formattedEq.length && /\d/.test(formattedEq[j])) {
        numStr += formattedEq[j];
        j++;
      }

      let color = 'white';
      if (usedIndices[diceIndex] !== undefined) {
        color = colors[usedIndices[diceIndex]] || 'white';
      }

      const isColored = color !== 'white';
      const isCorrect = correctnessMap.get(diceIndex) === true;
      const shouldOutline = allColoredCorrect ? isColored : (isColored && isCorrect);
      const sup = inSuperscript;

      spans.push(
        <span
          key={i}
          className={`${COLOR_CLASS[color]} ${sup ? 'inline-block align-super ml-0.5' : ''} ${shouldOutline ? 'border-2 rounded px-0.5' : ''}`}
          style={{
            ...(sup ? { fontSize: 'inherit' } : {}),
            // Shiny gold power-die outline (shared token — matches the live
            // builder's GoldPulseRing). Static, no pulse.
            ...(shouldOutline ? { borderColor: POWER_DIE_GOLD, boxShadow: POWER_DIE_GOLD_GLOW } : {}),
          }}
        >
          {numStr}
        </span>
      );

      diceIndex++;
      i = j - 1;

      if (inSuperscript && parenDepth === 0) {
        inSuperscript = false;
      }
    } else {
      const sup = inSuperscript;

      if (char === '(' && inSuperscript) {
        parenDepth++;
      } else if (char === ')' && inSuperscript && parenDepth > 0) {
        parenDepth--;
        if (parenDepth === 0) {
          spans.push(
            <span key={i} className="text-slate-200 inline-block align-super ml-0.5" style={{ fontSize: 'inherit' }}>
              {char}
            </span>
          );
          inSuperscript = false;
          continue;
        }
      }

      spans.push(
        <span
          key={i}
          className={`text-slate-200 ${sup ? 'inline-block align-super ml-0.5' : ''}`}
          style={sup ? { fontSize: 'inherit' } : {}}
        >
          {char}
        </span>
      );
    }
  }

  return <>{spans}</>;
}
